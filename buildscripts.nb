                    RowBox[{"symdir", ",", 
                    RowBox[{"n", "<>", "\"\<.nb\>\""}]}], "}"}], "]"}], "]"}],
                  ";"}], ",", 
                RowBox[{"Enabled", "->", 
                 RowBox[{"Dynamic", "[", 
