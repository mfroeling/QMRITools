      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"DirectoryName", "@", "buildDir"}], ",", 
         RowBox[{"name", "<>", "\"\<-html\>\""}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"toBuild", "=", 
      RowBox[{"FileBaseName", "/@", 
       RowBox[{"FileNames", "[", 
        RowBox[{"\"\<*.nb\>\"", ",", "\"\<QMRITools\\\\Documentation\>\"", ",",
          "Infinity"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"done", "=", 
      RowBox[{"FileBaseName", "/@", 
       RowBox[{"FileNames", "[", 
        RowBox[{"\"\<*.html\>\"", 
         ",", "\"\<D:\\\\werk\\\\workspace\\\\QMRITools\\\\build\\\\QMRITools-\
html\>\"", ",", "Infinity"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"toDo", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{"toBuild", ",", "done"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<HTML files still to be build: \>\"", ",", 
       RowBox[{"Length", "@", 
        RowBox[{"Flatten", "@", "toDo"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Quiet", "@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"names", "=", "toDo"}], ";", "\[IndentingNewLine]", 
