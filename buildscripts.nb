                  RowBox[{"FileNameJoin", "[", 
                   RowBox[{"{", 
                    RowBox[{"symdir", ",", 
                    RowBox[{"n", "<>", "\"\<.nb\>\""}]}], "}"}], "]"}], "]"}],
                  ";"}], ",", 
                RowBox[{"Enabled", "->", 
                 RowBox[{"Dynamic", "[", 
                  RowBox[{"pressed", "[", 
                   RowBox[{"[", "ii", "]"}], "]"}], "]"}]}]}], "]"}]}]}], 
            "]"}], "\[IndentingNewLine]", ",", 
