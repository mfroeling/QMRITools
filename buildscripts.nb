        " ", "command"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"get", " ", "packlet", " ", "information"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"location", "=", 
       RowBox[{"pac", "[", "\"\<Location\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dir", "=", 
