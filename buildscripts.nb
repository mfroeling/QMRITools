      RowBox[{"file", "=", 
       RowBox[{"MakePacletSite", "[", 
        RowBox[{"dir", ",", "tag"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"push", " ", "everyting", " ", "to", " ", "git"}], ",", " ", 
        RowBox[{
        "to", " ", "allow", " ", "this", " ", "GitHub", " ", "CLI", " ", 
         "needs", " ", "to", " ", "be", " ", "installed"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"OptionValue", "[", "PushRelese", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", "\"\<   - Not pushing the relese to GitHub\>\"", "]"}], 
