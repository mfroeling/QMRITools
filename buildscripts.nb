         "<>", "\"\<\\\"\\n\>\"", "<>", "\[IndentingNewLine]", "gitHub", 
         "<>", "\"\< release upload \>\"", "<>", "tag", "<>", "\"\< \\\"\>\"",
          "<>", "file", 
         "<>", "\"\<\\\"\\ngit commit -am \\\"update release \>\"", "<>", 
         "\[IndentingNewLine]", "tag", 
         "<>", "\"\<\\\" && git push\\nexit\\n\>\""}]}]}], ";", 
      "\[IndentingNewLine]", 
