     RowBox[{
      RowBox[{"file", "=", 
       RowBox[{"First", "@", 
        RowBox[{"FileNames", "[", 
         RowBox[{
          RowBox[{"\"\<*\>\"", "<>", "tag", "<>", "\"\<*.paclet\>\""}], ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"dir", ",", "\"\<build\>\""}], "}"}], "]"}]}], "]"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"DeleteFile", "/@", 
       RowBox[{"FileNames", "[", 
        RowBox[{"\"\<*.paclet\>\"", ",", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dir", ",", "\"\<Paclets\>\""}], "}"}], "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"CopyFile", "[", 
         RowBox[{"file", ",", 
          RowBox[{"StringReplace", "[", 
           RowBox[{"file", ",", 
            RowBox[{"\"\<build\>\"", "->", "\"\<Paclets\>\""}]}], "]"}], ",", 
          RowBox[{"OverwriteTarget", "->", "True"}]}], "]"}], ";"}], 
       "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "to", " ", "make", " ", "paclet", " ", "install", " ", "via", " ", 
        "github", " ", "work", " ", "install", " ", "git", " ", "lfs", " ", 
        "in", " ", "the", " ", "repository"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "use", " ", "the", " ", "command", " ", "\"\<git lfs track \>\"", "*", 
        RowBox[{".", "paclet"}], "\"\<\>\"", " ", "to", " ", "trac", " ", 
        "the", " ", "paclet", " ", "files"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"pacFiles", "=", 
         RowBox[{"FileNames", "[", 
          RowBox[{"\"\<*.paclet\>\"", ",", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", "\"\<Paclets\>\""}], "}"}], "]"}]}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"pacs", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "@", 
            RowBox[{"Import", "[", 
             RowBox[{"#", ",", " ", "\"\<*/PacletInfo.*\>\""}], "]"}]}], 
           "&"}], "/@", "pacFiles"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"exp", "=", 
         RowBox[{"PacletSite", "@@", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Paclet", "@@", 
              RowBox[{"Normal", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "&"}], "/@", 
            "pacs"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"dir", ",", "\"\<PacletSite.mz\>\""}], "}"}], "]"}], ",", 
          RowBox[{"{", "exp", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<ZIP\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{"\"\<PacletSite.m\>\"", ",", "\"\<Package\>\""}], "}"}],
              "}"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "check", " ", "which", " ", "pacs", " ", "are", " ", "availible"}], 
