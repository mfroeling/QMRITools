 RowBox[{
  RowBox[{
   RowBox[{"GitHubPush", "[", 
    RowBox[{"dir_", ",", "file_", ",", "tag_", ",", "title_", ",", "note_"}], 
    "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"gitHub", ",", "command"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "gitHub", 
       "=", "\"\<\\\"C:\\\\Program Files\\\\GitHub CLI\\\\gh.exe\\\"\>\""}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"command", "=", 
       RowBox[{
        RowBox[{"First", "[", 
         RowBox[{"FileNameSplit", "[", "dir", "]"}], "]"}], 
        "<>", "\"\<\\ncd \>\"", "<>", "dir", "<>", "\"\<\\n\>\"", "<>", 
        "\[IndentingNewLine]", "gitHub", "<>", "\"\< release create \>\"", "<>",
         "tag", "<>", "\"\< --title \\\"\>\"", "<>", "title", 
        "<>", "\"\<\\\" --notes-file \\\"\>\"", "<>", 
        RowBox[{"Export", "[", 
         RowBox[{
          
          RowBox[{"\"\<build\\\\note_\>\"", "<>", "tag", 
           "<>", "\"\<.md\>\""}], ",", "note", ",", "\"\<Text\>\""}], "]"}], 
        "<>", "\"\<\\\"\\n\>\"", "<>", "\[IndentingNewLine]", "gitHub", 
        "<>", "\"\< release upload \>\"", "<>", "tag", "<>", "\"\< \\\"\>\"", 
        "<>", "file", 
        "<>", "\"\<\\\"\\ngit commit -am \\\"update release \>\"", "<>", 
        "\[IndentingNewLine]", "tag", 
        "<>", "\"\<\\\" && git push\\nexit\\n\>\""}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "command", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"RunProcess", "[", 
       RowBox[{
       "$SystemShell", ",", "\"\<StandardOutput\>\"", ",", "command"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
