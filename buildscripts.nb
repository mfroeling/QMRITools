Cell[BoxData[
 RowBox[{
  RowBox[{"ShowStatus", "[", "dir_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ker", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"dir", ",", "\"\<QMRITools\\\\Kernel\>\""}], "}"}], "]"}]}], 
      ",", "\[IndentingNewLine]", "lines", ",", " ", "all", ",", " ", "lns", ",",
       "hlp", ",", "com", ",", "char", ",", "nFunc"}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lines", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Import", "[", 
         RowBox[{"#", ",", "\"\<Lines\>\""}], "]"}], "&"}], "/@", 
       RowBox[{"FileNames", "[", 
        RowBox[{"All", ",", "ker"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"all", "=", 
      RowBox[{"Length", "@", 
       RowBox[{"Flatten", "@", "lines"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"lines", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"DeleteCases", "[", 
         RowBox[{"#", ",", "\"\<\>\""}], "]"}], "&"}], "/@", "lines"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"lns", "=", 
      RowBox[{"Length", "@", 
       RowBox[{"Flatten", "@", "lines"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"hlp", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Differences", "[", 
           RowBox[{"MinMax", "[", "#", "]"}], "]"}], "&"}], "/@", 
         RowBox[{"DeleteCases", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"Quiet", "[", 
               RowBox[{"Position", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"_", "?", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"StringContainsQ", "[", 
                    RowBox[{"#", ",", "\"\<(*Functions*)\>\""}], "]"}], "&"}],
                    ")"}]}]}], "]"}], "]"}], "]"}], "&"}], "/@", "lines"}], ",", 
           RowBox[{"{", "}"}]}], "]"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"com", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{"StringContainsQ", "[", 
              RowBox[{"#", ",", 
               RowBox[{"\"\<(*\>\"", "~~", "__", "~~", "\"\<*)\>\""}]}], 
              "]"}], "&"}]}], "]"}], "&"}], "/@", "lines"}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"char", "=", 
      RowBox[{"StringLength", "[", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"Flatten", "[", "lines", "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Quiet", "@", 
      RowBox[{"Get", "[", "\"\<QMRITools`\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"nFunc", "=", 
      RowBox[{"Length", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"QMRIToolsFunctions", "[", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Grid", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<Number of Functions: \>\"", ",", "nFunc"}], "}"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"{", 
          
          RowBox[{"\"\<------------------------------------\>\"", ",", 
           "SpanFromLeft"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\"\<Total lines: \>\"", ",", "all"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\"\<Total non-empty lines: \>\"", ",", "lns"}], "}"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\"\<Total lines of help text: \>\"", ",", " ", "hlp"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\"\<Total lines off comments: \>\"", ",", " ", "com"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\"\<Total lines of code: \>\"", ",", " ", 
           RowBox[{"lns", "-", "hlp", "-", "com"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\"\<Total characters: \>\"", ",", " ", "char"}], "}"}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\"\<Average characters per line: \>\"", ",", " ", 
           RowBox[{"Round", "[", 
            RowBox[{"char", "/", "lns"}], "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], ",", 
       RowBox[{"Spacings", "->", 
        RowBox[{"{", 
         RowBox[{"1.5", ",", "1"}], "}"}]}], ",", 
       RowBox[{"Alignment", "->", "Left"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
