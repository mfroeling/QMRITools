Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FuncTable", "[", "list_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "tab", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tab", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"Intersection", "[", 
             RowBox[{"list", ",", 
              RowBox[{"Names", "[", 
               RowBox[{"#", "<>", "\"\<*\>\""}], "]"}]}], "]"}]}], "}"}], 
          "&"}], "/@", "QMRITools`$Contexts"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"TableForm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "===", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "None"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"PopupMenu", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}]}], "]"}], 
          "&"}], "/@", "tab"}], ",", 
        RowBox[{"TableHeadings", "->", 
         RowBox[{"{", 
          RowBox[{"None", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"#", ",", "Bold", ",", "Large"}], "]"}], "&"}], "/@", 
            RowBox[{"{", 
             RowBox[{"\"\<Toolbox\>\"", ",", "\"\<Functions\>\""}], "}"}]}]}],
           "}"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FuncButtonDel", "[", 
    RowBox[{"wrong_", ",", "symdir_"}], "]"}], ":=", 
   RowBox[{"DynamicModule", "[", 
    RowBox[{
     RowBox[{"{", "pressed", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pressed", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"True", ",", 
         RowBox[{"Length", "[", "wrong", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"DynamicModule", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"ii", ",", "n"}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"n", "=", 
               RowBox[{"wrong", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"ii", "=", "i"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Button", "[", 
               RowBox[{"n", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"pressed", "[", 
