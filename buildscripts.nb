      "\[IndentingNewLine]", 
      RowBox[{"buildDir", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"DirectoryName", "@", "location"}], ",", "\"\<build\>\"", 
