        "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"(*", "\n", 
   RowBox[{"(*", 
    RowBox[{"rebuild", " ", "HTML", " ", "doc", " ", "if", " ", "needed"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"OptionValue", "[", "RebuildHTMLDoc", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<   - Rebuilding html documentation\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Quiet", "@", 
        RowBox[{"PacletDocumentationBuild", "[", 
         RowBox[{"pac", ",", " ", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"DirectoryName", "@", "buildDir"}], ",", 
             RowBox[{"name", "<>", "\"\<-html\>\""}]}], "}"}], "]"}], 
          ",", "\"\<HTML\>\"", ",", 
