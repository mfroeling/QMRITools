         RowBox[{"Export", "[", 
          RowBox[{
           
           RowBox[{"\"\<build\\\\note_\>\"", "<>", "tag", 
            "<>", "\"\<.md\>\""}], ",", "note", ",", "\"\<Text\>\""}], "]"}], 
         "<>", "\"\<\\\"\\n\>\"", "<>", "\[IndentingNewLine]", "gitHub", 
         "<>", "\"\< release upload \>\"", "<>", "tag", "<>", "\"\< \\\"\>\"",
          "<>", "file", 
         "<>", "\"\<\\\"\\ngit commit -am \\\"update release \>\"", "<>", 
         "\[IndentingNewLine]", "tag", 
         "<>", "\"\<\\\" && git push\\nexit\\n\>\""}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "command", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"RunProcess", "[", 
