              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"dir", ",", "\"\<Build\>\""}], "}"}], "]"}]}], "]"}], 
            "]"}], ",", 
           RowBox[{"ForceVersionInstall", "->", "True"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", "\"\<   - Not installing the latest release\>\"", 
