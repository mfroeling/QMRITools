      RowBox[{"(*", 
       RowBox[{"get", " ", "filenames"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"filesApp", "=", 
       RowBox[{"Prepend", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"files", "=", 
