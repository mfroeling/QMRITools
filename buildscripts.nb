              RowBox[{"\"\<PacletSite.m\>\"", ",", "\"\<Package\>\""}], "}"}],
              "}"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
