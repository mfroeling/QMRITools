           RowBox[{
           "Print", "[", 
            "\"\<   - Cant push to GitHub not title or note is given\>\"", 
            "]"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
            "Print", "[", "\"\<   - Creating the release on GitHub\>\"", 
