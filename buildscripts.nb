 RowBox[{
  RowBox[{
   RowBox[{"CheckDocumentation", "[", "dir_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pac", ",", "symdir", ",", "guidedir", ",", "toolNames", ",", 
       "toolNamesS", ",", "context", ",", "functions", ",", "missingC", ",", 
       "missingG", ",", "missing", ",", "wrong", ",", "incomplete", ",", 
       "funName", ",", "inf"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"load", " ", "the", " ", "packlet"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pac", "=", 
       RowBox[{"LoadApplicationFolder", "[", "dir", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"PacletDirectoryLoad", "[", 
       RowBox[{"pac", "[", "\"\<Location\>\"", "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"PacletDataRebuild", "[", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Get", "[", "\"\<QMRITools`\>\"", "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"define", " ", "doc", " ", "directorys"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"symdir", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pac", "[", "\"\<Location\>\"", "]"}], 
          ",", "\"\<\\\\Documentation\\\\English\\\\ReferencePages\\\\Symbols\
\>\""}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"guidedir", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pac", "[", "\"\<Location\>\"", "]"}], 
          ",", "\"\<\\\\Documentation\\\\English\\\\Guides\>\""}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "toolbox", " ", "names"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"toolNames", "=", 
       RowBox[{"FileBaseName", "/@", 
        RowBox[{"FileNames", "[", 
         RowBox[{"\"\<*.wl\>\"", ",", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"pac", "[", "\"\<Location\>\"", "]"}], 
             ",", "\"\<\\\\kernel\>\""}], "}"}], "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"toolNamesS", "=", 
       RowBox[{"Sort", "@", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{"toolNames", ",", 
          RowBox[{"pac", "[", "\"\<Name\>\"", "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "contexts"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"context", "=", 
       RowBox[{"Sort", "@", 
        RowBox[{"ToExpression", "[", 
         RowBox[{
          RowBox[{"pac", "[", "\"\<Name\>\"", "]"}], 
          "<>", "\"\<`$Contexts\>\""}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "all", " ", "functions"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"functions", "=", 
       RowBox[{"Sort", "@", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Names", "[", 
            RowBox[{"#", "<>", "\"\<*\>\""}], "]"}], "&"}], "/@", "context"}],
          "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
      "Print", "[", "\"\<Checking all files and usage texts\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "check", " ", "if", " ", "all", " ", "toolboxes", " ", "are", " ", 
        "in", " ", "context"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"missingC", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "==", 
               RowBox[{"Last", "[", 
                RowBox[{"StringSplit", "[", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<`\>\""}], "]"}], 
                "]"}]}]}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"Thread", "[", 
           RowBox[{"{", 
            RowBox[{"toolNamesS", ",", "context"}], "}"}], "]"}]}], ",", 
         "Null"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "check", " ", "if", " ", "each", " ", "toolbox", " ", "has", " ", 
        "guide", " ", "pages"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"missingG", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"toolNames", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{"FileExistsQ", "[", 
              RowBox[{
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"guidedir", ",", "#"}], "}"}], "]"}], 
               "<>", "\"\<.nb\>\""}], "]"}], ")"}]}], ")"}], "&"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "check", " ", "if", " ", "all", " ", "functions", " ", "have", " ", 
        "symbol", " ", "page"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"missing", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"FileExistsQ", "[", 
             RowBox[{
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"symdir", ",", "#"}], "}"}], "]"}], 
              "<>", "\"\<.nb\>\""}], "]"}]}], ",", "#", ",", "Nothing"}], 
          "]"}], "&"}], "/@", "functions"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "check", " ", "if", " ", "usage", " ", "text", " ", "starts", " ", 
        "with", " ", "function", " ", "name", " ", "and", " ", "ends", " ", 
        "with", " ", "\"\<.\>\"", " ", "else", " ", "its", " ", "wrong"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
         "check", " ", "if", " ", "usage", " ", "text", " ", "ens", " ", 
          "with"}], " ", "..."}], " ", "which", " ", "indicates", " ", "work",
         " ", "in", " ", "progress"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wrong", ",", "incomplete"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"DeleteCases", "[", 
          RowBox[{"#", ",", "Null"}], "]"}], "&"}], "/@", 
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"funName", "=", "#"}], ";", "\[IndentingNewLine]", 
             RowBox[{"inf", "=", 
              RowBox[{
               RowBox[{"Information", "[", "funName", "]"}], 
               "[", "\"\<Usage\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"wrong", " ", "usage"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"inf", "===", "\"\<\>\""}], ",", "funName", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"inf", ",", 
                    RowBox[{"-", "1"}]}], "]"}], "=!=", "\"\<.\>\""}], "||", 
                    RowBox[{
                    RowBox[{"First", "[", 
                    RowBox[{"StringSplit", "[", 
                    RowBox[{"inf", ",", 
                    RowBox[{"\"\< \>\"", "|", "\"\<[\>\""}]}], "]"}], "]"}], "=!=",
                     "funName"}]}], ",", "funName"}], "]"}]}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"incomplete", " ", "usage"}], " ", "..."}], "*)"}], 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"StringLength", "[", "inf", "]"}], ">", "3"}], ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"StringTake", "[", 
                    RowBox[{"inf", ",", 
                    RowBox[{"-", "3"}]}], "]"}], "==", "\"\<...\>\""}], ",", 
                   "funName"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
              "}"}]}], "\[IndentingNewLine]", ")"}], "&"}], "/@", 
          "functions"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Toolbox Anaysis\>\"", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<   - There are \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Length", "@", "toolNamesS"}], "]"}], 
        "<>", "\"\< toolbox definitions.\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<   - There are \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Length", "@", "functions"}], "]"}], 
        "<>", "\"\< exposed functions or options.\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<   - There are \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Length", "@", "missingC"}], "]"}], 
        "<>", "\"\< missing toolboxes in context.\>\""}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<   - There are \>\"", "<>", 
