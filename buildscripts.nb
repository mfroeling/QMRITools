 RowBox[{
  RowBox[{
   RowBox[{"ApplicationBuild", "[", 
    RowBox[{"pac_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
      "location", ",", " ", "dir", ",", "tag", ",", "name", ",", " ", 
