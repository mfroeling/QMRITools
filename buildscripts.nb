       "pacs", ",", " ", "pacFiles", ",", " ", "exp", ",", " ", "gitHub", ",",
        " ", "command"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"get", " ", "packlet", " ", "information"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"location", "=", 
       RowBox[{"pac", "[", "\"\<Location\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dir", "=", 
       RowBox[{"DirectoryName", "@", "location"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"name", "=", 
       RowBox[{"pac", "[", "\"\<Name\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tag", "=", 
