         "<>", "\"\<\\ncd \>\"", "<>", "dir", "<>", "\"\<\\n\>\"", "<>", 
         "\[IndentingNewLine]", "gitHub", "<>", "\"\< release create \>\"", "<>",
          "tag", "<>", "\"\< --title \\\"\>\"", "<>", "title", 
