         RowBox[{"location", ",", "builDirhtml", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Alternatives", "@@", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "<>", "\"\<.nb\>\""}], "&"}], "/@", "names"}], 
               ")"}]}]}], "]"}], "&"}], ",", "\[IndentingNewLine]", 
          RowBox[{"\"\<UseLanguageExtension\>\"", "->", "False"}], ",", 
