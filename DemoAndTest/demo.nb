Cell[CellGroupData[{

Cell["Joining multiple stacks", "Subsection",
 CellChangeTimes->{{3.7548959535708256`*^9, 3.7548959678359003`*^9}, {
  3.7555791021749706`*^9, 
  3.7555791092126975`*^9}},ExpressionUUID->"6033b32e-4c89-4553-869f-\
3243e5607bf1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dataJ", ",", "voxJ"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"ImportNii", "/@", 
     RowBox[{"FileNames", "[", 
      RowBox[{"\"\<Join*.nii.gz\>\"", ",", "\"\<\>\""}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"overlap", "=", "5"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "number", " ", "of", " ", "slice", " ", "overlap", " ", "between", " ", 
    "stacks"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.755579130003971*^9, 3.755579220092123*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"a0948096-3a17-480e-88aa-5f8f54122f9a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"all", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ArrayPad", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"2", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "]"}], "&"}], "/@", 
      "dataJ"}], ",", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MakeSliceImages", "[", 
   RowBox[{
    RowBox[{"GetSliceData", "[", 
     RowBox[{"all", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "}"}], ",", 
        RowBox[{"{", "140", "}"}], ",", 
        RowBox[{"{", "}"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"voxJ", "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", 
    RowBox[{"ImageLegend", "\[Rule]", "True"}]}], "]"}], "[", 
  RowBox[{"[", "2", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.7584383745606956`*^9, 3.758438458513606*^9}, 
   3.758439203171208*^9},ExpressionUUID->"414b81d5-a5f7-405e-88ec-\
356977cae10c"],

Cell["\<\
With JoinSets multiple stacks which have overlapping slices can be joined \
into one set. 
If There is motion between the stacks this can be resolved using the option \
MotionCorrectSets which uses rigid registration of the overlap to align the \
sets.
Using JoinSetSplit the data can be split into a left and right side. \
\>", "Text",
 CellChangeTimes->{{3.75557935543929*^9, 3.7555794024582915`*^9}, {
  3.7555796023296337`*^9, 3.755579633544137*^9}, {3.758439242175694*^9, 
  3.7584392453430185`*^9}},ExpressionUUID->"7f20e0cc-33ba-4b02-a0c9-\
60eb0f4f1498"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Column", "@", 
  RowBox[{"Options", "@", "JoinSets"}]}]], "Input",
 CellChangeTimes->{{3.7555792952002583`*^9, 3.755579301563833*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"33670142-c814-4498-b5e7-7e7f8a967c11"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"ReverseSets", "\[Rule]", "True"}]},
    {
     RowBox[{"ReverseData", "\[Rule]", "True"}]},
    {
     RowBox[{"NormalizeSets", "\[Rule]", "True"}]},
    {
     RowBox[{"MotionCorrectSets", "\[Rule]", "False"}]},
    {
     RowBox[{"PaddOverlap", "\[Rule]", "2"}]},
    {
     RowBox[{"JoinSetSplit", "\[Rule]", "True"}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{
  3.755579302092767*^9, 3.755579923821715*^9, {3.7555810122430897`*^9, 
   3.755581028769208*^9}},
 CellLabel->"Out[51]=",ExpressionUUID->"2488a9a6-6b64-4f4c-ae24-a8f1bfc685b8"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"joined", "=", 
   RowBox[{"JoinSets", "[", 
    RowBox[{"dataJ", ",", "overlap"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.755579226890072*^9, 3.755579254219699*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"58d93156-a8c6-41f9-b9b1-fcef6a398386"],

Cell[BoxData[
 RowBox[{
  RowBox[{"joinedC", "=", 
   RowBox[{"JoinSets", "[", 
    RowBox[{"dataJ", ",", "overlap", ",", 
     RowBox[{"MotionCorrectSets", "\[Rule]", "True"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.755579226890072*^9, 3.755579254219699*^9}, {
  3.7555794661552687`*^9, 3.7555794729238205`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"e6b3fb20-ac33-4f43-b582-08fbcf2dfdcb"],

Cell["\<\
Using MotionCorrectSets->True is similar to using CorrectjoinSetMotion\
\>", "Text",
 CellChangeTimes->{{3.758439253411528*^9, 
  3.75843928223833*^9}},ExpressionUUID->"80e50c85-aa4a-47c4-beb7-\
0309b49cd6c2"],

