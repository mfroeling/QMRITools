    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"ApplyCrop", "[", 
        RowBox[{"#", ",", "crp"}], "]"}], "&"}], "/@", "tens"}], ")"}], "/.", 
    " ", 
    RowBox[{"0.", "\[Rule]", 
     RowBox[{"-", "1"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.755000323126373*^9, 3.7550004528731933`*^9}, 
   3.755000654989583*^9, {3.7555869291906013`*^9, 3.755586936545241*^9}, {
   3.758441889125291*^9, 3.7584419446473494`*^9}, 3.758441979190585*^9, {
