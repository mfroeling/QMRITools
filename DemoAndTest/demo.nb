         RowBox[{"tract", ",", "_Real", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"val", ",", "_Real", ",", "0"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Boole", "[", 
       RowBox[{"0", "<", 
        RowBox[{"Total", "[", 
         RowBox[{"UnitStep", "[", 
          RowBox[{"tract", "-", "val"}], "]"}], "]"}], "<", 
        RowBox[{"Length", "[", "tract", "]"}]}], "]"}], "\[IndentingNewLine]",
       ",", 
      RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}], ",", 
