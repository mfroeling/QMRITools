Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"Iterations", "\[Rule]", "250"}]},
    {
     RowBox[{"Resolutions", "\[Rule]", "1"}]},
    {
     RowBox[{"HistogramBins", "\[Rule]", "64"}]},
    {
     RowBox[{"NumberSamples", "\[Rule]", "2000"}]},
    {
