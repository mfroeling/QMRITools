 CellLabel->"In[59]:=",ExpressionUUID->"302b44be-ef86-48c9-aa2c-564b391aa0b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cleanMask2", "=", 
   RowBox[{"SmoothMask", "[", 
    RowBox[{"mask", ",", 
     RowBox[{"MaskComponents", "\[Rule]", "2"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.758435097834414*^9, 3.7584351036756153`*^9}},
