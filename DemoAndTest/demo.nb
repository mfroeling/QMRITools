     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", ".1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0.002"}], "}"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.758440831414627*^9, 3.7584408799931316`*^9}},
 CellLabel->
  "In[337]:=",ExpressionUUID->"18361a8d-0015-46b1-91d8-24b5e8b80e9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"res", "=", 
   RowBox[{"IVIMResiduals", "[", 
    RowBox[{"dwiIso", ",", "bval", ",", 
     RowBox[{"{", 
      RowBox[{"S0Ii", ",", "fracI", ",", "diff", ",", "pDiff"}], "}"}]}], 
    "]"}]}], ";"}]], "Input",
