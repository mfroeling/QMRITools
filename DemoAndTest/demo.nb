Cell[CellGroupData[{

Cell["ME-SE  (TSE) T2 mapping", "Subchapter",
 CellChangeTimes->{{3.7548951014856977`*^9, 3.754895112634607*^9}, {
  3.75489562596196*^9, 3.754895628456525*^9}, {3.7549025592745514`*^9, 
