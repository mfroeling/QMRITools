Cell[BoxData[{
 RowBox[{
  RowBox[{"b1", "=", 
   RowBox[{"N", "@", 
    RowBox[{"Range", "[", 
     RowBox[{".75", ",", "1.25", ",", ".05"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
