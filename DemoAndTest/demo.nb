      RowBox[{"water", ",", "maskw", ",", "voxW"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"fat", ",", "voxF"}], "}"}], ",", 
     RowBox[{"MethodReg", "\[Rule]", "\"\<affine\>\""}], ",", 
     RowBox[{"Iterations", "\[Rule]", "250"}], ",", " ", 
     RowBox[{"DeleteTempDirectory", "\[Rule]", "False"}]}], "]"}]}], 
  ";"}]], "Input",
