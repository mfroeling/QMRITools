Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tensT", "=", "tens"}], ";"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"int", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tracts", "=", 
     RowBox[{"FiberTractography2", "[", 
      RowBox[{"tens", ",", "dwivox", ",", "stop", ",", "\[IndentingNewLine]", 
       RowBox[{"FiberLengthRange", "->", 
        RowBox[{"{", 
         RowBox[{"10", ",", "400"}], "}"}]}], ",", 
       RowBox[{"FiberAngle", "->", "20"}], ",", "\[IndentingNewLine]", 
       RowBox[{"InterpolationOrder", "->", "int"}], ",", 
       RowBox[{"StepSize", "->", "1"}], ",", 
       RowBox[{"Method", "->", "\"\<Euler\>\""}], ",", 
       RowBox[{"MaxSeedPoints", "->", "50000"}], ",", "\[IndentingNewLine]", 
       RowBox[{"TensorFilps", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1", ",", "1"}], "}"}]}], ",", 
       RowBox[{"TensorPermutations", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}]}],
       "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
