 TagBox[GridBox[{
    {
     RowBox[{"Iterations", "\[Rule]", "500"}]},
    {
     RowBox[{"Resolutions", "\[Rule]", "1"}]},
    {
     RowBox[{"HistogramBins", "\[Rule]", "64"}]},
    {
