          RowBox[{
           RowBox[{
            RowBox[{"Round", "[", 
             RowBox[{"#", "/", "vox"}], "]"}], "&"}], "/@", "tract"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"roi", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "]"}], "&"}], "/@", 
           "pos"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"RuntimeAttributes", "->", 
       RowBox[{"{", "Listable", "}"}]}], ",", 
