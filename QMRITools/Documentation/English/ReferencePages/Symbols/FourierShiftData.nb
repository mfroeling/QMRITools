 Cell[BoxData[
  StyleBox["dy", "TI"]], "InlineFormula",ExpressionUUID->
  "c2f87ec4-9091-dc43-9bf2-d17644576c60"],
 " and dz. Output ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "bdc3f7d2-1c92-9846-93f1-c54d28248ed5"],
