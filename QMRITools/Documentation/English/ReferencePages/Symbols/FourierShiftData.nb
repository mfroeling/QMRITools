Cell["FourierShiftData", "ObjectName",
 CellID->987056828,ExpressionUUID->"32ce04ea-0a43-1842-869b-bb49a245cdfd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"12656d61-0738-dd49-a201-7fa8a2ade8fa"],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     ButtonBox["FourierShiftData",
      BaseStyle->"Link",
      ButtonData->"paclet:QMRIToolsReconstructionTools/ref/FourierShiftData"],
      "[", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["dz", "TI"], ",", 
        StyleBox["dy", "TI"], ",", 
        StyleBox["dx", "TI"]}], "}"}]}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"99507ae7-df43-6c4c-9d3a-84e22ab4a98e"],
