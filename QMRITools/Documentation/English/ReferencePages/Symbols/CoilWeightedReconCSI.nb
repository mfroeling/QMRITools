Cell[CellGroupData[{
Cell["CoilWeightedReconCSI", "ObjectName",
 CellID->87326381,ExpressionUUID->"3c4e4c82-4ea1-3748-ac50-594b44881602"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f9b1bc33-b849-3f4e-8b9b-9cf8daa753f3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CoilWeightedReconCSI",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsReconstructionTools/ref/CoilWeightedReconCSI"], "[", 
   RowBox[{
    StyleBox["kspace", "TI"], ",", 
    StyleBox["noise", "TI"], ",", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7d0408c0-a4cb-294e-9f54-9747baab976d"],
 "\[LineSeparator]performs reconstruction of raw 3D CSI data. The input ",
 Cell[BoxData[
  StyleBox["kspace", "TI"]], "InlineFormula",ExpressionUUID->
  "99a1170f-2609-194b-a228-6145c9a99946"],
 ", ",
 Cell[BoxData[
  StyleBox["noise", "TI"]], "InlineFormula",ExpressionUUID->
  "b3320326-9a97-814a-8fa3-9e7bffee9d7b"],
 " and ",
 Cell[BoxData[
  StyleBox["head", "TI"]], "InlineFormula",ExpressionUUID->
  "17be4de2-8c8f-b149-8260-89dd816d5e0e"],
 " are obtained using ",
 Cell[BoxData[
  ButtonBox["ReadListData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ReadListData"]], "InlineFormula",
  ExpressionUUID->"a6253d4d-4894-684b-a7dc-2f2e1d7be469"],
 ". The coil combination Methods can be \"Roemer\" or \"WSVD\"."
}], "Usage",
 CellChangeTimes->{{3.996655618647108*^9, 3.9966556187173367`*^9}},
 CellID->399926599,ExpressionUUID->"e9130f8f-f7e0-0943-8647-675f529a8477"],

Cell["The following options can be given: ", "Notes",
 CellID->103859140,ExpressionUUID->"1ff0e49e-d41f-e543-a35f-10ad5a3277a4"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
