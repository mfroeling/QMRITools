Notebook[{

Cell[CellGroupData[{
Cell["SimRotate", "ObjectName",
 CellID->324542441,ExpressionUUID->"1062c12d-58b9-484a-a04c-cab118647970"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8c7c671f-a0dc-9243-9cd8-067d18e04a69"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimRotate",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SimRotate"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"], " ", ",", 
    StyleBox["angle", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f6096252-cc4f-a34c-a3a9-476328716ef1"],
 "\[LineSeparator]rotates the spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "d45c3d0f-1d9e-b842-bc01-5cc9ea754bde"],
 " given the hamiltonian ham over ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",ExpressionUUID->
  "edd5857d-0c5b-b64c-ad15-5bd9eb0fb63b"],
 " with ",
 Cell[BoxData[
  StyleBox["phase", "TI"]], "InlineFormula",ExpressionUUID->
  "f4a1888e-8cfb-b340-83a4-254482866d67"],
 " 90 degrees. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e6aca38e-ea3d-a94e-9262-d2dc6be2e2df"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimRotate",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SimRotate"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"], " ", ",", 
    StyleBox["angle", "TI"], ",", 
    StyleBox["phase", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9eef8bd6-85ca-9846-ab4b-4f7fa8fa0c8c"],
 "\[LineSeparator]rotates the spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "d594e843-4eb7-f243-83c0-eaa2a7f53bdb"],
 " given the hamiltonian ham over ",
 Cell[BoxData[
  StyleBox["angle", "TI"]], "InlineFormula",ExpressionUUID->
  "3a07ff00-ad6d-9248-a30b-e5420e1201f9"],
 " with ",
 Cell[BoxData[
  StyleBox["phase", "TI"]], "InlineFormula",ExpressionUUID->
  "2fed6a6c-74f5-974f-b6ac-433d7319879a"],
 ". ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "bd2cfe7a-f0de-a64a-aca1-1782a69244f1"],
 " and ham are generated by ",
 Cell[BoxData[
  ButtonBox["SimHamiltonian",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SimHamiltonian"]], "InlineFormula",
  ExpressionUUID->"a65358bb-b651-954a-bd63-38322527ee82"],
 ". The angle and phase are defined in degree. The output is a new spin \
system dOut."
}], "Usage",
 CellChangeTimes->{{3.9966567746061325`*^9, 3.9966567748409576`*^9}},
