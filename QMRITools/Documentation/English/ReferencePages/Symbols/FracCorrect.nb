Notebook[{

Cell[CellGroupData[{
Cell["FracCorrect", "ObjectName",
 CellID->167381509,ExpressionUUID->"1eff2091-92f9-c546-abf8-c0080938b24d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"250ca53b-da49-cf45-a196-0c6998056956"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FracCorrect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/FracCorrect"], "[", 
   RowBox[{
    StyleBox["fraction", "TI"], ",", 
    StyleBox["time", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2b719d93-d238-9048-93e9-db0cb6c3b900"],
 "\[LineSeparator]corrects the signal ",
 Cell[BoxData[
  StyleBox["fraction", "TI"]], "InlineFormula",ExpressionUUID->
  "5821ace7-8f58-2241-ad9a-9cc8c8ddf844"],
 " calculated with the IVIM model for tissue relaxation and acquisition \
parameters. After correction the signal ",
 Cell[BoxData[
  StyleBox["fraction", "TI"]], "InlineFormula",ExpressionUUID->
  "8291ae29-60b8-244c-a678-5c93af984b22"],
 " can be regarded as volume ",
 Cell[BoxData[
  StyleBox["fraction", "TI"]], "InlineFormula",ExpressionUUID->
  "9a363f81-c086-5541-8f94-4019a752179a"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"04c915ed-5e1a-a948-8e3b-08ada616fb82"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FracCorrect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/FracCorrect"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["fraction", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["fraction", "TI"], 
       StyleBox["2", "TR"]]}], "}"}], ",", 
    StyleBox["time", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3cd10d56-4b8b-f447-affe-41469fc0046b"],
 "\[LineSeparator]corrects the signal fraction1 and fraction2 from a 3 \
compartment IVIM model. ",
 Cell[BoxData[
  StyleBox["time", "TI"]], "InlineFormula",ExpressionUUID->
  "1b152d9b-fd3d-904f-99e5-3eb9d0ce9d20"],
 " is {{te, tr}, {t2t, t21}, {t1t, t11}} or {{te, tr}, {t2t, t21, t22}, {t1t, \
t11, t12}}. where t2t and t1t are \"tissue\" relaxation times and t11 t12, \
t21 and t22 the \"fluid\" relaxation times. The te and tr as well as the \
relaxation times T2 and T1 can be defines in any ",
 Cell[BoxData[
  StyleBox["time", "TI"]], "InlineFormula",ExpressionUUID->
  "ab88d05a-1f48-0747-93a2-b793067dd302"],
 " unit as long as they are consistant for all, e.g. all in ms. output is the \
corrected ",
 Cell[BoxData[
  StyleBox["fraction", "TI"]], "InlineFormula",ExpressionUUID->
  "71f0f41e-a186-0f4e-9161-8c98182b24da"],
 " maps."
}], "Usage",
 CellChangeTimes->{{3.996656693637251*^9, 3.996656693833908*^9}},
 CellID->202570,ExpressionUUID->"994d01e6-feeb-a746-8ddf-9245994acafd"],

