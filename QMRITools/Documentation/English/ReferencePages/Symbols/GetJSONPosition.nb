Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0b526e66-ad4f-cc4b-a198-91ea197de73e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetJSONPosition",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/GetJSONPosition"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["json", "TI"], ".."}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["key", "TI"], ",", 
        StyleBox["value", "TI"]}], "}"}], ".."}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"a7c89688-593f-ea43-b62d-49da4029150e"],
 "\[LineSeparator]gets the position from a list of JSON association lists \
where keys have the given value. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ba73ebb3-d529-1a46-9682-530a3ec2fbba"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetJSONPosition",
    BaseStyle->"Link",
