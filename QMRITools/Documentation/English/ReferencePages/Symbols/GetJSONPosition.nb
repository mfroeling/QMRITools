   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["json", "TI"], ".."}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["key", "TI"], ",", 
        StyleBox["value", "TI"]}], "}"}], ".."}], "}"}], ",", 
    StyleBox["sortKey", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "df3c21b4-82d4-d547-8bd2-8749b4f00c6d"],
