Cell["FlipGradientOrientation", "ObjectName",
 CellID->17142352,ExpressionUUID->"7fecf464-4c7f-284d-b202-0b137cfda009"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"516f2c15-543b-de48-bc1f-fe05d6ad83da"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipGradientOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipGradientOrientation"], "[", 
   RowBox[{
    StyleBox["grad", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "22c93e65-5f44-2445-8f87-db608c3d640c"],
 "\[LineSeparator]permutes the internal orientation of the gradients, ",
 Cell[BoxData[
  StyleBox["perm", "TI"]], "InlineFormula",ExpressionUUID->
  "848e017c-b0cb-be4b-8fe8-a0fe1ee09085"],
 " can be any permutation of {\"x\",\"y\",\"z\"}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"428f3bc6-759a-c743-a68b-aad961ede03c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipGradientOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipGradientOrientation"], "[", 
   RowBox[{
    StyleBox["grad", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "101cf294-d3e6-9544-94da-5a213e4be997"],
 "\[LineSeparator]flips the internal orientation of the gradients, ",
 Cell[BoxData[
  StyleBox["flip", "TI"]], "InlineFormula",ExpressionUUID->
  "330c9a94-0174-b042-91a4-51e5af9c5542"],
 " can be {1,1,1}, {-1,1,1}, {1,-1,1} or {1,1,-1}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"97a24ca6-e361-f74f-ad68-b6a49302b068"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipGradientOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipGradientOrientation"], "[", 
   RowBox[{
    StyleBox["grad", "TI"], ",", 
    StyleBox["flip", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dc94dc70-e47c-8245-a088-bffac3475d02"],
 "\[LineSeparator]flips and permutes the internal orientation of the \
gradients. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4a2d0f21-a1bb-674c-a04b-44a8587b97e7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipGradientOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipGradientOrientation"], "[", 
   RowBox[{
    StyleBox["grad", "TI"], ",", 
    StyleBox["perm", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "21ba688c-c58e-114f-84af-c89123106580"],
 "\[LineSeparator]flips and permutes the internal orientation of the \
gradients."
}], "Usage",
