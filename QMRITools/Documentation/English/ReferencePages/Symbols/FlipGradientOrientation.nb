Cell["FlipGradientOrientation", "ObjectName",
 CellID->136839049,ExpressionUUID->"ddc886d8-80c9-2c4e-9ca7-955b8f9a9fa9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7b46f57b-c100-104f-a52e-8a22ebe98aeb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipGradientOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipGradientOrientation"], "[", 
   RowBox[{
    StyleBox["grad", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "854b9691-d623-8e40-81de-1d8ecbe73f33"],
 "\[LineSeparator]permutes the internal orientation of the gradients, ",
 Cell[BoxData[
  StyleBox["perm", "TI"]], "InlineFormula",ExpressionUUID->
  "1fae7786-fc13-324b-92c0-b6c8e682b5bf"],
 " can be any permutation of {\"x\",\"y\",\"z\"}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"17fedf3a-b791-3d4f-b8ae-b7db07e00f08"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipGradientOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipGradientOrientation"], "[", 
   RowBox[{
    StyleBox["grad", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4f6e0a19-d329-3d4b-907b-faf8d9d1e624"],
 "\[LineSeparator]flips the internal orientation of the gradients, ",
 Cell[BoxData[
  StyleBox["flip", "TI"]], "InlineFormula",ExpressionUUID->
  "12c65eed-2544-4e4c-b544-b4e8a0aaad0c"],
 " can be {1,1,1}, {-1,1,1}, {1,-1,1} or {1,1,-1}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c23a289e-7078-794d-b916-8fb8ecc7a13a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipGradientOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipGradientOrientation"], "[", 
   RowBox[{
    StyleBox["grad", "TI"], ",", 
    StyleBox["flip", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "200e17ae-ec58-2a4b-b4cd-058eacff7f62"],
 "\[LineSeparator]flips and permutes the internal orientation of the \
gradients. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"77707d0e-8f6b-b74f-b607-e9aa1428c122"],
 Cell[BoxData[
  RowBox[{
