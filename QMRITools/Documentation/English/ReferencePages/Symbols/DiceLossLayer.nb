Notebook[{

Cell[CellGroupData[{
Cell["DiceLossLayer", "ObjectName",
 CellID->12607559,ExpressionUUID->"eecf6266-389e-5542-9e5d-30f08c3dceb8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f54ed71-e7ef-354f-8313-be35bdb92abe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiceLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/DiceLossLayer"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "536d9717-811f-5642-b640-21ca08a73734"],
 "\[LineSeparator]represents a net layer that computes the Dice loss by \
comparing input class probability vectors with the target class vector. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e4e07f5b-8981-0247-a757-aed19b3b6819"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DiceLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/DiceLossLayer"], "[", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6e9219a2-bc63-ac40-9c38-4df9a3ee3058"],
 "\[LineSeparator]does the same but n defines the power of the denominator, \
with n=2 the squared dice score, is calculated."
}], "Usage",
 CellChangeTimes->{{3.9966565866808147`*^9, 3.996656586733776*^9}},
 CellID->130266848,ExpressionUUID->"2db04ce7-5284-2c44-88b5-25f0b73b7b82"],

