Notebook[{

Cell[CellGroupData[{
Cell["AddLossLayer", "ObjectName",
 CellID->42744409,ExpressionUUID->"abe69db7-406b-d549-bff3-25d0169e86c4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b69e80a8-83f4-d144-838a-3255f2f0f246"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AddLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/AddLossLayer"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a3008bd6-98cc-984d-8f23-a9770a08498b"],
 "\[LineSeparator]adds all ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "c2b869cd-8f6b-5740-8bee-98d360012d05"],
 " layers to a NetGraph. The \
DiceLossLayer,JaccardLossLayer,TverskyLossLayer,MSDLossLayer,TopK,and ",
 Cell[BoxData[
  ButtonBox["CELossLayer",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CELossLayer"]], "InlineFormula",
  ExpressionUUID->"14381723-08ef-6f46-94b1-a359470dd570"],
 " are added. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"de01d0a6-72e8-7548-a583-fa763e227418"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AddLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/AddLossLayer"], "[", 
   RowBox[{
    StyleBox["net", "TI"], ",", 
    StyleBox["loss", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "696c964e-e232-9e4d-a3a8-501f6360b6af"],
 "\[LineSeparator]only adds the ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "de5ff5b2-e176-5d49-ab1f-fee48594d2d1"],
 " layers given in ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "2801d72f-cd17-5d46-a8d6-d730d333fd6e"],
 ", ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "6ea20feb-bad4-f047-b12f-dce57a45c589"],
 " can be a string or a list of strings chosen from {\"Dice\", \"Jaccard\", \
\"Tversky\", \"MSD\", \"MAE\", \"MSDM\", \"MAEM\", \"CE\", \"Focal\", \
\"TopK\"}. \"MSDM\" and \"MAEM\" are the masked versions of \"MSD\" and \"MAE\
\": the ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "9e244dd6-857d-e14a-b66f-0218fff3557d"],
 " is only computed over the part of the target that is nonzero."
}], "Usage",
 CellChangeTimes->{{3.9985331875752754`*^9, 3.9985331879709473`*^9}},
 CellID->14104238,ExpressionUUID->"2377ada5-4b54-f643-ae70-c82b21659f85"],

