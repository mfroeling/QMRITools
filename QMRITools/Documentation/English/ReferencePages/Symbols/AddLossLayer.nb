Notebook[{

Cell[CellGroupData[{
Cell["AddLossLayer", "ObjectName",
 CellID->73346840,ExpressionUUID->"b6d4f3e5-a19d-5e41-ba32-8d696b793cbf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fe8e023d-960c-6147-9348-5fceb88846cd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AddLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/AddLossLayer"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1bf603ab-0289-724a-98cf-770effc5bb62"],
 "\[LineSeparator]adds all ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "f2e7f77c-6a04-6846-a19e-cd619b68254f"],
 " layers to a NetGraph. The \
DiceLossLayer,JaccardLossLayer,TverskyLossLayer,MSDLossLayer,TopK,and \
CELossLayer are added. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d46be52c-8a83-b948-a27c-2f36d2efadf8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AddLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/AddLossLayer"], "[", 
   RowBox[{
    StyleBox["net", "TI"], ",", 
    StyleBox["loss", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c8d5d88b-71fd-be48-9f46-b678ba6a6edd"],
 "\[LineSeparator]only adds the ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "ad8e08f9-a8e8-dd4d-81a8-8761645fbc5b"],
 " layers given in ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "54f6ac2e-436c-4143-9218-0605ba82ca1c"],
 ", ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "1000d6cb-b229-e34e-9849-65daaf8dce5e"],
 " can be a string or a list of strings chosen from {\"Dice\", \"Jaccard\", \
\"Tversky\", \"MSD\", \"MAE\", \"MSDM\", \"MAEM\", \"CE\", \"Focal\", \
\"TopK\"}. \"MSDM\" and \"MAEM\" are the masked versions of \"MSD\" and \"MAE\
\": the ",
 Cell[BoxData[
  StyleBox["loss", "TI"]], "InlineFormula",ExpressionUUID->
  "5d6999ce-0fb4-b140-9f30-8a6ee17320c2"],
 " is only computed over the part of the target that is nonzero."
}], "Usage",
 CellChangeTimes->{{4.003804491033825*^9, 4.003804491190218*^9}},
 CellID->635192355,ExpressionUUID->"8373c63b-2944-5240-97a3-93048475ab76"],

