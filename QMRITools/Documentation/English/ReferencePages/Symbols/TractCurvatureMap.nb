    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ddbcc145-17e1-324f-bb01-417bca550ccb"],
