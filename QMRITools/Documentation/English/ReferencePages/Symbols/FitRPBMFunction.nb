Notebook[{

Cell[CellGroupData[{
Cell["FitRPBMFunction", "ObjectName",
 CellID->214576295,ExpressionUUID->"85b7153c-ac39-f34e-8b00-77422b50b2f5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"78ee58a3-3761-954c-aa30-26389384b677"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FitRPBMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FitRPBMFunction"], "[", 
   RowBox[{
    StyleBox["tms", "TI"], ",", 
    StyleBox["dat", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "10def5c8-aecb-e340-bf84-73992b8b0064"],
 "\[LineSeparator]fits the RPBM function to the data ",
 Cell[BoxData[
  StyleBox["dat", "TI"]], "InlineFormula",ExpressionUUID->
  "511a6500-4387-c749-99d6-ea9120a27881"],
 " using the mixing times ",
 Cell[BoxData[
  StyleBox["tms", "TI"]], "InlineFormula",ExpressionUUID->
  "8944b969-50e5-b744-8cb4-1bc86e979b51"],
 " using FindMinimum. The output is a rule of the fitted parameters {d0->val, \
tau-> tau, zeta ->zeta}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2907a829-6b19-6e44-a9c4-fe989cb89c7f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FitRPBMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FitRPBMFunction"], "[", 
   RowBox[{
    StyleBox["tms", "TI"], ",", 
    StyleBox["dat", "TI"], ",", 
    StyleBox["init", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fe6c2cf7-ef5c-7448-9a09-3d6c81429031"],
 "\[LineSeparator]does the same but uses ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "a06544a2-d25b-5045-9b3e-7eb88634acca"],
 " as initial guess values. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"11b08589-27cd-3b46-b9a5-500925bc8796"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FitRPBMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FitRPBMFunction"], "[", 
   RowBox[{
    StyleBox["tms", "TI"], ",", 
    StyleBox["dat", "TI"], ",", 
    StyleBox["init", "TI"], ",", 
    StyleBox["fix", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e89b50fd-62a5-5044-8987-b6130eebe67b"],
 "\[LineSeparator]does the same but uses ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "505a5613-8cbe-3a4e-a772-a16bd1679365"],
 " as initial guess values and fixes the parameters in ",
 Cell[BoxData[
  StyleBox["fix", "TI"]], "InlineFormula",ExpressionUUID->
  "fd42bea2-e687-2345-ae31-6a94cfea94f7"],
 "."
}], "Usage",
