Cell[CellGroupData[{
Cell["Mask", "ObjectName",
 CellID->491329679,ExpressionUUID->"3511f2ec-da11-7f42-bc2a-5d5e903f9064"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8ec98346-f394-6041-a1ed-e9ab458570ec"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/Mask"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "61985f00-71c0-6d4f-9e42-8582e6ac7edf"],
 "\[LineSeparator]creates a mask by automatically finding a threshold. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"eb481739-57a2-fb41-958e-7ecd9f08dbc4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/Mask"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["min", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "28d919f2-173f-cd41-a61a-fbe7e8c0b637"],
 "\[LineSeparator]creates a mask which selects only ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "20840716-9470-ab40-a9c2-18f801d4a2cc"],
 " above the ",
 Cell[BoxData[
  StyleBox["min", "TI"]], "InlineFormula",ExpressionUUID->
  "431536d7-6403-c24d-817f-7cf407e7f888"],
 " value. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"12afcc19-7922-bb40-b9ed-f1889ce86be2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/Mask"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["min", "TI"], ",", 
      StyleBox["max", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"293a17ca-a907-5c48-8e9f-40728bf4a3e9"],
 "\[LineSeparator]creates a mask which selects ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "f149f8cb-dc4f-164e-a547-6448a193f013"],
 " between the ",
 Cell[BoxData[
  StyleBox["min", "TI"]], "InlineFormula",ExpressionUUID->
  "48a83c13-ab67-f848-b93b-1300159b9ad2"],
 " and max value."
}], "Usage",
 CellChangeTimes->{{3.9985332463796597`*^9, 3.998533246744913*^9}},
