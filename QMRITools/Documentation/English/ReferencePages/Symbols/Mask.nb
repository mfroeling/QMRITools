      "e2e34c7d-1a9c-f74d-abe1-e2d4a1c6ee06"],
     ", Smooth",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "f51ec750-efbc-2347-97d2-5b2a9a22f621"],
     " and SmoothSegmentation. Determines the amount of largest clusters used \
as mask."
    }], "TableText",ExpressionUUID->"4fd090bb-cedb-0643-8152-6b5c19141413"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e1655931-7b5a-1443-8f74-ff7b32484015"], 
    ButtonBox["MaskClosing",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMaskingTools/ref/MaskClosing"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "e6b76493-00fb-6d4e-a797-c64a8146b673"],
     "Closing is an option for ",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "2a7b55d2-c4a8-244e-bf22-ac6237cd04b7"],
     ", Smooth",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "6c4c3137-4ab3-b240-b3f4-edde35f6dbf4"],
     " and SmoothSegmentation. The size of the holes in the mask that will be \
closed."
    }], "TableText",ExpressionUUID->"a86e82f4-612e-8947-986f-d6f5c5423257"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d90ac026-fe6d-474f-a8f3-16c14ef538f9"], 
    ButtonBox["MaskFiltKernel",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMaskingTools/ref/MaskFiltKernel"], "2", 
    Cell[TextData[{
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "1561b68a-7b98-2d41-b773-7aee4d3b3e75"],
     "FiltKernel is an option for ",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "93d7dccb-3d8e-c348-b781-c70aeee6b1f7"],
     ", Smooth",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "978241b1-43fd-1742-bb11-ba8b40a0515d"],
     " and SmoothSegmentation. How much the contours are smoothed."
    }], "TableText",ExpressionUUID->"f0807133-060f-d64c-9854-4d081a919924"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ec5f181a-b032-4240-8c7e-c6bbac86e7e0"], 
    ButtonBox["MaskDilation",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMaskingTools/ref/MaskDilation"], "0", Cell[
    TextData[{
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "fa134554-4eaf-0741-b222-704df4f3db5a"],
     "Dilation is an option for ",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "8b107822-bd55-aa49-9a9c-9d8f35861dc6"],
     ", Smooth",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "9dce37c7-c0a1-3741-b7af-76ed6cf9126f"],
     " and SmoothSegmentation. If the value is greater than 0 it will dilate \
the mask, if the value is smaller than 0 it will erode the mask."
    }], "TableText",ExpressionUUID->"ee304190-7d5d-744c-96f4-f8427a43ad8f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e6df542a-c5b1-1446-be71-fe9535c32718"], 
    ButtonBox["SmoothIterations",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMaskingTools/ref/SmoothIterations"], "3", 
    Cell[TextData[{
     "SmoothIterations is an option for ",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "c25647b9-5fe7-b64b-b9aa-137ff6221a04"],
     ", Smooth",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "70d7f692-ba00-db44-9b33-4649d09c7241"],
     " and SmoothSegmentation and defines how often the smoothing is repeated."
    }], "TableText",ExpressionUUID->"93c6d3d4-199c-d044-82c4-2c30d21dfa32"]}
  }]], "3ColumnTableMod",
