  "19f73411-97f0-8a40-9091-6e0ac69fa8b4"],
 "\[LineSeparator]creates a mask by automatically finding a threshold. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6ed1350b-4013-5d4f-bf5c-d1fa63911b8b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/Mask"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["min", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3628f9ef-5b37-bd42-b2b2-ace141a34d7c"],
 "\[LineSeparator]creates a mask which selects only ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "af241420-b2cc-024f-bf60-a8fd66496b53"],
 " above the ",
 Cell[BoxData[
  StyleBox["min", "TI"]], "InlineFormula",ExpressionUUID->
  "3ec8f712-fb59-dc40-8420-25f0a125a07c"],
 " value. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e6421030-5425-2547-bc44-9b56434e12b4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/Mask"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["min", "TI"], ",", 
      StyleBox["max", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"5671b456-9ad1-cb44-87bd-d1d7f5189761"],
 "\[LineSeparator]creates a mask which selects ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "0f77280e-d104-d348-a232-a25df95c2a75"],
 " between the ",
 Cell[BoxData[
  StyleBox["min", "TI"]], "InlineFormula",ExpressionUUID->
  "84c95348-c103-2b4c-ba78-6eed3048d64e"],
 " and max value."
}], "Usage",
