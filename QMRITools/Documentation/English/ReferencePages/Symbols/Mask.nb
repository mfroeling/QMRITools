      "6e450d11-48ad-8748-9b72-e13910544d8c"],
     " and SmoothSegmentation, if set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "4535a804-cd8f-f84f-ad3d-459480b347a2"],
     " it smooths the mask, by closing holes and smoothing the contours."
    }], "TableText",ExpressionUUID->"762258d7-c16b-664e-a96a-0e41707e9bf7"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
