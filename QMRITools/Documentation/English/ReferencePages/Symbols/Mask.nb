Cell[CellGroupData[{
Cell["Mask", "ObjectName",
 CellID->5597711,ExpressionUUID->"e713adf4-de27-ed43-ad06-272df8f2bd03"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b051f25d-de14-e944-ad54-bbb09c8ee9c4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/Mask"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "114008f1-01ca-5042-8e93-507cca56ea7b"],
 "\[LineSeparator]creates a mask by automatically finding a threshold. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"371bc700-d780-724e-8592-f3a5940dcaeb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/Mask"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["min", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f97ff90f-2164-cf43-84ce-25fbb6dc4ea7"],
 "\[LineSeparator]creates a mask which selects only ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "bd5b1c1e-8d0f-d749-a1e7-2cbf1d35febd"],
 " above the ",
 Cell[BoxData[
  StyleBox["min", "TI"]], "InlineFormula",ExpressionUUID->
  "69427166-6d64-7f42-a16f-c77c16c749df"],
 " value. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"97093063-f05d-b041-ba4f-7b104423a025"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Mask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/Mask"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["min", "TI"], ",", 
      StyleBox["max", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"8b1409bc-52bc-c840-970c-948b66f65746"],
 "\[LineSeparator]creates a mask which selects ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "c0dd5567-3312-b54c-94cb-dfaaa38de0c3"],
 " between the ",
 Cell[BoxData[
  StyleBox["min", "TI"]], "InlineFormula",ExpressionUUID->
  "2291ee23-04ab-d04a-8da5-05b253777d39"],
 " and max value."
}], "Usage",
 CellChangeTimes->{{4.003804545459059*^9, 4.0038045456539783`*^9}},
 CellID->437549222,ExpressionUUID->"b26a8727-e796-e041-b43e-2ebe889e9228"],

