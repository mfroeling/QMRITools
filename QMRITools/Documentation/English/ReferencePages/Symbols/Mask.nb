     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "62b10c24-2855-5e40-95b8-60d299885f20"],
     "Smoothing is an options for ",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "1ed9ee46-e610-1943-949e-97c51851003c"],
     ", Smooth",
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "0425bc7b-005f-ef42-8b47-d8196879e679"],
     " and SmoothSegmentation, if set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "3864a534-2e15-6b42-bf28-b917e58387ab"],
     " it smooths the mask, by closing holes and smoothing the contours."
    }], "TableText",ExpressionUUID->"efa8ae13-9748-4644-9645-1caee1bf8443"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ced07fa4-349b-9041-b945-2f868ec97b2d"], 
    ButtonBox["MaskComponents",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMaskingTools/ref/MaskComponents"], "2", 
    Cell[TextData[{
     Cell[BoxData[
     "Mask"], "InlineFormula",ExpressionUUID->
      "54073d76-d805-a64e-9c73-c24e21c87a6b"],
