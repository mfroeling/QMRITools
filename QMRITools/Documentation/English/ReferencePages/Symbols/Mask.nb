Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2a68db76-d8be-8647-a014-a3e9f3efa7db"], 
    ButtonBox["MaskSmoothing",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMaskingTools/ref/MaskSmoothing"], 
    ButtonBox["False",
