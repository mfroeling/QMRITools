Cell[CellGroupData[{
Cell["SurfaceDistance", "ObjectName",
 CellID->58297219,ExpressionUUID->"de9abd8b-c975-4349-8f28-8d35a7547ba4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6edb970d-f199-254d-a50d-2ff092b9a367"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SurfaceDistance",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SurfaceDistance"], "[", 
   RowBox[{
    StyleBox["ref", "TI"], ",", 
    StyleBox["pred", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "95c88c8b-50d3-2b4f-88ad-8fe402cd4655"],
 "\[LineSeparator]gives the surface distance of segmentations ",
 Cell[BoxData[
  StyleBox["ref", "TI"]], "InlineFormula",ExpressionUUID->
  "33bb8616-aeb2-a046-bff6-10c37dba5554"],
 " and ",
 Cell[BoxData[
  StyleBox["pred", "TI"]], "InlineFormula",ExpressionUUID->
  "9ce204c8-f180-7d4c-8197-2157ebca9478"],
 " for ",
 Cell[BoxData[
  StyleBox["class", "TI"]], "InlineFormula",ExpressionUUID->
  "08b029b0-172d-0249-afbd-defa4fc16c3a"],
 " 1, assuming isotropic unit voxels. Use the ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "1ba2b27b-d627-9e4a-9705-c90d86c89618"],
 " argument for correct physical distances. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ba0caf17-46d9-fc48-bb5f-ccbe2a3538fc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SurfaceDistance",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SurfaceDistance"], "[", 
   RowBox[{
    StyleBox["ref", "TI"], ",", 
    StyleBox["pred", "TI"], ",", 
    StyleBox["class", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "62355de1-12f2-004b-9269-24baff2bc64e"],
 "\[LineSeparator]gives the surface distance for the given integer ",
 Cell[BoxData[
  StyleBox["class", "TI"]], "InlineFormula",ExpressionUUID->
  "21133673-548b-5046-a41a-50622368a410"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"daa48e1c-d117-d94b-90d4-49ac7503fe43"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SurfaceDistance",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SurfaceDistance"], "[", 
   RowBox[{
    StyleBox["ref", "TI"], ",", 
    StyleBox["pred", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["class", "TI"], ",", ".."}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"23827cb2-30ef-9744-bbd8-60b5f6e57a70"],
 "\[LineSeparator]gives the surface distance for each ",
 Cell[BoxData[
  StyleBox["class", "TI"]], "InlineFormula",ExpressionUUID->
  "dc8e10cf-eb9f-854d-8f90-387f64ffd592"],
 " in the list. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"97e5cad7-8843-f449-8462-370b21b5db68"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SurfaceDistance",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SurfaceDistance"], "[", 
   RowBox[{
    StyleBox["ref", "TI"], ",", 
    StyleBox["pred", "TI"], ",", 
    StyleBox["class", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5b82b131-7b64-294e-8fe7-34b0718adb5d"],
 "\[LineSeparator]gives the surface distance in millimeters using voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "a16025d5-1278-b247-aaa5-b772aaf8f83f"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"11f30a85-8061-1647-bcf2-edd70f557b35"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SurfaceDistance",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SurfaceDistance"], "[", 
   RowBox[{
    StyleBox["ref", "TI"], ",", 
    StyleBox["pred", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["class", "TI"], ",", ".."}], "}"}], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a4354ba4-1740-5d45-96f7-c2e72bdb4823"],
 "\[LineSeparator]does the same for a list of classes. The Method option \
controls the distance metric: \"Mean\", \"Median\", \"RMS\", \"HD\", \"HD95\" \
(default), or \"Std\". A list of methods can be given to return multiple \
metrics at once."
}], "Usage",
 CellChangeTimes->{{3.996656276799488*^9, 3.996656277244753*^9}},
 CellID->60200174,ExpressionUUID->"3227593d-b9a0-6d40-a8d5-715ebd8f8a55"],

Cell["The following options can be given: ", "Notes",
 CellID->878798,ExpressionUUID->"9ebb3a12-7387-6d42-8e9c-0d09dc2ac0c4"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0411add9-bd7d-af44-939e-cc46960c665e"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<HD95\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"21dbb8a2-fa13-8545-973d-be47e0449a0b"]}
  }]], "3ColumnTableMod",
 CellID->507926389,ExpressionUUID->"8cffe59a-efc8-ad45-9f6e-60799c7b3af3"]
}, Open  ]],

