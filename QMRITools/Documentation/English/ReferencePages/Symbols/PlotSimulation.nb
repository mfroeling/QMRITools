 CellID->106025310,ExpressionUUID->"3fccfe95-b562-a74d-81cb-d9dbd0f1b999"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da817009-ddc0-0545-8c2d-c7f028742e5f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotSimulation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/PlotSimulation"], "[", 
   RowBox[{
    StyleBox["pars", "TI"], ",", 
    StyleBox["xval", "TI"], ",", 
    StyleBox["true", "TI"], ",", 
    StyleBox["label", "TI"], ",", 
    StyleBox["color", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ba7ca11e-3eba-4d44-82f6-1c4a2dd76159"],
 "\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["pars", "TI"]], "InlineFormula",ExpressionUUID->
  "3dea67c0-2479-3342-bded-eec2d257b32a"],
 " (output form Parameters). Using ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "e5522e0a-220b-a242-a538-c49fbeab9614"],
 " as PlotLabel and ",
 Cell[BoxData[
  StyleBox["xval", "TI"]], "InlineFormula",ExpressionUUID->
  "0a552a00-209d-db47-b922-cbf5b7fa88e5"],
 " as x axis thicks. tr are the ",
 Cell[BoxData[
  StyleBox["true", "TI"]], "InlineFormula",ExpressionUUID->
  "e9de3ef2-773c-c448-b4f2-be0861242fe9"],
 " parameter values. ",
 Cell[BoxData[
  StyleBox["color", "TI"]], "InlineFormula",ExpressionUUID->
  "eb97fb84-b9a1-c64e-904d-0f79105fa1f3"],
 " are the ",
 Cell[BoxData[
  StyleBox["color", "TI"]], "InlineFormula",ExpressionUUID->
  "b6b6eb75-5f82-4745-92c7-464474c3c55a"],
 " used for the plot."
}], "Usage",
