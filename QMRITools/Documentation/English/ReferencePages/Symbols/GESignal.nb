Cell[CellGroupData[{
Cell["GESignal", "ObjectName",
 CellID->731683956,ExpressionUUID->"ffd6613a-13e6-3a4c-b3b4-c6dfc3aab9be"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f3ddac5-80d1-f745-a7f1-db6c6d0dcb4f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GESignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/GESignal"], "[", 
   RowBox[{
    StyleBox["ang", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["tr", "TI"], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["1", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"032ca239-f011-694a-8e50-90b2443e0c9d"],
 "\[LineSeparator]calculates the gradient echo signal for flip angles ",
 Cell[BoxData[
  StyleBox["ang", "TI"]], "InlineFormula",ExpressionUUID->
  "1388494f-5a1b-c241-b02d-4c3d2ac4c8b7"],
 " using tr and t1. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"916fa740-0a61-9b42-a129-765e320cf527"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GESignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/GESignal"], "[", 
   RowBox[{
    StyleBox["ang", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         StyleBox["tr", "TI"], 
         StyleBox["1", "TR"]], ",", 
        SubscriptBox[
         StyleBox["tr", "TI"], 
         StyleBox["2", "TR"]]}], "}"}], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["1", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"63f0f1ec-7f70-ab49-8ada-ecd52508f9c1"],
 "\[LineSeparator]calculates the dual tr gradient echo signal for flip angles \
",
 Cell[BoxData[
  StyleBox["ang", "TI"]], "InlineFormula",ExpressionUUID->
  "8c501b9d-472a-0449-9fab-480692001f81"],
 " using tr1, tr2 and t1. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1b35571e-3a9a-2145-a797-29e7e94c9949"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GESignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/GESignal"], "[", 
   RowBox[{
    StyleBox["ang", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         StyleBox["tr", "TI"], 
         StyleBox["1", "TR"]], ",", 
        SubscriptBox[
         StyleBox["tr", "TI"], 
         StyleBox["2", "TR"]]}], "}"}], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["1", "TR"]]}], "}"}], ",", 
    StyleBox["f", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e790d20c-71f5-ae47-8e1a-35b2ac678e0a"],
 "\[LineSeparator]does the same but the flip angle of the second tr is ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "22e03cf4-5fc2-9548-9cd1-a00a2ce3ff18"],
 " ang."
}], "Usage",
