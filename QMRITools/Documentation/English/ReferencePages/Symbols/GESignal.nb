Cell["GESignal", "ObjectName",
 CellID->240806439,ExpressionUUID->"adc153e3-35eb-494d-b5d0-394538f86e2f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"67dc8bc7-c7c7-f44e-a5e4-126206806f7b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GESignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/GESignal"], "[", 
   RowBox[{
    StyleBox["ang", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["tr", "TI"], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["1", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"7b95892c-d535-524c-b8b9-4fe7024bd8f2"],
 "\[LineSeparator]calculates the gradient echo signal for flip angles ",
 Cell[BoxData[
  StyleBox["ang", "TI"]], "InlineFormula",ExpressionUUID->
  "86134b8b-650e-7a45-84ad-0b8e057362bf"],
 " using tr and t1. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"05c45d07-cd04-584b-95cc-e2db13798c9a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GESignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/GESignal"], "[", 
   RowBox[{
    StyleBox["ang", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         StyleBox["tr", "TI"], 
         StyleBox["1", "TR"]], ",", 
        SubscriptBox[
         StyleBox["tr", "TI"], 
         StyleBox["2", "TR"]]}], "}"}], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["1", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"543556f8-27b3-f448-8ad1-8948a750b03b"],
 "\[LineSeparator]calculates the dual tr gradient echo signal for flip angles \
",
 Cell[BoxData[
  StyleBox["ang", "TI"]], "InlineFormula",ExpressionUUID->
  "660daf7f-481e-1d4e-833a-d5fd92022938"],
 " using tr1, tr2 and t1."
}], "Usage",
