 CellID->138070794,ExpressionUUID->"cba1dd39-788c-cd47-8898-79b8b79d93dd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d06def21-6b69-cf41-9afb-460076650fd0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeClassifyNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/MakeClassifyNetwork"],
    "[", 
   StyleBox["classes", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "159bd3ae-f99f-2049-99d6-2a148625c2fb"],
 "\[LineSeparator]makes a classify network with three convolution layers and \
3 fully connected layers. The input classes should be a list of strings. The \
input image dimensions should not be smaller than 64x64."
}], "Usage",
 CellChangeTimes->{3.9966556334785023`*^9},
 CellID->667605398,ExpressionUUID->"32e278f2-9075-3e42-8c2e-a90533911da7"],

