Cell[CellGroupData[{
Cell["SimReadout", "ObjectName",
 CellID->186368146,ExpressionUUID->"eeac51ca-5a1e-0548-95d1-95d84b5009cd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"73274599-c110-2e4d-af88-7a9fb8daf09a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimReadout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SimReadout"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2277e40f-09f5-4548-a620-010b71d1ed52"],
 "\[LineSeparator]performs a readout of a spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "2fdadb4f-d3cc-bc4e-b0ad-1060931365fd"],
 " with hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "2fa4073b-ab2c-ec41-87bb-5c34bdeaf966"],
 ". Output is {time,fids,ppm,spec,dOut}, which are the free induction decay \
fids with its time, the spectrum spec with its ppm and the evolved spin \
system dOut."
}], "Usage",
 CellChangeTimes->{{3.996656721350477*^9, 3.996656721416916*^9}},
 CellID->4538021,ExpressionUUID->"20ba4399-fbd0-ef43-9415-9997a0d3e0cc"],

