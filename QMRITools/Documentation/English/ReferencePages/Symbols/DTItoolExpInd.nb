Notebook[{

Cell[CellGroupData[{
Cell["DTItoolExpInd", "ObjectName",
 CellID->590438854,ExpressionUUID->"0b5ec88a-e012-2445-b014-f13b8ae567a1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cde2a3a5-744a-a641-9428-fe9aa8742ead"],
 "DTItoolExpInd[data,file]\[LineSeparator]exports a 3D array ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "91661c1b-27bd-8041-b387-66b2d1b201d8"],
 " to the ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "49c0bc20-d8ce-6e43-a02d-d45ce6a948b9"],
 " filename DTItool format (*.dat) using ",
 Cell[BoxData[
  ButtonBox["DatWrite",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/DatWrite"]], "InlineFormula",
  ExpressionUUID->"42ac4f47-175c-714c-abea-a04de8f2a88e"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"420ef2a2-8136-4f4a-b2b6-bb86c8d2e3d9"],
 "DTItoolExpInd[data,file ,folder]\[LineSeparator]exports ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "50f6c94b-5508-a448-8feb-8db48a41f916"],
 " to given ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "91a0e2a2-8b9c-8948-902f-09210448e55b"],
 " and ",
 Cell[BoxData[
  StyleBox["folder", "TI"]], "InlineFormula",ExpressionUUID->
  "5251dc46-0862-414b-a075-f2f9b82a4c3b"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"5c2f0565-281a-d74d-b4ed-7cd0ebf2d4aa"],
 "DTItoolExpInd[data,file ,folder,add]\[LineSeparator]exports ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "adc0fa36-a308-c241-bfcf-ef721b10caf0"],
 " to given ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "e0ae4e43-ab6d-9145-8172-9478709422ea"],
 " and ",
 Cell[BoxData[
  StyleBox["folder", "TI"]], "InlineFormula",ExpressionUUID->
  "308da02a-28d3-9941-8259-675359055982"],
 " and adds -add to the filename."
}], "Usage",
 CellChangeTimes->{{3.9966565842639046`*^9, 3.996656584339901*^9}},
 CellID->100578219,ExpressionUUID->"ad83c8b7-e18f-7d49-af2b-efd058de65fb"],

