    ButtonBox["OrderSpan",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/OrderSpan"], "\"\<Auto\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["OrderSpan",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OrderSpan"]], "InlineFormula",
      ExpressionUUID->"98fe7562-4520-9f46-bbcd-ff94b20d1122"],
     " is an options for ",
     Cell[BoxData[
     "FindOrder"], "InlineFormula",ExpressionUUID->
      "94fe0ee3-5300-1e4a-9c77-499fdb7968fa"],
     "."
    }], "TableText",ExpressionUUID->"e20bb272-b64c-494e-99e3-9dbecc341412"]}
  }]], "3ColumnTableMod",
 CellID->153207121,ExpressionUUID->"55a697d3-d596-984f-b3d7-86ee77620815"]
