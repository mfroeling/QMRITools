Notebook[{

Cell[CellGroupData[{
Cell["FindOrder", "ObjectName",
 CellID->94418400,ExpressionUUID->"d6411ce2-8d8d-2245-a675-c23881c722ac"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"10c2e2b8-277b-4a49-b59a-8e7e544c4b15"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindOrder",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/FindOrder"], "[", 
   RowBox[{
    StyleBox["grad", "TI"], ",", 
    StyleBox["bv", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "611fa471-dfdb-2747-bc91-67346b2d9b89"],
 "\[LineSeparator]finds the optimal order of the gradient directions which \
minimizes the duty cycle. The output is needed for ",
 Cell[BoxData[
  ButtonBox["FinalGrads",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/FinalGrads"]], "InlineFormula",
  ExpressionUUID->"dd5ef9b4-89ab-d740-854d-61b309618688"],
 ". grad is a list of gradient sets and bv is a list of b-values with the \
same number as the list of gradient sets."
}], "Usage",
 CellChangeTimes->{3.9966568040929413`*^9},
 CellID->202462224,ExpressionUUID->"e242c53f-d8c6-254a-8779-28493b714f05"],

Cell["The following options can be given: ", "Notes",
 CellID->521159,ExpressionUUID->"f719b9ca-cfbb-8e41-a1b1-26392aaa4951"],

