Notebook[{

Cell[CellGroupData[{
Cell["BayesianIVIMFit3", "ObjectName",
 CellID->207253165,ExpressionUUID->"c345f958-3339-ab4e-b37f-e48ae4e0467b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b7cbd56c-5636-f445-b231-b2b68bac01ff"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BayesianIVIMFit3",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/BayesianIVIMFit3"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["bval", "TI"], ",", 
    StyleBox["init", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e2c7df64-285b-be49-9dfc-1046d644a62d"],
 "\[LineSeparator]performs bayesian IVIM fit of ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "0daff89d-1421-f541-a5ba-151dd928992c"],
 ". ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "f9d987d6-08dd-5c4e-9bef-a017fb02b4b2"],
 " is the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "e41095c1-6703-4049-a251-afef88ca206e"],
 " which should be {slice, Ndiff, x, y}. ",
 Cell[BoxData[
  StyleBox["bval", "TI"]], "InlineFormula",ExpressionUUID->
  "4413ca00-03fd-8a41-9b87-b4189c57a3bd"],
 " is the bvector would be length Ndiff. ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "e3e3e722-12c9-7a4c-97d9-94e8f8d769ea"],
 " is the initialization of the bayesian fit which comes from IVIMCalC, \
(without s0 using 3 compartments). ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "d08ed316-622c-444f-8cb9-d309dd59c6db"],
 " is the region in which the bayesian fit is performed. output is {f1, f2, \
dc, pdc1, pdc2}. The fractions f1 and f2 are defined between 0 and 1, the dc, \
pdc1 and pdc1 is in mm^2/s."
}], "Usage",
 CellChangeTimes->{{3.996656268306612*^9, 3.9966562684420967`*^9}},
 CellID->145526805,ExpressionUUID->"45231632-0e7c-a34a-8a7f-c118f44ee7c4"],

Cell["The following options can be given: ", "Notes",
 CellID->31591613,ExpressionUUID->"b27689ea-cc06-6f41-bfc4-cf47cd744555"],

