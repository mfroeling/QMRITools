Cell[CellGroupData[{
Cell["FiberDensityMap", "ObjectName",
 CellID->250396868,ExpressionUUID->"8e2ffe0b-5aae-5942-818a-b41079b29044"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f096e31d-c9e1-d94a-bc98-f96e49c5e522"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FiberDensityMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsLegacy/ref/FiberDensityMap"], "[", 
   RowBox[{
    StyleBox["fiberPoins", "TI"], ",", 
    StyleBox["dim", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "25ea7845-15e1-314b-aef1-b064485636cd"],
 "\[LineSeparator]generates a fiber density map for the ",
 Cell[BoxData[
  StyleBox["fiberPoins", "TI"]], "InlineFormula",ExpressionUUID->
  "8a21d78d-ac44-a341-9617-2bc1a6ff2e89"],
 " which are imported by ",
 Cell[BoxData[
  ButtonBox["LoadFiberTracts",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/LoadFiberTracts"]], "InlineFormula",
  ExpressionUUID->"4199d6e0-26ae-ff4d-a93f-df377638ff24"],
 ". The dimensions dim should be the dimensions of the tracked datasets van \
vox its volxel size."
}], "Usage",
 CellChangeTimes->{{3.996656305220009*^9, 3.996656305274439*^9}},
 CellID->63530062,ExpressionUUID->"6b948afc-0bea-e74d-b0d2-039925bd723e"],

