 CellID->386408904,ExpressionUUID->"cc28851c-f527-5946-a4f3-54228f06d5a4"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ac8fe7bc-fb9e-3346-b3fb-0950062be03e"], 
    ButtonBox["SeedDensity",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SeedDensity"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SeedDensity",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SeedDensity"]], "InlineFormula",
      ExpressionUUID->"0b74abe6-c7eb-aa42-9dd5-c8b17d807c98"],
     " is an option for ",
     Cell[BoxData[
     "FiberDensityMap"], "InlineFormula",ExpressionUUID->
      "8abfbb80-4819-0043-9163-8ada38d8c8da"],
     ". The seedpoint spacing in mm."
    }], "TableText",ExpressionUUID->"bb32cfac-5819-9d40-9e56-b19daca2b86a"]}
  }]], "3ColumnTableMod",
 CellID->210703793,ExpressionUUID->"bc329f41-64e9-c042-a13d-c4893af8cd4e"]
