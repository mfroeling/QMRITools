Cell[CellGroupData[{
Cell["BullseyePlot", "ObjectName",
 CellID->208264324,ExpressionUUID->"6d0e28b8-f3f0-2347-b6b1-41711ab55ac7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f9d29377-82a4-a545-8adc-f8336278485c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BullseyePlot",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/BullseyePlot"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["segmask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1fbb1e0e-4867-8241-8e5a-185771cb133f"],
 "\[LineSeparator]generates a AHA-17 segment bullseye plot. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b0554ab2-81b3-ff44-9f4a-9ab1993552d4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BullseyePlot",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/BullseyePlot"], "[", 
   StyleBox["list", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8d4c105c-452d-ff46-9f91-9585fcbad23d"],
 "\[LineSeparator]generates a AHA-17 segment bullseye plot of the lists \
(which needs to have 17 values) provide. ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "eccce9c1-6957-c345-9e0a-2f7206b96635"],
 " is a 3D volume used for the plot. ",
 Cell[BoxData[
  StyleBox["segmask", "TI"]], "InlineFormula",ExpressionUUID->
  "0d774b61-716b-764e-92b3-b30f915f2d18"],
 " is the AHA-17 segmentation resulting form the ",
 Cell[BoxData[
  ButtonBox["CardiacSegment",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CardiacSegment"]], "InlineFormula",
  ExpressionUUID->"23f554c1-f943-164b-8870-de7cae8132c8"],
 " function when AHA17 is selected. Output is a bullseye plot or a \
plotWindow,depending on the Method which can be \"Dynamic\" else it will be \
static. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ac041c7c-5604-2143-873d-7128c8103775"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BullseyePlot",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/BullseyePlot"], "[", "]"}]],
   "InlineFormula",ExpressionUUID->"ced6707a-a47e-df49-9d98-d09fd6e90ad1"],
 "\[LineSeparator]is based on DOI: 10.1161/hc0402.102975."
}], "Usage",
 CellChangeTimes->{{3.996656652973484*^9, 3.99665665318248*^9}},
 CellID->479686574,ExpressionUUID->"c28b2337-c4dd-9247-b57a-2223e66513cb"],

