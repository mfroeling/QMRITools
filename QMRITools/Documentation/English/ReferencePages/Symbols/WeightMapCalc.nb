     Cell[BoxData[
     "WeightMapCalc"], "InlineFormula",ExpressionUUID->
      "1f4c2d2f-1b4d-c440-bf81-b47f5bb96e7d"],
     " and defines the weighting strength, all data is normalize to 100 \
before filetering."
    }], "TableText",ExpressionUUID->"88134277-6bcf-494e-b44a-be5bad581433"]}
