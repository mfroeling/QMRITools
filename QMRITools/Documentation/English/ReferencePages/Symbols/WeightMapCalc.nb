Cell[CellGroupData[{
Cell["WeightMapCalc", "ObjectName",
 CellID->164999203,ExpressionUUID->"67f6dec0-873b-9a4f-be08-0e68ab254d85"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7e016817-ff0e-1c49-a838-a8f1e7a9a8be"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["WeightMapCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/WeightMapCalc"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "885dd3aa-8f94-de44-8c83-980c66218a3f"],
 "\[LineSeparator]calculates a weight map which is used in ",
 Cell[BoxData[
  ButtonBox["AnisoFilterTensor",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/AnisoFilterTensor"]], "InlineFormula",
  ExpressionUUID->"e476af97-4387-f14c-8603-326ea2900d4d"],
 ". Output is a weight map of the data which is high in isotropic regions and \
low at edges."
}], "Usage",
 CellChangeTimes->{3.9966563649047737`*^9},
 CellID->139529066,ExpressionUUID->"d1e1f499-14e6-c849-9ab3-c5a16af02217"],

Cell["The following options can be given: ", "Notes",
 CellID->457915867,ExpressionUUID->"ae333b23-b9db-be4c-b58d-ac0405254c18"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2022aed9-5fcb-8a4b-9d3e-c7d63d5c4c8b"], 
    ButtonBox["AnisoWeightType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AnisoWeightType"], "2", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AnisoWeightType",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AnisoWeightType"]], "InlineFormula",
      ExpressionUUID->"87daa2ff-842c-de48-8330-1ef1411bb692"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["AnisoFilterTensor",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AnisoFilterTensor"]], 
      "InlineFormula",ExpressionUUID->"1cbb7397-c20d-d848-b09d-3f2f02981859"],
     " and ",
     Cell[BoxData[
     "WeightMapCalc"], "InlineFormula",ExpressionUUID->
      "c08f8142-06af-d04c-a498-3a2530941c8b"],
     " and defines the weighting, eigher 1, the exponent of (-g/kappa) or 2, \
1/(1+g/kappa)."
    }], "TableText",ExpressionUUID->"2259c451-db96-324c-b88e-ca01c757e79d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e713a57d-bf7b-604a-9dc6-0d3bd7420ffc"], 
    ButtonBox["AnisoKappa",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AnisoKappa"], "10.", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AnisoKappa",
       BaseStyle->"Link",
