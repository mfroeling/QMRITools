Notebook[{

Cell[CellGroupData[{
Cell["LinesToSegmentIndex", "ObjectName",
 CellID->41328780,ExpressionUUID->"7ed43500-a6f7-fc41-b057-c1b29131c381"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d4de1e3d-250d-3949-968a-9f30a16db882"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["LinesToSegmentIndex",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/LinesToSegmentIndex"], "[", 
   RowBox[{
    StyleBox["lines", "TI"], ",", 
    StyleBox["points", "TI"], ",", 
    StyleBox["segments", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2e19bd67-66d1-c547-ad4e-fb5e7a690a10"],
 "\[LineSeparator]finds the ",
 Cell[BoxData[
  StyleBox["lines", "TI"]], "InlineFormula",ExpressionUUID->
  "1cad3b5c-49ff-7a43-bc15-18b5c7ba3c59"],
 " indices corresponding to the ",
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",ExpressionUUID->
  "093b6379-49cd-9042-a34a-d7809bbbbaa4"],
 " and the ",
 Cell[BoxData[
  StyleBox["segments", "TI"]], "InlineFormula",ExpressionUUID->
  "6e5eb5f9-e186-3542-a8f6-080b0fc82952"],
 " borders. Additionally it finds all the ",
 Cell[BoxData[
  StyleBox["lines", "TI"]], "InlineFormula",ExpressionUUID->
  "f981ac8f-0006-4744-9029-cc1afb9cc455"],
 " indices for all ",
 Cell[BoxData[
  StyleBox["lines", "TI"]], "InlineFormula",ExpressionUUID->
  "5f5467a4-b25f-8644-b108-1ebafb237730"],
 " within each segment. The ",
 Cell[BoxData[
  StyleBox["lines", "TI"]], "InlineFormula",ExpressionUUID->
  "3e893cce-922c-2242-a85c-6a7cd875425c"],
 " are computed by ",
 Cell[BoxData[
  ButtonBox["MaskToLines",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MaskToLines"]], "InlineFormula",
  ExpressionUUID->"83281b39-5e33-d04f-bd08-86ad4e08a902"],
 ", the points are cumputed by ",
 Cell[BoxData[
  ButtonBox["GetMaskSegmentPoints",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetMaskSegmentPoints"]], "InlineFormula",
  ExpressionUUID->"b0574e59-960e-7340-b8a2-f19d6cec8ca9"],
 ", and the segments is the output of SegmentsPerSlices. Output {pointIndex, \
segmentIndex, lineIndex}."
}], "Usage",
 CellChangeTimes->{{3.996655634417576*^9, 3.99665563453726*^9}},
 CellID->221437390,ExpressionUUID->"3cf48f82-7224-2349-bd2d-ac0ac6cac0e7"],

Cell["The following options can be given: ", "Notes",
 CellID->57571988,ExpressionUUID->"5de8b846-b88f-d140-8d03-a1393e7298c4"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e6a72e3f-6a01-2347-a636-fc73f0c204fe"], 
    ButtonBox["ReversePoints",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/ReversePoints"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["ReversePoints",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ReversePoints"]], "InlineFormula",
      ExpressionUUID->"16cf725c-648c-ff44-a097-3ad1e4997353"],
     " is an option for ",
     Cell[BoxData[
     "LinesToSegmentIndex"], "InlineFormula",ExpressionUUID->
      "58cd135c-ff6f-b24f-b4b3-fcf1a4a3b291"],
     ", ",
     Cell[BoxData[
      ButtonBox["CardiacSegment",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CardiacSegment"]], "InlineFormula",
      ExpressionUUID->"026b2b2d-b276-a042-8ac7-34e9ce4064cf"],
     ". Defines at which point to start, can be ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "f9ce45c2-2953-d442-a5b8-9823d9f794c0"],
     " or False."
    }], "TableText",ExpressionUUID->"654ee4ae-db9a-6f4e-b04b-9e14ad8810f6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ab77d573-b592-2244-8a17-54d98cc057a2"], 
    ButtonBox["ReverseDirection",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/ReverseDirection"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["ReverseDirection",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ReverseDirection"]], "InlineFormula",
      ExpressionUUID->"d83857b1-c310-9b41-a2cf-084f51876573"],
     " is an option for ",
     Cell[BoxData[
     "LinesToSegmentIndex"], "InlineFormula",ExpressionUUID->
      "1e06ffe0-c1c2-3249-8c8a-8e03bebfca1e"],
     ", ",
     Cell[BoxData[
      ButtonBox["CardiacSegment",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CardiacSegment"]], "InlineFormula",
      ExpressionUUID->"74577a88-57ac-2e47-b597-b69c169bad51"],
     ". Defines the direction of rotation, clockwise or anti-clockwise, can \
be ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "7aa0df73-3be3-a74c-94db-60c16760efd6"],
     " of False."
    }], "TableText",ExpressionUUID->"9bea9701-f6fa-7a42-84be-ebfdb73e19fa"]}
  }]], "3ColumnTableMod",
 CellID->40867732,ExpressionUUID->"b414bde3-73a6-3f49-9fba-8c41fb1a993f"]
