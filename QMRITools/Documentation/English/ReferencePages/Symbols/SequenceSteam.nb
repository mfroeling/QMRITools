Notebook[{

Cell[CellGroupData[{
Cell["SequenceSteam", "ObjectName",
 CellID->44266492,ExpressionUUID->"8299f477-1fd4-ef46-b868-1f07dcbaa944"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3da8b28f-1c19-8145-8bcb-1689987f65ca"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SequenceSteam",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SequenceSteam"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["te", "TI"], ",", 
      StyleBox["tm", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8ff0d91a-2910-f14f-8e9a-75c22c121628"],
 "\[LineSeparator]performs a stimulated echo experiment with echo time te and \
mixing time tm of the spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "dccff365-edca-0143-9247-748f8af7d0f2"],
 " given the hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "0423ebf3-2a95-cc4d-9cc3-278a1183ec76"],
 " with 3 90 Degree pulses. The te and tm are defined in ms. The output is a \
new spin system dOut."
}], "Usage",
 CellChangeTimes->{{3.9966563745348225`*^9, 3.996656374604479*^9}},
 CellID->69993191,ExpressionUUID->"e1254338-c0c2-c04f-a49b-314d42e0f8cc"],

