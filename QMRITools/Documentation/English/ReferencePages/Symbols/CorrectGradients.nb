Notebook[{

Cell[CellGroupData[{
Cell["CorrectGradients", "ObjectName",
 CellID->26220828,ExpressionUUID->"e7a54579-1db8-c340-9aa7-b180a5db1ece"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6ee37e6b-323a-d74a-b38e-f3382a366317"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CorrectGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/CorrectGradients"], "[", 
   RowBox[{
    StyleBox["grad", "TI"], ",", 
    StyleBox["transformation", "TI"]}], "]"}]], "InlineFormula",
  ExpressionUUID->"f09dab2d-e64d-b940-a9fd-3b7d1d47d902"],
 "\[LineSeparator]corrects the gradient directions ",
 Cell[BoxData[
  StyleBox["grad", "TI"]], "InlineFormula",ExpressionUUID->
  "c05c144e-3bf6-624b-8cd1-c0a1cfb87866"],
 " with the ",
 Cell[BoxData[
  StyleBox["transformation", "TI"]], "InlineFormula",ExpressionUUID->
  "a7724ba7-a8e4-f54c-94f7-e67c34e3cad1"],
 " parameters from ",
 Cell[BoxData[
  ButtonBox["RegisterData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterData"]], "InlineFormula",
  ExpressionUUID->"9af48df6-b2ad-5a46-b012-47ab9e32e356"],
 " or ",
 Cell[BoxData[
  ButtonBox["RegisterDiffusionData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterDiffusionData"]], 
  "InlineFormula",ExpressionUUID->"e4867242-8e37-9c4d-a0a9-1529db032988"],
 ". Output is the corrected gradient vector."
}], "Usage",
 CellChangeTimes->{{3.9966562625134716`*^9, 3.996656262624449*^9}},
 CellID->733392295,ExpressionUUID->"edace5fb-38ac-9247-b0db-f4bd97120022"],

Cell["The following options can be given: ", "Notes",
 CellID->27231131,ExpressionUUID->"dc89c465-226d-5446-aee9-c659008f3a61"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ed0c03f7-26a2-624e-9938-f5d9a437e119"], 
    ButtonBox["MethodReg",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MethodReg"], "\"\<Rotation\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["MethodReg",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MethodReg"]], "InlineFormula",
      ExpressionUUID->"99ce9a02-df3c-7c4b-9af1-e2a7e04b9bc9"],
     " is an options for ",
     Cell[BoxData[
      ButtonBox["RegisterData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RegisterData"]], "InlineFormula",
      ExpressionUUID->"3c683604-5154-b845-b89f-e85e8ca4d33b"],
     ", ",
     Cell[BoxData[
      ButtonBox["RegisterDiffusionData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RegisterDiffusionData"]], 
      "InlineFormula",ExpressionUUID->"bfeddc3a-012e-1c43-a166-50c654347560"],
     ", ",
     Cell[BoxData[
      ButtonBox["RegisterCardiacData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RegisterCardiacData"]], 
      "InlineFormula",ExpressionUUID->"eaa741ed-7afd-b949-84f1-a0e636eba391"],
     " and ",
     Cell[BoxData[
      ButtonBox["RegisterData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RegisterData"]], "InlineFormula",
      ExpressionUUID->"82345fda-55ba-1540-881b-399ef02209f5"],
     "Transform. \nIt specifies which registration method to use. \nMethods \
can be be \"translation\", \"rigid\", \"affine\", \"bspline\", \"rigidDTI\", \
\"affineDTI\", \"PCAtranslation\", \"PCArigid\", \"PCAaffine\", or \
\"PCAbspline\"."
    }], "TableText",ExpressionUUID->"58549a18-a36c-2c4c-8def-4e43205c6ae9"]}
  }]], "3ColumnTableMod",
 CellID->53709026,ExpressionUUID->"7f7aeab7-d0d2-dc42-9d7f-68a6d2bf069e"]
