Notebook[{

Cell[CellGroupData[{
Cell["TaggingParPlot", "ObjectName",
 CellID->416069563,ExpressionUUID->"74a6ca14-b153-df49-9793-2b56d7d6bb95"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"496daf47-31b9-674c-8b92-74f23a3a87d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TaggingParPlot",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTaggingTools/ref/TaggingParPlot"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "16835fe6-6053-b549-825c-2182e9d4f1ab"],
 "\[LineSeparator]plots a tagging parameter over time with one line per \
slice, ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "80ce53a7-1919-5345-ba9b-4503ef31caf5"],
 " is {time, slices}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"7bf6f9d9-b23f-b44e-b96e-55b3d3ab2f94"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TaggingParPlot",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTaggingTools/ref/TaggingParPlot"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["min", "TI"], ",", 
      StyleBox["max", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"93b0afda-aed1-5f4a-bd6d-cbd530f3cccb"],
 "\[LineSeparator]uses the given plot range, by default it is symmetric \
around zero with 1.2 times the maximal absolute value."
}], "Usage",
 CellChangeTimes->{{3.999758992906769*^9, 3.9997589930270767`*^9}},
 CellID->170799748,ExpressionUUID->"2c398222-0a5c-e541-9bcf-226afb3acbb9"],

