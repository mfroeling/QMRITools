Notebook[{

Cell[CellGroupData[{
Cell["ExportBvalvec", "ObjectName",
 CellID->350695796,ExpressionUUID->"b268e3da-6dbd-a64c-8671-5908f749980e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"45030cc3-b38d-b84e-bb8d-a6442cdacecc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportBvalvec",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportBvalvec"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["bval", "TI"], ",", 
     StyleBox["grad", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "04f329f7-cd2f-c944-8877-065763817687"],
 "\[LineSeparator]exports the diffusion values and gradients to a *.bval and \
*.bvec format. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"eecd2d4c-0495-5645-8e2c-5ef420c0e081"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportBvalvec",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportBvalvec"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["bval", "TI"], ",", 
      StyleBox["grad", "TI"]}], "}"}], 
    ",", "\"\<\!\(\*StyleBox[\"file\", \"TI\"]\)\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"4b0cd676-64b6-014f-95f1-032590c267e8"],
 "\[LineSeparator]exports the diffusion values and gradients to \"",
 Cell[BoxData[
  StyleBox["\"\<file\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "85cb5e33-e3c4-2e44-913c-3f1996dcbdbc"],
 "file\" to a *.bval and *.bvec format."
}], "Usage",
