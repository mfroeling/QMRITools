Cell[CellGroupData[{
Cell["ExportBvalvec", "ObjectName",
 CellID->120674705,ExpressionUUID->"61e2c987-6c38-cf4d-9679-781d82aebf3b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5f1138f0-0490-5241-a2ac-089c300f9b17"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportBvalvec",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportBvalvec"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["bval", "TI"], ",", 
     StyleBox["grad", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "2521a4f1-73d9-ef4e-ae8c-f422a9fce626"],
 "\[LineSeparator]exports the diffusion values and gradients to a *.bval and \
*.bvec format. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"da756189-612b-c443-afd5-cab82fe41b89"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportBvalvec",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportBvalvec"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["bval", "TI"], ",", 
      StyleBox["grad", "TI"]}], "}"}], 
    ",", "\"\<\!\(\*StyleBox[\"file\", \"TI\"]\)\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"5713a387-188e-5741-b192-b34ea35784b7"],
 "\[LineSeparator]exports the diffusion values and gradients to \"",
 Cell[BoxData[
  StyleBox["\"\<file\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "5f7d87e7-6977-f144-a380-f32b41756fad"],
 "file\" to a *.bval and *.bvec format."
}], "Usage",
 CellChangeTimes->{{4.003804517930361*^9, 4.0038045180713005`*^9}},
 CellID->191468566,ExpressionUUID->"5db4ac77-9595-5840-81e6-d6d1415b0c27"],

