Cell[CellGroupData[{
Cell["ExportBvalvec", "ObjectName",
 CellID->64434319,ExpressionUUID->"71ce522a-f9e0-0144-a52c-6f74644f59af"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d271bbaf-3e56-2340-9079-29ce6482d587"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportBvalvec",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportBvalvec"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["bval", "TI"], ",", 
     StyleBox["grad", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "a9a6e866-b7c4-014c-8953-9e16f31c0840"],
 "\[LineSeparator]exports the diffusion values and gradients to a *.bval and \
*.bvec format. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ddef067a-2c68-9148-ba7b-ad781ef14493"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportBvalvec",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportBvalvec"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["bval", "TI"], ",", 
      StyleBox["grad", "TI"]}], "}"}], 
    ",", "\"\<\!\(\*StyleBox[\"file\", \"TI\"]\)\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"c131fcbf-ab40-174c-8cb5-530651c1a9d9"],
 "\[LineSeparator]exports the diffusion values and gradients to \"",
 Cell[BoxData[
  StyleBox["\"\<file\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "f0f465e8-dba2-e840-a019-f7879ba707fa"],
 "file\" to a *.bval and *.bvec format."
}], "Usage",
