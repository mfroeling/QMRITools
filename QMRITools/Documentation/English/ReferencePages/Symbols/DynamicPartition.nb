Cell[CellGroupData[{
Cell["DynamicPartition", "ObjectName",
 CellID->16859826,ExpressionUUID->"69c8dd5d-c3e4-3646-8779-239f7b0beaae"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f9654a52-6aad-f846-8175-75f22dd853c9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DynamicPartition",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/DynamicPartition"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     StyleBox["part", "TI"], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8ca5c71f-624e-ea43-832e-8082db8ad775"],
 "\[LineSeparator]partitions the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "43036aa6-8f93-464d-a667-17b689f265bf"],
 " into parts which is a list of integers. The remainders is los. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3139e887-5774-de4c-8821-77c147bc1bdc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DynamicPartition",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/DynamicPartition"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["part", "TI"], ",", 
    StyleBox["last", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fa56bad7-054b-4849-a8ff-e7053644e010"],
 "\[LineSeparator]partitions the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "feb742a1-dbca-4340-9863-7fc50fb81722"],
 " into parts which is a list of integers. The remainders is partitioned into \
equal parts defined by ",
 Cell[BoxData[
  StyleBox["last", "TI"]], "InlineFormula",ExpressionUUID->
  "877defe8-056a-3b47-a129-09a663e639fa"],
 ". If ",
 Cell[BoxData[
  StyleBox["last", "TI"]], "InlineFormula",ExpressionUUID->
  "43ae5a4d-6060-d641-affa-e6a334bb86dd"],
 " is All, the remainders is just one partition."
}], "Usage",
