Cell[CellGroupData[{
Cell["GetMaskMeans", "ObjectName",
 CellID->85203577,ExpressionUUID->"f5613a0e-8a39-ad43-8a5b-aad3fad035a0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"67fd2f0e-2639-4148-966f-28b98818fea1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetMaskMeans",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/GetMaskMeans"], "[", 
   RowBox[{
    StyleBox["dat", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3fc9d9ef-bee5-7d40-8609-7cc3575ac873"],
 "\[LineSeparator]calculates the mean, std, 5,50 and 95% CI form the given \
data for each of the given masks. ",
 Cell[BoxData[
  ButtonBox["Mask",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/Mask"]], "InlineFormula",ExpressionUUID->
  "2a8434a8-4294-eb46-9df6-b091b42359e6"],
 " can be generated by ",
 Cell[BoxData[
  ButtonBox["SegmentTracts",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SegmentTracts"]], "InlineFormula",
  ExpressionUUID->"d6a6cc60-ea06-ce44-9b8b-7a8a6e69aea1"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"72dd2b52-d553-3d44-98f8-2826216ed9bb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetMaskMeans",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/GetMaskMeans"], "[", 
   RowBox[{
    StyleBox["dat", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["name", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0eda23eb-6936-da46-8f23-a3302e0be42f"],
 "\[LineSeparator]where ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",ExpressionUUID->
  "8aa43ae4-c982-644f-a50c-449eec9b1322"],
 " is a string that is added to the header."
}], "Usage",
 CellChangeTimes->{{3.996656632990549*^9, 3.996656633125122*^9}},
 CellID->77300992,ExpressionUUID->"da7f45b0-1a0e-ee4c-ae1b-61f71330c46f"],

