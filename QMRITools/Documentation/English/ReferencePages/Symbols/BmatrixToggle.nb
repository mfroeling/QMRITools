Cell[CellGroupData[{
Cell["BmatrixToggle", "ObjectName",
 CellID->65904414,ExpressionUUID->"4874cff1-3d44-b943-a19f-609872d4ae7e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"613372a6-0864-6547-8cfc-1334858c4b17"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BmatrixToggle",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/BmatrixToggle"], "[", 
   RowBox[{
    StyleBox["bmat", "TI"], ",", 
    StyleBox["axes", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cb328e12-47e1-7846-b48b-544abed918f5"],
 "\[LineSeparator], ",
 Cell[BoxData[
  StyleBox["axes", "TI"]], "InlineFormula",ExpressionUUID->
  "bdee0a62-4b01-c94b-8330-c4bda4ec4d17"],
 " can be any order of {\"x\",\"y\",\"z\"}. ",
 Cell[BoxData[
  StyleBox["flip", "TI"]], "InlineFormula",ExpressionUUID->
  "14bc9ea9-a914-044c-b854-5d65484fd059"],
 " should be {1,1,1},{1,1,-1},{1,-1,1} or {-1,1,1}."
}], "Usage",
