Cell[CellGroupData[{
Cell["B1MapCalc", "ObjectName",
 CellID->22863119,ExpressionUUID->"f94c3e24-26ec-7a47-9cf5-6dd812df652c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"27a9a594-158f-3c41-baa2-58c9719d6115"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["B1MapCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/B1MapCalc"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", "TR", ",", 
    StyleBox["alpha", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "900a3cb8-f1de-304f-9832-d7af8504af46"],
 "\[LineSeparator]calculates the B1 map from a dual ",
 Cell[BoxData[
  StyleBox["TR", "TI"]], "InlineFormula",ExpressionUUID->
  "e52c33c6-859a-914a-95e4-23391ec191c1"],
 " {tr1, tr2} acquisition (AFI) using magnitude ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "f1a27b91-1106-4941-966b-1003b22e1f7d"],
 " with reference angle ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "776c7044-b930-7642-87d8-9a5059c2d4d7"],
 ". ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "8b274be2-96a8-e74b-8d53-d2bc138f74f9"],
 " has dimensions {z, {tr1,tr2}, x, y}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b1461767-fc31-f643-a5e5-6cc760168d4c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["B1MapCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/B1MapCalc"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["dataTr", "TI"], 
     StyleBox["1", "TR"]], ",", 
    SubscriptBox[
     StyleBox["dataTr", "TI"], 
     StyleBox["2", "TR"]], ",", "TR", ",", 
    StyleBox["alpha", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8b7fc222-dc24-364a-bbd1-d068ca0c6e4a"],
 "\[LineSeparator]where ",
 Cell[BoxData[
  StyleBox["dataTr1", "TI"]], "InlineFormula",ExpressionUUID->
  "e97b5ed6-af1c-6440-81bf-1eb0aaf70dd5"],
 " and and ",
 Cell[BoxData[
  StyleBox["dataTr2", "TI"]], "InlineFormula",ExpressionUUID->
  "3ceb3a18-fbab-5247-8795-57d49a41c154"],
 " can have any dimensions. The Output can be \"Map\", \"MagPhase\", or \
\"Complex\"} \n",
 Cell["   ", "ModInfo",ExpressionUUID->"fe1275ba-3d0c-ea4b-b12f-ed95e2d8a98b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["B1MapCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/B1MapCalc"], "[", "]"}]],
   "InlineFormula",ExpressionUUID->"c3356324-a197-b145-a687-3f7dbace6b45"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.21120."
}], "Usage",
 CellChangeTimes->{{3.9966568164114323`*^9, 3.9966568166738167`*^9}},
 CellID->159605140,ExpressionUUID->"8c0c8d90-9302-8e4e-9ad9-d85934009383"],

