Notebook[{

Cell[CellGroupData[{
Cell["TractAngleMap", "ObjectName",
 CellID->152241761,ExpressionUUID->"ee3e44be-ace0-c44b-8eb9-26c0e2513c37"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1331d93b-b262-8547-ac66-b04295f0521d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TractAngleMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/TractAngleMap"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "30b87f3f-e710-c940-b8df-fdae4b82b840"],
 "\[LineSeparator]makes a tract angle map based on the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "28ebb440-5d95-6944-8935-9471e73bcc88"],
 " angles with the z-plane. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"42af62ba-ce5d-1247-a024-0a8df7845284"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TractAngleMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/TractAngleMap"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["1", "TR"]], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "79f7946b-6236-404a-b3d8-8a572960ce50"],
 "\[LineSeparator]makes a tract angle map based on the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "3dd58a96-158d-f44b-adae-bf96bf219a89"],
 " angles with the plane normal to ",
 Cell[BoxData[
  StyleBox["v1", "TI"]], "InlineFormula",ExpressionUUID->
  "5f92241b-349c-9d49-b167-b63244b3ad72"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"5d3387f9-4d65-264b-8348-d4b6f70dd039"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TractAngleMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/TractAngleMap"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], 
       StyleBox["2", "TR"]]}], "}"}], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8eebec6c-7d0a-164c-853c-6f98679fa1f6"],
 "\[LineSeparator]makes a tract angle map based on the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "66c18104-ed9e-9d46-991f-9e507151a8e4"],
 " elevation angles with the plane normal to ",
 Cell[BoxData[
  StyleBox["v1", "TI"]], "InlineFormula",ExpressionUUID->
  "81149a74-e702-b344-ab66-83f39c21247f"],
 " and the azimuth angle in that plane relative to v2. The map is the median \
per voxel and voxels without ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "8cff4907-2637-1f45-a7ec-cb0f9d4f99a0"],
 " are -1."
}], "Usage",
 CellChangeTimes->{{4.003804592191044*^9, 4.0038045925710487`*^9}},
