Cell[CellGroupData[{
Cell["TractAngleMap", "ObjectName",
 CellID->131233333,ExpressionUUID->"37e3ed3a-0485-d347-ae26-4414bb18ece8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c3d47af3-5591-9c42-9fbc-7fe0772405aa"],
 "Tract",
 Cell[BoxData[
  RowBox[{
   ButtonBox["AngleMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRITools/ref/AngleMap"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f3ff94fb-1c4a-4447-98c2-18204613b5b2"],
 "\[LineSeparator]makes a tract angle map based on the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "b5850835-2269-624b-8522-e029d9d2def5"],
 " angles with the z-plane. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f79ae70a-69c6-3541-978e-4db8b2102609"],
 "Tract",
 Cell[BoxData[
  RowBox[{
   ButtonBox["AngleMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRITools/ref/AngleMap"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    StyleBox["v1", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dd90bc6d-112d-a646-a616-399272e12701"],
 "\[LineSeparator]makes a tract angle map based on the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "49e9a43f-891c-6c40-8b23-0c32d4d1b108"],
 " angles with the plane normal to ",
 Cell[BoxData[
  StyleBox["v1", "TI"]], "InlineFormula",ExpressionUUID->
  "149eeecd-6438-344b-90fb-5e9f0884b517"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3b2b7854-e060-614b-b52e-24eb3c90bdfe"],
 "Tract",
 Cell[BoxData[
  RowBox[{
   ButtonBox["AngleMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRITools/ref/AngleMap"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["v1", "TI"], ",", 
      StyleBox["v2", "TI"]}], "}"}], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "42b44cc9-776a-7742-93e4-83cb9ad61eb1"],
 "\[LineSeparator]makes a tract angle map based on the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "bd4a4c3e-9c90-9c46-909b-a10f306eb64b"],
 " elevation angles with the plane normal to ",
 Cell[BoxData[
  StyleBox["v1", "TI"]], "InlineFormula",ExpressionUUID->
  "b35d3291-e5d1-cf4d-92fd-2f1ffa35c11a"],
 " and the azimuth angle in that plane relative to v2."
}], "Usage",
