Cell[CellGroupData[{
Cell["RegisterDiffusionDataSplit", "ObjectName",
 CellID->543268875,ExpressionUUID->"05690576-b4f9-5b46-b5ba-d375d28d07c5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"64f57d94-0b3b-864b-bfb8-26cdf7a2d54a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDiffusionDataSplit",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsElastixTools/ref/RegisterDiffusionDataSplit"], "[", 
   RowBox[{
    StyleBox["dtiData", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7345b912-389f-3548-849c-0b139a07a59e"],
 "\[LineSeparator]is identical to Register diffusion data however left and \
right side of the data are registered separately. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"99749e17-8471-364d-a5a1-ff36e392d983"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDiffusionDataSplit",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsElastixTools/ref/RegisterDiffusionDataSplit"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["dtiData", "TI"], ",", 
      StyleBox["vox", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["anatData", "TI"], ",", 
      StyleBox["voxAnat", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"47378fbf-1a3b-2549-900a-e3e36f3d6108"],
 "\[LineSeparator]is identical to Register diffusion data however left and \
right side of the data are registered separately. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c7e5865d-e174-b94e-ad0a-d8d46dd9b521"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDiffusionDataSplit",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsElastixTools/ref/RegisterDiffusionDataSplit"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["dtiData", "TI"], ",", 
      StyleBox["dtiMask", "TI"], ",", 
      StyleBox["vox", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["anatData", "TI"], ",", 
      StyleBox["anatMast", "TI"], ",", 
      StyleBox["voxAnat", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"3f5a226c-9e8e-3f48-8529-35d9fd266373"],
 "\[LineSeparator]is identical to Register diffusion data however left and \
right side of the data are registered separately. Splitting the data is done \
using the function ",
 Cell[BoxData[
  ButtonBox["CutData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CutData"]], "InlineFormula",
  ExpressionUUID->"ecbc9e29-6c8d-5e46-81d6-8575ef33b476"],
 " and merged wit Stich data. Output is the registered data."
}], "Usage",
