Cell[CellGroupData[{
Cell["ManageCheckFiles", "ObjectName",
 CellID->226945601,ExpressionUUID->"9730fc45-1645-8f4a-8c24-c9d7bfdc959d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cbafae79-7a76-5245-9756-7a74f8360f85"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ManageCheckFiles",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ManageCheckFiles"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "19c9ac5b-8f92-e44a-8355-24ef3acdd2a6"],
 "\[LineSeparator]shows per processing step the check files expected from the \
config file in dir and their status. Selected check files can be deleted such \
that the next run of that step processes the data again."
}], "Usage",
 CellChangeTimes->{4.002264732797268*^9},
 CellID->591045012,ExpressionUUID->"0b0990eb-e398-3849-a2a3-134f0ec49e69"],

