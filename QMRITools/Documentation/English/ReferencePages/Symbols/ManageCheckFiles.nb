Notebook[{

Cell[CellGroupData[{
Cell["ManageCheckFiles", "ObjectName",
 CellID->831945837,ExpressionUUID->"d59bcf67-7ca4-5444-aaca-9051d6b6e90f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a3a953d4-5df5-0047-b9ca-2ffc70968761"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ManageCheckFiles",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ManageCheckFiles"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "69a6ccdb-1db7-9445-8da3-17f52e7c5df3"],
 "\[LineSeparator]shows per processing step the check files expected from the \
config file in dir and their status. Selected check files can be deleted such \
that the next run of that step processes the data again. Reload scans again. \
The options are ProcessSubjects to limit the subjects and ",
 Cell[BoxData[
  ButtonBox["BidsOutputImages",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/BidsOutputImages"]], "InlineFormula",
  ExpressionUUID->"711290f2-7a09-a94c-8f76-78bf91db94f2"],
 " to define the expected Analysis images."
}], "Usage",
 CellChangeTimes->{4.003804544476959*^9},
 CellID->144120659,ExpressionUUID->"89557252-1a44-304d-9e6e-1b588cc2eea2"],

Cell["The following options can be given: ", "Notes",
 CellID->125526334,ExpressionUUID->"7abba5bd-937a-f549-aa01-5675c6a601cf"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0ac0113d-b4be-474f-bcc9-b5da77089cdb"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell[TextData[{
     "ProcessSubjects is an option for Bids functions. Can be a list of bids \
subject names else it is ",
     Cell[BoxData[
      ButtonBox["All",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "acd87a76-cd6d-ef47-912c-5faf87592daa"],
     "."
    }], "TableText",ExpressionUUID->"4615dfd8-5bb3-4a4a-8435-040d2b8582a5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ce297f0c-b547-a04b-acd0-6e235c888b94"], 
    ButtonBox["BidsOutputImages",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/BidsOutputImages"], "\"\<All\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["BidsOutputImages",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/BidsOutputImages"]], "InlineFormula",
      ExpressionUUID->"9da6b045-083b-bd4b-8970-6b12d68f0622"],
     " is an option for MuscleBidsAnalysis and ",
     Cell[BoxData[
     "ManageCheckFiles"], "InlineFormula",ExpressionUUID->
      "02e4a5cf-7b66-c44d-a5dc-c7814e2f681a"],
     ". It sets which images are saved in the output folder,\none of \"All\", \
\"Quantitative\", \"Segmentation\", \"Tractography\" or \"None\"."
    }], "TableText",ExpressionUUID->"0c358a85-a166-bb43-8415-6fd34f77a152"]}
  }]], "3ColumnTableMod",
 CellID->264266076,ExpressionUUID->"4e99365f-7ffb-3e4d-a90b-d339c3d38e6e"]
}, Open  ]],

