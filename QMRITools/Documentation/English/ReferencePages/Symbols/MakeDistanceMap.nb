Notebook[{

Cell[CellGroupData[{
Cell["MakeDistanceMap", "ObjectName",
 CellID->481195155,ExpressionUUID->"5314688d-92e3-2e4b-b65a-d708d5eaf794"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"16e36f41-e188-4544-8345-3ebe77ef4419"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeDistanceMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeDistanceMap"], "[", 
   StyleBox["mask", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a53e26ed-c846-be4b-9e7b-4bb27c925cc6"],
 "\[LineSeparator]makes a distance map of the given ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "29ee2100-f5d9-8f4b-91f6-d9bf0e5d8904"],
 " in voxels. The distance map is positive inside the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "cb61bfc3-fb58-5042-a286-73ece647cb8b"],
 " and negative outside the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "a2983606-c3f0-814a-91f3-b742f89697b7"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d69f1cb0-c066-0e49-92a2-c2db3a339d1c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeDistanceMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeDistanceMap"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1df4ad33-8b03-de45-81cf-f799eb23999c"],
 "\[LineSeparator]makes a distance map of the given ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "3e72fc28-a534-aa4d-8c91-46335bd4219f"],
 " in the same unit as ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "eca5efc0-1293-0746-a71f-80d08c62545d"],
 ". The distance map is positive inside the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "fec31b58-b209-6644-a8ea-717aa7cd8e3a"],
 " and negative outside the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "41018659-6a77-6943-912f-55c2cc683ad2"],
 "."
}], "Usage",
 CellChangeTimes->{{4.0038045410725307`*^9, 4.003804541305889*^9}},
 CellID->1037885325,ExpressionUUID->"4feb5bb2-6831-024f-ab13-2b719a6b72cb"],

Cell["The following options can be given: ", "Notes",
 CellID->112430554,ExpressionUUID->"8a772a6b-5f17-fa45-90fd-dd942ea92db2"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "195fb69c-f997-0c47-9775-fba6095c3386"], 
    ButtonBox["DistanceRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/DistanceRange"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     "DistanceRange is an option for ",
     Cell[BoxData[
     "MakeDistanceMap"], "InlineFormula",ExpressionUUID->
      "1976ac55-a99b-9b42-ad6e-92a63a5817e2"],
     ". It defines the range of the distance map outside the segmentation in \
voxels.\nValues can be Automatic, ",
     Cell[BoxData[
      ButtonBox["All",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "3d848c9e-f820-294e-a146-5cd5fd886dcf"],
     ", or a integer value. If ",
     Cell[BoxData[
      ButtonBox["All",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "6ac257b1-fa5d-2048-a696-1c8ff67693da"],
     " the distance map is calculated for the whole image. If 0 the \n\
distance map is only calculated inside the segmentation."
    }], "TableText",ExpressionUUID->"182b452a-cfd6-224f-bf4e-59874b964445"]}
  }]], "3ColumnTableMod",
 CellID->327077327,ExpressionUUID->"93c64df6-2eeb-2b47-887c-6637639477e3"]
}, Open  ]],

