Notebook[{

Cell[CellGroupData[{
Cell["MakeDistanceMap", "ObjectName",
 CellID->819040802,ExpressionUUID->"8c62ad24-7ebd-ad49-a8ef-f450a53b6279"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0dc99369-5da8-604b-9f5b-585aa25701a7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeDistanceMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeDistanceMap"], "[", 
   StyleBox["mask", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "be22cd83-97d2-4641-97c2-5b3f4e320d09"],
 "\[LineSeparator]makes a distance map of the given ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "71819db2-50a4-6b41-8636-58160e076ef5"],
 " in voxels. The distance map is negative inside the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "b358afe3-b50f-ce43-8fe8-29a8259faa75"],
 " and positive outside the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "bcf7ee89-db59-3a4a-9ccf-196e78705c83"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f0591871-a439-c24e-8ba9-fb1f95195e73"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeDistanceMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeDistanceMap"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d37c65dd-83d3-ad49-bad0-475786ea9e20"],
 "\[LineSeparator]makes a distance map of the given ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "d361f34f-bf01-6e41-be96-747428588f25"],
 " in the same unit as ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "b0161407-f348-8540-985f-aab8dd91dff4"],
 ". The distance map is negative inside the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "94c4fa05-f72d-b242-a5ba-f4f7fa6b713f"],
 " and positive outside the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "0825fe9b-1625-414b-b0e3-a38c403bff8d"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9966562921136456`*^9, 3.996656292302166*^9}},
 CellID->26805666,ExpressionUUID->"a9c267f4-4ccc-bc4e-944d-036ce04d2bb8"],

Cell["The following options can be given: ", "Notes",
 CellID->472606701,ExpressionUUID->"e67bd157-ebb5-954f-9dcc-a3717cbfb509"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "715e7a34-d458-f647-b0f4-de85839bb941"], 
    ButtonBox["DistanceRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DistanceRange"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["DistanceRange",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DistanceRange"]], "InlineFormula",
      ExpressionUUID->"42485c8e-3e9c-4b48-af88-d42d45de2b6d"],
     " is an option for ",
     Cell[BoxData[
     "MakeDistanceMap"], "InlineFormula",ExpressionUUID->
      "315b92c0-4e27-aa42-9569-ea0a44e92a85"],
     ". It defines the range of the distance map outside the segmentation in \
voxels.\nValues can be Automatic, All, or a integer value. If All the \
distance map is calculated for the whole image. If 0 the distance map is only \
calculated inside the segmentation."
    }], "TableText",ExpressionUUID->"8efe37e4-e4e4-d94b-b9c6-f88888d98b35"]}
  }]], "3ColumnTableMod",
 CellID->301750560,ExpressionUUID->"dcb374c5-e763-d649-8280-f7f2b2b9dba6"]
}, Open  ]],

