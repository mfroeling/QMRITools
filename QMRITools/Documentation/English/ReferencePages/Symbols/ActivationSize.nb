Notebook[{

Cell[CellGroupData[{
Cell["ActivationSize", "ObjectName",
 CellID->460493803,ExpressionUUID->"dff527dd-39b3-7f45-9cab-30d62f53d3e0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"642c701e-d5fa-f743-8214-86098e5bbbce"],
 Cell[BoxData[
 "ActivationSize"], "InlineFormula",ExpressionUUID->
  "55637efc-a0d1-b840-a4c5-a69711f0a48a"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["SelectActivations",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SelectActivations"]], "InlineFormula",
  ExpressionUUID->"cb76de1f-2132-3743-86e1-2a0714605826"],
 ". Its the minimal size of the activations selected, in number of connected \
voxels within a slice if SizeMethod is \"Voxels\" and in mm^2 if SizeMethod \
is \"Area\". The default is Automatic which is 4 voxels for \"Voxels\" and 30 \
mm^2 for \"Area\". For \"Area\" the size is rounded up to whole voxels."
}], "Usage",
 CellID->485284724,ExpressionUUID->"38af4035-adfc-9440-8932-b405aac7cf9e"],

Cell["XXXX", "Notes",
 CellID->643242556,ExpressionUUID->"378e4487-5f17-354c-b695-312280dfa8f3"]
