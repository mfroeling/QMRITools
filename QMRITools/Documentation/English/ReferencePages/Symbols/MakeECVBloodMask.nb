Notebook[{

Cell[CellGroupData[{
Cell["MakeECVBloodMask", "ObjectName",
 CellID->450072629,ExpressionUUID->"d553abab-c402-ea4f-8af3-28134aa3db8d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2684beb3-3d4d-4f4f-ab31-618792e9d78c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeECVBloodMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/MakeECVBloodMask"], "[", 
   RowBox[{"T$1pre", ",", "T$1post"}], "]"}]], "InlineFormula",ExpressionUUID->
  "801b4eb2-bb3c-8940-ab37-c6256d9b3e04"],
 "\[LineSeparator]makes a bloodpool mask based on the ",
 Cell[BoxData[
  StyleBox["T1pre", "TI"]], "InlineFormula",ExpressionUUID->
  "190bf7aa-4ab1-1f45-bd13-30e9214ec789"],
 " and ",
 Cell[BoxData[
  StyleBox["T1post", "TI"]], "InlineFormula",ExpressionUUID->
  "dfa37306-7024-264e-ae91-8fbe9aa90e69"],
 " images. It assumes that the hart is cropped with the blood in the center. \
The ",
 Cell[BoxData[
  StyleBox["T1pre", "TI"]], "InlineFormula",ExpressionUUID->
  "0d2666d3-0fdc-2a44-a6c9-c0325c0864b5"],
 " and ",
 Cell[BoxData[
  StyleBox["T1post", "TI"]], "InlineFormula",ExpressionUUID->
  "b77fbc3a-202c-d748-a05d-50a2d8b3e7e5"],
 " maps are assumed to be in ms."
}], "Usage",
 CellChangeTimes->{{3.99853324288863*^9, 3.998533243114048*^9}},
 CellID->664292994,ExpressionUUID->"45cd12e1-9c49-fd47-a232-a68f0d4d6c1a"],

