Notebook[{

Cell[CellGroupData[{
Cell["MakeECVBloodMask", "ObjectName",
 CellID->467010721,ExpressionUUID->"396f4954-1d13-c445-8eb5-fef7267114a5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d316408f-8ced-2b4f-8fcd-ea9c4cfa894a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeECVBloodMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/MakeECVBloodMask"], "[", 
   RowBox[{"T$1pre", ",", "T$1post"}], "]"}]], "InlineFormula",ExpressionUUID->
  "1ae2c797-8f20-c74a-9615-d9aa0db58f3b"],
 "\[LineSeparator]makes a bloodpool mask based on the ",
 Cell[BoxData[
  StyleBox["T1pre", "TI"]], "InlineFormula",ExpressionUUID->
  "7786a84a-61c2-7140-aff7-46854298dfe5"],
 " and ",
 Cell[BoxData[
  StyleBox["T1post", "TI"]], "InlineFormula",ExpressionUUID->
  "c62bd1c6-a9de-a64e-aa11-491fd203dcd9"],
 " images. It assumes that the hart is cropped with the blood in the center. \
The ",
 Cell[BoxData[
  StyleBox["T1pre", "TI"]], "InlineFormula",ExpressionUUID->
  "c2a230a5-f52a-1b46-a685-d0a3ad0a642d"],
 " and ",
 Cell[BoxData[
  StyleBox["T1post", "TI"]], "InlineFormula",ExpressionUUID->
  "75be8b6c-144a-b54f-aad9-c10ce852e563"],
 " maps are assumed to be in ms."
}], "Usage",
 CellChangeTimes->{{3.9966562447464905`*^9, 3.9966562448289146`*^9}},
 CellID->43716796,ExpressionUUID->"e2d5d5c7-2410-1541-83f4-8cb54cb23fe2"],

