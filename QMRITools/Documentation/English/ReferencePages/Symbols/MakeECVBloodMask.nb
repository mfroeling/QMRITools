Cell[CellGroupData[{
Cell["MakeECVBloodMask", "ObjectName",
 CellID->67604598,ExpressionUUID->"905e3ebd-f6bf-2448-a49a-04d90a10de88"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"64b2edf7-893c-4349-ae7b-cc36131ee9c0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeECVBloodMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/MakeECVBloodMask"], "[", 
   RowBox[{"T$1pre", ",", "T$1post"}], "]"}]], "InlineFormula",ExpressionUUID->
  "bd41d248-a009-004f-a7d9-fd0ccdd50d7b"],
 "\[LineSeparator]makes a bloodpool mask based on the ",
 Cell[BoxData[
  StyleBox["T1pre", "TI"]], "InlineFormula",ExpressionUUID->
  "26217227-e4da-314a-8d12-8e915cc5d9e7"],
 " and ",
 Cell[BoxData[
  StyleBox["T1post", "TI"]], "InlineFormula",ExpressionUUID->
  "1ef4abc6-6e73-db4e-a52e-9ce58edd2617"],
 " images. It assumes that the hart is cropped with the blood in the center. \
The ",
 Cell[BoxData[
  StyleBox["T1pre", "TI"]], "InlineFormula",ExpressionUUID->
  "bd48a311-0c45-ef40-b08e-4542166d6f45"],
 " and ",
 Cell[BoxData[
  StyleBox["T1post", "TI"]], "InlineFormula",ExpressionUUID->
  "000a4b3d-15b1-024c-a64e-d03dd5ed14ec"],
 " maps are assumed to be in ms."
}], "Usage",
