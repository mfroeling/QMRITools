Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ecb63945-3837-3140-919f-918d552dd934"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AverageKspace",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/AverageKspace"], "[", 
   RowBox[{
    StyleBox["kspace", "TI"], ",", 
    StyleBox["types", "TI"], ",", 
    StyleBox["met", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f2ae2f85-ca76-3c45-94dd-9a9688001df0"],
 "\[LineSeparator]calculates the average of the ",
 Cell[BoxData[
  StyleBox["kspace", "TI"]], "InlineFormula",ExpressionUUID->
  "e265028c-e43f-1743-b1de-51a0c49e6f6d"],
 " over the type \"N_aver\". The method that can be used are \"Mean\", \
\"Total\", \"Hamming\"."
}], "Usage",
