Notebook[{

Cell[CellGroupData[{
Cell["CorrectParMap", "ObjectName",
 CellID->602060755,ExpressionUUID->"07365e55-88a1-bb46-9b51-5c61b7b687df"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"69cb20d6-a2df-b24d-9c85-53a8135cff11"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CorrectParMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/CorrectParMap"], "[", 
   RowBox[{
    StyleBox["par", "TI"], ",", 
    StyleBox["constraints", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "11d327c8-f88f-ce48-a7d4-177976547f05"],
 "\[LineSeparator]removes the IVIM parameters outside the ",
 Cell[BoxData[
  StyleBox["constraints", "TI"]], "InlineFormula",ExpressionUUID->
  "8036a703-5a89-764d-90c3-c635f94e9436"],
 " within the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "8535c297-071d-0d4e-8791-ef56d648c812"],
 ". ",
 Cell[BoxData[
  StyleBox["par", "TI"]], "InlineFormula",ExpressionUUID->
  "43310024-f069-b043-a59a-ee049f2c59b1"],
 " is {f1, dc, pdc1} or {f1, f2, dc, pdc1, pdc2}. ",
 Cell[BoxData[
  StyleBox["constraints", "TI"]], "InlineFormula",ExpressionUUID->
  "e89fa836-2814-b341-a454-420effb4ec3e"],
 " are the lower and upper ",
 Cell[BoxData[
  StyleBox["constraints", "TI"]], "InlineFormula",ExpressionUUID->
  "d114fe11-ca36-b743-888c-7ffbee9ed5f7"],
 " for each parameters {{min, max},...}. ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "0f8b58bd-1ab4-dd4d-8c54-74e00f3ca7cf"],
 " has the same dimensions as the parameter maps. output are the corrected \
paremeter maps."
}], "Usage",
 CellChangeTimes->{{3.996656589970356*^9, 3.9966565900835514`*^9}},
 CellID->404787551,ExpressionUUID->"8e65a7ad-f10f-0a42-8c91-dcee9baec2a4"],

