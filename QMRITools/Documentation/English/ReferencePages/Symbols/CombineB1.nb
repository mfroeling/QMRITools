Cell[CellGroupData[{
Cell["CombineB1", "ObjectName",
 CellID->24057068,ExpressionUUID->"ba4e36ad-828a-4e47-8ad2-ed0b39f02470"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9a79df69-8773-b843-94a1-894400df276f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CombineB1",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/CombineB1"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["10", "TR"]], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["190", "TR"]], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["f", "TI"], 
       StyleBox["2", "TR"]], ",", 
      StyleBox["ang", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"28a0011b-bd8a-d741-ada5-112f4cddbb47"],
 "\[LineSeparator]combines the complex b1 maps with relative amplitudes f1 \
and ",
 Cell[BoxData[
  StyleBox["f2", "TI"]], "InlineFormula",ExpressionUUID->
  "1792883a-7a0d-824c-a248-1dda135ea02c"],
 " using phase angle ang."
}], "Usage",
 CellChangeTimes->{{3.9966568131495705`*^9, 3.9966568132009525`*^9}},
 CellID->144594028,ExpressionUUID->"2915e3bd-4873-3045-b727-96df5e15187d"],

Cell["The following options can be given: ", "Notes",
 CellID->144507940,ExpressionUUID->"fc49889b-e3d4-0b4e-a350-bdb3643bcf2c"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "28c84f6a-24d2-9441-af5a-c2f732d715a8"], 
    ButtonBox["B1Scaling",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/B1Scaling"], "\"\<Relative\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["B1Scaling",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/B1Scaling"]], "InlineFormula",
      ExpressionUUID->"c39b2a1a-38a6-fd41-8364-49b8158f92fe"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["B1Shimming",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/B1Shimming"]], "InlineFormula",
      ExpressionUUID->"fd584f18-93d2-2044-9056-3fcdfbb3f9ca"],
     " and ",
     Cell[BoxData[
     "CombineB1"], "InlineFormula",ExpressionUUID->
      "3f22095a-703f-904b-9109-f83fd52dcc9f"],
     ". Values can be \"Relative\" or \"Absolute\". \"Absolute\" assumes b1 \
maps are\ngiven in uT, \"Relative\" assumes that maps are in %."
    }], "TableText",ExpressionUUID->"f10a2c95-8dd1-7044-bf47-3a21bdf2de0f"]}
  }]], "3ColumnTableMod",
