Notebook[{

Cell[CellGroupData[{
Cell["MakeSpinSystem", "ObjectName",
 CellID->14088627,ExpressionUUID->"82d42c95-9b8c-6345-b764-fef9fa6f888d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8fa96747-1e87-614f-bd6e-95b6537a752b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeSpinSystem",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/MakeSpinSystem"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", 
    StyleBox["freqs", "TI"], ",", 
    StyleBox["jcoup", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a2d4a282-eec0-3e40-bce8-54ba2d994ba3"],
 "\[LineSeparator]makes a spin system for jcoupling simulations. The with ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",ExpressionUUID->
  "56ceaca8-a1c4-f24e-95fd-a5aa6d826d60"],
 " is defined by the ",
 Cell[BoxData[
  StyleBox["freqs", "TI"]], "InlineFormula",ExpressionUUID->
  "67b0500d-6a93-3a4c-a4c6-49d32534ddfe"],
 " of the nuclei and the ",
 Cell[BoxData[
  StyleBox["jcoup", "TI"]], "InlineFormula",ExpressionUUID->
  "841b197a-1770-1245-abf9-56fb7ab04ec2"],
 " values {{n1, nx}, j} between nuclei. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e6acdc38-1d7c-984b-97a4-7c1872543ac2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeSpinSystem",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/MakeSpinSystem"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["name", "TI"], ",", 
      StyleBox["labs", "TI"]}], "}"}], ",", 
    StyleBox["freqs", "TI"], ",", 
    StyleBox["jcoup", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d1beb6a0-b144-7543-aa18-4a96418a6a7e"],
 "\[LineSeparator]same but each nuclei has a specific ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",ExpressionUUID->
  "c2a5caf7-d4f0-a748-8771-cd422528f407"],
 ", e.g.{\"ATP\", {\"\[Gamma]\",\"\[Alpha]\",\"\[Beta]\"}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"40a6c11e-b2e2-2542-ba87-90341964f625"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeSpinSystem",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/MakeSpinSystem"], "[", 
   RowBox[{
    StyleBox["name", "TI"], ",", 
    StyleBox["freqs", "TI"], ",", 
    StyleBox["jcoup", "TI"], ",", 
    StyleBox["scales", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "297991b6-cc6c-a646-bf88-2f7e073db3fc"],
 "\[LineSeparator]same but each nuclei has a scale, default ",
 Cell[BoxData[
  StyleBox["scales", "TI"]], "InlineFormula",ExpressionUUID->
  "26f42ed4-5846-ed44-a6f9-0d4668ec6b3c"],
 " are 1. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a3a084b5-b3c8-624b-ac51-48a131b48038"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeSpinSystem",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/MakeSpinSystem"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["name", "TI"], ",", 
      StyleBox["labs", "TI"]}], "}"}], ",", 
    StyleBox["freqs", "TI"], ",", 
    StyleBox["jcoup", "TI"], ",", 
    StyleBox["scales", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1aa02a4c-2022-0541-91b9-f3b5bf2ab233"],
 "\[LineSeparator]same as alle before."
}], "Usage",
 CellChangeTimes->{{3.996656334094183*^9, 3.9966563344179497`*^9}},
 CellID->219144727,ExpressionUUID->"aa92eb3b-1ede-d44a-bf39-58c274d5322c"],

Cell["The following options can be given: ", "Notes",
 CellID->615596817,ExpressionUUID->"a9aafc16-dc1d-2945-aece-32b6fab70472"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b7c2a8dc-4a69-7446-a838-740091fbe3c3"], 
    ButtonBox["CenterFrequency",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/CenterFrequency"], "0", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["CenterFrequency",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CenterFrequency"]], "InlineFormula",
      ExpressionUUID->"a65fefc1-6038-9c49-ab39-55e096052d51"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["GetSpinSystem",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetSpinSystem"]], "InlineFormula",
      ExpressionUUID->"3094ea72-0333-304e-a85f-2c0211abbd50"],
     " and defines the center frequency in ppm."
    }], "TableText",ExpressionUUID->"8183e762-df7e-b643-9457-c592b8de6beb"]}
  }]], "3ColumnTableMod",
 CellID->394536553,ExpressionUUID->"ad04543c-91b9-5048-957a-bf0509a70eb7"]
