Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0ec45e08-25f9-3a41-b6b0-ff31298b2a2d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RescaleData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/RescaleData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4c965107-8311-864c-bb80-9a688bf21e69"],
 "\[LineSeparator]rescales the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "42d6aaea-85ee-1141-ac4f-8fd126ac4841"],
 " to given dimensions. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8caeda72-5a9c-a641-8358-a28e308e6117"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RescaleData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/RescaleData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["vox", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["vox", "TI"], 
       StyleBox["2", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"423d1b12-977d-184f-a595-7178213c2183"],
