 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "cc5035cc-7f6a-7d44-993f-7cbfa9389dd9"],
 " from size vox1 to size vox2."
}], "Usage",
