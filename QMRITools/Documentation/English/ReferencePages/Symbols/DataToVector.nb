Notebook[{

Cell[CellGroupData[{
Cell["DataToVector", "ObjectName",
 CellID->337823606,ExpressionUUID->"d5380228-c2af-6e40-9f26-45c3fe476c4b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"509f2728-ed0d-f347-a8f5-077c8270cefb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DataToVector",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/DataToVector"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3538e85f-e8c8-4d4e-a80c-186b01ddaead"],
 "\[LineSeparator]converts the non zero ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "29802c2a-6206-2844-918c-c5460084fa57"],
 " to vector. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8ae0a891-55fb-5541-aaa6-ad72b3738f15"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DataToVector",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/DataToVector"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5c8da22d-94f7-6f48-b67b-8dc65233c849"],
 "\[LineSeparator]converts the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "85614e90-94a1-7b4f-9325-d463e8d0f50d"],
 " within the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "881d228f-8573-c74f-9b24-d258cc32d2cb"],
 " to vector. The ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "7d8948d5-45b9-4d46-a8b7-f9894e4931d6"],
 " can be reconstructed using ",
 Cell[BoxData[
  ButtonBox["VectorToData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/VectorToData"]], "InlineFormula",
  ExpressionUUID->"6ac0ddb7-c8b9-a040-a17b-f459b0c913fc"],
 ". Output is the vectorized data and a list containing the original data \
dimensions and a list with the data coordinates. {vec, {dim,pos}}."
}], "Usage",
 CellChangeTimes->{{3.9966566468066635`*^9, 3.9966566469706707`*^9}},
 CellID->34251844,ExpressionUUID->"32dcfa50-5d4e-df42-bb95-210b8aa53b49"],

