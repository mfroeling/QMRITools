Notebook[{

Cell[CellGroupData[{
Cell["RegisterDataTransformSplit", "ObjectName",
 CellID->74314706,ExpressionUUID->"5ddcdf8b-34ec-db4c-96e0-9caff0905d29"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8ee464ad-00d5-be45-b84f-bb286d2dfb17"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDataTransformSplit",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsElastixTools/ref/RegisterDataTransformSplit"], "[", 
   RowBox[{
    StyleBox["target", "TI"], ",", 
    StyleBox["moving", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["moving", "TI"], 
       StyleBox[
        RowBox[{"2", "nd"}], "TI"]], ",", 
      StyleBox["vox", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"21175d7c-4e17-714c-b54c-f2e02b0cefe8"],
 "\[LineSeparator]is identical to ",
 Cell[BoxData[
  ButtonBox["RegisterDataTransform",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterDataTransform"]], 
  "InlineFormula",ExpressionUUID->"20173a90-1ea6-0842-9b28-dde743bef793"],
 " with the same functionality as ",
 Cell[BoxData[
  ButtonBox["RegisterDataSplit",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterDataSplit"]], "InlineFormula",
  ExpressionUUID->"c2a0dcd4-993e-164f-94fb-1f499965a562"],
 ". This means the data is split in two using the function ",
 Cell[BoxData[
  ButtonBox["CutData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CutData"]], "InlineFormula",
  ExpressionUUID->"18ed72b0-faf6-874d-b9d7-673cb8d34e2c"],
 " and merged wit Stich data. Output is {registered moving, deformed \
moving2nd}."
}], "Usage",
 CellChangeTimes->{3.996655569971529*^9},
 CellID->167330567,ExpressionUUID->"7d2025ed-67cb-604c-ab0b-3f3eb2413ca5"],

