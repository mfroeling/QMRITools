Cell[CellGroupData[{
Cell["ReadBvalue", "ObjectName",
 CellID->9840310,ExpressionUUID->"b2075be0-e5ff-d64f-90e9-299f995cef37"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fd360dc6-6c7d-2445-a4fc-21d907845eb4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReadBvalue",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsLegacy/ref/ReadBvalue"], "[", 
   RowBox[{
    StyleBox["folder", "TI"], ",", 
    StyleBox["nr", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4dfff3ee-f943-3241-a973-5896729293ce"],
 "\[LineSeparator]imports the gradient directions from the dicom header of \
the first ",
 Cell[BoxData[
  StyleBox["nr", "TI"]], "InlineFormula",ExpressionUUID->
  "77cd53e1-56c5-3442-b38d-2fcd95dd91d6"],
 " of files in de given ",
 Cell[BoxData[
  StyleBox["folder", "TI"]], "InlineFormula",ExpressionUUID->
  "1a10d9b0-1a33-9945-a430-a0c34c666c8e"],
 ". ",
 Cell[BoxData[
  StyleBox["folder", "TI"]], "InlineFormula",ExpressionUUID->
  "0ed827f4-fc30-3345-82f4-5ce81ba41cca"],
 " must be a string, ",
 Cell[BoxData[
  StyleBox["nr", "TI"]], "InlineFormula",ExpressionUUID->
  "f16cacd9-bf94-044c-92a6-692e9bd35bdf"],
 " must be a int. Uses ",
 Cell[BoxData[
  ButtonBox["BvalRead",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/BvalRead"]], "InlineFormula",
  ExpressionUUID->"53f2c306-db2d-044a-a96a-467ced93d2ca"],
 "."
}], "Usage",
