Notebook[{

Cell[CellGroupData[{
Cell["FilterTracts", "ObjectName",
 CellID->131250515,ExpressionUUID->"da0734e1-4d34-884c-b7ae-4a6b4fd40510"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4a66faa1-998e-b445-962d-974e5cea03a1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FilterTracts",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/FilterTracts"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["select", "TI"], ".."}], " ", "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"803c837a-295c-1f47-b91f-32d03dca0198"],
 "\[LineSeparator]filters the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "0ab43051-2548-6e45-bfca-dd8c0ad2650e"],
 " based on the list of select criteria. Select criteria are defined as \
{\"logic\",{\"how\", criteria}}. The \"logic\" parameter can be \"and\", \"or\
\" and \"not\". The \"how\" parameter can be: \t- \"x\", \"y\", or \"z\" for \
slice selection, here criteria is a slice number \t- \"through\" for \
selecting tract that go through a roi, here criteria is a 3D mask. \t- \
\"within\" for selecting tract that fit fully within the roi, here criteria \
is a 3D mask. \t- \"partWithin\" for selecting the part of the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "c6a6dc3a-6723-1e4d-9631-22dbceb663f2"],
 " that fall within the roi, here criteria is a 3D mask. Any number of select \
criteria can be listed."
}], "Usage",
 CellChangeTimes->{{4.003804520661707*^9, 4.0038045207205505`*^9}},
 CellID->294585098,ExpressionUUID->"5cb5be46-4a98-8540-876d-fd58e7e03bc1"],

Cell["The following options can be given: ", "Notes",
 CellID->4898032,ExpressionUUID->"9bbf0755-3ea4-b146-a24b-c18d24cc9be2"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "92511420-1758-c642-adf1-5c603cbdb53d"], 
    ButtonBox["FiberLengthRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsTractographyTools/ref/FiberLengthRange"], 
    RowBox[{"{", 
     RowBox[{"20", ",", " ", "500"}], "}"}], Cell["\<\
FiberLengthRange is an option for FiberTractography and specifies the allowed \
tract range.\
\>", "TableText",ExpressionUUID->"9579c5d8-f119-2745-9c52-cdbbbfb701ca"]}
  }]], "3ColumnTableMod",
 CellID->753611507,ExpressionUUID->"cc507957-856f-084c-9522-e35084570e6e"]
}, Open  ]],

