Notebook[{

Cell[CellGroupData[{
Cell["FilterTracts", "ObjectName",
 CellID->238708792,ExpressionUUID->"969aa744-e968-ee45-a7d9-5b7ad0065d80"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a783b888-d9e4-ed46-9cbb-75087d9db0b8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FilterTracts",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/FilterTracts"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["select", "TI"], ".."}], " ", "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"c3d84bcd-59ab-f544-8ebd-8f72a455ac52"],
 "\[LineSeparator]filters the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "5eb58f02-50d5-944b-8e25-8e3e5f4c720e"],
 " based on the list of select criteria. Select criteria are defined as \
{\"logic\",{\"how\", criteria}}. The \"logic\" parameter can be \"and\", \"or\
\" and \"not\". The \"how\" parameter can be: \t- \"x\", \"y\", or \"z\" for \
slice selection, here criteria is a slice number \t- \"through\" for \
selecting tract that go through a roi, here criteria is a 3D mask. \t- \
\"within\" for selecting tract that fit fully within the roi, here criteria \
is a 3D mask. \t- \"partWithin\" for selecting the part of the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "1e4026ac-7e39-c845-a50e-12b13c6016fb"],
 " that fall within the roi, here criteria is a 3D mask. Any number of select \
criteria can be listed."
}], "Usage",
 CellChangeTimes->{{3.996656636620407*^9, 3.9966566366810493`*^9}},
 CellID->482707378,ExpressionUUID->"763fb9e5-a9f0-db44-8f7b-83b60e3d7344"],

Cell["The following options can be given: ", "Notes",
 CellID->52526074,ExpressionUUID->"0b36d9eb-4e95-5f4a-8732-09e9aef5b26b"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f36d8677-d667-ab47-8ab9-541d25c215fc"], 
    ButtonBox["FiberLengthRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/FiberLengthRange"], 
    RowBox[{"{", 
     RowBox[{"20", ",", " ", "500"}], "}"}], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["FiberLengthRange",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/FiberLengthRange"]], "InlineFormula",
      ExpressionUUID->"021f1a4f-5369-7840-93c3-19493b0248e0"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["FiberTractography",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/FiberTractography"]], 
      "InlineFormula",ExpressionUUID->"5963917b-f30b-ce47-b39a-a17f27b66a4e"],
     " and specifies the allowed tract range."
    }], "TableText",ExpressionUUID->"389c906a-0ad9-974a-a163-75828134edd1"]}
  }]], "3ColumnTableMod",
 CellID->180823420,ExpressionUUID->"a9588dad-7659-5242-9464-6599f3e42919"]
}, Open  ]],

