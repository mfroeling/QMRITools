Notebook[{

Cell[CellGroupData[{
Cell["FilterTracts", "ObjectName",
 CellID->768414702,ExpressionUUID->"71bbd335-5af9-9e47-b596-da6e5f018d6e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"082ea019-64f4-bf46-82db-36e91021e3f9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FilterTracts",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/FilterTracts"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["select", "TI"], ".."}], " ", "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"055130cb-8933-5e4b-b75c-ca7445f624d9"],
 "\[LineSeparator]filters the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "9b2117d4-b990-6a4c-9dab-f3ed4d5a1905"],
 " based on the list of select criteria. Select criteria are defined as \
{\"logic\",{\"how\", criteria}}. The \"logic\" parameter can be \"and\", \"or\
\" and \"not\". The \"how\" parameter can be: \t- \"x\", \"y\", or \"z\" for \
slice selection, here criteria is a slice number \t- \"through\" for \
selecting tract that go through a roi, here criteria is a 3D mask. \t- \
\"within\" for selecting tract that fit fully within the roi, here criteria \
is a 3D mask. \t- \"partWithin\" for selecting the part of the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "53a2aa88-7cb1-ab48-aa66-dbbbd1b54c6d"],
 " that fall within the roi, here criteria is a 3D mask. Any number of select \
criteria can be listed."
}], "Usage",
 CellChangeTimes->{{3.9985332159187546`*^9, 3.998533216016577*^9}},
 CellID->333825100,ExpressionUUID->"c5fc704d-966e-264b-9840-2af1126aff0f"],

Cell["The following options can be given: ", "Notes",
 CellID->52845727,ExpressionUUID->"bbe84678-f8b9-4244-b6df-c6836ec41262"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4f8a904b-76c1-934f-b8ab-fe8da5678bd4"], 
    ButtonBox["FiberLengthRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsTractographyTools/ref/FiberLengthRange"], 
    RowBox[{"{", 
     RowBox[{"20", ",", " ", "500"}], "}"}], Cell["\<\
FiberLengthRange is an option for FiberTractography and specifies the allowed \
tract range.\
\>", "TableText",ExpressionUUID->"74cace48-36b1-fc41-be14-70a5d28f1768"]}
  }]], "3ColumnTableMod",
 CellID->81694415,ExpressionUUID->"d28a42e5-5ea6-5849-b2a4-72becc59e7b8"]
}, Open  ]],

