Cell[CellGroupData[{
Cell["GetSegmentSlices", "ObjectName",
 CellID->329878340,ExpressionUUID->"4d3dd525-8760-544f-8f18-12e4cf19526c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"de7cd6de-d424-514f-bef8-bc1b0ad07e33"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetSegmentSlices",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/GetSegmentSlices"], "[", 
   StyleBox["mask", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2d924dde-3766-434a-a375-3f74511a2402"],
 "\[LineSeparator]based on the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "2901a4c0-0bac-c74a-9ef9-debe25928c15"],
 " it gives back the slice numbers of the apex,apical,mid-vertical,and basal \
slices. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c1d10558-0fb3-2743-82da-b2faeeab94e6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetSegmentSlices",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/GetSegmentSlices"], "[", 
   StyleBox["points", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c16c068e-7cb2-4742-bff8-cad9af409300"],
 "\[LineSeparator]does the same but then based on the ",
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",ExpressionUUID->
  "44737493-460c-4e45-b577-e36faf74d71f"],
 " obtained form ",
 Cell[BoxData[
  ButtonBox["GetMaskSegmentPoints",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetMaskSegmentPoints"]], "InlineFormula",
  ExpressionUUID->"d3c5f3ec-160c-fc4b-ba08-dd4a94a26c49"],
 "."
}], "Usage",
