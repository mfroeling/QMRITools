Notebook[{

Cell[CellGroupData[{
Cell["EPGRepetitionTime", "ObjectName",
 CellID->142363374,ExpressionUUID->"f11a292f-b971-5245-94c0-7de36a9aa203"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e3c2f351-8291-2a42-9a5b-95d8b5ee704a"],
 Cell[BoxData[
 "EPGRepetitionTime"], "InlineFormula",ExpressionUUID->
  "43b93e08-b5da-c44e-aa2b-2f59cf88deb5"],
 "\[LineSeparator]is an option for EPGT2Fit and CalibrateEPGT2Fit. If larger \
than 0 it is the repetition time in ms and the water and fat signals are \
corrected for incomplete T1 recovery between repetitions, using the T1 values \
of EPGRelaxPars. The water signal fraction of adipose tissue in the fat model \
is then also reduced such that it is 10% water after the correction."
}], "Usage",
 CellID->182560124,ExpressionUUID->"d273848e-72f5-ee4f-beb2-d95b7750a5ec"],

Cell["XXXX", "Notes",
 CellID->430587111,ExpressionUUID->"c366d6cb-174d-164c-a6de-62b68ba873c0"]
}, Open  ]],

