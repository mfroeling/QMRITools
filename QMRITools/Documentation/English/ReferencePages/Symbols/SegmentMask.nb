Cell[CellGroupData[{
Cell["SegmentMask", "ObjectName",
 CellID->66726617,ExpressionUUID->"ec396765-da7e-bd45-b193-a7ace3e4efa5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"71782c54-f965-794f-8aea-e2e004d4d1b3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/SegmentMask"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6752f312-a0f4-9e45-8dd0-539113c8e124"],
 "\[LineSeparator]divides a ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "c042d28e-58c2-eb45-91fd-7fa6e73c5060"],
 " in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "2dde875e-d165-c846-9c0f-218458527580"],
 " segments along the slice direction, ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "487f12f5-61cc-894b-a33a-7c4d8fc56da9"],
 " must be an integer. The ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "3379a553-2dac-be43-8cfe-f2e711b6d34c"],
 " is divided in ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "24cbe4e3-355d-1742-aff7-537ba2368ace"],
 " equal parts where each parts has the same number of slices."
}], "Usage",
 CellChangeTimes->{{3.996656665747814*^9, 3.996656665850296*^9}},
 CellID->368087573,ExpressionUUID->"10973ca8-18d9-f94d-b6b1-d9742d753e50"],

