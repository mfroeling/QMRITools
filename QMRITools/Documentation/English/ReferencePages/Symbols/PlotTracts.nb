Cell["The following options can be given: ", "Notes",
 CellID->600135357,ExpressionUUID->"d044848d-c002-2844-9810-fb2aa5930323"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "60dd6fea-00bd-be4e-95b1-b04220b4c263"], 
    ButtonBox["MaxTracts",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MaxTracts"], "2000", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["MaxTracts",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MaxTracts"]], "InlineFormula",
      ExpressionUUID->"d151372d-dbaa-ec41-8c89-915264d0bcff"],
     " is an option for ",
     Cell[BoxData[
     "PlotTracts"], "InlineFormula",ExpressionUUID->
      "4d40c7a0-cc92-bb40-bb59-791d6e4307d9"],
     ". It specifies how many tracts are plotted."
    }], "TableText",ExpressionUUID->"0c89f4aa-bebb-3f48-8fcb-db9f5a5c9893"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ee44c50e-ec3e-a44d-a6dc-1d09458998d9"], 
    ButtonBox["ImageSize",
     BaseStyle->"Link"], "600", Cell["\<\
ImageSize is an option that specifies the overall size of an image to display \
for an object. \
\>", "TableText",ExpressionUUID->"80589049-43b9-f140-b767-775dcfe6859f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6a8de91c-8ee0-fb4d-8453-062d81433d76"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<line\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"d6fca319-036d-5b47-82e8-7aecac7a3d67"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "67b53173-5e1b-0f4a-b34c-0cc984659380"], 
    ButtonBox["TractColoring",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/TractColoring"], "\"\<Direction\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["TractColoring",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TractColoring"]], "InlineFormula",
      ExpressionUUID->"325e3f55-7458-884c-b7ab-c2ed4f64175f"],
     " is an option for ",
     Cell[BoxData[
     "PlotTracts"], "InlineFormula",ExpressionUUID->
      "e2c99ed1-b4cf-3f4b-ba6a-97232402f327"],
     " and sets how the tracts are colored. Values can be \"Direction\", \
\"Length\", \"Angle\", {par}, or RGBColor[].\nFor \"Length\", \"Angle\", \
{par} it can be defined in the form {..., {min, max}} where the {min, max} \
specifies the range of the color function."
    }], "TableText",ExpressionUUID->"d643896d-11d9-364f-8c76-a8c385dbbab0"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "eabeb2e2-dc14-f842-9bac-b110759ab17b"], 
    ButtonBox["ColorFunction",
     BaseStyle->"Link"], "\"\<SouthwestColors\>\"", Cell["\<\
ColorFunction is an option for graphics functions that specifies a function \
to apply to determine colors of elements. \
\>", "TableText",ExpressionUUID->"d3993c23-8e1d-384d-a11a-9ec18abe350a"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e7b5ad0e-f0d8-ed4c-a377-a008954fc641"], 
    ButtonBox["Boxed",
     BaseStyle->"Link"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell["\<\
Boxed is an option for Graphics3D that specifies whether to draw the edges of \
the bounding box in a three\[Hyphen]dimensional picture. \
\>", "TableText",ExpressionUUID->"f3a84142-16f1-8d4c-b216-1ff5a101d31d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4f4a2214-b145-a247-a7e6-f46357392476"], 
    ButtonBox["TractSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/TractSize"], "1", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["TractSize",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TractSize"]], "InlineFormula",
      ExpressionUUID->"789c37ed-900e-8b4a-858a-58b800e04cdc"],
     " is an option for ",
     Cell[BoxData[
     "PlotTracts"], "InlineFormula",ExpressionUUID->
      "bf5f352e-6021-9240-9d03-8e57390dafe1"],
     ". When tubes are used it specifies the tube width."
    }], "TableText",ExpressionUUID->"be651fad-38d7-9d40-97e0-a64b06795f2a"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "67922c95-6472-bb4a-9bb6-8d03f4966259"], 
    ButtonBox["TractReduction",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/TractReduction"], "3", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["TractReduction",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TractReduction"]], "InlineFormula",
      ExpressionUUID->"8982f1bf-17cc-1b43-bb3f-affdf58c390d"],
     " is an option for ",
     Cell[BoxData[
     "PlotTracts"], "InlineFormula",ExpressionUUID->
      "fc9a23fc-a04d-8146-a1be-c9727986e245"],
     ". Value can be an Integer > 0, which determines with which factor the \
tract coordinates are sub sampled."
    }], "TableText",ExpressionUUID->"bd1772d5-74be-1540-b81f-bff329a96184"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f56104d7-f1d2-2a47-bf86-b8bab1c05ecc"], 
    ButtonBox["TractScaling",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/TractScaling"], "\"\<World\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["TractScaling",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TractScaling"]], "InlineFormula",
      ExpressionUUID->"a6b4d86b-b7d0-3041-bd9d-6dbb7251fda8"],
     " is an option for ",
     Cell[BoxData[
     "PlotTracts"], "InlineFormula",ExpressionUUID->
      "5519de8f-83ba-984e-8457-5941f22f12ec"],
     ". The value can be \"World\" or \"Voxel\", if the value is \"World\" \
the tracts are in mm else in voxel coordinates."
    }], "TableText",ExpressionUUID->"70e9ff70-a484-a945-afb1-ce5edb203094"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "60d54db9-1d03-354c-97c2-1464ef55312b"], 
