Cell["FindCrop", "ObjectName",
 CellID->167673926,ExpressionUUID->"5b1315a5-ae78-d545-9373-dbdcee5dea4a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c87a8466-278f-0f41-8f50-d8aca6e865d2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindCrop",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/FindCrop"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8fbc0c47-e577-9745-825a-8ed6f76f64bf"],
 "\[LineSeparator]finds the crop values of the data by removing all zeros \
surrounding the data. If the data is all zero the full range is returned."
}], "Usage",
 CellChangeTimes->{4.003804521484022*^9},
