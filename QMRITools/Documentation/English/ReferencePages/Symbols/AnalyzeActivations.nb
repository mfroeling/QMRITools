Notebook[{

Cell[CellGroupData[{
Cell["AnalyzeActivations", "ObjectName",
 CellID->18368914,ExpressionUUID->"8160092e-58ce-4b4e-9de9-4a4cd6540a16"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3b1d00be-ca70-9742-8571-386ae56e6e27"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnalyzeActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/AnalyzeActivations"], 
   "[", 
   RowBox[{
    StyleBox["actMap", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7faf932f-4d03-2140-b889-69e787763bc7"],
 "\[LineSeparator]Analysis of the activation map generated from the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "5e3c593d-045d-9a43-8742-daeaa5d76d37"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d90acaaf-4722-8b43-ad79-dd228b088dc6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnalyzeActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/AnalyzeActivations"], 
   "[", 
   RowBox[{
    StyleBox["actMap", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["lab", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d66114c3-4188-1647-9fea-344e1cb2144f"],
 "\[LineSeparator]the same but the output is an association with the name ",
 Cell[BoxData[
  StyleBox["lab", "TI"]], "InlineFormula",ExpressionUUID->
  "1a66831b-108b-d74f-877b-487e077ca7a9"],
 ", or one name per ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "beb66be4-0458-204e-bc30-a8e8d96ba0f4"],
 " for a 4D ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "ddefd2ef-7da4-c544-bb8a-8d5a64a74174"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6598291f-deb6-f846-a913-f689abc5c826"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnalyzeActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/AnalyzeActivations"], 
   "[", 
   RowBox[{
    StyleBox["actMap", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "659a7008-c041-dc4f-8dbe-faefcf58cdfa"],
 "\[LineSeparator]the same but with the voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "5fa78067-43b1-e449-b964-d4f6fa9df9c4"],
 " = {z, y, x} in mm, which adds the columns \"ROI Vol [dm3]\", \"Chance \
[%/dm3]\", \"Chance Obs [%/dm3]\" and the sizes as area in cm^2 \"Mean Area \
[cm2]\", \"StDv Area [cm2]\", \"Median Area [cm2]\", \"5% Area [cm2]\" and \
\"95% Area [cm2]\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d0ec2611-eb87-8546-921f-9b8912d5bc34"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnalyzeActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/AnalyzeActivations"], 
   "[", 
   RowBox[{
    StyleBox["actMap", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["lab", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "51e26708-cf3b-e34d-a23c-5954a35739e5"],
 "\[LineSeparator]the same with the name ",
 Cell[BoxData[
  StyleBox["lab", "TI"]], "InlineFormula",ExpressionUUID->
  "6572293b-566e-c940-9b97-0863638d3b5f"],
 " and the voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "a902e3d0-2c01-d948-9367-3e3833f9dc33"],
 ". \"Amount\" is the number of activations and \"Amount Obs\" the number of \
observations (a slice in one volume) that contain at least one activation."
}], "Usage",
 CellChangeTimes->{{4.0038044918604107`*^9, 4.0038044922003098`*^9}},
 CellID->423580110,ExpressionUUID->"a8040793-d3c5-ed4d-b4d5-c22ef8382733"],

