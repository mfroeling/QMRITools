Notebook[{

Cell[CellGroupData[{
Cell["IVIMCorrectData", "ObjectName",
 CellID->279486181,ExpressionUUID->"a8dc23e2-81d5-504e-8317-52e7f403e206"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1e22089b-0457-6d4c-baea-e9e66b01b97c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMCorrectData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMCorrectData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["0", "TR"]], ",", 
      StyleBox["f", "TI"], ",", 
      StyleBox["pdc", "TI"]}], "}"}], ",", 
    StyleBox["bval", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fbad28e5-3ceb-7943-a7ab-053df2a5596d"],
 "\[LineSeparator]removes the ivim signal from the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "b5a4301c-d3a4-5f4d-9e7e-d97ef32b797a"],
 ". ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "9e1b52eb-6b15-334b-8a58-b390b7d80fa8"],
 " is the original ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "f9eb8605-d51c-bf43-9036-608c61b83155"],
 ". {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "s0"}], "TI"]], "InlineFormula",ExpressionUUID->
  "2f5e91b2-37a0-8646-92bb-92d3b1537355"],
 "s0, ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "5734a05a-79c8-b446-83ef-2caeb2cdd454"],
 ", ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"pdc", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "645964d7-e93a-8540-8d13-a93de23df225"],
 " are the solution to a 2 compartment IVIM fit using ",
 Cell[BoxData[
  ButtonBox["IVIMCalc",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/IVIMCalc"]], "InlineFormula",
  ExpressionUUID->"0fad863a-7cdf-614c-a0a1-6d3d273bdfa3"],
 " or ",
 Cell[BoxData[
  ButtonBox["BayesianIVIMFit2",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/BayesianIVIMFit2"]], "InlineFormula",
  ExpressionUUID->"0a645559-509c-e646-bbf5-68ad72ace35e"],
 ". bval are the bvalues. The fraction is defined between 0 and 1, the pdc is \
in mm^2/s. output is the corrected data."
}], "Usage",
 CellChangeTimes->{{3.996656294239174*^9, 3.9966562943593006`*^9}},
 CellID->279266046,ExpressionUUID->"4fdc7798-707c-fb48-a5e0-dd9b034b28f1"],

