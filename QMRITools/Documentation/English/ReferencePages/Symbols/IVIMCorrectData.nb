Notebook[{

Cell[CellGroupData[{
Cell["IVIMCorrectData", "ObjectName",
 CellID->999578118,ExpressionUUID->"91370245-786b-1949-b214-4fccdc92d670"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d1b939d8-ebd5-b641-8bef-a710e64458d3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMCorrectData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMCorrectData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["0", "TR"]], ",", 
      StyleBox["f", "TI"], ",", 
      StyleBox["pdc", "TI"]}], "}"}], ",", 
    StyleBox["bval", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bb61078d-e25e-6f42-af36-766a774677de"],
 "\[LineSeparator]removes the ivim signal from the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "aa3da9cb-a3cc-c440-9b7f-e216d6c6e8f0"],
 ". ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "8c4c69d1-417a-104b-af89-1c1a0e2df627"],
 " is the original ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "84db7445-cbf0-f049-b1c1-9c86c5613623"],
 ". {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "s0"}], "TI"]], "InlineFormula",ExpressionUUID->
  "48d8d79e-cd32-504d-9b74-a83009bd4962"],
 "s0, ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "f691b491-d932-f540-803c-5b3e069196fc"],
 ", ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"pdc", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "4aa1778d-3be5-0648-8132-ab4aa9b6aff7"],
 " are the solution to a 2 compartment IVIM fit using IVIMCalc or \
BayesianIVIMFit2. ",
 Cell[BoxData[
  StyleBox["bval", "TI"]], "InlineFormula",ExpressionUUID->
  "3217cd44-52fd-6046-8113-a7c17015431b"],
 " are the bvalues. The fraction is defined between 0 and 1, the pdc is in \
mm^2/s. output is the corrected ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "79a48b44-3752-5544-9b82-b6db31f4d9c7"],
 "."
}], "Usage",
 CellChangeTimes->{{4.0038045387605953`*^9, 4.0038045388906937`*^9}},
 CellID->471533499,ExpressionUUID->"4dfa68a4-ed31-e943-b9e5-4ae9108075ed"],

Cell["The following options can be given: ", "Notes",
 CellID->172295289,ExpressionUUID->"4c772645-a988-324b-a7ab-1f2916a04b01"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bda44d90-6a76-be49-94c4-bb91c3c0ec65"], 
    ButtonBox["FilterMaps",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/FilterMaps"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "FilterMaps is an option for ",
     Cell[BoxData[
     "IVIMCorrectData"], "InlineFormula",ExpressionUUID->
      "22db28f1-dc09-3644-ac32-f685486d10e2"],
     ". If ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "340f88ca-ec89-1c48-889c-9ff4b4efabb1"],
     " the IVIM parameter maps are filtered before signal correction."
    }], "TableText",ExpressionUUID->"095db017-21a5-ec47-82ca-fbec94ae0778"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "dcf2cdc0-b64f-b340-96b0-4d33933db22d"], 
    ButtonBox["FilterType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/FilterType"], "\"\<Median\>\"",
     Cell[TextData[{
     "FilterType is an option for ",
     Cell[BoxData[
     "IVIMCorrectData"], "InlineFormula",ExpressionUUID->
      "dbebd7c2-385b-5d48-8c1f-bf5722475091"],
     ". If FilterMaps is ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "87cf2db8-287c-6a49-a292-a34cbda37b49"],
     " it tells which filter to use. can be \"Median\" of \"Gaussian\"."
    }], "TableText",ExpressionUUID->"23bd3ec7-8c14-0641-b480-4a864efa6de8"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "dba61cfd-e4e6-bc4c-97fb-f78d0ccd81aa"], 
    ButtonBox["FilterSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/FilterSize"], "1", Cell[
    TextData[{
     "FilterSize is an option for ",
     Cell[BoxData[
     "IVIMCorrectData"], "InlineFormula",ExpressionUUID->
      "edc3b7cc-7950-6845-83af-e755bcf11d73"],
     ". If FilterMaps is ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "3f301789-1fe5-5c44-9438-0257678c3f64"],
     " it gives the kernel size."
    }], "TableText",ExpressionUUID->"109b4073-9e75-224e-9a67-18b9cf38051c"]}
  }]], "3ColumnTableMod",
