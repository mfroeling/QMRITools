Notebook[{

Cell[CellGroupData[{
Cell["IVIMCorrectData", "ObjectName",
 CellID->32215914,ExpressionUUID->"c53c98a1-bf73-cc41-b4ea-5537b9e747a3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"379a891d-be85-6d44-8f8d-e0722ed0dade"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMCorrectData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMCorrectData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["s", "TI"], 
       StyleBox["0", "TR"]], ",", 
      StyleBox["f", "TI"], ",", 
      StyleBox["pdc", "TI"]}], "}"}], ",", 
    StyleBox["bval", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "41444893-eb70-b946-b148-cfdb5c3df3ce"],
 "\[LineSeparator]removes the ivim signal from the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "15ae0189-46a9-b641-8da7-ebbfd80249be"],
 ". ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "0208fc29-a6d7-4143-b99d-a68aa0f06610"],
 " is the original ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "b022e9ed-21ad-8740-b493-792310b908c6"],
 ". {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "s0"}], "TI"]], "InlineFormula",ExpressionUUID->
  "6f81f6ca-0891-e041-a75e-fd4fc38e4d21"],
 "s0, ",
 Cell[BoxData[
  StyleBox["f", "TI"]], "InlineFormula",ExpressionUUID->
  "ecc73d87-52e8-8b42-8234-da2d1d3f3447"],
 ", ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"pdc", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "27d45ca8-e7fb-0c43-8f15-2fc39f4c17c3"],
 " are the solution to a 2 compartment IVIM fit using ",
 Cell[BoxData[
  ButtonBox["IVIMCalc",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/IVIMCalc"]], "InlineFormula",
  ExpressionUUID->"50c5ee8e-c985-eb44-8164-95a4d7bdf1bb"],
 " or BayesianIVIMFit2. bval are the bvalues. The fraction is defined between \
0 and 1, the pdc is in mm^2/s. output is the corrected data."
}], "Usage",
 CellChangeTimes->{{3.9985332339879513`*^9, 3.99853323428446*^9}},
 CellID->53837501,ExpressionUUID->"6e1ce839-a61d-2947-b11f-427fe799119e"],

Cell["The following options can be given: ", "Notes",
 CellID->52147332,ExpressionUUID->"3a4f1cc3-47c5-484e-abff-0337f1e020fe"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "37d67b19-6e1c-e34a-8b96-527b052b14c3"], 
    ButtonBox["FilterMaps",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/FilterMaps"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "FilterMaps is an option for ",
     Cell[BoxData[
     "IVIMCorrectData"], "InlineFormula",ExpressionUUID->
      "9d19e534-96a2-6746-97f4-9a0d74faf629"],
     ". If ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "8227f1ba-5ebb-4843-b590-de0f233a9b78"],
     " the IVIM parameter maps are filtered before signal correction."
    }], "TableText",ExpressionUUID->"9e796740-0e1f-5347-8963-ccc572b74b8e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6914adf9-b73f-694c-903c-ccb58891f74a"], 
    ButtonBox["FilterType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/FilterType"], "\"\<Median\>\"",
     Cell[TextData[{
     "FilterType is an option for ",
     Cell[BoxData[
     "IVIMCorrectData"], "InlineFormula",ExpressionUUID->
      "240685b0-9a3e-1348-a065-8b70afa20f15"],
     ". If FilterMaps is ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "50da7dd2-d14e-854a-8483-39f6922159f6"],
     " it tells which filter to use. can be \"Median\" of \"Gaussian\"."
    }], "TableText",ExpressionUUID->"18f8f234-9ff4-dd4c-a80f-7731e350aaa3"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "36e2b832-3b1c-a048-b72e-6936d6ab386c"], 
    ButtonBox["FilterSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/FilterSize"], "1", Cell[
    TextData[{
     "FilterSize is an option for ",
     Cell[BoxData[
     "IVIMCorrectData"], "InlineFormula",ExpressionUUID->
      "25519ddf-811a-c842-a47b-eab69670078c"],
     ". If FilterMaps is ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "356a928e-80aa-1845-81a4-71f374eb10cc"],
     " it gives the kernel size."
    }], "TableText",ExpressionUUID->"cd70aabb-b152-344c-af09-6b2d2fc26c29"]}
  }]], "3ColumnTableMod",
 CellID->210644584,ExpressionUUID->"8e218a5f-56c4-3f42-a4f2-074cf6eda9b1"]
