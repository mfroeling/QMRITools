Notebook[{

Cell[CellGroupData[{
Cell["PCADeNoise", "ObjectName",
 CellID->200592016,ExpressionUUID->"17c90b4f-d00f-2c4b-b4bf-5134a403ffcd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"289426bf-59f5-b046-acb2-df10deabea4b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PCADeNoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/PCADeNoise"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a0e82ad4-d0a8-ff49-8175-3aa0dd9621b4"],
 "\[LineSeparator]removes Rician noise from the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "a5004465-0334-354a-a84a-35b45458eba9"],
 " with PCA. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0e182ff3-8d3b-0945-88ba-2a51933b2816"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PCADeNoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/PCADeNoise"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "09c3499e-53c5-a14d-b0a3-3206669c0908"],
 "\[LineSeparator]removes Rician noise from the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "f4770271-c83b-ae44-81b1-2d3beaccf7a7"],
 " with PCA only withing the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "21c970f7-ea0e-a342-9b67-fd093e46cd72"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"881b0ac2-00b2-3f43-87b7-60cb48e1252b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PCADeNoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/PCADeNoise"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["sig", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "221ca079-aa3d-8346-b21d-b7c59250e942"],
 "\[LineSeparator]removes Rician noise from the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "0410497d-9079-6647-80e2-cd667ea97e63"],
 " with PCA only withing the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "b35efe8d-dd9c-ca47-86f7-4bedccd57bfe"],
 " using ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "a31a2cfd-c1b3-f34c-94aa-2248763834cd"],
 " as prior knowledge or fixed value. Output is de {data denoise, sigma map} \
by default if ",
 Cell[BoxData[
  ButtonBox["PCAOutput",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PCAOutput"]], "InlineFormula",
  ExpressionUUID->"e0cc8ac2-d971-234e-b707-2f368ba84d7c"],
 " is Full then fitted {data denoise , {sigma fit, average sigma}, {number \
components, number of fitted voxesl, number of max fits}, total fit -time per \
500 ittt}. If PCARicianCorrect is ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "63952830-e5c6-424a-9ca5-8849e7fc1206"],
 " the denoised ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "a5e50c2b-7a16-244f-aebf-a2d63adedd54"],
 " is corrected for the Rician noise bias using RicianBiasCorrect with the \
fitted sigma map. Kernel voxels that are exactly zero (e.g. outside the image \
or already masked) are not used for the fit. If less than a quarter of the \
kernel contains ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "f6e66f71-0d70-e745-9267-4f817284e3d8"],
 " the voxel is not denoised and its sigma is the given sigma (0 if not \
given). \n",
 Cell["   ", "ModInfo",ExpressionUUID->"856f2269-c010-9248-a16a-6f591e114607"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PCADeNoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/PCADeNoise"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"a42ab923-04f4-a74f-9eca-c26b0d2a660e"],
 "\[LineSeparator]is based on DOI: 10.1016/j.neuroimage.2016.08.016 and \
10.1002/mrm.26059."
}], "Usage",
 CellChangeTimes->{{4.0038045566592274`*^9, 4.0038045571342697`*^9}},
 CellID->440887675,ExpressionUUID->"f8b7f627-226d-1b4e-8e4d-797fba983913"],

Cell["The following options can be given: ", "Notes",
 CellID->80657804,ExpressionUUID->"c252f540-bd2c-a346-b98e-cb7d453f1813"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "17b3ee3c-a45b-9f45-9e7f-8f25d4097b80"], 
    ButtonBox["PCAKernel",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsDenoiseTools/ref/PCAKernel"], "5", Cell[
    TextData[{
     "PCAKernel is an option of ",
     Cell[BoxData[
     "PCADeNoise"], "InlineFormula",ExpressionUUID->
      "615f8405-f1cf-8947-b9cc-fa4b96844210"],
     ". It sets the kernel size."
    }], "TableText",ExpressionUUID->"7d8b49fa-5389-124e-8881-4295cfbbe2cf"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e10c6121-2a23-574e-a3db-0dcd35ebdc44"], 
    ButtonBox["PCAOutput",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PCAOutput"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PCAOutput",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCAOutput"]], "InlineFormula",
      ExpressionUUID->"58805c19-b84e-2547-8595-eb99840a9b65"],
     " is an option of ",
     Cell[BoxData[
     "PCADeNoise"], "InlineFormula",ExpressionUUID->
      "6608439d-e0ca-4347-b45c-c77669009478"],
     ". If output is full the output is {datao, {output[[1]], sigmat}, \
{output[[2]], output[[3]], j}, timetot}.\nElse the output is {datao, sigmat}."
    }], "TableText",ExpressionUUID->"b641da3e-64d1-cd42-a31a-036f2453b0d6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "384738cf-5c82-eb42-b99b-af2a3f344508"], 
    ButtonBox["PCATolerance",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PCATolerance"], "0", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PCATolerance",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCATolerance"]], "InlineFormula",
      ExpressionUUID->"2bd280ea-7b71-2143-b5ea-d279d3754814"],
     " is an option of ",
     Cell[BoxData[
     "PCADeNoise"], "InlineFormula",ExpressionUUID->
      "cc204245-d689-4744-b583-53b42bfe4d1d"],
     " and should be an integer >= 0. ",
     Cell[BoxData[
      ButtonBox["Default",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "324c768e-55de-564e-9dfd-343ebc9bef88"],
     " value is 0, which removes exactly the noise components that are found. \
Each increase of 1 keeps one more component, i.e. the method removes less \
noise."
    }], "TableText",ExpressionUUID->"54e56409-889b-0644-ad95-c6b27c33ea1c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "37efa9de-0d04-8d47-8763-e9c149fcc830"], 
    ButtonBox["PCAWeighting",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PCAWeighting"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PCAWeighting",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCAWeighting"]], "InlineFormula",
      ExpressionUUID->"b9a5d924-d2a8-ab44-a8a2-afb29df74c5b"],
     " is an option of ",
     Cell[BoxData[
     "PCADeNoise"], "InlineFormula",ExpressionUUID->
      "87020ea8-4a6c-0147-93a9-36b5c12543e5"],
     " and can be ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "369ab5a9-c423-1d44-977b-cfdabf39c21b"],
     " of False. ",
     Cell[BoxData[
      ButtonBox["Default",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "460ab9d6-7e57-764e-8b6a-375ab7324874"],
     " value is False. When ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "f33cf2b9-5e86-4549-9424-786826b2e71a"],
     " the weights of the per voxel result are calculated based on the number \
of non noise components. Weighting is not possible with Parallelize ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "0f0abdfa-00a5-eb40-9eee-266cab2d0323"],
     ", which is the default, in that case ",
     Cell[BoxData[
      ButtonBox["PCAWeighting",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCAWeighting"]], "InlineFormula",
      ExpressionUUID->"e4e551d4-e176-ef4b-b20d-a662c8753e61"],
     " is ignored."
    }], "TableText",ExpressionUUID->"b6054183-5257-f64a-9c79-b05942ab5c43"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4a2101a7-9383-de41-8dd0-d032877e3d99"], 
    ButtonBox["PCAClipping",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PCAClipping"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PCAClipping",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCAClipping"]], "InlineFormula",
      ExpressionUUID->"fc91d0f6-4f21-e242-8e52-936adf92bdc0"],
     " is an option of ",
     Cell[BoxData[
     "PCADeNoise"], "InlineFormula",ExpressionUUID->
      "dd9aa2fb-ad4f-8941-81db-7a7d46e56a8b"],
     " and can be ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "a306b70c-0bd4-8445-b8e5-86a9f910e6b6"],
     " of False. If ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "190622b6-eacc-754c-984b-1a61cbacff6a"],
     " the output is clipped between 0.9 times the minimum and 1.1 times the \
maximum absolute value of the input data."
    }], "TableText",ExpressionUUID->"92d75bfa-d896-2c40-8462-3b49fb810a79"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5cb9047e-f3e0-3c46-bb44-0797deb2b6fa"], 
    ButtonBox["PCAComplex",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsDenoiseTools/ref/PCAComplex"], 
