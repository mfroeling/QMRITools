Cell[CellGroupData[{
Cell["DixonPhase", "ObjectName",
 CellID->719225030,ExpressionUUID->"f40706ad-952a-bf4a-996a-1699062709c6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e68cc813-e1fc-6342-ae85-203616f2dac5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonPhase",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonPhase"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echos", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1a43e716-f723-1e4d-9cec-c258045601a5"],
 "\[LineSeparator]calculates the initial field maps for ",
 Cell[BoxData[
  ButtonBox["DixonReconstruct",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/DixonReconstruct"]], "InlineFormula",
  ExpressionUUID->"38205826-8a51-e140-bc90-0f39cf075b1d"],
 ". Echo times echos are in s. Output is {{b0, t2star, phi0, phib}, {e1, e2, \
n}}, with b0 in Hz, t2star in s, the initial phase phi0 and bipolar phase \
phib in cycles, e1 and e2 the echos used for b0 and n the first echo used for \
t2star."
}], "Usage",
 CellChangeTimes->{4.003804506645628*^9},
 CellID->5090456,ExpressionUUID->"46bc0cc8-30b9-1b44-b2b6-cb5b200338a3"],

Cell["The following options can be given: ", "Notes",
 CellID->23801109,ExpressionUUID->"3d7a428a-46cd-0042-b047-a8a5bcbfa62a"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c2005da6-d2c1-0e48-b53f-6b49901a2395"], 
