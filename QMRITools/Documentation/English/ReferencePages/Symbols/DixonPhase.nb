       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "4b84bd4a-cad6-364b-be07-12d696259a04"],
     " the mask is used as weights in ",
     Cell[BoxData[
      ButtonBox["UnwrapDCT",
