Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"917fe2c2-a197-eb47-b3a4-fab9961dd27a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["InvertDataset",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/InvertDataset"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b7d55f68-8999-114e-bca6-c87e68ce7ec8"],
 "\[LineSeparator]inverts the data along the x y and z axes. In other words \
it is rotated around the origin such that (x,y,z)=(-x,-y,-z) and \
(0,0,0)=(0,0,0)."
}], "Usage",
