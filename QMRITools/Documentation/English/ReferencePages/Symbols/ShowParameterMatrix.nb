 Cell[BoxData[
  RowBox[{
   ButtonBox["ShowParameterMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/ShowParameterMatrix"], "[", 
   RowBox[{
    StyleBox["fit", "TI"], ",", 
