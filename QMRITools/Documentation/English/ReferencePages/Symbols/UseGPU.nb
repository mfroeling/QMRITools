Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d8effadd-8632-ba4b-9204-31470574d287"],
 Cell[BoxData[
 "UseGPU"], "InlineFormula",ExpressionUUID->
  "c5249a3e-9f5f-ac4f-ada4-72ac54d762db"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["RegisterData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterData"]], "InlineFormula",
  ExpressionUUID->"fb4d1724-76dd-5d4c-9218-c749d7df9f21"],
 ". The value is {bool, gpu} where bool is ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "80fa318e-7eaa-2949-9787-3a55516ec618"],
 " or False, and gpu is the gpu ID which is an integer or Automatic."
}], "Usage",
