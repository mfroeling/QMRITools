Cell["CalculateGFactor", "ObjectName",
 CellID->191007086,ExpressionUUID->"8aced8ff-065e-a545-982a-77bee381c97b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f809b73a-68ad-7040-89ad-8fd073a26161"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CalculateGFactor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/CalculateGFactor"], "[", 
   RowBox[{
    StyleBox["factors", "TI"], ",", 
    StyleBox["sensitivity", "TI"], ",", 
    StyleBox["wMat", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "55c7e126-5e4d-8644-a21f-6ce60405d95d"],
 "\[LineSeparator]calculates a gFactor for given ",
 Cell[BoxData[
  StyleBox["sensitivity", "TI"]], "InlineFormula",ExpressionUUID->
  "2d9c8115-a28c-5245-afab-0e6de55b3613"],
 " maps and noise corelation w. given the sense ",
 Cell[BoxData[
  StyleBox["factors", "TI"]], "InlineFormula",ExpressionUUID->
  "9c12d64b-cef3-2845-9e9b-3f3f5825df9f"],
 " which is a list of three integers."
}], "Usage",
