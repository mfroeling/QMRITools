Cell[CellGroupData[{
Cell["SumOfSquares", "ObjectName",
 CellID->68620315,ExpressionUUID->"1dba16ad-5d89-f34d-9563-c23fc8770dc7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"00766868-3d38-3f45-aeb6-6440dad765e2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SumOfSquares",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/SumOfSquares"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["2", "TR"]], ",", 
     RowBox[{
      RowBox[{".", " ", 
       StyleBox["\[Ellipsis]", "TR"]}], " ", 
      StyleBox["datan", "TI"]}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"8e63bed1-5b6f-7148-bbbb-0240050d964e"],
 "\[LineSeparator]calculates the sum of squares of the datasets. Output is \
the SoS and the weights, or just the SoS."
}], "Usage",
 CellChangeTimes->{3.9966566012643566`*^9},
 CellID->73371381,ExpressionUUID->"ab4ec8c7-a53c-2f4b-8b9b-c767e3ba2233"],

