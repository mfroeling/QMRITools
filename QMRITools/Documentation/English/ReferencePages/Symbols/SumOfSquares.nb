Cell["SumOfSquares", "ObjectName",
 CellID->91640024,ExpressionUUID->"3c0d4a07-fc48-0c44-b213-cd777a7e427f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"23c0b0d5-5a0b-a34b-bffb-d1237dc7fe11"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SumOfSquares",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/SumOfSquares"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["2", "TR"]], ",", 
     RowBox[{
      RowBox[{".", " ", 
       StyleBox["\[Ellipsis]", "TR"]}], " ", 
      StyleBox["dataN", "TI"]}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"beeed1f4-ba9b-0241-ab7d-70122ce1583d"],
 "\[LineSeparator]calculates the sum of squares of the datasets. Output is \
the SoS and the weights, or just the SoS."
}], "Usage",
 CellChangeTimes->{3.9985332833564796`*^9},
 CellID->247347660,ExpressionUUID->"b9ee50dd-2019-bd45-af1a-1f94aa846e4a"],

