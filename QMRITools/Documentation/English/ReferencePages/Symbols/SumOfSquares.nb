     Cell[BoxData[
     "SumOfSquares"], "InlineFormula",ExpressionUUID->
      "20547eee-de2c-0440-b27d-f00f3b9d64ca"],
     ". If ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
