Cell["SumOfSquares", "ObjectName",
 CellID->182844313,ExpressionUUID->"cbfb74a5-a6cb-a549-b762-76e0027f2910"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7a4140ed-1939-ff42-815e-dbe1ff33b8ce"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SumOfSquares",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/SumOfSquares"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["2", "TR"]], ",", 
     RowBox[{
      RowBox[{".", " ", 
       StyleBox["\[Ellipsis]", "TR"]}], " ", 
      StyleBox["dataN", "TI"]}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"e8144868-beaf-b946-aeff-290719484e1c"],
 "\[LineSeparator]calculates the sum of squares of the datasets. Output is \
the SoS and the weights, or just the SoS."
}], "Usage",
 CellChangeTimes->{4.003804587744768*^9},
 CellID->3037888,ExpressionUUID->"7882f7a7-2001-a04c-9775-73f9ecfa2b7a"],

