Cell["CalculateMoments", "ObjectName",
 CellID->369183314,ExpressionUUID->"21f32014-e295-f347-9e72-4818cac480ce"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0bd17d2c-cdc4-c941-96e0-70f8d08e5da8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CalculateMoments",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/CalculateMoments"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["gt", "TI"], ",", 
      StyleBox["hw", "TI"], ",", 
      StyleBox["te", "TI"]}], "}"}], ",", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "582a0e64-3bb6-f949-912f-efbd7ed4d46c"],
 "\[LineSeparator]calculates the 0th to 3th order moments of the sequence \
created by ",
 Cell[BoxData[
  ButtonBox["GradSeq",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GradSeq"]], "InlineFormula",
  ExpressionUUID->"9e70092a-83a3-a749-9488-82cba1978205"],
 ". Output is {{gt, M0, M1, M2, M3}, vals}."
}], "Usage",
