Notebook[{

Cell[CellGroupData[{
Cell["ListActivations", "ObjectName",
 CellID->290579344,ExpressionUUID->"6330546a-7c1b-b24d-8e7a-dc35f542354a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4da06584-f09d-1f4b-a42c-db7cb55d5a48"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ListActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/ListActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "94592bd5-e7f3-f545-a5ff-dfa626dca940"],
 "\[LineSeparator]lists every activation in the activation map ",
 Cell[BoxData[
  StyleBox["act", "TI"]], "InlineFormula",ExpressionUUID->
  "0fda7e42-2a6b-b04a-98e6-6f83646766c9"],
 ", one association per activation, with the voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "203c25f7-0415-7048-8f97-e23319397a58"],
 " = {z, y, x} in mm. An activation is one connected component within one \
slice of one volume, counted the same way as in AnalyzeActivations. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d1a7ccec-6124-2e43-a46f-c4b39ab27d71"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ListActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/ListActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["seg", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7685883e-69f3-184c-b089-650c4fc43d83"],
 "\[LineSeparator]the same with the label of the label map ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "ba3bece7-b68d-7c41-b2c5-69bd3c742f04"],
 " that covers most of the activation, and the percentage of the voxels \
within ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "a7b6dfae-2965-5540-bcd5-8de057b78d11"],
 " in that slice that are active in that volume. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8d79482f-7a10-6046-b239-ae518862f3dc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ListActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/ListActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["seg", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["norm", "TI"], ",", 
      StyleBox["mn", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5ac7a5ab-6e03-b64d-859b-cf6b76680af0"],
 "\[LineSeparator]the same with the mean of the normalized data norm and of \
the mean mn within the activation, as given by FindActivations with \
ActivationOutput set to ",
 Cell[BoxData[
  ButtonBox["All",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "0022ac13-704f-8949-8da4-56ab9c12c28c"],
 ". ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "1a8604cf-11e4-e940-8850-c9d120f5ceef"],
 " can be None. The keys \"slice\", \"volume\" and \"component\" identify \
each activation. The centroid and bounding box are voxel coordinates {y, x} \
of the array (1-based), a viewer such as ITK-SNAP shows the y axis flipped."
}], "Usage",
 CellChangeTimes->{{4.0046866716646595`*^9, 4.0046866719363766`*^9}},
 CellID->73172535,ExpressionUUID->"f86d904a-48ab-f847-8a30-298c6bfaad6a"],

