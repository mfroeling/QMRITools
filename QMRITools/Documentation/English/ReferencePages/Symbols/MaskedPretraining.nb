Cell["MaskedPretraining", "ObjectName",
 CellID->52868539,ExpressionUUID->"2778483c-99a3-ef49-a378-8cb7e17ab8e0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e95662f3-6c9d-fa46-928f-66b7ae189f5b"],
 Cell[BoxData[
 "MaskedPretraining"], "InlineFormula",ExpressionUUID->
  "9f4cb11d-50d7-1b49-a166-7ceac10f121d"],
 "\[LineSeparator]is an option for GetTrainData and TrainSegmentationNetwork. \
If set to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "ac10798a-6cc0-6f48-9319-fac1eae77f21"],
 " self supervised masked-pretraining data/mode is used instead of \
segmentation data: the target becomes the clean data itself and the input is \
masked with noise filled blocks."
}], "Usage",
 CellChangeTimes->{3.99853067786174*^9},
