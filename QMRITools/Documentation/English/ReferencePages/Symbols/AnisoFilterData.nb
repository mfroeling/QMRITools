Notebook[{

Cell[CellGroupData[{
Cell["AnisoFilterData", "ObjectName",
 CellID->43838300,ExpressionUUID->"e7cdf51e-d774-be42-a60d-c6abe6fdf7a7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"550529fc-c070-1640-b1ca-7c525a8e509c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnisoFilterData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/AnisoFilterData"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "90141eda-9946-8344-b979-f1d054f8b00c"],
 "\[LineSeparator]Filter the diffusion tensor data using an anisotropic \
filter based on the structure tensor of the data. Output is the smoothed \
data. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9e7ad251-6ea9-314f-b1da-2fbbd93e72f9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnisoFilterData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/AnisoFilterData"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "873521ca-6fdc-3e47-9b62-f77262920be0"],
 "\[LineSeparator]is based on DOI: 10.1016/j.jbiomech.2021.110540 and \
10.1016/j.mri.2009.10.001 and 10.1371/journal.pone.0126953."
}], "Usage",
 CellChangeTimes->{{3.9966563148052177`*^9, 3.9966563148803673`*^9}},
 CellID->713915242,ExpressionUUID->"a6c2bb7a-817d-214e-96d7-364e9b925320"],

