Notebook[{

Cell[CellGroupData[{
Cell["MakeGradientDerivatives", "ObjectName",
 CellID->562535755,ExpressionUUID->"26d17362-d1c9-1e41-b2f2-ae10269dd8cc"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aec215df-ed6c-524f-90d1-1ad6a5a23548"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeGradientDerivatives",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/MakeGradientDerivatives"], 
   "[", 
   RowBox[{
    StyleBox["vox", "TI"], ",", 
    StyleBox["type", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fed1cbcc-971f-eb43-ac51-849a718c4c6a"],
 "\[LineSeparator]generates two interpolation functions using the resolution \
defined by ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "b9cdbf75-1e35-b64c-8758-99f22b1b865d"],
 ". One of the gradient field and one of the dx dy and dz of each of the \
gradient componets. The ",
 Cell[BoxData[
  StyleBox["type", "TI"]], "InlineFormula",ExpressionUUID->
  "0c45f94c-00c5-0c43-a856-c829eb9c414c"],
 " is the gradient of the system which now can be \"WA1\" or \"WA2\"."
}], "Usage",
 CellChangeTimes->{{3.996655582832327*^9, 3.996655582898031*^9}},
 CellID->8843669,ExpressionUUID->"9c9f7c3b-60af-2e4d-a7e8-3a7950d7844c"],

