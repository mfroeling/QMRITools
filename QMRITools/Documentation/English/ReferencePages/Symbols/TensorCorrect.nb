Cell[CellGroupData[{
Cell["TensorCorrect", "ObjectName",
 CellID->29752317,ExpressionUUID->"6e57158c-a936-e349-a090-915584359927"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"05d3fa8d-7c61-fd48-b6a5-2b29b78b701a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorCorrect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/TensorCorrect"], "[", 
   RowBox[{
    StyleBox["tensor", "TI"], ",", 
    StyleBox["phase", "TI"], ",", 
    StyleBox["shift", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4a77af64-0b3a-c649-ac29-99f322a51c53"],
 "\[LineSeparator]corrects the ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "ad1021a4-47eb-8348-b9ff-f7d7d0e45e7b"],
 " based on B0 field map. Can perform both translation and rotation of ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "cf116a31-0cde-d741-95d5-8a7ed78a3f6a"],
 "."
}], "Usage",
 CellChangeTimes->{{3.996656371673609*^9, 3.996656371739292*^9}},
 CellID->144853653,ExpressionUUID->"4ec306c2-1d5f-324a-8bde-e53a4d12fa2f"],

Cell["The following options can be given: ", "Notes",
 CellID->268074400,ExpressionUUID->"1bdd3294-4405-954e-a4c2-fea7e5de48a9"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2abe2994-9f5c-9243-97a9-9ad208fa8ecf"], 
    ButtonBox["RotationCorrect",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/RotationCorrect"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["RotationCorrect",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RotationCorrect"]], "InlineFormula",
      ExpressionUUID->"03cf71ba-9b1a-8045-8167-9f00c49f645c"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["Tensor",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Tensor"]], "InlineFormula",
      ExpressionUUID->"569b6e10-9e13-4b48-824c-c6dc66786889"],
     Cell[BoxData[
      ButtonBox["Correct",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Correct"]], "InlineFormula",
      ExpressionUUID->"06df31e8-9605-094a-95c3-a6456143fa54"],
     ". Default is False. Is a tensor is deformed setting to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "ce92bd5d-fea5-ae41-ab5f-ad3c41083e5b"],
     " also the shear is accounted for by local rotation of the tensor."
    }], "TableText",ExpressionUUID->"b1bbed88-0f93-624e-8268-60bd9e8ea22c"]}
  }]], "3ColumnTableMod",
 CellID->15576437,ExpressionUUID->"81f98656-836a-6142-b7a1-151d1154b3d8"]
