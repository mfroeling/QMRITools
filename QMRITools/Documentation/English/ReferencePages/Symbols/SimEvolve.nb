Notebook[{

Cell[CellGroupData[{
Cell["SimEvolve", "ObjectName",
 CellID->205920740,ExpressionUUID->"8d0ba472-2092-2a4f-958e-1a3cdf1136c1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8a36c1ac-85ff-0847-8725-6ad2b225a451"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimEvolve",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SimEvolve"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"], ",", 
    StyleBox["t", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0900a0f0-7a4a-504f-8961-0c55d64d85cf"],
 "\[LineSeparator]evolves the spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "2a1a088f-d969-624c-9143-cc36f09d4894"],
 " given the hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "f554f5f4-8430-c441-9b64-e5aa0bfc8917"],
 " over a time ",
 Cell[BoxData[
  StyleBox["t", "TI"]], "InlineFormula",ExpressionUUID->
  "52fc567f-b8ae-1543-b6bb-0b5ee69ec943"],
 ". ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "aedbadec-427e-3d4d-8292-bd076e856ddb"],
 " and ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "c39b290a-aadc-1841-babd-b3575f7d2318"],
 " are generated by ",
 Cell[BoxData[
  ButtonBox["SimHamiltonian",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SimHamiltonian"]], "InlineFormula",
  ExpressionUUID->"67bae42f-1192-d441-ab7a-5a44432303cc"],
 ". The output is a new spin system dOut."
}], "Usage",
 CellChangeTimes->{{3.996656775510872*^9, 3.9966567756145477`*^9}},
 CellID->58442983,ExpressionUUID->"0a6994e4-1dcc-e643-8946-65203381a7f2"],

Cell["XXXX", "Notes",
 CellID->642510080,ExpressionUUID->"4662be75-d2af-3e43-beae-206a374931a3"]
}, Open  ]],

