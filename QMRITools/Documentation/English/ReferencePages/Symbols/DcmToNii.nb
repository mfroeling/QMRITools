Notebook[{

Cell[CellGroupData[{
Cell["DcmToNii", "ObjectName",
 CellID->29890491,ExpressionUUID->"fa71f8d2-c602-224b-a9dd-07208a7401bf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"101ead7c-b9a8-0a4c-bf16-7169fadba289"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DcmToNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/DcmToNii"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"04047a59-364f-0740-ada7-5d3af9b4c02f"],
 "\[LineSeparator]converts a dicom folder to nii,you will be prompted for the \
location of the folders. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6e759f05-09a7-0249-8596-274968bab346"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DcmToNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/DcmToNii"], "[", 
   RowBox[{"{", 
    RowBox[{"\"\<\!\(\*StyleBox[\"input\", \"TI\"]\)\>\"", 
     ",", "\"\<\!\(\*StyleBox[\"output\", \"TI\"]\)\>\""}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"8ec97ffd-7fba-8c40-a63c-181089d5b791"],
 "\[LineSeparator]converts the \"input\" dicom folder to nii files which are \
place in the \"output\" folder. For this function to work the dcm2niix.exe \
file should be present in the QMRITools application folder."
}], "Usage",
 CellChangeTimes->{{3.9966568430209064`*^9, 3.996656843085287*^9}},
 CellID->85308912,ExpressionUUID->"8f1c3c4e-dbc2-7b40-a04d-527c57709aea"],

