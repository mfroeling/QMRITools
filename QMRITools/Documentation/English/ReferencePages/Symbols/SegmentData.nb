Notebook[{

Cell[CellGroupData[{
Cell["SegmentData", "ObjectName",
 CellID->426160189,ExpressionUUID->"5d1cb259-eb57-1d49-bd19-f413218ffe52"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2d0f3fa7-1b6c-5844-9456-05a01ee166a9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c799c403-fdd4-ce4f-9b24-a7a8c58e5a6d"],
 "\[LineSeparator]segments the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "3c3e1313-7999-6142-98f6-4f5502fde8b1"],
 " using the default \"Body\" method. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1304236e-96f1-3c46-968c-a5cb64d1de23"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f99f5dd0-3bde-0245-8715-cefc7abfc7f5"],
 "\[LineSeparator]segments using the specified anatomical region. With full \
body output labels ",
 Cell[BoxData[
  StyleBox["what", "TI"]], "InlineFormula",ExpressionUUID->
  "591299ad-13c3-9f49-aeb8-5e0131da6e37"],
 " can be \"Body\", \"LegsBody\", \"LegsHipBody\", \"HipBody\", \
\"UpperLegsBody\", \"LowerLegsBody\", or \"ShoulderBody\". With legacy output \
labels ",
 Cell[BoxData[
  StyleBox["what", "TI"]], "InlineFormula",ExpressionUUID->
  "eca6a3a0-2b57-0f43-9124-5576c304100c"],
 " can be \"Legs\", \"LegsHip\", \"UpperLegs\", \"LowerLegs\", \"Hip\", \
\"Shoulder\", or \"Arm\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"24608a80-4058-b243-be8c-7a7e5c288c1f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["data", "TI"], ",", 
     StyleBox["vox", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "faaf9cfd-11bf-3046-a8c3-694efb631303"],
 "\[LineSeparator]and \n",
 Cell["   ", "ModInfo",ExpressionUUID->"faced99f-48f5-3f4b-a5f6-791fb8a5390e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["vox", "TI"]}], "}"}], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4b07ad91-f3db-804a-af45-48fc2c846288"],
 "\[LineSeparator]additionally give the voxel size of ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "85af3313-b11c-3947-85a7-b2081069b4f7"],
 ". Unless vox is {1, 1, 1}, ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "5a0a08ce-f41b-f941-a5ac-4cf6469f481f"],
 " is rescaled before segmentation to {vox[[1]], 1.5, 1.5} for ",
 Cell[BoxData[
  RowBox[{"SegmentationDimension", "->", "\"\<2D\>\""}]], "InlineFormula",
  ExpressionUUID->"b68ca8f4-e75e-7e49-b130-220dd3e8ea58"],
 " or to {6, 1.5, 1.5} for \"3D\". If ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["NetworkOutput",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRITools/ref/NetworkOutput"], 
   "->", "\"\<Both\>\""}]], "InlineFormula",ExpressionUUID->
  "9ca0dd4e-a30a-f24a-9cff-24f0a9aa9af6"],
 " returns {segmentation, confidence}, any other value always returns just \
the segmentation."
}], "Usage",
 CellChangeTimes->{{4.0038045724049416`*^9, 4.003804572678442*^9}},
 CellID->95470353,ExpressionUUID->"3a1e067e-4187-ad4c-93fe-225368baecb4"],

Cell["The following options can be given: ", "Notes",
 CellID->597579297,ExpressionUUID->"4de84f32-7893-cb41-ae2a-0de044f16abc"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "fd15e8a9-35d1-0d47-9144-8ce48575708d"], 
    ButtonBox["TargetDevice",
     BaseStyle->"Link"], "\"\<CPU\>\"", Cell[
    "XXXX", "TableText",ExpressionUUID->
     "1744514c-9cf1-894d-8165-ef9ef0567e36"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4392699c-1bad-c540-931f-4df4501952b9"], 
    ButtonBox["MaxMemorySize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MaxMemorySize"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     "MaxMemorySize is an option for ",
     Cell[BoxData[
     "SegmentData"], "InlineFormula",ExpressionUUID->
      "181cde8f-cf68-af43-b4c0-88ad23d5335d"],
     " and ApplySegmentationNetwork. Defines the maximum memory a patch can \
use in Gb. Higher is better."
    }], "TableText",ExpressionUUID->"39dcde24-3308-b94c-9e20-e73420e2cf87"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "63b0e0ab-f162-c549-bed3-c57e76326464"], 
    ButtonBox["SegmentationDimension",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsSegmentationTools/ref/SegmentationDimension"], "\"\<3D\
\>\"", Cell[TextData[{
     "SegmentationDimension is an option for ",
     Cell[BoxData[
     "SegmentData"], "InlineFormula",ExpressionUUID->
      "4de93ecf-41ca-7d4f-b0ce-40701de74cbf"],
     ". The default value is \"3D\" but can also be set to \"2D\" to used 2D \
slice by slice segmentation."
    }], "TableText",ExpressionUUID->"2e7a79ad-cf1a-1a42-a943-b574b2141286"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "76b41437-e6c7-f84d-b864-cae10c5a47d1"], 
    ButtonBox["NetworkOutput",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NetworkOutput"], "\"\<Segmentation\>\"",
     Cell[TextData[{
     Cell[BoxData[
      ButtonBox["NetworkOutput",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NetworkOutput"]], "InlineFormula",
      ExpressionUUID->"95285a0e-028a-7740-bd20-5a931fd97e10"],
     " is an option for ApplySegmentationNetwork. Can be \"Segmentation\" \
(default) to return the segmentation, \"Confidence\" to return the\nper-voxel \
class confidence (see ClassConfidence), \"Both\" to return {segmentation, \
confidence}, or \"Volume\" for a network that outputs a\nreconstructed volume \
rather than class probabilities (e.g. a self-supervised pretrained network), \
which merges patches without ClassDecoder."
    }], "TableText",ExpressionUUID->"05b3eacb-14c6-bd4f-be0a-ce82fe6c518c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "05ae7079-5e08-a64e-bfc1-8f6845145b6d"], 
    ButtonBox["Monitor",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Monitor", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["mon", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
      "2f49b297-a7b9-ab41-9342-dffffc324082"],
     " generates a temporary monitor cell in which the continually updated \
current value of ",
     Cell[BoxData[
      StyleBox["mon", "TI"]], "InlineFormula",ExpressionUUID->
      "c4641757-e439-3f40-8d05-859d8e70b299"],
     " is displayed during the course of evaluation of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "1e73d11a-fb37-b34c-97a0-e8c83425ed5c"],
     ". "
    }], "TableText",ExpressionUUID->"c1ca0620-e9f7-3147-a204-e1eabb033c93"]}
  }]], "3ColumnTableMod",
 CellID->510650636,ExpressionUUID->"51d8ece9-e851-7b4f-9962-c0472e3215ed"]
}, Open  ]],

