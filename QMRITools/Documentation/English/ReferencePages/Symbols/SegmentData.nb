Notebook[{

Cell[CellGroupData[{
Cell["SegmentData", "ObjectName",
 CellID->26610808,ExpressionUUID->"35b4dc1d-26b6-d548-aff4-c28ee7599c77"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"13269db3-3956-8f4c-8509-f50c46f8790a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "67fd4503-9717-fe4b-a699-e454bab5d5ec"],
 "\[LineSeparator]segments the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "d8b9c69d-e2f0-db4f-bba8-2d8150f98865"],
 " using the default \"Legs\" method. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"aa245d08-7d3c-d942-b53f-c02e52af2a5a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0deca8f0-391f-e74b-9f3a-6b7f0b665d85"],
 "\[LineSeparator]segments using the specified anatomical region. What can be \
\"Legs\", \"LegsHip\", \"UpperLegs\", \"LowerLegs\", \"Shoulder\", \"Hip\", \
or \"Body\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"607e9897-ac14-7f48-abb2-b315473888cc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["what", "TI"], ",", 
      StyleBox["netFile", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"ae860474-e403-f448-a5ba-ccb27a9edc79"],
 "\[LineSeparator]uses a custom network file instead of the built-in net. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3785d8c5-a4ec-a443-a165-44cd5510638d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["data", "TI"], ",", 
     StyleBox["vox", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "d0e971c2-7b4e-ef4f-8177-d3035edab1d0"],
 "\[LineSeparator]and \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9365274c-668f-4f48-8d93-69198e694468"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["vox", "TI"]}], "}"}], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3410b6b2-bff5-0d4d-89f3-adb407f4d503"],
 "\[LineSeparator]additionally give the voxel size of ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "c736a767-aa7c-9f4f-b99e-53fe526b2546"],
 ". Unless vox is {1, 1, 1}, ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "17577b3a-e94f-1647-9f96-680a64b85a9b"],
 " is rescaled before segmentation to {vox[[1]], 1.5, 1.5} for ",
 Cell[BoxData[
  RowBox[{"SegmentationDimension", "->", "\"\<2D\>\""}]], "InlineFormula",
  ExpressionUUID->"e8031744-07ef-1e49-91ce-232b5e400e5c"],
 " or to {6, 1.5, 1.5} for \"3D\". If ",
 Cell[BoxData[
  RowBox[{"NetworkOutput", "->", "\"\<Both\>\""}]], "InlineFormula",
  ExpressionUUID->"a6bc42cc-04d7-ba45-899d-12553ddc7ce6"],
 " returns {segmentation, confidence}, any other value always returns just \
the segmentation."
}], "Usage",
 CellChangeTimes->{{3.9985332702371464`*^9, 3.9985332708311596`*^9}},
 CellID->698320092,ExpressionUUID->"206a12d8-67cb-cd46-a835-3c4972f38297"],

Cell["The following options can be given: ", "Notes",
 CellID->172613387,ExpressionUUID->"ca8e2685-ee55-3e40-809d-cde1d81bc6ed"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "de5d0dff-faff-ac4a-852c-c79e7a8060de"], 
    ButtonBox["TargetDevice",
     BaseStyle->"Link"], "\"\<CPU\>\"", Cell[
    "XXXX", "TableText",ExpressionUUID->
     "f36321b3-6946-084c-9630-5f96b23019c6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e64843e5-7f22-db48-a913-06829595cba7"], 
    ButtonBox["MaxMemorySize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MaxMemorySize"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     "MaxMemorySize is an option for ",
     Cell[BoxData[
     "SegmentData"], "InlineFormula",ExpressionUUID->
      "75633835-5ae6-b542-8d38-f3c4df8e5fef"],
     " and ApplySegmentationNetwork. Defines the maximum memory a patch can \
use in Gb. Higher is better."
    }], "TableText",ExpressionUUID->"205c1a8d-13a7-244a-a833-a445ddeb7895"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bc74c37b-0035-4943-b6bf-55a68b2a4990"], 
    ButtonBox["SegmentationDimension",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsSegmentationTools/ref/SegmentationDimension"], "\"\<3D\
\>\"", Cell[TextData[{
     "SegmentationDimension is an option for ",
     Cell[BoxData[
     "SegmentData"], "InlineFormula",ExpressionUUID->
      "4ecb7fa2-7d69-724a-80f1-250db72b5b6b"],
     ". The default value is \"3D\" but can also be set to \"2D\" to used 2D \
slice by slice segmentation."
    }], "TableText",ExpressionUUID->"677a9641-b059-4f44-890d-afea2afc3138"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b6c0e8a6-effc-8d41-8417-a05c8d9c7ebd"], 
    ButtonBox["NetworkOutput",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsSegmentationTools/ref/NetworkOutput"], \
"\"\<Segmentation\>\"", Cell["\<\
NetworkOutput is an option for ApplySegmentationNetwork. Can be \
\"Segmentation\" (default) to return the segmentation, \"Confidence\" to \
return the
per-voxel class confidence (see ClassConfidence), or \"Both\" to return \
{segmentation, confidence}.\
\>", "TableText",ExpressionUUID->"ef300811-1333-df4d-9fe0-2d2549746eec"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "289f413b-856d-7642-8124-eaef91d20fa2"], 
    ButtonBox["Monitor",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Monitor", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["mon", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
      "097c4c4f-a581-ce43-a728-0aaa8994e7a8"],
     " generates a temporary monitor cell in which the continually updated \
current value of ",
     Cell[BoxData[
      StyleBox["mon", "TI"]], "InlineFormula",ExpressionUUID->
      "290acbc7-5119-bd4a-b2d8-f1e0de7194f2"],
     " is displayed during the course of evaluation of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "007b6bb3-2705-2e40-9ec0-443d141eb209"],
     ". "
    }], "TableText",ExpressionUUID->"0aaefb59-88db-f04a-a73b-783ec32a898e"]}
  }]], "3ColumnTableMod",
 CellID->423153246,ExpressionUUID->"e2a29d6f-329d-6546-8323-9a83782138f7"]
}, Open  ]],

