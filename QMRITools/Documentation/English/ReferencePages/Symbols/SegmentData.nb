Cell["SegmentData", "ObjectName",
 CellID->705076308,ExpressionUUID->"8667fcd7-2979-4b4b-947b-6f4ad4d4828c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"335f7371-f750-d64c-b9ee-e5277e99dc3b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "60487b6d-e898-ce42-a088-aa2ea2dfeca5"],
 "\[LineSeparator]segments the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "1d8100c0-e30d-0f4d-935d-512873d85a7b"],
 " using the default \"Legs\" method. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8f66fbe0-93c4-974a-9d2a-1d7babe9c2a4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "60643fd0-a347-3245-9b52-74f9407eb20b"],
 "\[LineSeparator]segments using the specified anatomical region. What can be \
\"Legs\", \"LegsHip\", \"UpperLegs\", \"LowerLegs\", \"Shoulder\", \"Hip\", \
or \"Body\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a8f7271a-5835-c743-94a5-624b2a910a4c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SegmentData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["what", "TI"], ",", 
      StyleBox["netFile", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"7f944956-13c2-1f47-b125-963a769f7629"],
 "\[LineSeparator]uses a custom network file instead of the built-in net."
}], "Usage",
 CellChangeTimes->{{3.996656666481119*^9, 3.9966566666810417`*^9}},
 CellID->495486907,ExpressionUUID->"a5ee3701-9c0b-ef47-9497-015380a5790e"],

