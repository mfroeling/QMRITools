Notebook[{

Cell[CellGroupData[{
Cell["AddNoise", "ObjectName",
 CellID->647599051,ExpressionUUID->"09495e68-6ddb-0248-b86f-dc07a87f768b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"79d825ad-dfd1-aa46-90b0-d493ce988dfe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AddNoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/AddNoise"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["noise", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e2566557-064c-1647-8aee-44c67d5a3130"],
 "\[LineSeparator]ads rician ",
 Cell[BoxData[
  StyleBox["noise", "TI"]], "InlineFormula",ExpressionUUID->
  "be57f413-052e-be4a-9525-6191a6853c86"],
 " to the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "23e3aa82-8309-df42-90af-2de5262abb1b"],
 " with a given sigma or SNR value."
}], "Usage",
 CellChangeTimes->{{3.99665684937105*^9, 3.996656849435692*^9}},
 CellID->449742590,ExpressionUUID->"d4988f40-943f-b944-9d19-b3c3d6b13637"],

Cell["The following options can be given: ", "Notes",
 CellID->792595985,ExpressionUUID->"cf719348-1c48-a54b-83d1-dd0a4204fc8c"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "54103917-eb2f-c54d-8be1-6947ecff2d04"], 
    ButtonBox["NoiseSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NoiseSize"], "\"\<Sigma\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["NoiseSize",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NoiseSize"]], "InlineFormula",
      ExpressionUUID->"a8e45090-c472-0b4c-885d-07370bc3222d"],
     " is an option for ",
     Cell[BoxData[
     "AddNoise"], "InlineFormula",ExpressionUUID->
      "541f40b1-7d37-dc47-b513-8f9723b3f984"],
     ". Values can be \"Sigma\", then the noise sigma is given or \"SNR\", \
then the SNR is given."
    }], "TableText",ExpressionUUID->"a03e3920-aad8-d540-91d2-87e5b0feb7e5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "adf270b9-53bb-3d4a-9cd5-293e5e11996d"], 
    ButtonBox["NoiseType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NoiseType"], "\"\<Absolute\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["NoiseType",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NoiseType"]], "InlineFormula",
      ExpressionUUID->"20e68477-6daa-3e49-9e61-6664ad158081"],
     " is an option for ",
     Cell[BoxData[
     "AddNoise"], "InlineFormula",ExpressionUUID->
      "36dd33e2-a49a-614a-b2b8-c65f570b825e"],
     ". Values can be \"Absolute\" or \"Complex\", and will add either Rician \
absolute noise or complex noise to the data."
    }], "TableText",ExpressionUUID->"0c043459-a7dc-e241-abc6-6c4810641818"]}
  }]], "3ColumnTableMod",
 CellID->153072273,ExpressionUUID->"68400b0c-a693-6d4e-a943-2c8b7d08ceab"]
}, Open  ]],

