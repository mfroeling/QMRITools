Cell[CellGroupData[{
Cell["TransmuralPlot", "ObjectName",
 CellID->83294029,ExpressionUUID->"2c4f701e-3bc3-4b4e-ac58-458649a20404"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2188b8f8-ba00-f349-887d-47c69b72e2c9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TransmuralPlot",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/TransmuralPlot"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "db06efaa-8923-ff4d-b76f-2e352558358e"],
 "\[LineSeparator]plots transmural profiles of the data which are created by ",
 Cell[BoxData[
  ButtonBox["RadialSample",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RadialSample"]], "InlineFormula",
  ExpressionUUID->"637f7f69-d4e2-6849-b7f1-013354df5783"],
 ". data can be a single profile or a list of profiles. In the second case \
the mean and standard deviations are plotted. Output is a plot of the \
transmural profile."
}], "Usage",
 CellChangeTimes->{3.9966563169465847`*^9},
 CellID->84244476,ExpressionUUID->"7ef8140d-c2fd-be40-9c39-9b5b6ee268ad"],

