Notebook[{

Cell[CellGroupData[{
Cell["AmaresSignalCalc", "ObjectName",
 CellID->213724656,ExpressionUUID->"d216043d-7e94-c047-8e94-349a4ed298f6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"62468b1a-1216-4e47-8ae3-939876c93e06"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresSignalCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresSignalCalc"], "[", 
   RowBox[{
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["pars", "TI"], ",", 
    StyleBox["gyro", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "abd3cce5-52ae-bb40-ab90-e115dcc8d408"],
 "\[LineSeparator]generates a fid from the ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "e463a64b-e8a3-824b-bfcb-62849af3cefc"],
 " functions according to ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "e47009f7-7b2f-9740-8f7d-a158a39806f3"],
 " and ",
 Cell[BoxData[
  StyleBox["pars", "TI"]], "InlineFormula",ExpressionUUID->
  "86bfeb94-be4d-7348-874b-1e0cd24751fc"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"932332eb-1964-a749-aa8b-090d51d22c3e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresSignalCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresSignalCalc"], "[", 
   RowBox[{
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["pars", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox[
      RowBox[{"1", "Pars"}], "TI"]], ",", 
    StyleBox["gyro", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1625ed51-df7d-e74b-9e8a-34535007af6b"],
 "\[LineSeparator]also generates a fid but also using the B1 effect if set ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "6196e2a0-00c4-fb4b-8788-75ce3462f309"],
 " in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "350d023a-c97d-1f45-8f8c-ce8bed14f519"],
 ". The values of ",
 Cell[BoxData[
  StyleBox["b1Pars", "TI"]], "InlineFormula",ExpressionUUID->
  "7e2f1a78-fb4f-9b4c-bf50-2f1849912b88"],
 " are {tau, fa, TR} with tau and TR in ms and fa in degrees."
}], "Usage",
 CellChangeTimes->{{3.995101409490114*^9, 3.9951014096931973`*^9}},
 CellID->262150982,ExpressionUUID->"d8080e21-1a45-7243-8724-9565b9bae6af"],

