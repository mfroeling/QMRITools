Notebook[{

Cell[CellGroupData[{
Cell["AmaresSignalCalc", "ObjectName",
 CellID->190895137,ExpressionUUID->"8a60fc1d-89f0-9744-8168-1c40820113f9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"af85808b-789b-2e44-bee8-b313819ff3c6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresSignalCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresSignalCalc"], "[", 
   RowBox[{
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["pars", "TI"], ",", 
    StyleBox["gyro", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "01bbdea3-0fb4-8540-a55a-bf89dc4abe7f"],
 "\[LineSeparator]generates a fid from the ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "c8276cd8-e973-af48-90f2-133fa9cca9d0"],
 " functions according to ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "599cf3c5-885b-0b46-bd8d-443c2ad744e6"],
 " and ",
 Cell[BoxData[
  StyleBox["pars", "TI"]], "InlineFormula",ExpressionUUID->
  "42f13a0b-f48f-894d-a9e2-8fe00728c547"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"cd873e46-cce2-e64a-942b-d158042db6f4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresSignalCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresSignalCalc"], "[", 
   RowBox[{
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["pars", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox[
      RowBox[{"1", "Pars"}], "TI"]], ",", 
    StyleBox["gyro", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c8d75a7a-4138-3445-a84c-3d0edc44ce70"],
 "\[LineSeparator]also generates a fid but also using the B1 effect if set ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "8d58845f-7d72-7d42-b43c-c15612d6d233"],
 " in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "39e54d0e-d191-184f-b4c4-641acbf02048"],
 ". The values of ",
 Cell[BoxData[
  StyleBox["b1Pars", "TI"]], "InlineFormula",ExpressionUUID->
  "4abea32a-9994-8a41-8cf0-d72ca4f11bb5"],
 " are {tau, fa, TR} with tau and TR in ms and fa in degrees."
}], "Usage",
 CellChangeTimes->{{3.9966562713013134`*^9, 3.99665627151947*^9}},
 CellID->236214865,ExpressionUUID->"d5d9cea7-8e99-3c40-8afb-61d7c825f70f"],

