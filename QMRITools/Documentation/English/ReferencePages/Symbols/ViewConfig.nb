Cell["ViewConfig", "ObjectName",
 CellID->62822840,ExpressionUUID->"61ae429c-2449-2f48-8063-41df84d270f7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6ff16761-a0fc-fb47-9fb9-3a1a1c6fe0e8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ViewConfig",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ViewConfig"], "[", 
   StyleBox["config", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "127b6dbc-e843-0d4a-b59c-4f595bdcf6d4"],
 "\[LineSeparator]shows a config file for Muscle Bids processing. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c22b7570-ea97-be40-8fab-32113060c42e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ViewConfig",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ViewConfig"], "[", 
   StyleBox["folder", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "89932718-7d9c-0544-8674-359922c2a035"],
 "\[LineSeparator]same but imports the config file from the given folder. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"22acc1e3-4e46-4f41-a84c-dedaa34ce510"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ViewConfig",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ViewConfig"], 
   "[", "\"\<\!\(\*StyleBox[\"default\", \"TI\"]\)\>\"", "]"}]], 
  "InlineFormula",ExpressionUUID->"889ea6b0-391a-8848-9076-a82398a2b162"],
 "\[LineSeparator]shows the default config."
}], "Usage",
