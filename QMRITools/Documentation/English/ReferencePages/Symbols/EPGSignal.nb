Notebook[{

Cell[CellGroupData[{
Cell["EPGSignal", "ObjectName",
 CellID->147473256,ExpressionUUID->"afecaa6d-515c-d843-be1a-b1b09f9585db"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f54eacd4-4977-934d-80cd-f9f6ffa73ece"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EPGSignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/EPGSignal"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["nEcho", "TI"], ",", 
      StyleBox["echoSpace", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ex_angle", "TI"], ",", 
      StyleBox["ref_angle", "TI"]}], "}"}], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["1", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "220e1c9d-21d4-9943-b1f8-3f3d540f00a1"],
 "\[LineSeparator]generates a EPG t2 curve with stimulated echos. t1, t2 and \
echoSpace are in ms, angel is in degree, ",
 Cell[BoxData[
  StyleBox["b1", "TI"]], "InlineFormula",ExpressionUUID->
  "f35c1485-09fe-b44e-a83e-2cbbe0dda112"],
 " is between 0 and 1. Output is the EPG ",
 Cell[BoxData[
  ButtonBox["Signal",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/Signal"]], "InlineFormula",
  ExpressionUUID->"99b11bad-8ce0-4a4d-90f2-35568d6ea3a3"],
 " vector. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ae9611c0-e299-8940-b283-b3d8347fa35b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EPGSignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/EPGSignal"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "db65628f-9d29-f24e-8437-059eac974947"],
 "\[LineSeparator]is based on DOI: 10.1002/jmri.24619."
}], "Usage",
 CellChangeTimes->{{3.9966568104481316`*^9, 3.996656810581423*^9}},
 CellID->118127446,ExpressionUUID->"36b0d097-8b8d-e84a-ad9a-2c5bd9da69a3"],

Cell["The following options can be given: ", "Notes",
 CellID->107904845,ExpressionUUID->"fc71be57-d4dc-4148-9956-22e6665fdd65"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "91f481c6-890d-c147-a3d6-c58b124dac98"], 
    ButtonBox["EPGOutput",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/EPGOutput"], "\"\<Magnitude\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["EPGOutput",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGOutput"]], "InlineFormula",
      ExpressionUUID->"d81a39f8-44a7-6b4c-bfc4-beea6a5a9f91"],
     " is an option for ",
     Cell[BoxData[
     "EPGSignal"], "InlineFormula",ExpressionUUID->
      "5e74e31b-1fef-2b41-a0af-3c7622cddb16"],
     ". It specifies how to format the output, as magnitude or complex."
    }], "TableText",ExpressionUUID->"ccc21857-82d3-424b-b594-437cebdd0aac"]}
  }]], "3ColumnTableMod",
 CellID->35271391,ExpressionUUID->"1843fa22-d345-9b44-9bb0-db40dfcf55c3"]
