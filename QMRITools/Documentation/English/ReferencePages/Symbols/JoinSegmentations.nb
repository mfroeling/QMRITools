Notebook[{

Cell[CellGroupData[{
Cell["JoinSegmentations", "ObjectName",
 CellID->58811099,ExpressionUUID->"885f6f73-38f2-5f43-bef9-c42044f9eed5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"552d8e34-169c-1843-a37c-746a6900c7b6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["JoinSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/JoinSegmentations"], "[", 
   RowBox[{
    StyleBox["seg", "TI"], ",", 
    StyleBox["joinRules", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e141e820-e27a-0543-af9f-fb2dd0e6b1bb"],
 "\[LineSeparator]joins the segmentations in ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "aae997a3-17d4-b14c-8d64-48c4f8f5ef55"],
 " according to the rules in ",
 Cell[BoxData[
  StyleBox["joinRules", "TI"]], "InlineFormula",ExpressionUUID->
  "ef1f8bd3-476a-394e-ad69-ddaa986ab31a"],
 ". JoinRules is a list of rules {{join, new}..} where join is a list of \
labels to be joined and new is the new label number. For example {{1, 2}, 3} \
joins the labels 1 and 2 to label 3. A single rule {join, new} can also be \
given."
}], "Usage",
 CellChangeTimes->{{4.003804539462906*^9, 4.003804539530508*^9}},
 CellID->602567768,ExpressionUUID->"920f4bb6-3f3c-c942-9b43-c1c6061c4201"],

