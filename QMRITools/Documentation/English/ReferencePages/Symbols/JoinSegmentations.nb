Notebook[{

Cell[CellGroupData[{
Cell["JoinSegmentations", "ObjectName",
 CellID->182091647,ExpressionUUID->"5d759aa9-db5e-9c43-8e93-560f62f8eddc"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"040fd5ac-9f29-aa44-8ec3-81b9d4b59aa1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["JoinSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/JoinSegmentations"], "[", 
   RowBox[{
    StyleBox["seg", "TI"], ",", 
    StyleBox["joinRules", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "546a7427-4be5-7641-ab6e-16ddf257da67"],
 "\[LineSeparator]joins the segmentations in ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "3efbfc7b-8c4c-5b49-bba4-bd2f79cf098b"],
 " according to the rules in ",
 Cell[BoxData[
  StyleBox["joinRules", "TI"]], "InlineFormula",ExpressionUUID->
  "ef3358b6-de6a-5a4b-8435-3e1626eeaf53"],
 ". JoinRules is a list of rules {{join, new}..} where join is a list of \
labels to be joined and new is the new label number. For example {{1, 2}, 3} \
joins the labels 1 and 2 to label 3."
}], "Usage",
 CellChangeTimes->{{3.9966556911077423`*^9, 3.9966556911677113`*^9}},
 CellID->82093146,ExpressionUUID->"2aa37292-8b90-284d-ada0-f583c5579604"],

