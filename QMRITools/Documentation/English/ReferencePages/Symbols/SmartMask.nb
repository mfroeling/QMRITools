     "SmartMask"], "InlineFormula",ExpressionUUID->
      "adf816e5-a5c9-8440-962b-88af2c2876f9"],
     " value between 0 and 1. higher values removes more data."
    }], "TableText",ExpressionUUID->"3546fdea-053b-c741-8228-9dbc73be31b5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1b29de41-2a5b-554f-a1bb-af8e9864eec0"], 
    ButtonBox["MaskCompartment",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MaskCompartment"], "\"\<Muscle\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["Mask",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Mask"]], "InlineFormula",
      ExpressionUUID->"ab9b64fd-4817-3743-8a86-6e1484a09a69"],
     "Compartment is an option for ",
     Cell[BoxData[
     "SmartMask"], "InlineFormula",ExpressionUUID->
      "19af42c9-ae6c-224b-8fba-462cd7e9633d"],
     ". Can be \"Muscle\" or \"Fat\"."
    }], "TableText",ExpressionUUID->"24df406c-954d-aa4e-ba6f-5ff23a6187ee"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "680d17c1-e375-c545-82bb-ffbc0a013531"], 
    ButtonBox["SmartMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SmartMethod"], "\"\<Continuous\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SmartMethod",
       BaseStyle->"Link",
