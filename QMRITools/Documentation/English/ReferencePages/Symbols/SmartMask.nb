Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"735f7d88-4b95-654e-8639-03e8c86ac425"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SmartMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/SmartMask"], "[", 
   StyleBox["input", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7f5fe401-6cfc-a547-9a3b-c6378f4296c1"],
 "\[LineSeparator]crates a smart ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "4d5d1627-d0e8-b648-940f-1082b2ab0cca"],
 " of ",
 Cell[BoxData[
  StyleBox["input", "TI"]], "InlineFormula",ExpressionUUID->
  "7b0db972-2136-e648-be6d-e48a8f972d4b"],
 ",which is either the tensor or the tensor parameters calculated using ",
 Cell[BoxData[
  ButtonBox["ParameterCalc",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ParameterCalc"]], "InlineFormula",
  ExpressionUUID->"9e3accfb-e6d5-1943-ad38-341741c52544"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d8a9b772-9732-b84a-b100-2ccee0d329e7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SmartMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/SmartMask"], "[", 
   RowBox[{
    StyleBox["input", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5fc103b3-54ed-8844-a175-8502816a0131"],
 "\[LineSeparator]crates a smart ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "0a669c7e-eeb0-f540-9a56-42a198ffeb5f"],
 " of ",
 Cell[BoxData[
  StyleBox["input", "TI"]], "InlineFormula",ExpressionUUID->
  "9a655674-86d8-9643-b31b-21ed2db0ad1d"],
 " and used the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "cd71b068-a4fe-8148-bdb7-96c8af6880e7"],
 " as a prior selection of the ",
 Cell[BoxData[
  StyleBox["input", "TI"]], "InlineFormula",ExpressionUUID->
  "5289059f-a064-184a-a10b-3187ab3131ae"],
 "."
}], "Usage",
