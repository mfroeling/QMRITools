Notebook[{

Cell[CellGroupData[{
Cell["P2SDenoise", "ObjectName",
 CellID->45788777,ExpressionUUID->"504db517-e6be-af40-91bb-854847b96e4c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c3d20627-9eb7-e54f-94d3-0a9a85be317a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["P2SDenoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/P2SDenoise"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9a6b75e3-1069-7c46-88dc-d6d4859d6974"],
 "\[LineSeparator]removes noise from the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "ca5e6abc-90c0-7842-953d-698c5073ee09"],
 " using self-supervised linear regression,where each volume is predicted \
from all other volumes. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"240b3c53-d19a-5c4d-aacc-470a83bd2874"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["P2SDenoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/P2SDenoise"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cf844c63-d775-314f-9e56-5a6762e271b1"],
 "\[LineSeparator]does the same but only within the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "bd6aea34-7185-be48-adec-2e1786087881"],
 ". The regression is fitted on Iterations random row sketches of 10% of the \
voxels and the predictions are averaged. The option Method sets the sketch \
and can be \"Leverage\" (default, leverage score sampling) or \"Count\" \
(count sketch). \n",
 Cell["   ", "ModInfo",ExpressionUUID->"824a4207-a249-634f-a688-cbf15f6d0c86"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["P2SDenoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/P2SDenoise"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"482f7351-03ae-c449-8a4a-fa9d170da7d3"],
 "\[LineSeparator]is based on DOI:10.48550/arXiv.2011.01355 (Patch2Self) and \
Patch2Self2 (CVPR 2024)."
}], "Usage",
 CellChangeTimes->{{4.003804553773775*^9, 4.0038045540673275`*^9}},
 CellID->303139211,ExpressionUUID->"3a21effe-c607-bd49-9bd5-5f1458925246"],

Cell["The following options can be given: ", "Notes",
 CellID->323605571,ExpressionUUID->"b2f6f9c8-f874-5c41-813d-1d2ed0a110f3"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c2d25e64-eaac-854b-b023-feea341985d7"], 
    ButtonBox["Threshold",
     BaseStyle->"Link"], "2", Cell[
    "XXXX", "TableText",ExpressionUUID->
     "824d0441-5f1e-8c45-9307-66ec8ae2fd43"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c6aeb284-89b3-8644-883f-aa1f6f09ab59"], 
    ButtonBox["Iterations",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsElastixTools/ref/Iterations"], "10", 
    Cell["\<\
Iterations is an options for RegisterData, RegisterDiffusionData, and \
RegisterDataTransform. 
It specifies the number of iterations used by the registration functions.\
\>", "TableText",ExpressionUUID->"e7b41630-59fa-7240-a3e0-e71e5335c5b9"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a34c5a54-257b-bf4d-8947-4b607e9ab933"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<Leverage\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"c3befce2-374b-4c44-be70-1af56461ceaf"]}
  }]], "3ColumnTableMod",
 CellID->105295122,ExpressionUUID->"e9ff2fbb-8311-0c46-baea-33edf8d6db69"]
}, Open  ]],

