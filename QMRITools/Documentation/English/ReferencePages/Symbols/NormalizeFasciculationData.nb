Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"41edc328-30ff-9d4d-bdf8-91e1965a3495"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NormalizeFasciculationData",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsFasciculationTools/ref/NormalizeFasciculationData"], "[", 
   RowBox[{
    StyleBox["data_", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["tens", "TI"], ",", 
      StyleBox["grad", "TI"], ",", 
      StyleBox["val", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"006b63b1-ac72-b243-8479-6f27572102ab"],
 "\[LineSeparator]will normalize DWI data based on the tensor fit. For each \
diffusion direction and b-value the estimated unweighted image is calculated."
}], "Usage",
