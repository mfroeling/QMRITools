Notebook[{

Cell[CellGroupData[{
Cell["SimAddPhase", "ObjectName",
 CellID->14532087,ExpressionUUID->"3bfc6590-1ec5-a24e-a69b-61d6cb8cbf28"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"668654f9-212a-f146-8b6b-c9263fa348c0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimAddPhase",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SimAddPhase"], "[", 
   RowBox[{
    StyleBox["din", "TI"], " ", ",", 
    StyleBox["ham", "TI"], " ", ",", 
    StyleBox["phase", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2fa0a49d-d6f4-264b-8619-55d84f1136f9"],
 "\[LineSeparator]adds ",
 Cell[BoxData[
  StyleBox["phase", "TI"]], "InlineFormula",ExpressionUUID->
  "f0f5303c-2b41-b644-9a82-9f735438e065"],
 " to the spin system din given the hamiltonian ham. din and ham are \
generated by ",
 Cell[BoxData[
  ButtonBox["SimHamiltonian",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SimHamiltonian"]], "InlineFormula",
  ExpressionUUID->"543ef565-bb94-fd45-ad59-3bd8cbc7808d"],
 ". The phase is defined in degree. The output is a new spin system dOut."
}], "Usage",
 CellChangeTimes->{{3.9966566638509045`*^9, 3.996656663900633*^9}},
 CellID->143196911,ExpressionUUID->"f85dd2cb-bed2-5245-92fd-19c09d1e6e33"],

