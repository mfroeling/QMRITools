Cell[CellGroupData[{
Cell["ExportNii", "ObjectName",
 CellID->436556069,ExpressionUUID->"66782166-1e28-0342-bcf9-0123ca881113"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4b1fb564-e57d-b640-95f9-cfdf710274a9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportNii"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6ac1f0c1-7293-d740-8971-397627d10b12"],
 "\[LineSeparator]exports the nii file and will prompt for a file name. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"66b962f7-04cd-574f-9fa0-d7489f2fd3db"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportNii"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"], 
    ",", "\"\<\!\(\*StyleBox[\"file\", \"TI\"]\)\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"8a54105b-0637-7a4b-a7f5-05d49ea63ae3"],
 "\[LineSeparator]exports the nii file to the location \"file",
 Cell[BoxData[
  StyleBox["\"\<file\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "291ab442-36f1-cb40-88f8-92417f98f293"],
 "\"."
}], "Usage",
 CellChangeTimes->{{3.9985332140118446`*^9, 3.9985332141697693`*^9}},
 CellID->5611031,ExpressionUUID->"e3f6751c-868c-cd41-8fbc-01d7bdd0c5f8"],

Cell["The following options can be given: ", "Notes",
 CellID->250910310,ExpressionUUID->"d82394c1-b704-274e-a1a3-10b18db34398"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ec340a8c-89f0-0c41-80fe-0716814d3b75"], 
    ButtonBox["NiiDataType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNiftiTools/ref/NiiDataType"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     "NiiDataType is an option of ",
     Cell[BoxData[
     "ExportNii"], "InlineFormula",ExpressionUUID->
      "2d5fa0c9-ae84-9047-902d-89388f9acd4a"],
     ". The number type of Nii file can be \"Integer\", \"Real\", \
\"Complex\", or \"Automatic\"."
    }], "TableText",ExpressionUUID->"91fd8c87-edb1-0c4d-85fb-fc6aeafc69a3"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "acbda0cb-b31b-bb49-a0d8-f010df650c94"], 
    ButtonBox["CompressNii",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNiftiTools/ref/CompressNii"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "CompressNii is an option for DcmToNii and ",
     Cell[BoxData[
     "ExportNii"], "InlineFormula",ExpressionUUID->
      "65ae6760-e059-b94c-a9a1-63046e7fc0f0"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "30b98632-204d-6b42-976a-d8ff749377d3"],
     " .nii.gz files will be created."
    }], "TableText",ExpressionUUID->"417b0f45-6208-4a4f-b484-a64ac805d3b5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "223bd6ef-7544-f54b-945c-878a342c30c7"], 
    ButtonBox["NiiOffset",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNiftiTools/ref/NiiOffset"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     "NiiOffset is an option of ",
     Cell[BoxData[
     "ExportNii"], "InlineFormula",ExpressionUUID->
      "b6a1a44c-e29c-cb47-b388-4c56f56173d3"],
     ". Is {xOff, yOff, zOff}."
    }], "TableText",ExpressionUUID->"2d66e0ab-0a39-1e47-9de7-74d2b4725ea3"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d18fc6f0-8042-f340-a7d8-03543a819535"], 
    ButtonBox["NiiLegacy",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNiftiTools/ref/NiiLegacy"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "NiiLegacy is an option for ",
     Cell[BoxData[
     "ExportNii"], "InlineFormula",ExpressionUUID->
      "4aa17cbf-0b4c-f24e-8417-93f194b73646"],
     ", if set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "f1e6db39-c0c3-8245-afbf-bfc7caae8c39"],
     " default orientations are set instead of unknown."
    }], "TableText",ExpressionUUID->"d719c870-192d-d74a-b087-df6ff17bcdbc"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "76014bb8-21e7-6b40-bfa0-5ea6024a0195"], 
    ButtonBox["NiiSliceCode",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNiftiTools/ref/NiiSliceCode"], "0", Cell["\<\
NiiSliceCode is an option for Export nii. With this you can set the slice \
code of the nii file.\
