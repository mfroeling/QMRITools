Cell[CellGroupData[{
Cell["ExportNii", "ObjectName",
 CellID->167380252,ExpressionUUID->"08541ebc-028a-9f48-b891-65ed1c3acc85"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5110577b-0d88-694f-a600-25b859805c80"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportNii"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bcdfa04a-f9a2-0f4f-a761-7bd002dfcfe9"],
 "\[LineSeparator]exports the nii file and will prompt for a file name. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4ae82f84-74f7-1343-92f0-5ebfdc769ae8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportNii"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"], 
    ",", "\"\<\!\(\*StyleBox[\"file\", \"TI\"]\)\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"1db1df7e-fd66-114a-b4e1-90dc0e60257d"],
 "\[LineSeparator]exports the nii file to the location \"file",
 Cell[BoxData[
  StyleBox["\"\<file\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "9b46a8d0-d2d0-1848-85cc-4f4d694b2acf"],
 "\"."
}], "Usage",
 CellChangeTimes->{{4.0038045196931553`*^9, 4.003804519827017*^9}},
 CellID->221419894,ExpressionUUID->"8ff1a6dc-94e1-b040-9d0e-30b7e54b5306"],

Cell["The following options can be given: ", "Notes",
 CellID->599576787,ExpressionUUID->"8de0ed1d-84d2-084f-9163-f4df7667b783"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "aca31421-0b55-a542-a01b-2887b042c963"], 
    ButtonBox["NiiDataType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNiftiTools/ref/NiiDataType"], 
