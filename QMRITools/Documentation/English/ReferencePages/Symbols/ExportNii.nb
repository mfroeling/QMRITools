Cell[CellGroupData[{
Cell["ExportNii", "ObjectName",
 CellID->385267155,ExpressionUUID->"a4e4c3cc-7e82-7c46-9b72-aaf0e647708b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4f765dc0-6166-2a40-8212-a3d92aabd275"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportNii"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "53ccbf3a-ede0-db4c-9ee0-71df194e076f"],
 "\[LineSeparator]exports the nii file and will prompt for a file name. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e0083023-7f85-844a-a91b-bd0cb7bf8ad4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ExportNii"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"], 
    ",", "\"\<\!\(\*StyleBox[\"file\", \"TI\"]\)\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"1414ee1f-6402-de4e-9090-0c0e7c72ffc4"],
 "\[LineSeparator]exports the nii file to the location \"file",
 Cell[BoxData[
  StyleBox["\"\<file\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "2b878a6d-5371-7541-835b-be1f9c511b35"],
 "\"."
}], "Usage",
