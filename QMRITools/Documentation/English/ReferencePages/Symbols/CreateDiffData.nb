Notebook[{

Cell[CellGroupData[{
Cell["CreateDiffData", "ObjectName",
 CellID->633013574,ExpressionUUID->"50cdd271-0550-e541-9958-ae4475898d55"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"edd193f5-ec46-1545-9831-4b5318a426d1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CreateDiffData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/CreateDiffData"], "[", 
   RowBox[{
    StyleBox["sig", "TI"], ",", 
    StyleBox["eig", "TI"], ",", 
    StyleBox["bvec", "TI"], ",", 
    StyleBox["gradients", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1577680a-fe94-cd49-8116-7eb2688233de"],
 "\[LineSeparator]creates a DTI datasets of dimensions ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",ExpressionUUID->
  "2e17c597-76e2-9341-a1f6-02b67fe4e8e2"],
 " with ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "846101fd-fcbd-6349-b42b-adb0609ab69b"],
 " as unweighted signal s0 and ",
 Cell[BoxData[
  StyleBox["bvec", "TI"]], "InlineFormula",ExpressionUUID->
  "841b6268-23ae-064c-a9f2-90b92f1ed9b5"],
 " and ",
 Cell[BoxData[
  StyleBox["gradients", "TI"]], "InlineFormula",ExpressionUUID->
  "368a5492-de63-4c40-a936-e909895d922c"],
 ". ",
 Cell[BoxData[
  StyleBox["eig", "TI"]], "InlineFormula",ExpressionUUID->
  "64fc6706-c00d-6c40-aeff-457f47b0d4d9"],
 " can be {l1, l2, l3}, {{l1, l2, l3}, {e1, e2, e3}}, {{l1, l2, l3}, \"Random\
\"}, {{l1, l2, l3}, \"RandomZ\"} or {{l1, l2, l3}, \"OrtRandom\"}. Uses ",
 Cell[BoxData[
  ButtonBox["Tensor",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/Tensor"]], "InlineFormula",
  ExpressionUUID->"1449bba8-d537-964f-9d0b-b09ebac18da0"],
 " internally. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1b891685-ae82-da46-8a9c-2af29ddb8321"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CreateDiffData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/CreateDiffData"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "1067e7c8-ffe3-264e-83f1-60cc207f1bd0"],
 "\[LineSeparator]is based on DOI: 10.1002/nbm.2959."
}], "Usage",
 CellChangeTimes->{{3.998533197095106*^9, 3.9985331973570786`*^9}},
 CellID->91316509,ExpressionUUID->"c707c68c-6029-2842-9c60-98dc76a33442"],

