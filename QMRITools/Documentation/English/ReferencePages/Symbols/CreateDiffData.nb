Notebook[{

Cell[CellGroupData[{
Cell["CreateDiffData", "ObjectName",
 CellID->332128176,ExpressionUUID->"c461e8d5-75df-be4a-8222-c902b54bf483"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ee29307e-4206-f940-951a-c90b34d06080"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CreateDiffData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/CreateDiffData"], "[", 
   RowBox[{
    StyleBox["sig", "TI"], ",", 
    StyleBox["eig", "TI"], ",", 
    StyleBox["bvec", "TI"], ",", 
    StyleBox["gradients", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "98dacebc-8d56-564c-9ad8-1a60af422de5"],
 "\[LineSeparator]creates a DTI datasets of dimensions ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",ExpressionUUID->
  "69dd402a-8ff2-8a44-83dc-3e02a4eda658"],
 " with ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "7c7a3e4f-0c53-594c-918d-962b78c2fac9"],
 " as unweighted signal s0 and ",
 Cell[BoxData[
  StyleBox["bvec", "TI"]], "InlineFormula",ExpressionUUID->
  "b284104a-1468-c640-8c5c-b3a5d6234adf"],
 " and ",
 Cell[BoxData[
  StyleBox["gradients", "TI"]], "InlineFormula",ExpressionUUID->
  "aa159caa-d15b-2b48-ba84-0de042532dc5"],
 ". ",
 Cell[BoxData[
  StyleBox["eig", "TI"]], "InlineFormula",ExpressionUUID->
  "a0cb1427-3870-6341-a6a0-e7cc4018ca50"],
 " can be {l1, l2, l3}, {{l1, l2, l3}, {e1, e2, e3}}, {{l1, l2, l3}, \"Random\
\"}, {{l1, l2, l3}, \"RandomZ\"} or {{l1, l2, l3}, \"OrtRandom\"}. Uses ",
 Cell[BoxData[
  ButtonBox["Tensor",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/Tensor"]], "InlineFormula",
  ExpressionUUID->"c600caab-056b-ce41-83d9-202e981efb7d"],
 " internally. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3580d8e9-aa0f-a044-81ae-6509eaaf1a13"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CreateDiffData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/CreateDiffData"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "16ab2806-35ef-084d-9264-829cfd47a7c5"],
 "\[LineSeparator]is based on DOI: 10.1002/nbm.2959."
}], "Usage",
 CellChangeTimes->{{4.003804500622896*^9, 4.003804500750391*^9}},
 CellID->457999727,ExpressionUUID->"79025cd6-8f38-c94e-9195-8ef43ac54f89"],

