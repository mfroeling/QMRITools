Notebook[{

Cell[CellGroupData[{
Cell["CreateDiffData", "ObjectName",
 CellID->134242362,ExpressionUUID->"bf23f6dd-c6fa-2349-92e1-408e0df2096d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e3c6d1c4-8155-0d42-a357-70879da10ed3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CreateDiffData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/CreateDiffData"], "[", 
   RowBox[{
    StyleBox["sig", "TI"], ",", 
    StyleBox["eig", "TI"], ",", 
    StyleBox["bvec", "TI"], ",", 
    StyleBox["gradients", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f13c9fd1-1138-da40-87b6-a46c4e6148de"],
 "\[LineSeparator]creates a DTI datasets of dimensions ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",ExpressionUUID->
  "e70bfd8b-8390-094f-ab3a-8657844440bb"],
 " with ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "4ecdf335-2403-da42-a203-48c9c3bae2a5"],
 " as unweighted signal s0 and ",
 Cell[BoxData[
  StyleBox["bvec", "TI"]], "InlineFormula",ExpressionUUID->
  "ed282ecc-26bf-c94b-a125-600465f36f0f"],
 " and ",
 Cell[BoxData[
  StyleBox["gradients", "TI"]], "InlineFormula",ExpressionUUID->
  "881673b7-ebac-0e4c-a58f-85d54de3987c"],
 ". ",
 Cell[BoxData[
  StyleBox["eig", "TI"]], "InlineFormula",ExpressionUUID->
  "f200631e-fd24-6145-bc81-c2140654dc7d"],
 " can be {l1, l2, l3}, {{l1, l2, l3}, {e1, e2, e3}}, {{l1, l2, l3}, \"Random\
\"}, {{l1, l2, l3}, \"RandomZ\"} or {{l1, l2, l3}, \"OrtRandom\"}. Uses ",
 Cell[BoxData[
  ButtonBox["Tensor",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/Tensor"]], "InlineFormula",
  ExpressionUUID->"4f0522f8-d662-ac4f-9577-6fd0efcfee4b"],
 " internally. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"df666d24-78d4-254d-a75e-e07f5ecec98d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CreateDiffData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/CreateDiffData"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "ca0db5e9-85ff-9e44-b83c-d56d61d3afcf"],
 "\[LineSeparator]is based on DOI: 10.1002/nbm.2959."
}], "Usage",
 CellChangeTimes->{{3.9966563560493393`*^9, 3.9966563562395115`*^9}},
 CellID->561045937,ExpressionUUID->"79fa5399-a4e1-5d45-84f6-a3ea349d36f5"],

