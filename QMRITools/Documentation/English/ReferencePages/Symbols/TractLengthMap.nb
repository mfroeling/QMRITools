Notebook[{

Cell[CellGroupData[{
Cell["TractLengthMap", "ObjectName",
 CellID->619029495,ExpressionUUID->"2af81f28-3d45-004b-9c9b-4ee2151dd739"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ddb6f2ba-3d84-eb48-b4f2-f94e7ccccd26"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TractLengthMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/TractLengthMap"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f6d01f76-9a81-6c4b-9ba1-b95d4e5745dc"],
 "\[LineSeparator]makes a tract length map based on the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "d491cd38-210a-f94d-a194-c390e2e12037"],
 " lengths, the median per voxel. Voxels without ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "49a49570-8fb2-ba47-95e0-43607d740912"],
 " are -1."
}], "Usage",
 CellChangeTimes->{{4.003804593926052*^9, 4.0038045939910984`*^9}},
 CellID->48682194,ExpressionUUID->"5ffa4bf8-7757-f842-924a-b533156528ff"],

