Notebook[{

Cell[CellGroupData[{
Cell["IVIMCalc", "ObjectName",
 CellID->23455778,ExpressionUUID->"2bb94780-5787-7048-9cef-59f9d2122ab9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b82080c6-901b-eb44-9832-d2bbfd959b59"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMCalc"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["binp", "TI"], ",", 
    StyleBox["init", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a692232d-1105-3a44-acbc-dbcf1def8ec1"],
 "\[LineSeparator]calculates the IVIM fit. ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "cee1cbd2-e314-8746-8146-2064c12b94d7"],
 " should be 1D ,2D, 3D or 4D. ",
 Cell[BoxData[
  StyleBox["binp", "TI"]], "InlineFormula",ExpressionUUID->
  "fc60c976-0271-7741-98e8-f74b71f47368"],
 " should be full bmatrix which can be calculated from the bvecs en bvals \
using ",
 Cell[BoxData[
  ButtonBox["Bmatrix",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/Bmatrix"]], "InlineFormula",
  ExpressionUUID->"563af5ed-1fa2-b44c-9941-996245cebb3c"],
 " with the bvalues in s/mm^2. init should are the initialization parameters \
for 2 components this is {s0, f, D, Dp} for 3 components this is {s0, f1, f2, \
D, Dp1, Dp2}. The fraction is defined between 0 and 1, the D, Dp, Dp1 and Dp2 \
is in mm^2/s. output is {s0, f1, D, pD1} or {s0, f1, f2, D, pD1, pD2}."
}], "Usage",
 CellChangeTimes->{{3.996656834645378*^9, 3.996656834714573*^9}},
 CellID->406084591,ExpressionUUID->"d0604e3b-14d3-e741-9776-71087ff11015"],

Cell["The following options can be given: ", "Notes",
 CellID->1010292755,ExpressionUUID->"45a52034-4832-1a4a-8336-01d9c5ea4bfa"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "48d2c449-7c1c-4446-9e4f-fc99e55ecfdd"], 
    ButtonBox["Method",
     BaseStyle->"Link"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"05a20f1a-5b48-6444-9514-dc3a2e41c2f1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f97f1572-fa55-f846-81a2-538a37a41412"], 
    ButtonBox["Parallelize",
     BaseStyle->"Link"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Parallelize", "[", 
       StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
      "226f80a8-21fb-bb49-821b-c0e128d50a56"],
     " evaluates ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "a728be44-94e1-6a48-88f3-1c5da7dec840"],
     " using automatic parallelization."
    }], "TableText",ExpressionUUID->"07974af4-c828-9748-a726-3681e5f9a2a6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1453be7e-db31-1545-bd29-bf2f17edfc1d"], 
    ButtonBox["IVIMFixed",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/IVIMFixed"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["IVIMFixed",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/IVIMFixed"]], "InlineFormula",
      ExpressionUUID->"81324341-d20d-a14e-9497-1f97159e1769"],
     " is an option for ",
     Cell[BoxData[
     "IVIMCalc"], "InlineFormula",ExpressionUUID->
      "19e58512-179a-5d4c-9ce5-6f7d3c27f807"],
     " and the default value is False. \nWhen set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "b2046232-170d-024e-a2a8-a22e882adf0c"],
     " the pseudo diffusion wil be fixed to the parameter given as init.\n\
When set to \"One\" only the fast component of a 3 compartment fit is fixed."
    }], "TableText",ExpressionUUID->"fdcc5da0-ef4e-1648-9659-d58ef65d0030"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2a2641c8-dbf6-fa41-9a2f-61515808d819"], 
    ButtonBox["IVIMConstrained",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/IVIMConstrained"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["IVIMConstrained",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/IVIMConstrained"]], "InlineFormula",
      ExpressionUUID->"b5d55355-aa13-0845-9087-4d30d82daed7"],
     " is an option for ",
     Cell[BoxData[
     "IVIMCalc"], "InlineFormula",ExpressionUUID->
      "1bfc5b0c-6178-fd48-804e-10ebdfab6de3"],
     ". When set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "a4cb8c32-ecd5-2c4a-b72c-65d9f1cb1a26"],
     " the fit wil be constrained to the values given in ",
     Cell[BoxData[
      ButtonBox["IVIMConstrains",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/IVIMConstrains"]], "InlineFormula",
      ExpressionUUID->"5f115221-6318-b648-b10b-a78d0660a528"],
     "."
    }], "TableText",ExpressionUUID->"1132de26-cc0a-d845-b94e-3d59177d8dbf"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c1496f60-e309-c14f-a8f9-49b51bac6e8c"], 
    ButtonBox["IVIMComponents",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/IVIMComponents"], "2", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["IVIMComponents",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/IVIMComponents"]], "InlineFormula",
      ExpressionUUID->"a4b3a4e3-90ff-de43-8e4e-395e755d922a"],
     " is an option for ",
     Cell[BoxData[
     "IVIMCalc"], "InlineFormula",ExpressionUUID->
      "3586b95b-f675-4140-9b57-afacd922f98c"],
     ". Default value is 2, the tissue and the blood component. can also be \
set to 3."
    }], "TableText",ExpressionUUID->"d8e94030-4036-8046-8656-9293b9d7b002"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b34202d4-7269-4b4d-98e7-915d26d64841"], 
    ButtonBox["IVIMConstrains",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/IVIMConstrains"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.8", ",", " ", "1.2"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.0005", ",", " ", "0.0035"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.001", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.001", ",", " ", "0.5"}], "}"}]}], "}"}], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["IVIMConstrains",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/IVIMConstrains"]], "InlineFormula",
      ExpressionUUID->"b813b445-6e3a-c94c-9185-4de4b3740bd3"],
     " is an option for ",
     Cell[BoxData[
     "IVIMCalc"], "InlineFormula",ExpressionUUID->
      "61e6e503-78b7-ef49-9af9-b6a9e2c53c99"],
     ".\nDefault values are: {{0.8, 1.2}, {0, 1}, {0.0005, 0.0035}, {0.005, \
0.5}, {0.002, 0.015}}.\nWhere {{s0 in percentage},{fractions},{tissue \
diffusion},{blood compartment Dp},{third compartment}}."
    }], "TableText",ExpressionUUID->"304ec6c1-57a5-6546-aa8a-b40b69cb2bc6"]}
  }]], "3ColumnTableMod",
 CellID->100031850,ExpressionUUID->"df91391b-749d-d544-ab0b-162ac43b9ad8"]
