Notebook[{

Cell[CellGroupData[{
Cell["IVIMCalc", "ObjectName",
 CellID->73309173,ExpressionUUID->"3ac0364e-29b2-8d49-85cf-6302390f5548"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2521b595-2f30-2348-98b9-eb24e46c178f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMCalc"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["bInp", "TI"], ",", 
    StyleBox["init", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f1060582-eb42-d048-beca-50a045dc816b"],
 "\[LineSeparator]calculates the IVIM fit. ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "931656e3-4a43-e04d-9ca7-f974cc26035d"],
 " should be 1D ,2D, 3D or 4D. ",
 Cell[BoxData[
  StyleBox["bInp", "TI"]], "InlineFormula",ExpressionUUID->
  "d964c893-a26d-584b-bfbb-033009089802"],
 " should be full bmatrix which can be calculated from the bvecs en bvals \
using Bmatrix with the bvalues in s/mm^2. ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "9372470d-fbfc-014e-bfbd-035b8cda7995"],
 " should are the initialization parameters for 2 comp this is {s0, f, D, Dp} \
for 3 comp this is {s0, f1, f2, D, Dp1, Dp2}. The fraction is defined between \
0 and 1, the D, Dp, Dp1 and Dp2 is in mm^2/s. output is {s0, f1, D, pD1} or \
{s0, f1, f2, D, pD1, pD2}."
}], "Usage",
 CellChangeTimes->{{3.9985332329791317`*^9, 3.998533233125372*^9}},
 CellID->115099285,ExpressionUUID->"93294f10-1326-7546-a420-0a4545eefb79"],

Cell["The following options can be given: ", "Notes",
 CellID->694314518,ExpressionUUID->"f13520ff-92a2-ff46-8adb-2c439aa92e84"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c5c4a7f9-027c-ce41-9f71-ca8a108d287c"], 
    ButtonBox["Method",
     BaseStyle->"Link"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"429c9c1f-6776-9e4e-9e87-1b4abde3f7a2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6cdedb54-27da-6349-8443-3cd2c17c3ce4"], 
    ButtonBox["Parallelize",
     BaseStyle->"Link"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Parallelize", "[", 
       StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
      "efbd4965-9a4a-ce4f-9a33-702332abd459"],
     " evaluates ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "e417e8dc-5772-0045-8953-ffdbca9e1019"],
     " using automatic parallelization."
    }], "TableText",ExpressionUUID->"84be5f5c-d262-a849-bc2e-f1210dfb7f96"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2480645b-7302-3a40-ba37-11dc25bb16f1"], 
    ButtonBox["IVIMFixed",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMFixed"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "IVIMFixed is an option for ",
     Cell[BoxData[
     "IVIMCalc"], "InlineFormula",ExpressionUUID->
      "91a1695f-3ca3-2540-86d0-c2baee114f85"],
     " and the default value is False. \nWhen set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "97cbcb45-e1a2-4d4d-a399-f09231706031"],
     " the pseudo diffusion wil be fixed to the parameter given as init.\n\
When set to \"One\" only the fast component of a 3 compartment fit is fixed."
    }], "TableText",ExpressionUUID->"48b65de7-da2a-3548-bdce-9fae624d2ed9"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "93492d3a-5566-de4b-b8c9-761aec458aaf"], 
    ButtonBox["IVIMConstrained",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMConstrained"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "IVIMConstrained is an option for ",
     Cell[BoxData[
     "IVIMCalc"], "InlineFormula",ExpressionUUID->
      "31c63c0e-9a24-9f49-8606-66f4d11a6c61"],
     ". When set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "d0d0895a-a21a-2040-a677-1deab5c183b8"],
     " the fit wil be constrained to the values given in IVIMConstrains."
    }], "TableText",ExpressionUUID->"de890bf2-98df-9141-9246-268d0c6f310e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "edeab594-200d-5249-9ff3-d148a19fb0b9"], 
    ButtonBox["IVIMComponents",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMComponents"], "2", Cell[
    TextData[{
     "IVIMComponents is an option for ",
     Cell[BoxData[
     "IVIMCalc"], "InlineFormula",ExpressionUUID->
      "0c85dd8a-f4da-1040-9643-addd8d281413"],
     ". Default value is 2, the tissue and the blood component. can also be \
set to 3."
    }], "TableText",ExpressionUUID->"e6596d35-eb2e-7e4b-86eb-343c7b64365f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c14eb25c-9306-ea49-a0d8-520ce9c34895"], 
    ButtonBox["IVIMConstrains",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMConstrains"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.1", ",", " ", "20"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.0005", ",", " ", "0.0035"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.001", ",", " ", "0.5"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.001", ",", " ", "0.5"}], "}"}]}], "}"}], Cell[TextData[{
     "IVIMConstrains is an option for ",
     Cell[BoxData[
     "IVIMCalc"], "InlineFormula",ExpressionUUID->
      "c85e0c91-fac1-2b40-bdb5-f668cd4033a0"],
     ".\nDefault values are: {{0.8, 1.2}, {0, 1}, {0.0005, 0.0035}, {0.005, \
0.5}, {0.002, 0.015}}.\nWhere {{s0 in percentage},{fractions},{tissue \
diffusion},{blood compartment Dp},{third compartment}}."
    }], "TableText",ExpressionUUID->"76deca7a-3d6b-6342-8200-0494cc4726fe"]}
  }]], "3ColumnTableMod",
 CellID->49400343,ExpressionUUID->"4b364658-dee4-1544-afc7-98a212c4a427"]
}, Open  ]],

