Cell[CellGroupData[{
Cell["MeanBvalueSignal", "ObjectName",
 CellID->568863705,ExpressionUUID->"89e1043a-ae38-d148-bd10-21c1f80bfcca"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5380fa82-82c8-b44b-a758-e5d4354f9f6d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MeanBvalueSignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/MeanBvalueSignal"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["bval", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c167ec0f-238d-434a-9ab9-2b8e8b9f9360"],
 "\[LineSeparator]calculates the geometric mean of the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "d3053e65-c658-3542-bf75-5c68990d04ed"],
 " for each unique ",
 Cell[BoxData[
  StyleBox["bval", "TI"]], "InlineFormula",ExpressionUUID->
  "4e0e828d-b953-604f-b734-b1c20cbef496"],
 ". output is the mean ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "25c846c0-f7a4-5548-b6bd-7d4344fd24e0"],
 " and the unique bvalues."
}], "Usage",
