Notebook[{

Cell[CellGroupData[{
Cell["CorrectBmatrix", "ObjectName",
 CellID->165695293,ExpressionUUID->"901b465b-826c-f646-9660-db76abcfac0c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"602af50c-7784-754a-8f32-555b2c8999c0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CorrectBmatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/CorrectBmatrix"], "[", 
   RowBox[{
    StyleBox["bmat", "TI"], ",", 
    StyleBox["transformation", "TI"]}], "]"}]], "InlineFormula",
  ExpressionUUID->"a1d1ff84-0e15-7f45-994a-4109f9ddb1c5"],
 "\[LineSeparator]corrects the bmatrix ",
 Cell[BoxData[
  StyleBox["bmat", "TI"]], "InlineFormula",ExpressionUUID->
  "7d84f1f2-1a91-ab43-9016-d6c1b6352133"],
 " with the ",
 Cell[BoxData[
  StyleBox["transformation", "TI"]], "InlineFormula",ExpressionUUID->
  "15b43793-2772-974d-b2df-c1157e13e124"],
 " parameters from ",
 Cell[BoxData[
  ButtonBox["RegisterData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterData"]], "InlineFormula",
  ExpressionUUID->"88d9f234-4d4b-4445-a180-6f25145e0d0b"],
 " or ",
 Cell[BoxData[
  ButtonBox["RegisterDiffusionData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterDiffusionData"]], 
  "InlineFormula",ExpressionUUID->"05461e87-9574-f444-8dd5-7bd63476bc45"],
 ". Output is the corrected bmatrix."
}], "Usage",
 CellChangeTimes->{{3.9966563568134003`*^9, 3.996656356880003*^9}},
 CellID->235685221,ExpressionUUID->"de96249c-ae98-9f41-bafd-c5afba11c087"],

Cell["The following options can be given: ", "Notes",
 CellID->297763954,ExpressionUUID->"94525ce3-6bd3-9045-a834-c323e8b29497"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "33da351b-dcb5-cb47-ad2f-9aee9913b2ed"], 
    ButtonBox["MethodReg",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MethodReg"], "\"\<Full\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["MethodReg",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MethodReg"]], "InlineFormula",
      ExpressionUUID->"02538bfc-82fb-b249-ab03-5d34a51bca7d"],
     " is an options for ",
     Cell[BoxData[
      ButtonBox["RegisterData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RegisterData"]], "InlineFormula",
      ExpressionUUID->"0361bcdc-97a4-b64c-a1ca-d61586ff2848"],
     ", ",
     Cell[BoxData[
      ButtonBox["RegisterDiffusionData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RegisterDiffusionData"]], 
      "InlineFormula",ExpressionUUID->"896db219-5a5e-4b4e-970c-02a82da5ec71"],
     ", ",
     Cell[BoxData[
      ButtonBox["RegisterCardiacData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RegisterCardiacData"]], 
      "InlineFormula",ExpressionUUID->"021f447e-a0f6-3748-8838-4fdef8703434"],
     " and ",
     Cell[BoxData[
      ButtonBox["RegisterData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RegisterData"]], "InlineFormula",
      ExpressionUUID->"c7980cde-efa7-7445-9f5f-51412a57e533"],
     "Transform. \nIt specifies which registration method to use. \nMethods \
can be be \"translation\", \"rigid\", \"affine\", \"bspline\", \"rigidDTI\", \
\"affineDTI\", \"PCAtranslation\", \"PCArigid\", \"PCAaffine\", or \
\"PCAbspline\"."
    }], "TableText",ExpressionUUID->"a577f140-491a-2f4b-9c31-dd04106dd870"]}
