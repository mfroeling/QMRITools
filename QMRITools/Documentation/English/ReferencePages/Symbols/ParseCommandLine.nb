Cell["ParseCommandLine", "ObjectName",
 CellID->223264789,ExpressionUUID->"5353ae69-0b96-9944-801c-2001e3ec81a1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aeb3e43d-ea22-554c-8cbf-3ac1d090fda3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ParseCommandLine",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/ParseCommandLine"], "[", 
   StyleBox["arguments", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ee7dd5a0-b691-a641-b726-9ec108966748"],
 "\[LineSeparator]parses command line arguments and in QmriTools is used for \
using arguments given with command line scripts for processing. Flags start \
with \"--\" and the result is an association with the flags as keys. Values \
following a flag are joined with spaces, a flag without a value gets the \
value ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "c526b523-daef-5e40-b4a4-71f5ab63ec82"],
 "."
}], "Usage",
