Cell["PlotIVIM", "ObjectName",
 CellID->110616397,ExpressionUUID->"3a8b6304-1fae-8840-aa8d-45e2f4b975b7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2cd0d540-3542-0d40-8356-9111b12235ec"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotIVIM",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsPlottingTools/ref/PlotIVIM"], "[", 
   RowBox[{
    StyleBox["vals", "TI"], ",", 
    StyleBox["data", "TI"], ",", 
    StyleBox["bvals", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bfea852f-54a6-e640-97ce-817b3b4d5921"],
 "\[LineSeparator]plots the results of the IVIM fits from ",
 Cell[BoxData[
  ButtonBox["IVIMCalc",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/IVIMCalc"]], "InlineFormula",
  ExpressionUUID->"fe654589-e64c-a64a-923d-7a99d4b85fc8"],
 " or ",
 Cell[BoxData[
  ButtonBox["BayesianIVIMFit2",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/BayesianIVIMFit2"]], "InlineFormula",
  ExpressionUUID->"b721cad7-c641-2944-b3d5-b42e473d323f"],
 " or Baye."
}], "Usage",
 CellChangeTimes->{3.996656826915468*^9},
 CellID->52499932,ExpressionUUID->"8d44ec6c-3995-764f-b7fe-eee84c2f5345"],

