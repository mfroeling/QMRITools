Cell["HarmonicDenoiseTensor", "ObjectName",
 CellID->30303391,ExpressionUUID->"de8238e1-6f65-d14d-9fd1-e4799cc21a19"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"230cbfa9-51e3-2144-b43b-588916ec6a41"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HarmonicDenoiseTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/HarmonicDenoiseTensor"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "366eea2e-7d2c-0b4c-b8f4-d40a726f17e4"],
 "\[LineSeparator]uses the harmonic denoising method to denoise the tensor \
within the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "cc31dd18-fa73-fd4d-9a56-48ea15ac6dc4"],
 ". Values for which the tensor is not defined but are within the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "290acdbf-df5b-0340-8010-15bd5000f954"],
 " will be filled in. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ec236539-c230-e54e-8f3d-d3b4c28f75c8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HarmonicDenoiseTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/HarmonicDenoiseTensor"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["seg", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a2f61c87-9371-9b40-a13f-e1cffd7b9836"],
 "\[LineSeparator]will do the same for each segmentation label in ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "f21e77db-4644-0c42-989f-06a948fcb836"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"01a9c061-381b-5342-8a83-994422704028"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HarmonicDenoiseTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/HarmonicDenoiseTensor"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["seg", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["labs", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7bd91ece-7aec-564a-b268-b30da1f227d1"],
 "\[LineSeparator]will do the same for each segmentation label in ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "38d911f9-918a-a14b-a5af-74f40fbba688"],
 " that is specified in ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "dcc820ba-fafa-cf4e-ac33-0a983e4cb968"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d53f03ef-de01-ab42-a0c7-57655da117d7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HarmonicDenoiseTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/HarmonicDenoiseTensor"], "[",
    "]"}]], "InlineFormula",ExpressionUUID->
  "a61c8209-8c60-4e4d-8443-ea6422ae10d3"],
 "\[LineSeparator]is based on 10.1016/j.media.2011.01.005."
}], "Usage",
