Notebook[{

Cell[CellGroupData[{
Cell["GetNeuralNet", "ObjectName",
 CellID->226680415,ExpressionUUID->"0570a4c3-7722-d64c-965c-431a8f240873"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e5120539-92b4-0b46-a9bd-360e99c812ae"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], "[", 
   StyleBox["name", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "147e9aa8-14a6-c542-8efd-03d9ebbdd3a8"],
 "\[LineSeparator]loads a pre-trained neural net by asset name. The net is \
cached within a session. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9f41b7d3-1457-4946-90dd-cd9fc8e8e88b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], "[", 
   StyleBox["file", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b5340269-24c8-6c4b-900a-ff95efeaa3f6"],
 "\[LineSeparator]loads a net from a file path directly. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"09cb5fba-0d1d-6542-90ff-8b7e354fcbf9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d0c8e07b-17ce-4747-b56a-5cc67ac3e431"],
 "\[LineSeparator]passes through an existing NetGraph or NetChain unchanged. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8aee1892-796c-c242-93c4-09ec8ed7b1d0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], 
   "[", "\"\<Clear\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "63472310-26d8-234f-ad6c-fc87c42cf6b9"],
 "\[LineSeparator]clears the session cache."
}], "Usage",
 CellChangeTimes->{{3.996656632197813*^9, 3.9966566323901043`*^9}},
 CellID->168578350,ExpressionUUID->"c829462c-5b96-4746-b36c-5f6c34a08d85"],

