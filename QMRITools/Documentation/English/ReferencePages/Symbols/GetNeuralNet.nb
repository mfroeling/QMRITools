Notebook[{

Cell[CellGroupData[{
Cell["GetNeuralNet", "ObjectName",
 CellID->162549914,ExpressionUUID->"7465df54-d4c0-bb4f-b4a1-9f9a41ea4192"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"60336317-c7a6-9443-a26f-2fb2b91c7363"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], "[", 
   StyleBox["name", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6f3cb767-5bbf-5447-91e8-1792daf364c6"],
 "\[LineSeparator]loads a pre-trained neural net by asset name. The net is \
cached within a session. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6278ba3d-82a4-8340-8bfb-d4ba1be2ae0d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], "[", 
   StyleBox["file", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6f6090e9-cc0f-2e44-82d6-c17578c0e6ae"],
 "\[LineSeparator]loads a net from a file path directly. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ae805fee-cbe5-ea4d-8f59-34f6278b9378"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d32dd2d4-2073-804d-9ee9-61f55e5e235e"],
 "\[LineSeparator]passes through an existing NetGraph or NetChain unchanged. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"80d118d4-1f03-ba4b-8894-a70f1f94e6f4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], 
   "[", "\"\<Clear\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "c58f5fa9-8070-aa4d-9e83-02aa5f3c86a0"],
 "\[LineSeparator]clears the session cache."
}], "Usage",
 CellChangeTimes->{{3.998533224927227*^9, 3.9985332252071896`*^9}},
 CellID->221418701,ExpressionUUID->"1e437a07-5ace-eb48-ac24-3586984f12f2"],

