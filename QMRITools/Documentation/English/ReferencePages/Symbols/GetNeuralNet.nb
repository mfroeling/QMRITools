Notebook[{

Cell[CellGroupData[{
Cell["GetNeuralNet", "ObjectName",
 CellID->88993828,ExpressionUUID->"3962fe9f-77d4-1343-b001-453631004503"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8052733f-c375-494e-90c6-8fe6464a3774"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], "[", 
   StyleBox["name", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "753c3902-7d05-da40-aae0-8a6dc80d296a"],
 "\[LineSeparator]loads a pre-trained neural net by asset name. The net is \
cached within a session. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b32bd97d-2ecf-9d40-8dc6-3715ddc1e99e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], "[", 
   StyleBox["file", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "37e9cfef-b4af-664f-b11c-15863273caf1"],
 "\[LineSeparator]loads a net from a file path directly. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"707493ac-e237-5749-9417-d59d6c53d453"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0d8c3463-b571-bf4f-ba81-4bd1457a8008"],
 "\[LineSeparator]passes through an existing NetGraph or NetChain unchanged. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6e2f5125-0fb4-e245-906b-bcbb884b875e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetNeuralNet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetNeuralNet"], 
   "[", "\"\<Clear\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "eef7110c-3e56-7046-9655-a8ae99406d67"],
 "\[LineSeparator]clears the session cache."
}], "Usage",
 CellChangeTimes->{{4.003804529361904*^9, 4.0038045295508633`*^9}},
 CellID->338238888,ExpressionUUID->"ea33a0aa-4146-3e44-871f-a6d0b929863d"],

