Notebook[{

Cell[CellGroupData[{
Cell["FindOutliers", "ObjectName",
 CellID->83382419,ExpressionUUID->"38ffa621-d0ff-554c-8b01-d9e4e98ef14e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1c311bde-7dee-4848-805d-f70a5d52ee16"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindOutliers",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/FindOutliers"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fbea74ed-8d79-9840-8020-541285d442df"],
 "\[LineSeparator]finds the outliers of a list of data."
}], "Usage",
 CellChangeTimes->{3.9966566359306717`*^9},
 CellID->259916190,ExpressionUUID->"8f1b347e-69ed-c544-a5d8-f0a448781a24"],

Cell["The following options can be given: ", "Notes",
 CellID->577301349,ExpressionUUID->"0adea2d5-097a-2045-bee8-83eb6f799775"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d5246ffa-972f-8c40-a78b-ad81e9dde516"], 
    ButtonBox["OutlierMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/OutlierMethod"], "\"\<IQR\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["OutlierMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OutlierMethod"]], "InlineFormula",
      ExpressionUUID->"63da2475-324e-7643-bc90-094f02269067"],
     " is an option for ",
     Cell[BoxData[
     "FindOutliers"], "InlineFormula",ExpressionUUID->
      "30bc6776-6f25-6a47-a3e9-dcff6ee7728f"],
     ". values can be \"IQR\", \"SIQR\" or \"aIQR\". \"IRQ\" is used for \
normally distributed data, \"SIQR\" or \"aIQR\" are better for skewed \
distributions."
    }], "TableText",ExpressionUUID->"e650aca7-77d3-9f41-b834-39986b29f896"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5b80cc6f-d55f-2749-8ba2-c205e220d1e8"], 
    ButtonBox["OutlierOutput",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/OutlierOutput"], "\"\<Mask\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["OutlierOutput",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OutlierOutput"]], "InlineFormula",
      ExpressionUUID->"48b1fe11-ba8f-884e-bb16-b462c77634b0"],
     " is an option for ",
     Cell[BoxData[
     "FindOutliers"], "InlineFormula",ExpressionUUID->
      "76f8a125-fd2d-4e49-b8bf-7aaf09f35b64"],
     ". If value is \"",
     Cell[BoxData[
      ButtonBox["Mask",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Mask"]], "InlineFormula",
      ExpressionUUID->"a4229744-71dd-ac40-ad68-c726417d8a46"],
     "\" it gives a list of 1 for data and 0 for outliers. Else the output is \
{data, outliers}."
    }], "TableText",ExpressionUUID->"62f8b7a6-ac53-5d48-8bec-9de33d6b6351"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f91c7f22-7425-e945-9d22-380a6cdb695b"], 
    ButtonBox["OutlierIterations",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/OutlierIterations"], "1", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["OutlierIterations",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OutlierIterations"]], 
      "InlineFormula",ExpressionUUID->"ec127bde-6d2b-cf42-86f0-e60cd924e028"],
     " is an option for ",
     Cell[BoxData[
     "FindOutliers"], "InlineFormula",ExpressionUUID->
      "7cf2509d-5a20-d743-8f4a-0ab095adbc4b"],
     ". Specifies how many iterations are used to find the outliers. \nEach \
iteration the outliers are reevaluated on the data with the previously found \
outliers already rejected."
    }], "TableText",ExpressionUUID->"ca51ca99-47e0-264f-888d-9de64a313525"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4d302b93-4936-614c-9b4c-62e6c34eb1cb"], 
    ButtonBox["OutlierRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/OutlierRange"], "1.5", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["OutlierRange",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OutlierRange"]], "InlineFormula",
      ExpressionUUID->"8504c413-cd3e-e442-a657-9c2af621dea0"],
     " is an option for ",
     Cell[BoxData[
     "FindOutliers"], "InlineFormula",ExpressionUUID->
      "ad38e94a-2d1c-3a4b-bc84-05161aaaebf1"],
     ". Specifies how many times the IQR is considered an outlier."
    }], "TableText",ExpressionUUID->"c35456a8-f9a7-3744-98db-c5a7c46a960c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "482bbcb9-6868-bb49-a5c6-17b997a27c14"], 
    ButtonBox["OutlierIncludeZero",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/OutlierIncludeZero"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["OutlierIncludeZero",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OutlierIncludeZero"]], 
      "InlineFormula",ExpressionUUID->"def3b3be-645b-7c45-9cb4-aa23dec429dc"],
     " is an option for ",
     Cell[BoxData[
     "FindOutliers"], "InlineFormula",ExpressionUUID->
      "1f530344-6e8f-0b43-a6e0-9f5e52f13648"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "f9224cc5-13ba-f045-af52-a2dfcc3d310a"],
     " all values that are zero are ignored and considered outliers."
    }], "TableText",ExpressionUUID->"d1d55402-4d1b-984b-9d86-a404b283de76"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d3b8a317-4cf6-9c49-b472-f66ed46e2955"], 
    ButtonBox["OutlierCheckNormality",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/OutlierCheckNormality"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["OutlierCheckNormality",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OutlierCheckNormality"]], 
      "InlineFormula",ExpressionUUID->"3745ef9a-e1e9-de48-9e90-3f46da4ea711"],
     " is an option for ",
     Cell[BoxData[
     "FindOutliers"], "InlineFormula",ExpressionUUID->
      "07c92e0b-b7a6-1949-8624-6c7e99112200"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "8469566b-14d5-b842-9b56-828545d091ed"],
     " the data is checked for normality using the ",
     Cell[BoxData[
      ButtonBox["Distribution",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Distribution"]], "InlineFormula",
      ExpressionUUID->"ff9f9baa-f4f3-9c47-bd8f-f230ed2519c5"],
     "FitTest function. \nIf the data is not normal the data is log \
transformed before outlier detection."
    }], "TableText",ExpressionUUID->"8990ca0d-5cce-f241-9c57-c11a88752c91"]}
  }]], "3ColumnTableMod",
 CellID->54915085,ExpressionUUID->"f3cc11f0-1a83-1e48-a4ca-903fa44b7dbb"]
}, Open  ]],

