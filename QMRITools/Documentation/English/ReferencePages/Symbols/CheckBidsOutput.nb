Notebook[{

Cell[CellGroupData[{
Cell["CheckBidsOutput", "ObjectName",
 CellID->437518610,ExpressionUUID->"40434b8c-2e3c-2547-b3b2-ed07f1261b00"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c0e53198-0284-4a4f-ad9e-1142ee5489e7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckBidsOutput",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/CheckBidsOutput"], "[", 
   RowBox[{
    StyleBox["dir", "TI"], ",", 
    StyleBox["step", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "097f34e2-4b3a-0d4d-b3e3-dd315daca637"],
 "\[LineSeparator]checks for each subject if the output expected from the \
config file in ",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",ExpressionUUID->
  "0c7ee3c1-c4b3-764c-b985-b5331dce8d81"],
 " is present after the given ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "33b1cadf-cbf2-1f42-b659-d64024032d1b"],
 ". Currently ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "c38ab70d-9c08-e740-8485-1090fdcff21a"],
 " can be \"Convert\", which checks for each Label if the json and nii files \
are present in the rawData folder. Missing files are highlighted and can be \
shown only using the checkbox."
}], "Usage",
 CellChangeTimes->{{4.003804497733595*^9, 4.003804497817095*^9}},
 CellID->7337704,ExpressionUUID->"b29c4bf9-f6b2-0e42-a7bd-628127a93114"],

