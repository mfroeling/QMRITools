Notebook[{

Cell[CellGroupData[{
Cell["CheckBidsOutput", "ObjectName",
 CellID->11309635,ExpressionUUID->"21b2abcd-6bbe-1745-952e-8f25ab970fce"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"47f546e7-5641-394b-b386-3b43a69f812c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckBidsOutput",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/CheckBidsOutput"], "[", 
   RowBox[{
    StyleBox["dir", "TI"], ",", 
    StyleBox["step", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e426a35c-7050-be47-9443-84939df3ea8a"],
 "\[LineSeparator]checks for each subject if the output expected from the \
config file in ",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",ExpressionUUID->
  "ddbdef43-19b3-b641-9a15-73ccaea8b829"],
 " is present after the given ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "9101beb3-a955-b44e-ab39-c313f124f41e"],
 ". Currently ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "6ef260ec-6238-2f46-8d72-b8d3f5bc1df9"],
 " can be \"Convert\", which checks for each Label if the json and nii files \
are present in the rawData folder. Missing files are shown in red and can be \
shown only using the checkbox."
}], "Usage",
 CellChangeTimes->{{4.0022647279581623`*^9, 4.002264728025326*^9}},
 CellID->10380432,ExpressionUUID->"8e4488f1-f4c6-274a-a9c1-256f77a283fe"],

Cell["The following options can be given: ", "Notes",
 CellID->520987433,ExpressionUUID->"d8d4d87b-c40a-b543-9f7a-71d55baa8ef9"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "71f5c287-48b9-e64e-9e03-7a9c5d66a3e2"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell["\<\
ProcessSubjects is an option for Bids functions. Can be a list of bids \
subject names else it is All.\
\>", "TableText",ExpressionUUID->"b58343a4-e395-e54f-ad26-79d717a36702"]}
  }]], "3ColumnTableMod",
 CellID->679726433,ExpressionUUID->"ffe7f0b2-e146-dd4f-bf9f-b8fdb55f181d"]
}, Open  ]],

