       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "2988dc21-5f5e-fe44-94cb-f25fb8f0d983"],
     "."
    }], "TableText",ExpressionUUID->"cc73db41-cd5c-d743-8e69-ef109e4363c2"]}
