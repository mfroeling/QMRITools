Cell["MuscleBidsConvert", "ObjectName",
 CellID->393198978,ExpressionUUID->"13dc78c4-60bc-ae45-9ba1-29b649a2ea4c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9b2afbde-35a5-2145-a570-e7db3f26b33b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsConvert",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsConvert"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0524cad8-b8bf-f843-ad0b-14c6fee8eed7"],
 "\[LineSeparator]converts all raw nii data in the to Muscle-Bids named nii \
based on the config file in the bids sourceFolder dir."
}], "Usage",
 CellChangeTimes->{3.9966556874618626`*^9},
 CellID->571607208,ExpressionUUID->"d6410266-f9c3-5a40-9ca1-81be0322cd96"],

