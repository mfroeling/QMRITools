Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"82e4a39a-5e55-184a-9576-ea993e549c72"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeHammingFilter",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/MakeHammingFilter"], 
   "[", 
   StyleBox["xdim", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d98af607-3528-c64a-9ed9-b499ef822c82"],
 "\[LineSeparator]makes a 1D HammingKernel for filtering k-space. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6f573788-da9c-0749-af8b-801247ac0bcd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeHammingFilter",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/MakeHammingFilter"], 
