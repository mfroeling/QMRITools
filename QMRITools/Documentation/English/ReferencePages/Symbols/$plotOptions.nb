Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "8d31825c-206f-294f-93fd-333bfce02433"], 
    ButtonBox["Axes",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell["\<\
Axes is an option for graphics functions that specifies whether axes should \
be drawn. \
\>", "TableText",ExpressionUUID->"899e3655-5b3a-714f-a2d7-b244a3e2e0cf"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "69d0686c-f741-ed46-a66c-665fd618216c"], 
    ButtonBox["Frame",
     BaseStyle->"Link"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"True", ",", " ", "False"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"True", ",", " ", "False"}], "}"}]}], "}"}], Cell["\<\
Frame is an option for Graphics, Grid, and other constructs that specifies \
whether to include a frame. \
\>", "TableText",ExpressionUUID->"4c068472-60eb-ea41-aca4-41683afd41a1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1ff30dd7-ef83-1942-a6b8-5525216ae553"], 
    ButtonBox["PlotHighlighting",
     BaseStyle->"Link"], 
    ButtonBox["None",
     BaseStyle->"Link"], Cell["\<\
PlotHighlighting is an option to Plot, ListPlot and related visualization \
functions that specifies how points and curves should be highlighted. \
\>", "TableText",ExpressionUUID->"ade1232a-b5a6-7844-bfc4-20220c4729ff"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "05bc8083-edd7-1b4a-814c-ae14ee5113d7"], 
    ButtonBox["FrameStyle",
     BaseStyle->"Link"], 
    RowBox[{"Directive", "[", 
     RowBox[{
      RowBox[{"Thickness", "[", "Large", "]"}], ",", " ", 
      RowBox[{"LightDarkSwitched", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0", "]"}], ",", " ", 
        RowBox[{"GrayLevel", "[", "1", "]"}]}], "]"}]}], "]"}], Cell["\<\
FrameStyle is an option for Graphics, Grid, and other constructs that \
specifies the style in which to draw frames.\
\>", "TableText",ExpressionUUID->"a7537668-cf08-144b-9dea-37ab5c0f7ee4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
