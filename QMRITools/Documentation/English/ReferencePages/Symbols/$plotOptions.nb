Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0db9be79-e1e9-ea4e-8464-d3e0e5427227"], 
    ButtonBox["Axes",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell["\<\
Axes is an option for graphics functions that specifies whether axes should \
be drawn. \
\>", "TableText",ExpressionUUID->"33f65639-b8f2-df48-bcde-be522abdc7b7"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "850870c6-9eb6-8b4a-b589-0be5057fe576"], 
    ButtonBox["Frame",
     BaseStyle->"Link"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"True", ",", " ", "False"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"True", ",", " ", "False"}], "}"}]}], "}"}], Cell["\<\
Frame is an option for Graphics, Grid, and other constructs that specifies \
whether to include a frame. \
\>", "TableText",ExpressionUUID->"71a8af49-a0ba-d243-8977-2ce0edfa736d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "37025d19-3981-2a4e-8482-63399f84aa88"], 
    ButtonBox["PlotHighlighting",
     BaseStyle->"Link"], 
    ButtonBox["None",
     BaseStyle->"Link"], Cell["\<\
PlotHighlighting is an option to Plot, ListPlot and related visualization \
functions that specifies how points and curves should be highlighted. \
\>", "TableText",ExpressionUUID->"39af2cda-492d-df4a-ae35-8ae7b39c6723"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a4ac9903-e0c2-1242-8dcc-0ed10ed9bfb7"], 
    ButtonBox["FrameStyle",
     BaseStyle->"Link"], 
    RowBox[{"Directive", "[", 
     RowBox[{
      RowBox[{"Thickness", "[", "Large", "]"}], ",", " ", 
      RowBox[{"LightDarkSwitched", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0", "]"}], ",", " ", 
        RowBox[{"GrayLevel", "[", "1", "]"}]}], "]"}]}], "]"}], Cell["\<\
FrameStyle is an option for Graphics, Grid, and other constructs that \
specifies the style in which to draw frames.\
\>", "TableText",ExpressionUUID->"d5bf5c46-ef86-974b-aaf2-1568c08dfd9e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "99498392-71a4-4546-ad2a-0d74648e0f69"], 
    ButtonBox["LabelStyle",
     BaseStyle->"Link"], 
    RowBox[{"Directive", "[", 
