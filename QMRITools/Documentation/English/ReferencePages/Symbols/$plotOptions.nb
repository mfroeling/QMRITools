        RowBox[{"GrayLevel", "[", "0", "]"}], ",", " ", 
        RowBox[{"GrayLevel", "[", "1", "]"}]}], "]"}], ",", " ", "Bold", ",", 
      " ", "14"}], "]"}], Cell["\<\
