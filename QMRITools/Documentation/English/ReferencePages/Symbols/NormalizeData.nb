Cell[CellGroupData[{
Cell["NormalizeData", "ObjectName",
 CellID->332728220,ExpressionUUID->"af49627d-995b-154a-b84e-d08f633da0e8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"23d43115-9d0b-2e4a-954c-7e3dea099153"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NormalizeData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/NormalizeData"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "4000cd98-4ce4-3f4e-93cb-1212f7d438b8"],
 "\[LineSeparator]normalizes the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "b1147419-07c5-ec47-b351-17b1b8df24a5"],
 " to the mean signal of the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "d0b022b6-0508-4f4d-86ef-296d4cc297db"],
 ". For 4D ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "d9a9d188-a97d-a845-9779-108732a9e23f"],
 " it normalizes to the first volume of the 4th dimension. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b6c8ae94-ac43-844a-986d-27efa38d28db"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NormalizeData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/NormalizeData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "173cc79c-f3cf-b549-8933-242d9bd5f258"],
 "\[LineSeparator]normalizes the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "fc85dc07-cb6f-374c-a950-d81f89310f37"],
 " based on the mean signal only within the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "cc90ae4f-d6b4-5c45-8e52-efc9c3f0979f"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9966563905075016`*^9, 3.996656390680147*^9}},
 CellID->51066127,ExpressionUUID->"66f3ca47-8b80-2b45-b60c-149d0625ce9e"],

Cell["The following options can be given: ", "Notes",
 CellID->127669269,ExpressionUUID->"8ef6a6e7-c5c3-af46-9f4f-2bf62e83cc7a"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bfdbe4f4-4ce2-c842-b075-d3442c4fa931"], 
    ButtonBox["NormalizeMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NormalizeMethod"], "\"\<Set\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["NormalizeMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NormalizeMethod"]], "InlineFormula",
      ExpressionUUID->"a253d900-d80b-2042-b003-a0343ee6f8d1"],
     " is an option for ",
     Cell[BoxData[
     "NormalizeData"], "InlineFormula",ExpressionUUID->
      "d2699a3a-4948-3d40-9aa1-5d881746911b"],
     ". Can be \"Set\" or \"Volumes\" which normalizes to the first volume or \
normalizes each volume individually, respectively.\nIf \"Uniform\" normalizes \
the histogram of the data to have a uniform distribution between 0 and 1 \
where 0 is treated as background of the data."
    }], "TableText",ExpressionUUID->"40ade04c-8da9-0c4b-aab5-ca970c90c5a7"]}
