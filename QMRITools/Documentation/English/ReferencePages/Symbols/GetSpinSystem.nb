Notebook[{

Cell[CellGroupData[{
Cell["GetSpinSystem", "ObjectName",
 CellID->97821619,ExpressionUUID->"1677090f-b99b-6448-af9e-e41aabcf880d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c68617d8-7368-6447-9d69-cb849290d39e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetSpinSystem",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/GetSpinSystem"], "[", 
   StyleBox["name", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "40fb9e4f-a7dc-7047-b62c-8c0a7e8d235d"],
 "\[LineSeparator]get a spin system that can be used in ",
 Cell[BoxData[
  ButtonBox["SimHamiltonian",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SimHamiltonian"]], "InlineFormula",
  ExpressionUUID->"40b07c42-6bc7-d046-ad75-5cf26e654fcb"],
 ". Current implements systems are \"glu\", \"lac\", \"gaba\", \"fatGly\", \
\"fatAll\", \"fatEnd\", \"fatDouble\", \"fatStart\", and \"fatMet\"."
}], "Usage",
 CellChangeTimes->{3.996656405980444*^9},
 CellID->32852741,ExpressionUUID->"84d0905c-77f5-d849-836a-0bb50ab33e84"],

Cell["The following options can be given: ", "Notes",
 CellID->420290539,ExpressionUUID->"a7f39fe6-4832-b446-adc6-34310dcc85ef"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9b31a8c9-557d-fe48-9ae9-5ffad96d4490"], 
    ButtonBox["CenterFrequency",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/CenterFrequency"], "0", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["CenterFrequency",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CenterFrequency"]], "InlineFormula",
      ExpressionUUID->"3aa6d9ec-0823-8346-9e56-9053bf960e65"],
     " is an option for ",
     Cell[BoxData[
     "GetSpinSystem"], "InlineFormula",ExpressionUUID->
      "ccc3293c-4488-2645-8d5d-6d2ebcdd1dac"],
     " and defines the center frequency in ppm."
    }], "TableText",ExpressionUUID->"d171a926-8265-154c-a4ea-9d9d415c9f3f"]}
  }]], "3ColumnTableMod",
 CellID->175900928,ExpressionUUID->"4a638aaf-dfc2-fe41-a5b8-2859c43240da"]
}, Open  ]],

