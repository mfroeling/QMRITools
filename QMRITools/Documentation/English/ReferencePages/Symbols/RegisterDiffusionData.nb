Cell[CellGroupData[{
Cell["RegisterDiffusionData", "ObjectName",
 CellID->30762088,ExpressionUUID->"214f9ed1-aba8-5f4d-8a7c-aeb17ea80112"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3c1ee644-3d74-2e44-a543-6c9f549f253a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDiffusionData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterDiffusionData"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dtiData", "TI"], ",", 
     StyleBox["vox", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "d1c5f4c5-44eb-7f48-afd9-91e6b653b6bc"],
 "\[LineSeparator]registers a diffusion dataset. dtiData should be 4D {slice, \
diff, x, y}. vox is the voxel size of the data. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e62997fe-6d68-7741-b84a-84912ceeb464"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDiffusionData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterDiffusionData"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dtiData", "TI"], ",", 
     StyleBox["dtiMask", "TI"], ",", 
     StyleBox["vox", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "02d514e4-c2b8-de44-94f3-6052182e221f"],
 "\[LineSeparator]registers the data series using the given voxel size only \
using data within the mask. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2eae3a4c-6b37-a443-b400-ff80b2077850"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDiffusionData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterDiffusionData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["dtiData", "TI"], " ", ",", 
      StyleBox["vox", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["anatData", "TI"], ",", 
      StyleBox["voxAnat", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"77b6b625-db10-ea4a-8e13-670c373ce28d"],
 "\[LineSeparator]registers a diffusion dataset. The diffusion data is also \
registered to the anatData. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"5e84925b-18b4-9b46-8c16-41e46abe24f6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDiffusionData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterDiffusionData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["dtiData", "TI"], ",", 
      StyleBox["dtiMask", "TI"], ",", 
      StyleBox["vox", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["anatData", "TI"], ",", 
      StyleBox["voxAnat", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"0e27b611-0976-1348-89f6-d425a6277b75"],
 "\[LineSeparator]registers the data series using the given voxel size only \
using data within the mask. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d5ec8a1a-423e-eb45-a87f-0eea93e638e8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDiffusionData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterDiffusionData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["dtiData", "TI"], ",", 
      StyleBox["vox", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["anatData", "TI"], ",", 
      StyleBox["anatMast", "TI"], ",", 
      StyleBox["voxAnat", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"5664dccf-45bc-184a-8394-b42b1452e3a0"],
 "\[LineSeparator]registers the data series using the given voxel size only \
using data within the mask. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1acb9cca-186b-0446-ba92-7761a85c5648"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDiffusionData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterDiffusionData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["dtiData", "TI"], ",", 
      StyleBox["dtiMask", "TI"], ",", 
      StyleBox["vox", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["anatData", "TI"], ",", 
      StyleBox["anatMast", "TI"], ",", 
      StyleBox["voxAnat", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"8ef2df3e-77f4-d34d-9f5c-2d5e12db08fe"],
 "\[LineSeparator]registers the data series using the given voxel size only \
using data within the mask. Output is the registered dtiData and, if anatData \
is given, the registered dtiData in anatomical space. If ",
 Cell[BoxData[
  ButtonBox["OutputTransformation",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/OutputTransformation"]], "InlineFormula",
  ExpressionUUID->"a5648a68-b15d-e249-aaca-603d8bc09ebc"],
 " is ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "76512ec4-5e13-7b41-82e3-d74414beef94"],
 " it also outputs the translation, rotation scale and skew of all images or \
volumes."
}], "Usage",
