Notebook[{

Cell[CellGroupData[{
Cell["SettingSchedule", "ObjectName",
 CellID->103608870,ExpressionUUID->"10903636-606f-0942-ae05-e21b9537e14e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e71288a6-c1f4-aa48-b306-1fdf3bb06336"],
 Cell[BoxData[
 "SettingSchedule"], "InlineFormula",ExpressionUUID->
  "2dd7467c-4e6e-8f46-8bca-097f2f98f344"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["MakeUnet",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
  ExpressionUUID->"9b51b9b9-6593-8745-9334-64d6eafab934"],
 ". It defines the settings for the Unet blocks. If one setting is given it \
applied to all layers. If a list of settings is given the settings can be \
different per layer. The following settings are the default settings. \
\"Unet\": convolution block repetitions, 2, ",
 Cell[BoxData[
  RowBox[{"\"\<ResNet\>\"", "\[Rule]", "convolution"}]], "InlineFormula",
  ExpressionUUID->"659b8206-4ed3-2e48-83a5-77a66c5f6d5d"],
 " block repetitions, 2, ",
 Cell[BoxData[
  RowBox[{"\"\<DenseNet\>\"", "\[Rule]", 
   RowBox[{"{", "dense"}]}]], "InlineFormula",ExpressionUUID->
  "b1331dcc-24ab-ba4d-976e-9df479a27053"],
 " depth, block repetitions}, {4,2}, ",
 Cell[BoxData[
  RowBox[{"\"\<Inception\>\"", "\[Rule]", 
   RowBox[{"{", "inception"}]}]], "InlineFormula",ExpressionUUID->
  "aa92004d-c40a-a640-a575-4b80602cdf64"],
 " width, block repetitions}, {4,2}, \"U2Net\"-> {Unet depth, downscale}, {5, \
",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "e5c27e39-b123-ba4f-b918-2a8de01df3c0"],
 "}."
}], "Usage",
 CellChangeTimes->{3.9985332735763073`*^9},
 CellID->27449315,ExpressionUUID->"e9523956-2fab-d84f-9991-e0c124119228"],

