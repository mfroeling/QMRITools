Notebook[{

Cell[CellGroupData[{
Cell["SettingSchedule", "ObjectName",
 CellID->33065077,ExpressionUUID->"f9feb19a-ca9a-4a4b-9150-4eb6c6809c09"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"adddb486-2a74-884e-93b7-9e610a31d243"],
 Cell[BoxData[
 "SettingSchedule"], "InlineFormula",ExpressionUUID->
  "7f35caae-5a71-6f4f-ab47-57e4acadd3af"],
 "\[LineSeparator]is an option for MakeUnet. It defines the settings for the \
Unet blocks. If one setting is given it applied to all layers. If a list of \
settings is given the settings can be different per layer. The following \
settings are the default settings. \"Unet\": convolution block repetitions, \
2, ",
 Cell[BoxData[
  RowBox[{"\"\<ResNet\>\"", "\[Rule]", "convolution"}]], "InlineFormula",
  ExpressionUUID->"41fa533a-12b6-bf43-b659-d69335056913"],
 " block repetitions, 2, ",
 Cell[BoxData[
  RowBox[{"\"\<DenseNet\>\"", "\[Rule]", 
   RowBox[{"{", "dense"}]}]], "InlineFormula",ExpressionUUID->
  "353ae892-fa94-e443-a1de-79038b126d51"],
 " depth, block repetitions}, {4,2}, ",
 Cell[BoxData[
  RowBox[{"\"\<Inception\>\"", "\[Rule]", 
   RowBox[{"{", "inception"}]}]], "InlineFormula",ExpressionUUID->
  "e64e0cf0-90ed-3944-a584-13614bfa4aee"],
 " width, block repetitions}, {4,2}, \"U2Net\"-> {Unet depth, downscale}, {5, \
",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "2ce81c9c-4fe0-eb4d-a988-b92708988520"],
 "}."
}], "Usage",
 CellChangeTimes->{4.003804578484478*^9},
 CellID->163527996,ExpressionUUID->"5a4bfa74-c985-5c41-b278-89fcfa1cbf24"],

