Notebook[{

Cell[CellGroupData[{
Cell["UseVersion", "ObjectName",
 CellID->438977624,ExpressionUUID->"6fd59f99-cd75-7f4d-9289-835a20b312b2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f48480e7-7136-2f4f-bd33-907d49428ed5"],
 Cell[BoxData[
 "UseVersion"], "InlineFormula",ExpressionUUID->
  "99215d48-0797-db44-9bb5-ecb4f8534ee5"],
 "\[LineSeparator]is an option for DcmToNii. For windows it allows to switch \
between different versions of dcm2niix.exe. Set to 1 for the default bundled \
version, an integer matching a dated \"DcmToNii-<version>\" asset (e.g. 25 \
for dcm2niix-20250506.exe), or \"Own\" for a custom dcm2niix-own.exe build \
registered as the \"DcmToNii-Own\" asset in PacletInfo.wl."
}], "Usage",
 CellID->263741240,ExpressionUUID->"d20ecd75-cc6d-9a45-b0ac-94bae331b5c1"],

