Cell["ExportTCK", "ObjectName",
 CellID->272929819,ExpressionUUID->"1ecb63e1-1c0d-fc4d-8028-b64f35d3b45b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b0e63e83-69e7-234d-b06b-c953b86687f5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportTCK",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/ExportTCK"], "[", 
   RowBox[{
    StyleBox["file", "TI"], ",", 
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "66753a73-c89a-1b41-bdfb-e65794579289"],
 "\[LineSeparator]exports the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "0b4f1de2-7156-d740-9da6-95b13fe6ac83"],
 " to the given *.tck ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "88a829c4-51af-0b43-a90f-9de47cace9b9"],
 " and automatically generates the ",
 Cell[BoxData[
  StyleBox["header", "TI"]], "InlineFormula",ExpressionUUID->
  "0f02776a-44f1-e04c-971c-52cdcc11fbb4"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b58bcbe4-8e51-e443-9fa9-38d2a188a0af"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExportTCK",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/ExportTCK"], "[", 
   RowBox[{
    StyleBox["file", "TI"], ",", 
    StyleBox["tracts", "TI"], ",", 
    StyleBox["header", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a5bc23d9-0397-b947-8af0-e4fb198cfb13"],
 "\[LineSeparator]exports the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "6a851269-70d7-1d4c-954f-3c48e3f60326"],
 " to the given *.tck ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "77e5d5c8-2eaa-e74d-b45d-bb910f25201b"],
 ". The ",
 Cell[BoxData[
  StyleBox["header", "TI"]], "InlineFormula",ExpressionUUID->
  "452948c9-2244-aa47-b99e-5caeceffd1a7"],
 " can be the ",
 Cell[BoxData[
  StyleBox["header", "TI"]], "InlineFormula",ExpressionUUID->
  "8f635d85-ee5d-f54b-abed-7da827a536eb"],
 " string or the ",
 Cell[BoxData[
  StyleBox["header", "TI"]], "InlineFormula",ExpressionUUID->
  "9ace0b9d-a8d5-aa4c-93a4-8d888d069df6"],
 " association as given by ",
 Cell[BoxData[
  ButtonBox["ImportTCK",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ImportTCK"]], "InlineFormula",
  ExpressionUUID->"2daeb283-81af-4a41-923d-7e5009a32a34"],
