 "\[LineSeparator]generates images from the ",
 Cell[BoxData[
  StyleBox["imgData", "TI"]], "InlineFormula",ExpressionUUID->
  "915a928d-4b64-8644-8c96-ddd541a74360"],
 " which is obtained form ",
