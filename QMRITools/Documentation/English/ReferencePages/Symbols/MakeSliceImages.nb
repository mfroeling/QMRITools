   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetSliceData"]], "InlineFormula",
  ExpressionUUID->"0e573e59-63aa-bb44-8551-a546b126e995"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"226fc7b0-9d0e-2d46-ad1a-c842813eda1d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeSliceImages",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsPlottingTools/ref/MakeSliceImages"], "[", 
   RowBox[{
    StyleBox["imgData", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "45bc1342-ef16-7a47-bb40-8eded20e20bb"],
 "\[LineSeparator]generates images from the ",
 Cell[BoxData[
  StyleBox["imgData", "TI"]], "InlineFormula",ExpressionUUID->
  "305b502d-2d7e-614f-b331-4623b9a1af82"],
 " which is obtained form ",
 Cell[BoxData[
  ButtonBox["GetSliceData",
