Notebook[{

Cell[CellGroupData[{
Cell["PhaseShiftSpectra", "ObjectName",
 CellID->706159772,ExpressionUUID->"10339c85-1667-cf4e-be7e-73f825efa354"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"caaefb4f-eea4-7c42-be4e-219f21350e09"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    SubscriptBox[
     StyleBox["phi", "TI"], 
     StyleBox["0", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c5370b15-dfcd-994e-b790-bbc704cfe5d5"],
 "\[LineSeparator]applies the 0th order phase ",
 Cell[BoxData[
  StyleBox["phi0", "TI"]], "InlineFormula",ExpressionUUID->
  "c87b3636-0501-9e4f-ad44-dc9f1468614e"],
 " to the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "0775a5b9-87bb-3045-9a70-d8d96d7382f9"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"65b542e5-ce8e-1241-acfe-0a9a9541701b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    StyleBox["ppm", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    SubscriptBox[
     StyleBox["phi", "TI"], 
     StyleBox["1", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e452e021-ef7b-c44f-9701-d77db796cae4"],
 "\[LineSeparator]applies the 1st order phase ",
 Cell[BoxData[
  StyleBox["phi1", "TI"]], "InlineFormula",ExpressionUUID->
  "4a79c597-9c22-e24a-8045-c404b10e5c3e"],
 " to the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "af14018f-9a8c-5046-a13a-8eb0dee71bd5"],
 ". The ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "b54d14de-6cd8-f34e-9c83-447f2ad3265c"],
 " can be obtained using GetPpmRange and ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "933212e2-b8bc-2c46-890e-65a59cea6f9f"],
 " with GetGyro. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"42ed2196-18b5-214a-93d7-b4dd2cef559e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", 
    StyleBox["ppm", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["phi", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["phi", "TI"], 
       StyleBox["1", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"1bc76426-3e4c-cf46-8fcd-c9f263a6da18"],
 "\[LineSeparator]applies the 0th and 1st order phases {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "phi0"}], "TI"]], "InlineFormula",ExpressionUUID->
  "aea9f4f7-ec82-b14f-8d5a-4cbeb9a5c7b2"],
 "phi0, ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"phi1", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "fdd7ecb4-a30b-a647-9f71-12c2a27531bd"],
 " to the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "58a66fd9-794d-ac47-b7dd-028203f9767f"],
 ". The ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "8c30095d-9fcc-d840-a260-44c6f6873bd1"],
 " can be obtained using GetPpmRange and ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "d570e3f7-82fd-504e-bfff-8cf4fda7d0ec"],
 " with GetGyro. The 0th order phase ",
 Cell[BoxData[
  StyleBox["phi0", "TI"]], "InlineFormula",ExpressionUUID->
  "974b5fe1-338e-0347-a55e-10ca65a0e127"],
 " is in radians and the 1st order phase ",
 Cell[BoxData[
  StyleBox["phi1", "TI"]], "InlineFormula",ExpressionUUID->
  "8970982c-e312-4d40-b53d-4b01d51374b2"],
 " is in ms."
}], "Usage",
