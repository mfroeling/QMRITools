Cell[CellGroupData[{
Cell["PhaseShiftSpectra", "ObjectName",
 CellID->7006331,ExpressionUUID->"3e1f8f0e-89d9-8841-aa5d-f8173ffad3e9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"70a2e65f-73a4-464f-bf94-bdd5f07b826b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    SubscriptBox[
     StyleBox["phi", "TI"], 
     StyleBox["0", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2df3d4cb-2ea8-a04c-9e97-df1dfead6c1d"],
 "\[LineSeparator]applies the 0th order phase ",
 Cell[BoxData[
  StyleBox["phi0", "TI"]], "InlineFormula",ExpressionUUID->
  "515f96de-4237-fb4e-b187-ae93c381da03"],
 " to the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "7affefd6-7a6a-d145-8c1f-81968e664c96"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0bcefaaa-4b91-5140-8055-80de3c1b84a1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    StyleBox["ppm", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    SubscriptBox[
     StyleBox["phi", "TI"], 
     StyleBox["1", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4ee12f1c-7206-d84b-997d-f58e70179ea2"],
 "\[LineSeparator]applies the 1st order phase ",
 Cell[BoxData[
  StyleBox["phi1", "TI"]], "InlineFormula",ExpressionUUID->
  "4d7ac5b2-553a-fc49-96da-a2ade6b3d726"],
 " to the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "34d0abab-26b5-cc40-8462-7e49b83b7b9b"],
 ". The ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "f97ac803-85ca-6b4c-a6c3-4ee7877fcb9d"],
 " can be obtained using ",
 Cell[BoxData[
  ButtonBox["GetPpmRange",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetPpmRange"]], "InlineFormula",
  ExpressionUUID->"63073657-02b7-3845-b3b2-ed558112a181"],
 " and gyro with ",
 Cell[BoxData[
  ButtonBox["GetGyro",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetGyro"]], "InlineFormula",
  ExpressionUUID->"7c28e7e7-251b-214c-98f7-21ab601518dd"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"fdfacc82-73b5-e948-8f8c-c2f4d03410fc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", 
    StyleBox["ppm", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["phi", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["phi", "TI"], 
       StyleBox["1", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"6d135577-86fe-314f-82ed-01f296044383"],
 "\[LineSeparator]applies the 0th and 1st order phases {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "phi0"}], "TI"]], "InlineFormula",ExpressionUUID->
  "8e25618e-9630-c34a-b321-69cd9e5fcee5"],
 "phi0, ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"phi1", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "85cbdbda-5e5e-2145-84e0-612c171ecedf"],
 " to the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "74cf4f7b-795d-1f4a-a747-7f98bd7a3ca1"],
 ". The ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "04b5133c-a09e-2046-9121-eec2d6e3a7e2"],
 " can be obtained using ",
 Cell[BoxData[
  ButtonBox["GetPpmRange",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetPpmRange"]], "InlineFormula",
  ExpressionUUID->"b518fd09-18a9-0f4e-9e08-b134ec65016c"],
 " and gyro with ",
 Cell[BoxData[
  ButtonBox["GetGyro",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetGyro"]], "InlineFormula",
  ExpressionUUID->"3efe677e-b7ce-7f40-a64d-98310f9da4ec"],
 ". The 0th order phase phi0 is in radians and the 1st order phase phi1 is in \
ms."
}], "Usage",
