Notebook[{

Cell[CellGroupData[{
Cell["PhaseShiftSpectra", "ObjectName",
 CellID->193000689,ExpressionUUID->"f46d130d-397e-7244-a18e-963869a8c015"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9e437336-3f43-004f-ac1f-6f9f737d4fc2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    SubscriptBox[
     StyleBox["phi", "TI"], 
     StyleBox["0", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a298a044-c9f8-bd4e-a536-078be3ee3546"],
 "\[LineSeparator]applies the 0th order phase ",
 Cell[BoxData[
  StyleBox["phi0", "TI"]], "InlineFormula",ExpressionUUID->
  "fe7841cb-dae3-c247-ad08-1cad2f576a90"],
 " to the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "d12b87cb-4cc2-6d48-aabb-c9c6359dbca4"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"40a67894-337b-8045-8452-4041cd8f1c3f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    StyleBox["ppm", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    SubscriptBox[
     StyleBox["phi", "TI"], 
     StyleBox["1", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "30acfd29-cc72-3a45-b51c-56a37033d603"],
 "\[LineSeparator]applies the 1st order phase ",
 Cell[BoxData[
  StyleBox["phi1", "TI"]], "InlineFormula",ExpressionUUID->
  "cacbb380-1b2e-f44b-9e94-216d52589e92"],
 " to the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "a634c68c-47ad-404a-a443-f8f7b9918374"],
 ". The ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "67df3db1-0fc7-ef4b-9584-8dfd7c194fe7"],
 " can be obtained using GetPpmRange and ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "1a336a63-d37a-5448-ac4d-8b46f6db0a2f"],
 " with GetGyro. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4b4d84ad-8542-cc44-9c57-11ca225e59d8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", 
    StyleBox["ppm", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["phi", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["phi", "TI"], 
       StyleBox["1", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"ecba891a-f811-d340-a514-42b97fbaee44"],
 "\[LineSeparator]applies the 0th and 1st order phases {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "phi0"}], "TI"]], "InlineFormula",ExpressionUUID->
  "13818366-947b-1840-84fe-3544e06ea88b"],
 "phi0, ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"phi1", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "0e4dd498-f0f8-f941-be33-ff730a7772d9"],
 " to the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "cd6b5924-f1b7-8745-99a3-061df633cf09"],
 ". The ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "752d975e-042d-dd4e-bc2d-7c910bb619e3"],
 " can be obtained using GetPpmRange and ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "03113572-64e9-2844-8c7c-f247090686b8"],
 " with GetGyro. The 0th order phase ",
 Cell[BoxData[
  StyleBox["phi0", "TI"]], "InlineFormula",ExpressionUUID->
  "f0c66ef8-8cdf-4f44-9adb-52a895668f65"],
 " is in radians and the 1st order phase ",
 Cell[BoxData[
  StyleBox["phi1", "TI"]], "InlineFormula",ExpressionUUID->
  "3d5234fb-ccc2-a541-836e-7f824db4aa69"],
 " is in ms."
}], "Usage",
 CellChangeTimes->{{3.998533258029194*^9, 3.9985332587241*^9}},
