Notebook[{

Cell[CellGroupData[{
Cell["ClassifyData", "ObjectName",
 CellID->14119069,ExpressionUUID->"db27452f-1e54-3a47-b9f8-104136677c24"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6abe74a2-5861-a242-9a36-43659027b495"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ClassifyData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/ClassifyData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["method", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "eb0b980c-d066-874a-81db-c5544b0d6ff9"],
 "\[LineSeparator]classifies the input ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "aa150682-2197-264e-9d63-832bf79516c9"],
 " using the Body classification network. Method \"Body\" returns {side, \
positions}. Any ",
 Cell[BoxData[
  StyleBox["method", "TI"]], "InlineFormula",ExpressionUUID->
  "e4fac482-69c5-2d4c-b521-814513170464"],
 " containing \"Side\" returns the detected side only. Any other ",
 Cell[BoxData[
  StyleBox["method", "TI"]], "InlineFormula",ExpressionUUID->
  "1594f1b0-b4cc-044a-8a49-26ed23ef8a06"],
 " returns the raw network output."
}], "Usage",
 CellChangeTimes->{{3.9966566508143272`*^9, 3.99665665093091*^9}},
 CellID->90743282,ExpressionUUID->"d324a47a-76b7-124e-80f4-583dadaa607a"],

Cell["The following options can be given: ", "Notes",
 CellID->229128379,ExpressionUUID->"7c5c4f71-94f7-ae46-b94d-9e7109be8cb7"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c3b845b4-0457-5847-bb02-c1a55bd9a2ba"], 
    ButtonBox["TargetDevice",
     BaseStyle->"Link"], "\"\<CPU\>\"", Cell[
    "XXXX", "TableText",ExpressionUUID->
     "ec625bd5-718c-ac4a-a63b-9c69e5eea989"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2220aee6-3e07-2c45-8893-0f715025504d"], 
    ButtonBox["Monitor",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Monitor", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["mon", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
      "95a1023b-aac1-5b4c-b72c-6572f1f00fec"],
     " generates a temporary monitor cell in which the continually updated \
current value of ",
     Cell[BoxData[
      StyleBox["mon", "TI"]], "InlineFormula",ExpressionUUID->
      "4ac1c557-9a43-7c4e-812c-6d567250991d"],
     " is displayed during the course of evaluation of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "a9aa040f-380c-e64e-9df4-70c31a76eeab"],
     ". "
    }], "TableText",ExpressionUUID->"fa734cfc-92c9-be4b-8bc1-8eac8af75bb5"]}
  }]], "3ColumnTableMod",
 CellID->203385023,ExpressionUUID->"3d63c36f-c6e5-ed47-ad70-3ac115e40280"]
