Notebook[{

Cell[CellGroupData[{
Cell["CheckBidsSubjects", "ObjectName",
 CellID->222188,ExpressionUUID->"76ae5617-1397-1d48-bb51-2d5757720550"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dc3b89c1-fda2-2749-80c4-2b9e6fda9c21"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckBidsSubjects",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/CheckBidsSubjects"], "[", 
   RowBox[{
    StyleBox["dir", "TI"], ",", 
    StyleBox["subs", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e49e8762-58dd-8345-81b2-15d3acfcdc72"],
 "\[LineSeparator]gives for each subject name in ",
 Cell[BoxData[
  StyleBox["subs", "TI"]], "InlineFormula",ExpressionUUID->
  "ec972d87-7788-1342-bd42-8b0a5afb8b14"],
 " the sessions it selects in the dicom folders and the rawData folder of the \
config file in ",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",ExpressionUUID->
  "26e1b9c6-509f-c743-9d96-8b34445ce78e"],
 ", as sub-x_ses-y names, or an empty list when it selects none. The names \
are those of ProcessSubjects, for example the dicom folder name 001_1 or \
sub-001_ses-1. A name without session selects session 001. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0207f636-c4b5-c142-a284-f39612220d31"],
 "CheckBidsSubjects[dir,",
 Cell[BoxData[
  ButtonBox[
   ButtonBox["All",
    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "e3a403f4-266c-a64f-8477-f7792cf82a15"],
 "]\[LineSeparator]gives all sessions with the key ",
 Cell[BoxData[
  StyleBox["All", "TI"]], "InlineFormula",ExpressionUUID->
  "093e6dd0-4151-c248-bada-941d75f4ea30"],
 "."
}], "Usage",
 CellChangeTimes->{{4.0046866706598377`*^9, 4.004686670868374*^9}},
 CellID->230493496,ExpressionUUID->"39b70886-1c22-d84b-a6b6-4f775a24552f"],

