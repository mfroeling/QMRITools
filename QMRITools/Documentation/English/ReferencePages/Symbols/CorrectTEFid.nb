Cell[CellGroupData[{
Cell["CorrectTEFid", "ObjectName",
 CellID->34403330,ExpressionUUID->"8dc5a050-82bd-e247-8254-90cc745eccdd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"331fd433-5be2-bd42-bd2d-74eeefee07ab"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CorrectTEFid",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/CorrectTEFid"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["dw", "TI"], ",", 
    StyleBox["te", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c37550e9-2fec-1d44-b204-564438b4c7eb"],
 "\[LineSeparator]corrects the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "11870614-5cda-cd4d-a515-510ff5c48b8b"],
 " for 1st order phase by extrapolating the missing FID samples in the TE \
using Hankel matrix SVD analysis. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"de6ceef6-af18-d84e-a20a-7e16d4ad043c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CorrectTEFid",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/CorrectTEFid"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["dw", "TI"], ",", 
    StyleBox["te", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["ppmRan", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "580d2529-a545-7c46-8262-f3c68a7dbe44"],
 "\[LineSeparator]corrects the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "664f01c7-9fbe-154d-a18a-b6cacb291404"],
 " for 1st order phase by extrapolating the missing FID samples in the TE \
using Hankel matrix SVD analysis. Only the part of the spectra in the ",
 Cell[BoxData[
  StyleBox["ppmRan", "TI"]], "InlineFormula",ExpressionUUID->
  "c38080a0-9cd1-f745-9645-204576704770"],
 " is used for optimization."
}], "Usage",
 CellChangeTimes->{{3.9966566490364857`*^9, 3.996656649191204*^9}},
