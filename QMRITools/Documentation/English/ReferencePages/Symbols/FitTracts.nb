      ButtonBox["FittingOrder",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/FittingOrder"]], "InlineFormula",
      ExpressionUUID->"4ce0283c-e81f-ad41-b6be-126d19d563de"],
     " is an option for ",
     Cell[BoxData[
     "FitTracts"], "InlineFormula",ExpressionUUID->
      "eddf8e2c-346f-4548-9391-fdcc201b6993"],
