Cell[CellGroupData[{
Cell["FitTracts", "ObjectName",
 CellID->457941821,ExpressionUUID->"2eb163cc-c3b3-a643-9fec-803f75798529"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ea6fe534-52dd-3e45-a5b9-55f1b8397cb8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FitTracts",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/FitTracts"], "[", 
   StyleBox["tract", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "21cb164e-b9fb-774f-bbc7-7b9148949cd3"],
 "\[LineSeparator]fits a ",
 Cell[BoxData[
  StyleBox["tract", "TI"]], "InlineFormula",ExpressionUUID->
  "ca521719-80a2-714a-b545-fb1e8303ce37"],
 " or a list of tracts,each defined as a list of {x,y,z} coordinates with a \
polynomial function. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"97bbd5d1-dda0-5349-b473-9563a11727da"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FitTracts",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/FitTracts"], "[", 
   RowBox[{
    StyleBox["tract", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "53709f56-5b54-534a-a977-b8400f9dca83"],
 "\[LineSeparator]does the same but constrains all the ",
 Cell[BoxData[
  StyleBox["tract", "TI"]], "InlineFormula",ExpressionUUID->
  "149402cc-c125-e846-ab7c-05c5e257d6c0"],
 " coordinates to the volume defined by ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",ExpressionUUID->
  "7ab9fb3c-95f6-9941-94a4-27a7c8e9c699"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9966568023229065`*^9, 3.9966568024750233`*^9}},
 CellID->682009718,ExpressionUUID->"6b71a0a8-93cc-0e45-845b-4f495e37d706"],

