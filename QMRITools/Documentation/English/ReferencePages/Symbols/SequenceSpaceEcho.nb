Notebook[{

Cell[CellGroupData[{
Cell["SequenceSpaceEcho", "ObjectName",
 CellID->222011146,ExpressionUUID->"71ad0e41-ab38-6740-9cb1-580aae1cf0b3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"10a1e306-9768-a74b-8373-e2ee8d6e7bb1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SequenceSpaceEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SequenceSpaceEcho"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"], ",", 
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["1", "TR"]], ",", 
    SubscriptBox[
     StyleBox["t", "TI"], 
     StyleBox["2", "TR"]], ",", 
    StyleBox["nEcho", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["1", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "716c8e5b-40a3-f147-87e5-00e6da32b52f"],
 "\[LineSeparator]performs a multi echo spin echo experiment with a 90 degree \
spin echo, with ",
 Cell[BoxData[
  StyleBox["t1", "TI"]], "InlineFormula",ExpressionUUID->
  "a0dc3862-14c6-c94f-99d2-ea66ccbaa681"],
 " the time between the 90 degree RF pulse and the first 180 degree RF pulse, \
",
 Cell[BoxData[
  StyleBox["t2", "TI"]], "InlineFormula",ExpressionUUID->
  "5f882e31-bc14-c04c-9572-dba51c202f21"],
 " the time between a 180 degree RF pulse and the following readout (and 2xt1 \
the time between two consecutive 180 degree RF pulses. Further defines ",
 Cell[BoxData[
  StyleBox["nEcho", "TI"]], "InlineFormula",ExpressionUUID->
  "3ee4fe4a-8006-4f4b-b77f-88d771fb8362"],
 " the number of 180 degree RF pulses, ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "5c938107-5276-b24a-b0f3-1fc3388ba824"],
 " the spin system given the hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "ea17463c-8a82-9f47-8e4d-b328f41b70cc"],
 " using ",
 Cell[BoxData[
  StyleBox["b1", "TI"]], "InlineFormula",ExpressionUUID->
  "aeaba3e7-f95c-024a-b253-97332580ab0f"],
 ". The ",
 Cell[BoxData[
  StyleBox["t1", "TI"]], "InlineFormula",ExpressionUUID->
  "9d0874cd-11a0-dc4f-ad18-8b0390d13bdd"],
 " and ",
 Cell[BoxData[
  StyleBox["t2", "TI"]], "InlineFormula",ExpressionUUID->
  "d301f2f9-7a37-3a43-a6f4-cd19c4f40ed9"],
 " are defined in ms, and ",
 Cell[BoxData[
  StyleBox["b1", "TI"]], "InlineFormula",ExpressionUUID->
  "8ed7a87d-853e-3a41-b68d-e929a833dd5d"],
 " of 100% is defines as 1. The output is a new spin system dOut."
}], "Usage",
 CellChangeTimes->{{3.9966556729574986`*^9, 3.9966556731072884`*^9}},
 CellID->213187564,ExpressionUUID->"6f2ff045-1356-b94f-a986-ff2c1ff3ed72"],

