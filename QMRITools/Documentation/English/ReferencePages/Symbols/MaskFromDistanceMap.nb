Notebook[{

Cell[CellGroupData[{
Cell["MaskFromDistanceMap", "ObjectName",
 CellID->301924175,ExpressionUUID->"c79e23ac-fa70-634d-bfa8-79b664f42394"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"80f79137-1580-4e4b-95d2-ff868a067155"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MaskFromDistanceMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MaskFromDistanceMap"], "[", 
   StyleBox["dist", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "927c729d-8e8b-1e4d-8ebf-90ecc10dc65a"],
 "\[LineSeparator]converts a mask distance map created with ",
 Cell[BoxData[
  ButtonBox["MaskToDistanceMap",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MaskToDistanceMap"]], "InlineFormula",
  ExpressionUUID->"c7fca384-483a-1b45-a38f-4522c448f3da"],
 " back to a binary mask. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"10474100-0799-a748-96e9-cb1dd41395e7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MaskFromDistanceMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MaskFromDistanceMap"], "[", 
   RowBox[{
    StyleBox["dist", "TI"], ",", 
    StyleBox["method", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "353d31e1-0f8c-1e4d-b370-06190e8e214a"],
 "\[LineSeparator]converts a mask distance map created with ",
 Cell[BoxData[
  ButtonBox["MaskToDistanceMap",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MaskToDistanceMap"]], "InlineFormula",
  ExpressionUUID->"5edf200d-a5b0-9042-8eff-4f081650522d"],
 " back to a binary mask. The method can be \"both\", \"out\" or \"in\" which \
calculates the mask distance inside and outside, outside, or inside the mask."
}], "Usage",
 CellChangeTimes->{{3.9966556314621315`*^9, 3.9966556315283985`*^9}},
 CellID->82102154,ExpressionUUID->"9fed1f6d-8c69-954d-95b4-9bab6b3837d2"],

