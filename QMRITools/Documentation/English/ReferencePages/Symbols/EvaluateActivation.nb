Cell[CellGroupData[{
Cell["EvaluateActivation", "ObjectName",
 CellID->563051083,ExpressionUUID->"edd3525c-0def-1a4b-91e6-d532411f9ce8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4bcf6887-98f1-5a40-8222-f53ebe5b1276"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EvaluateActivation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/EvaluateActivation"], 
   "[", 
   StyleBox["out", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2f55d9f1-d847-bc45-9130-2bce2eca3f81"],
 "\[LineSeparator]allows to evaluate the activation detection using ",
 Cell[BoxData[
  ButtonBox["FindActivations",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/FindActivations"]], "InlineFormula",
  ExpressionUUID->"3fd91c61-951d-614c-94e2-6e047795db46"],
 ",where ",
 Cell[BoxData[
  StyleBox["out", "TI"]], "InlineFormula",ExpressionUUID->
  "89297e02-f347-a540-9cd4-e8290b0c6b35"],
 " is the output of that function with the option ",
 Cell[BoxData[
  ButtonBox["ActivationOutput",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ActivationOutput"]], "InlineFormula",
  ExpressionUUID->"f01ed5b6-9778-8f48-b50c-38ec654dc995"],
 " set to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "52f174f5-bf12-af4d-8b77-1d2564c9fd18"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d68d7027-0218-4349-81a9-2dee71a0cc9d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EvaluateActivation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/EvaluateActivation"], 
   "[", 
   RowBox[{
    StyleBox["out", "TI"], ",", 
    StyleBox["actS", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2821c5db-4489-af43-a0f2-88e59aa76b19"],
 "\[LineSeparator]The same with the extra analysis of the ",
 Cell[BoxData[
  ButtonBox["SelectActivations",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SelectActivations"]], "InlineFormula",
  ExpressionUUID->"135c4bbe-8d97-5142-ab1a-4169c3590cc4"],
 " function output given as ",
 Cell[BoxData[
  StyleBox["actS", "TI"]], "InlineFormula",ExpressionUUID->
  "e41c398d-0941-e241-ae96-902513ed7718"],
 "."
}], "Usage",
 CellChangeTimes->{{3.99665566216222*^9, 3.9966556623074493`*^9}},
