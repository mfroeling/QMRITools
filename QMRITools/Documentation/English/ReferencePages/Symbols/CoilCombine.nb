Cell[CellGroupData[{
Cell["CoilCombine", "ObjectName",
 CellID->38046636,ExpressionUUID->"b09f13ba-88cc-1c4e-8472-0920cbdf01f1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e45038f5-f29b-4b40-bdb7-ec018988fc1d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CoilCombine",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/CoilCombine"], "[", 
   StyleBox["sig", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "98a1b436-3482-0f4d-87ad-c5f9e8dd0f15"],
 "\[LineSeparator]combines the coil signals ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "08f78f6f-e39b-f947-896e-3a98d5d9c8d5"],
 ". Where ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "f8f1a03b-0c62-0045-9fb5-15dac9287143"],
 " is {nCoils,...}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b2c8e00f-d52d-4c47-9bde-8c2b42c900c0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CoilCombine",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/CoilCombine"], "[", 
   RowBox[{
    StyleBox["sig", "TI"], ",", 
    StyleBox["cov", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0a119733-dd1c-0540-aad1-c01c13844e6e"],
 "\[LineSeparator]combines the coil signals ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "5b911801-8771-0142-976b-8bfa6297921f"],
 ". Where ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "17660f53-f250-a745-bb27-82c96c3bab94"],
 " is {nCoils, ...} and ",
 Cell[BoxData[
  StyleBox["cov", "TI"]], "InlineFormula",ExpressionUUID->
  "33cbb7a9-0989-604e-9bda-27e875d2964e"],
 " the complex noise correlation matrix. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"fcce1a1e-e07f-684a-99ef-15f9e26a17e8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CoilCombine",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/CoilCombine"], "[", 
   RowBox[{
    StyleBox["sig", "TI"], ",", 
    StyleBox["cov", "TI"], ",", 
    StyleBox["sens", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "36088f72-dd75-1343-bbf6-3afd887307e7"],
 "\[LineSeparator]combines the coil signals ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "392c7268-47e1-a042-bc11-4fd9a2a9e37d"],
 ". Where ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "1aaeda78-c01d-aa4c-af35-ee601a1652d3"],
 " is {nCoils, ...} and ",
 Cell[BoxData[
  StyleBox["cov", "TI"]], "InlineFormula",ExpressionUUID->
  "9093ca84-e51b-9540-8664-060d80416259"],
 " the complex noise correlation matrix and sense the coils sensItivity. \
Possible coil combination methods are \"Sum\", \"RootSumSquares\", \
\"RoemerEqualNoise\", \"RoemerEqualSignal\", \"WSVD\". RootSumSquares needs \
the signal. Can be performed with and without the noise covariance matrix \
RoemerEqualNoise needs the signal and the noise covariance matrix. Can be \
performed with and without the sense data, without sense data the sensItivity \
is estimated using the signal and the RSS reconstruction of the signal. \
RoemerEqualSignal needs the signal and the noise covariance matrix and the \
sense data. WSVD needs the signal and the noise covariance matrix."
}], "Usage",
 CellChangeTimes->{{3.99665670287624*^9, 3.996656703162876*^9}},
 CellID->494982896,ExpressionUUID->"b87c2dd6-ce04-7149-a39a-ac9eb391d72d"],

