Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "57c5ff9f-2acf-c94c-8341-8e02f0b31425"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<RoemerEqualNoise\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"a5f13289-766f-9c4b-9a3b-6e53fa706057"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bd6021a8-dae0-1d45-be32-7ea598f37905"], 
    ButtonBox["SenseSmoothing",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SenseSmoothing"], 
