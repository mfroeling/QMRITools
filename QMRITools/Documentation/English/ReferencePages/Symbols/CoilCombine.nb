      "389bb9c0-ee27-8c4c-b83b-1d00e248b477"],
     " the data and sense maps are smoothed using hamming filters."
    }], "TableText",ExpressionUUID->"5feb088f-c83a-124a-b18e-9e80a496b80e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a15d7725-e973-c44b-9ffe-e94307815051"], 
