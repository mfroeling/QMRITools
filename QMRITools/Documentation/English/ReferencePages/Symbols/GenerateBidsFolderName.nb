    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/GenerateBidsFolderName"],
    "[", 
   StyleBox["parts", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a27cbbde-9086-6649-b9ba-49374d2fc674"],
 "\[LineSeparator]generates a Bids folder name from the Bids labels \
association which can be generated by PartitionBidsFolderName. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b149bdc6-1466-ab4f-b3ae-3af7451ad320"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateBidsFolderName",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/GenerateBidsFolderName"],
    "[", 
   RowBox[{
    StyleBox["fol", "TI"], ",", 
    StyleBox["parts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "664a8df5-203d-4a43-ba01-0706bb9b2263"],
 "\[LineSeparator]the same but with a custom root folder."
}], "Usage",
