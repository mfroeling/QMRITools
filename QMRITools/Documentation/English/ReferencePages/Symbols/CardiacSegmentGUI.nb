Notebook[{

Cell[CellGroupData[{
Cell["CardiacSegmentGUI", "ObjectName",
 CellID->24303032,ExpressionUUID->"2176288c-00b3-dc4c-97ed-b7fa605507dd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6975c550-2dba-f343-b792-34c9d872c767"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CardiacSegmentGUI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/CardiacSegmentGUI"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1b6ad98b-ff8b-7145-94fe-54cd3715ea3b"],
 "\[LineSeparator]allows to segment the heart in 1, 4, 6 or AHA-17 segments \
for each slice 360 radial samples are generated. ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "ad0b8ac7-3466-374c-bd90-2617b2c3432f"],
 " is a background image on which all overlays are projected. ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "829e2236-704b-a94e-be5c-b0924bfc19d9"],
 " is the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "5847ac02-d4d4-2048-8a61-0a8a80011a19"],
 " of the left ventricle (same as used for CentralAxes) and defines the area \
in which the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "7164e7d3-e227-3848-b8d9-04003e1fad58"],
 " is sampled. off is the centerpoints generated by ",
 Cell[BoxData[
  ButtonBox["CentralAxes",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
  ExpressionUUID->"a1e57a47-a686-a443-abee-37a550de292a"],
 ". Output is {points, slices , {rev, flip}}."
}], "Usage",
 CellChangeTimes->{{3.9966557059376736`*^9, 3.9966557060177784`*^9}},
 CellID->21027503,ExpressionUUID->"40ee2d35-a07e-214e-b9fe-368c47836579"],

