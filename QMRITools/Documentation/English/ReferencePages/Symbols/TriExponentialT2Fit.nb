Notebook[{

Cell[CellGroupData[{
Cell["TriExponentialT2Fit", "ObjectName",
 CellID->254742947,ExpressionUUID->"59f5f872-c8c7-b54f-b3a0-a81b6d5feb2c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"580a142b-473d-9b4f-b94b-8bf4932753f1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TriExponentialT2Fit",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/TriExponentialT2Fit"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", "EchoTimes"}], "]"}]], "InlineFormula",
  ExpressionUUID->"9ebfb76e-ed42-e446-9975-750b5ea587b9"],
 "\[LineSeparator]fits the t2 based on Azzabou N et.al. Validation of a \
generic approach to muscle water t2 determination at 3T in fat-infiltrated \
skeletal muscle. J. Magn. Reson. 2015. The fat t2 parameters are \
automatically estimated from the high signal voxels from the last echo. The \
output is in units as defined by the ",
 Cell[BoxData[
  StyleBox["EchoTimes", "TI"]], "InlineFormula",ExpressionUUID->
  "3420960a-49a4-f941-b421-97b94f7d1986"],
 ", e.g. if ",
 Cell[BoxData[
  StyleBox["EchoTimes", "TI"]], "InlineFormula",ExpressionUUID->
  "5510accf-668b-d34c-929d-67224478d463"],
 " is in ms the output is in ms. The output fraction is between 0 an 1. \
Output is {{S(0), fatFraction, muscleFraction, T2map},callibration} or {S(0), \
fatFraction, muscleFranction, T2map}."
}], "Usage",
 CellChangeTimes->{{3.9966556216451263`*^9, 3.9966556217072372`*^9}},
 CellID->15042779,ExpressionUUID->"de8fddba-1a97-ed4f-99ac-eeed503c25eb"],

Cell["The following options can be given: ", "Notes",
 CellID->788360666,ExpressionUUID->"963ba075-2040-004c-b40a-b3ba44ae1016"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "77ab7ea3-946f-6147-87b6-040a31bf76d6"], 
    ButtonBox["OutputCalibration",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/OutputCalibration"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["OutputCalibration",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OutputCalibration"]], 
      "InlineFormula",ExpressionUUID->"24107e43-e623-fa47-990c-26685c2c8aa2"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["EPGT2Fit",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
      ExpressionUUID->"1c324745-9f9b-e347-b651-868133747b55"],
     " and ",
     Cell[BoxData[
     "TriExponentialT2Fit"], "InlineFormula",ExpressionUUID->
      "4c1da12a-faa9-244f-a89f-eafbb41cdce6"],
     ". If true it outputs the calibartion values."
    }], "TableText",ExpressionUUID->"ed71a798-efea-cf4b-9517-fd50854f1eb3"]}
  }]], "3ColumnTableMod",
 CellID->536879014,ExpressionUUID->"5bef7cea-87d5-4a47-a74b-107896608393"]
}, Open  ]],

