Cell[CellGroupData[{
Cell["ReadGradients", "ObjectName",
 CellID->333591874,ExpressionUUID->"6a274ed3-767d-c44f-a1d9-f646a3fd1c9b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2756d28d-26b8-ad48-ad39-e5d3748bb507"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReadGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsLegacy/ref/ReadGradients"], "[", 
   RowBox[{
    StyleBox["folder", "TI"], ",", 
    StyleBox["nr", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f8882892-cd52-e74d-b6db-0928220c0bde"],
 "\[LineSeparator]imports the diffusion gradient directions from the dicom \
header of the first ",
 Cell[BoxData[
  StyleBox["nr", "TI"]], "InlineFormula",ExpressionUUID->
  "880a9c89-9833-954b-940d-e83c5f3f0019"],
 " of files in de given ",
 Cell[BoxData[
  StyleBox["folder", "TI"]], "InlineFormula",ExpressionUUID->
  "b0931fbc-92db-c042-96c3-8313d9b344f5"],
 ". ",
 Cell[BoxData[
  StyleBox["folder", "TI"]], "InlineFormula",ExpressionUUID->
  "5c24bd9d-51d9-ef46-8692-7004b822d0dd"],
 " must be a string, ",
 Cell[BoxData[
  StyleBox["nr", "TI"]], "InlineFormula",ExpressionUUID->
  "8e51dcf1-6ae0-d040-a3c5-9609343d7d2e"],
 " must be a int. Uses ",
 Cell[BoxData[
  ButtonBox["GradRead",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GradRead"]], "InlineFormula",
  ExpressionUUID->"d93df2d7-f0d2-6a41-821d-270bb93d37bf"],
 "."
}], "Usage",
