Cell[CellGroupData[{
Cell["CorrectTESpec", "ObjectName",
 CellID->100736702,ExpressionUUID->"bcbd2dd0-5c80-2a4d-895d-9e5d4770affc"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"93e2a0b4-8e0d-ca47-8b3d-4f356be46890"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CorrectTESpec",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/CorrectTESpec"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    StyleBox["dw", "TI"], ",", 
    StyleBox["te", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c2fb47da-ca99-e744-bbcd-4185d19466cb"],
 "\[LineSeparator]corrects the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "81b7cd03-9c0d-a746-8eee-2368dd62b871"],
 " for 1st order phase by extrapolating the missing FID samples in the TE \
using Hankel matrix SVD analysis. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"978913c6-9f51-cf4b-be35-0f2934bfaf45"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CorrectTESpec",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/CorrectTESpec"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    StyleBox["dw", "TI"], ",", 
    StyleBox["te", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["ppmRan", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c7ce50bf-d7f8-d744-9eda-57813e7f4132"],
 "\[LineSeparator]corrects the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "b67e0bb1-3716-f147-b629-f535ceae851b"],
 " for 1st order phase by extrapolating the missing FID samples in the TE \
using Hankel matrix SVD analysis. Only the part of the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "6f28ed72-8d39-6341-ba01-99b8fb815fde"],
 " in the ",
 Cell[BoxData[
  StyleBox["ppmRan", "TI"]], "InlineFormula",ExpressionUUID->
  "68d2a44d-dd30-9543-99ff-ca1c848cd740"],
 " is used for optimization."
}], "Usage",
 CellChangeTimes->{{3.9966565892500477`*^9, 3.9966565894083424`*^9}},
