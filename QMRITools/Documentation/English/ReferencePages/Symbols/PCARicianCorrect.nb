Notebook[{

Cell[CellGroupData[{
Cell["PCARicianCorrect", "ObjectName",
 CellID->94858516,ExpressionUUID->"dd864d56-e58b-f24f-b77e-7c87ac89f377"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"13ca7e87-2848-d64a-b83a-9606fe86edab"],
 Cell[BoxData[
 "PCARicianCorrect"], "InlineFormula",ExpressionUUID->
  "d55de824-e052-2844-8122-5e625c0d1782"],
 "\[LineSeparator]is an option of PCADeNoise and can be ",
 Cell[BoxData[
  ButtonBox[
   ButtonBox[
    ButtonBox["True",
     BaseStyle->"Link"],
    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "219b014f-c2e6-3642-94d7-68d1ea438677"],
 " of False. Default value is False. If True the denoised data is corrected \
for the Rician noise bias with ",
 Cell[BoxData[
  ButtonBox["RicianBiasCorrect",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RicianBiasCorrect"]], "InlineFormula",
  ExpressionUUID->"60a569f1-2e39-6f4e-8f72-14b855714e3f"],
 ", using the fitted sigma. Not used if PCAComplex is True."
}], "Usage",
 CellChangeTimes->{{4.0026958100714664`*^9, 4.002695810081114*^9}},
 CellID->113860090,ExpressionUUID->"87d75dec-fcb6-344b-a14f-cd0a79256cdf"],

