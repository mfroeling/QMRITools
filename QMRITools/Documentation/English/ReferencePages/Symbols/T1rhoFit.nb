Notebook[{

Cell[CellGroupData[{
Cell["T1rhoFit", "ObjectName",
 CellID->523290763,ExpressionUUID->"9586feeb-eddb-6047-b228-0255a25fc0a5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3d3f1b1b-cad4-284f-a35a-202d28a9ef18"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["T1rhoFit",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/T1rhoFit"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", "EchoTimes"}], "]"}]], "InlineFormula",
  ExpressionUUID->"63e93cc9-4110-254b-bc44-117be80ed9ab"],
 "\[LineSeparator]fits the T1rho value to the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "2349626f-2a8f-c647-89f5-6b894fe1f99d"],
 " using linear or nonlinear methods. The output is in units as defined by \
the ",
 Cell[BoxData[
  StyleBox["EchoTimes", "TI"]], "InlineFormula",ExpressionUUID->
  "f4728330-cbc6-4140-8609-d22ecd024c46"],
 ", e.g. if ",
 Cell[BoxData[
  StyleBox["EchoTimes", "TI"]], "InlineFormula",ExpressionUUID->
  "09efba3a-b851-ac4b-9909-675041742790"],
 " is in ms the output is in ms. Output is {S(0), T1rhomap}."
}], "Usage",
 CellChangeTimes->{{3.996656820181385*^9, 3.996656820270916*^9}},
 CellID->559371236,ExpressionUUID->"aa25a58e-ce0f-a140-ba63-270356780f1d"],

