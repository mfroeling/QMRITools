Notebook[{

Cell[CellGroupData[{
Cell["ReadListData", "ObjectName",
 CellID->859527508,ExpressionUUID->"b2093bf0-fa10-a04a-bf1e-62733279da8b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b6241e7f-4246-b54c-af33-584556e52738"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReadListData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/ReadListData"], "[", 
   StyleBox["file", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "a34b7b6b-330d-8647-bd40-8cc13fea77e3"],
 "\[LineSeparator]reads a list/data raw data ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "c0678684-5ef0-2b44-8fc1-1c6bfa3e33e8"],
 " from the philips MR platform. The input ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "0ab45a3f-33b0-9046-a30a-ce03138861c4"],
 " can either be .list or .data ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "dba7dc69-49c1-d746-a124-9dc3133bb87b"],
 ". Output is {{rawData,noise},{head,types}}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"39e501d9-18f8-ab42-8b6f-fcacf315e85c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReadListData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/ReadListData"], "[", 
   RowBox[{
    StyleBox["file", "TI"], ",", 
    StyleBox["print", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ace34d5e-a1ad-044f-ad96-9c9a1c642286"],
 "\[LineSeparator]does the same but if ",
 Cell[BoxData[
  StyleBox["print", "TI"]], "InlineFormula",ExpressionUUID->
  "e6e41e7d-06be-c94b-a572-e7e885822330"],
 " is set False no reporting is done."
}], "Usage",
 CellChangeTimes->{{3.9966566120520096`*^9, 3.996656612214031*^9}},
 CellID->398924883,ExpressionUUID->"80835cc5-e658-2a4b-8388-f12f67a739f3"],

