Notebook[{

Cell[CellGroupData[{
Cell["MakeGradientMaps", "ObjectName",
 CellID->76737,ExpressionUUID->"6ff28402-4a95-6444-8c40-90ef2e869b35"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9e7cbcd7-3b9d-ad4e-8f50-6deac9b3d7d5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeGradientMaps",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/MakeGradientMaps"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["int", "TI"], ",", 
      StyleBox["dint", "TI"]}], "}"}], ",", 
    StyleBox["fov", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["start", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3564feb3-7f26-3340-9c0b-257233ed597f"],
 "\[LineSeparator]will produce the gradient maps from the interpolation \
functions int and dint. The field of view is defined by ",
 Cell[BoxData[
  StyleBox["fov", "TI"]], "InlineFormula",ExpressionUUID->
  "3fb22466-f144-1442-b814-7b1bacdc857f"],
 ", the resolution by ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "059d0c3c-8f54-6f4d-88c5-f6b7a336fef3"],
 " and the ",
 Cell[BoxData[
  StyleBox["start", "TI"]], "InlineFormula",ExpressionUUID->
  "2684cd38-f6a1-5843-a794-4ba488164cad"],
 " is the left most coordinate in the scanner coordinate system. The \
interpolation functions int and dint are generated by ",
 Cell[BoxData[
  ButtonBox["MakeGradientDerivatives",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeGradientDerivatives"]], 
  "InlineFormula",ExpressionUUID->"aa394cb0-c2a3-7344-add3-aa5554d5919b"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9966562440689964`*^9, 3.9966562441532116`*^9}},
 CellID->512609980,ExpressionUUID->"7e9da724-be4d-894f-85a0-dda95d1e1878"],

