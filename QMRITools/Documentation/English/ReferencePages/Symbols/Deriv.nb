Cell[CellGroupData[{
Cell["Deriv", "ObjectName",
 CellID->525139709,ExpressionUUID->"1354d309-e2db-884e-bf81-84dc67ec22ad"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e35a5187-e338-0944-ae88-9c979aa50003"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Deriv",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/Deriv"], "[", 
   RowBox[{
    StyleBox["disp", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "95140c92-4654-da42-ae99-d9847f1a1451"],
 "\[LineSeparator]calculates the derivative of the displacement along the \
three main axes. ",
 Cell[BoxData[
  StyleBox["disp", "TI"]], "InlineFormula",ExpressionUUID->
  "a3ab189e-02f9-2f4b-ae57-e2be5b98c139"],
 " is the displacement field, ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "ca7f99fd-df3a-c14b-9632-ee129068b800"],
 " is the voxel size. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"293ba5a6-33c3-9c49-a158-4befa268a762"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Deriv",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/Deriv"], "[", 
   RowBox[{
    StyleBox["disp", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "628fed06-5152-fe4b-aeff-1c71c9b3067c"],
 "\[LineSeparator]calculates the derivative of the displacement along the \
three main axes. Sharp edges between the background and ",
 Cell[BoxData[
  StyleBox["disp", "TI"]], "InlineFormula",ExpressionUUID->
  "63695e84-f992-af43-a27a-d4e5f221c8c0"],
 " are solved by the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "35066573-c4a3-5f49-8ece-19766d957beb"],
 ". ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "c3a15903-3bc4-7c43-89c4-3763cb65c953"],
 " is a ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "78814da6-7478-7b4b-bb3d-6f32e7da3d6b"],
 " defining the edge of the displacement field."
}], "Usage",
 CellChangeTimes->{{3.998533202962015*^9, 3.9985332033202705`*^9}},
