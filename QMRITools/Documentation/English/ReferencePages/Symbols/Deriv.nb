Cell[CellGroupData[{
Cell["Deriv", "ObjectName",
 CellID->340735114,ExpressionUUID->"50a59a9d-75e2-cf46-8741-27ee42fb595f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1224e3dc-325e-3149-a83b-f5e87cac1aa3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Deriv",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/Deriv"], "[", 
   RowBox[{
    StyleBox["disp", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6556bda5-ed77-a340-afa0-7dee1f653f8c"],
 "\[LineSeparator]calculates the derivative of the displacement along the \
three main axes. ",
 Cell[BoxData[
  StyleBox["disp", "TI"]], "InlineFormula",ExpressionUUID->
  "ce69f3a1-71e3-de41-b3a3-2d3fb7edd684"],
 " is the displacement field, ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "0adb915f-385d-774c-8e9b-9704b502e922"],
 " is the voxel size. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"92aa4a80-904f-c243-894d-67e3892af8c0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Deriv",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/Deriv"], "[", 
   RowBox[{
    StyleBox["disp", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0d7b07aa-f441-ec4d-b3af-affa01700a5a"],
 "\[LineSeparator]calculates the derivative of the displacement along the \
three main axes. Sharp edges between the background en ",
 Cell[BoxData[
  StyleBox["disp", "TI"]], "InlineFormula",ExpressionUUID->
  "a4d5b712-53a0-a54d-a36a-b4648691c146"],
 " are solved by the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "cd7e61ca-830f-6045-89cb-a6de109ffaef"],
 ". ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "06925e09-9742-d14c-b39c-69c0a4c71fb9"],
 " is a ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "bb27ff98-e4a5-b844-bbce-52300c8f1856"],
 " defining the edge of the displacement field."
}], "Usage",
 CellChangeTimes->{{3.9966568821913166`*^9, 3.996656882437195*^9}},
