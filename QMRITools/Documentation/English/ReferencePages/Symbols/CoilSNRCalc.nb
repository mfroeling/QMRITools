Cell["CoilSNRCalc", "ObjectName",
 CellID->8713746,ExpressionUUID->"31a9e3ce-9c7f-c64d-a579-f78ea54e79e0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1a9dad30-79b5-8345-a510-c74a57ed0442"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CoilSNRCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/CoilSNRCalc"], "[", 
   RowBox[{
    StyleBox["coils", "TI"], ",", 
    StyleBox["noise", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "11b82dda-5cee-7947-bb5e-1578ea912f27"],
 "\[LineSeparator]calculates the sensitivity weighted snr of multiple coil \
elements using magnitude signal and ",
 Cell[BoxData[
  StyleBox["noise", "TI"]], "InlineFormula",ExpressionUUID->
  "badd5be9-fbcf-3946-8767-785f313097bd"],
 ". Output is {data, ",
 Cell[BoxData[
  StyleBox["noise", "TI"]], "InlineFormula",ExpressionUUID->
  "71c6ec0e-b91b-2e49-ae14-6d96e166fb1d"],
 ", sos, snr, sigmap, weights}."
}], "Usage",
