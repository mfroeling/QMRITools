Notebook[{

Cell[CellGroupData[{
Cell["RegisterTensorData", "ObjectName",
 CellID->196656839,ExpressionUUID->"a7e85913-5cef-f246-9b46-49537a0db827"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1b9b1489-7d6e-6844-8183-74ce4058140e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterTensorData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterTensorData"], "[", 
   RowBox[{
    StyleBox["target", "TI"], ",", 
    StyleBox["moving", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a8653260-60d1-9a4a-8cbe-9b164f8cb6da"],
 "\[LineSeparator]registers the ",
 Cell[BoxData[
  StyleBox["moving", "TI"]], "InlineFormula",ExpressionUUID->
  "e53a8a41-3486-b44d-b120-e6ded61feaa9"],
 " tensor to the ",
 Cell[BoxData[
  StyleBox["target", "TI"]], "InlineFormula",ExpressionUUID->
  "20a55429-6f31-1c4d-8a2c-0c675892628f"],
 " tensor. After registration the ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "36062943-bf49-e542-b7fb-2739be0699eb"],
 " is reorientated appropriately. The inputs ",
 Cell[BoxData[
  StyleBox["target", "TI"]], "InlineFormula",ExpressionUUID->
  "e71e34e9-0dd9-124b-a2cb-9438b4eb9738"],
 " and ",
 Cell[BoxData[
  StyleBox["moving", "TI"]], "InlineFormula",ExpressionUUID->
  "22791e5b-01be-4f48-9cb8-f6d111143a60"],
 " can be in the forms: ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "c4af95a5-b060-eb44-8f1b-796d199b3e0f"],
 ", {tensor, vox}, {tensor, mask} or {tensor, mask, vox}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3e19b121-a500-d44f-93c8-61dc16f2042a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterTensorData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterTensorData"], "[", 
   RowBox[{
    StyleBox["target", "TI"], ",", 
    StyleBox["moving", "TI"], ",", 
    StyleBox["tensor", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ce92a249-c795-6844-8331-234d68aada66"],
 "\[LineSeparator]registers the ",
 Cell[BoxData[
  StyleBox["moving", "TI"]], "InlineFormula",ExpressionUUID->
  "e2340a10-514c-3343-8252-5a916b7237d1"],
 " data to the ",
 Cell[BoxData[
  StyleBox["target", "TI"]], "InlineFormula",ExpressionUUID->
  "ffbbbbdb-24ef-1a46-816d-db29b8b2c48f"],
 " data and applies the deformation to the ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "30c2faf5-86f3-e543-8959-55114c6c9baa"],
 ". The inputs ",
 Cell[BoxData[
  StyleBox["target", "TI"]], "InlineFormula",ExpressionUUID->
  "aea64aae-41fe-3a4f-ae04-629410efd39b"],
 " and ",
 Cell[BoxData[
  StyleBox["moving", "TI"]], "InlineFormula",ExpressionUUID->
  "08ff2e7a-3766-bd4c-836a-09044bfb2552"],
 " can be in the form: data, {data, vox}, {data, mask} or {data, mask, vox}. \
The input ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "390d8418-2c46-204d-97d9-410617f6d43a"],
 " can be in the form: ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "bf772879-7767-3e48-b038-7da08122aa6c"],
 " or {tensor, vox}. only \"rigid\", \"affine\" and \"bspline\" can be used \
as MetReg."
}], "Usage",
 CellChangeTimes->{{3.996655653611866*^9, 3.9966556538951225`*^9}},
 CellID->152209719,ExpressionUUID->"54b86d41-fabb-424c-b8f2-6baadd09a62b"],

