Notebook[{

Cell[CellGroupData[{
Cell["BmatrixCalc", "ObjectName",
 CellID->484180040,ExpressionUUID->"113fc4da-7bf5-354b-ae58-920a1c8b35f4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8c2e3e38-7db2-ad49-939b-8510f38cad3d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BmatrixCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/BmatrixCalc"], "[", 
   RowBox[{"\"\<\!\(\*StyleBox[\"folder\", \"TI\"]\)\>\"", ",", 
    StyleBox["grads", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2b247a51-2915-2145-8922-4fdc50420212"],
 "\[LineSeparator]calculates the true bmatrix from the exported sequence \
parameters from the philips scanner that are stored in \"",
 Cell[BoxData[
  StyleBox["\"\<folder\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "822612b3-ad19-ff43-9ac6-3b5ecaf8dc94"],
 "folder\" for each of the gradient directions ",
 Cell[BoxData[
  StyleBox["grads", "TI"]], "InlineFormula",ExpressionUUID->
  "cbb8e0fc-a8f6-fc46-a85f-6bf855965d18"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9985331935195312`*^9, 3.99853319359651*^9}},
 CellID->26558284,ExpressionUUID->"7486fd0a-91d1-0d4b-93f2-51c0e23e3e5d"],

Cell["The following options can be given: ", "Notes",
 CellID->367837314,ExpressionUUID->"a104ba19-28d8-0342-b9c9-efea716dc868"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d4107176-70f2-a942-ba1d-0190d14e04e7"], 
    ButtonBox["UseGrad",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/UseGrad"], 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "1", ",", " ", "1"}], 
     "}"}], Cell["\<\
UseGrad is an option for GradSeq. The default value is {0, 1, {1, 0}, 1} \
where {grex, gr180, {grepi1, grepi2}, grdiff, grflow}.\
\>", "TableText",ExpressionUUID->"960da5f1-7997-504f-98ce-9e8947b7208e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7e8ed9ca-a74c-514b-8494-5c7c2d3a44c3"], 
    ButtonBox["OutputType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsGradientTools/ref/OutputType"], "\"\<Matrix\>\"", Cell[
    TextData[{
     "OutputType is an option for ",
     Cell[BoxData[
     "BmatrixCalc"], "InlineFormula",ExpressionUUID->
      "7827e1a4-ff5d-2c47-96c3-1d96233faf5a"],
     ". Values can be \"Matrix\" of \"Gradients\"."
    }], "TableText",ExpressionUUID->"e773450d-8539-a741-b8c7-18c33d42dbaa"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c2c2acb8-4efd-4a4c-a33f-edec86570e80"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<Numerical\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"caf8acb2-81ef-244d-9bea-cff4513c0099"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "83aea048-1443-0245-8f8e-a091383ec51b"], 
    ButtonBox["StepSizeI",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/StepSizeI"], "0.05", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["StepSizeI",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/StepSizeI"]], "InlineFormula",
      ExpressionUUID->"c4ce0da9-0f49-0c49-bf05-189399aa3497"],
     " is an option for GradBmatrix. Specifies the integration stepsize is \
Method -> \"Numerical\" is used."
    }], "TableText",ExpressionUUID->"646e21d9-7871-a24f-8bd2-558c650564e2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e50f080a-6f9e-564a-9c4b-78bb4587521e"], 
    ButtonBox["UnitMulti",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/UnitMulti"], 
    RowBox[{" ", 
     RowBox[{"1", "\n", 
      RowBox[{"--", 
       RowBox[{"--", "\n", "1000"}]}]}]}], Cell["\<\
UnitMulti is an option for GradSeq. Defaul value is 10^-3. Defines the \
scaling of the gradient strength.\
\>", "TableText",ExpressionUUID->"95e24f42-49b7-7243-8543-2e1f5f86d449"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "20b1d443-8271-b046-8e7a-a94cd4dfee65"], 
    ButtonBox["PhaseEncoding",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsGradientTools/ref/PhaseEncoding"], "\"\<A\>\"", 
    Cell["\<\
PhaseEncoding is an options of GradSeq. Values can be \"A\", \"P\", \"R\" and \
\"L\".\
\>", "TableText",ExpressionUUID->"ad53b59b-e6c7-ee43-b101-2f4d195586bc"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5c8de3ea-6c4f-5c48-8aa6-ea5302a4ebb7"], 
    ButtonBox["FlipAxes",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/FlipAxes"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], "}"}], Cell["\<\
FlipAxes is an option for GradSeq. Defaul value is {{1,1,1},{1,1,1}}. First \
three values are for diffusion gradients last three are for the acquisition \
gradients.\
\>", "TableText",ExpressionUUID->"08f5c992-20e8-e840-8bcd-53616011eb0d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6634f74e-f71b-ff44-a2c8-480b5d161939"], 
    ButtonBox["SwitchAxes",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/SwitchAxes"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}], Cell["\<\
SwitchAxes is an option for GradSeq. Defaul value is {{1,2,3},{1,2,3}}. First \
three values are for diffusion gradients last three are for the acquisition \
gradients.\
\>", "TableText",ExpressionUUID->"d252c809-91ee-4c41-b849-8b765f8a7437"]}
  }]], "3ColumnTableMod",
 CellID->26386014,ExpressionUUID->"f4ea4656-e37f-a440-9081-067710049eb1"]
