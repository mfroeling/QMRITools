Notebook[{

Cell[CellGroupData[{
Cell["BmatrixCalc", "ObjectName",
 CellID->235933879,ExpressionUUID->"9ad2fbe7-a211-2144-abee-b63bbe721991"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"02e8d8ce-bec0-de41-9e9e-0b9233fc9cb9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BmatrixCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/BmatrixCalc"], "[", 
   RowBox[{"\"\<\!\(\*StyleBox[\"folder\", \"TI\"]\)\>\"", ",", 
    StyleBox["grads", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8c8880b6-b114-f940-b80f-d201ac9b2000"],
 "\[LineSeparator]calculates the true bmatrix from the exported sequence \
parameters from the philips scanner that are stored in \"",
 Cell[BoxData[
  StyleBox["\"\<folder\>\"", "TI"]], "InlineFormula",ExpressionUUID->
  "c38cb5d7-472a-7a4c-8ff2-d60d6c5ac273"],
 "folder\" for each of the gradient directions ",
 Cell[BoxData[
  StyleBox["grads", "TI"]], "InlineFormula",ExpressionUUID->
  "edd07a40-22a3-554b-8a80-719d4c7dd338"],
 "."
}], "Usage",
 CellChangeTimes->{{4.003804494710747*^9, 4.003804494773222*^9}},
 CellID->405948744,ExpressionUUID->"996fb7f7-1d9b-7444-b1e7-613768d9b55f"],

Cell["The following options can be given: ", "Notes",
 CellID->167158255,ExpressionUUID->"4d8d50e2-bd2a-4245-abab-269e1fffbdf2"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bc921af1-06cd-0541-b13a-b12c524a6b4f"], 
    ButtonBox["UseGrad",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/UseGrad"], 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", "1", ",", " ", "1"}], 
     "}"}], Cell["\<\
UseGrad is an option for GradSeq. The default value is {0, 1, {1, 0}, 1} \
where {grex, gr180, {grepi1, grepi2}, grdiff, grflow}.\
\>", "TableText",ExpressionUUID->"ebed728e-ce90-0341-ae31-9ca13f16dce2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "de64eea8-9830-bc48-991f-03ffd8116f95"], 
    ButtonBox["OutputType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsGradientTools/ref/OutputType"], "\"\<Matrix\>\"", Cell[
    TextData[{
     "OutputType is an option for ",
     Cell[BoxData[
     "BmatrixCalc"], "InlineFormula",ExpressionUUID->
      "6524ec8c-bb60-414d-b4ce-be1d309cbc3c"],
     ". Values can be \"Matrix\" of \"Gradients\"."
    }], "TableText",ExpressionUUID->"fd54afcb-0e1d-264a-9530-ebf3286735d2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "38a24fac-7e0f-6b47-9ef5-41d7376dc087"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<Numerical\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"b6ed6080-7d3c-e643-b58a-7bc3e1f51ba7"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "605007b8-bd85-1e47-b91a-cdbefe1cba42"], 
    ButtonBox["StepSizeI",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/StepSizeI"], "0.05", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["StepSizeI",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/StepSizeI"]], "InlineFormula",
      ExpressionUUID->"a81e5647-3d46-5f45-b424-2a562f2020eb"],
     " is an option for GradBmatrix. Specifies the integration stepsize is \
Method -> \"Numerical\" is used."
    }], "TableText",ExpressionUUID->"1c94c303-0fcc-cf48-8435-563da837b0c7"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7d669925-41c9-b840-ad19-de724603b937"], 
    ButtonBox["UnitMulti",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/UnitMulti"], 
    RowBox[{" ", 
     RowBox[{"1", "\n", 
      RowBox[{"--", 
       RowBox[{"--", "\n", "1000"}]}]}]}], Cell["\<\
UnitMulti is an option for GradSeq. Defaul value is 10^-3. Defines the \
scaling of the gradient strength.\
\>", "TableText",ExpressionUUID->"a1428b0e-7630-dd41-b82f-d635a9a7f319"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7a010ee1-32c3-fb45-84b3-3b060b8c00cc"], 
    ButtonBox["PhaseEncoding",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsGradientTools/ref/PhaseEncoding"], "\"\<A\>\"", 
    Cell["\<\
PhaseEncoding is an options of GradSeq. Values can be \"A\", \"P\", \"R\" and \
\"L\".\
\>", "TableText",ExpressionUUID->"866512a5-5fd5-2b4d-baf4-43a7e3421cfe"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ec22b837-4351-bf4b-b16e-37e31b37fd7f"], 
    ButtonBox["FlipAxes",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/FlipAxes"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}]}], "}"}], Cell["\<\
FlipAxes is an option for GradSeq. Defaul value is {{1,1,1},{1,1,1}}. First \
three values are for diffusion gradients last three are for the acquisition \
gradients.\
\>", "TableText",ExpressionUUID->"c9e7b1db-37d3-fc44-88e3-1f8f528aa840"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "fe8aae07-7cfe-b04d-a81b-31028f9b8d4b"], 
    ButtonBox["SwitchAxes",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/SwitchAxes"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "}"}], Cell["\<\
SwitchAxes is an option for GradSeq. Defaul value is {{1,2,3},{1,2,3}}. First \
three values are for diffusion gradients last three are for the acquisition \
gradients.\
\>", "TableText",ExpressionUUID->"6ebb1688-05ca-1e4a-a98b-9f6b91152916"]}
  }]], "3ColumnTableMod",
 CellID->119165176,ExpressionUUID->"6e74dbd9-e70d-f54e-82f1-d6644638388c"]
}, Open  ]],

