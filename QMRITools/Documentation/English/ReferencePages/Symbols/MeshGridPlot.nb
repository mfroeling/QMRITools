Cell["MeshGridPlot", "ObjectName",
 CellID->143090004,ExpressionUUID->"e1ee0cbd-beda-1947-92d3-2bd5076dad4c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6e70be48-3386-d94d-8be1-044af9ffff40"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MeshGridPlot",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MeshGridPlot"], "[", 
   RowBox[{
    StyleBox["meshes", "TI"], ",", 
    StyleBox["points", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "46e6145f-8253-7243-bafe-4d677a834dd8"],
 "\[LineSeparator]gives a grid of shape ",
 Cell[BoxData[
  StyleBox["meshes", "TI"]], "InlineFormula",ExpressionUUID->
  "6c6dea23-445a-b04b-a06c-136c2cf24936"],
 " defined by ",
 Cell[BoxData[
  StyleBox["meshes", "TI"]], "InlineFormula",ExpressionUUID->
  "58f5de8b-4c0a-8e4b-9003-6f5c6007b871"],
 " and ",
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",ExpressionUUID->
  "da12ff31-2d07-1549-b2d8-7661b70131c2"],
 ". These can be obtained from with the ",
 Cell[BoxData[
  ButtonBox["TemplateOutput",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/TemplateOutput"]], "InlineFormula",
  ExpressionUUID->"334840cc-2ee2-1544-865b-79ab13ef9175"],
 " set to \"Meshes\"."
}], "Usage",
