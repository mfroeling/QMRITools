    StyleBox["dti", "TI"], ",", 
    StyleBox["tens", "TI"], ",", 
    StyleBox["grad", "TI"], ",", 
    StyleBox["bvec", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e657abe4-9050-c64f-9003-832d988e23ec"],
 "\[LineSeparator]calculates the noise sigma based on the tensor residual, \
using a ",
 Cell[BoxData[
  StyleBox["blur", "TI"]], "InlineFormula",ExpressionUUID->
  "97698ef0-43bb-974d-a0ef-a54485678408"],
 " factor of 2. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"5ed8841a-255b-ea48-8afa-a6e73ab7d8cd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SigmaCalc",
