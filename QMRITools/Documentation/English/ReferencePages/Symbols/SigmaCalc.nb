 Cell["   ", "ModInfo",ExpressionUUID->"13df3651-67e2-ae41-8323-27a1a64dedb4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SigmaCalc",
    BaseStyle->"Link",
