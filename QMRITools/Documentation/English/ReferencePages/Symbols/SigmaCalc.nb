   RowBox[{
    StyleBox["dti", "TI"], ",", 
    StyleBox["tens", "TI"], ",", 
    StyleBox["grad", "TI"], ",", 
    StyleBox["bvec", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cfb85241-78d9-b647-b1e3-24e6671ac79c"],
 "\[LineSeparator]calculates the noise sigma based on the tensor residual, \
using a ",
 Cell[BoxData[
  StyleBox["blur", "TI"]], "InlineFormula",ExpressionUUID->
  "0bef15c7-0bd3-f445-8d04-da4e4d6a88bf"],
 " factor of 10. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8c05d443-252c-de48-b829-3b41afe25ad5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SigmaCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/SigmaCalc"], "[", 
   RowBox[{
    StyleBox["dti", "TI"], ",", 
    StyleBox["grad", "TI"], ",", 
    StyleBox["bvec", "TI"], ",", 
    StyleBox["blur", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dc1d121c-58fa-9746-bcb4-dfa6d903a77b"],
 "\[LineSeparator]calculates the noise sigma based on the tensor residual,If ",
