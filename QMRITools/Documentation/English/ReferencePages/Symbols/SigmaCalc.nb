Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b37374c6-8944-1448-a436-03262ae63409"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SigmaCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/SigmaCalc"], "[", 
