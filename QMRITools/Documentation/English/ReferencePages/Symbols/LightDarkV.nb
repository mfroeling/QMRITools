Cell[CellGroupData[{
Cell["LightDarkV", "ObjectName",
 CellID->62958521,ExpressionUUID->"7da67a19-e42e-dd49-91d1-7ef5d51c5487"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fe5c1060-05f2-2c49-ae58-b6827dbf9bf1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["LightDarkV",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/LightDarkV"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"7f4d0d8a-319f-4b48-8521-fb29991e4db0"],
 "\[LineSeparator]gives Black for ",
 Cell[BoxData[
  StyleBox["light", "TI"]], "InlineFormula",ExpressionUUID->
  "e7e81ab8-7454-cc46-b935-734b6748787f"],
 " mode and White for ",
 Cell[BoxData[
  StyleBox["dark", "TI"]], "InlineFormula",ExpressionUUID->
  "825de695-bc10-f946-995f-fc710f7c6bcd"],
 " mode in version 14.3+ else it gives White. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2ec2e0d3-893c-c644-b2f7-badcac50f133"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["LightDarkV",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/LightDarkV"], "[", 
   RowBox[{
    StyleBox["light", "TI"], ",", 
    StyleBox["dark", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d3a0f34d-fba5-3542-9172-a8ed8cdc3084"],
 "\[LineSeparator]does the same as LightDarkSwitched but only for version \
14.3 or higher."
}], "Usage",
