Cell[CellGroupData[{
Cell["LightDarkV", "ObjectName",
 CellID->102971468,ExpressionUUID->"bc6ea777-9a3d-7f4b-95f8-6469917187ab"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f7f2b5c-619d-104d-9f9b-00a52d990aae"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["LightDarkV",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/LightDarkV"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"1934597a-af0e-f446-b8ec-ac8c122ea9aa"],
 "\[LineSeparator]gives Black for ",
 Cell[BoxData[
  StyleBox["light", "TI"]], "InlineFormula",ExpressionUUID->
  "5fa9b86a-4ec7-dc46-967e-ea837a76b233"],
 " mode and White for ",
 Cell[BoxData[
  StyleBox["dark", "TI"]], "InlineFormula",ExpressionUUID->
  "c1f1d81b-9ec6-da45-ac54-d03b2c3149eb"],
 " mode in version 14.3+ else it gives White. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3b43addb-3402-dc48-b94a-a62f61fc2faa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["LightDarkV",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/LightDarkV"], "[", 
   RowBox[{
    StyleBox["light", "TI"], ",", 
    StyleBox["dark", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "febc7656-9384-3c4b-921a-3545973c0dbc"],
 "\[LineSeparator]does the same as tighhDarkSwitched but only for version \
14.3 or higher."
}], "Usage",
