  RowBox[{
   ButtonBox["SegmentationCrossSection",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/SegmentationCrossSection"], 
   "[", 
   StyleBox["seg", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "70691c83-67f4-a242-9901-2f786408e417"],
 "\[LineSeparator]calculates the maximum cross section of each label in the \
segmentation in voxels. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b36b43e3-bf6c-2042-abb3-d00fbb8e6cf2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentationCrossSection",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/SegmentationCrossSection"], 
   "[", 
   RowBox[{
    StyleBox["seg", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5bbffb72-5881-0940-934d-1d129370ccb9"],
 "\[LineSeparator]calculates the maximum cross section of each label in the \
segmentation in cm^2 where ",
