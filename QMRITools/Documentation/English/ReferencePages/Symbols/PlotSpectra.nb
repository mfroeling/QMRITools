Cell[CellGroupData[{
Cell["PlotSpectra", "ObjectName",
 CellID->44781754,ExpressionUUID->"12d1c9ae-0406-e948-9a22-e5d95a642644"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"57322bc7-104d-db4b-a434-62b6afd5ccb3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PlotSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["dwell", "TI"], ",", 
      StyleBox["gyro", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"580087e6-01ad-e142-9d94-711238dc9eb4"],
 "\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "ca383d14-b310-d344-995d-a99ac7102ed5"],
 ", the ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "e44af182-e1f0-ac45-b9f0-1d997a44ebf9"],
 " axes is determined by dwell and gyro. Gyro can be obtained with GetGyro. \n\
",
 Cell["   ", "ModInfo",ExpressionUUID->"231bf286-c01a-014f-8e25-dc2b9585ddeb"],
 "PlotSpectra[spectra {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "dwell"}], "TI"]], "InlineFormula",ExpressionUUID->
  "0fe1a8ad-40d6-c246-ba0a-1310878bead6"],
 "dwell,field,nuc}]\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "ab60643f-84f6-8941-a2b4-7bea6a8c7c8d"],
 ", the ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "3907c190-3b00-4844-9906-2821275a65c4"],
 " axes is determined by dwell ",
 Cell[BoxData[
  StyleBox["field", "TI"]], "InlineFormula",ExpressionUUID->
  "e7bcd7e9-bd07-a843-addc-5d819076ee21"],
 " and nuc. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c0e51ca2-4299-0248-bdd3-6c1fdc3f3023"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PlotSpectra"], "[", 
   RowBox[{
    StyleBox["ppm", "TI"], ",", 
    StyleBox["spectra", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "92a2ed38-5bb1-ed49-8827-ac6eb061dfb0"],
 "\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "667162d7-dc46-4a4b-b9e7-cc6dda4a4497"],
 " where ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "fe205c96-5440-8a40-b3af-5ddd409f1801"],
 " is the pmm range of the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "4e61a3e8-fbf2-b349-94eb-3dcfdf2c1e60"],
 " which can be obtained with GetPpmRange."
}], "Usage",
 CellChangeTimes->{{4.0038045632950706`*^9, 4.0038045635606537`*^9}},
 CellID->211724507,ExpressionUUID->"7af84800-c1a7-0a45-aab4-9c97cf432b20"],

