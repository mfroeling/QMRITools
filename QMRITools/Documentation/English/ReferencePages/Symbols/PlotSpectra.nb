Cell["PlotSpectra", "ObjectName",
 CellID->636726777,ExpressionUUID->"d0de9a69-a7b2-d147-b38e-2217310bd3a5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"92280baf-9622-6140-999e-1dbfe96fe888"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PlotSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["dwell", "TI"], ",", 
      StyleBox["gyro", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"2b145e3c-b55d-264b-acb9-9942b8a7f082"],
 "\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "a86d5fb0-64aa-1e4b-b09b-53fe9f882f32"],
 ", the ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "8b4ee515-7365-4c44-8ad9-b17770d3c426"],
 " axes is determined by dwell and gyro. Gyro can be obtained with ",
 Cell[BoxData[
  ButtonBox["GetGyro",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetGyro"]], "InlineFormula",
  ExpressionUUID->"ee607dc8-147e-8445-a5bc-b3066b1d0ecf"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"00b7b85c-35ce-0040-958a-aaad72e74eb1"],
 "PlotSpectra[spectra {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "dwell"}], "TI"]], "InlineFormula",ExpressionUUID->
  "b9857c4b-cf81-a84f-9e7e-b85b08a4aaee"],
 "dwell,field,nuc}]\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "2f6e17b3-643a-3042-9209-ce7890159bab"],
 ", the ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "cb3918fc-03d0-364a-8bb3-201e05d96eda"],
 " axes is determined by dwell ",
 Cell[BoxData[
  StyleBox["field", "TI"]], "InlineFormula",ExpressionUUID->
  "3333d15b-0285-d94d-b9ee-08462774d29c"],
 " and nuc. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0234ed6a-90a6-874a-96af-6e80767fc4e6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PlotSpectra"], "[", 
   RowBox[{
    StyleBox["ppm", "TI"], ",", 
    StyleBox["spectra", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "dbf3c749-d8bb-9b49-ba64-86f8d84dd97e"],
 "\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "93d82a2b-710a-824a-b613-510a2174d9ff"],
 " where ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "4978dc8e-a0dd-5142-9b51-9a04df33a0bc"],
 " is the pmm range of the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "6ed2faa5-7b8b-6847-9222-e221f0de8115"],
 " which can be obtained with ",
 Cell[BoxData[
  ButtonBox["GetPpmRange",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetPpmRange"]], "InlineFormula",
  ExpressionUUID->"ad5767c8-d82f-cf48-af82-2446262765b4"],
 "."
}], "Usage",
