Cell[CellGroupData[{
Cell["PlotSpectra", "ObjectName",
 CellID->537662392,ExpressionUUID->"90e675bb-45e6-e14e-8eb6-6af1bcfae52a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"27b3e32c-2441-a247-94dd-1a4c39699671"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PlotSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["dwell", "TI"], ",", 
      StyleBox["gyro", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"451828a1-538f-1944-9811-31ad641beef2"],
 "\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "a1493d10-010d-3848-acec-2b0adb4eaa46"],
 ", the ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "5657f8c3-6594-6c40-ad51-81da612cb7b9"],
 " axes is determined by dwell and gyro. Gyro can be obtained with GetGyro. \n\
",
 Cell["   ", "ModInfo",ExpressionUUID->"50a6c9d3-0780-8340-8547-840d4117f565"],
 "PlotSpectra[spectra {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "dwell"}], "TI"]], "InlineFormula",ExpressionUUID->
  "2f5a9bc9-ad73-3349-8203-196f66f341b2"],
 "dwell,field,nuc}]\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "64830908-fd4a-9245-8cb4-c0dacdf74825"],
 ", the ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "86120d1a-f8ee-5045-a081-7abef8eea475"],
 " axes is determined by dwell ",
 Cell[BoxData[
  StyleBox["field", "TI"]], "InlineFormula",ExpressionUUID->
  "0f8b8a4a-34d6-f845-bb7b-c2cad251a7ff"],
 " and nuc. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"24493ff7-cd1b-304b-b05c-f19c3dd880b4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PlotSpectra"], "[", 
   RowBox[{
    StyleBox["ppm", "TI"], ",", 
    StyleBox["spectra", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8c86636c-54be-c245-9c6a-bd106fd2ea4a"],
 "\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "8caf1c00-776a-c84b-b1a5-1a3c0fc43d4b"],
 " where ",
 Cell[BoxData[
  StyleBox["ppm", "TI"]], "InlineFormula",ExpressionUUID->
  "4b253400-d90b-484c-bcd0-26b0fa810587"],
 " is the pmm range of the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "e8e67efa-22a1-ff47-b661-2fc87ec020dd"],
 " which can be obtained with GetPpmRange."
}], "Usage",
 CellChangeTimes->{{3.9985332633130474`*^9, 3.998533263923046*^9}},
 CellID->941042069,ExpressionUUID->"8201f846-f0d7-4e40-bf51-d307a2805436"],

