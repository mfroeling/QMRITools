Notebook[{

Cell[CellGroupData[{
Cell["TransformTensor", "ObjectName",
 CellID->161069420,ExpressionUUID->"a9db2fd2-ec69-134d-aee4-1e32dd646568"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"090f7591-4108-9f4e-9635-49f5e33dfb69"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TransformTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/TransformTensor"], "[", 
   RowBox[{
    StyleBox["tensor", "TI"], ",", 
    StyleBox["disp", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e028411e-965e-144b-a434-3dbee01d7571"],
 "\[LineSeparator]corrects the ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "43a5b43e-7a66-0b4c-bcd6-cf0c64965b90"],
 " with voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "ba475e1a-22b9-5d4e-8971-62a18de4c1ff"],
 " based on the displacement field ",
 Cell[BoxData[
  StyleBox["disp", "TI"]], "InlineFormula",ExpressionUUID->
  "33b9accd-c68e-3042-ba7f-804fc176495e"],
 ". The displacement field is te displacement in mm for each voxel location \
in x, y and z. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f2ee50c2-7fef-6145-b7fd-cf1f758a02de"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TransformTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/TransformTensor"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "4671d809-c241-7c47-bf85-1b7998b12761"],
 "\[LineSeparator]is based on DOI: 10.1109/42.963816."
}], "Usage",
 CellChangeTimes->{{3.996656273913416*^9, 3.996656274061077*^9}},
 CellID->715729531,ExpressionUUID->"da0d5e94-4581-fe40-8751-ab97e6a8e332"],

