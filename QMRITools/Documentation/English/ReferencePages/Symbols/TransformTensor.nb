Notebook[{

Cell[CellGroupData[{
Cell["TransformTensor", "ObjectName",
 CellID->74987276,ExpressionUUID->"c2d9ce4b-fcb0-b841-a4fe-6258c9e973d1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1ec198e9-45a3-0f4c-b933-28a7a0ebee53"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TransformTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/TransformTensor"], "[", 
   RowBox[{
    StyleBox["tensor", "TI"], ",", 
    StyleBox["disp", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3da1a182-ded2-a04a-bcf2-4cdf0f350d71"],
 "\[LineSeparator]corrects the ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "3506ff46-67c1-6747-b22b-c46d69626e1e"],
 " with voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "c817249f-46f3-fb45-a6e4-da4e939a43b4"],
 " based on the displacement field ",
 Cell[BoxData[
  StyleBox["disp", "TI"]], "InlineFormula",ExpressionUUID->
  "386f9323-5a7b-d049-9103-c47840d163e0"],
 ". The displacement field is the displacement in mm for each voxel location, \
in the array order {z, y, x} of the data and ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "6a55f4d8-13dd-9648-8c02-39c0cfab4b43"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ffa21e17-4741-a240-8eec-bdc14ee62f71"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TransformTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/TransformTensor"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "3e391b5d-e128-1045-a669-ca9e7a568bc5"],
 "\[LineSeparator]is based on DOI: 10.1109/42.963816."
}], "Usage",
 CellChangeTimes->{{4.0038045961912537`*^9, 4.003804596361681*^9}},
 CellID->23165927,ExpressionUUID->"5c98c8bf-4501-c946-b652-392e8c33d444"],

