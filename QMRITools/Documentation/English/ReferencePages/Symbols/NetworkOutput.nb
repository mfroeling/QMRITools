Cell[CellGroupData[{
Cell["NetworkOutput", "ObjectName",
 CellID->647756349,ExpressionUUID->"557f22d0-b15c-f34f-bf5e-88bff2d5b9a6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ecbc33a9-0b0d-1643-ba8d-ae564d0e5bc0"],
 Cell[BoxData[
 "NetworkOutput"], "InlineFormula",ExpressionUUID->
  "09696faa-ee89-914e-a2d1-e623cf99fbe1"],
 "\[LineSeparator]is an option for ApplySegmentationNetwork. Can be \
\"Segmentation\" (default) to return the segmentation, \"Confidence\" to \
return the per-voxel class confidence (see ClassConfidence), \"Both\" to \
return {segmentation, confidence}, or \"Volume\" for a network that outputs a \
reconstructed volume rather than class probabilities (e.g. a self-supervised \
pretrained network), which merges patches without ClassDecoder."
}], "Usage",
 CellID->496001072,ExpressionUUID->"c33a7fa5-ed14-0445-999b-8770e0aa0523"],

