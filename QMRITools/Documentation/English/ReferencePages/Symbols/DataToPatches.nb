Notebook[{

Cell[CellGroupData[{
Cell["DataToPatches", "ObjectName",
 CellID->64999488,ExpressionUUID->"4337fca4-a131-9a48-9119-e8112bb92337"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"314c0bc6-2d9e-9949-b234-433506d90ee5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DataToPatches",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/DataToPatches"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["patchSize", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3084d90e-645c-f842-8b98-90caa08fa9ff"],
 "\[LineSeparator]creates non-overlapping patches covering ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "5e65a173-3cea-0643-9a90-666641f8be00"],
 " with minimal overlap. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"826881e0-29b8-0447-a1a4-e0ed7f237ab7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DataToPatches",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/DataToPatches"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["patchSize", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "83994bbf-9d36-b54a-8c28-df07be9ece9c"],
 "\[LineSeparator]creates patches with ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "2789620e-0f70-6f45-9e28-ffe91157d9ae"],
 " additional overlap steps per dimension. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"67cd4a04-24f8-1547-b6e9-4bef2d167fba"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DataToPatches",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/DataToPatches"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["patchSize", "TI"], ",", 
    StyleBox["pts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "363bf72f-3478-7043-9c19-476cb2ef3bd2"],
 "\[LineSeparator]extracts patches at the given pre-computed ranges ",
 Cell[BoxData[
  StyleBox["pts", "TI"]], "InlineFormula",ExpressionUUID->
  "8d4a5813-0f90-0e4d-9af2-6e8171a78016"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e123ff7a-b4d7-c449-87dc-faeae6764ad0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DataToPatches",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/DataToPatches"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["pts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e1276efc-ed7e-9f4f-8c24-4810224fca6d"],
 "\[LineSeparator]extracts patches at ranges ",
 Cell[BoxData[
  StyleBox["pts", "TI"]], "InlineFormula",ExpressionUUID->
  "8cd4546a-f7ad-5444-9b90-d208c9edb301"],
 " without resizing. Output is {patches, ranges} where ranges can be passed \
to ",
 Cell[BoxData[
  ButtonBox["PatchesToData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PatchesToData"]], "InlineFormula",
  ExpressionUUID->"74efca19-5594-cf47-a060-0d2e7111ec43"],
 "."
}], "Usage",
 CellChangeTimes->{{3.996656588250166*^9, 3.996656588564253*^9}},
 CellID->353684251,ExpressionUUID->"e899147e-26f2-2841-9395-0ee66597dd99"],

Cell["The following options can be given: ", "Notes",
 CellID->480462874,ExpressionUUID->"eb52ada1-933a-b44b-a4b8-5a3810500dbb"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "84bb4416-d983-6b48-a66c-692e28c0d6ac"], 
    ButtonBox["PatchNumber",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PatchNumber"], "0", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PatchNumber",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PatchNumber"]], "InlineFormula",
      ExpressionUUID->"edcf5895-a881-1d4d-93fc-c832871d8010"],
     " is an option for ",
     Cell[BoxData[
     "DataToPatches"], "InlineFormula",ExpressionUUID->
      "1af1f6d3-9201-f648-93b1-d48de03329b9"],
     ". Can be an integer value >= 0. The larger the number the more overlap \
the patches have.\nThe minimal number of patches in each direction is \
calculated, and then for each dimension the given number is added."
    }], "TableText",ExpressionUUID->"27c21ca0-49c4-b446-b3d8-d770fbe00fb0"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "42fb604e-6b1e-5c49-b310-b456a9fa34e9"], 
    ButtonBox["PatchPadding",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PatchPadding"], "0", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PatchPadding",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PatchPadding"]], "InlineFormula",
      ExpressionUUID->"84a725bb-36b4-cb4b-9e2a-433391309111"],
     " is an option for ",
     Cell[BoxData[
     "DataToPatches"], "InlineFormula",ExpressionUUID->
      "554ae9c5-578b-614f-9829-fe11d3e7916a"],
     ". Can be an integer value >= 0. It pads the chosen patch size with the \
given number."
    }], "TableText",ExpressionUUID->"fdc2fe2d-10f4-084b-95a8-4edb1dbc3c44"]}
  }]], "3ColumnTableMod",
 CellID->385702401,ExpressionUUID->"d38fc9ea-a24e-7147-b7a5-0c63477a41c5"]
}, Open  ]],

