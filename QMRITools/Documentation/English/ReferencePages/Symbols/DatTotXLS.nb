Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"19d4d48e-2754-6a48-aaee-234dc694fde4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DatTotXLS",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/DatTotXLS"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["data", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["data", "TI"], 
       StyleBox["2", "TR"]], ",", ".."}], "}"}], ",", 
    StyleBox["name", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "82a1cd5c-6128-1c47-85af-364ac0ccbd86"],
 "\[LineSeparator]is the same as ",
 Cell[BoxData[
  ButtonBox["DatTot",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/DatTot"]], "InlineFormula",
  ExpressionUUID->"816cb1fd-c533-774a-84f8-0232072ef2e7"],
 ", but gives the parameters as strings for easy export to excel."
}], "Usage",
