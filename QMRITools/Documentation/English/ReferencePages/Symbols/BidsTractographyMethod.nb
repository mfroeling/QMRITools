Cell["BidsTractographyMethod", "ObjectName",
 CellID->270180210,ExpressionUUID->"20c3cfad-f0a5-4542-b614-6ba5012c4190"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"45859661-e240-1945-824f-8d3ad4c06d56"],
 Cell[BoxData[
 "BidsTractographyMethod"], "InlineFormula",ExpressionUUID->
  "e8866ed3-5ddb-3546-a317-37e84e32aa4b"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["MuscleBidsTractography",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MuscleBidsTractography"]], 
  "InlineFormula",ExpressionUUID->"c21d8ac6-18f5-9d4f-9631-580134430d01"],
 " and can be \"Full\", \"Tractography\" or \"Segmentation\". With \
\"Tractography\" the tractography is performed without segmentation. With \
\"Segmentation\" only the segmentation is performed without tractography. \
With Full both are performed."
}], "Usage",
 CellID->172484557,ExpressionUUID->"28d5570c-d763-fe4c-a8a4-5309780f71ee"],

