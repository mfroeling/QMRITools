Cell[CellGroupData[{
Cell["GetSpectraBasisFunctions", "ObjectName",
 CellID->331346588,ExpressionUUID->"f53379d0-7dc4-344c-9899-c8c274a0e264"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6baaeaed-f16a-954f-a9b2-dd891389fe46"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetSpectraBasisFunctions",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/GetSpectraBasisFunctions"], 
   "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["met", "TI"], 
      StyleBox["1", "TR"]], ",", " ", 
     StyleBox["\[Ellipsis]", "TR"], ",", 
     StyleBox["metN", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "ad76335b-4a6e-ee42-98db-aebc4b70ad5f"],
 "\[LineSeparator]generates a list of spectra basis functions with names met1 \
to metN. The names are strings and are the metabolites available in ",
 Cell[BoxData[
  ButtonBox["GetSpinSystem",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetSpinSystem"]], "InlineFormula",
  ExpressionUUID->"fb5660ea-5dcd-da43-a112-b3d7a9ebe5de"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"49d58375-7ab1-544f-b8a7-ca697e24044c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetSpectraBasisFunctions",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/GetSpectraBasisFunctions"], 
   "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      SubscriptBox[
       StyleBox["prop", "TI"], 
       StyleBox["1", "TR"]], "}"}], ",", " ", 
     StyleBox["\[Ellipsis]", "TR"], ",", 
     RowBox[{"{", 
      StyleBox["propN", "TI"], "}"}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"6f9bce0e-24f5-5a4b-a301-89fa1a8e4683"],
 "\[LineSeparator]generates a list of spectra basis functions with properties \
prop1 to propN. The properties are those specified in ",
 Cell[BoxData[
  ButtonBox["MakeSpinSystem",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeSpinSystem"]], "InlineFormula",
  ExpressionUUID->"fbf0436e-c065-484b-aad1-7b23382d2a81"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b63a0bdb-94af-5d4c-bbb6-28408c63d01c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetSpectraBasisFunctions",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/GetSpectraBasisFunctions"], 
   "[", 
   RowBox[{
    StyleBox["inp", "TI"], ",", 
    StyleBox["split", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f3691b98-9eca-2e4f-8f19-e33b7e5e9b62"],
 "\[LineSeparator]generates a list of spectra basis functions. Each \
metabolite name present in the list ",
 Cell[BoxData[
  StyleBox["split", "TI"]], "InlineFormula",ExpressionUUID->
  "3153b941-3d9b-a54c-8075-c8e6b3548449"],
 " wil be ",
 Cell[BoxData[
  StyleBox["split", "TI"]], "InlineFormula",ExpressionUUID->
  "50f54df4-a2ff-6a45-9d09-e04d339640c1"],
 " in individual spectra per peak."
}], "Usage",
 CellChangeTimes->{{3.9966555759472904`*^9, 3.996655576241455*^9}},
 CellID->781666346,ExpressionUUID->"be1fe343-ec06-5743-9e3a-33670a369155"],

