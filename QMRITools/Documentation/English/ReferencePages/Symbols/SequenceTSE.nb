Notebook[{

Cell[CellGroupData[{
Cell["SequenceTSE", "ObjectName",
 CellID->246408958,ExpressionUUID->"9be4058e-d8d6-cb44-9e49-ee6235019fbb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6fd57230-13d6-874b-90e2-11a39620a480"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SequenceTSE",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SequenceTSE"], "[", 
   RowBox[{
    StyleBox["din", "TI"], " ", ",", 
    StyleBox["ham", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["te", "TI"], ",", 
      StyleBox["nEcho", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ex", "TI"], ",", 
      StyleBox["ref", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"80e02b33-47f9-4e46-af60-1c6c49a97ea5"],
 "\[LineSeparator]performs a multi echo spin echo experiment with echo time \
te with nEcho echos of the spin system din given the hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "25d3d340-b69b-a149-9d8a-8e2e3fa249d5"],
 " using ex Degree excitation and ref Degree refocus pulses. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"75a0f4d7-094c-6946-b240-20adf804e20e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SequenceTSE",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SequenceTSE"], "[", 
   RowBox[{
    StyleBox["din", "TI"], " ", ",", 
    StyleBox["ham", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["te", "TI"], ",", 
      StyleBox["nEcho", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["ex", "TI"], ",", 
      StyleBox["ref", "TI"]}], "}"}], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["1", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "83492af2-f815-9644-971b-b2ae148b4e52"],
 "\[LineSeparator]performs a multi echo spin echo experiment with echo time \
te with nEcho echos of the spin system din given the hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "f9475094-9f34-2344-ad62-e5c5dd62adc3"],
 " using ex Degree excitation and ref Degree refocus pulses and ",
 Cell[BoxData[
  StyleBox["b1", "TI"]], "InlineFormula",ExpressionUUID->
  "dce44b5e-9d75-0343-8fbf-c9acfcf97c8e"],
 ". The te is defined in ms, the ex and ref are defined in degree and ",
 Cell[BoxData[
  StyleBox["b1", "TI"]], "InlineFormula",ExpressionUUID->
  "6e18f3b9-03bb-6a42-b8f6-747a65583f02"],
 " of 100% is defined as 1. The output is a new spin system dOut."
}], "Usage",
 CellChangeTimes->{{3.9966566644977093`*^9, 3.9966566646932125`*^9}},
 CellID->64712048,ExpressionUUID->"2c328127-4bf3-414c-a60c-220dda4a8e57"],

