Cell[CellGroupData[{
Cell["GradientCoilTensor", "ObjectName",
 CellID->71978051,ExpressionUUID->"70d818d7-d2a7-7e4b-97b8-c037398b60b4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"17dfe7d1-7ead-964a-9cb7-3e6ae320db69"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GradientCoilTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GradientCoilTensor"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["off", "TI"], ",", 
    StyleBox["dint", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "00b9a0e7-adb2-584d-a083-0e67f7c68c09"],
 "\[LineSeparator]makes the gradient coil tensor from the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "c5b074b5-31f7-b145-9b76-df6bc11fbc78"],
 ", with the resolution defined by ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "f3edadec-8007-9a4a-8fb0-a513b31f5b59"],
 ". The offset ",
 Cell[BoxData[
  StyleBox["off", "TI"]], "InlineFormula",ExpressionUUID->
  "431a50b2-fc5a-1c41-b7dc-3586963a9a03"],
 " is the left most ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "1b2478e1-1438-d141-b5fc-2b036d76abf7"],
 " coordinate in the scanner coordinate systeme and the gradient tensor ",
 Cell[BoxData[
  StyleBox["dint", "TI"]], "InlineFormula",ExpressionUUID->
  "185f3d0e-19c9-5144-81dc-1cc4bda80e2e"],
 " comes from the function ",
 Cell[BoxData[
  ButtonBox["MakeGradientDerivatives",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeGradientDerivatives"]], 
  "InlineFormula",ExpressionUUID->"97691a0e-407c-cd4d-8051-9edbdf2fab73"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9966556608838997`*^9, 3.996655660985241*^9}},
 CellID->162060178,ExpressionUUID->"315cea5e-d696-ca44-a7ca-369bca80f2e9"],

