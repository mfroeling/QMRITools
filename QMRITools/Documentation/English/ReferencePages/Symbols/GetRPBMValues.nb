Notebook[{

Cell[CellGroupData[{
Cell["GetRPBMValues", "ObjectName",
 CellID->43187858,ExpressionUUID->"cdd44b82-364b-9a46-a115-e38219fcc4b2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"680fa9ad-1499-4843-bdae-ebef380ea56e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetRPBMValues",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/GetRPBMValues"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["0", "TR"]], ",", 
     StyleBox["tau", "TI"], ",", 
     StyleBox["zeta", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "1d68db16-ba5a-8243-9fb6-3786f0c06f78"],
 "\[LineSeparator]derives parameters from RPBM function. d0, ",
 Cell[BoxData[
  StyleBox["tau", "TI"]], "InlineFormula",ExpressionUUID->
  "90921465-128b-494f-9039-6fdfbdb03aa8"],
 " and zeta are the parameters of the RPBM function. output is a list \
containing {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "d0"}], "TI"]], "InlineFormula",ExpressionUUID->
  "32f5113b-4694-4b4a-bf34-69e8f9dab9af"],
 "d0, ",
 Cell[BoxData[
  StyleBox["tau", "TI"]], "InlineFormula",ExpressionUUID->
  "83b99403-e5a7-c643-93d1-94281db6e330"],
 ", zeta, dInf, td, tr, I, sv, a, kappa}."
}], "Usage",
 CellChangeTimes->{{4.0038045323205757`*^9, 4.003804532440811*^9}},
 CellID->153281103,ExpressionUUID->"ecde6d3c-d280-9540-82f7-025b423089fc"],

