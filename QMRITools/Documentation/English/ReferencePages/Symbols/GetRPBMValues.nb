Notebook[{

Cell[CellGroupData[{
Cell["GetRPBMValues", "ObjectName",
 CellID->604518130,ExpressionUUID->"2dba336b-9cde-7e49-8980-8910b410382e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3504c84b-dcae-7147-bb74-c77b20f5cf1f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetRPBMValues",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/GetRPBMValues"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["0", "TR"]], ",", 
     StyleBox["tau", "TI"], ",", 
     StyleBox["zeta", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "996558ee-13ae-af47-a3de-56037f8c5bdf"],
 "\[LineSeparator]derives parameters from RPBM function. d0, ",
 Cell[BoxData[
  StyleBox["tau", "TI"]], "InlineFormula",ExpressionUUID->
  "acac565d-5ba7-3347-b62c-42378690cc4e"],
 " and zeta are the parameters of the RPBM function. output is a list \
containing {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "d0"}], "TI"]], "InlineFormula",ExpressionUUID->
  "87a15871-8bd3-204a-a23a-9a85fd6a7c00"],
 "d0, ",
 Cell[BoxData[
  StyleBox["tau", "TI"]], "InlineFormula",ExpressionUUID->
  "f13bb140-ccd7-0149-956c-3d160cdd6242"],
 ", zeta, dInf, td, tr, I, sv, a, kappa}."
}], "Usage",
 CellChangeTimes->{{3.9966564065697575`*^9, 3.9966564066495857`*^9}},
 CellID->469696961,ExpressionUUID->"f7f10845-d259-7d46-908b-4bb2707baf2f"],

