Notebook[{

Cell[CellGroupData[{
Cell["GetRPBMValues", "ObjectName",
 CellID->35653448,ExpressionUUID->"0c9ecc83-8f46-854f-88cf-97d1dc88d0a7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"44959c40-6c50-d84d-95c4-700de12c70c5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetRPBMValues",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/GetRPBMValues"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["d", "TI"], 
      StyleBox["0", "TR"]], ",", 
     StyleBox["tau", "TI"], ",", 
     StyleBox["zeta", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "f5303981-6a07-d342-b223-b54d0556ef65"],
 "\[LineSeparator]derives parameters from RPBM function. d0, ",
 Cell[BoxData[
  StyleBox["tau", "TI"]], "InlineFormula",ExpressionUUID->
  "8bc5b2bc-1bce-6e43-a0ce-2773ecb8cfc6"],
 " and zeta are the parameters of the RPBM function. output is a list \
containing {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "d0"}], "TI"]], "InlineFormula",ExpressionUUID->
  "9aae4179-8253-8e4c-ab69-715e32f52a16"],
 "d0, ",
 Cell[BoxData[
  StyleBox["tau", "TI"]], "InlineFormula",ExpressionUUID->
  "7b7277f8-d2ca-2046-8be9-701d0d9b69fd"],
 ", zeta, dInf, td, tr, I, sv, a, kappa}."
}], "Usage",
 CellChangeTimes->{{3.998533227813595*^9, 3.9985332279190025`*^9}},
 CellID->194300079,ExpressionUUID->"139e9d6a-aef3-a748-9add-e94f529aec4f"],

