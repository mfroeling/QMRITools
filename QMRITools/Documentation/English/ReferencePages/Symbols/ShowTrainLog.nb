Notebook[{

Cell[CellGroupData[{
Cell["ShowTrainLog", "ObjectName",
 CellID->6058607,ExpressionUUID->"f94405b1-2d7f-f840-b413-16feda2527db"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0c0660b7-2a20-3149-95eb-65ed71732dac"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ShowTrainLog",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/ShowTrainLog"], "[", 
   StyleBox["folder", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "459486ee-c959-f748-82e5-a00401b18701"],
 "\[LineSeparator]shows an interactive plot of the training log stored in ",
 Cell[BoxData[
  StyleBox["folder", "TI"]], "InlineFormula",ExpressionUUID->
  "1d4c38fb-da87-3f48-891c-8a8fba128fc9"],
 " as JSON files. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"443fa82d-8495-b14e-8df4-1db0ff76eb36"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ShowTrainLog",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/ShowTrainLog"], "[", 
   RowBox[{
    StyleBox["folder", "TI"], ",", 
    StyleBox["min", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c5e9d7a5-08e2-0e4f-bd15-ca3bd4bc555e"],
 "\[LineSeparator]filters rounds with fewer than ",
 Cell[BoxData[
  StyleBox["min", "TI"]], "InlineFormula",ExpressionUUID->
  "b78ff41c-39e3-1947-923d-c1ac9e0fa76c"],
 " progress entries. Default is 5. The interface allows selecting metrics, \
toggling log scale, Gaussian filtering, and live ",
 Cell[BoxData[
  StyleBox["folder", "TI"]], "InlineFormula",ExpressionUUID->
  "2cafe3f9-286e-4f4e-8bdc-7cfa0b74ca6a"],
 " reloading."
}], "Usage",
 CellChangeTimes->{{3.9966566024704285`*^9, 3.9966566026243*^9}},
 CellID->66823610,ExpressionUUID->"e6c4767f-ede2-0d47-88db-1d29a62c33b1"],

