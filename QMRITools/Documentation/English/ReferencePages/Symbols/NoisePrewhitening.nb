Cell["NoisePrewhitening", "ObjectName",
 CellID->717636497,ExpressionUUID->"9c45263f-726b-d449-bc0d-83e21d5ee35f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f62eb2f6-6fc7-0349-be39-f90af0e7c347"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NoisePrewhitening",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/NoisePrewhitening"], 
   "[", 
   RowBox[{
    StyleBox["sig", "TI"], ",", 
    StyleBox["cov", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2ead286e-1951-3a43-99a4-3234e66f4317"],
 "\[LineSeparator]prewhiten the signal ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "752d84e8-5b94-aa4c-a2a6-f115fa28652a"],
 " using the noise covariance matrix ",
 Cell[BoxData[
  StyleBox["cov", "TI"]], "InlineFormula",ExpressionUUID->
  "81c4862e-a8fe-dd48-83d9-fd11bfbf1347"],
 ". The signal and covariance matrix can be any dimension."
}], "Usage",
