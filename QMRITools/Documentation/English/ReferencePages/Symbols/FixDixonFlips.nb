Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"92962a0d-d247-2841-8f0f-67ba28c68cf1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FixDixonFlips",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/FixDixonFlips"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["mag", "TI"], ",", 
     StyleBox["phase", "TI"], ",", 
     StyleBox["real", "TI"], ",", 
     StyleBox["imag", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "6c31d30c-4015-4c48-8257-4de890cad7b2"],
 "\[LineSeparator]checks if any volumes are 180 degrees out of ",
 Cell[BoxData[
  StyleBox["phase", "TI"]], "InlineFormula",ExpressionUUID->
  "d8d59087-803d-2f4e-bfeb-caacbb577535"],
 " and corrects them."
}], "Usage",
