Notebook[{

Cell[CellGroupData[{
Cell["CreateT2Dictionary", "ObjectName",
 CellID->91207144,ExpressionUUID->"bbdad4cf-6385-4d4d-8a61-69beeadd0d6f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b2789c8b-0bdb-de4f-85ce-3dc507e4347c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CreateT2Dictionary",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/CreateT2Dictionary"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"T$1m", ",", "T$1f"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["nEcho", "TI"], ",", 
      StyleBox["detlaTE", "TI"]}], "}"}], ",", 
    StyleBox["angle", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0a0caf11-59a4-a941-beeb-8d88b5f05f4d"],
 "\[LineSeparator]Creates a EPG signal dictionary used for EPGT2fit. Every \
dictionary that is defined is cached. The output is in units as defined by \
the detlaTE, e.g. if detlaTE is in ms the output is in ms. The TR and TE \
should be in the same units as Dela. Output is {dictionary, vals}."
}], "Usage",
 CellChangeTimes->{3.9985331982618504`*^9},
 CellID->511801160,ExpressionUUID->"bf6caa45-c0e6-4d4a-88c8-77b65bfac305"],

Cell["The following options can be given: ", "Notes",
 CellID->164676095,ExpressionUUID->"a1e42e85-2252-7e47-9926-735abff88bf5"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4643c424-0263-424a-8958-809bcd4b1157"], 
    ButtonBox["DictB1Range",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/DictB1Range"], 
    RowBox[{"{", 
     RowBox[{"0.5", ",", " ", "1.4", ",", " ", "0.01"}], "}"}], Cell[TextData[{
     "DictB1Range is an option for ",
     Cell[BoxData[
     "CreateT2Dictionary"], "InlineFormula",ExpressionUUID->
      "358b3eec-0f07-4647-a7ea-209c80b2d401"],
     " and EPGT2Fit. It specifies the range and step of the b1 values in the \
dictionary {min, max, step}."
    }], "TableText",ExpressionUUID->"a84a8019-321c-5049-b635-9f2f20c599e0"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9c2a5b01-48b9-b24e-9805-f56d80e746ff"], 
    ButtonBox["DictT2Range",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/DictT2Range"], 
    RowBox[{"{", 
     RowBox[{"10.", ",", " ", "70.", ",", " ", "0.2"}], "}"}], Cell[TextData[{
     "DictT2Range is an option for ",
     Cell[BoxData[
     "CreateT2Dictionary"], "InlineFormula",ExpressionUUID->
      "8d9592ae-7cff-1f43-9091-ff8afba26e3f"],
     " and EPGT2Fit. is specifies the range and step of the t2 values in the \
dictionary {min, max, step} in ms."
    }], "TableText",ExpressionUUID->"6a0683a4-05ea-a948-9afe-2d5217305bd4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "fad9867e-0a66-0348-b6ef-2217ca325b66"], 
    ButtonBox["DictT2fRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/DictT2fRange"], 
    RowBox[{"{", 
     RowBox[{"100.", ",", " ", "200.", ",", " ", "2."}], "}"}], Cell[TextData[{
     "DictT2fRange is an option for ",
     Cell[BoxData[
     "CreateT2Dictionary"], "InlineFormula",ExpressionUUID->
      "7af8d0a3-e46d-8742-a2a3-28160fdbba72"],
     " and EPGT2Fit. is specifies the range and step of the t2 fat values in \
the dictionary {min, max, step} in ms. \nIf a single value is given this \
fixed value is used a long as EPGCalibrate is False."
    }], "TableText",ExpressionUUID->"d8e7c5d7-2721-9f4c-bee0-193ef16e76ef"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "8d7b9942-e8b7-0e4c-a259-f20148e3ed43"], 
    ButtonBox["DictT2IncludeWater",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/DictT2IncludeWater"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[
    "DictT2IncludeWater is an options for EPGT2Fit.", "TableText",
     ExpressionUUID->"fb163cbf-315b-154a-a1ad-88dab9c2d2ec"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e9631cda-706c-5c4b-a58a-680e956963a2"], 
    ButtonBox["EPGFatShift",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/EPGFatShift"], "0.", 
    Cell[TextData[{
     "EPGFatShift is an options for EPGT2Fit. Specifies the amount of shift \
of the fat refocusing pulse relative to the fat exitation pulse.\nCan be \
obtained form ",
     Cell[BoxData[
      ButtonBox["GetPulseProfile",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetPulseProfile"]], "InlineFormula",
      ExpressionUUID->"3defdbb2-90ec-884f-a9e4-553926a10529"],
     "."
    }], "TableText",ExpressionUUID->"f0d80e70-ef66-7b4b-a95f-24692b58865a"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a2b05d2d-1b9c-8240-b6fd-2627dfa9bcef"], 
    ButtonBox["MonitorCalc",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsProcessingTools/ref/MonitorCalc"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell["\<\
MonitorCalc is an option for many processing functions. When true the process \
of the calculation is shown.\
\>", "TableText",ExpressionUUID->"606de970-884b-8249-a290-ac51462eac98"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c937ed97-44d6-0545-a83c-08eaca9c48ec"], 
    ButtonBox["EPGRefocussingPhase",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/EPGRefocussingPhase"], 
    "0.", Cell[TextData[{
     "EPGRefocussingPhase is an option for EPGT2Fit and ",
     Cell[BoxData[
     "CreateT2Dictionary"], "InlineFormula",ExpressionUUID->
      "b50cd7f9-3162-4740-8aca-52287080adcf"],
     ". It specifies the phase of the refocussing pulse."
    }], "TableText",ExpressionUUID->"91ac9076-52c6-3f4a-81b2-602afcfe9ee4"]}
  }]], "3ColumnTableMod",
 CellID->541163389,ExpressionUUID->"d2a2c584-6d76-d74e-8e87-ae7c3d22a21f"]
}, Open  ]],

