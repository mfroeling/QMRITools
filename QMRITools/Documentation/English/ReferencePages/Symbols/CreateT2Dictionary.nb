Notebook[{

Cell[CellGroupData[{
Cell["CreateT2Dictionary", "ObjectName",
 CellID->366848721,ExpressionUUID->"81b1edc8-7e17-c941-ab89-362d3dab6ab2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1f73e402-d0f9-d942-b5c7-6fb15fc77d2f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CreateT2Dictionary",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/CreateT2Dictionary"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"T$1m", ",", "T$1f"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["nEcho", "TI"], ",", 
      StyleBox["detlaTE", "TI"]}], "}"}], ",", 
    StyleBox["angle", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "493105af-256b-3d4b-91bc-18f62542511d"],
 "\[LineSeparator]Creates a EPG signal dictionary used for EPGT2fit. The \
water signals of every dictionary are cached, the fat signals are \
recalculated each call. The output is in units as defined by the detlaTE, \
e.g. if detlaTE is in ms the output is in ms. The TR and TE should be in the \
same units as Dela. Output is {dictionary, vals}."
}], "Usage",
 CellChangeTimes->{4.0038045013670883`*^9},
 CellID->272343247,ExpressionUUID->"f57fe516-b206-164a-a1ee-64d57950686c"],

Cell["The following options can be given: ", "Notes",
 CellID->715286684,ExpressionUUID->"d98ca344-7d68-b245-b8f4-8862846382d3"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "87f5825d-3623-8447-b48b-30d79899a2ff"], 
    ButtonBox["DictB1Range",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/DictB1Range"], 
    RowBox[{"{", 
     RowBox[{"0.5", ",", " ", "1.4", ",", " ", "0.01"}], "}"}], Cell[TextData[{
     "DictB1Range is an option for ",
     Cell[BoxData[
     "CreateT2Dictionary"], "InlineFormula",ExpressionUUID->
      "7e396ef1-e93a-7a4c-aa6d-d6c0415965d5"],
     " and ",
     Cell[BoxData[
      ButtonBox["EPGT2Fit",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
      ExpressionUUID->"e14c0316-cef3-7644-914c-2e9a3b51fca1"],
     ". It specifies the range and step of the b1 values in the dictionary \
{min, max, step}."
    }], "TableText",ExpressionUUID->"cf279212-504f-ad4d-9434-b0e5d8a44038"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d857c732-332f-3546-a959-34a40e6591c1"], 
    ButtonBox["DictT2Range",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/DictT2Range"], 
    RowBox[{"{", 
     RowBox[{"10.", ",", " ", "70.", ",", " ", "0.2"}], "}"}], Cell[TextData[{
     "DictT2Range is an option for ",
     Cell[BoxData[
     "CreateT2Dictionary"], "InlineFormula",ExpressionUUID->
      "0d1935f0-c32a-bc45-8f25-d1d175d7e180"],
     " and ",
     Cell[BoxData[
      ButtonBox["EPGT2Fit",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
      ExpressionUUID->"a3c94f99-70d1-f240-bbee-2bae04390ae7"],
     ". is specifies the range and step of the t2 values in the dictionary \
{min, max, step} in ms."
    }], "TableText",ExpressionUUID->"ede6fc54-6414-ad40-b433-44aa990a0473"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6b64e753-cabe-5748-8d08-bb7cac7435b7"], 
    ButtonBox["DictT2fRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/DictT2fRange"], 
    RowBox[{"{", 
     RowBox[{"100.", ",", " ", "200.", ",", " ", "2."}], "}"}], Cell[TextData[{
     "DictT2fRange is an option for ",
     Cell[BoxData[
     "CreateT2Dictionary"], "InlineFormula",ExpressionUUID->
      "0a0424d4-5821-bb48-ac87-0407f8999520"],
     " and ",
     Cell[BoxData[
      ButtonBox["EPGT2Fit",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
      ExpressionUUID->"4e0094ed-91a0-f54e-a531-6450626698b9"],
     ". is specifies the range and step of the t2 fat values in the \
dictionary {min, max, step} in ms. \nIf a single value is given this fixed \
value is used a long as EPGCalibrate is False."
    }], "TableText",ExpressionUUID->"011c5a27-9a22-fb42-b879-cccd56eeeaa5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "23728782-0eec-4f49-88a9-d95eb42c5e7d"], 
    ButtonBox["DictT2IncludeWater",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DictT2IncludeWater"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["DictT2IncludeWater",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DictT2IncludeWater"]], 
      "InlineFormula",ExpressionUUID->"17f99f4f-50d1-0648-8c2d-aec4ceeaef58"],
     " is an options for ",
     Cell[BoxData[
      ButtonBox["EPGT2Fit",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
      ExpressionUUID->"80a6f9a3-194a-3344-861c-e858c769ed06"],
     " and ",
     Cell[BoxData[
     "CreateT2Dictionary"], "InlineFormula",ExpressionUUID->
      "2efb7d25-5d3c-ba48-b579-41d720a0a80b"],
     ". If ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "ccbaf404-9b68-5140-993d-002d9c0e362d"],
     " the fat signal is modeled as adipose tissue with 90% lipid and 10% \
water with a t2 of 20 ms.\nThe water and fat outputs of ",
     Cell[BoxData[
      ButtonBox["EPGT2Fit",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
      ExpressionUUID->"2e4372e9-5a92-bb42-8adf-2de319314690"],
     " are then the water and lipid signals and the fat fraction is the lipid \
fraction, as reported by Dixon.\nBased on Keene KR et.al. DOI: \
10.1002/mrm.28290."
    }], "TableText",ExpressionUUID->"ab224867-26e2-9f4e-9f71-3e585a52152d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "da39bc59-262b-dc40-81ac-6435507894d1"], 
    ButtonBox["EPGFatShift",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/EPGFatShift"], "0.", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["EPGFatShift",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGFatShift"]], "InlineFormula",
      ExpressionUUID->"2a91729b-bff9-a14c-b203-b4661237cb78"],
     " is an options for ",
     Cell[BoxData[
      ButtonBox["EPGT2Fit",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
      ExpressionUUID->"c5460caf-be9f-4f4f-bde0-d783dc86d97b"],
     ". Specifies the amount of shift of the fat refocusing pulse relative to \
the fat exitation pulse in slice profile samples, the sign does not matter.\n\
Can be obtained form ",
     Cell[BoxData[
      ButtonBox["GetPulseProfile",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetPulseProfile"]], "InlineFormula",
      ExpressionUUID->"6a0b2dba-f413-cd4c-996c-457830ff2379"],
     " with FatFieldStrength."
    }], "TableText",ExpressionUUID->"2df20006-6218-5b4a-bd04-3aec48124929"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c1e112c0-1500-0d47-b3e1-63b438d60980"], 
    ButtonBox["MonitorCalc",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsProcessingTools/ref/MonitorCalc"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell["\<\
MonitorCalc is an option for many processing functions. When true the process \
of the calculation is shown.\
\>", "TableText",ExpressionUUID->"755178dc-c76d-f34c-bce6-dd6df65475b2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
