Cell[CellGroupData[{
Cell["MaskDilation", "ObjectName",
 CellID->455219487,ExpressionUUID->"5ace8c83-e008-bb4b-8e0d-c7ee87b34726"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"00c897d6-5cba-0242-b6e5-d2a170089f7c"],
 Cell[BoxData[
 "MaskDilation"], "InlineFormula",ExpressionUUID->
  "2f86d46e-8701-274d-9a5a-fbc353d5ab9a"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["Mask",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/Mask"]], "InlineFormula",ExpressionUUID->
  "6920936f-c3cf-ac45-8cd4-39e5b4fa21f8"],
 ", ",
 Cell[BoxData[
  ButtonBox["SmoothMask",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SmoothMask"]], "InlineFormula",
  ExpressionUUID->"e0916ae9-117a-514e-8cc0-e1d782cb0bf4"],
 " and ",
 Cell[BoxData[
  ButtonBox["SmoothSegmentation",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SmoothSegmentation"]], "InlineFormula",
  ExpressionUUID->"2e12b1df-a788-bf41-8cf9-434095e0abf7"],
 ". If the value is greater than 0 it will dilate the mask, if the value is \
smaller than 0 it will erode the mask."
}], "Usage",
 CellID->702167048,ExpressionUUID->"7cde2603-5d42-5a4a-895b-8f6754d9622e"],

