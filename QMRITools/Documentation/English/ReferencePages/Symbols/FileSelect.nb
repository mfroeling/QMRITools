Cell[CellGroupData[{
Cell["FileSelect", "ObjectName",
 CellID->187284584,ExpressionUUID->"44c465e6-548b-324d-bdf8-8b5250702b1e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b3aa7b51-506e-1248-b01d-b9edc7cca79a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FileSelect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/FileSelect"], "[", 
   StyleBox["action", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "80459d61-721c-084b-bf59-4b04ea7b5335"],
 "\[LineSeparator]creates a system dialog which returns file/foldername ",
 Cell[BoxData[
  StyleBox["action", "TI"]], "InlineFormula",ExpressionUUID->
  "1bf9551a-2ce7-8441-95b0-d4414c6af602"],
 " can be \"FileOpen\",\"FileSave\" or \"Directory\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"590a06c6-009a-504e-acb3-ed69489b886b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FileSelect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/FileSelect"], "[", 
   RowBox[{
    StyleBox["action", "TI"], ",", 
    RowBox[{"{", 
     StyleBox["type", "TI"], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "701c2cfb-633b-0f4e-9c84-1f7e4720ce57"],
 "\[LineSeparator]same but allows the definition of filetypes for \
\"FileOpen\" and \"FileSave\" e.g. \"jpg\" or \"pdf\"."
}], "Usage",
