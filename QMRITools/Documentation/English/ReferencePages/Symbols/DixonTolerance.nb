Notebook[{

Cell[CellGroupData[{
Cell["DixonTolerance", "ObjectName",
 CellID->42495662,ExpressionUUID->"cfa608e1-e6d5-eb40-b7db-8ce8a20e21bb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a7f7b31f-615a-e643-80b6-11685c87f22e"],
 Cell[BoxData[
 "DixonTolerance"], "InlineFormula",ExpressionUUID->
  "0d69578b-60e3-214c-8a24-fba3b520680f"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["DixonReconstruct",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/DixonReconstruct"]], "InlineFormula",
  ExpressionUUID->"bdbf3e8b-6428-e442-9e04-5c0f8272dffb"],
 ". Defines at which change per iteration the iterative method stops. The \
change is the sum of R2star (1/s) and b0 (Hz) plus 100 times the phases \
(cycles) and bipolar phase drift (Hz). ",
 Cell[BoxData[
  ButtonBox["Default",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "96aaebf9-ee78-0c49-af69-13e0038dfa7a"],
 " value is 1."
}], "Usage",
 CellChangeTimes->{4.003804510408001*^9},
 CellID->14796288,ExpressionUUID->"ec67988f-866f-c347-bcd1-df36e64a2493"],

