Cell["TransformMethod", "ObjectName",
 CellID->431298909,ExpressionUUID->"e04765bf-943e-0c4f-b779-c6bc68bb8f4b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f1a6e99c-6684-2d4f-a087-5a94112da234"],
 Cell[BoxData[
 "TransformMethod"], "InlineFormula",ExpressionUUID->
  "7ecd838c-1df0-a44b-a2cb-167d87cfd8bf"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["RegisterDataSplit",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterDataSplit"]], "InlineFormula",
  ExpressionUUID->"180aff05-effb-fa4d-a7d0-fd99b64e96db"],
 " and ",
 Cell[BoxData[
  ButtonBox["RegisterDataTransformSplit",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterDataTransformSplit"]], 
  "InlineFormula",ExpressionUUID->"6ce885ee-8648-be46-b0ac-2ebcf4453045"],
 ". values can be \"Data\", \"Mask\", \"Segmentation\". If set to \"Mask\" a \
binary mask is expected as the second moving input. If set to \
\"Segmentation\" a multi label segmentation is expected as the second moving \
input. Uses ",
 Cell[BoxData[
  ButtonBox["SplitSegmentations",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SplitSegmentations"]], "InlineFormula",
  ExpressionUUID->"381e1574-f3a0-0246-9271-013c99f24dc6"],
 " internally then."
}], "Usage",
 CellID->104503617,ExpressionUUID->"878f37be-4716-c744-bed0-6330aed2920e"],

