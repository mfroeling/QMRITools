Notebook[{

Cell[CellGroupData[{
Cell["EPGSmoothB1", "ObjectName",
 CellID->20225729,ExpressionUUID->"1dbbf9c3-d02f-eb48-854d-1963101e6d4a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"052a322d-ff6c-e542-b83a-85f3358df1f9"],
 Cell[BoxData[
 "EPGSmoothB1"], "InlineFormula",ExpressionUUID->
  "1a10bce8-8f2e-be45-9717-de8273393851"],
 "\[LineSeparator]is an options for ",
 Cell[BoxData[
  ButtonBox["EPGT2Fit",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
  ExpressionUUID->"604a2326-3bda-534a-a2e9-b079610113ce"],
 ". If set to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "f2551e7e-c855-1043-8dbc-d2ec3038170d"],
 " or a radius the b1 is fitted on the dictionary cost pooled over the \
neighbouring voxels (radius 2 for True), after which the minimization is \
performed again with this fixed b1."
}], "Usage",
 CellChangeTimes->{4.0038045147406025`*^9},
 CellID->141404144,ExpressionUUID->"9ccc1c89-f21d-c64c-88af-90eb296e2d0d"],

