Notebook[{

Cell[CellGroupData[{
Cell["MakeNoisePlots", "ObjectName",
 CellID->44496390,ExpressionUUID->"bb3f0633-6381-9644-8e11-b188fc417609"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8e41745d-ad29-ef47-99cf-99f8276048eb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeNoisePlots",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeNoisePlots"], "[", 
   StyleBox["noise", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9b81d021-5264-2e49-bfef-65b416ba8ff4"],
 "\[LineSeparator]returns a grid of plots of the ",
 Cell[BoxData[
  StyleBox["noise", "TI"]], "InlineFormula",ExpressionUUID->
  "1e1de10c-4246-7844-bfb1-ebaea1df0ade"],
 " per channel \n",
 Cell["   ", "ModInfo",ExpressionUUID->"cc55e398-48b8-ec4c-99c0-a73f730a1f65"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeNoisePlots",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeNoisePlots"], "[", 
   RowBox[{
    StyleBox["noise", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["met", "TI"], ",", 
      StyleBox["prt", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"1d3187ed-728f-b240-b5f1-aa4528e7caeb"],
 "\[LineSeparator]met can be \"Grid\" with prt a number or Automatic. Else \
all plots will be returend as a list of plots. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"04619014-58a0-8642-b6ea-96e2af9b82af"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeNoisePlots",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeNoisePlots"], "[", 
   RowBox[{
    StyleBox["noise", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["met", "TI"], ",", 
      StyleBox["prt", "TI"]}], "}"}], ",", 
    StyleBox["sub", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "549a8b99-096a-3b45-97d6-a7b8512c7c4e"],
 "\[LineSeparator]sub defines how much the ",
 Cell[BoxData[
  StyleBox["noise", "TI"]], "InlineFormula",ExpressionUUID->
  "60ad2585-c6b5-9743-b879-bde7c048ca5a"],
 " is subsampled, default is 40 (every 40th sample is used in plot)."
}], "Usage",
 CellChangeTimes->{{3.996656336586691*^9, 3.9966563368115463`*^9}},
 CellID->679931489,ExpressionUUID->"b5ce33fc-f9c2-4b4e-87db-51ebb2cb012a"],

