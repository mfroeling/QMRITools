 Cell[BoxData[
 "TemplateOutput"], "InlineFormula",ExpressionUUID->
  "2c0975ad-fcd7-7f41-b4d0-520b922395d0"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["TemplateToVolume",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/TemplateToVolume"]], "InlineFormula",
  ExpressionUUID->"4beac84a-0477-1d4e-a7ec-67b995dfc394"],
 ". The value can be \"Meshes\" \"PointsCells\" or \"Points\". The \"Meshes\" \
\"PointsCells\" outputs are needed for template and model visualization. The \
\"Points\" is the only thing needed for model fitting."
}], "Usage",
 CellID->58521078,ExpressionUUID->"df5875fe-ee3a-d342-9034-cd8d3cab76ed"],

