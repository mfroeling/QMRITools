Notebook[{

Cell[CellGroupData[{
Cell["FindInPhaseEchos", "ObjectName",
 CellID->342077547,ExpressionUUID->"7a734219-9179-e14a-a536-39feb3e6b4b9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ba5fb1cd-66b9-6b4c-8f9e-0a971608e4e8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindInPhaseEchos",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/FindInPhaseEchos"], "[", 
   RowBox[{
    StyleBox["echos", "TI"], ",", 
    StyleBox["iop", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d8bf8b54-1811-cf43-8ec0-898cef5bf8cc"],
 "\[LineSeparator]finds the two nearest ",
 Cell[BoxData[
  StyleBox["echos", "TI"]], "InlineFormula",ExpressionUUID->
  "61bd8753-32ba-b741-aed9-addf63e04e31"],
 " to inphase which are best used for unwrapping using the ",
 Cell[BoxData[
  StyleBox["iop", "TI"]], "InlineFormula",ExpressionUUID->
  "4338cd1e-2e68-fd46-82e9-aa3960b4574e"],
 " time."
}], "Usage",
 CellChangeTimes->{{3.996656253943987*^9, 3.996656254023056*^9}},
 CellID->462539389,ExpressionUUID->"d48c91bd-ddf8-6146-81c0-1bc4a2715102"],

Cell["The following options can be given: ", "Notes",
 CellID->1344919,ExpressionUUID->"5b596f4b-198d-2540-b5bf-35f374502cbb"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "44bfec3e-659a-8546-b559-eb7f0de9e1ba"], 
    ButtonBox["DixonBipolar",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DixonBipolar"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["DixonBipolar",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DixonBipolar"]], "InlineFormula",
      ExpressionUUID->"5e33856c-beef-2b48-a2c3-3cb2d84a3faf"],
     " is an option for ",
     Cell[BoxData[
     "FindInPhaseEchos"], "InlineFormula",ExpressionUUID->
      "fe52e2b3-f979-af40-acbc-11401deb50e6"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "28d51d52-cb73-2647-840e-0ead53ce04dc"],
     " the found echos will always be of the same polaritiy."
    }], "TableText",ExpressionUUID->"c2f622f8-7e81-4044-88a7-b83f920fa394"]}
  }]], "3ColumnTableMod",
 CellID->183131145,ExpressionUUID->"7c6c839e-6d41-cf48-aa44-0c4cfbfbb257"]
}, Open  ]],

