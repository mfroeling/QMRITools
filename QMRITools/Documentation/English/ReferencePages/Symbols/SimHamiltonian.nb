Cell[CellGroupData[{
Cell["SimHamiltonian", "ObjectName",
 CellID->246011461,ExpressionUUID->"cb29f8d9-0edf-2643-80c1-9d9ee3c47c08"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d47051d0-1fc0-574a-959e-16d412faf545"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimHamiltonian",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SimHamiltonian"], "[", 
   StyleBox["sys", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "87082d9b-ba4b-3c45-b2dd-f0328a2e6777"],
 "\[LineSeparator]simulates the hamiltonian for a given spin system. The spin \
system is generated by ",
 Cell[BoxData[
  ButtonBox["GetSpinSystem",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetSpinSystem"]], "InlineFormula",
  ExpressionUUID->"dd599df1-12a3-3745-ae71-6fa0c2294bfd"],
 ". The output is the spin system and hamiltonian structure. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"39824e5f-8501-a048-b299-eb03d8e27bf3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimHamiltonian",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SimHamiltonian"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "b11cb86c-06b8-454b-8e18-153a921baf99"],
 "\[LineSeparator]is based on DOI: 10.1016/j.jmr.2010.12.008 and \
10.1002/mrm.24340."
}], "Usage",
 CellChangeTimes->{{3.9966563225095997`*^9, 3.9966563225592155`*^9}},
 CellID->325498125,ExpressionUUID->"546fc302-070a-c141-b1c5-2ac6bf552a98"],

