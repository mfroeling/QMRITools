Notebook[{

Cell[CellGroupData[{
Cell["CoilWeightedRecon", "ObjectName",
 CellID->95731381,ExpressionUUID->"dfa21dcc-a58b-e044-84e1-354a391d4603"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f7f212d3-8131-8442-805c-7638b7ccdbab"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CoilWeightedRecon",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/CoilWeightedRecon"], 
   "[", 
   RowBox[{
    StyleBox["kspace", "TI"], ",", 
    StyleBox["noise", "TI"], ",", 
    StyleBox["head", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6008d47a-cc47-4d44-8a68-c6920a48350e"],
 "\[LineSeparator]performs reconstruction of raw MS2D MRI data. The input ",
 Cell[BoxData[
  StyleBox["kspace", "TI"]], "InlineFormula",ExpressionUUID->
  "6f284215-cf24-6c4c-9985-d660a204afee"],
 ", ",
 Cell[BoxData[
  StyleBox["noise", "TI"]], "InlineFormula",ExpressionUUID->
  "c5ac7eb0-d48f-1b41-a473-b0992d355abd"],
 " and ",
 Cell[BoxData[
  StyleBox["head", "TI"]], "InlineFormula",ExpressionUUID->
  "c55785ab-2739-b847-8348-df0dd6b2de48"],
 " are obtained using ",
 Cell[BoxData[
  ButtonBox["ReadListData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ReadListData"]], "InlineFormula",
  ExpressionUUID->"3c407516-89df-5b41-936b-01c4a50c3e09"],
 ". The coil combination Methods can be \"Roemer\" or \"RSS\"."
}], "Usage",
 CellChangeTimes->{{3.996655704106388*^9, 3.9966557041788216`*^9}},
 CellID->140040617,ExpressionUUID->"7071ce83-86c7-c44c-bcb5-51a3dbf98410"],

Cell["The following options can be given: ", "Notes",
 CellID->498288045,ExpressionUUID->"8dc9b479-357f-ad4d-9c33-65d65c231e05"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
