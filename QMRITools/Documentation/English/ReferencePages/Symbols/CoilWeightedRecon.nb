      ExpressionUUID->"ebebc123-526c-484e-94b8-bfee04fbcdcf"],
     " is an option for CoilWeighted recon. If true the reconstruction gets a \
hamming filter."
    }], "TableText",ExpressionUUID->"6ba07743-ad20-3844-88ea-ae612831a240"]}
  }]], "3ColumnTableMod",
