Notebook[{

Cell[CellGroupData[{
Cell["GetPulseProfile", "ObjectName",
 CellID->88950866,ExpressionUUID->"32c5b2dd-3114-e542-bb02-bf5d5716b61a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0dc760bb-4f58-4642-a0dd-44c86c8eb37c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetPulseProfile",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/GetPulseProfile"], "[", 
   RowBox[{
    StyleBox["excitation", "TI"], ",", 
    StyleBox["refocus", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1d9f0e1e-ce28-0e45-a0d2-37f7e4ada2f0"],
 "\[LineSeparator]gives the pulse angle profiles for the ",
 Cell[BoxData[
  StyleBox["excitation", "TI"]], "InlineFormula",ExpressionUUID->
  "faab936f-43c1-7947-b03d-604086b78fff"],
 " and refocusing pulses. a pulse is defined as {\"name\", flip angle, \
{G_strength, Dur, BW}}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ce97dc0b-28ae-9042-981b-51164bd43bff"],
 "GetPulseProfile[",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "\"\<name\>\""}], "TI"]], "InlineFormula",ExpressionUUID->
  "3f7b26ca-c785-f64f-adaf-0b94927d1336"],
 ",flip angle,{G_strength,Dur,BW}}]\[LineSeparator]gives detailed slice \
profile information of one pulse. output is {ex_angle_profile, \
ref_angel_profile, {plots}}. output for single pulse is {{distance, Mt, Mz, \
Mx, My, ang, phase}, plots}."
}], "Usage",
 CellChangeTimes->{{3.9966563000284576`*^9, 3.9966563001138916`*^9}},
 CellID->744262912,ExpressionUUID->"9db3946e-9704-ea45-83d8-8e17c98ffea0"],

Cell["The following options can be given: ", "Notes",
 CellID->572921375,ExpressionUUID->"522ebc8a-6d7e-a141-96ac-401ebd7b6727"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "297848a2-0d18-1e4c-9cb9-fdae2ec81729"], 
    ButtonBox["MagnetizationVector",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MagnetizationVector"], 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["MagnetizationVector",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MagnetizationVector"]], 
      "InlineFormula",ExpressionUUID->"7ccbc922-0209-1447-8915-9e21a6bdf969"],
     " is an option for ",
     Cell[BoxData[
     "GetPulseProfile"], "InlineFormula",ExpressionUUID->
      "07039267-3a94-5d4b-b437-49e2875cad61"],
     ". It defines the start magnetization vector for the bloch simulation."
    }], "TableText",ExpressionUUID->"374ee9d3-0e93-fc45-8e7b-9a798166af8e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b662658b-a982-e645-bd22-9fd5abba422c"], 
    ButtonBox["SliceRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SliceRange"], "12", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SliceRange",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SliceRange"]], "InlineFormula",
      ExpressionUUID->"1a48f155-c90c-0e4d-adee-1ee573b8d626"],
     " is an option for ",
     Cell[BoxData[
     "GetPulseProfile"], "InlineFormula",ExpressionUUID->
      "6024eef1-ae2d-c04c-bcbc-e711f156560c"],
     ". It specifies over which range the slice profile is generated (in mm). \
the total profile is 2x",
     Cell[BoxData[
      ButtonBox["SliceRange",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SliceRange"]], "InlineFormula",
      ExpressionUUID->"a303ce74-a859-b646-838d-2f674a8a0155"],
     "."
    }], "TableText",ExpressionUUID->"4eb8d0c4-004e-0b44-97fe-918a137a68ed"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7a10cb5f-a734-3a4e-989f-34887c07820d"], 
    ButtonBox["SliceRangeSamples",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SliceRangeSamples"], "25", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["SliceRange",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SliceRange"]], "InlineFormula",
      ExpressionUUID->"69836116-f7eb-ad4b-afef-aaff7ed10c26"],
     "Samples is an option for ",
     Cell[BoxData[
     "GetPulseProfile"], "InlineFormula",ExpressionUUID->
      "f7e69a52-3d09-d04a-9b2a-ea8d0f3f8dd0"],
     ". defines how many samples are used to generate half a puls profile."
    }], "TableText",ExpressionUUID->"0cee00ed-4841-994f-9618-03a6afac2562"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2cdb1947-1f9d-354a-ac29-4ab5866e327f"], 
    ButtonBox["FatFieldStrength",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/FatFieldStrength"], "0", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["FatFieldStrength",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/FatFieldStrength"]], "InlineFormula",
      ExpressionUUID->"beda7448-158b-0a4e-844f-67f5a261763f"],
     " is an option for ",
     Cell[BoxData[
     "GetPulseProfile"], "InlineFormula",ExpressionUUID->
      "f435b6d5-ca12-d740-8fd0-5071739f9e18"],
     ". If the value >0 it will calculate the shift of the fat refocusing \
pulse compared to the fat excitation pulse.\nThe shift is in ",
     Cell[BoxData[
      ButtonBox["SliceRange",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SliceRange"]], "InlineFormula",
      ExpressionUUID->"0ecc212d-a78b-1846-b2e8-89a3eb45c3b1"],
     "Samples steps."
    }], "TableText",ExpressionUUID->"a32f9934-be62-7a44-958b-d29de38d5775"]}
  }]], "3ColumnTableMod",
 CellID->53608194,ExpressionUUID->"de153771-faa4-1e40-84c5-e48e8a507a59"]
}, Open  ]],

