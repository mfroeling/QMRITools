Notebook[{

Cell[CellGroupData[{
Cell["GetPulseProfile", "ObjectName",
 CellID->407432185,ExpressionUUID->"6e2f4538-af24-5445-8493-9580a68b6ad8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"13f2724d-1452-ef4b-8cd2-1fc458beb99e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetPulseProfile",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/GetPulseProfile"], "[", 
   RowBox[{
    StyleBox["excitation", "TI"], ",", 
    StyleBox["refocus", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0a0dde2b-1039-3f47-80c3-4232b7b7af47"],
 "\[LineSeparator]gives the pulse angle profiles for the ",
 Cell[BoxData[
  StyleBox["excitation", "TI"]], "InlineFormula",ExpressionUUID->
  "09de72f7-6ba5-0540-a354-620f93f86571"],
 " and refocusing pulses. a pulse is defined as {\"name\", flip angle, \
{G_strength, Dur, BW}}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e2cfa440-12e4-894c-9b13-9c37eaf80cf8"],
 "GetPulseProfile[",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "\"\<name\>\""}], "TI"]], "InlineFormula",ExpressionUUID->
  "c487a161-e35b-1843-9d04-cad832a7d58b"],
 ",flip angle,{G_strength,Dur,BW}}]\[LineSeparator]gives detailed slice \
profile information of one pulse. output is {ex_angle_profile, \
ref_angel_profile, {plots}}. output for single pulse is {{distance, Mt, Mz, \
Mx, My, ang, phase}, plots}."
}], "Usage",
 CellChangeTimes->{{3.998533226823677*^9, 3.9985332269354706`*^9}},
 CellID->377677657,ExpressionUUID->"e88dc55c-b835-9442-b2bd-5efbd6bc34ab"],

Cell["The following options can be given: ", "Notes",
 CellID->373029318,ExpressionUUID->"31c17afb-48f0-4d48-a575-edc47bf658a0"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "40557543-9f60-8543-893f-dc122423837f"], 
    ButtonBox["MagnetizationVector",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSimulationTools/ref/MagnetizationVector"], 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], Cell[TextData[{
     "MagnetizationVector is an option for ",
     Cell[BoxData[
     "GetPulseProfile"], "InlineFormula",ExpressionUUID->
      "a00ed12d-b96d-7948-aa22-1466981d6dbf"],
     ". It defines the start magnetization vector for the bloch simulation."
    }], "TableText",ExpressionUUID->"9507ca38-26ed-4446-8b6a-9c3cce901a76"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3ba49a9f-1a4f-7e40-ac4d-cea752d35d11"], 
    ButtonBox["SliceRange",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSimulationTools/ref/SliceRange"], "12", 
    Cell[TextData[{
     "SliceRange is an option for ",
     Cell[BoxData[
     "GetPulseProfile"], "InlineFormula",ExpressionUUID->
      "df37224c-8df3-5f49-b0d9-4657e0538397"],
     ". It specifies over which range the slice profile is generated (in mm). \
the total profile is 2xSliceRange."
    }], "TableText",ExpressionUUID->"eb6d6c29-60dd-9c47-afde-d6d27c17bf1b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1a256f0f-b6a7-7c48-ad02-dc1eeafe5275"], 
    ButtonBox["SliceRangeSamples",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSimulationTools/ref/SliceRangeSamples"], 
    "25", Cell[TextData[{
     "SliceRangeSamples is an option for ",
     Cell[BoxData[
     "GetPulseProfile"], "InlineFormula",ExpressionUUID->
      "3d139fa2-9d4c-e64c-93bc-d236b2556d2f"],
     ". defines how many samples are used to generate half a puls profile."
    }], "TableText",ExpressionUUID->"0ada9276-711e-5b49-a6d3-892bb5f104b3"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7b9010fb-61a1-ec4c-adad-253a1ec3cdd7"], 
    ButtonBox["FatFieldStrength",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSimulationTools/ref/FatFieldStrength"], "0",
     Cell[TextData[{
     "FatFieldStrength is an option for ",
     Cell[BoxData[
     "GetPulseProfile"], "InlineFormula",ExpressionUUID->
      "aee1577a-8575-5642-943e-bed4397be3a4"],
     ". If the value >0 it will calculate the shift of the fat refocusing \
pulse compared to the fat excitation pulse.\nThe shift is in \
SliceRangeSamples steps."
    }], "TableText",ExpressionUUID->"e2c293a5-c8f8-8248-a30c-ba7deb4331c5"]}
  }]], "3ColumnTableMod",
 CellID->567011262,ExpressionUUID->"7d7fe859-fdd9-6f4d-b624-44cb77bd37a2"]
}, Open  ]],

