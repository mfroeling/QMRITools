Notebook[{

Cell[CellGroupData[{
Cell["DictT2IncludeWater", "ObjectName",
 CellID->207980801,ExpressionUUID->"5276984d-9ae9-3e4d-8cfc-b089998a49dd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"86433690-fffb-6b4f-be9b-48db7ff2f95a"],
 Cell[BoxData[
 "DictT2IncludeWater"], "InlineFormula",ExpressionUUID->
  "5d1832eb-2b79-2146-9bc6-69d339071e7d"],
 "\[LineSeparator]is an options for ",
 Cell[BoxData[
  ButtonBox["EPGT2Fit",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
  ExpressionUUID->"b28a28a6-3b97-c340-9a50-52a0912e705f"],
 " and ",
 Cell[BoxData[
  ButtonBox["CreateT2Dictionary",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CreateT2Dictionary"]], "InlineFormula",
  ExpressionUUID->"05409d08-0493-794d-9bf1-45fc0ca1b67f"],
 ". If ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "9b02e0a4-74b3-ce4d-bd70-191db89a4848"],
 " the fat signal is modeled as adipose tissue with 90% lipid and 10% water \
with a t2 of 20 ms. The water and fat outputs of ",
 Cell[BoxData[
  ButtonBox["EPGT2Fit",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
  ExpressionUUID->"ec4b32dd-a785-ed42-ba17-c8c7d24f85da"],
 " are then the water and lipid signals and the fat fraction is the lipid \
fraction, as reported by Dixon. Based on Keene KR et.al. DOI: \
10.1002/mrm.28290."
}], "Usage",
 CellChangeTimes->{4.003804502564989*^9},
 CellID->183694025,ExpressionUUID->"c974e110-c537-1943-bb81-765f7ae81e3e"],

Cell["XXXX", "Notes",
