Cell[CellGroupData[{
Cell["RegisterDataSplit", "ObjectName",
 CellID->48115108,ExpressionUUID->"4082519a-2df4-ef4e-a209-f3a429bb0f25"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3a47d7ea-3cca-f04b-ae09-c492bf54f3e1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterDataSplit",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterDataSplit"], "[", 
   RowBox[{
    StyleBox["target", "TI"], ",", 
    StyleBox["moving", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "12b22dc5-5ea2-bc4a-adf1-2b806c5a3b93"],
 "\[LineSeparator]is identical to ",
 Cell[BoxData[
  ButtonBox["RegisterData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterData"]], "InlineFormula",
  ExpressionUUID->"88a8c6e2-e5f8-f44d-bb68-28b102e67c7b"],
 " data however left and right side of the data are registered separately. \
Splitting the data is done using the function ",
 Cell[BoxData[
  ButtonBox["CutData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CutData"]], "InlineFormula",
  ExpressionUUID->"3c5a689b-b56c-8146-a718-efcc4407d564"],
 " and merged wit Stich data. Output is the registered data."
}], "Usage",
 CellChangeTimes->{3.9966556762874393`*^9},
 CellID->37997886,ExpressionUUID->"fb26626d-850e-2f4e-a398-68efcd5458b7"],

