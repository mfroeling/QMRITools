Notebook[{

Cell[CellGroupData[{
Cell["MaskToLines", "ObjectName",
 CellID->15571804,ExpressionUUID->"e175aa74-77e7-3147-9783-008da6686a13"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"84b190fa-09f1-9e49-a78d-8fd372a351e0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MaskToLines",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/MaskToLines"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "96b5a47d-6a07-2a4c-bd1b-84b38dd39ed1"],
 "\[LineSeparator]calculates lines perpendicular to the heart ",
 Cell[BoxData[
  StyleBox["wall", "TI"]], "InlineFormula",ExpressionUUID->
  "3bdb1e51-7456-1f49-82e1-934faf062633"],
 " per slice within the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "b083c420-0377-0d47-8abf-1878285bf31e"],
 ". Internally it uses ",
 Cell[BoxData[
  ButtonBox["CalculateWallMap",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CalculateWallMap"]], "InlineFormula",
  ExpressionUUID->"2c8ba2c1-4aff-7f41-baba-340d9a438307"],
 " and ",
 Cell[BoxData[
  ButtonBox["CentralAxes",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
  ExpressionUUID->"adbf447d-173e-e649-be84-c03561432c34"],
 " to obtain the cardiac geometry from mask. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e8e0be67-edd9-8446-8191-73bf0dbfb5d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MaskToLines",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/MaskToLines"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["wall", "TI"], ",", 
    StyleBox["cent", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "88956c4f-b79d-ef4e-b18c-538da36d5867"],
 "\[LineSeparator]where ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "88a5b160-9f3c-b747-b10f-4fac21cf7994"],
 " is the first output of ",
 Cell[BoxData[
  ButtonBox["CalculateWallMap",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CalculateWallMap"]], "InlineFormula",
  ExpressionUUID->"c1699c7d-122c-f24f-bfa6-5df0a0aba9df"],
 " and cent is the first output of ",
 Cell[BoxData[
  ButtonBox["CentralAxes",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
  ExpressionUUID->"c4704ed2-c208-3641-921c-d5d0be3869b3"],
 "."
}], "Usage",
