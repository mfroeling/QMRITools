Notebook[{

Cell[CellGroupData[{
Cell["ImportNiiDiff", "ObjectName",
 CellID->8775498,ExpressionUUID->"88c6a9f0-a562-2142-b83c-fdd13d7f6a83"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"15fa69a4-6de7-1c44-85c6-69c04a48cf3d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ImportNiiDiff",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ImportNiiDiff"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"7cabe53b-d761-c444-8e15-e83df8966790"],
 "\[LineSeparator]will prompt for the *.nii,*.bvec and *.bval file to import. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ec53bf5a-4d25-ba45-abc0-f2585572f2b2"],
 "ImportNiiDiff[",
 Cell[BoxData[
  StyleBox[
   RowBox[{"*", 
    RowBox[{".", "nii"}]}], "TI"]], "InlineFormula",ExpressionUUID->
  "fcb5e6ec-a2f2-7b4b-a9d5-a8fcab27254d"],
 "]\[LineSeparator]will import the *.nii file and automatically also imports \
the *.bvec and *.bval is they have the same name. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3ee5f11a-8ccc-0c46-ab07-24b0c1a6eede"],
 "ImportNiiDiff[*.nii,*.bvec,",
 Cell[BoxData[
  StyleBox[
   RowBox[{"*", 
    RowBox[{".", "bval"}]}], "TI"]], "InlineFormula",ExpressionUUID->
  "dd09a338-0eb3-cf47-822b-3398d5e9e9fc"],
 "]\[LineSeparator]will import the given files. The output will be \
{data,grad,bvec,vox}."
}], "Usage",
 CellChangeTimes->{{3.9966564019822216`*^9, 3.9966564020574055`*^9}},
 CellID->323446031,ExpressionUUID->"333d5bfd-40ec-7341-b5aa-ebd30335552f"],

