 CellID->342561137,ExpressionUUID->"29c32a46-cdb2-f640-8035-383a2b4155f3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"483cc555-2acd-6b49-a417-6b3457e652e1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetTractMeans",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/GetTractMeans"], "[", 
   RowBox[{
    StyleBox["dat", "TI"], ",", 
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1ce571b3-bc93-2042-a8f5-3aa5b15e0cc2"],
 "\[LineSeparator]calculates the mean, std, 5,50 and 95% CI form the given \
data for each of the given ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "aac0ae68-321f-f44c-b3bc-c6dac9d14b1f"],
 ". Tracts can be by ",
 Cell[BoxData[
  ButtonBox["SplitSegmentations",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SplitSegmentations"]], "InlineFormula",
  ExpressionUUID->"0d878117-ed81-8640-a570-e8635b48a00a"],
 ". ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",ExpressionUUID->
  "c194589d-5d2f-2142-a532-b7ae6bff51d4"],
 " is a string that is added to the header. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"172f3488-c765-a644-8936-9f45ba2b7324"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetTractMeans",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/GetTractMeans"], "[", 
   RowBox[{
    StyleBox["dat", "TI"], ",", 
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["name", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7dd3b416-841b-f842-a1bd-a8223a75ef5c"],
 "\[LineSeparator]where name is a string that is added to the header."
}], "Usage",
 CellChangeTimes->{{3.996656405181553*^9, 3.9966564053468323`*^9}},
