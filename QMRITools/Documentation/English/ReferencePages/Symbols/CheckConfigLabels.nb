Notebook[{

Cell[CellGroupData[{
Cell["CheckConfigLabels", "ObjectName",
 CellID->381960454,ExpressionUUID->"f82a7958-36ed-db45-90c5-bd6d09bca39d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"66558ffb-c4fa-944e-a721-a6163db52a22"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckConfigLabels",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/CheckConfigLabels"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "efa62d4c-edbf-2b40-98e8-8ce209d34588"],
 "\[LineSeparator]checks for each subject and session if the protocol names \
that are defined as Label in the config file in ",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",ExpressionUUID->
  "ec46314e-e2cc-3d41-a40d-1b4bc2c21bc9"],
 " are present. Missing labels are highlighted and can be shown only using \
the checkbox. Only subjects in the rawData folder are shown,so run it after \
BidsDcmToNii. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a932184a-efee-0b45-9191-316859ba4a0c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckConfigLabels",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/CheckConfigLabels"], "[", 
   RowBox[{
    StyleBox["dir", "TI"], ",", 
    StyleBox["subs", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b1c6559c-c9e7-aa46-bff4-0cdcacfba2b7"],
 "\[LineSeparator]does the same for the subjects ",
 Cell[BoxData[
  StyleBox["subs", "TI"]], "InlineFormula",ExpressionUUID->
  "ccde99d4-8a23-3a4a-8bec-b983fd784c1d"],
 "."
}], "Usage",
 CellChangeTimes->{{4.0038044984296856`*^9, 4.00380449854521*^9}},
