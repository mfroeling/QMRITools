Cell[CellGroupData[{
Cell["MakeChannelClassImage", "ObjectName",
 CellID->837015819,ExpressionUUID->"92e91395-c729-ee4d-b796-8afa5f51a4e8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9fb3d6ae-cdc3-0f49-a125-d0e77e615847"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassImage",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cc4284e4-62b0-8044-90ab-6d94770c712f"],
 "\[LineSeparator]makes a cross-sectional image of the channels ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "56998731-cf28-6b44-971b-c43c82d38df6"],
 " overlaid with a cross-sectional image of the classes ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "64e0bfa2-4254-e546-a72d-5644a46c82ec"],
 " of a training dataset generated. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a6c52d87-30a8-2d44-8790-4d04717cbd91"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassImage",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["off", "TI"], ",", 
      StyleBox["max", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"1b8788a3-6072-d346-b63b-b3f5591a4c81"],
 "\[LineSeparator]same but with explicit definition of background value b and \
number of classes n. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"7ff1fe92-4456-6e4c-ad27-ebee579074c4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassImage",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e0833bda-22de-2f45-b5b4-17ec0efd3933"],
 "\[LineSeparator]same but with the aspect ratio determined by ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "eb859a39-41ed-5841-acfd-c37144d5c15a"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4e077f1a-6457-5540-8af3-634e6e335aa4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassImage",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["off", "TI"], ",", 
      StyleBox["max", "TI"]}], "}"}], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ab8d831a-5000-ad4e-8327-acbcd9516a7a"],
 "\[LineSeparator]same with explicit definition and aspect ratio definition."
}], "Usage",
