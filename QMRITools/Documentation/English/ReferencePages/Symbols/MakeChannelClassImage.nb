Cell[CellGroupData[{
Cell["MakeChannelClassImage", "ObjectName",
 CellID->57404916,ExpressionUUID->"a45fa1f5-cd61-5841-87cd-78c5dc51e5aa"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f6ad3380-1ea6-2f42-82d5-c9df04187fe4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassImage",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d391c8e5-d9dd-0540-908e-6360c965bbb4"],
 "\[LineSeparator]makes a cross-sectional image of the channels ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "53341c7e-eace-634e-9eb5-10731980b853"],
 " overlaid with a cross-sectional image of the classes ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "d20fd576-71f3-d641-9d1f-1f5b43512302"],
 " of a training dataset generated \n",
 Cell["   ", "ModInfo",ExpressionUUID->"182e31bc-98bc-d04a-92bf-26295d3267f3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassImage",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["off", "TI"], ",", 
      StyleBox["max", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"206a706f-1ec3-9f43-b9a7-f544a3a293cd"],
 "\[LineSeparator]same but with explicit definition of background value b and \
number of classes n. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ec3cb336-b97f-954e-87be-74a21ef3bce4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassImage",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0b7403e4-4e98-114e-bda3-629822b031d8"],
 "\[LineSeparator]same but with the aspect ratio determined by ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "c813774b-d46c-f845-8ee1-dbff03430e9c"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e6847ac8-b2b9-1046-bc7e-96c1046edd18"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassImage",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["off", "TI"], ",", 
      StyleBox["max", "TI"]}], "}"}], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8fdd266a-f7b8-f44a-a308-b4d2cfda7b89"],
 "\[LineSeparator]same with explicit definition and aspect ratio definition."
}], "Usage",
