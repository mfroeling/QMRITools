Notebook[{

Cell[CellGroupData[{
Cell["PCATolerance", "ObjectName",
 CellID->41412934,ExpressionUUID->"da95cc5e-ef59-2641-b453-630cbdbfdc04"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4e81b4bf-d425-804c-921d-31ccd244c676"],
 Cell[BoxData[
 "PCATolerance"], "InlineFormula",ExpressionUUID->
  "dbdf7ad8-7d42-014d-8743-984ea78dca17"],
 "\[LineSeparator]is an option of ",
 Cell[BoxData[
  ButtonBox["PCADeNoise",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PCADeNoise"]], "InlineFormula",
  ExpressionUUID->"cbd469a8-1321-6845-be38-06bef4f61c0e"],
 " and should be an integer >= 0. ",
 Cell[BoxData[
  ButtonBox["Default",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "59f4e2a3-48ca-b046-a79f-8eed7caf99dd"],
 " value is 0, which removes exactly the noise components that are found. \
Each increase of 1 keeps one more component, i.e. the method removes less \
noise."
}], "Usage",
 CellChangeTimes->{4.003804558453003*^9},
 CellID->264507866,ExpressionUUID->"c55312cc-2a6c-3f4f-b297-12ec24cad43e"],

