Cell[CellGroupData[{
Cell["AmaresUseB1", "ObjectName",
 CellID->219463481,ExpressionUUID->"1f50bca2-d8f7-0f4f-be4a-f009edb027ce"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"09efff21-2c47-164b-b746-504a0fea9039"],
 Cell[BoxData[
 "AmaresUseB1"], "InlineFormula",ExpressionUUID->
  "cf5a3025-e2a9-0c47-a7d8-167f0f9e51ac"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["AmaresFitFidI",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/AmaresFitFidI"]], "InlineFormula",
  ExpressionUUID->"3e956b09-14e3-a047-8727-fb3a92ac682a"],
 ". When ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "b7cdd309-9ffa-0f49-ae08-dd7b04a2b474"],
 ", the B1 value supplied through init is used to apply the Ernst-angle \
amplitude correction even if the fitting matrix has \"B1\"->False for all \
metabolites (i.e. B1 is applied but not fitted). Default is False."
}], "Usage",
 CellChangeTimes->{3.9966567096703644`*^9},
 CellID->64033532,ExpressionUUID->"453d66f5-acbb-3446-97c9-98c9198661f4"],

