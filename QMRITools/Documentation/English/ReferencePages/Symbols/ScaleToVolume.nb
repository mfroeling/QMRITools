Notebook[{

Cell[CellGroupData[{
Cell["ScaleToVolume", "ObjectName",
 CellID->179037472,ExpressionUUID->"aff539e1-e248-0b4b-a4f0-eb03f5a63c95"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cc4f310f-f63f-2840-9fd7-f009680b8a82"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ScaleToVolume",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/ScaleToVolume"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fda7620b-9099-8a42-8665-e760ffc8ae68"],
 "\[LineSeparator]rescales a series of ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "6e4a39d6-f50c-8749-8047-33014855e4e2"],
 " all to the same volume, which will be the median volume of all the masks. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f49de972-14f5-154e-8e1b-eac2d6c8c00d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ScaleToVolume",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/ScaleToVolume"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["vol", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "839b4bb8-3b67-6d4c-bcb2-6e54dadb46bd"],
 "\[LineSeparator]does the same but then rescales to the target volume ",
 Cell[BoxData[
  StyleBox["vol", "TI"]], "InlineFormula",ExpressionUUID->
  "9ba0e65c-93fb-9340-9ff7-14d0f9f19940"],
 "."
}], "Usage",
 CellChangeTimes->{{3.996656375874708*^9, 3.99665637601338*^9}},
 CellID->250672551,ExpressionUUID->"5160b73a-0ed2-f544-a72b-d7948d024488"],

