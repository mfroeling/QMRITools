Notebook[{

Cell[CellGroupData[{
Cell["PCAWeighting", "ObjectName",
 CellID->86643617,ExpressionUUID->"58b42392-f0db-ef4e-b21b-f520343697e4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6ff44111-71b1-3d4d-9db5-93d3a51a7316"],
 Cell[BoxData[
 "PCAWeighting"], "InlineFormula",ExpressionUUID->
  "f52ec01f-7c80-a24c-b85b-b1ff784a1f29"],
 "\[LineSeparator]is an option of ",
 Cell[BoxData[
  ButtonBox["PCADeNoise",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PCADeNoise"]], "InlineFormula",
  ExpressionUUID->"28829b4e-e3e1-bc4c-bc70-32ecea4bf4e3"],
 " and can be ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "77476fe8-3071-3e43-9278-0a962ec0527f"],
 " of False. ",
 Cell[BoxData[
  ButtonBox["Default",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "fa10356c-e81b-9f47-9954-23c019272de7"],
 " value is False. When ",
 Cell[BoxData[
  ButtonBox[
   ButtonBox["True",
    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "de660a74-3ace-0348-9bf2-3d587f9f2b55"],
 " the weights of the per voxel result are calculated based on the number of \
non noise components. Weighting is not possible with Parallelize True, which \
is the default, in that case ",
 Cell[BoxData[
  ButtonBox["PCAWeighting",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PCAWeighting"]], "InlineFormula",
  ExpressionUUID->"bd355182-5a61-c442-8240-05b586aaf537"],
 " is ignored."
}], "Usage",
 CellChangeTimes->{{4.0038045595175247`*^9, 4.003804559577282*^9}},
 CellID->7002455,ExpressionUUID->"b81d391d-8e35-e14b-ac7d-44ce20c1bc9f"],

Cell["XXXX", "Notes",
 CellID->152595811,ExpressionUUID->"4336882a-4a26-2a48-b42b-829a308c5eee"]
