 "PCAWeighting"], "InlineFormula",ExpressionUUID->
  "787ed627-3b14-1c4d-ad87-779ce721a2ee"],
 "\[LineSeparator]is an option of ",
 Cell[BoxData[
  ButtonBox["PCADeNoise",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PCADeNoise"]], "InlineFormula",
  ExpressionUUID->"05fce07a-359f-e14c-9ec0-0859fae5cbe9"],
 " and can be ",
 Cell[BoxData[
  ButtonBox[
   ButtonBox["True",
    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "9c2609d4-06ba-a840-b8d6-89a9f4bd870d"],
 " of False. Default value is False. When True the weights of the per voxel \
result are calculated based on the number of non noise components."
}], "Usage",
