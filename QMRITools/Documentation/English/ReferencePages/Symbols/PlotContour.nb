Cell[CellGroupData[{
Cell["PlotContour", "ObjectName",
 CellID->26707425,ExpressionUUID->"19daf2ce-3a57-ae40-b54f-ac7993ef98b3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7a4e6a96-52cd-f441-b037-7002bcaadbe4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotContour",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsPlottingTools/ref/PlotContour"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "25122871-1fbe-e342-856c-ae75b4a2225d"],
 "\[LineSeparator]creates a contour of the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "bf2ca1bc-c492-be41-9352-617efab56865"],
 ". The ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "36cd274d-1e30-8249-8c0b-8bdbf89df53c"],
 " can be 3D or 4D, when its 4D each contour is given a random color."
}], "Usage",
 CellChangeTimes->{{3.996656677357916*^9, 3.996656677425709*^9}},
 CellID->185400371,ExpressionUUID->"1238133f-e4d3-eb45-b987-467feafe99a3"],

