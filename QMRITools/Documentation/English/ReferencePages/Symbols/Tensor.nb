Notebook[{

Cell[CellGroupData[{
Cell["Tensor", "ObjectName",
 CellID->132760510,ExpressionUUID->"5630b4e9-fc99-3249-9e02-97d76287c331"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5d7e9f0a-135c-1e4d-9654-f10beee5bcd0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Tensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/Tensor"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["l", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["l", "TI"], 
      StyleBox["2", "TR"]], ",", 
     SubscriptBox[
      StyleBox["l", "TI"], 
      StyleBox["3", "TR"]]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "10140c35-92ff-8c4b-a367-a77611fcd2b4"],
 "\[LineSeparator]creates a diffusion tensor with vectors \
{{0,0,1},{0,1,0},{1,0,0}} and eigenvalues {l1, l2, l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f1759e04-74fa-5042-804a-1a7599ad6218"],
 "Tensor[",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "l1"}], "TI"]], "InlineFormula",ExpressionUUID->
  "3e4b544a-4970-524b-9a77-9951cb0b6e48"],
 ",l2,l3},{e1,e2,e3}]\[LineSeparator]creates a diffusion tensor with vectors \
{e1, e2, e3} and eigenvalues {l1, ",
 Cell[BoxData[
  StyleBox["l2", "TI"]], "InlineFormula",ExpressionUUID->
  "77cc9b4d-04ff-ea41-9eea-547509472418"],
 ", l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b3f245be-d59a-6f45-8768-3554aa1c43a0"],
 "Tensor[{l1,l2,",
 Cell[BoxData[
  StyleBox[
   RowBox[{"l3", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "2c38d789-eaff-924a-b71a-298e201d3dcb"],
 ",\"Random\"]\[LineSeparator]creates a diffusion tensor with random \
orthogonal eigenvectors {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "e1"}], "TI"]], "InlineFormula",ExpressionUUID->
  "03ec6ea1-a998-ed48-969d-edf1f80a13b5"],
 "e1, ",
 Cell[BoxData[
  StyleBox["e2", "TI"]], "InlineFormula",ExpressionUUID->
  "4f28ffe4-f8ae-7b44-9444-c6941607f0a3"],
 ", e2} and eigenvalues {l1, l2, l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"daa09991-62e7-974f-b25a-7a36e07dde38"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Tensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/Tensor"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["3", "TR"]]}], "}"}], ",", "\"\<RandomZ\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"f2774fde-6ab4-e749-8641-75eaff4a043a"],
 "\[LineSeparator]creates a diffusion tensor with random orthogonal \
eigenvectors {{1,0,0}, e2, ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"e3", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "5e632f1a-4a04-fd48-8312-44c0fdbbf850"],
 " with random eigenvectors and eigenvalues {l1, l2, l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d4ffd3d2-5c72-8043-adab-4c1b978c5bff"],
 "Tensor[",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "l1"}], "TI"]], "InlineFormula",ExpressionUUID->
  "ba5871f2-930e-254a-9641-31e0683b0c06"],
 ",l2,l3},\"OrtRandom\"]\[LineSeparator]creates a diffusion tensor with \
random orthogonal eigenvectors {{1,0,0},{0,1,0},{0,0,1}} and eigenvalues {l1, \
",
 Cell[BoxData[
  StyleBox["l2", "TI"]], "InlineFormula",ExpressionUUID->
  "37bf479f-41da-ba47-8b8b-4fe05760ac3c"],
 ", l3",
 Cell[BoxData[
  StyleBox[
   RowBox[{"l3", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "b549266f-e783-d246-8c06-e4da1f5f041b"],
 "}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e01f799a-e8b2-bb4d-8a65-931b76258aa4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Tensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/Tensor"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"7d9ec6a0-3b84-404f-90e8-1f618ac8f08d"],
 "\[LineSeparator]is based on DOI: 10.1002/nbm.2959."
}], "Usage",
 CellChangeTimes->{{3.998533284790207*^9, 3.9985332855055065`*^9}},
 CellID->323883106,ExpressionUUID->"4b0150dd-01a9-e140-b899-74bf4b7493a6"],

