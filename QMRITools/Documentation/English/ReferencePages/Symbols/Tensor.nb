Notebook[{

Cell[CellGroupData[{
Cell["Tensor", "ObjectName",
 CellID->825995491,ExpressionUUID->"e58ddf35-d585-ce4d-8081-367a35174d01"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8b4cf761-5790-3b4d-aaad-a44cb345d48b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Tensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/Tensor"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["l", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["l", "TI"], 
      StyleBox["2", "TR"]], ",", 
     SubscriptBox[
      StyleBox["l", "TI"], 
      StyleBox["3", "TR"]]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "3a3c98b0-fe77-174c-9533-f499a6587a68"],
 "\[LineSeparator]creates a diffusion tensor with vectors \
{{0,0,1},{0,1,0},{1,0,0}} and eigenvalues {l1, l2, l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"df289a24-20ed-5f44-af87-5cd866a9f594"],
 "Tensor[",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "l1"}], "TI"]], "InlineFormula",ExpressionUUID->
  "5da9b448-1cba-9c43-b4f7-6d17a19492e8"],
 ",l2,l3},{e1,e2,e3}]\[LineSeparator]creates a diffusion tensor with vectors \
{e1, e2, e3} and eigenvalues {l1, ",
 Cell[BoxData[
  StyleBox["l2", "TI"]], "InlineFormula",ExpressionUUID->
  "e5ac9392-9942-6842-9bf2-2d11143f0e58"],
 ", l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e3ee6ed2-dd68-6140-be86-07cb9e222d7f"],
 "Tensor[{l1,l2,",
 Cell[BoxData[
  StyleBox[
   RowBox[{"l3", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "db4635ca-004c-5748-b9a8-474fc6eae700"],
 ",\"Random\"]\[LineSeparator]creates a diffusion tensor with random \
orthogonal eigenvectors {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "e1"}], "TI"]], "InlineFormula",ExpressionUUID->
  "a6ffb801-ffe9-8042-99c0-1aa10f2ab951"],
 "e1, ",
 Cell[BoxData[
  StyleBox["e2", "TI"]], "InlineFormula",ExpressionUUID->
  "005d8e51-4a83-da4c-824a-d554d8064b4e"],
 ", e2} and eigenvalues {l1, l2, l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ac0f7e6f-a1ac-004c-b8bb-ebb3e1c90a53"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Tensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/Tensor"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["3", "TR"]]}], "}"}], ",", "\"\<RandomZ\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"473284d8-329e-5347-b671-39c1354d7956"],
 "\[LineSeparator]creates a diffusion tensor with random orthogonal \
eigenvectors {{1,0,0}, e2, ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"e3", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "a7a8e867-271e-6149-8855-574a20c701fc"],
 " with random eigenvectors and eigenvalues {l1, l2, l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"66b99b72-4ebd-2e4c-98c5-a6ccc1b2320e"],
 "Tensor[",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "l1"}], "TI"]], "InlineFormula",ExpressionUUID->
  "a3721c65-159a-9a43-be80-bcfd1a00cba6"],
 ",l2,l3},\"OrtRandom\"]\[LineSeparator]creates a diffusion tensor with \
random orthogonal eigenvectors {{1,0,0},{0,1,0},{0,0,1}} and eigenvalues {l1, \
",
 Cell[BoxData[
  StyleBox["l2", "TI"]], "InlineFormula",ExpressionUUID->
  "2fc10b17-0c6f-564f-aa9e-89774a5d6092"],
 ", l3",
 Cell[BoxData[
  StyleBox[
   RowBox[{"l3", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "2b74f057-df5d-9849-b332-0979929cbb95"],
 "}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e10c49fa-0717-c247-af58-7b8847196781"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Tensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/Tensor"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"7f8135cb-f6de-1f42-903d-abfa00669d97"],
 "\[LineSeparator]is based on DOI: 10.1002/nbm.2959."
}], "Usage",
 CellChangeTimes->{{4.0038045886512184`*^9, 4.0038045889701385`*^9}},
