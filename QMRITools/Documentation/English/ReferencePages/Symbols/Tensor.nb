Notebook[{

Cell[CellGroupData[{
Cell["Tensor", "ObjectName",
 CellID->155260505,ExpressionUUID->"72bf2d6d-a5ca-c54b-84fe-7e37e919082f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"09927354-ae62-bc42-80fd-4d7f1a7b536c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Tensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/Tensor"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["l", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["l", "TI"], 
      StyleBox["2", "TR"]], ",", 
     SubscriptBox[
      StyleBox["l", "TI"], 
      StyleBox["3", "TR"]]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "58b55871-629f-2b47-804d-cb08d27cf0fc"],
 "\[LineSeparator]creates a diffusion tensor with vectors \
{{0,0,1},{0,1,0},{1,0,0}} and eigenvalues {l1, l2, l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"7323fe24-f9cf-e246-b952-81a7fe628c15"],
 "Tensor[",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "l1"}], "TI"]], "InlineFormula",ExpressionUUID->
  "30615be7-b2a1-e84f-9735-3527a55c4dc0"],
 ",l2,l3},{e1,e2,e3}]\[LineSeparator]creates a diffusion tensor with vectors \
{e1, e2, e3} and eigenvalues {l1, ",
 Cell[BoxData[
  StyleBox["l2", "TI"]], "InlineFormula",ExpressionUUID->
  "5ca6f310-7e9a-4548-8bf9-1d32383e56a0"],
 ", l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d118f39d-b73c-7641-952f-b143bb81b033"],
 "Tensor[{l1,l2,",
 Cell[BoxData[
  StyleBox[
   RowBox[{"l3", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "18bc1d6c-1196-5045-9621-184413b60c33"],
 ",\"Random\"]\[LineSeparator]creates a diffusion tensor with random \
orthogonal eigenvectors {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "e1"}], "TI"]], "InlineFormula",ExpressionUUID->
  "4ea9b6f8-fba3-f040-84c4-d1e987efe714"],
 "e1, ",
 Cell[BoxData[
  StyleBox["e2", "TI"]], "InlineFormula",ExpressionUUID->
  "75762449-c309-aa4a-8673-685ec0b77db7"],
 ", e2} and eigenvalues {l1, l2, l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d9f2460f-967b-1d45-b7dd-432abff11d04"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Tensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/Tensor"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["l", "TI"], 
       StyleBox["3", "TR"]]}], "}"}], ",", "\"\<RandomZ\>\""}], "]"}]], 
  "InlineFormula",ExpressionUUID->"daa24ea9-d7e8-9549-a9d9-5b9e549f1a10"],
 "\[LineSeparator]creates a diffusion tensor with random orthogonal \
eigenvectors {{1,0,0}, e2, ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"e3", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "e071e903-bc91-2743-b7f9-966407804ae1"],
 " with random eigenvectors and eigenvalues {l1, l2, l3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"5c36ec15-21f4-9546-bbc4-e75c0c7b1731"],
 "Tensor[",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "l1"}], "TI"]], "InlineFormula",ExpressionUUID->
  "2913ee43-b0bb-3246-9933-fabf52c53ef4"],
 ",l2,l3},\"OrtRandom\"]\[LineSeparator]creates a diffusion tensor with \
random orthogonal eigenvectors {{1,0,0},{0,1,0},{0,0,1}} and eigenvalues {l1, \
",
 Cell[BoxData[
  StyleBox["l2", "TI"]], "InlineFormula",ExpressionUUID->
  "8a5b88d9-92fa-9240-a6b4-1eb8c953b1a5"],
 ", l3",
 Cell[BoxData[
  StyleBox[
   RowBox[{"l3", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "bf98f2e6-4da2-6841-b933-7b9066317ce6"],
 "}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e7566002-d41d-844b-bacc-2ea1a50b606a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Tensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/Tensor"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"a0a2447b-58d1-4146-bb32-d714b506f2a1"],
 "\[LineSeparator]is based on DOI: 10.1002/nbm.2959."
}], "Usage",
