Cell[CellGroupData[{
Cell["HistogramPar", "ObjectName",
 CellID->332530671,ExpressionUUID->"ada94e98-f79b-4341-8876-28b77f8e3049"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6608dc6b-3499-7141-ad51-c9f5e720e55d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HistogramPar",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/HistogramPar"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["constraints", "TI"], ",", "Nbins"}], "}"}], ",", 
    StyleBox["style", "TI"], ",", 
    StyleBox["color", "TI"], ",", 
    StyleBox["range", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "09e20488-3b27-bf41-ac74-cf72f7c8262f"],
 "\[LineSeparator]plots histograms of IVIM solution. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d6083e13-e6ed-db41-9e26-d36296761167"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HistogramPar",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/HistogramPar"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["constraints", "TI"], ",", "Nbins", ",", 
      StyleBox["mu", "TI"], ",", 
      StyleBox["conv", "TI"]}], "}"}], ",", 
    StyleBox["components", "TI"], ",", 
    StyleBox["color", "TI"], ",", 
    StyleBox["range", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1ae9a664-c700-9c42-a75e-6b7351487b11"],
 "\[LineSeparator]plots histograms of IVIM solution. ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "6bae165a-5b51-054b-b158-0033266d7497"],
 " is {f1, dc, pdc1} or {f1, f2, dc, pdc1, pdc2}. constraints are the ranges \
of the x-axes for the plots. ",
 Cell[BoxData[
  StyleBox["Nbins", "TI"]], "InlineFormula",ExpressionUUID->
  "63c46dc8-8dca-b64c-8168-cefd2de57d36"],
 " are the number of histogram bins. ",
 Cell[BoxData[
  StyleBox["style", "TI"]], "InlineFormula",ExpressionUUID->
  "f9d4f8f4-a8bc-8048-9af7-e48522aad2d9"],
 " is the plot type, can be 1, 2, or 3. ",
 Cell[BoxData[
  StyleBox["color", "TI"]], "InlineFormula",ExpressionUUID->
  "d1337a1f-28cf-1345-a819-7a05bed1ce34"],
 " is the ",
 Cell[BoxData[
  StyleBox["color", "TI"]], "InlineFormula",ExpressionUUID->
  "78cc6feb-21c9-b347-b683-4ce71194399b"],
 " of the histogram. ",
 Cell[BoxData[
  StyleBox["range", "TI"]], "InlineFormula",ExpressionUUID->
  "a53696e7-c7d4-774c-98ff-622238c43167"],
 " are the ranges of the y-axes. output is a row of histograms."
}], "Usage",
 CellChangeTimes->{{3.996656628490097*^9, 3.9966566286809216`*^9}},
 CellID->268107867,ExpressionUUID->"81448006-8fde-7548-8241-6eb95900aace"],

