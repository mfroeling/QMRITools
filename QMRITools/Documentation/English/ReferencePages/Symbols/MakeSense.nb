Cell[CellGroupData[{
Cell["MakeSense", "ObjectName",
 CellID->40638213,ExpressionUUID->"8dbe5e5b-7c36-5848-8b35-ebda0e0a905b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"63b9cc5f-c48f-724a-bd54-b2cef1c8b583"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeSense",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/MakeSense"], "[", 
   RowBox[{
    StyleBox["coils", "TI"], ",", 
    StyleBox["cov", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "caf06113-b7bb-2b49-8b5e-e9561c80f91e"],
 "\[LineSeparator]makes a sense map for ",
 Cell[BoxData[
  StyleBox["coils", "TI"]], "InlineFormula",ExpressionUUID->
  "691727e8-24a4-eb40-8566-69e4baca973f"],
 ". Each coil signal is divided by the RSS reconstruction of the ",
 Cell[BoxData[
  StyleBox["coils", "TI"]], "InlineFormula",ExpressionUUID->
  "d7d02ee1-9e8b-b540-8d37-f2846baeddfd"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9966567929698277`*^9, 3.996656793030718*^9}},
 CellID->203159268,ExpressionUUID->"8c520cbb-1f52-e241-a389-4fd29e66d8b9"],

Cell["The following options can be given: ", "Notes",
 CellID->222753313,ExpressionUUID->"1f7cd8b7-ba1e-ee4d-a5fe-f6b912bc3452"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "454682e4-2e55-8b47-94be-b56c4bf21996"], 
    ButtonBox["SenseSmoothing",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SenseSmoothing"], "\"\<Hamming\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SenseSmoothing",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SenseSmoothing"]], "InlineFormula",
      ExpressionUUID->"35936be0-f017-d340-ae68-7c302a61a066"],
     " is an option for ",
     Cell[BoxData[
     "MakeSense"], "InlineFormula",ExpressionUUID->
      "3d62f60a-fb09-2541-a5cc-fd23bd97c1e6"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "c270a91a-d41a-9e4c-ba44-895927b48598"],
     " the data and sense maps are smoothed using hamming filters."
    }], "TableText",ExpressionUUID->"d9e72560-6b09-844b-bf85-68e98dfc9896"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "180afcb4-96dc-7d45-bd6e-166d98936362"], 
    ButtonBox["SenseWeight",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SenseWeight"], "1", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SenseWeight",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SenseWeight"]], "InlineFormula",
      ExpressionUUID->"f5151b87-241e-9142-8a0c-7763cc0d12a1"],
     " is an option for ",
     Cell[BoxData[
     "MakeSense"], "InlineFormula",ExpressionUUID->
      "ccd1e75f-fdfa-4e41-a154-b04c08c6612c"],
     ". Is a integer between 0 and Infinity and define the amount of SOS \
weighting in the SENSE map."
    }], "TableText",ExpressionUUID->"ebb0f2b2-fb0b-5a41-a0d4-89a9922996ea"]}
  }]], "3ColumnTableMod",
