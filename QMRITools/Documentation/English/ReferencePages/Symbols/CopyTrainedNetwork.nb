Notebook[{

Cell[CellGroupData[{
Cell["CopyTrainedNetwork", "ObjectName",
 CellID->221831594,ExpressionUUID->"a708b590-95da-a34e-bdb7-591bcd3d927d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bcc96c16-4caf-5b40-a480-1411dd02976b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CopyTrainedNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/CopyTrainedNetwork"], "[", 
   RowBox[{
    StyleBox["fileIn", "TI"], ",", 
    StyleBox["loc", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3161e425-2913-e140-befa-bf95674358e3"],
 "\[LineSeparator]copy a trained network to final location. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"21cc7b8d-ab25-9f4d-9ae3-acd236769ab3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CopyTrainedNetwork",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/CopyTrainedNetwork"], "[", 
   RowBox[{
    StyleBox["fileIn", "TI"], ",", 
    StyleBox["loc", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "16bdbe0d-1b80-ae46-bc27-ebb0f992acc0"],
 "\[LineSeparator]does the same but appends ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",ExpressionUUID->
  "17540369-53bb-9a47-92fb-7aedad535f56"],
 " to the network name, used for the \"2D\" or \"3D\" segmentation network \
variants. ",
 Cell[BoxData[
  StyleBox["loc", "TI"]], "InlineFormula",ExpressionUUID->
  "12feb65f-b772-ec47-874c-e43f012c1243"],
 " can be \"HeadNeck\", \"Shoulder\", \"Torso\", \"Hip\", \"UpperLeg\", \
\"LowerLeg\", \"Arm\", or \"PosSide\" to copy the body position/side \
classification network."
}], "Usage",
 CellChangeTimes->{{3.9981148201163464`*^9, 3.998114820199999*^9}},
 CellID->345831789,ExpressionUUID->"f126451f-f8a5-3240-913f-182b1c574737"],

Cell["XXXX", "Notes",
 CellID->448659579,ExpressionUUID->"07a5d0dc-5607-9446-9c43-ec2b68c28dde"]
