Cell[CellGroupData[{
Cell["TimeShiftFid", "ObjectName",
 CellID->181024522,ExpressionUUID->"19ecc7a4-1dd0-b44d-8729-063d52457061"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c792d072-bd0c-bd48-bc12-d3ec36cd9424"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftFid",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftFid"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gam", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b9e909a3-2486-2a47-83fc-899d11a74102"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "66395e75-0be7-8a42-ba4c-4b41a2ac2992"],
 " and a Voigt line shape to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "c5398b4c-d860-2841-b145-7097c5efcf68"],
 ". The ",
 Cell[BoxData[
  StyleBox["time", "TI"]], "InlineFormula",ExpressionUUID->
  "73554492-840c-6847-a117-a3452c2716e2"],
 " can be obtained using ",
 Cell[BoxData[
  ButtonBox["GetTimeRange",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetTimeRange"]], "InlineFormula",
  ExpressionUUID->"015026fe-02b0-6649-891e-1db0049b53fc"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d71b0169-afb0-404c-9bef-5c6be33035e2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftFid",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftFid"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gamL", "TI"], ",", 
      StyleBox["gamG", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"9a8881ce-3426-8940-86f7-67e8f3bf71c0"],
 "\[LineSeparator]applies a line broadening with linewidth gamG \"Gaussian\" \
and gamL \"Lorentzian\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c46a8390-06b4-754e-8f41-624df637f637"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftFid",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftFid"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["eps", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"8196b17e-21a2-ce46-8b67-d956ec4664d7"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "03df71eb-1993-cf45-9045-66e6cc99fa38"],
 " to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "1e509ee0-c4d8-3e47-a27d-8b30b3ba8d26"],
 " and a phase eps that results in eps ppm shift of the spectra. The ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "da0a73c3-6ecb-224d-a5e5-c1ded22b0007"],
 " can be obtained with ",
 Cell[BoxData[
  ButtonBox["GetGyro",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetGyro"]], "InlineFormula",
  ExpressionUUID->"867221af-272c-f147-8eb8-9e06f593d6fa"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d5a3fd71-c7f3-0b48-a56b-2fdb4ee03dd5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftFid",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftFid"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["gamL", "TI"], ",", 
        StyleBox["gamG", "TI"]}], "}"}], ",", 
      StyleBox["eps", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"7e1ea671-29f1-2e4e-bdd8-1751169868b7"],
 "\[LineSeparator]applies a line broadening with linewidth linewidth gamG \
\"Gaussian\" and gamL \"Lorentzian\" to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "9be6039a-1236-3246-b2d8-aaacce5a634d"],
 " and a phase eps that results in eps ppm shift of the spectra. The \
linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "ec8c399e-d392-694f-b87b-905173d49da5"],
 " is given in ms and the spectra shift eps is given in ppm."
}], "Usage",
