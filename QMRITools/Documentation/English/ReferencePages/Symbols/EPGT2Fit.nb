\>", "TableText",ExpressionUUID->"01771ca9-c8fe-bb47-ac9b-fb8e42326a3d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "48bc8d4f-6b1e-9a45-a11b-68a513c671eb"], 
    ButtonBox["OutputCalibration",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/OutputCalibration"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "OutputCalibration is an option for ",
     Cell[BoxData[
     "EPGT2Fit"], "InlineFormula",ExpressionUUID->
      "d64afbbe-56b3-4f48-a86b-255f4b8004cf"],
     " and TriExponentialT2Fit. If true it outputs the calibartion values."
    }], "TableText",ExpressionUUID->"1642c4b5-25b3-f74e-9f4e-62559abadb41"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "38ba8d10-3cee-5043-b941-378fdbea1ffd"], 
    ButtonBox["EPGSmoothB1",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/EPGSmoothB1"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["EPGSmoothB1",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGSmoothB1"]], "InlineFormula",
      ExpressionUUID->"bafaa353-11f6-814f-a299-4672c39af223"],
     " is an options for ",
     Cell[BoxData[
     "EPGT2Fit"], "InlineFormula",ExpressionUUID->
      "27685a8b-ca13-bd4b-a205-12e6444878c2"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "c28de28b-b966-1641-9149-a8b1b6e5b7b3"],
     " or a radius the b1 is fitted on the dictionary cost pooled over the \
neighbouring voxels (radius 2 for True), after which the minimization is \
performed again with this fixed b1."
    }], "TableText",ExpressionUUID->"03a1bea1-ebbe-0646-8567-e46ec9740a4e"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "aa25c033-c210-b348-9e89-05c3f6a08d29"], 
    ButtonBox["WaterFatShift",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/WaterFatShift"], "0.", 
    Cell[TextData[{
     "WaterFatShift is an options for ",
     Cell[BoxData[
     "EPGT2Fit"], "InlineFormula",ExpressionUUID->
      "51adbd58-02b0-a149-a3c3-0061f47e3aa6"],
     ". It specifies the amount of water fat shift in voxels."
    }], "TableText",ExpressionUUID->"2f64d565-9837-864e-8915-999011dd4770"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
