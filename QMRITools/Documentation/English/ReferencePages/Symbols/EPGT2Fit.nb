     "EPGT2Fit"], "InlineFormula",ExpressionUUID->
      "e1969d85-0c10-844f-8074-24d0bd4c1f9a"],
     ". Number of points is 200 by default."
    }], "TableText",ExpressionUUID->"0e89ebc9-e08f-1d40-b403-e0a32e4203fd"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9d65be64-60d2-3d45-8479-17394d5c36da"], 
