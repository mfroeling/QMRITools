 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "63401cbe-1c0b-514a-a139-d64269129609"],
 " layer that computes the topK 10% loss. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"19afd98d-fd80-754a-92f4-20bf097bbc54"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TopKLossLayer",
    BaseStyle->"Link",
