    StyleBox["net", "TI"], ",", 
    StyleBox["k", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2a744209-b373-2a43-a0b1-174465457fcc"],
 "\[LineSeparator]does the same but ",
 Cell[BoxData[
  StyleBox["k", "TI"]], "InlineFormula",ExpressionUUID->
  "4816c883-1591-6b49-ad76-4c9e61d463df"],
 " defines the topK between 0 and 1."
}], "Usage",
