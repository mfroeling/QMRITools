 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassGrid",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassGrid"],
    "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["label", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2186defd-2255-5c40-bd9a-31e769190af4"],
 "\[LineSeparator]makes a ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "042f93ed-342e-ff4e-b137-6c759f0e9742"],
 " x ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "bfd5a246-519b-e348-931b-a6da7b26e855"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f9ee37a1-7c43-a049-af38-822d94d2a252"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelClassGrid",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeChannelClassGrid"],
    "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
