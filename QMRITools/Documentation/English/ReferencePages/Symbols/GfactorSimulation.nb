Cell[CellGroupData[{
Cell["GFactorSimulation", "ObjectName",
 CellID->201787652,ExpressionUUID->"81f7758f-83bc-bf44-bca6-52428d03afac"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a5ee12c3-bb46-1a4d-88bf-d26d444d9309"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GFactorSimulation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/GFactorSimulation"], "[", 
   RowBox[{
    StyleBox["sensitivity", "TI"], ",", 
    StyleBox["cov", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["dir", "TI"], ",", 
      StyleBox["sense", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"914cb547-57aa-8247-838c-8846e64a42a0"],
 "\[LineSeparator]calculates the g-factor maps for given ",
 Cell[BoxData[
  StyleBox["sensitivity", "TI"]], "InlineFormula",ExpressionUUID->
  "8e50b2cf-e986-7041-80ab-baf621faa155"],
 " maps and noise corelation ",
 Cell[BoxData[
  StyleBox["cov", "TI"]], "InlineFormula",ExpressionUUID->
  "9432c9ea-347d-cd4a-992b-cc5493a2171b"],
 " in one direction. The sense factors are a list of integers in a given \
direction: \"LR\", \"FH\", or \"AP\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"458c7e54-7fb4-0a42-a24c-32ac7137b8dc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GFactorSimulation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/GFactorSimulation"], "[", 
   RowBox[{
    StyleBox["sensitivity", "TI"], ",", 
    StyleBox["cov", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["dir", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["sense", "TI"], 
       StyleBox["1", "TR"]]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["dir", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["sense", "TI"], 
       StyleBox["2", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"0e057fe6-8df6-c247-aed3-80accf5c2228"],
 "\[LineSeparator]calculates the g-factor maps for given ",
 Cell[BoxData[
  StyleBox["sensitivity", "TI"]], "InlineFormula",ExpressionUUID->
  "abdc092c-7b6a-b449-9da3-688a5f640a41"],
 " maps and noise corelation w in two directions."
}], "Usage",
 CellChangeTimes->{{4.003804534162815*^9, 4.003804534346916*^9}},
 CellID->176286185,ExpressionUUID->"bc3097f9-a670-8b47-b967-a553cec44ebd"],

