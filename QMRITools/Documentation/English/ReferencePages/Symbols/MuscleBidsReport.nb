Notebook[{

Cell[CellGroupData[{
Cell["MuscleBidsReport", "ObjectName",
 CellID->56552584,ExpressionUUID->"96e8ddbf-ba6a-af42-b182-96a830ae0520"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a904e1b8-c6fa-8941-b36e-e517ff091754"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsReport",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsReport"], "[", 
   RowBox[{
    StyleBox["dir", "TI"], ",", 
    StyleBox["step", "TI"], ",", 
    StyleBox["file", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2df8bae1-607a-6e42-820f-01a3b2e97f98"],
 "\[LineSeparator]writes the problem report of the config ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "a054523c-2c1b-a34d-9818-a70107397570"],
 " in ",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",ExpressionUUID->
  "3fd01f96-a4dd-e148-b116-dcfc8bb57716"],
 " to ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "a0b2decd-f037-2f43-b59d-8fc859275d5c"],
 ", for the ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "834f3803-8219-704e-ac67-a37005fdb098"],
 " or for all steps when ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "e6cb57ba-e063-ee49-8eeb-5e0d42c9ec95"],
 " is \"All\". The steps are \"Protocol names\", \"Config labels\", \"Convert\
\", \"Custom configs\", \"Process\", \"Merge\", \"Segment\", \"Tractography\" \
and \"Analysis\". Problems are grouped by class: error, unreadable, missing, \
duplicate and outdated. The extension of ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "4703fac8-5fde-174c-b7b7-a0ba64290108"],
 " selects the format, \".md\" or \".pdf\". The options are ProcessSubjects \
to limit the subjects and BidsOutputImages to define the expected Analysis \
images. Returns the full path of ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "f623ac56-25db-9149-b629-e5e52727a30c"],
 "."
}], "Usage",
 CellChangeTimes->{{4.0026958094005547`*^9, 4.0026958095001926`*^9}},
 CellID->72835843,ExpressionUUID->"536f0b0d-69ef-474b-a235-054ddf2afefc"],

Cell["The following options can be given: ", "Notes",
 CellID->19005933,ExpressionUUID->"499bb934-97b3-5e42-9aed-b4fe91c87b7c"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1bb12c51-fefd-2c45-a9d6-9e3d5491dbfb"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell["\<\
ProcessSubjects is an option for Bids functions. Can be a list of bids \
subject names else it is All.\
\>", "TableText",ExpressionUUID->"d3a2b76d-3848-2e4c-a56e-9302abe5ef65"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "288f02db-a56e-aa45-be55-1f7ab6b6f24f"], 
    ButtonBox["BidsOutputImages",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsMuscleBidsTools/ref/BidsOutputImages"], "\"\<All\>\"", 
    Cell["\<\
BidsOutputImages is an option for MuscleBidsAnalysis and ManageCheckFiles. It \
sets which images are saved in the output folder,
one of \"All\", \"Quantitative\", \"Segmentation\", \"Tractography\" or \
\"None\".\
\>", "TableText",ExpressionUUID->"837fe0a6-b64c-e547-8345-8d0722c2ff55"]}
  }]], "3ColumnTableMod",
 CellID->97026743,ExpressionUUID->"b0c14bd5-bed5-5c48-8782-f56331840ad1"]
}, Open  ]],

