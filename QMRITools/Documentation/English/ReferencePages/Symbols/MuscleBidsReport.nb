Notebook[{

Cell[CellGroupData[{
Cell["MuscleBidsReport", "ObjectName",
 CellID->22618207,ExpressionUUID->"4150839e-fece-5e42-bfab-252d537b2d56"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2d5139ae-995d-a440-9c45-4e401f0bd6a4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsReport",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsReport"], "[", 
   RowBox[{
    StyleBox["dir", "TI"], ",", 
    StyleBox["step", "TI"], ",", 
    StyleBox["file", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b58cd353-5409-e843-a6ea-9ab588832d02"],
 "\[LineSeparator]writes the problem report of the config ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "2f925482-da91-b64f-8740-07857bbf71fb"],
 " in ",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",ExpressionUUID->
  "19cd20f1-7409-9b43-b872-50bd81808674"],
 " to ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "6919edfc-0a14-2845-86c4-d403b84be0dc"],
 ", for the ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "29d6e213-e82d-5348-98fa-a1b48e6201b4"],
 " or for all steps when ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "eaa5a4fa-57a9-8144-af62-9565338f0d76"],
 " is \"All\". The steps are \"Protocol names\", \"Config labels\", \"Convert\
\", \"Custom configs\", \"Process\", \"Merge\", \"Segment\", \"Tractography\" \
and \"Analysis\". Problems are grouped by class: error, unreadable, missing, \
duplicate and outdated. The extension of ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "1a1ab00d-a28c-1148-ad97-ec0e6f396717"],
 " selects the format, \".md\" or \".pdf\". The options are ProcessSubjects \
to limit the subjects and ",
 Cell[BoxData[
  ButtonBox["BidsOutputImages",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/BidsOutputImages"]], "InlineFormula",
  ExpressionUUID->"0e4f33ce-5fb6-c340-a556-b3207c846c66"],
 " to define the expected Analysis images. Returns the full path of file."
}], "Usage",
 CellChangeTimes->{{4.0038045512207584`*^9, 4.0038045513247013`*^9}},
 CellID->181125610,ExpressionUUID->"197e43cf-845d-7740-aa7c-bb4001ffc92e"],

Cell["The following options can be given: ", "Notes",
 CellID->71415503,ExpressionUUID->"41a072d5-0eb5-0d47-9269-986d449ca6a1"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "390e94ad-3fde-8a45-8a77-2dd4e559bbe7"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell[TextData[{
     "ProcessSubjects is an option for Bids functions. Can be a list of bids \
subject names else it is ",
     Cell[BoxData[
      ButtonBox["All",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "626bd842-4c49-694d-9c77-68788c27caa5"],
     "."
    }], "TableText",ExpressionUUID->"ef6bc943-1d82-3e42-ac75-069bdd8fe007"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "751ea52e-3e82-ce46-ad1d-210067dd38a5"], 
    ButtonBox["BidsOutputImages",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/BidsOutputImages"], "\"\<All\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["BidsOutputImages",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/BidsOutputImages"]], "InlineFormula",
      ExpressionUUID->"dfaacdd3-6270-bf47-81d2-b6881de04008"],
     " is an option for MuscleBidsAnalysis and ",
     Cell[BoxData[
      ButtonBox["ManageCheckFiles",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ManageCheckFiles"]], "InlineFormula",
      ExpressionUUID->"d2b3615a-83c1-3b41-b468-edfce09dde95"],
     ". It sets which images are saved in the output folder,\none of \"All\", \
\"Quantitative\", \"Segmentation\", \"Tractography\" or \"None\"."
    }], "TableText",ExpressionUUID->"b99200cd-5e0b-2346-9a05-de0ad212100e"]}
  }]], "3ColumnTableMod",
 CellID->140210224,ExpressionUUID->"2e11ecab-0920-1a40-91d6-3e06df9d7bc0"]
}, Open  ]],

