Notebook[{

Cell[CellGroupData[{
Cell["CalculateDisplacementParameters", "ObjectName",
 CellID->790786,ExpressionUUID->"68aa5356-4dbd-c64d-bd39-220a2662479d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bc90e213-f695-e74b-a408-92717823230d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CalculateDisplacementParameters",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsTaggingTools/ref/CalculateDisplacementParameters"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["motx", "TI"], ",", 
      StyleBox["moty", "TI"]}], "}"}], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6e8a5ee5-6414-7a41-9dba-8030ae51dbc1"],
 "\[LineSeparator]calculates strain and rotation from the displacements motx \
and moty as given by ",
 Cell[BoxData[
  ButtonBox["AnnalyzeTagging",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/AnnalyzeTagging"]], "InlineFormula",
  ExpressionUUID->"e484e50b-69ce-fa44-9efb-19e8b08d5dc4"],
 ", both {slices, frames, y, x}. The mask is {slices, y, x} and a circle \
fitted to the mask of each slice defines the center for the circumferential \
and radial directions. Output is {Exx, Eyy, Exy, Ecc, Ecr, rot}, all {slices, \
frames, y, x}, where Exx, Eyy and Exy are the Green-Lagrange strain \
components along the image axes, Ecc is the circumferential strain, Ecr the \
radial strain and rot the rotation around the center in degrees."
}], "Usage",
 CellChangeTimes->{4.003804495634924*^9},
 CellID->433932281,ExpressionUUID->"9434b6e5-a0c3-d048-8bf2-57b358e5991f"],

Cell["XXXX", "Notes",
 CellID->420352335,ExpressionUUID->"bbdd4bc7-a658-8a40-bc48-22256656255c"]
}, Open  ]],

