Cell["ChangeNetDimensions", "ObjectName",
 CellID->163620390,ExpressionUUID->"a1d321f0-dd4d-bd45-9002-c7dc30c92005"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0a368772-21f1-b04d-a707-5edd2fbde086"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ChangeNetDimensions",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/ChangeNetDimensions"],
    "[", 
   StyleBox["netIn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1ab6e630-6a81-cd4f-9ad0-9b91e69daf82"],
 "\[LineSeparator]returns ",
 Cell[BoxData[
  StyleBox["netIn", "TI"]], "InlineFormula",ExpressionUUID->
  "1dc8d45c-8f74-a84c-bfb7-9696fa4247d8"],
 " unchanged; use the \"Dimensions\",\"Channels\",and \"Classes\" options to \
actually change the input patch dimension,input channels,or output classes of \
",
 Cell[BoxData[
  StyleBox["netIn", "TI"]], "InlineFormula",ExpressionUUID->
  "5dc72d4a-e4b2-3b4c-88bc-58a260c57f7a"],
 ",e.g. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d88aa055-3a63-424e-9879-5da33583cb24"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ChangeNetDimensions",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/ChangeNetDimensions"],
    "[", 
   RowBox[{
    StyleBox["netIn", "TI"], ",", 
    RowBox[{"\"\<Dimensions\>\"", " ", "\[Rule]", " ", 
     StyleBox["dim", "TI"]}], ",", 
    RowBox[{"\"\<Channels\>\"", " ", "\[Rule]", " ", 
     StyleBox["nChan", "TI"]}], ",", 
    RowBox[{"\"\<Classes\>\"", " ", "\[Rule]", " ", 
     StyleBox["nClass", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fc1c6343-4682-8540-a934-17e425e84845"],
 "\[LineSeparator]."
}], "Usage",
