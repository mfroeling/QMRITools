Cell["ChangeNetDimensions", "ObjectName",
 CellID->482145817,ExpressionUUID->"4964c4e9-77e4-8f4d-b847-777acbbed380"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a144e13a-4ab3-5346-8d17-46253d15bdc8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ChangeNetDimensions",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/ChangeNetDimensions"],
    "[", 
   StyleBox["netIn", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "01376792-51b2-034c-b9d8-c3f211f4f94c"],
 "\[LineSeparator]returns ",
 Cell[BoxData[
  StyleBox["netIn", "TI"]], "InlineFormula",ExpressionUUID->
  "27939481-05c8-684a-a51f-655caa99088f"],
 " unchanged; use the \"Dimensions\",\"Channels\",and \"Classes\" options to \
actually change the input patch dimension,input channels,or output classes of \
",
 Cell[BoxData[
  StyleBox["netIn", "TI"]], "InlineFormula",ExpressionUUID->
  "9839bfd4-f199-b44f-907a-1443500bc436"],
 ",e.g. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a809e5b2-c00d-d84a-b1a1-f57dd38c5abc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ChangeNetDimensions",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/ChangeNetDimensions"],
    "[", 
   RowBox[{
    StyleBox["netIn", "TI"], ",", 
    RowBox[{"\"\<Dimensions\>\"", " ", "\[Rule]", " ", 
     StyleBox["dim", "TI"]}], ",", 
    RowBox[{"\"\<Channels\>\"", " ", "\[Rule]", " ", 
     StyleBox["nChan", "TI"]}], ",", 
    RowBox[{"\"\<Classes\>\"", " ", "\[Rule]", " ", 
     StyleBox["nClass", "TI"]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "aaca3171-765e-fb49-b561-11d0557b76cc"],
 "\[LineSeparator]."
}], "Usage",
