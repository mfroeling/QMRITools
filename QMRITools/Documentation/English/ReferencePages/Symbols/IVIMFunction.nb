Notebook[{

Cell[CellGroupData[{
Cell["IVIMFunction", "ObjectName",
 CellID->1039927244,ExpressionUUID->"d697f98c-dca7-3144-9721-52a10f118606"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"47996a0e-b933-8646-9343-53266ad4dbbb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMFunction"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"4ff26934-25e4-2d46-9081-ca85c667cd21"],
 "\[LineSeparator]gives the IVIM function with 2 comps. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ef086e24-ea75-6c45-b85d-4d613e51d70a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMFunction"], "[", 
   StyleBox["comp", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "13755207-9795-b448-8028-c5d0123454c8"],
 "\[LineSeparator]gives the IVIM function. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"89976705-b95f-f84e-bfaf-773cdfd73a72"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMFunction"], "[", 
   RowBox[{
    StyleBox["comp", "TI"], ",", 
    StyleBox["type", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bfd10d43-0408-3642-bfc2-8da1f04d8ada"],
 "\[LineSeparator]gives the IVIM function. ",
 Cell[BoxData[
  StyleBox["type", "TI"]], "InlineFormula",ExpressionUUID->
  "89234899-e6d0-a84b-b48f-20e07ef5dc58"],
 " can be \"Normal\" or \"Exp\". ",
 Cell[BoxData[
  StyleBox["comp", "TI"]], "InlineFormula",ExpressionUUID->
  "e70acc15-4b1f-6f49-868e-75eb28cfded1"],
 " can be 2 or 3. output is the function with b, s0, f1, f2, D, pD1, pD2 as \
parameters. The fraction is defined between 0 and 1, the D, Dp, Dp1 and Dp2 \
is in mm^2/s."
}], "Usage",
 CellChangeTimes->{{3.998533235166424*^9, 3.9985332354729156`*^9}},
