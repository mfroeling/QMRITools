Notebook[{

Cell[CellGroupData[{
Cell["IVIMFunction", "ObjectName",
 CellID->1080862,ExpressionUUID->"4fa46fa2-d38d-8e4c-aceb-b1dfe81d67ce"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d10f2dc4-2147-134d-9efe-bb2d596d51f8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMFunction"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"6a634435-d7b4-8848-b03f-0eb87cb2add9"],
 "\[LineSeparator]gives the IVIM function with 2 comps. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"fb77446e-4cfb-2640-b3ca-855d8f7180ec"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMFunction"], "[", 
   StyleBox["components", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "41c12269-d068-6e4a-a8fe-2051eacbfebe"],
 "\[LineSeparator]gives the IVIM function. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6786136e-6358-c945-9cb6-30f86dc6a239"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["IVIMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/IVIMFunction"], "[", 
   RowBox[{
    StyleBox["components", "TI"], ",", 
    StyleBox["type", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "710fbae6-8974-ea4f-acfb-62856516933c"],
 "\[LineSeparator]gives the IVIM function. ",
 Cell[BoxData[
  StyleBox["type", "TI"]], "InlineFormula",ExpressionUUID->
  "99822e09-52d5-3c49-abc3-7c8ae8bc4c6c"],
 " can be \"Normal\" or \"Exp\". ",
 Cell[BoxData[
  StyleBox["components", "TI"]], "InlineFormula",ExpressionUUID->
  "987ce03f-0c3a-4a45-96ae-41c1d99e409b"],
 " can be 2 or 3. output is the function with b, s0, f1, f2, D, pD1, pD2 as \
parameters. The fraction is defined between 0 and 1, the D, Dp, Dp1 and Dp2 \
is in mm^2/s."
}], "Usage",
 CellChangeTimes->{{3.9966566260751095`*^9, 3.996656626280054*^9}},
