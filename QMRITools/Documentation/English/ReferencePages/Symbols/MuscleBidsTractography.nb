Notebook[{

Cell[CellGroupData[{
Cell["MuscleBidsTractography", "ObjectName",
 CellID->150178141,ExpressionUUID->"dbb4fc2f-4d69-2143-8604-6409e6306f8a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b0b1f9b5-d2fd-ea4e-917e-f34f0cb21200"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsTractography",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsTractography"],
    "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "57990e97-8e2f-434a-8dce-736befe86924"],
 "\[LineSeparator]performs tractography on the Muscle-Bids named nii based on \
the config file in the bids sourceFolder dir. If a segmentation is present it \
is used as a mask for per muscle segmentation."
}], "Usage",
 CellChangeTimes->{3.996655586937414*^9},
 CellID->8627112,ExpressionUUID->"03fb5f52-0f68-ba40-9d14-e745c9f950db"],

Cell["The following options can be given: ", "Notes",
 CellID->307599669,ExpressionUUID->"3d28f6cb-fb9b-b441-8f72-b5cfe85c1dca"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f54af5ef-797a-db42-88d5-627620250f81"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["ProcessSubjects",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ProcessSubjects"]], "InlineFormula",
      ExpressionUUID->"e724a3a0-41e9-fa44-9bf5-69d2a9e33a6b"],
     " is an option for Bids functions. Can be a list of bids subject names \
else it is All."
    }], "TableText",ExpressionUUID->"128663d0-15a2-404f-a202-725742f111b4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3f1cd411-3eae-f94d-8aa8-dbaabe5f72f7"], 
    ButtonBox["VersionCheck",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/VersionCheck"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["VersionCheck",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/VersionCheck"]], "InlineFormula",
      ExpressionUUID->"887a4ebc-66d6-e04c-80fb-47ebde8f694a"],
     " is an option for all Bids functions. If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "ab690ff3-084c-5742-83e1-b083a0926e1c"],
     " data processed with an old version is reprocessed."
    }], "TableText",ExpressionUUID->"0babf136-7aad-674d-a8de-ee0e3ae0238f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "18c3b94a-aefb-bb4b-ab99-3c4855919138"], 
    ButtonBox["BidsTractographyMethod",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRITools/ref/BidsTractographyMethod"], "\"\<Full\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["BidsTractographyMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/BidsTractographyMethod"]], 
      "InlineFormula",ExpressionUUID->"8c238724-c871-ee47-ad4f-80563b2cf191"],
     " is an option for ",
     Cell[BoxData[
     "MuscleBidsTractography"], "InlineFormula",ExpressionUUID->
      "2c2f835a-7b7a-e04b-a8da-5018a93e8e54"],
     " and can be \"Full\", \"Tractography\" \nor \"Segmentation\". With \
\"Tractography\" the tractography is performed without segmentation.\nWith \
\"Segmentation\" only the segmentation is performed without tractography. \
With Full both are performed."
    }], "TableText",ExpressionUUID->"24470f05-ca6c-644f-8470-2acaef003998"]}
  }]], "3ColumnTableMod",
 CellID->132131413,ExpressionUUID->"91a2847f-7935-b94d-89c3-30962fa4f814"]
}, Open  ]],

