Notebook[{

Cell[CellGroupData[{
Cell["MakeShapeModel", "ObjectName",
 CellID->149443841,ExpressionUUID->"dcb656a9-2ff1-6749-b3c4-7883e59153f0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"987fcd2d-29f7-f84e-b610-6e9e5ee3bcd5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeShapeModel",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MakeShapeModel"], "[", 
   StyleBox["points", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c1dfd28f-2d56-6940-9fa2-059bf8e0b81c"],
 "\[LineSeparator]makes the statistical shape model for the points given. The \
points per muscle must have the same number of coordinates. The points can be \
obtained form ",
 Cell[BoxData[
  ButtonBox["TemplateToVolume",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/TemplateToVolume"]], "InlineFormula",
  ExpressionUUID->"75d208d1-cf5f-cf4c-8d36-2576161708e3"],
 ". The output is {meanPoints, model} which are needed in ",
 Cell[BoxData[
  ButtonBox["FitShapeModel",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/FitShapeModel"]], "InlineFormula",
  ExpressionUUID->"ea7c45c5-ec66-7543-b8ee-6c46e1edcaaf"],
 "."
}], "Usage",
 CellChangeTimes->{3.996656335055155*^9},
 CellID->131388817,ExpressionUUID->"88dc9aac-f571-2340-bb8a-47326b509d14"],

