Notebook[{

Cell[CellGroupData[{
Cell["UnwrapDCT", "ObjectName",
 CellID->9418698,ExpressionUUID->"6e763509-911e-5c4b-9cda-ff45180e472c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"47dca07a-3e32-a34f-8cde-69ac9500b89e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UnwrapDCT",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/UnwrapDCT"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3f23b012-31b3-064b-bde9-c22067d54a2e"],
 "\[LineSeparator]unwraps the given dataset using DCT transform . The ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "64c707d9-adeb-3a49-a6c8-d16abb8bca3b"],
 " should be between -Pi and Pi. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"89010841-aa30-1b43-8a92-0cb7b4001726"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UnwrapDCT",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/UnwrapDCT"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["weights", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c98c778f-bfe7-d54a-9815-64cbc01fdcbb"],
 "\[LineSeparator]unwraps using weighted least squares, ",
 Cell[BoxData[
  StyleBox["weights", "TI"]], "InlineFormula",ExpressionUUID->
  "01fa4089-324f-ba4a-8aa7-da1abcf2acf7"],
 " can be Automatic or an array with the dimensions of ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "3197a95b-7e9d-8a48-9812-1344a9c7e655"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c093b694-a655-304a-88ad-4ae85944d9f2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UnwrapDCT",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/UnwrapDCT"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"84428d3f-29d1-9f42-8e62-142824ba8152"],
 "\[LineSeparator]is based on DOI: 10.1364/JOSAA.11.000107."
}], "Usage",
 CellChangeTimes->{{4.003804597013876*^9, 4.0038045971911297`*^9}},
 CellID->369391144,ExpressionUUID->"ca187921-d4e0-194a-b3c9-0bd66a9422c5"],

