   {Cell["   ", "ModInfo",ExpressionUUID->
     "b74e1af4-d19f-844f-b109-50758be128ec"], 
    ButtonBox["RobustFitParameters",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/RobustFitParameters"], 
    RowBox[{"{", 
