   {Cell["   ", "ModInfo",ExpressionUUID->
     "87876559-8958-a54e-b30a-b3cf5cfa3937"], 
    ButtonBox["RobustFit",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/RobustFit"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["RobustFit",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RobustFit"]], "InlineFormula",
      ExpressionUUID->"6c3ba3da-d96a-2440-8637-5ccc2689048f"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["Tensor",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Tensor"]], "InlineFormula",
      ExpressionUUID->"b0b3ac7e-f069-2140-ae55-6f51a7deafda"],
     "Calc. If true outliers will be rejected in the fit, only works with \
WLLS.\nIf ",
     Cell[BoxData[
      ButtonBox["FullOutput",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/FullOutput"]], "InlineFormula",
      ExpressionUUID->"cd84e903-bbd1-8846-92b0-fe8e3fe553ac"],
     " is given the outlier map is given."
    }], "TableText",ExpressionUUID->"2c1376d3-fbbb-fb4e-98b8-61d461227879"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f8cc5718-3938-fe4c-9c73-85c78eefceca"], 
    ButtonBox["Parallelize",
     BaseStyle->"Link"], 
    ButtonBox["True",
