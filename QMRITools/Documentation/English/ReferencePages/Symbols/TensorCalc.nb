Notebook[{

Cell[CellGroupData[{
Cell["TensorCalc", "ObjectName",
 CellID->194638704,ExpressionUUID->"0e09fbaa-17aa-724b-983c-004d40e9a607"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a72c5935-3312-1a45-a212-0426cc0a5f9e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/TensorCalc"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["gradients", "TI"], ",", 
    StyleBox["bvec", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "251adc23-0c54-d04e-85e7-49541e4bdba4"],
 "\[LineSeparator]calculates the diffusion tensor for the given dataset. \
allows for multiple unweighted images and multiple bvalues. allows for \
different tensor fitting methods. gradient directions must be in the form \
{{x1,y1,z1}, ..., {xn,yn,zn}} with the unweighted direction as {0,0,0}. ",
 Cell[BoxData[
  StyleBox["bvec", "TI"]], "InlineFormula",ExpressionUUID->
  "3b28397f-5916-5a4f-9159-8366f219f3d0"],
 " the b-vector, with a bvalue defined for each gradient direction. b value \
for unweighted images is 0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9d499451-2ded-0d47-9d0a-310984127448"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/TensorCalc"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["bmatrix", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4b54924f-36a7-cb4f-b6eb-2a60435d7c3f"],
 "\[LineSeparator]calculates the diffusion tensor for the given dataset. \
allows for multiple unweighted images and multiple bvalues. bmat is the ",
 Cell[BoxData[
  StyleBox["bmatrix", "TI"]], "InlineFormula",ExpressionUUID->
  "fb6b8e56-441b-2342-8e53-244430b9c904"],
 " which can be generated using Bmatrix. The bvalue assumed to be is in \
s/mm^2 and therefore the output is in mm^2/2. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f88a8b06-bf13-9244-922e-4e8282926d3f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TensorCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/TensorCalc"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"02b669f1-963b-034a-b7af-092ee572b993"],
 "\[LineSeparator]is based on DOI: 10.1016/j.neuroimage.2013.05.028 and \
10.1002/mrm.25165."
}], "Usage",
 CellChangeTimes->{{3.998533286931776*^9, 3.998533287448572*^9}},
 CellID->462837057,ExpressionUUID->"75705e46-d90f-eb4c-a529-d2ad8f92bbb8"],

Cell["The following options can be given: ", "Notes",
 CellID->340949870,ExpressionUUID->"e1a9eb29-d9f6-8745-9870-df41fd5c28f6"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "aa02f627-ce36-494c-b62e-dcc3ccfaac3a"], 
    ButtonBox["MonitorCalc",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsProcessingTools/ref/MonitorCalc"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell["\<\
MonitorCalc is an option for many processing functions. When true the process \
of the calculation is shown.\
\>", "TableText",ExpressionUUID->"f5d551c6-1bea-924a-b540-c41876cf8627"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7559e32a-5ab6-684c-bfcf-5a2ca9514b0d"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<iWLLS\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"497e09f7-de74-b04f-b2df-b2d98add797d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "cd9f91d7-6131-ce44-a2c2-2ae2a9fc9d03"], 
    ButtonBox["FullOutput",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsTensorTools/ref/FullOutput"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "FullOutput is an option for ",
     Cell[BoxData[
      ButtonBox["Tensor",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Tensor"]], "InlineFormula",
      ExpressionUUID->"4574a4a9-eb8c-e948-bd83-78ebbf44c1fd"],
     "Calc when using b-vector. When ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "3aaae7bf-39a9-5a4e-8552-b6f97ce11a6a"],
     " also the s0 is given as output."
    }], "TableText",ExpressionUUID->"9181055b-ca68-274a-b5e6-b86318f64034"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0bfb36be-71aa-3c48-8ef5-16d64a7bd523"], 
    ButtonBox["RobustFit",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsTensorTools/ref/RobustFit"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "RobustFit is an option for ",
     Cell[BoxData[
      ButtonBox["Tensor",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Tensor"]], "InlineFormula",
      ExpressionUUID->"3e68a200-d8dd-994b-bc32-a832ee82ad27"],
     "Calc. If true outliers will be rejected in the fit, only works with \
WLLS.\nIf FullOutput is given the outlier map is given."
    }], "TableText",ExpressionUUID->"f26df11e-5ad4-e442-9e10-05498b7048a4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f02ea4c7-31da-e441-8161-45f701494270"], 
    ButtonBox["Parallelize",
     BaseStyle->"Link"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Parallelize", "[", 
       StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
      "32d525d7-6264-434f-819c-5424322653e3"],
     " evaluates ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "db3ea5be-115f-ed4e-98fb-41befca35792"],
     " using automatic parallelization."
    }], "TableText",ExpressionUUID->"85ed9f36-ecc5-b040-b99a-1bbad0a1014f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "49844e96-f5c5-474e-b7f0-d6f5cdb673e4"], 
    ButtonBox["RobustFitParameters",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsTensorTools/ref/RobustFitParameters"], 
    RowBox[{"{", 
     RowBox[{"0.1", ",", " ", "5"}], "}"}], Cell[TextData[{
     "RobustFitParameters is an option for ",
     Cell[BoxData[
      ButtonBox["Tensor",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Tensor"]], "InlineFormula",
      ExpressionUUID->"96d3fcbe-c1ca-644a-8e1d-2cf476b66bcd"],
     "Calc. gives the threshold for stopping the iterations and the kappa for \
the outlier margin, {tr,kappa}."
    }], "TableText",ExpressionUUID->"648df12d-3245-b140-9921-ce76dbcd1de5"]}
  }]], "3ColumnTableMod",
 CellID->191943977,ExpressionUUID->"4f47c704-9e40-5742-810a-448898fd3483"]
}, Open  ]],

