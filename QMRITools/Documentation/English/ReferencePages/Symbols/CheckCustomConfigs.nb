Notebook[{

Cell[CellGroupData[{
Cell["CheckCustomConfigs", "ObjectName",
 CellID->441838543,ExpressionUUID->"cba23051-a2c0-b84d-954a-3723b257ebf1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"571da7e1-c480-084b-9836-433b5fa15956"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CheckCustomConfigs",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/CheckCustomConfigs"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "652e631d-3138-ce4e-9407-3ffc12e4ca2a"],
 "\[LineSeparator]lists for each subject that has a custom config, the \
settings that differ from the config file in dir, one row per setting. It \
also checks that the custom config was carried along by the steps: the copy \
in a later stage that is missing, unreadable or different from the first copy \
is highlighted. The stages are checked from the source folder via rawData and \
derivedData to mergeData. Subjects without a custom config are not shown. The \
option ProcessSubjects limits the subjects."
}], "Usage",
 CellChangeTimes->{4.002695807625883*^9},
 CellID->610778819,ExpressionUUID->"3d8fffd0-4b5b-d948-a775-13044ff2e68d"],

Cell["The following options can be given: ", "Notes",
 CellID->279268116,ExpressionUUID->"94ab37c0-f4cb-6746-a8bc-ea58cb0c1ea7"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "cf2b4757-edf1-b647-995d-bd9a2a00c9b0"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell["\<\
ProcessSubjects is an option for Bids functions. Can be a list of bids \
subject names else it is All.\
\>", "TableText",ExpressionUUID->"46168c16-698c-c74e-aa69-a1de5e4f7841"]}
  }]], "3ColumnTableMod",
 CellID->435020188,ExpressionUUID->"01a954e1-61f9-0443-91f0-226e8fae9c81"]
}, Open  ]],

