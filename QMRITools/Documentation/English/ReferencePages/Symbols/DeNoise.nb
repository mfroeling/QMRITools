Notebook[{

Cell[CellGroupData[{
Cell["DeNoise", "ObjectName",
 CellID->431628626,ExpressionUUID->"2d661e2c-12d9-e948-860b-abf03be4b92f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f66a2f59-d48d-6144-bc84-1abbfc5de092"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DeNoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/DeNoise"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["sigma", "TI"], ",", 
    StyleBox["filterSize", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "adf1ad3f-b37a-2643-89fd-71d9391be3d3"],
 "\[LineSeparator]removes Rician noise with standard deviation \"sigma\" from \
the given dataset using a kernel with size \"filterSize\" a gaussian kernel. \
Output is ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "411517a2-661b-0e4c-b14f-e7043c2d40b5"],
 " denoised. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2af14b18-7a53-c64c-9f80-56b93e06a8b9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DeNoise",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/DeNoise"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"0657d09f-b6e4-4e42-833b-b7b65e1922ce"],
 "\[LineSeparator]is based on DOI: 10.1109/TMI.2008.920609."
}], "Usage",
 CellChangeTimes->{{3.9966568652609253`*^9, 3.996656865384451*^9}},
 CellID->294952168,ExpressionUUID->"ffe2e578-17d6-4d40-aeac-c11264dff00d"],

Cell["The following options can be given: ", "Notes",
 CellID->649574618,ExpressionUUID->"d887bdd5-f0dd-5b4f-a7a9-a48b073b54b1"],

