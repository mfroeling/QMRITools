     "DeNoise"], "InlineFormula",ExpressionUUID->
      "a606415e-bc60-a546-9b75-ca5aa92181ab"],
     ". Values can be \"Disk\", \"Box\" or \"Gaussian\"."
    }], "TableText",ExpressionUUID->"024aaabe-2e23-8547-a30a-a7fe86194e9c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b17f0259-e8eb-1048-8057-a4145bb29335"], 
    ButtonBox["DeNoiseMonitor",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DeNoiseMonitor"], 
