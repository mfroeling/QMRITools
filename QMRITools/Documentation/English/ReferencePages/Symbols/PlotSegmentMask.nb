Cell[CellGroupData[{
Cell["PlotSegmentMask", "ObjectName",
 CellID->582198217,ExpressionUUID->"feec3b97-f3ad-e04d-8c1e-88669469081d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d2524a3b-00bb-584c-8753-7ee1e85a4d6b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotSegmentMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/PlotSegmentMask"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["segmask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d03c0813-7c56-f549-bc94-b550eb86f1a6"],
 "\[LineSeparator]plots the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "79e8993e-358c-f640-89f0-e7a9371f9532"],
 " segments created by ",
 Cell[BoxData[
  ButtonBox["CardiacSegment",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CardiacSegment"]], "InlineFormula",
  ExpressionUUID->"ebbaac83-0173-db4b-a026-9c713e09e866"],
 ". mask is a mask the left ventricle that was used in the ",
 Cell[BoxData[
  ButtonBox["CardiacSegment",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CardiacSegment"]], "InlineFormula",
  ExpressionUUID->"462cc890-c1f4-eb4b-b945-3d03f9c22fd8"],
 ". segmask is the output of ",
 Cell[BoxData[
  ButtonBox["CardiacSegment",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CardiacSegment"]], "InlineFormula",
  ExpressionUUID->"4640b921-fe6a-3e44-97bb-e73cd2c07dd9"],
 ". vox is the voxels size, {slice, x, y}. Output is a plot window."
}], "Usage",
