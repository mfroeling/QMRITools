 CellID->170142423,ExpressionUUID->"4b8404aa-6a14-dc4e-8482-f1939dc9b680"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b4cb1173-453a-684b-be69-0a430c598c2b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RPBMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/RPBMFunction"], "[", 
   RowBox[{
    StyleBox["tm", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["d", "TI"], 
       StyleBox["0", "TR"]], ",", 
      StyleBox["tau", "TI"], ",", 
      StyleBox["zeta", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"56714706-6345-264d-a1aa-bd6825d84d89"],
 "\[LineSeparator]generates the RPBM function for the given mixing times ",
 Cell[BoxData[
  StyleBox["tm", "TI"]], "InlineFormula",ExpressionUUID->
  "8ed3ec55-b8e2-c74b-aa65-932c0286ea35"],
 ", with d0, ",
 Cell[BoxData[
  StyleBox["tau", "TI"]], "InlineFormula",ExpressionUUID->
  "6793e608-275a-804c-a10d-b0339719b3c4"],
 " and zeta. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"06c59f6e-a6c2-1d49-8694-0eb76f97d88d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RPBMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/RPBMFunction"], "[", 
   RowBox[{
    StyleBox["tm", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["tau", "TI"], ",", 
      StyleBox["zeta", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"b2a75e4e-d21c-e242-8646-fbee79fa855c"],
 "\[LineSeparator]generates the RPBM function for the given mixing times ",
 Cell[BoxData[
  StyleBox["tm", "TI"]], "InlineFormula",ExpressionUUID->
  "bbb35ab0-439b-504d-8b41-b1212d66cf3a"],
 ", assuming a d0 of 1. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"307645a4-9d84-ef4b-875c-02d7081825fe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RPBMFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/RPBMFunction"], "[", 
   RowBox[{
    StyleBox["tm", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         StyleBox["d", "TI"], 
         StyleBox["0", "TR"]], ",", 
        StyleBox["tau", "TI"], ",", 
        StyleBox["zeta", "TI"]}], "}"}], ",", ".."}], "}"}]}], "]"}]], 
  "InlineFormula",ExpressionUUID->"2047115e-b6ee-024e-ad06-36b29d18329e"],
 "\[LineSeparator]generates the RPBM function for the given mixing times ",
 Cell[BoxData[
  StyleBox["tm", "TI"]], "InlineFormula",ExpressionUUID->
  "91536bd4-0201-794a-9189-659bad4791cd"],
 ", for a list of d0, ",
 Cell[BoxData[
  StyleBox["tau", "TI"]], "InlineFormula",ExpressionUUID->
