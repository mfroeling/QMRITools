     BaseStyle->"Link"], "\"\<CPU\>\"", Cell[
    "XXXX", "TableText",ExpressionUUID->
     "2b78f4ba-32c2-cb4a-94f8-b179e318dd20"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d2e4e631-c584-044b-a2ac-cd60118552cb"], 
    ButtonBox["SplitOverlap",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SplitOverlap"], "0.1", Cell[TextData[{
