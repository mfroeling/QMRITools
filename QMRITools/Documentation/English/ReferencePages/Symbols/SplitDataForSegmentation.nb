Notebook[{

Cell[CellGroupData[{
Cell["SplitDataForSegmentation", "ObjectName",
 CellID->302897661,ExpressionUUID->"64037e02-e11f-2345-97af-a9c0e36410ac"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"79c56a98-97fb-1a43-8801-104555ebffa0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SplitDataForSegmentation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/SplitDataForSegmentation"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3b88fb3f-6f84-6143-b795-cb334a80d8a0"],
 "\[LineSeparator]splits ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "4bde13a1-3ffe-a749-8ac4-78e5cf9c8be3"],
 " for \"Legs\" segmentation,detecting left/right side and upper/lower leg \
position automatically using a classification network. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8ef994f4-d76e-fd47-899e-5136527bf763"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SplitDataForSegmentation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/SplitDataForSegmentation"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6d12b111-1645-1d49-ac7b-a827885c209f"],
 "\[LineSeparator]splits for the specified region. What can be any region \
accepted by ",
 Cell[BoxData[
  ButtonBox["SegmentData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SegmentData"]], "InlineFormula",
  ExpressionUUID->"29514c77-f741-4d41-82c8-cf54c8cde28b"],
 ", i.e. \"Body\", \"LegsBody\", \"LegsHipBody\", \"HipBody\", \
\"UpperLegsBody\", \"LowerLegsBody\", \"ShoulderBody\", \"Legs\", \
\"LegsHip\", \"UpperLegs\", \"LowerLegs\", \"Hip\", \"Shoulder\", or \"Arm\". \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2c02b17c-0a72-2347-9cbe-61c95ed71890"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SplitDataForSegmentation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/SplitDataForSegmentation"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["seg", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e15c58a8-f971-be4a-945e-a4adca614995"],
 "\[LineSeparator]splits both ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "c2b258ab-8c1e-fb49-8fa2-c2fc1047582e"],
 " and segmentation identically for \"Legs\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1e4eb991-d3f9-9340-924a-a28c87a408eb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SplitDataForSegmentation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/SplitDataForSegmentation"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["seg", "TI"], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3339e2b3-b291-c741-b767-bf67c8d1d46d"],
 "\[LineSeparator]does the same for the specified region. Output is \
{{patches, ranges, dim}, locations}."
}], "Usage",
 CellChangeTimes->{{4.0038045842548447`*^9, 4.0038045847611275`*^9}},
 CellID->289662574,ExpressionUUID->"794dfdad-68dd-ce4e-a60b-4b061ca90810"],

Cell["The following options can be given: ", "Notes",
 CellID->203926033,ExpressionUUID->"306a2649-0d48-dd45-b774-0fc00850042d"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1dfd4757-971a-4747-b6c9-4802a7eded70"], 
    ButtonBox["Monitor",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Monitor", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["mon", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
      "c8481f9b-ee64-ff43-93d3-ca76918685ab"],
     " generates a temporary monitor cell in which the continually updated \
current value of ",
     Cell[BoxData[
      StyleBox["mon", "TI"]], "InlineFormula",ExpressionUUID->
      "a2c384e0-0f97-6943-a673-f4ed75e1a1b9"],
     " is displayed during the course of evaluation of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "3185b795-a463-b445-babe-b277ac9f2245"],
     ". "
    }], "TableText",ExpressionUUID->"4fd304d6-5187-8949-8de6-ffcb218e823a"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "270a8026-10cb-1f47-a685-578a50ca6835"], 
    ButtonBox["TargetDevice",
     BaseStyle->"Link"], "\"\<CPU\>\"", Cell[
    "XXXX", "TableText",ExpressionUUID->
     "1cdee2cc-0903-5046-997d-e4baff84374b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9def2396-cf10-5245-8265-10febd5ceea2"], 
    ButtonBox["SplitOverlap",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/SplitOverlap"], 
    "0.05", Cell[TextData[{
     "SplitOverlap is an option of ",
     Cell[BoxData[
     "SplitDataForSegmentation"], "InlineFormula",ExpressionUUID->
      "9805f0c7-0ce0-e946-890b-40f04d05bfcf"],
     ". Has to be a value between 0 and 0.2 and defines how much the left\n\
and right side overlap."
    }], "TableText",ExpressionUUID->"3238de7c-8e9b-514c-a2de-e4c7744b45da"]}
  }]], "3ColumnTableMod",
 CellID->29183951,ExpressionUUID->"2ad8e30d-4c2d-e548-8d3d-e2760b535255"]
