Cell[CellGroupData[{
Cell["SplitDataForSegmentation", "ObjectName",
 CellID->119852058,ExpressionUUID->"ac1e5d13-9e32-1145-9ac3-0f92f2b4c7e2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e4982fa5-1e37-274e-924f-d52c43ca6f45"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SplitDataForSegmentation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/SplitDataForSegmentation"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b4012707-004d-4945-a955-1cef96c90ec4"],
 "\[LineSeparator]splits ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "4a84630f-dc03-e34d-929f-e1fd7e54f7e4"],
 " for \"Legs\" segmentation,detecting left/right side and upper/lower leg \
position automatically using a classification network. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"585d3d12-7e32-d446-a1cb-4e9483b5b4d0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SplitDataForSegmentation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/SplitDataForSegmentation"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bbdf3f9e-bd43-6847-8fdf-5b643a21cc15"],
 "\[LineSeparator]splits for the specified region. What can be \"Legs\", \
\"LegsHip\", \"UpperLegs\", \"LowerLegs\", \"Shoulder\", \"Hip\", or \
\"Body\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f071ad88-bd55-4742-bffd-a9e01a142920"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SplitDataForSegmentation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/SplitDataForSegmentation"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["seg", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "00b3e1b8-0264-ba47-8c58-8fb71da8778c"],
 "\[LineSeparator]splits both ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "ef63466a-8295-7549-92a4-8f035f0bf0e2"],
 " and segmentation identically for \"Legs\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4488061c-9a6b-ab44-bc5f-478f2033fd1c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SplitDataForSegmentation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/SplitDataForSegmentation"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["seg", "TI"], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f1839110-fb48-2a48-8150-307dd6ca856d"],
 "\[LineSeparator]does the same for the specified region. Output is \
{{patches, ranges, dim}, locations}."
}], "Usage",
 CellChangeTimes->{{3.996655574017273*^9, 3.9966555744377117`*^9}},
 CellID->170183103,ExpressionUUID->"779c0ec6-0c24-6147-9516-71ee6266a3f8"],

