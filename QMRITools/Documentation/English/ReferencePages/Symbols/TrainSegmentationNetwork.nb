Notebook[{

Cell[CellGroupData[{
Cell["TrainSegmentationNetwork", "ObjectName",
 CellID->893219631,ExpressionUUID->"20df9294-e512-2244-8fcb-ed4efb55213c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"14c007b2-680b-3344-b50e-17a4e72e7757"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TrainSegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/TrainSegmentationNetwork"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["inFol", "TI"], ",", 
     StyleBox["outFol", "TI"]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"311f2684-8e8b-fb49-a1f2-caa81966f026"],
 "\[LineSeparator]trains a segmentation network from scratch. Training data \
should be wxf files in inFol. Progress is saved each round to outFol. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e82f1bcf-504f-b34e-bace-4202831fa2d4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TrainSegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/TrainSegmentationNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["inFol", "TI"], ",", 
      StyleBox["outFol", "TI"]}], "}"}], ",", 
    StyleBox["netCont", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4eec39a7-28d0-1848-915b-ca772bd09100"],
 "\[LineSeparator]continues training. ",
 Cell[BoxData[
  StyleBox["netCont", "TI"]], "InlineFormula",ExpressionUUID->
  "53c8125d-5e44-cf49-8c74-ee4f6948e972"],
 " can be \"Start\" to restart, a NetGraph, a wlnet file, or a previous \
outFol to continue from the last saved network. Loss functions can be All or \
a subset of {\"Dice\", \"Jaccard\", \"Tversky\", \"MSD\", \"CE\", \"Focal\", \
\"TopK\"}."
}], "Usage",
 CellChangeTimes->{{3.996655573267248*^9, 3.996655573379959*^9}},
 CellID->368701784,ExpressionUUID->"3bda0f8a-a871-ea4f-bc5a-fdaadcaece2b"],

Cell["The following options can be given: ", "Notes",
 CellID->449085591,ExpressionUUID->"d29d7a03-7c86-3642-881a-d563198a7f8f"],

