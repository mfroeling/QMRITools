       ButtonData->"paclet:QMRITools/ref/RoundLength"]], "InlineFormula",
      ExpressionUUID->"a8194729-5436-e047-8c39-5e732fb36831"],
     " is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "599c9b69-3e63-a641-acc9-c687304b81f6"],
     ". Defines how many batches will be seen during each training round."
    }], "TableText",ExpressionUUID->"69303d0c-d1b6-dc48-9b1d-06af7435c2b8"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "cb712652-04b2-564f-bee0-bc1ff2e2feab"], 
    ButtonBox["MaxTrainingRounds",
     BaseStyle->"Link"], "150", Cell["\<\
MaxTrainingRounds is an option for NetTrain and related functions that \
specifies the maximum number of rounds of training to do.\
\>", "TableText",ExpressionUUID->"b3e94ae0-1a7e-f946-ab1f-1a747183a621"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2a957d98-23ae-044c-bf60-41066a5e5395"], 
    ButtonBox["BlockType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/BlockType"], "\"\<ResNet\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["BlockType",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/BlockType"]], "InlineFormula",
      ExpressionUUID->"5279a027-3158-964a-b5c6-d9887fa0541a"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"67060826-212d-de4e-b9f4-8fbdaaad97e2"],
     ". It specifies the type of block used in the network. It can be \
\"Conv\", \"UNet\", \"ResNet\", \"DenseNet\", \"Inception\", or \"U2Net\"."
    }], "TableText",ExpressionUUID->"10cc048b-6e93-ac45-95f0-180e014c5421"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2fdd997c-8871-a74f-bdc3-145263dd1d6f"], 
    ButtonBox["NetworkArchitecture",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NetworkArchitecture"], "\"\<UNet\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["NetworkArchitecture",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NetworkArchitecture"]], 
      "InlineFormula",ExpressionUUID->"5beacd74-8d3a-8f4c-86dd-be742ed40f14"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"5f030bf5-3f17-5148-ab59-5f9cf3db2ed4"],
     ". It defines the architecture of the network. It can be \"UNet\", \
\"UNet+\", or \"UNet++\".\nFor \"UNet+\" or \"UNet++\" it can also be {arch, \
i} where i specifies how many of the top layers are connected to the mapping \
layer."
    }], "TableText",ExpressionUUID->"34182713-6a95-b44b-bbc7-cf9fba2f2638"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bd08e1f3-33f3-6a4d-97c3-df080bf66fae"], 
    ButtonBox["ActivationType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/ActivationType"], "\"\<GELU\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["ActivationType",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ActivationType"]], "InlineFormula",
      ExpressionUUID->"200401d2-9f4e-3f4a-8375-00cb45ebd3a7"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"4994065e-155c-754e-b997-a601c21d48e1"],
     ". It specifies which activation layer is used in the network. It can be \
\"LeakyRELU\" or any type allowed \nby a \"name\" definition in \
ElementwiseLayer."
    }], "TableText",ExpressionUUID->"64100e8c-2155-9143-bc40-b16270659aee"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2964df50-9452-6f47-90f7-c311d7e5a635"], 
    ButtonBox["NormalizationType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NormalizationType"], "\"\<Batch\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["NormalizationType",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NormalizationType"]], 
      "InlineFormula",ExpressionUUID->"fd8d3041-b852-2c47-912b-d929ce9566fc"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"734ee108-9c62-cd46-87ba-a475bea66e03"],
     ". It specifies which normalization layer is used in the network. It can \
be \"Batch\" or \"Instance\" for \neither BatchNormalization or \
NormalizationLayer which is instance normalization."
    }], "TableText",ExpressionUUID->"e0659304-234e-314d-bab2-bda8240c6e07"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "10cec251-26f9-b14e-8de9-5f2f5e01ee56"], 
    ButtonBox["RescaleMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/RescaleMethod"], "\"\<Conv\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["RescaleMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RescaleMethod"]], "InlineFormula",
      ExpressionUUID->"c4a3f0e2-0c18-8b4a-91c5-710f691e1148"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"24737fae-cc3b-994a-a60f-2cc3d6b39f96"],
     ". It specifies how the network rescales. It can be \"Conv\" or \"Pool\"."
    }], "TableText",ExpressionUUID->"822fed04-5108-a54e-a312-719233ff7c49"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "df5787c4-df25-bc4a-8472-a463bd0dae08"], 
    ButtonBox["CatenateMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/CatenateMethod"], "\"\<Cat\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["CatenateMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CatenateMethod"]], "InlineFormula",
      ExpressionUUID->"825e2a2b-067d-3746-a359-a6c47d1f3153"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"aebb4a0d-d4ea-7142-8d92-e29feebe5a55"],
     ". It specifies how the network catenates the skip and upscale channel. \
It can be \"Tot\", or \"Cat\"."
    }], "TableText",ExpressionUUID->"bed7a212-aa1f-df44-9a3e-8f935da9601c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e1b7e37d-de69-f943-814c-5d9a04bb9365"], 
    ButtonBox["NetworkDepth",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NetworkDepth"], "5", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["NetworkDepth",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NetworkDepth"]], "InlineFormula",
      ExpressionUUID->"1d213dc0-266e-f846-bda7-faf5fb5d0269"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"5ccd4c9d-37cd-824c-8e3f-abb039b3eabe"],
     ". It specifies how deep the UNET will be."
    }], "TableText",ExpressionUUID->"267bba82-c276-f44b-a77b-1be18cd3df41"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "466947c7-a748-c44b-8466-2002fee4e727"], 
    ButtonBox["DownsampleSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DownsampleSchedule"], "2", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["DownsampleSchedule",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DownsampleSchedule"]], 
      "InlineFormula",ExpressionUUID->"1d6ef085-7d51-5b43-b410-1a41a1ed18da"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"ee919c93-912a-4946-85a5-35104e06d5b8"],
     ". It defines how the data is downsampled for each of the deeper layers \
of the Unet. \nBy default is is a factor two for each layer. A custom \
schedule for a 5 layer 3D Unet could be {{2,2,2},{1,2,2},{2,2,2},{1,2,2}, 1}.\
\nThe deepest layer is always downsampled by 1 and therefore not needed to be \
specified."
    }], "TableText",ExpressionUUID->"1362aa14-41fb-8442-a376-3bb500e237d3"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2029f168-d9fa-7544-8cbd-2c46d01be8fb"], 
    ButtonBox["SettingSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SettingSchedule"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SettingSchedule",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SettingSchedule"]], "InlineFormula",
      ExpressionUUID->"0a9eb248-1871-5043-a7a3-366ae60e0032"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"e5da6d86-6c28-234a-91b6-fb636b457135"],
     ". It defines the settings for the Unet blocks. If one setting is given \
it applied to all layers.\nIf a list of settings is given the settings can be \
different per layer. The following settings are the default settings. \n\
\"Unet\": convolution block repetitions, 2, \"ResNet\" -> convolution block \
repetitions, 2, \"DenseNet\" -> {dense depth, block repetitions}, {4,2},\n\
\"Inception\" -> {inception width, block repetitions}, {4,2}, \"U2Net\"-> \
{Unet depth, downscale}, {5, True}."
    }], "TableText",ExpressionUUID->"03f3f629-d5cf-f240-bb08-4e0fe14f9be4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2cfa92b6-b4dc-8145-baaf-84eb4f1bbf06"], 
    ButtonBox["FeatureSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/FeatureSchedule"], "32", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["FeatureSchedule",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/FeatureSchedule"]], "InlineFormula",
      ExpressionUUID->"5e4654b5-0b5e-164a-a9c6-9981f91233cf"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"cf49e192-40f1-a849-a402-e3ebf6cbe5ef"],
     ". It defines how the number of features is up-sampled for each of the \
deeper layers of the Unet.\nBy default it increases the number of features by \
a factor 2 each layer, i.e. {1, 2, 4, 8, 16}."
    }], "TableText",ExpressionUUID->"a0257e89-a84b-d341-9f0a-d385673376e7"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a60ec5e5-c712-2c43-b745-74fa42018b6f"], 
    ButtonBox["MultiChannel",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MultiChannel"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["MultiChannel",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MultiChannel"]], "InlineFormula",
      ExpressionUUID->"5a5cc08d-d361-7141-bca3-5a75ead36160"],
     " is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "1c55f812-c723-ab40-897c-90b96ec840bf"],
     ", If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "c3171462-061a-3f4a-992a-4ad2923aa65d"],
     " it will train on multi channel input data. If set to False it will \
select a random channel."
    }], "TableText",ExpressionUUID->"a72bd210-a31b-4a4c-a6a2-28224d31b2c7"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9fc6f754-8cc6-4d49-b82a-1b80871c887d"], 
    ButtonBox["AugmentData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AugmentData"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AugmentData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AugmentData"]], "InlineFormula",
      ExpressionUUID->"329f326d-0a65-1745-8e9d-30bfaf5f7e7b"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"c5d08b4d-719d-404c-a62c-773fb44f0169"],
     " and ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "55516a12-8834-ca43-a1f1-c906e94dbe69"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "07cb9e25-557e-a34e-bab5-4f2163d531ac"],
     " the training data is augmented.\nIt can also be set to \"2D\" or \
\"3D\" to control if augmentation is done through plane or only in-plane."
    }], "TableText",ExpressionUUID->"6a9ac61c-c096-d346-ad2f-9d798e9ae477"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "faeffa40-2c29-9945-bfa0-34409d374ee4"], 
    ButtonBox["PadData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PadData"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PadData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PadData"]], "InlineFormula",
      ExpressionUUID->"8969c2eb-c0d9-084b-9b1a-3e4f3c71d4a2"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"ceee0922-e922-0548-aa5b-5f305cebee6d"],
     " and ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "6c8625f7-ff39-874d-8f29-db9c20873a81"],
     ".. If set to an integers the that number of slices on the top and \
bottom of the \ndata can be made 0. This is done to learn cut of datasets."
