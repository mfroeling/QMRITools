Notebook[{

Cell[CellGroupData[{
Cell["TrainSegmentationNetwork", "ObjectName",
 CellID->597621581,ExpressionUUID->"df5dcb53-ead9-6b46-aee6-4e0845b53a78"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f4a0d71d-e28d-2342-aa82-c7979bfcb887"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TrainSegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/TrainSegmentationNetwork"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["inFol", "TI"], ",", 
     StyleBox["outFol", "TI"]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"e30f2f8b-ac77-5d4d-8e1d-eb35ef402f8a"],
 "\[LineSeparator]trains a segmentation network from scratch. Training data \
should be wxf files in inFol. inFol can also be a list of folders, in which \
case wxf files from all folders are used. Progress is saved each round to \
outFol. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f3aa63f6-8604-834d-be2d-462f2ab9fc58"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TrainSegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/TrainSegmentationNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["inFol", "TI"], ",", 
      StyleBox["outFol", "TI"]}], "}"}], ",", 
    StyleBox["netCont", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "23f1d932-df7a-9441-8ed5-fe863e1c8263"],
 "\[LineSeparator]continues training. ",
 Cell[BoxData[
  StyleBox["netCont", "TI"]], "InlineFormula",ExpressionUUID->
  "517f7185-e82c-2943-98ad-193132a9ee3d"],
 " can be \"Start\" to restart, a NetGraph, a wlnet file, or a previous \
outFol to continue from the last saved network. Loss functions can be ",
 Cell[BoxData[
  ButtonBox["All",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "982f517d-ae08-b948-a6c6-e39d1aa33b86"],
 " or a subset of {\"Dice\", \"Jaccard\", \"Tversky\", \"MSD\", \"CE\", \
\"Focal\", \"TopK\"}. If ",
 Cell[BoxData[
  RowBox[{"MaskedPretraining", "->", 
   ButtonBox[
    ButtonBox["True",
     BaseStyle->"Link"],
    BaseStyle->"Link"]}]], "InlineFormula",ExpressionUUID->
  "4d07128f-9ca3-8c47-885c-e58eec75eac4"],
 " self supervised pretraining is done instead: the network gets a single \
output channel, only the MSD and MAE losses are used, and the training data \
is masked and noise filled as generated by ",
 Cell[BoxData[
  ButtonBox["GetTrainData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
  ExpressionUUID->"95e40242-755a-ba4a-b015-8b782f32be33"],
 " with ",
 Cell[BoxData[
  RowBox[{"MaskedPretraining", "->", "True"}]], "InlineFormula",
  ExpressionUUID->"29007d02-1c93-de4e-8656-3f2430a27ec5"],
 "."
}], "Usage",
 CellChangeTimes->{{4.0038045953011684`*^9, 4.003804595452587*^9}},
 CellID->304391578,ExpressionUUID->"6a720f70-5cc7-6343-9af6-16de550664d5"],

Cell["The following options can be given: ", "Notes",
 CellID->515358602,ExpressionUUID->"52c3f195-ee94-774b-ab3b-f23f5750c3b8"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d7a2a0d3-c779-1c41-b181-efe6f2c23b41"], 
    ButtonBox["LoadTrainingData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/LoadTrainingData"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "LoadTrainingData is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "6ff84b57-ace0-7c40-aa4c-c6b54751e2bd"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "8fa47f6b-bded-2640-81d4-c12a9eff32b1"],
     " the training data is loaded from the disk."
    }], "TableText",ExpressionUUID->"da40d99e-e004-5b45-9842-2e59d9e6a38d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "acfd7d8e-058d-e14c-ba05-7a4d584fb564"], 
    ButtonBox["TargetDevice",
     BaseStyle->"Link"], "\"\<GPU\>\"", Cell[
    "XXXX", "TableText",ExpressionUUID->
     "39423789-c674-f84d-88a3-76c7a6585a6c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0c3a1e11-2bb0-a646-ac29-a0bd4b3beb52"], 
    ButtonBox["UseParallelKernels",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/UseParallelKernels"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "UseParallelKernels is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "fd1d6fb9-4e83-e342-9827-3d7ebd1118fe"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "8626cea0-7a29-a143-b3fb-88c4615e4518"],
     " (default), producer kernels are launched\nas raw WSTP links, data \
loading and batch augmentation run on these separate kernels while NetTrain \
runs concurrently\non its own kernel, which can substantially speed up \
training when augmentation is the bottleneck. If set to \"Parallel\",\nthe \
older shared-queue Parallel-framework kernel pool is used instead. If set to \
{",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "973b64c1-e2f8-bb41-8ded-c761cc23017e"],
     ", n} or {\"Parallel\", n} at most\nn producer kernels are used, useful \
for debugging on a small scale. If set to False batches are generated \
in-process."
    }], "TableText",ExpressionUUID->"9bc1f2eb-9a2f-4743-8fe4-31853b6233b8"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ac945d7e-db96-8a48-b593-76ecb4054ead"], 
    ButtonBox["Monitor",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Monitor", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["mon", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
      "19bef268-a9e8-7642-b06a-8923ff6d1412"],
     " generates a temporary monitor cell in which the continually updated \
current value of ",
     Cell[BoxData[
      StyleBox["mon", "TI"]], "InlineFormula",ExpressionUUID->
      "669c2497-0a3a-9d4e-8234-84ccc068d586"],
     " is displayed during the course of evaluation of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "5e1a785f-313c-0c4c-a1ab-633481a040a1"],
     ". "
    }], "TableText",ExpressionUUID->"75497846-b269-2044-9d40-4b8047c7ef9b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d384e0e4-e251-d044-a094-84c0a728eb16"], 
    ButtonBox["MonitorInterval",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MonitorInterval"], 
    "2", Cell[TextData[{
     "MonitorInterval is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "6d7a0aba-ce5a-be48-b343-5218f7fc5b91"],
     ". It defines how often the training is monitored."
    }], "TableText",ExpressionUUID->"a08ae75a-bfde-1c45-8db9-028fc017a1a3"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6df18fbc-30f2-984b-845b-bf4bdb47546a"], 
    ButtonBox["PatchSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PatchSize"], 
    RowBox[{"{", 
     RowBox[{"32", ",", " ", "96", ",", " ", "96"}], "}"}], Cell[TextData[{
     "PatchSize is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "98b8796d-8481-4143-8725-9eabd5705b5a"],
     ". Defines the patch size used in the network training."
    }], "TableText",ExpressionUUID->"cdd0081d-2422-6041-8027-30dd7ba36875"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a04c7c25-49d8-394b-87c8-284392cd7865"], 
    ButtonBox["BatchSize",
     BaseStyle->"Link"], "2", Cell["\<\
BatchSize is an option for NetTrain and related functions that specifies the \
size of a batch of examples to process together.\
\>", "TableText",ExpressionUUID->"6651d54e-fc61-074f-ba25-f49380660117"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e7bb8e37-f888-984c-ba54-61afbb5e60f8"], 
    ButtonBox["PatchesPerSet",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PatchesPerSet"], "1", 
    Cell[TextData[{
     "PatchesPerSet is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"a08add83-6375-984d-baa5-d36c873e3506"],
     ". Defines how many random patches per dataset are created within the \
batch."
    }], "TableText",ExpressionUUID->"b0b8ace3-fb5e-4441-81ef-0df357ee2699"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "702663d8-0541-d140-a0b0-41f449262a3a"], 
    ButtonBox["MultiChannel",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MultiChannel"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["MultiChannel",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MultiChannel"]], "InlineFormula",
      ExpressionUUID->"1d1c8c86-3a3c-cd48-8e8a-6a6d4b8902a4"],
     " is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "463d779d-e524-294e-87e2-04af8c6d6d13"],
     ". Multi channel training is not yet implemented and the option \
currently has no effect.\nNetworks always have a single input channel, for 4D \
training data a random channel is selected for each sample."
    }], "TableText",ExpressionUUID->"2be72760-c276-1b46-892d-fd0c9e58756c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d9d0d6ce-b0ec-074d-8246-4dd2d31a6275"], 
    ButtonBox["AugmentData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentData"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "AugmentData is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"370a2206-b727-ee4b-8d01-5c3064a515d3"],
     " and ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "46a36ade-fe98-9e4a-b851-7dd8e5864b95"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "2def53bc-c5b8-f343-a665-8564f0aa3251"],
     " the training data is augmented.\nIt can also be set to \"2D\" or \
\"3D\" to control if augmentation is done through plane or only in-plane."
    }], "TableText",ExpressionUUID->"cdad96d3-8691-e643-8997-c28f1ed200b5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bf58f665-d1d3-4b49-813c-f24d87eab684"], 
    ButtonBox["PadData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PadData"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "PadData is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"d91ad4ec-9345-4741-a60e-4f3f56d8f57f"],
     " and ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "0840386c-63b0-324b-aee4-c2c16803a5d1"],
     ".. If set to an integers the that number of slices on the top and \
bottom of the\ndata can be made 0. This is done to learn cut of datasets."
    }], "TableText",ExpressionUUID->"1fa19474-297b-a64d-9b26-7970285630b6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "25cef124-2c11-c241-a537-37b80709a9ee"], 
    ButtonBox["MaskedPretraining",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MaskedPretraining"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["Mask",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Mask"]], "InlineFormula",
      ExpressionUUID->"a60ac4ca-22d4-1f41-8335-140ccaf75a27"],
     "edPretraining is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"5b42948d-25d5-7d4e-b7cc-8b8c14d87788"],
     " and ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "5a19f3b8-3504-1444-b027-54db2592dfba"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "caf18968-2a5d-3f44-84fc-ddc3d92a02d0"],
     " self supervised masked-pretraining data/mode is used instead\nof \
segmentation data: the target becomes the clean data itself and the input is \
masked with noise filled blocks."
    }], "TableText",ExpressionUUID->"327b959b-4976-b640-a1d2-9a5c180a2637"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e3c50ecc-a3ff-4344-b0f2-a3e29cbfb0c6"], 
    ButtonBox["RoundLength",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/RoundLength"], "256", 
    Cell[TextData[{
     "RoundLength is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "e5da2758-77d2-4d44-b56d-dffacc47d8da"],
     ". Defines how many batches will be seen during each training round."
    }], "TableText",ExpressionUUID->"1c9a8a2e-81e7-ac4b-a2d5-2b7ca5e3a360"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "08bd5129-2809-ec44-8d0b-962e1a0b49b5"], 
    ButtonBox["MaxTrainingRounds",
     BaseStyle->"Link"], "350", Cell["\<\
MaxTrainingRounds is an option for NetTrain and related functions that \
specifies the maximum number of rounds of training to do.\
\>", "TableText",ExpressionUUID->"d0b38fba-c39b-a54c-8640-f2e9138b8728"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "729d764a-a94b-7f45-86ee-b7c7a47901be"], 
    ButtonBox["RestartLearningCycle",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsSegmentationTools/ref/RestartLearningCycle"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "RestartLearningCycle is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "4bc8d36a-3632-354c-a6eb-840f2b604731"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "9d76796d-c750-de49-a1e7-ba4c436a0b70"],
     " and continuing training from a previous run, the one-cycle\nlearning \
rate schedule (including its warmup) is restarted from 0 and fit to the \
remaining rounds, instead of resuming mid-cycle where the\nprevious run left \
off."
    }], "TableText",ExpressionUUID->"13480bd8-32a8-ba43-838f-25abbfd39e9c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e36f8572-2acf-d64b-a82f-4d601c06ff50"], 
    ButtonBox["BlockType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/BlockType"], "\"\<ResNet\>\"", 
    Cell["\<\
BlockType is an option for MakeUnet. It specifies the type of block used in \
the network. It can be \"Conv\", \"UNet\", \"ResNet\", \"DenseNet\", \
\"Inception\", or \"U2Net\".\
\>", "TableText",ExpressionUUID->"a4eab0ca-c90c-c04a-ab4f-356c8b73d0ce"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "952ec03f-840c-f642-85ba-619ab7f19cc6"], 
    ButtonBox["NetworkArchitecture",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/NetworkArchitecture"], \
"\"\<UNet\>\"", Cell["\<\
NetworkArchitecture is an option for MakeUnet. It defines the architecture of \
the network. It can be \"UNet\", \"UNet+\", or \"UNet++\".
For \"UNet+\" or \"UNet++\" it can also be {arch, i} where i specifies how \
many of the top layers are connected to the mapping layer.\
\>", "TableText",ExpressionUUID->"5ff23eeb-dc7b-b34b-9cee-06fcf1f323b4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9c4475e0-1919-824a-b234-2cead08fc63e"], 
    ButtonBox["ActivationType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/ActivationType"], "\"\<GELU\>\"",
     Cell["\<\
ActivationType is an option for MakeUnet. It specifies which activation layer \
is used in the network. It can be \"LeakyRELU\" or any type allowed 
by a \"name\" definition in ElementwiseLayer.\
\>", "TableText",ExpressionUUID->"b6aa2508-9f48-f946-8f2b-5dd0186b8cc2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4356df66-a3d5-0b46-99a7-14152af7a6fc"], 
    ButtonBox["NormalizationType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/NormalizationType"], \
"\"\<Instance\>\"", Cell["\<\
NormalizationType is an option for MakeUnet. It specifies which normalization \
layer is used in the network. It can be \"Batch\" or \"Instance\" for 
either BatchNormalization or NormalizationLayer which is instance \
normalization.\
\>", "TableText",ExpressionUUID->"67610087-0a0f-f146-b1c0-10be5a40de02"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2f917009-67f7-9744-bc7c-6eff30742eeb"], 
    ButtonBox["RescaleMethod",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/RescaleMethod"], "\"\<ConvS\>\"",
     Cell["\<\
RescaleMethod is an option for MakeUnet. It specifies how the network \
rescales. It can be \"Conv\" or \"Pool\".\
\>", "TableText",ExpressionUUID->"3b5b869d-3f40-dc48-851f-b8a3f7f5cbe2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7a7335b6-81d0-274c-8c08-f5ccc32d8c55"], 
    ButtonBox["CatenateMethod",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/CatenateMethod"], "\"\<Tot\>\"",
     Cell["\<\
CatenateMethod is an option for MakeUnet. It specifies how the network \
catenates the skip and upscale channel. It can be \"Tot\", or \"Cat\".\
\>", "TableText",ExpressionUUID->"b5227302-4414-ae45-bdc4-053575978923"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b24ca7ae-8ba3-7c4a-9e17-91f39e8233c9"], 
    ButtonBox["NetworkDepth",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/NetworkDepth"], "5", 
    Cell["\<\
NetworkDepth is an option for MakeUnet. It specifies how deep the UNET will \
be.\
\>", "TableText",ExpressionUUID->"5d22f7c1-b9b2-7341-b77a-5f4ea71d3c78"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f2d821d5-a240-1a4d-b1de-798035613091"], 
    ButtonBox["DownsampleSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/DownsampleSchedule"],
     "2", Cell["\<\
DownsampleSchedule is an option for MakeUnet. It defines how the data is \
downsampled for each of the deeper layers of the Unet. 
By default is is a factor two for each layer. A custom schedule for a 5 layer \
3D Unet could be {{2,2,2},{1,2,2},{2,2,2},{1,2,2}, 1}.
The deepest layer is always downsampled by 1 and therefore not needed to be \
specified.\
\>", "TableText",ExpressionUUID->"207a875e-db75-4d41-9c11-423b3643864c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ec3ee9cc-1bf4-684d-8206-db0c4f2cb293"], 
    ButtonBox["SettingSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SettingSchedule"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SettingSchedule",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SettingSchedule"]], "InlineFormula",
      ExpressionUUID->"24f96109-37de-dc42-ba9a-837d00b2eea7"],
     " is an option for MakeUnet. It defines the settings for the Unet \
blocks. If one setting is given it applied to all layers.\nIf a list of \
settings is given the settings can be different per layer. The following \
settings are the default settings. \n\"Unet\": convolution block repetitions, \
2, \"ResNet\" -> convolution block repetitions, 2, \"DenseNet\" -> {dense \
depth, block repetitions}, {4,2},\n\"Inception\" -> {inception width, block \
repetitions}, {4,2}, \"U2Net\"-> {Unet depth, downscale}, {5, True}."
    }], "TableText",ExpressionUUID->"52596ea2-dd9d-2949-ae87-4b629307bec5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6d00e086-356b-1f46-951a-46487491ac47"], 
    ButtonBox["FeatureSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/FeatureSchedule"], 
    "32", Cell["\<\
FeatureSchedule is an option for MakeUnet. It defines how the number of \
features is up-sampled for each of the deeper layers of the Unet.
By default it increases the number of features by a factor 2 each layer, i.e. \
{1, 2, 4, 8, 16}.\
\>", "TableText",ExpressionUUID->"4e8c2e14-eddf-3946-972b-5128e4c30540"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c0efef2d-3c7e-4d46-afdc-bcb6e48f997b"], 
    ButtonBox["LossFunction",
     BaseStyle->"Link"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell["\<\
LossFunction is an option for NetTrain that specifies how to compare actual \
and requested outputs from a neural net.\
\>", "TableText",ExpressionUUID->"178efaad-7cdc-d24f-9151-dd9248e6df44"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2be1997f-ffe8-7740-90d9-df9dee9390cf"], 
    ButtonBox["DropoutRate",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/DropoutRate"], "0.2",
     Cell["\<\
DropoutRate is an option for MakeUnet. It specifies how much dropout is used \
after each block. It is a value between 0 and 1, default is .2.\
\>", "TableText",ExpressionUUID->"d75b4a61-11ae-344f-a4ce-6119c1a6a2e5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "624d7a9c-b868-f043-ae7f-23757d4a734f"], 
    ButtonBox["LearningRate",
     BaseStyle->"Link"], "0.001", Cell["\<\
LearningRate is an option for NetTrain that specifies the rate at which to \
adjust neural net weights in order to minimize the training loss.\
\>", "TableText",ExpressionUUID->"3954b4be-9799-2e4c-b24d-2fa7e07ab5f0"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3af5744a-c111-754e-aedf-67594ec7a629"], 
    ButtonBox["L2Regularization",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/L2Regularization"], 
    "0.0001", Cell[TextData[{
     "L2Regularization is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "e5cc6071-014e-fb45-9029-2723225624d2"],
     ". It defines the L2 regularization factor."
    }], "TableText",ExpressionUUID->"c8e8ecd1-2bcf-4246-9492-b5f6d14b26a5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e51f63b9-209b-d641-84dd-4f7a11395726"], 
    ButtonBox["FreezeEncoderDepth",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/FreezeEncoderDepth"], 
    ButtonBox["None",
     BaseStyle->"Link"], Cell[TextData[{
     "FreezeEncoderDepth is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "7a9a0d17-48e9-e04a-84de-7bcc7ad9affd"],
     ". If set to an integer n, freezes the first n \nencoder blocks of a \
pretrained input network so their weights are not updated during training, \
useful for transfer learning \nfrom a pretrained encoder. Only applies when \
netCont is not \"Start\".\n",
     Cell[BoxData[
      ButtonBox["Default",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "307376e8-83cc-4142-9bf8-a65a1830c175"],
     " is None, which trains all layers."
    }], "TableText",ExpressionUUID->"a4632b55-160a-9140-a5c9-d70bae280136"]}
  }]], "3ColumnTableMod",
 CellID->101162844,ExpressionUUID->"71bfa4bc-a07a-b64c-b2df-c980a0d4f90b"]
}, Open  ]],

