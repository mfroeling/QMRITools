Notebook[{

Cell[CellGroupData[{
Cell["TrainSegmentationNetwork", "ObjectName",
 CellID->111274011,ExpressionUUID->"6599b47d-527b-6a4b-8cf6-892682cd5fd8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bceb07ef-251a-5646-af9d-258340871275"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TrainSegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/TrainSegmentationNetwork"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["inFol", "TI"], ",", 
     StyleBox["outFol", "TI"]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"6f39d11c-7c3b-6944-87ab-2c1f364a7145"],
 "\[LineSeparator]trains a segmentation network from scratch. Training data \
should be wxf files in inFol. inFol can also be a list of folders, in which \
case wxf files from all folders are used. Progress is saved each round to \
outFol. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0ab569b8-70bd-194b-837b-65d310634f3a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TrainSegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/TrainSegmentationNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["inFol", "TI"], ",", 
      StyleBox["outFol", "TI"]}], "}"}], ",", 
    StyleBox["netCont", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "493b4d2c-c315-f64c-8dd9-58a0dc2ff8dc"],
 "\[LineSeparator]continues training. ",
 Cell[BoxData[
  StyleBox["netCont", "TI"]], "InlineFormula",ExpressionUUID->
  "b0f183d4-8681-5045-90f0-5db727b5f611"],
 " can be \"Start\" to restart, a NetGraph, a wlnet file, or a previous \
outFol to continue from the last saved network. Loss functions can be All or \
a subset of {\"Dice\", \"Jaccard\", \"Tversky\", \"MSD\", \"CE\", \"Focal\", \
\"TopK\"}. If ",
 Cell[BoxData[
  RowBox[{"MaskedPretraining", "->", 
   ButtonBox[
    ButtonBox["True",
     BaseStyle->"Link"],
    BaseStyle->"Link"]}]], "InlineFormula",ExpressionUUID->
  "158a9fec-eeed-d745-8210-915231ed7348"],
 " self supervised pretraining is done instead: the network gets a single \
output channel, only the MSD and MAE losses are used, and the training data \
is masked and noise filled as generated by ",
 Cell[BoxData[
  ButtonBox["GetTrainData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
  ExpressionUUID->"71825a0e-61ab-5249-ac58-ebbf93c2b621"],
 " with ",
 Cell[BoxData[
  RowBox[{"MaskedPretraining", "->", "True"}]], "InlineFormula",
  ExpressionUUID->"cd2d27f0-6f85-9349-9dfa-acacc9bafcad"],
 "."
}], "Usage",
 CellChangeTimes->{{3.998533295653366*^9, 3.998533295977312*^9}},
 CellID->545911823,ExpressionUUID->"ab4f6bc4-a871-1f40-a8b6-c8f9cb7944a3"],

Cell["The following options can be given: ", "Notes",
 CellID->13135999,ExpressionUUID->"174c6ff9-fd87-cb48-bb21-5226c9514fd1"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9fbedd72-9c5c-c44e-92fe-62b856a7dcfc"], 
    ButtonBox["LoadTrainingData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/LoadTrainingData"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "LoadTrainingData is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "ccae1e8d-afc7-7044-ba9b-6a62b17ab9fd"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "438a79d7-6752-fc47-9f87-ad93a50104ec"],
     " the training data is loaded from the disk."
    }], "TableText",ExpressionUUID->"b5a5f507-a7cf-664f-be07-9b69a762baa2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ad20b50e-f320-0743-86aa-17e45465ee3a"], 
    ButtonBox["TargetDevice",
     BaseStyle->"Link"], "\"\<GPU\>\"", Cell[
    "XXXX", "TableText",ExpressionUUID->
     "665cda1d-f8ac-8443-8175-5d04783a2350"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b12f9933-8780-ae40-aaef-9e3ad23dbcda"], 
    ButtonBox["UseParallelKernels",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/UseParallelKernels"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["UseParallelKernels",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/UseParallelKernels"]], 
      "InlineFormula",ExpressionUUID->"e44e75fd-f7d1-904f-b82d-ec852f22eafd"],
     " is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "ac999c4c-837c-894b-a9f7-6fab11427dd6"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "72853c39-4b4f-7840-8094-225d3cd3bdcd"],
     " (default), producer kernels are launched\nas raw WSTP links, data \
loading and batch augmentation run on these separate kernels while NetTrain \
runs concurrently\non its own kernel, which can substantially speed up \
training when augmentation is the bottleneck. If set to \"Parallel\",\nthe \
older shared-queue Parallel-framework kernel pool is used instead. If set to \
{",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "5e19ab61-e97a-f34d-8f16-b431eac134f9"],
     ", n} or {\"Parallel\", n} at most\nn producer kernels are used, useful \
for debugging on a small scale. If set to False batches are generated \
in-process."
    }], "TableText",ExpressionUUID->"d714ef8f-6898-9e4b-8c62-026ddd77e7ef"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "59e07ced-a762-0746-a0b4-93160c931d18"], 
    ButtonBox["Monitor",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Monitor", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["mon", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
      "d9421924-9cae-a049-b245-1a5683e7909c"],
     " generates a temporary monitor cell in which the continually updated \
current value of ",
     Cell[BoxData[
      StyleBox["mon", "TI"]], "InlineFormula",ExpressionUUID->
      "b33a0385-0c2f-9242-b4a2-ac147acf1f5c"],
     " is displayed during the course of evaluation of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "1a4cab9e-056d-b347-b211-bdcb378a8c48"],
     ". "
    }], "TableText",ExpressionUUID->"79f3a789-a1af-3d49-8e4e-053e08f56717"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "edec4d58-951e-6441-bedb-ec0b19a83620"], 
    ButtonBox["MonitorInterval",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MonitorInterval"], 
    "2", Cell[TextData[{
     "MonitorInterval is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "aa0008ab-c34b-7e47-aa0c-070c59e7b8f8"],
     ". It defines how often the training is monitored."
    }], "TableText",ExpressionUUID->"b009cc28-9f46-6843-ab1d-78b390d3b7f6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "447cdf23-ea12-8346-98e1-bf5993cced1a"], 
    ButtonBox["PatchSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PatchSize"], 
    RowBox[{"{", 
     RowBox[{"32", ",", " ", "96", ",", " ", "96"}], "}"}], Cell[TextData[{
     "PatchSize is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "66d81f2c-84fd-bf4e-8d5b-7d6f1ac2a89a"],
     ". Defines the patch size used in the network training."
    }], "TableText",ExpressionUUID->"de21c391-9244-3446-b3b4-2e0f0b47623f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "980fbb71-67f7-e74c-bffa-3f32975dcf24"], 
    ButtonBox["BatchSize",
     BaseStyle->"Link"], "2", Cell["\<\
BatchSize is an option for NetTrain and related functions that specifies the \
size of a batch of examples to process together.\
\>", "TableText",ExpressionUUID->"3f5e9fda-21db-9242-98ee-d455aa920375"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "da94aaff-91a9-b044-9c94-35603d851556"], 
    ButtonBox["PatchesPerSet",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PatchesPerSet"], "1", 
    Cell[TextData[{
     "PatchesPerSet is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"006cb817-7fbc-3844-b578-426894b672d9"],
     ". Defines how many random patches per dataset are created within the \
batch."
    }], "TableText",ExpressionUUID->"91f12ac3-bb1c-e040-8620-88322f0eff6f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d428aee2-c81e-0144-9816-b884139e486f"], 
    ButtonBox["MultiChannel",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MultiChannel"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "MultiChannel is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "fb9179f8-a8a7-7844-90e9-a90cc35261e0"],
     ", If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "00109ecf-7f52-9244-a84b-5ff813ad989b"],
     " it will train on multi channel input data. \nIf set to False it will \
select a random channel."
    }], "TableText",ExpressionUUID->"1edde7da-6902-094c-a0d3-61d01643c5a6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b1f65b1b-0e65-c545-ad5f-9bdf8e23946d"], 
    ButtonBox["AugmentData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentData"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "AugmentData is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"26e90893-14c2-f549-a26c-1997819f46a0"],
     " and ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "facc8eae-b824-ef4c-b044-5bdc79cca66c"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "347ae39b-f68e-a545-b7fa-b931c60f87d7"],
     " the training data is augmented.\nIt can also be set to \"2D\" or \
\"3D\" to control if augmentation is done through plane or only in-plane."
    }], "TableText",ExpressionUUID->"f4d909b5-a16a-4949-8e87-06bea031b903"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c23f33d5-76dd-824a-8987-06395869b581"], 
    ButtonBox["PadData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PadData"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "PadData is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"3b8cdd9e-2ce7-3a45-be11-bf13f82edfbd"],
     " and ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "870cfb66-20ec-c34c-866f-1614d2d35955"],
     ".. If set to an integers the that number of slices on the top and \
bottom of the\ndata can be made 0. This is done to learn cut of datasets."
    }], "TableText",ExpressionUUID->"ec047b84-1214-3046-93e3-f47dc88f4f0b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b7ae74e4-d95f-7243-bcd7-fc2fd644a700"], 
    ButtonBox["MaskedPretraining",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MaskedPretraining"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["Mask",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Mask"]], "InlineFormula",
      ExpressionUUID->"323eaeb6-eaef-964b-b200-39eca2ba4326"],
     "edPretraining is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"e044de00-7c16-4e41-810b-f578cf392008"],
     " and ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "64964965-91f9-3549-8f1e-c12471be997c"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "3656d4e4-1d34-4e43-8320-0e699a0d50e9"],
     " self supervised masked-pretraining data/mode is used instead\nof \
segmentation data: the target becomes the clean data itself and the input is \
masked with noise filled blocks."
    }], "TableText",ExpressionUUID->"0dcafcf9-d3a2-0946-befe-2fc213bf0c70"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f1abfe62-912e-cf41-9177-f328b3b5e623"], 
    ButtonBox["RoundLength",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/RoundLength"], "256", 
    Cell[TextData[{
     "RoundLength is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "165ee89e-1efb-6b4c-9524-822f83c5ce69"],
     ". Defines how many batches will be seen during each training round."
    }], "TableText",ExpressionUUID->"d120130b-d6ca-2847-922e-97a5fa4a0b29"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "8b901c7c-2ac8-d848-87f5-443ee6c5668f"], 
    ButtonBox["MaxTrainingRounds",
     BaseStyle->"Link"], "350", Cell["\<\
MaxTrainingRounds is an option for NetTrain and related functions that \
specifies the maximum number of rounds of training to do.\
\>", "TableText",ExpressionUUID->"cb20fb56-9348-c549-9382-775aaac47b39"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5e867d06-d22f-cd4e-994a-704758c29266"], 
    ButtonBox["RestartLearningCycle",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsSegmentationTools/ref/RestartLearningCycle"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "RestartLearningCycle is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "cd50c104-adc3-6b4e-8075-acde69ce9bee"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "b9b9e3f7-8e09-0945-93e5-4cf02d6e07aa"],
     " and continuing training from a previous run, the one-cycle\nlearning \
rate schedule (including its warmup) is restarted from 0 and fit to the \
remaining rounds, instead of resuming mid-cycle where the\nprevious run left \
off."
    }], "TableText",ExpressionUUID->"d37ea72c-e211-3e45-a05b-0133d7e02c3b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "07657857-2ef4-9c4d-b9b3-127d13febe7c"], 
    ButtonBox["BlockType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/BlockType"], "\"\<ResNet\>\"", 
    Cell[TextData[{
     "BlockType is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"fc86d886-9259-4949-98ee-4f53e4094cd7"],
     ". It specifies the type of block used in the network. It can be \
\"Conv\", \"UNet\", \"ResNet\", \"DenseNet\", \"Inception\", or \"U2Net\"."
    }], "TableText",ExpressionUUID->"70c741c1-445b-7445-9d0e-a9e301707a89"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3e050e42-3aea-3c41-b29f-a63ea57071a1"], 
    ButtonBox["NetworkArchitecture",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/NetworkArchitecture"], \
"\"\<UNet\>\"", Cell[TextData[{
     "NetworkArchitecture is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"b2f129f1-40bf-9043-82be-52656c982274"],
     ". It defines the architecture of the network. It can be \"UNet\", \
\"UNet+\", or \"UNet++\".\nFor \"UNet+\" or \"UNet++\" it can also be {arch, \
i} where i specifies how many of the top layers are connected to the mapping \
layer."
    }], "TableText",ExpressionUUID->"1c6175e2-c6d6-464d-99f2-1049dc93dadb"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5cd4bea9-35b6-954e-b1cf-c639f8f3a0d7"], 
    ButtonBox["ActivationType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/ActivationType"], "\"\<GELU\>\"",
     Cell[TextData[{
     "ActivationType is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"df0640c6-cebe-f941-82a3-ee6d6ebd8a61"],
     ". It specifies which activation layer is used in the network. It can be \
\"LeakyRELU\" or any type allowed \nby a \"name\" definition in \
ElementwiseLayer."
    }], "TableText",ExpressionUUID->"5d683f00-c297-8147-ac28-90815079b0bd"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c7fb9d7f-684e-6744-ad93-1eeec1d626d7"], 
    ButtonBox["NormalizationType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/NormalizationType"], \
"\"\<Instance\>\"", Cell[TextData[{
     "NormalizationType is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"f29c2929-7b53-774f-9fb3-4d140d5bc591"],
     ". It specifies which normalization layer is used in the network. It can \
be \"Batch\" or \"Instance\" for \neither BatchNormalization or \
NormalizationLayer which is instance normalization."
    }], "TableText",ExpressionUUID->"cc6685d8-dd8f-e849-8566-7af473ae9240"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d776e7cd-5b7f-9c47-a56f-a687f1c3e5fc"], 
    ButtonBox["RescaleMethod",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/RescaleMethod"], "\"\<ConvS\>\"",
     Cell[TextData[{
     "RescaleMethod is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"e62d3aee-5bc2-0d4a-81ff-8bdd683a25f9"],
     ". It specifies how the network rescales. It can be \"Conv\" or \"Pool\"."
    }], "TableText",ExpressionUUID->"f8b218c1-40b8-d248-b509-5b7f3b9eedfd"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a8517466-b794-bb46-8fa1-cd159e62748f"], 
    ButtonBox["CatenateMethod",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/CatenateMethod"], "\"\<Tot\>\"",
     Cell[TextData[{
     "CatenateMethod is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"246616df-0310-ec41-9204-21e90cac1ad4"],
     ". It specifies how the network catenates the skip and upscale channel. \
It can be \"Tot\", or \"Cat\"."
    }], "TableText",ExpressionUUID->"11024ce1-38c4-c340-a2a6-dfccb8c3baf0"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b045e06a-b87a-fb4d-bb2e-af5dabbca8fd"], 
    ButtonBox["NetworkDepth",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/NetworkDepth"], "5", 
    Cell[TextData[{
     "NetworkDepth is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"b970e42b-7b61-da40-8912-35967872c78e"],
     ". It specifies how deep the UNET will be."
    }], "TableText",ExpressionUUID->"0dd15f63-ace9-484a-b0dc-7990b499d07d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b9ee6d09-424f-274a-b641-e3bf91cfefdb"], 
    ButtonBox["DownsampleSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/DownsampleSchedule"],
     "2", Cell[TextData[{
     "DownsampleSchedule is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"316b29fa-c28f-a141-93be-81e0cebd65c2"],
     ". It defines how the data is downsampled for each of the deeper layers \
of the Unet. \nBy default is is a factor two for each layer. A custom \
schedule for a 5 layer 3D Unet could be {{2,2,2},{1,2,2},{2,2,2},{1,2,2}, 1}.\
\nThe deepest layer is always downsampled by 1 and therefore not needed to be \
specified."
    }], "TableText",ExpressionUUID->"3fbf1da3-2bab-5f4d-b551-6c108df298ee"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "8ab2bc19-15f1-d043-954e-7efb708c36ac"], 
    ButtonBox["SettingSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SettingSchedule"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SettingSchedule",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SettingSchedule"]], "InlineFormula",
      ExpressionUUID->"ddd5d80c-e541-0542-add6-ce7421e2d510"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"5b79e4f0-f2f1-2443-a453-1d4bf16ec127"],
     ". It defines the settings for the Unet blocks. If one setting is given \
it applied to all layers.\nIf a list of settings is given the settings can be \
different per layer. The following settings are the default settings. \n\
\"Unet\": convolution block repetitions, 2, \"ResNet\" -> convolution block \
repetitions, 2, \"DenseNet\" -> {dense depth, block repetitions}, {4,2},\n\
\"Inception\" -> {inception width, block repetitions}, {4,2}, \"U2Net\"-> \
{Unet depth, downscale}, {5, True}."
    }], "TableText",ExpressionUUID->"0024fd3a-1afa-c34c-855b-223dd89964e2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "065e980b-89bc-4443-9b55-1b4220c800e3"], 
    ButtonBox["FeatureSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/FeatureSchedule"], 
    "32", Cell[TextData[{
     "FeatureSchedule is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"52251854-56b5-6c4f-a9ba-4c610e228f8f"],
     ". It defines how the number of features is up-sampled for each of the \
deeper layers of the Unet.\nBy default it increases the number of features by \
a factor 2 each layer, i.e. {1, 2, 4, 8, 16}."
    }], "TableText",ExpressionUUID->"f45a6525-baab-5945-8fd1-8a95ba2798d6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ab9a25af-1c72-5143-a1e8-5a99a14153f8"], 
    ButtonBox["LossFunction",
     BaseStyle->"Link"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell["\<\
LossFunction is an option for NetTrain that specifies how to compare actual \
and requested outputs from a neural net.\
\>", "TableText",ExpressionUUID->"0160058d-d6c7-0544-826c-0a5d27749cfc"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f9eab3ca-ee94-3747-ad77-eddc420b8fc0"], 
    ButtonBox["DropoutRate",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/DropoutRate"], "0.2",
     Cell[TextData[{
     "DropoutRate is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"fa0b1f92-54d7-7a4d-8229-12752081e865"],
     ". It specifies how much dropout is used after each block. It is a value \
between 0 and 1, default is .2."
    }], "TableText",ExpressionUUID->"ed4b14ec-1b1a-3642-8163-5b8f78ef909c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "15185944-6e6b-204e-b304-38b8c170cd86"], 
    ButtonBox["LearningRate",
     BaseStyle->"Link"], "0.001", Cell["\<\
LearningRate is an option for NetTrain that specifies the rate at which to \
adjust neural net weights in order to minimize the training loss.\
\>", "TableText",ExpressionUUID->"317f2209-15bd-e345-b23c-1d723d9a1bff"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c1501fb3-bbd4-d14d-975c-aa171370e619"], 
    ButtonBox["L2Regularization",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/L2Regularization"], 
    "0.0001", Cell[TextData[{
     "L2Regularization is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "eab120c8-6925-bc4b-94b5-0241ea8e33de"],
     ". It defines the L2 regularization factor."
    }], "TableText",ExpressionUUID->"4e98e483-e38b-7c4d-bf0e-114e360de642"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "29db72b6-8a69-224f-9de5-02c4f7b739c6"], 
    ButtonBox["FreezeEncoderDepth",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/FreezeEncoderDepth"], 
    ButtonBox["None",
     BaseStyle->"Link"], Cell[TextData[{
     "FreezeEncoderDepth is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "c5ce1515-afa8-6543-a961-cfd0e670d1c9"],
     ". If set to an integer n, freezes the first n \nencoder blocks of a \
pretrained input network so their weights are not updated during training, \
useful for transfer learning \nfrom a pretrained encoder. Only applies when \
netCont is not \"Start\".\nDefault is None, which trains all layers."
    }], "TableText",ExpressionUUID->"13575abb-590c-bd44-aa03-0764dcb358f6"]}
  }]], "3ColumnTableMod",
 CellID->129447959,ExpressionUUID->"6e253b87-897e-f847-801f-5579ca0ff49d"]
}, Open  ]],

