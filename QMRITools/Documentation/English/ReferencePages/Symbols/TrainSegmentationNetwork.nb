       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PatchesPerSet"]], "InlineFormula",
      ExpressionUUID->"ab6302db-62eb-6942-bfa9-d2d80b320e7c"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["GetTrainData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
      ExpressionUUID->"6256da20-8c35-f344-a31a-77c04fce548c"],
     ". Defines how many random patches per dataset are created within the \
