   {Cell["   ", "ModInfo",ExpressionUUID->
     "c52fde56-caf1-db4f-b4d8-ac7f3b66cff8"], 
    ButtonBox["BatchSize",
     BaseStyle->"Link"], "4", Cell["\<\
BatchSize is an option for NetTrain and related functions that specifies the \
size of a batch of examples to process together.\
\>", "TableText",ExpressionUUID->"764037ba-9196-e549-a29c-f98c0ba323f3"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "02188987-4728-7247-aa7f-3f0f73f02d7b"], 
    ButtonBox["RoundLength",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/RoundLength"], "512", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["RoundLength",
