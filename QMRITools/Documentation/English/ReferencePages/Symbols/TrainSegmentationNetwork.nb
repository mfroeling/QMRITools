    ButtonBox["PatchSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PatchSize"], 
    RowBox[{"{", 
     RowBox[{"32", ",", " ", "112", ",", " ", "112"}], "}"}], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PatchSize",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PatchSize"]], "InlineFormula",
      ExpressionUUID->"9d1d96bd-efdc-3847-aa35-48d565a402b3"],
     " is an option for ",
     Cell[BoxData[
     "TrainSegmentationNetwork"], "InlineFormula",ExpressionUUID->
      "09f28f04-f71a-e846-9925-cf30a1fb7f36"],
     ". Defines the patch size used in the network training."
    }], "TableText",ExpressionUUID->"67d7a8f6-8c68-5e4c-afb7-9008b78d46eb"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b1d619df-9e64-eb46-957f-b7c7a64b0888"], 
    ButtonBox["PatchesPerSet",
     BaseStyle->"Link",
