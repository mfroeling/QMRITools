Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a9adea4c-763e-2a4a-8d33-81b52ea2ca93"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MaskToDistanceMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MaskToDistanceMap"], "[", 
   StyleBox["mask", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "081d87eb-878b-a549-bb0d-4dd9515fc9ef"],
 "\[LineSeparator]converts a binary ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "d3fb1eac-ecd7-154e-9d80-6ce769b66829"],
 " into a ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "09b5515e-a001-ef44-9458-70e0c89ce2a7"],
 " distance map. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4e9f7bca-9f4a-934e-bff4-7e4f21adfcc7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MaskToDistanceMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MaskToDistanceMap"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["method", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6ac1420a-6fba-4246-9f5a-3ee646ee203e"],
 "\[LineSeparator]converts a binary ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "30ac514c-15cb-a746-bcda-8beaea508947"],
 " into a distance ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "e6439425-339c-2c45-95ec-f21eb5bc7b15"],
 ". The ",
 Cell[BoxData[
  StyleBox["method", "TI"]], "InlineFormula",ExpressionUUID->
  "fbf715c8-ff95-634f-b67e-3eecf9983fcd"],
 " can be \"both\", \"out\" or \"in\" which calculates the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "9d42e2cf-eecf-4741-b708-9da632ab0dbd"],
 " distance inside and outside, outside, or inside the ",
