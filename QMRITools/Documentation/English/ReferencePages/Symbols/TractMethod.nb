Notebook[{

Cell[CellGroupData[{
Cell["TractMethod", "ObjectName",
 CellID->41014652,ExpressionUUID->"1328d7e3-33b3-f04d-92b5-99b2aebb8b3c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b881e22f-8937-1147-9206-fc2847ec4266"],
 Cell[BoxData[
 "TractMethod"], "InlineFormula",ExpressionUUID->
  "8c125674-ccd5-6849-827e-6af40ddff1b8"],
 "\[LineSeparator]is an option for FiberTractography and \
FindTensorPermutation and defines the integration method of each tract step. \
Values can be \"Euler\", \"RK2\" (midpoint, also \"RK\" or \"RungeKutta\"), \
\"Heun\" (also \"RK2T\"), \"RK3\" (strong stability preserving, also \"SSPRK3\
\" or \"RungeKutta3\"), \"Heun3\" (also \"RK3Heun\") and \"RK4\" (also \
\"RungeKutta4\")."
}], "Usage",
 CellID->201733702,ExpressionUUID->"e2673009-4748-a04b-b7e9-c1f9d8e4fb98"],

Cell["XXXX", "Notes",
 CellID->34353387,ExpressionUUID->"8c7e7a17-b4e6-a24a-be29-49ebeddc5813"]
