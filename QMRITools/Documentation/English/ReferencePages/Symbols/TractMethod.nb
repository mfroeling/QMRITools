Notebook[{

Cell[CellGroupData[{
Cell["TractMethod", "ObjectName",
 CellID->50064683,ExpressionUUID->"427dd657-e34a-4c48-b6bb-b53f20c55dd1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b5a9b2b3-98ed-ad40-a2a6-021862d1194d"],
 Cell[BoxData[
 "TractMethod"], "InlineFormula",ExpressionUUID->
  "957cd020-2e5e-3940-9ab4-2f079c68ffd4"],
 "\[LineSeparator]is an option for FiberTractography and \
FindTensorPermutation and defines the integration method of each tract step. \
Values can be \"Euler\", \"RK2\" (midpoint, also \"RK\" or \"RungeKutta\"), \
\"Heun\" (also \"RK2T\"), \"RK3\" (strong stability preserving, also \"SSPRK3\
\" or \"RungeKutta3\"), \"Heun3\" (also \"RK3Heun\") and \"RK4\" (also \
\"RungeKutta4\")."
}], "Usage",
 CellID->641434665,ExpressionUUID->"93bedbcf-f338-3940-9e5b-baaa9c058599"],

Cell["XXXX", "Notes",
 CellID->78116773,ExpressionUUID->"600d0d1a-5d89-0e4e-b128-7a9df2cdfefa"]
