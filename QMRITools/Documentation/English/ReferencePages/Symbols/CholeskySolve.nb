Notebook[{

Cell[CellGroupData[{
Cell["CholeskySolve", "ObjectName",
 CellID->149988182,ExpressionUUID->"d197e4a0-306b-094c-8d86-1329aa480e3b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6691385a-7ce6-c449-8cb3-a9333eed63a2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CholeskySolve",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/CholeskySolve"], "[", 
   RowBox[{
    StyleBox["y", "TI"], ",", 
    StyleBox["mat", "TI"], ",", 
    StyleBox["w", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d2633c23-90ac-1d4d-98c6-1ef6824ea500"],
 "\[LineSeparator]solves the weighted linear least squares problem ",
 Cell[BoxData[
  StyleBox["mat", "TI"]], "InlineFormula",ExpressionUUID->
  "eee31f0c-41f5-6e4a-b103-03b50c2686b8"],
 ".x = ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",ExpressionUUID->
  "051aa913-e834-374a-8680-a8c198c40055"],
 " with weights ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "06d347ec-a8f9-0347-a593-558f3058ccaa"],
 " via the normal equations and a Cholesky decomposition. It is meant to be \
used inside Compile with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{Cell[BoxData[
     RowBox[{"CompilationOptions", "->", 
      RowBox[{"{", "\"\<InlineExternalDefinitions\>\""}]}]], "InlineFormula",
     ExpressionUUID->"47a8bf87-dcd9-514a-b9d0-2f3afadba60d"], "->", 
    ButtonBox["True",
     BaseStyle->"Link"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "78831aec-a4fe-434b-b9b9-c8116e2730dc"],
 ", where it is inlined in the compiled code."
}], "Usage",
 CellChangeTimes->{{4.003433397475069*^9, 4.0034333975684547`*^9}},
 CellID->393200691,ExpressionUUID->"73991bd2-8b73-ab46-a565-b4acf2d20228"],

