Notebook[{

Cell[CellGroupData[{
Cell["CholeskySolve", "ObjectName",
 CellID->455803298,ExpressionUUID->"947d25c8-0edd-9442-a643-36c99f17ce96"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c8b1843a-3dbd-1546-b1cf-3e55ec33b494"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CholeskySolve",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/CholeskySolve"], "[", 
   RowBox[{
    StyleBox["y", "TI"], ",", 
    StyleBox["mat", "TI"], ",", 
    StyleBox["w", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8e24f904-572f-4f4a-b9f4-9e5c87b7f740"],
 "\[LineSeparator]solves the weighted linear least squares problem ",
 Cell[BoxData[
  StyleBox["mat", "TI"]], "InlineFormula",ExpressionUUID->
  "d028931b-cf70-ed43-b35f-6bd792c4ef46"],
 ".x = ",
 Cell[BoxData[
  StyleBox["y", "TI"]], "InlineFormula",ExpressionUUID->
  "b8933bdd-ea9d-874a-b6a7-35701c2d9293"],
 " with weights ",
 Cell[BoxData[
  StyleBox["w", "TI"]], "InlineFormula",ExpressionUUID->
  "e5368823-42e8-dc46-82b3-d051762e1e3c"],
 " via the normal equations and a Cholesky decomposition. It is meant to be \
used inside Compile with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{Cell[BoxData[
     RowBox[{"CompilationOptions", "->", 
      RowBox[{"{", "\"\<InlineExternalDefinitions\>\""}]}]], "InlineFormula",
     ExpressionUUID->"4e1f2c9f-4e60-a344-b64b-e9d9c9c80aee"], "->", 
    ButtonBox["True",
     BaseStyle->"Link"]}], "}"}]], "InlineFormula",ExpressionUUID->
  "cacf1bc7-b9a9-7745-83de-fe1b8a8bb786"],
 ", where it is inlined in the compiled code."
}], "Usage",
 CellChangeTimes->{{4.0038044999440327`*^9, 4.003804500063486*^9}},
 CellID->158117515,ExpressionUUID->"45ed6877-b20b-e544-9f5f-4c964fcd14e0"],

