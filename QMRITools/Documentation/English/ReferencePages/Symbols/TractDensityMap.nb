     Cell[BoxData[
     "TractDensityMap"], "InlineFormula",ExpressionUUID->
      "4a41c416-0ae2-6646-86b6-7346b952d0e5"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "97b95237-2c4b-ae41-a7f0-516d36e652bc"],
     " the tract density is normalized, if False then it is the true tract \
count."
    }], "TableText",ExpressionUUID->"1467974c-0029-ad4e-b57a-3a3fed19a240"]}
  }]], "3ColumnTableMod",
