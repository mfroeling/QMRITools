     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["NormalizeDensity",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NormalizeDensity"]], "InlineFormula",
