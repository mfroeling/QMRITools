Cell[CellGroupData[{
Cell["TractDensityMap", "ObjectName",
 CellID->313288410,ExpressionUUID->"6028b374-7196-a941-a12e-7bccb3b2e3f9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"263e9bfa-df3f-804d-a1e1-c3f627bc07c1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TractDensityMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/TractDensityMap"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1272328b-3f65-9e43-9f2a-722af39dc51e"],
 "\[LineSeparator]makes a tract density map based on the ",
 Cell[BoxData[
  StyleBox["tracts", "TI"]], "InlineFormula",ExpressionUUID->
  "58461164-1f0c-2d4a-afcf-b1515d61bde6"],
 " vertices."
}], "Usage",
 CellChangeTimes->{{3.9966562751492844`*^9, 3.996656275213253*^9}},
 CellID->192061590,ExpressionUUID->"155363ce-a118-934c-bcea-41057fb9efaf"],

