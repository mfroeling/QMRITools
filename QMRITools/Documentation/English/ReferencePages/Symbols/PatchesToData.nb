Cell["PatchesToData", "ObjectName",
 CellID->515955227,ExpressionUUID->"e658f76c-cb68-d343-8618-5d0b060e4442"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"30180797-0dd6-224b-9c4f-7da750935486"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PatchesToData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PatchesToData"], "[", 
   RowBox[{
    StyleBox["patches", "TI"], ",", 
    StyleBox["ranges", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "39738c21-f6a8-c54d-9a88-1b584b3d6a83"],
 "\[LineSeparator]reconstructs data from ",
 Cell[BoxData[
  StyleBox["patches", "TI"]], "InlineFormula",ExpressionUUID->
  "c5739035-d869-ee47-b1ca-076cff2b93a4"],
 " at the given ",
 Cell[BoxData[
  StyleBox["ranges", "TI"]], "InlineFormula",ExpressionUUID->
  "cd4f8e6c-04f5-4a4d-bb6d-d0667936da87"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f1039711-5a15-7f4e-beac-65d636c6a9f2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PatchesToData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PatchesToData"], "[", 
   RowBox[{
    StyleBox["patches", "TI"], ",", 
    StyleBox["ranges", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "de91cc9d-e7ec-4c48-bda3-3c88916adde0"],
 "\[LineSeparator]reconstructs into an array of dimensions ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",ExpressionUUID->
  "2a439b05-4feb-2641-ad2c-89b28cad453f"],
 ". Overlapping ",
 Cell[BoxData[
  StyleBox["patches", "TI"]], "InlineFormula",ExpressionUUID->
  "a9594a03-a353-314f-a798-fba0a3e74088"],
 " are averaged. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"273166a0-81e7-fd41-a7b7-2b6e4c44cc91"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PatchesToData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PatchesToData"], "[", 
   RowBox[{
    StyleBox["patches", "TI"], ",", 
    StyleBox["ranges", "TI"], ",", 
    StyleBox["dim", "TI"], ",", 
    StyleBox["labels", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b8124563-2de5-5a43-87aa-a04b1e0612cd"],
 "\[LineSeparator]reconstructs segmentation ",
 Cell[BoxData[
  StyleBox["patches", "TI"]], "InlineFormula",ExpressionUUID->
  "5df39c07-2918-964d-95c7-7700d133c246"],
 ". For each label only the largest connected component is kept and \
overlapping ",
 Cell[BoxData[
  StyleBox["labels", "TI"]], "InlineFormula",ExpressionUUID->
  "93576743-b429-f64c-8544-6a9e4b3fe5c4"],
 " are resolved. Returns a merged integer segmentation."
}], "Usage",
