    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "ff5cdbab-c9a2-5f4e-b7dd-27176d98231b"],
 "]\[LineSeparator]add the ",
 Cell[BoxData[
  StyleBox["list", "TI"]], "InlineFormula",ExpressionUUID->
  "d22d081c-3289-754c-8abe-6ff6134339fa"],
 " to the log at ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "115d72b9-7193-7447-b076-2dcffd425e63"],
 " 1 with a timestamp. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e803158e-3c34-7345-9aef-e73df091f77b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AddToLog",
