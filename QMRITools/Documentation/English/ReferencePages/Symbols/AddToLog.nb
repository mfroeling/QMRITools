   RowBox[{
    StyleBox["list", "TI"], ",", 
    StyleBox["level", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "897aa3a3-b43f-de43-a499-20db4339694a"],
 "\[LineSeparator]add the ",
 Cell[BoxData[
  StyleBox["list", "TI"]], "InlineFormula",ExpressionUUID->
  "dbc0b7e8-e453-9947-80a2-98be0c049667"],
 " to the log at ",
 Cell[BoxData[
  StyleBox["level", "TI"]], "InlineFormula",ExpressionUUID->
  "90ba12be-c061-ae41-8c42-34628c5eb9a1"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"cbe1077d-aaca-3c44-840a-5a83793dda66"],
 "AddToLog[list,",
 Cell[BoxData[
  ButtonBox[
   ButtonBox[
