Cell["FindTensorPermutation", "ObjectName",
 CellID->171822144,ExpressionUUID->"ad858741-b853-6642-afa2-d9f85a7ed616"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d7b9a84b-dd52-5a45-808a-7519355c37ea"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindTensorPermutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsTractographyTools/ref/FindTensorPermutation"], "[", 
   RowBox[{
    StyleBox["tensor", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7c301f57-d214-b249-8342-750b5e766a0c"],
 "\[LineSeparator]performs tractography for all ",
 Cell[BoxData[
  StyleBox["tensor", "TI"]], "InlineFormula",ExpressionUUID->
  "6da10671-f97d-cf42-9e2d-ab3a9675ebb9"],
 " permutations and gives back the one that has the longest tracts. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ea408ea8-7675-fe4d-bd63-a49c48591d79"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindTensorPermutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsTractographyTools/ref/FindTensorPermutation"], "[", 
   RowBox[{
    StyleBox["tensor", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["par", "TI"], ",", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["min", "TI"], ",", 
        StyleBox["max", "TI"]}], "}"}]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"b9a2287f-9dbf-fb42-9b4c-f4ce4f65b541"],
 "\[LineSeparator]same but with additional stopping criteria par, where \
tracts are only generated between values of par min and max. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"91589bba-39fa-6e44-a049-ea232b849367"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindTensorPermutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsTractographyTools/ref/FindTensorPermutation"], "[", 
   RowBox[{
    StyleBox["tensor", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["par", "TI"], ",", 
        RowBox[{"{", 
         RowBox[{
          StyleBox["min", "TI"], ",", 
          StyleBox["max", "TI"]}], "}"}]}], "}"}], ",", ".."}], "}"}]}], 
   "]"}]], "InlineFormula",ExpressionUUID->
  "0a021b71-c4e0-4d4e-8939-eda164067e45"],
 "\[LineSeparator]same but with multiple additional stopping criteria. Output \
= {permutations, flips, plot} \n",
 Cell["   ", "ModInfo",ExpressionUUID->"bbd85b37-ca14-0d4b-b7c5-722d8615b6c9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindTensorPermutation",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsTractographyTools/ref/FindTensorPermutation"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "b19a8470-94f3-1646-bc6e-a3c16d2ff5c5"],
 "\[LineSeparator]is based on DOI: 10.1016/j.media.2014.05.012."
}], "Usage",
 CellChangeTimes->{{3.9966556030214615`*^9, 3.9966556033852367`*^9}},
 CellID->306245335,ExpressionUUID->"7d47a91f-2f08-e44b-ae72-283baae4ead4"],

