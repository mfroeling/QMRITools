Notebook[{

Cell[CellGroupData[{
Cell["DixonReconstruct", "ObjectName",
 CellID->216794142,ExpressionUUID->"f82cb1e1-2807-894b-948a-247928d83034"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f46fd10a-9450-4a4d-ada7-6ea9d72d6603"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b22f667e-2707-2947-836d-3b81c6320134"],
 "\[LineSeparator]reconstruxt Dixon data with initial guess b0 = 0 and T2star \
= 0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e6569b9d-4bcd-d247-80d9-78f901951101"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["0", "TR"]], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a138163c-e285-f244-9b43-dfe04a51b0a0"],
 "\[LineSeparator]reconstructs Dixon data with initial guess T2star = 0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4ff2e842-19bf-8f4c-90c3-4697c43a5f98"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"aac17fc0-e41b-5445-8139-127b1c7600e7"],
 "\[LineSeparator]reconstructs Dixon data with t2star and B0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a9b9abd5-be1b-e14d-82fe-fd7bdc78c966"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["ph", "TI"], 
       StyleBox["0", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"b21468bb-e438-1b41-a8b5-c7322c6f8797"],
 "\[LineSeparator]reconstructs Dixon data with initial phase. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6f9b17c3-d398-9c4b-b97d-08633c3dc4cd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["ph", "TI"], 
       StyleBox["0", "TR"]], ",", 
      StyleBox["phb", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"451c951f-fe22-004e-8587-ed79c3c6fa06"],
 "\[LineSeparator]reconstructs Dixon data with bipolar phase . Output is \
{{watF,fatF},{watSig,fatSig},{inphase,outphase},{{b0, ",
 Cell[BoxData[
  StyleBox["ph0", "TI"]], "InlineFormula",ExpressionUUID->
  "f398cbd9-495f-5d41-bf15-d935d5c37dc7"],
 ", phb",
 Cell[BoxData[
  StyleBox[
   RowBox[{"phb", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "f0957e4a-d7e3-9741-9b9b-c4f4f535793c"],
 "},{r2, t2}},iterations}. The fractions are between 0 and 1, the B0 field \
map is in Hz and the T2start map is in ms. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"feb39d36-78c8-c442-801c-a140859c8c20"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "d2466812-2c6c-e042-94aa-782dd47e4298"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.20624 and 10.1002/mrm.21737 \
(10.1002/nbm.3766)."
}], "Usage",
 CellChangeTimes->{{3.9985332044583073`*^9, 3.998533205390772*^9}},
 CellID->26195565,ExpressionUUID->"0498f7e8-3491-3246-9a08-bd87268ed258"],

