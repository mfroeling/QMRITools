Notebook[{

Cell[CellGroupData[{
Cell["DixonReconstruct", "ObjectName",
 CellID->764233635,ExpressionUUID->"5ae1178c-6629-154c-be09-197e2aff8403"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"437b2c49-7bdb-1b4f-a759-11699096cc17"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1ed34095-5c19-2d4a-a542-da4c4aa46fa2"],
 "\[LineSeparator]reconstruxt Dixon data with initial guess b0 = 0 and T2star \
= 0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9ad4e484-22d4-d54c-b94c-9d32b9d76a41"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["0", "TR"]], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "777204e1-6a22-fb4c-acc9-16a20f315f63"],
 "\[LineSeparator]reconstructs Dixon data with initial guess T2star = 0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"36668aa0-4922-6c4e-807c-0a22a4d38f25"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"9e2f975f-5ebf-f646-a2e2-0b69d21c618e"],
 "\[LineSeparator]reconstructs Dixon data with t2star and B0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"7ab301bb-d585-4b4a-9da6-c7dbfeabcf17"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["ph", "TI"], 
       StyleBox["0", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"4c312efb-7c0b-1c40-84ce-e45ebd6471ae"],
 "\[LineSeparator]reconstructs Dixon data with initial phase. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b168632d-07e6-2645-b391-45c5d39a1a46"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["ph", "TI"], 
       StyleBox["0", "TR"]], ",", 
      StyleBox["phb", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"93656aac-060a-054b-bee1-829dcff9fd4b"],
 "\[LineSeparator]reconstructs Dixon data with bipolar phase . Output is \
{{watF,fatF},{watSig,fatSig},{inphase,outphase},{{b0, ",
 Cell[BoxData[
  StyleBox["ph0", "TI"]], "InlineFormula",ExpressionUUID->
  "87c8e8ed-9b5b-0340-83b2-ece0833358dc"],
 ", phb",
 Cell[BoxData[
  StyleBox[
   RowBox[{"phb", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "793c1124-e481-2c46-924b-eb3148071ec6"],
 "},{r2, t2}},iterations}. The fractions are between 0 and 1, the B0 field \
map is in Hz and the T2start map is in ms. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d9dcf143-1ec7-0b4a-a3ac-5e89fd7f23fe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "292ef17e-fae9-814b-9302-bfa6bd5574a4"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.20624 and 10.1002/mrm.21737 \
(10.1002/nbm.3766)."
}], "Usage",
 CellChangeTimes->{{3.9966562586299515`*^9, 3.9966562591542416`*^9}},
 CellID->93202476,ExpressionUUID->"c315a029-1ce7-9544-9fd7-67ce56da6fd6"],

