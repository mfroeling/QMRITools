   {Cell["   ", "ModInfo",ExpressionUUID->
     "a08603f6-412e-114d-b77c-bddcd3776b8a"], 
    ButtonBox["DixonTolerance",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DixonTolerance"], "1", Cell[TextData[{
