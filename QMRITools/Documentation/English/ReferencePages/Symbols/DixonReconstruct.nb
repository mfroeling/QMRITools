Notebook[{

Cell[CellGroupData[{
Cell["DixonReconstruct", "ObjectName",
 CellID->30092208,ExpressionUUID->"ff3af748-e49c-794b-abf9-c8571c9c3f41"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f7c9c349-fda6-df40-8022-4f2e16da4447"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "52d99a29-fc6d-4e4c-a847-a162b8162728"],
 "\[LineSeparator]reconstructs Dixon data with initial guess b0 = 0 and \
T2star = 0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4983d479-0262-884c-94f2-236e0bd372b3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     SubscriptBox[
      StyleBox["b", "TI"], 
      StyleBox["0", "TR"]], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fdfecbcc-4924-0d46-a960-0fa7bef19d62"],
 "\[LineSeparator]reconstructs Dixon data with initial guess T2star = 0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a8f333c5-bc07-9a42-a18b-5758104e5dfe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"5c8f82cb-320f-2849-9ab2-061d390ea531"],
 "\[LineSeparator]reconstructs Dixon data with t2star and B0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2f534b0e-aa38-c14d-954c-e946464ae5e0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["ph", "TI"], 
       StyleBox["0", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"4acb82bf-67b3-3241-83f4-991fec2ca818"],
 "\[LineSeparator]reconstructs Dixon data with initial phase. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"97fe6f74-786b-9a4e-a2e0-399e459a993a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echo", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["0", "TR"]], ",", 
      SubscriptBox[
       StyleBox["t", "TI"], 
       StyleBox["2", "TR"]], ",", 
      SubscriptBox[
       StyleBox["ph", "TI"], 
       StyleBox["0", "TR"]], ",", 
      StyleBox["phb", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"48b680a7-368a-3b48-9e22-39f5158cf53d"],
 "\[LineSeparator]reconstructs Dixon data with bipolar phase. Echo times ",
 Cell[BoxData[
  StyleBox["echo", "TI"]], "InlineFormula",ExpressionUUID->
  "0cb158f1-0cf2-c54e-b5ac-8a99572e027e"],
 " are in s, the initial b0 in Hz, ",
 Cell[BoxData[
  StyleBox["t2", "TI"]], "InlineFormula",ExpressionUUID->
  "e9991d2e-9abe-a440-86e6-a94c20c2a53f"],
 " in s and the phases ",
 Cell[BoxData[
  StyleBox["ph0", "TI"]], "InlineFormula",ExpressionUUID->
  "4c382adc-79b7-3040-bc9f-4d52289bd93c"],
 " and phb in cycles. Output is {{watFr, fatFr}, {watSig, fatSig, ...}, \
{inphase, outphase}, {{b0, phb, ",
 Cell[BoxData[
  StyleBox["ph0", "TI"]], "InlineFormula",ExpressionUUID->
  "37246f0d-40af-884e-a89d-189baf6573b2"],
 ", phbt}, {t2, r2}}, iterations, residuals}. The phase maps are only those \
selected with ",
 Cell[BoxData[
  ButtonBox["DixonPhases",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/DixonPhases"]], "InlineFormula",
  ExpressionUUID->"f2236ac2-5091-ea43-9b29-645b490807a4"],
 ", if R2 is fitted the T2 and R2 maps are given separately. If a fat model \
is used the signals are followed by the fitted fat model parameters (e.g. \
double bonds). The fractions are between 0 and 1 (see DixonClipFraction), the \
B0 field map is in Hz, the T2star map in s and R2star in 1/s. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d4bcd89e-f16c-8642-852c-aeafff2431b3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonReconstruct",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonReconstruct"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "456133fd-6e80-2b47-9f33-d4fa49189c41"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.20624 and 10.1002/mrm.21737 \
(10.1002/nbm.3766)."
}], "Usage",
 CellChangeTimes->{{4.003804508600361*^9, 4.0038045091604977`*^9}},
 CellID->84325942,ExpressionUUID->"c0aec652-77af-d54e-b840-1c3a474aaf00"],

