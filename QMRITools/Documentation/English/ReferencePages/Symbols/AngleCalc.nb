Notebook[{

Cell[CellGroupData[{
Cell["AngleCalc", "ObjectName",
 CellID->558628356,ExpressionUUID->"3cb89f54-a86c-174c-81e4-fe3f69e644e6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"18628345-a684-9a46-8fdf-022c6977f766"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AngleCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/AngleCalc"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vector", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8070537b-6b7e-eb44-abfd-e81b23aca319"],
 "\[LineSeparator]calculates the angle between the ",
 Cell[BoxData[
  StyleBox["vector", "TI"]], "InlineFormula",ExpressionUUID->
  "18619ed9-f57d-b74d-975e-655596264ae5"],
 " and the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "8a6fedb9-1e38-9e4e-950e-30800d3f4988"],
 ". Data should be an array of dimensions {xxx,3}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2062960b-b8dd-4e4b-b51d-24be1729926d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AngleCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/AngleCalc"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vectors", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e7534e2f-2e4b-da46-b27e-f713f48cd767"],
 "\[LineSeparator]does the same but calculates the angle between each element \
of ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "eb7950ac-9d20-6946-a9ce-270c3e2bdd1f"],
 " and the corresponding element of ",
 Cell[BoxData[
  StyleBox["vectors", "TI"]], "InlineFormula",ExpressionUUID->
  "fcc8095c-91b8-e64e-902f-121f585d093e"],
 ", ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "01da05ea-ad84-4c4e-b9d8-8cc533972bea"],
 " and ",
 Cell[BoxData[
  StyleBox["vectors", "TI"]], "InlineFormula",ExpressionUUID->
  "0b260c2f-90c6-324e-9525-53975cbddcf7"],
 " should have the same dimensions."
}], "Usage",
 CellChangeTimes->{{3.9985331891473103`*^9, 3.9985331896484795`*^9}},
 CellID->646572435,ExpressionUUID->"0e5e9121-47c4-d94c-aacf-fd049909168d"],

Cell["The following options can be given: ", "Notes",
 CellID->266708618,ExpressionUUID->"96870455-0d46-c845-a9fd-905bedd7f965"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7d3a6972-f330-1941-9c37-6b9d70a73cfb"], 
    ButtonBox["Distribution",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsTensorTools/ref/Distribution"], "\"\<0-180\>\"", Cell[
    TextData[{
     "Distribution is an option for ",
     Cell[BoxData[
     "AngleCalc"], "InlineFormula",ExpressionUUID->
      "10761714-dab2-e54c-a58e-0d0e88839c97"],
     ". values can be \"0-180\", \"0-90\" and \"-90-90\"."
    }], "TableText",ExpressionUUID->"83ca19f9-0f25-cc41-a238-1ed6dbff57a6"]}
  }]], "3ColumnTableMod",
