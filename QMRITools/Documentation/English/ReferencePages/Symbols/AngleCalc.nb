  RowBox[{
   ButtonBox["AngleCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/AngleCalc"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
