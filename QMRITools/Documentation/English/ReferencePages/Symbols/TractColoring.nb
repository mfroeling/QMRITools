Notebook[{

Cell[CellGroupData[{
Cell["TractColoring", "ObjectName",
 CellID->34720784,ExpressionUUID->"0f397f80-1354-624b-8dcd-5238ed0e4ffa"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"840b988d-9222-3846-9631-890fd093374a"],
 Cell[BoxData[
 "TractColoring"], "InlineFormula",ExpressionUUID->
  "53d644fd-f433-4b4c-bd2e-fa82aeae1656"],
 "\[LineSeparator]is an option for PlotTracts and sets how the tracts are \
colored. Values can be \"Direction\", \"Length\", \"Angle\", {par}, or \
RGBColor[]. For \"Length\", \"Angle\", {par} it can be defined in the form \
{..., {min, max}} where the {min, max} specifies the range of the color \
function."
}], "Usage",
 CellID->177264882,ExpressionUUID->"2b54b5f9-68a4-3f4b-a04e-bc25c7c675bb"],

