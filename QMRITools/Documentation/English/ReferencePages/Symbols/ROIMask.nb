Cell[CellGroupData[{
Cell["ROIMask", "ObjectName",
 CellID->266319646,ExpressionUUID->"2969d1d0-8fc6-9d4c-be64-8bf2dc631abb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f11b0d9c-3eed-4048-8fc8-b460e0566a8b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ROIMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsLegacy/ref/ROIMask"], "[", 
   RowBox[{
    StyleBox["maskdim", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["name", "TI"], "\[Rule]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"]}], "}"}], ",", 
           StyleBox["slice", "TI"]}], "}"}], ".."}], "}"}], ".."}]}], "}"}]}],
    "]"}]], "InlineFormula",ExpressionUUID->
  "c4885530-aa3e-de41-9bb6-339ebdd9ab75"],
 "\[LineSeparator]crates mask from coordinates x and y at slice. ",
 Cell[BoxData[
  StyleBox["maskdim", "TI"]], "InlineFormula",ExpressionUUID->
  "0c068f17-f6d1-6846-ab11-f65099868965"],
 " is the dimensions of the output {zout,xout,yout}."
}], "Usage",
 CellChangeTimes->{{3.996656856710743*^9, 3.9966568567647877`*^9}},
 CellID->226044319,ExpressionUUID->"c3225f95-f2e9-b849-9697-2930d610366b"],

