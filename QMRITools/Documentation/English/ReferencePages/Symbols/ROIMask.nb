Cell[CellGroupData[{
Cell["ROIMask", "ObjectName",
 CellID->21557996,ExpressionUUID->"7b00f7c6-cc91-f44d-98aa-339d29ca8c46"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9a6481ba-7d41-4e41-9c7b-cdb34ba0d096"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ROIMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsLegacy/ref/ROIMask"], "[", 
   RowBox[{
    StyleBox["maskdim", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["name", "TI"], "\[Rule]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"]}], "}"}], ",", 
           StyleBox["slice", "TI"]}], "}"}], ".."}], "}"}], ".."}]}], "}"}]}],
    "]"}]], "InlineFormula",ExpressionUUID->
  "66341c0d-5287-a740-b685-b975b88a8f22"],
 "\[LineSeparator]crates mask from coordinates x and y at slice. ",
 Cell[BoxData[
  StyleBox["maskdim", "TI"]], "InlineFormula",ExpressionUUID->
  "77f762b8-12d9-1847-a52d-766dd4915812"],
 " is the dimensions of the output {zout,xout,yout}."
}], "Usage",
 CellChangeTimes->{{4.00380456921747*^9, 4.003804569267601*^9}},
 CellID->66392492,ExpressionUUID->"67625c40-c521-204d-bf6c-a0b003766b20"],

