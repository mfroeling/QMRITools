Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"509cec1a-58dd-8447-b79f-b8b4eac1d465"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CardiacSegment",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/CardiacSegment"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["pts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "22c87dd4-859e-f147-8010-33b7d71bd6e0"],
 "\[LineSeparator]segments the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "f2c166cc-e77c-844c-92b1-40f0761fc69a"],
 " in the AHA17 segmentation using ",
 Cell[BoxData[
  StyleBox["pts", "TI"]], "InlineFormula",ExpressionUUID->
  "bf02792f-d628-6d40-bc7c-a75bc685715c"],
 " to indicate the attachments. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"03624298-1fad-494b-a134-9d8e1c5bbfc0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CardiacSegment",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/CardiacSegment"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["back", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["pts", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "60d27e81-44bf-1649-bc97-7dd5d69a0dfe"],
 "\[LineSeparator]the same where ",
 Cell[BoxData[
  StyleBox["back", "TI"]], "InlineFormula",ExpressionUUID->
  "428fc3f0-00be-e443-b610-69da89ba4cce"],
 " is used for image generation. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"90dfc084-d755-0b40-a1b4-b4498c0ebea4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CardiacSegment",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/CardiacSegment"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["pts", "TI"], ",", 
    StyleBox["seg", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "55143c82-5a10-cd4e-9a19-6e79cc63a837"],
 "\[LineSeparator]does the same but ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "882e0205-635c-1346-afd0-a5e156a38437"],
 " can be an alternate segmentation to the AHA17. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"bd199e64-b12b-5547-aa88-61096e425884"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CardiacSegment",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/CardiacSegment"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["back", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["pts", "TI"], ",", 
    StyleBox["seg", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "04de2d46-e93e-2640-8d9d-6ecf37f32f9c"],
 "\[LineSeparator]does the same but ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "013ece89-ba99-e34a-aaef-af7637974917"],
 " can be an alternate segmentation to the AHA17 where ",
 Cell[BoxData[
  StyleBox["back", "TI"]], "InlineFormula",ExpressionUUID->
  "f2c2ecbf-fe8c-994b-9575-4522f9a5ea9e"],
 " is used for image generation."
}], "Usage",
