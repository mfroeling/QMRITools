Cell["HelixAngleCalc", "ObjectName",
 CellID->699190241,ExpressionUUID->"31f93b7b-8c59-8c49-a1ea-7420f3ed32ce"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e2e4e94c-0d08-264f-9b36-7def6500bd8e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HelixAngleCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/HelixAngleCalc"], "[", 
   RowBox[{
    StyleBox["eigenvectors", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1be54bb0-c3ec-2842-8e8d-4206f6de22dc"],
 "\[LineSeparator]calculates the helix angle matrix of cardiac data using \
only a left ventricle ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "eeefd324-b945-6b4b-bdab-9cf61066c4c6"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"62f6b27d-220f-5e49-931d-43bcdd7b3e6a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HelixAngleCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/HelixAngleCalc"], "[", 
   RowBox[{
    StyleBox["eigenvectors", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["maskp", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "73f874aa-4a2d-6d4c-82d8-f2738a3637c1"],
 "\[LineSeparator]calculates the helix angle matrix of cardiac data using \
only a left ventricle ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "8ebb4b99-e170-514b-aacd-f21c84809a68"],
 ", and a ",
 Cell[BoxData[
  StyleBox["maskp", "TI"]], "InlineFormula",ExpressionUUID->
  "87c8ad2f-cf43-7041-b8ce-f2c50d46fdf3"],
 " for visualization. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b5fa333c-6582-3c40-a4fe-f2c2896fa864"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HelixAngleCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/HelixAngleCalc"], "[", 
   RowBox[{
    StyleBox["eigenvectors", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["centerpoint", "TI"], ",", 
    StyleBox["vec", "TI"], ",", 
    StyleBox["inout", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "132041a7-f32e-6743-89f1-51139a8503f8"],
 "\[LineSeparator]calculates the helix angle matrix of cardiac data using \
only a left ventricle ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "b7907afa-8418-234d-8671-cfe8bfd10c91"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2db42b5f-8448-1841-8267-c89dbcf2a7d4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HelixAngleCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/HelixAngleCalc"], "[", 
   RowBox[{
    StyleBox["eigenvectors", "TI"], ",", 
    StyleBox["mask", "TI"], ",", 
    StyleBox["maskp", "TI"], ",", 
    StyleBox["centerpoint", "TI"], ",", 
    StyleBox["vec", "TI"], ",", 
    StyleBox["inout", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "eb09ee59-96ad-3f4d-87dc-312dd66e8d1e"],
 "\[LineSeparator]calculates the helix angle matrix of cardiac data using a \
left ventricle ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "1a3a3989-c382-e446-994c-9c2e8f1682f3"],
 " and a ",
 Cell[BoxData[
  StyleBox["maskp", "TI"]], "InlineFormula",ExpressionUUID->
  "a323e0a2-6ea1-3841-ac2f-6dbb51680686"],
 " for visualization. ",
 Cell[BoxData[
  StyleBox["eigenvectors", "TI"]], "InlineFormula",ExpressionUUID->
  "d97c64e0-19f8-fb4c-82f3-6ae1fceabc04"],
 " are the tensor ",
 Cell[BoxData[
  StyleBox["eigenvectors", "TI"]], "InlineFormula",ExpressionUUID->
  "dc20fb6a-c9e5-2441-b18b-f8937b82c300"],
 " calculated with ",
 Cell[BoxData[
  ButtonBox["EigenvecCalc",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/EigenvecCalc"]], "InlineFormula",
  ExpressionUUID->"c3dacc4e-60cc-3845-b72a-e4f30957f2fd"],
 ". mask is a mask of the left ventricle. maskp is a mask used for \
visualization. vox is the voxels size, {slice, x, y}. The following values \
are calculated automatically Using ",
 Cell[BoxData[
  ButtonBox["CentralAxes",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
  ExpressionUUID->"a1db1f32-423f-9747-b199-40360a7b320a"],
 " but can also be provided as an input. centerpoint is the center of each \
slice calculated with ",
 Cell[BoxData[
  ButtonBox["CentralAxes",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
  ExpressionUUID->"d901976f-9b41-824c-aefd-9d2841d504b7"],
 ". inout is the inner and outer radius calculated with ",
 Cell[BoxData[
  ButtonBox["CentralAxes",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
  ExpressionUUID->"493df4bb-3ec4-ec42-881e-c2d78eb973b3"],
 ". vec is the vector describin the central axes of the heart, calculated \
with ",
 Cell[BoxData[
  ButtonBox["CentralAxes",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
  ExpressionUUID->"d5abbcac-9158-164b-848b-ab610c174d21"],
 ". Output is het fiber angle matrix FAM = {9, slice, x, y} or {FAM, plot}. \
The angles are in degrees. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d02fb469-269c-d44b-8ad3-9dcb1c0f4ff0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["HelixAngleCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/HelixAngleCalc"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "2aaa7d28-6afb-8949-ae04-903289903d54"],
 "\[LineSeparator]is based on DOI: 10.1186/1532-429X-17-S1-P15."
}], "Usage",
 CellChangeTimes->{{3.996656344779642*^9, 3.9966563455313454`*^9}},
 CellID->162965415,ExpressionUUID->"be8e1142-acb9-a84a-8dd1-3c5efd1bda96"],

