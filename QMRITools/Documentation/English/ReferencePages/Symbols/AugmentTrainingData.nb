Cell["AugmentTrainingData", "ObjectName",
 CellID->7423335,ExpressionUUID->"fe6a0e14-53b5-4341-aac3-4e6a477f3ed4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"33f2c51e-c047-8543-a4c4-edeacb0f1cc6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AugmentTrainingData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentTrainingData"], 
   "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["seg", "TI"]}], "}"}], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "50365ea5-b395-8e44-83f2-c1ff3f11f5df"],
 "\[LineSeparator]augments ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "66ac5ced-9d6e-4948-b3c4-f359abf5cf36"],
 " and segmentation consistently. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"89f3f0d1-dab1-7d42-8885-cdedb65928ca"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AugmentTrainingData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentTrainingData"], 
   "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["seg", "TI"]}], "}"}], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["aug", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "60faf17a-6d2d-aa49-8dee-459cda27617a"],
 "\[LineSeparator]controls augmentation. ",
 Cell[BoxData[
  StyleBox["aug", "TI"]], "InlineFormula",ExpressionUUID->
  "160b177e-1f1b-444f-a0d9-fe0e7a1378c2"],
 " can be ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "4e5090f2-e7b7-f74d-a3fc-400810765f0d"],
 "/False for all, or a list {flip, rotate, scale, noise, blur}. Default is \
all True. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"cb58aecf-c023-a74d-a986-69b03569fd2d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AugmentTrainingData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentTrainingData"], 
   "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e13efea2-2dfe-b141-a0f0-ecf834bfb69c"],
 "\[LineSeparator]augments ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "0d921338-c101-4a4a-a14c-c77e4fdaebf8"],
 " only, returning the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "abddb4eb-7534-364c-ac72-60870fabf138"],
 " without segmentation."
}], "Usage",
