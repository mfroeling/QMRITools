Cell[CellGroupData[{
Cell["AugmentTrainingData", "ObjectName",
 CellID->413298855,ExpressionUUID->"c4409811-d48a-724d-ac3f-b18ce921b4a5"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0dbe774d-bf4f-f546-a28e-291bdc9e41c1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AugmentTrainingData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentTrainingData"], 
   "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["seg", "TI"]}], "}"}], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0694957c-7024-1e4d-a6dc-5c20a52ad74c"],
 "\[LineSeparator]augments ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "ea963d9c-6021-5e4e-a504-0e76744029b4"],
 " and segmentation consistently. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f6a5fe76-7d0d-354a-8d57-38c2361a1321"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AugmentTrainingData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentTrainingData"], 
   "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["seg", "TI"]}], "}"}], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["aug", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3af9e427-7f25-bd44-87a9-739af4c8a029"],
 "\[LineSeparator]controls augmentation. ",
 Cell[BoxData[
  StyleBox["aug", "TI"]], "InlineFormula",ExpressionUUID->
  "45819439-adaf-be4b-8083-d151e8204dfd"],
 " can be True/False for all, or an association with any of the keys \
\"Flip\", \"Rotate\", \"Scale\", \"Noise\", \"Blur\", \"Bias\" (unspecified \
keys default to True). \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f4cb0498-3e3f-ec45-a1d3-0ea77240504a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AugmentTrainingData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentTrainingData"], 
   "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c42cb279-5a3b-e845-9842-db630490539c"],
 "\[LineSeparator]augments ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "d6ed7eeb-c57c-d248-842c-5b01b32eb767"],
 " only, returning the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "27a2c25f-42e8-d646-beb4-da7211836142"],
 " without segmentation."
}], "Usage",
