Cell[CellGroupData[{
Cell["GetSliceData", "ObjectName",
 CellID->707382144,ExpressionUUID->"8e4a5504-0cbe-f74b-bc61-3eb22d084b25"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4000fa27-ff70-284d-91b6-3ede64fdc4e3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetSliceData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsPlottingTools/ref/GetSliceData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["offsets", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d0e6cc2b-6133-c143-8d28-6b42ab4fc6c2"],
 "\[LineSeparator]gets the slices from the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "10cd43f4-b607-1c47-be8d-2abb32ff6c5d"],
 " defined by ",
 Cell[BoxData[
  StyleBox["offsets", "TI"]], "InlineFormula",ExpressionUUID->
  "7a47a910-c42a-f448-80d5-4a49cd72bd49"],
 " which are obtained by GetSlicePosisions. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"36f4dcee-8d73-3b44-ba61-59436472bfb0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetSliceData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsPlottingTools/ref/GetSliceData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["offsets", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "98047423-39fd-fe4a-a50b-316419ab1e2b"],
 "\[LineSeparator]gets the slices from the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "ac324e10-dbbc-e842-999d-c38a016f5bad"],
 " defined by ",
 Cell[BoxData[
  StyleBox["offsets", "TI"]], "InlineFormula",ExpressionUUID->
  "c0907ad5-2ad9-8f40-ae02-9f0cd808efb7"],
 " which are obtained by GetSlicePosisions in mm. The ",
 Cell[BoxData[
  StyleBox["offsets", "TI"]], "InlineFormula",ExpressionUUID->
  "bb1e29b5-1740-064d-881b-b683c0201525"],
 " can also be provided manually which is {{AX,..},{COR,..},{SAG,..}}."
}], "Usage",
 CellChangeTimes->{{3.996656631400299*^9, 3.9966566315642586`*^9}},
