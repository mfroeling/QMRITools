Cell[CellGroupData[{
Cell["BayesianIVIMFit2", "ObjectName",
 CellID->377128982,ExpressionUUID->"9901d5f5-6c02-4749-895a-41fcd213925a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0d920cbe-f089-5348-baa5-baa940f3ffc6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BayesianIVIMFit2",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsIVIMTools/ref/BayesianIVIMFit2"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["bval", "TI"], ",", 
    StyleBox["init", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "cced181f-cb1b-1c44-aa41-e05904a6bb77"],
 "\[LineSeparator]performs bayesian IVIM fit of ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "ae533571-ccc3-4c40-8cc6-7d04307698cb"],
 ". ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "8e2e2b92-3fa1-e442-9758-8fe55aa30883"],
 " is the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "9a844c3d-df9a-704d-b3d6-a90ab222391f"],
 " which should be {slice, Ndiff, x, y}. ",
 Cell[BoxData[
  StyleBox["bval", "TI"]], "InlineFormula",ExpressionUUID->
  "c5ac2f3e-21d3-3247-81bd-ec0600f1e93c"],
 " is the bvector would be length Ndiff. ",
 Cell[BoxData[
  StyleBox["init", "TI"]], "InlineFormula",ExpressionUUID->
  "fdc98b84-6a49-9a45-a682-1e80e3a8f232"],
 " is the initialization of the bayesian fit which comes from ",
 Cell[BoxData[
  ButtonBox["IVIMCalc",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/IVIMCalc"]], "InlineFormula",
  ExpressionUUID->"d9f82911-253d-3340-826b-a4934571b723"],
 ", (without s0 using 2 compartments). mask is the region in which the \
bayesian fit is performed. output is {f1, dc, pdc1}. The fraction is defined \
between 0 and 1, the dc, pdc1 is in mm^2/s."
}], "Usage",
 CellChangeTimes->{{3.9966562692322807`*^9, 3.996656269409443*^9}},
 CellID->85758583,ExpressionUUID->"56af5ca7-8ada-2a4f-8fae-ab7459cb676c"],

