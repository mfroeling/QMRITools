Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5fbcec6b-47bd-ae46-931d-51b171adfe82"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeMuscleTemplate",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MakeMuscleTemplate"], "[", 
   RowBox[{
