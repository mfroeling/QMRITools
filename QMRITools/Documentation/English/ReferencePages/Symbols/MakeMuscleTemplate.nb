    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c73601f7-d658-5849-a418-bace7c55e0cb"],
 "\[LineSeparator]makes a muscle template form a series of ",
 Cell[BoxData[
  StyleBox["masks", "TI"]], "InlineFormula",ExpressionUUID->
  "b0e37747-d3f7-7140-a554-db3191e4cdae"],
 ". The output is the mean template muscle mask as a binary volume."
}], "Usage",
