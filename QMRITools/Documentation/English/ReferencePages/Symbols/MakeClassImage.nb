Cell["MakeClassImage", "ObjectName",
 CellID->492104236,ExpressionUUID->"e5179421-4670-794e-b79c-f30545331696"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c1585ec9-ad58-b24b-ad28-76c9d1cb9fcf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeClassImage",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeClassImage"], "[", 
   StyleBox["label", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1bdef852-6c42-7948-aaeb-0c3dffa570cb"],
 "\[LineSeparator]makes a cross-sectional image of the classes ",
 Cell[BoxData[
  StyleBox["label", "TI"]], "InlineFormula",ExpressionUUID->
  "7d16ec06-21cc-a346-91a4-0d05102beac2"],
 " of a training dataset generated by ",
 Cell[BoxData[
  ButtonBox["GetTrainData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
  ExpressionUUID->"6c5826d8-7867-6a40-9f13-cdfe71f0702e"],
 " \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6e7717c5-9f83-184a-939d-586e72a348dc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeClassImage",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeClassImage"], "[", 
   RowBox[{
    StyleBox["label", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["n", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "32d3c4de-f55c-9d4b-97ac-7768311daaa7"],
 "\[LineSeparator]same but with explicit definition of background value b and \
number of classes n. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3b90f463-0637-6d40-b752-4a938bc73dda"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeClassImage",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeClassImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e76bec4d-6138-ce4a-9d57-4b3221b9430e"],
 "\[LineSeparator]same but with the aspect ratio determined by ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "a50a634c-b62c-6a41-bee4-172ee0446365"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d3c42bea-25b9-524a-84b5-88ce1549ebe5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeClassImage",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeClassImage"], "[", 
   RowBox[{
    StyleBox["label", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b", "TI"], ",", 
      StyleBox["n", "TI"]}], "}"}], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "275fb671-3ed5-ff42-bd94-fde6c953e7a9"],
 "\[LineSeparator]same with explicit definition and aspect ratio definition."
