Notebook[{

Cell[CellGroupData[{
Cell["RegistrationTarget", "ObjectName",
 CellID->365864359,ExpressionUUID->"c76c919e-ecaf-694c-933a-57be81f22627"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"07fcfdca-9583-e64f-ae68-f9f1379c340b"],
 Cell[BoxData[
 "RegistrationTarget"], "InlineFormula",ExpressionUUID->
  "16a13e21-7087-f441-aaca-2f208768dcec"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["RegisterDiffusionData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterDiffusionData"]], 
  "InlineFormula",ExpressionUUID->"832567df-0aaf-6e4f-8d0a-568f4f5f7987"],
 " and ",
 Cell[BoxData[
  ButtonBox["RegisterCardiacData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterCardiacData"]], "InlineFormula",
  ExpressionUUID->"cd0ceefd-255b-234f-bb2f-ed696d11c80f"],
 ". Specifies which target to uses for registration if using \"rigid\", \
\"affine\" or \"bspline\" as ",
 Cell[BoxData[
  ButtonBox["MethodReg",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MethodReg"]], "InlineFormula",
  ExpressionUUID->"8998ee1d-a740-5a4f-87e2-6c311e1f6109"],
 ". If the ",
 Cell[BoxData[
  ButtonBox["MethodReg",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MethodReg"]], "InlineFormula",
  ExpressionUUID->"2b4f0a56-a9bc-4c47-888e-3963a09b1443"],
 " is \"PCA\" based it does not need a target and this options does nothing. \
Values can be \"First\", \"Mean\" or \"Median\"."
}], "Usage",
 CellID->239128124,ExpressionUUID->"d3a30636-6ddc-a34d-94a3-66275690727a"],

