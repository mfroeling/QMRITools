Cell[CellGroupData[{
Cell["CalibrateEPGT2Fit", "ObjectName",
 CellID->420075531,ExpressionUUID->"3360c75b-fcca-9344-813c-bb1ce6ce2b90"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"76ae0301-c04d-b041-b828-e638e901e504"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CalibrateEPGT2Fit",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/CalibrateEPGT2Fit"], "[", 
   RowBox[{
    StyleBox["datan", "TI"], ",", 
    StyleBox["times", "TI"], ",", 
    StyleBox["angle", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "73419ff8-7c59-b24f-9963-9911af454ea7"],
 "\[LineSeparator]calculates the Fat t2 ralaxation that will be used in the \
EPGT2fit. Outputs the fat t2 value."
}], "Usage",
 CellChangeTimes->{3.9966557066691303`*^9},
 CellID->56416731,ExpressionUUID->"6145319c-2228-2541-8257-4780209e8203"],

Cell["The following options can be given: ", "Notes",
 CellID->18733075,ExpressionUUID->"c24a3fcb-349a-ed49-a8bc-4f13ddd9b502"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "06f4e834-5dfd-5948-bcfd-911439de1902"], 
    ButtonBox["EPGRelaxPars",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/EPGRelaxPars"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "100"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"20", ",", " ", "300"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1400.", ",", " ", "365."}], "}"}]}], "}"}], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["EPGRelaxPars",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EPGRelaxPars"]], "InlineFormula",
      ExpressionUUID->"c2af88a3-f200-9248-9e55-ed51bd1ffec4"],
     " is and option for ",
