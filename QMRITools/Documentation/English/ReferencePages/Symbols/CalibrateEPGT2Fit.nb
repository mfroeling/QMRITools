      ExpressionUUID->"32595e8e-6da3-334e-aa19-094f9493ac0f"],
     ". Number of points is 200 by default."
    }], "TableText",ExpressionUUID->"27caff2b-26da-864d-9d72-f9dae1071fa1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3724b143-9dc8-d94b-9186-0f17ff82fd11"], 
