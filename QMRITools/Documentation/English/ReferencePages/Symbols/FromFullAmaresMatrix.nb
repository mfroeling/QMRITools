Cell[CellGroupData[{
Cell["FromFullAmaresMatrix", "ObjectName",
 CellID->245943673,ExpressionUUID->"3ddc3599-caab-5245-965c-657f50096685"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c03342bc-6a27-2341-85e2-58bca35287a8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FromFullAmaresMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/FromFullAmaresMatrix"], "[", 
   StyleBox["matrix", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "dbdc4adf-415b-f54d-8a1b-67ee02e5f118"],
 "\[LineSeparator]compresses the Amares fitting matrix to its full form by \
removing all defaults from the defined. To edit the matrix the function ",
 Cell[BoxData[
  ButtonBox["EditAmaresMatrix",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/EditAmaresMatrix"]], "InlineFormula",
  ExpressionUUID->"0be51409-b9a7-2949-8540-cc1e972aab16"],
 " can be used and to extend it ",
 Cell[BoxData[
  ButtonBox["ToFullAmaresMatrix",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ToFullAmaresMatrix"]], "InlineFormula",
  ExpressionUUID->"13d96875-1192-6d4b-9e44-1050c43457b0"],
 " can be used."
}], "Usage",
 CellChangeTimes->{3.995101411636322*^9},
 CellID->284657710,ExpressionUUID->"4be8e665-937e-034a-b61e-68117af10071"],

