Notebook[{

Cell[CellGroupData[{
Cell["FromFullAmaresMatrix", "ObjectName",
 CellID->2229792,ExpressionUUID->"4ad18226-1b18-964f-a6a6-645e99b897f7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c62c2c49-353c-514d-a079-1f98b6a4a3a3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FromFullAmaresMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/FromFullAmaresMatrix"], "[", 
   StyleBox["matrix", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2ec627a6-6196-0641-a5c8-9264ff819700"],
 "\[LineSeparator]compresses the Amares fitting matrix from its full form by \
removing all defaults from the defined. To edit the matrix the function ",
 Cell[BoxData[
  ButtonBox["EditAmaresMatrix",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/EditAmaresMatrix"]], "InlineFormula",
  ExpressionUUID->"852897c9-98d8-5e4f-a49b-567d28b900df"],
 " can be used and to extend it ",
 Cell[BoxData[
  ButtonBox["ToFullAmaresMatrix",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ToFullAmaresMatrix"]], "InlineFormula",
  ExpressionUUID->"ae0e4140-d86b-b14c-8d39-b2881808d815"],
 " can be used."
}], "Usage",
 CellChangeTimes->{3.996655616261654*^9},
