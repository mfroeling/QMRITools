Cell[CellGroupData[{
Cell["PlotRespiract", "ObjectName",
 CellID->444802805,ExpressionUUID->"ddd835fa-ccb7-f649-be4f-755417676db6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ac4c8c54-a03b-8b4b-aaa0-ad85180cad11"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotRespiract",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsLegacy/ref/PlotRespiract"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["dataP", "TI"], ",", 
    StyleBox["scantimes", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7719c073-059a-3b4f-b644-2d47996bc60c"],
 "\[LineSeparator]plots the respirect ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "8f32207b-ed15-4f49-9917-7b81113977e0"],
 " to correct peaks. ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "df38f9b8-c3b9-f74d-9627-55198fc3c1bc"],
 " and ",
 Cell[BoxData[
  StyleBox["dataP", "TI"]], "InlineFormula",ExpressionUUID->
  "50a4bd9b-85ff-c74c-9978-8ffc65f5fe34"],
 " are the first outputs of ImportResirect. ",
 Cell[BoxData[
  StyleBox["scantimes", "TI"]], "InlineFormula",ExpressionUUID->
  "910399c1-b8a4-514b-be03-ba1c4517ac22"],
 " is the output from AlignRespLog. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f9e30e81-a350-5843-9378-cc9b072d473f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotRespiract",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsLegacy/ref/PlotRespiract"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["dataP", "TI"], ",", 
    StyleBox["scantimes", "TI"], ",", 
    StyleBox["steps", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ca510991-f8ef-3542-87a8-eff4803a586f"],
 "\[LineSeparator]."
}], "Usage",
