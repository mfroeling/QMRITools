Notebook[{

Cell[CellGroupData[{
Cell["DixonToPercent", "ObjectName",
 CellID->155445227,ExpressionUUID->"7edecd36-73a4-cf48-9960-1ed7d5cd3175"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"81fd99d1-8383-6242-be50-f2985c90b92f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonToPercent",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonToPercent"], "[", 
   RowBox[{
    StyleBox["water", "TI"], ",", 
    StyleBox["fat", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e754dfed-d7a1-7c41-9b3e-25bbbcadabd5"],
 "\[LineSeparator]converts the dixon ",
 Cell[BoxData[
  StyleBox["water", "TI"]], "InlineFormula",ExpressionUUID->
  "2eef9773-984b-9747-a81a-12014d452541"],
 " and ",
 Cell[BoxData[
  StyleBox["fat", "TI"]], "InlineFormula",ExpressionUUID->
  "6505ad66-ba38-2c4d-9b70-822d7d2d7628"],
 " data to percent maps. Output is {waterFraction, fatFraction}. The values \
of ",
 Cell[BoxData[
  StyleBox["water", "TI"]], "InlineFormula",ExpressionUUID->
  "4baa3e63-83f9-8c49-8cba-5a53b2ab953d"],
 " and ",
 Cell[BoxData[
  StyleBox["fat", "TI"]], "InlineFormula",ExpressionUUID->
  "363ab1dc-be88-7344-abb4-7a433fe04adf"],
 " are arbitrary units and the output fractions are between 0 and 1. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e30e3522-0b37-c74d-b8ad-d7023a8096e3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonToPercent",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonToPercent"], "[", "]"}]],
   "InlineFormula",ExpressionUUID->"f2994f68-ae11-064b-94fb-48f633cc200c"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.21301."
}], "Usage",
 CellChangeTimes->{{3.996656352159338*^9, 3.996656352303755*^9}},
 CellID->118678218,ExpressionUUID->"c921f5a8-3e5a-4e40-9025-96cd16deb2bb"],

