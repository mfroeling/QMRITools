Notebook[{

Cell[CellGroupData[{
Cell["DixonToPercent", "ObjectName",
 CellID->85977455,ExpressionUUID->"d4297104-eccf-984a-be84-59a9405b2caa"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a74b67a3-49e7-0f4a-926a-9f9a6385c7e1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonToPercent",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonToPercent"], "[", 
   RowBox[{
    StyleBox["water", "TI"], ",", 
    StyleBox["fat", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bb823b92-6e81-9b46-a1d6-11a1438c9141"],
 "\[LineSeparator]converts the dixon ",
 Cell[BoxData[
  StyleBox["water", "TI"]], "InlineFormula",ExpressionUUID->
  "9746fb38-75f2-0549-8d27-ae5b4d24c5ef"],
 " and ",
 Cell[BoxData[
  StyleBox["fat", "TI"]], "InlineFormula",ExpressionUUID->
  "02e50efe-cc9d-844a-8a6e-d24cd972dfd9"],
 " data to fraction maps clipped between 0 and 1. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b1652563-4386-a645-b7ef-772e9b1422f3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonToPercent",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonToPercent"], "[", 
   RowBox[{
    StyleBox["water", "TI"], ",", 
    StyleBox["fat", "TI"], ",", 
    StyleBox["clip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f4cd8037-670d-874f-a8a4-63f2d0fcd6aa"],
 "\[LineSeparator]does the same, but if ",
 Cell[BoxData[
  StyleBox["clip", "TI"]], "InlineFormula",ExpressionUUID->
  "4ae93ac7-a103-a148-b5e2-d502c4e2873b"],
 " is False the fractions are clipped between -0.1 and 1.1, keeping small \
negative values caused by noise. Output is {waterFraction, fatFraction}. The \
values of ",
 Cell[BoxData[
  StyleBox["water", "TI"]], "InlineFormula",ExpressionUUID->
  "288772e6-8c3b-964a-ae41-0c236d6cc5cd"],
 " and ",
 Cell[BoxData[
  StyleBox["fat", "TI"]], "InlineFormula",ExpressionUUID->
  "05dc2d01-91bb-fb48-b821-817454a8de20"],
 " are arbitrary units and can be complex. The smallest component is derived \
from the dominant one (magnitude discrimination) to avoid a noise bias. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3d2a86ff-f860-6340-b6ce-b73b610a11bc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonToPercent",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonToPercent"], "[", "]"}]],
   "InlineFormula",ExpressionUUID->"be7ff386-e614-884f-8293-960ccb1d0208"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.21301."
}], "Usage",
 CellChangeTimes->{{4.003804511090355*^9, 4.0038045113206177`*^9}},
 CellID->475886688,ExpressionUUID->"254337d4-9376-2545-adc1-2028e0b91b6d"],

