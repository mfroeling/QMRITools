Notebook[{

Cell[CellGroupData[{
Cell["DenoiseCSIdata", "ObjectName",
 CellID->700969701,ExpressionUUID->"e6d49dba-c488-f843-8638-bc7fb24d83e0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d7194132-ea7b-0c47-8002-e1ee3ee164c5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DenoiseCSIdata",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/DenoiseCSIdata"], "[", 
   StyleBox["spectra", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "da07beaa-22ec-8149-b311-f7775867707d"],
 "\[LineSeparator]performs PCA denoising of the complex values spectra, data \
has to be 3D and the spectral dimensions is last, {x,y,z,spectra}."
}], "Usage",
 CellChangeTimes->{3.9966563553892536`*^9},
 CellID->174842021,ExpressionUUID->"0236acb5-075d-3740-a820-767bec87e45d"],

Cell["The following options can be given: ", "Notes",
 CellID->392490935,ExpressionUUID->"adab0509-6f95-3f47-a7e4-6b5a083574c9"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "72cd8daf-8321-6c4c-9d16-9b0ba9107292"], 
    ButtonBox["PCAKernel",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PCAKernel"], "5", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PCAKernel",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCAKernel"]], "InlineFormula",
      ExpressionUUID->"468d4e82-a915-434f-98bb-0f84da9072ac"],
     " is an option of ",
     Cell[BoxData[
      ButtonBox["PCADeNoise",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCADeNoise"]], "InlineFormula",
      ExpressionUUID->"45efba31-d1a8-5147-89f1-a7845e39c793"],
     ". It sets the kernel size."
    }], "TableText",ExpressionUUID->"3d96d95c-ec85-6449-bdb7-92ec7260952b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b7340934-7579-224c-ad98-771634ef451c"], 
    ButtonBox["PCANoiseSigma",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PCANoiseSigma"], "\"\<Corners\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PCANoiseSigma",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCANoiseSigma"]], "InlineFormula",
      ExpressionUUID->"6fcd4ca8-7296-8b41-825a-e7fb07f2b2f0"],
     " is an option of ",
     Cell[BoxData[
      ButtonBox["DenoiseCSI",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DenoiseCSI"]], "InlineFormula",
      ExpressionUUID->"b8011d08-5be9-594f-8545-e770897f732e"],
     "data and can be \"Corners\" or \"Automatic\"."
    }], "TableText",ExpressionUUID->"ce3743f3-789c-ed45-b429-97b67968b9f1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ef2e1707-f512-014f-97b7-f6aa6dbbf5ee"], 
    ButtonBox["PCAWeighting",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PCAWeighting"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PCAWeighting",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCAWeighting"]], "InlineFormula",
      ExpressionUUID->"79c958fb-0b47-a84c-9c7d-fd28b3e46dce"],
     " is an option of ",
     Cell[BoxData[
      ButtonBox["PCADeNoise",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PCADeNoise"]], "InlineFormula",
      ExpressionUUID->"fbcb62b8-094b-ba47-8ac8-a0b52cfaf456"],
     " and can be ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "cd205007-f745-c747-89a3-aae60186e6cf"],
     " of False. Default value is False. When ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "e28d5af3-0633-f84a-89bb-6f89948729a8"],
     " the weights of the per voxel result are calculated based on the number \
of non noise components."
    }], "TableText",ExpressionUUID->"a9af6ad8-3db2-514d-a610-75018bf02228"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9fc64047-945f-5640-87aa-69c3bd0f8aae"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<Patch\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"f826fb99-40ca-6e4d-b446-4b355c6a9e2f"]}
  }]], "3ColumnTableMod",
