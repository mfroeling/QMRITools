Cell["SelectBvalueData", "ObjectName",
 CellID->81730857,ExpressionUUID->"1de00e2d-84f7-154f-bab1-7acb3f48d34d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"525405fe-752f-0a40-857f-068bbbb6afdc"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectBvalueData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/SelectBvalueData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["vals", "TI"]}], "}"}], ",", 
    StyleBox["sel", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8b764b6d-8da8-a944-8617-05fc655258af"],
 "\[LineSeparator]selects the volumes and bvalues based on ",
 Cell[BoxData[
  StyleBox["sel", "TI"]], "InlineFormula",ExpressionUUID->
  "ddccd2dc-69bb-7c4b-a68d-e2142ca0a744"],
 ". The value of ",
 Cell[BoxData[
  StyleBox["sel", "TI"]], "InlineFormula",ExpressionUUID->
  "61298f17-84c8-da47-aa8a-6081b8ac136e"],
 " can be a number, for which al higher bvalues are selected, or a list {min, \
max}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"9cd641a2-7067-de4c-8b80-94c0e7ce00aa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectBvalueData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/SelectBvalueData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["vals", "TI"], ",", 
      StyleBox["grads", "TI"]}], "}"}], ",", 
    StyleBox["sel", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bfc7e854-6f25-8645-abbf-1a7d88ed4a77"],
 "\[LineSeparator]the same but also including the gradients. Output is {data, \
vals} or ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "data"}], "TI"]], "InlineFormula",ExpressionUUID->
  "2046cd1e-8e65-f148-9cad-a4cf3d0adda3"],
 ", ",
 Cell[BoxData[
  StyleBox["vals", "TI"]], "InlineFormula",ExpressionUUID->
  "9f1af45a-47a9-d74f-b3ce-69a89d4dada6"],
 ", grads",
 Cell[BoxData[
  StyleBox[
   RowBox[{"grads", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "e0c29bad-cfb5-8c43-b0c2-a34ee0163a81"],
 "}."
}], "Usage",
