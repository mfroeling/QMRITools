Cell["SelectBvalueData", "ObjectName",
 CellID->299625756,ExpressionUUID->"20cc7ce8-32d8-be42-97da-6f35d31bb282"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1bce13cc-ec33-e54d-8295-aa0886b0075d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectBvalueData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/SelectBvalueData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["vals", "TI"]}], "}"}], ",", 
    StyleBox["sel", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7159e2d8-bf73-274e-b05e-208ffde35ed9"],
 "\[LineSeparator]selects the volumes and bvalues based on ",
 Cell[BoxData[
  StyleBox["sel", "TI"]], "InlineFormula",ExpressionUUID->
  "0098ad01-4bde-294f-bc56-fd79793bd395"],
 ". The value of ",
 Cell[BoxData[
  StyleBox["sel", "TI"]], "InlineFormula",ExpressionUUID->
  "c5ca2c87-8fce-6545-8fa6-7caf9c445d94"],
 " can be a number, for which al higher bvalues are selected, or a list {min, \
max}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e52a6222-1e83-0c41-a376-e83bd95a5a83"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectBvalueData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/SelectBvalueData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["vals", "TI"], ",", 
      StyleBox["grads", "TI"]}], "}"}], ",", 
    StyleBox["sel", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8edac0a9-65a2-f945-bb7b-ec4f8aa336b4"],
 "\[LineSeparator]the same but also including the gradients. Output is {data, \
vals} or ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "data"}], "TI"]], "InlineFormula",ExpressionUUID->
  "301a8083-0393-df40-b2ce-90a830692636"],
 ", ",
 Cell[BoxData[
  StyleBox["vals", "TI"]], "InlineFormula",ExpressionUUID->
  "c235b71a-656c-ed49-bec7-d8bb7176d65a"],
 ", grads",
 Cell[BoxData[
  StyleBox[
   RowBox[{"grads", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "b3481bd1-9d5a-ca49-9b3a-e3cd62ed5342"],
 "}."
}], "Usage",
