Cell["SelectBvalueData", "ObjectName",
 CellID->382671698,ExpressionUUID->"03f7270d-c279-2141-9657-5339b7aa54d1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b889086c-9021-8841-83b3-b0619141a7fa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectBvalueData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/SelectBvalueData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["vals", "TI"]}], "}"}], ",", 
    StyleBox["sel", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f52d8849-3bc9-5540-9314-4b991619a06e"],
 "\[LineSeparator]selects the volumes and bvalues based on ",
 Cell[BoxData[
  StyleBox["sel", "TI"]], "InlineFormula",ExpressionUUID->
  "de2e9974-1e7a-544c-89d6-14c759561f67"],
 ". The value of ",
 Cell[BoxData[
  StyleBox["sel", "TI"]], "InlineFormula",ExpressionUUID->
  "cd5b7659-4eda-dc42-b13d-224ed33e3287"],
 " can be a number, for which al higher bvalues are selected, or a list {min, \
max}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6e2f09dc-c7c8-1342-899e-d5de87b0ae5f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectBvalueData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/SelectBvalueData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["data", "TI"], ",", 
      StyleBox["vals", "TI"], ",", 
      StyleBox["grads", "TI"]}], "}"}], ",", 
    StyleBox["sel", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b3f0cc7c-69ee-8543-95c6-87ed17521dfc"],
 "\[LineSeparator]the same but also including the gradients. Output is {data, \
vals} or ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "data"}], "TI"]], "InlineFormula",ExpressionUUID->
  "2fb526ba-5b7d-f442-8b8f-87fa09d6e5ce"],
 ", ",
 Cell[BoxData[
  StyleBox["vals", "TI"]], "InlineFormula",ExpressionUUID->
  "b3c3fd44-6298-474c-8553-9cdd0f58eabd"],
 ", grads",
 Cell[BoxData[
  StyleBox[
   RowBox[{"grads", "}"}], "TI"]], "InlineFormula",ExpressionUUID->
  "fb45667a-c6ea-2642-a394-97a1278f2001"],
 "}."
}], "Usage",
