Notebook[{

Cell[CellGroupData[{
Cell["AnisoFilterTensor", "ObjectName",
 CellID->58384793,ExpressionUUID->"ed52d1a9-9ce3-ea4f-a46a-b01d24dc6b16"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"289b35b2-0f66-9648-8dbe-230a8ac8cfb0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnisoFilterTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/AnisoFilterTensor"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["data", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4e752dda-5013-ff47-af37-e947c46cff1c"],
 "\[LineSeparator]Filter the tensor ",
 Cell[BoxData[
  StyleBox["tens", "TI"]], "InlineFormula",ExpressionUUID->
  "9109ac46-3b66-d141-a7f9-5215aa8060ce"],
 " using an anisotropic diffusion filter (Perona-Malik). It uses the \
diffusion weighted ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "120c1c83-6c4a-8e4f-8a2b-7e24f073e96f"],
 " ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "585bf215-c99a-4c4b-a071-ec7fc63ff9b5"],
 " to find edges that are not visible in the tensor. Edge weights based on \
the diffusion ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "d675e04c-4e71-3646-90bb-e6be43726227"],
 " are averaged over all normalized diffusion direction. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"610b5cf1-046b-614f-b0c6-7b699d2cdc5f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnisoFilterTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/AnisoFilterTensor"], "[", 
   StyleBox["tens", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "03394764-c3d9-a14f-a99f-2759e521345a"],
 "\[LineSeparator]Same but does not use the data for edge identification. \
Output is the smoothed tensor. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b9c88c4c-1ab6-7646-8c4c-c5cb85a51263"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnisoFilterTensor",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/AnisoFilterTensor"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "048aa317-e44c-434d-9f51-ed5367dd877e"],
 "\[LineSeparator]is based on DOI: 10.1109/ISBI.2006.1624856."
}], "Usage",
 CellChangeTimes->{{3.9966557086274242`*^9, 3.996655708860121*^9}},
 CellID->20956749,ExpressionUUID->"9cd23b72-124f-5b49-93c3-acc0d60a836d"],

Cell["The following options can be given: ", "Notes",
 CellID->41680873,ExpressionUUID->"0d7caca5-079a-084a-bf58-cbe9d4b7db50"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3d474112-6796-3d42-a916-4dbe35398afa"], 
    ButtonBox["AnisoWeightType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AnisoWeightType"], "2", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AnisoWeightType",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AnisoWeightType"]], "InlineFormula",
      ExpressionUUID->"fad7457b-0f00-5c48-8200-02cc4910bb49"],
     " is an option for ",
     Cell[BoxData[
     "AnisoFilterTensor"], "InlineFormula",ExpressionUUID->
      "30b2f517-4672-4042-8c19-563670595107"],
     " and ",
     Cell[BoxData[
      ButtonBox["WeightMapCalc",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/WeightMapCalc"]], "InlineFormula",
      ExpressionUUID->"0c425862-2ce8-1646-b3cd-037cbe8ac8c6"],
     " and defines the weighting, eigher 1, the exponent of (-g/kappa) or 2, \
1/(1+g/kappa)."
    }], "TableText",ExpressionUUID->"0bcab901-b199-7043-924b-54daa87afc8f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "84432a01-e755-f243-a0c8-86325f184b9d"], 
    ButtonBox["AnisoKappa",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AnisoKappa"], "5.", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AnisoKappa",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AnisoKappa"]], "InlineFormula",
      ExpressionUUID->"31b52aaf-b3b2-2f43-8e9f-9274435464ed"],
     " is an option for ",
     Cell[BoxData[
     "AnisoFilterTensor"], "InlineFormula",ExpressionUUID->
      "4d4bbe1b-88e0-c94a-9b41-401c620a12ab"],
     " and ",
     Cell[BoxData[
      ButtonBox["WeightMapCalc",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/WeightMapCalc"]], "InlineFormula",
      ExpressionUUID->"71a77681-a796-ef43-867e-ded2a829830e"],
     " and defines the weighting strength, all data is normalize to 100 \
before filetering."
    }], "TableText",ExpressionUUID->"3a5859a5-a004-d341-a8c0-36f3b02910e8"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c73bf811-7d4c-3f41-9161-1b2eff59520d"], 
    ButtonBox["AnisoStepTime",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AnisoStepTime"], "1", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AnisoStepTime",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AnisoStepTime"]], "InlineFormula",
      ExpressionUUID->"140086a2-d6cf-c047-b3f1-0e3da68f6af3"],
     " is an option for ",
     Cell[BoxData[
     "AnisoFilterTensor"], "InlineFormula",ExpressionUUID->
      "f107fb71-ef8a-f64d-b25a-f303e4ef7c82"],
     " and defines the diffusion time, when small more step are needed."
    }], "TableText",ExpressionUUID->"251515ad-71f8-eb4d-b5a6-f5aeb9c676aa"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "aff4d257-2740-664c-80f1-5c52abffdcd0"], 
    ButtonBox["AnisoFilterSteps",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AnisoFilterSteps"], "5", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AnisoFilterSteps",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AnisoFilterSteps"]], "InlineFormula",
      ExpressionUUID->"67a0cdcd-531a-9e41-8d4e-0a2c62d2f7d8"],
     " is an option for ",
     Cell[BoxData[
     "AnisoFilterTensor"], "InlineFormula",ExpressionUUID->
      "db20957c-19bb-7846-b76b-35c3bb559c30"],
     " and defines the amount of diffusin steps taken. Higher is more \
smoothing."
    }], "TableText",ExpressionUUID->"3d9d1df2-47bb-e040-b6dd-1270f39d89ea"]}
  }]], "3ColumnTableMod",
 CellID->190108815,ExpressionUUID->"c15a55b2-c927-b84e-80ed-1e80dc9331ec"]
}, Open  ]],

