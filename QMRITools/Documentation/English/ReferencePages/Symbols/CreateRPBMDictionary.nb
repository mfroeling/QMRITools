Cell["CreateRPBMDictionary", "ObjectName",
 CellID->152813536,ExpressionUUID->"8077da24-916a-884a-a7ff-beb562ae70ba"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"594f97f1-f240-3143-adc0-6ae0403137f5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CreateRPBMDictionary",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/CreateRPBMDictionary"], "[", 
   StyleBox["tm", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "bffa5109-3cf5-e742-87cb-fd1cb535993c"],
 "\[LineSeparator]creates a dictionary of RPBM functions for the given mixing \
times tm. Options are the used parameters in the dictionary and the simulated \
RD values, {pars, sim}."
}], "Usage",
 CellChangeTimes->{3.996655617478668*^9},
 CellID->76686004,ExpressionUUID->"11bc99e4-12b7-0e42-8dac-29ae3599a57c"],

