Cell[CellGroupData[{
Cell["ToFullAmaresMatrix", "ObjectName",
 CellID->206996766,ExpressionUUID->"58cf5ba8-be3f-f347-a17f-aa9adaaeca3d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"67da8c11-9316-5249-97db-1f98c00ab6b6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ToFullAmaresMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/ToFullAmaresMatrix"], "[", 
   StyleBox["names_List", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "37059acf-a14e-4841-abcc-37665e7a1bf3"],
 "\[LineSeparator]completes the Amares fitting matrix to its full form by \
using defaults for the values not defined. To edit the matrix the function ",
 Cell[BoxData[
  ButtonBox["EditAmaresMatrix",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/EditAmaresMatrix"]], "InlineFormula",
  ExpressionUUID->"790c79b1-a82e-8f47-9145-bbf80aba07b0"],
 " can be used and to compress it ",
 Cell[BoxData[
  ButtonBox["FromFullAmaresMatrix",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/FromFullAmaresMatrix"]], "InlineFormula",
  ExpressionUUID->"5f67f85c-f0b6-bf45-a281-6e44125a3b7d"],
 " can be used."
}], "Usage",
