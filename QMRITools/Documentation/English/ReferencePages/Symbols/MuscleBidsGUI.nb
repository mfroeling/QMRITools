Notebook[{

Cell[CellGroupData[{
Cell["MuscleBidsGUI", "ObjectName",
 CellID->803123461,ExpressionUUID->"2d5883c6-5ab4-be46-bdc6-ee4a1ae03ddb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1a7b3fa8-65c4-0844-911a-262a63cd6b0d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsGUI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsGUI"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b1a7011c-ffc4-b540-8a0a-54417db84825"],
 "\[LineSeparator]shows a GUI to run the Muscle Bids processing steps for the \
config file in dir, with the options of each step and the subjects to \
process. Each step runs in a separate kernel, nothing is printed in the \
notebook and the progress is shown from the log files. The tabs Config and \
Check show MuscleBidsConfig and ",
 Cell[BoxData[
  ButtonBox["MuscleBidsCheck",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MuscleBidsCheck"]], "InlineFormula",
  ExpressionUUID->"05c54b6d-336f-d149-98fe-006c477d0c6a"],
 "."
}], "Usage",
 CellChangeTimes->{4.0038045506108475`*^9},
 CellID->95645974,ExpressionUUID->"ddd09754-01b4-2c46-8eae-781932c8f340"],

