Notebook[{

Cell[CellGroupData[{
Cell["MuscleBidsGUI", "ObjectName",
 CellID->171205329,ExpressionUUID->"bad01920-6eef-2c48-93f3-852339c50486"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6f9700c8-5eaf-0a48-9933-03db9dcc766a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsGUI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsGUI"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "6bb44913-f25c-0941-afa2-db40d4ab7dab"],
 "\[LineSeparator]shows a GUI to run the Muscle Bids processing steps for the \
config file in dir, with the options of each step and the subjects to \
process. Each step runs in a separate kernel, nothing is printed in the \
notebook and the progress is shown from the log files. The tabs Check and \
Config show ",
 Cell[BoxData[
  ButtonBox["MuscleBidsCheck",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MuscleBidsCheck"]], "InlineFormula",
  ExpressionUUID->"85181e25-3a37-0f48-8688-e578527640ea"],
 " and ViewConfig."
}], "Usage",
 CellChangeTimes->{4.0022647341779404`*^9},
 CellID->133458276,ExpressionUUID->"d1d2d6cf-ee16-7c46-846e-14bbdf35eb77"],

