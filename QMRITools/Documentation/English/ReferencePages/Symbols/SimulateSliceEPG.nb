  StyleBox["excitation", "TI"]], "InlineFormula",ExpressionUUID->
  "6fbbe0ca-cd34-9a47-8766-4bb5a33d4dd0"],
 " and ",
 Cell[BoxData[
  StyleBox["refocus", "TI"]], "InlineFormula",ExpressionUUID->
  "9eeb7f2b-ec84-ac49-a05e-763c0c23b285"],
 " are generated by ",
