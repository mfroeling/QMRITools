Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c98bfc25-2120-9d4f-bdf5-58a960366f02"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimulateSliceEPG",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/SimulateSliceEPG"], "[", 
   RowBox[{
    StyleBox["excitation", "TI"], ",", 
    StyleBox["refocus", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        SubscriptBox[
         StyleBox["t", "TI"], 
         StyleBox["1", "TR"]], ",", 
        SubscriptBox[
         StyleBox["t", "TI"], 
         StyleBox["2", "TR"]]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["nEcho", "TI"], ",", 
        StyleBox["echoSp", "TI"]}], "}"}], ",", 
      SubscriptBox[
       StyleBox["b", "TI"], 
       StyleBox["1", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"6c0835f7-819e-2243-9d5f-d78437f26a21"],
 "\[LineSeparator]gives a simulated slice profile and EPG signal plot. ",
