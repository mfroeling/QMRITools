  ButtonBox["ReadListData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ReadListData"]], "InlineFormula",
  ExpressionUUID->"7930ab79-7b9a-1f4d-9a81-116d07e492b3"],
