Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5001d0b1-b196-d243-a1e7-340ffabe2c36"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["OrderKspace",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/OrderKspace"], "[", 
   RowBox[{
    StyleBox["kspace", "TI"], ",", 
    StyleBox["types", "TI"], ",", 
    StyleBox["order", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d3643658-7ea8-db40-955e-f518af049505"],
 "\[LineSeparator]reorders the ",
 Cell[BoxData[
  StyleBox["kspace", "TI"]], "InlineFormula",ExpressionUUID->
  "ba3d7927-902a-bd4d-aa2e-bb154e976256"],
 " data to ",
 Cell[BoxData[
  StyleBox["order", "TI"]], "InlineFormula",ExpressionUUID->
  "5fceb2f2-2597-7045-a627-4bdc1b5de88b"],
 ", where ",
 Cell[BoxData[
  StyleBox["order", "TI"]], "InlineFormula",ExpressionUUID->
  "ac8772c1-a5fd-fa42-8c78-db59acf02411"],
 " is a list and each value is a part of ",
 Cell[BoxData[
  StyleBox["types", "TI"]], "InlineFormula",ExpressionUUID->
  "2ab4c66a-6db0-184c-bebf-69a51125cf10"],
 ". The ",
 Cell[BoxData[
  StyleBox["kspace", "TI"]], "InlineFormula",ExpressionUUID->
  "94d54af4-c8e0-ba4d-8a3f-e349188d4f4f"],
 " and ",
 Cell[BoxData[
  StyleBox["types", "TI"]], "InlineFormula",ExpressionUUID->
  "ee514d1a-0f22-214b-be6f-ecf811d45c9b"],
 " are generated by ",
