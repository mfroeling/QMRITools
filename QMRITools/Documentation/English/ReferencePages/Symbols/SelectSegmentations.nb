Notebook[{

Cell[CellGroupData[{
Cell["SelectSegmentations", "ObjectName",
 CellID->15780403,ExpressionUUID->"d30bfb1d-40b0-b848-936d-514ecdc0af21"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6bccf373-b276-074f-bc7d-ec58def49bbf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/SelectSegmentations"], "[", 
   RowBox[{
    StyleBox["seg", "TI"], ",", 
    StyleBox["labs", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e937e1df-83db-e74e-b43f-9bbdcebd1c0f"],
 "\[LineSeparator]selects only the segmentations from ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "67b579e8-1af0-5646-99ed-f95e76a2e3d2"],
 " with label number ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "248bac21-15b0-8d4f-96cc-513b34ef05b7"],
 " and returns a labeled segmentation. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"bcbfe9fc-d8c0-ee45-a70e-d7486ee15896"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/SelectSegmentations"], "[", 
   RowBox[{
    StyleBox["seg", "TI"], ",", 
    StyleBox["labs", "TI"], ",", 
    StyleBox["join", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d3d34f95-6fd5-f24c-a243-8c6308580c70"],
 "\[LineSeparator]does the same but if ",
 Cell[BoxData[
  StyleBox["join", "TI"]], "InlineFormula",ExpressionUUID->
  "96748c2c-e8eb-194b-acac-a4b3b46f9d0f"],
 " is False the output is split as {masks, labels}, see SplitSegmentations. \
The input ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "c2946336-1bcf-ef49-8981-eddf8328663d"],
 " can also be a split segmentation {masks, labels}, in which case the output \
is always {masks, labels} sorted by label."
}], "Usage",
 CellChangeTimes->{{4.003804576180767*^9, 4.003804576461035*^9}},
 CellID->489004939,ExpressionUUID->"3270383b-9a8a-6e4a-9aca-d278bf83676e"],

