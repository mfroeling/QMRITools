Notebook[{

Cell[CellGroupData[{
Cell["ParameterCalc", "ObjectName",
 CellID->134778093,ExpressionUUID->"4e51109c-666b-454b-afe9-727aae7599d4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ec84c665-0e1b-0245-80da-a6954ee905ad"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ParameterCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/ParameterCalc"], "[", 
   StyleBox["tensor", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "98154f12-af8d-6943-a424-8b80986a823c"],
 "\[LineSeparator]calculates the eigenvalues and MD and FA from the given \
tensor. The parameters are l1, l2, l3, MD and FA. l1, l2, l3, MD are in \
(10^-3 mm^2/s)."
}], "Usage",
 CellChangeTimes->{3.996656385965683*^9},
 CellID->74890226,ExpressionUUID->"da48518a-ddf1-4c42-be26-145bb2aeb7c5"],

Cell["The following options can be given: ", "Notes",
 CellID->177638192,ExpressionUUID->"9120c387-0b29-4142-9a6e-b8a3fcaf01af"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5f534123-31d8-6347-90ab-1fa55ddf5b1a"], 
    ButtonBox["Reject",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/Reject"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["Reject",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Reject"]], "InlineFormula",
      ExpressionUUID->"d369efe1-83ee-6540-bae9-e7d60486689e"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["EigenvalCalc",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/EigenvalCalc"]], "InlineFormula",
      ExpressionUUID->"d9dbb7e4-038d-424b-b6ea-d0d997888c16"],
     ". It ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "01d8adb9-b551-ea45-924d-64ad8c10487b"],
     " then voxels with negative eigenvalues are rejected and set to 0."
    }], "TableText",ExpressionUUID->"d016d779-6d22-1549-a9e3-0e91b159340a"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b8ea389a-22d9-a743-89ca-953ca4a6baed"], 
    ButtonBox["PerformanceGoal",
     BaseStyle->"Link"], "\"\<Quality\>\"", Cell["\<\
