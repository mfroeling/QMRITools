 CellID->430739296,ExpressionUUID->"04be43fe-2ea1-a440-910a-615a24335514"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"610935b0-ea8e-5c40-a5ea-fdd1225699e5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
