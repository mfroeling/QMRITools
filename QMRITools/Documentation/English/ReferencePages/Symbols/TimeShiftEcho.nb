Cell[CellGroupData[{
Cell["TimeShiftEcho", "ObjectName",
 CellID->483750252,ExpressionUUID->"3fcedd0a-cc02-1d4b-903a-41b16091eae1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d4897c8b-5865-5744-9c04-a44a890c5f31"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gam", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c2fcff2f-1940-024b-af65-fbf8fb54b23a"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "48785ba1-9a73-b449-9b99-b48aa7caacd5"],
 " and a Voigt line shape to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "0c8f8669-296a-954b-981a-f23907454fe5"],
 ". The ",
 Cell[BoxData[
  StyleBox["time", "TI"]], "InlineFormula",ExpressionUUID->
  "f38ed5b2-f7d1-5041-a600-fe2846692c14"],
 " can be obtained using GetTimeRange. T\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fae4fb31-82e2-d247-bc7c-79df20ce5bb5"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["f", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "40c16f92-ade5-094b-a163-ba5fb10d25b7"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "ebaf37d1-5eba-134a-a028-571efd519d7e"],
 " and a custom line shape f to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "720a887b-25e5-5d41-a881-8c46e500ac74"],
 " (f=0, \"Gaussian\", f=1 \"Lorentzian\"). T\n",
 Cell["   ", "ModInfo",ExpressionUUID->"020523ba-8818-1a45-a9fd-f029b8627abd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["eps", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"a7f3e012-ef3a-544e-b196-b38c018709a2"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "734f14e4-4c43-a74b-8784-d5b80751534b"],
 " to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "43748df3-b454-5f4a-a5fa-6b9db76dea9b"],
 " and a phase ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "63e62d0b-5e95-594d-b843-a525568ec25c"],
 " that results in ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "1dbaf905-b7cf-4747-8104-dd065794a991"],
 " ppm shift of the spectra. The ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "d88ea0f9-f76c-1648-9203-c34aac9f5c46"],
 " can be obtained with GetGyro. T\n",
 Cell["   ", "ModInfo",ExpressionUUID->"eaa3a335-9006-b745-a8af-ad7586fc0121"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["eps", "TI"], ",", 
      StyleBox["f", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8722e1c9-8624-394e-bf31-ee8dbba00d67"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "e1e12e7a-1950-4c48-a0f5-a0dbad25e05f"],
 " using a custom line shape f to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "2b7a1a77-0eab-e943-9412-0791543987e7"],
 " and a phase ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "b5caaf09-667f-0c4c-9d5f-6077bd603249"],
 " that results in ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "94d44971-dcbf-c14d-9ff6-a7da839331b8"],
 " ppm shift of the spectra. The linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "e8a77379-458b-7d4b-be33-d8b5a8151fde"],
 " is given in ms and the spectra shift ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "b397be0e-de51-da4b-ae2a-72ff5652f772"],
 " is given in ppm."
}], "Usage",
