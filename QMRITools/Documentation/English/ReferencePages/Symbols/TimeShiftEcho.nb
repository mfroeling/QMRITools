    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["eps", "TI"], ",", 
      StyleBox["f", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2bdb0228-85d4-bf47-9b93-3fba3d2331de"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "8dd3af31-a1cb-8746-8110-465e335157e2"],
 " using a custom line shape f to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "d118529d-e1d1-af4f-87a7-88232543905e"],
 " and a phase ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "40449004-db93-084b-9293-e2c43781eb85"],
 " that results in ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "0ba0eab7-696a-534a-8f8e-b2186834ecc0"],
 " ppm shift of the spectra. The linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "f721d9cb-ba51-c145-b1cc-04c0e4a48f59"],
 " is given in ms and the spectra shift ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "09b4ca2a-485c-ec42-a1db-40cf97277feb"],
 " is given in ppm."
}], "Usage",
