Cell[CellGroupData[{
Cell["TimeShiftEcho", "ObjectName",
 CellID->23095286,ExpressionUUID->"969e46c4-ef1d-6049-8d4c-34dca84cd2e8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"83ff78b3-bc05-8746-a25e-db9ce76f23b2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gam", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3a3bf243-be9b-8247-8efd-a774de8a1719"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "5965709d-3c62-1543-b220-89c732b0ebc9"],
 " and a Voigt line shape to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "f279d766-2ab6-f342-ab3a-a58dbb705de0"],
 ". The ",
 Cell[BoxData[
  StyleBox["time", "TI"]], "InlineFormula",ExpressionUUID->
  "37905155-fece-d04f-97a7-b302e06dbce5"],
 " can be obtained using GetTimeRange. T\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5e168518-6bf7-da45-b284-b7f2969df384"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["f", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "65a75761-ce16-0d40-b270-146945c50d48"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "a0b2a755-149a-2f45-9fa3-2e39ac4327a3"],
 " and a custom line shape f to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "72b5b552-9042-6f40-aeae-f3d2d053c88a"],
 " (f=0, \"Gaussian\", f=1 \"Lorentzian\"). T\n",
 Cell["   ", "ModInfo",ExpressionUUID->"26f805e4-93c8-244f-be4e-37df81e1f586"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["eps", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"516ee9e8-f3a6-3f45-888b-fab34536c919"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "4363dd9b-6414-6a48-a65e-a2f46fe2afc4"],
 " to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "9c986138-2646-1a47-817b-b4934edfecaa"],
 " and a phase ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "220ad1ba-64ec-0341-b623-c8d9fd2a9d06"],
 " that results in ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "7cffab48-1bf2-d545-9d71-406437682382"],
 " ppm shift of the spectra. The ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "a89e01d5-8ee7-634a-bafe-40dfb3e2f98a"],
 " can be obtained with GetGyro. T\n",
 Cell["   ", "ModInfo",ExpressionUUID->"de1e2327-3d60-1947-a34d-f7a1b329b32d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["eps", "TI"], ",", 
      StyleBox["f", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4f23c219-b445-5645-a039-746e12bed74b"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "7843f148-8d9f-d944-8b73-fbcd3c471b39"],
 " using a custom line shape f to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "0a991b09-3bad-de4f-8881-75bbbddd4e2f"],
 " and a phase ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "6758d93a-9c01-de4b-9ea3-a7e426081100"],
 " that results in ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "476ead45-6779-064d-a9c9-baf1888aca8a"],
 " ppm shift of the spectra. The linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "37a7f4b5-fec9-d54f-8ae5-2ec190b8f528"],
 " is given in ms and the spectra shift ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "bfefbd8f-4a0b-5244-982f-b9cf25a385cc"],
 " is given in ppm."
}], "Usage",
