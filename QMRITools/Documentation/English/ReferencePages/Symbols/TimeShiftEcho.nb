  "db899ef7-59e1-9e43-a10a-097d606ce728"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "d368e8b5-b913-9044-ae81-531a1a0184db"],
 " and a Voigt line shape to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "f79be467-bf80-014e-b8de-b82e08fcbf16"],
 ". The ",
 Cell[BoxData[
  StyleBox["time", "TI"]], "InlineFormula",ExpressionUUID->
  "8194fac8-8688-8d4a-bf7a-c830716b5f39"],
 " can be obtained using ",
 Cell[BoxData[
  ButtonBox["GetTimeRange",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetTimeRange"]], "InlineFormula",
  ExpressionUUID->"9ae0f313-b2e2-144b-9229-670ddbb500db"],
 ". T\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c0fa089c-424f-6e45-829d-b21270606f9a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["f", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9fbc1f21-f954-b943-acc1-0834d7a0b2f1"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "bc83d98e-3b2b-b546-81af-f70c7d3fed1b"],
 " and a custom line shape f to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "32df1bc3-8a28-4e47-9766-7578194c3fb9"],
 " (f=0, \"Gaussian\", f=1 \"Lorentzian\"). T\n",
 Cell["   ", "ModInfo",ExpressionUUID->"12dd26c3-afc4-7140-9957-280a46101d4a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gam", "TI"], ",", 
      StyleBox["eps", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"61eb887c-3a60-cf4d-bf10-ce4d6cfe01e1"],
 "\[LineSeparator]applies a line broadening with linewidth ",
 Cell[BoxData[
  StyleBox["gam", "TI"]], "InlineFormula",ExpressionUUID->
  "d0dd927e-53fd-d447-a030-84d6e8ff3630"],
 " to the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "ed2d0bc0-1d5f-8849-ad49-c3663c6083c5"],
 " and a phase ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "11e99b1c-28e3-a741-9bc8-f19fc5813ab7"],
 " that results in ",
 Cell[BoxData[
  StyleBox["eps", "TI"]], "InlineFormula",ExpressionUUID->
  "2ee6dc11-01ad-0241-b1c8-2f73a07d04fc"],
 " ppm shift of the spectra. The ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "f8cd9060-cbbb-d846-91fe-d737130654fb"],
 " can be obtained with ",
 Cell[BoxData[
  ButtonBox["GetGyro",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetGyro"]], "InlineFormula",
  ExpressionUUID->"53876e43-c81c-3d4e-bf23-499458bbe7b1"],
 ". T\n",
 Cell["   ", "ModInfo",ExpressionUUID->"503769df-5b56-274f-aab2-974484ea9dc9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TimeShiftEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/TimeShiftEcho"], "[", 
