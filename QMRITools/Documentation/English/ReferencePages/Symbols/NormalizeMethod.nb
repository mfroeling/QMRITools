Cell["NormalizeMethod", "ObjectName",
 CellID->556440341,ExpressionUUID->"352601cd-e177-ab49-86a4-8c5e8e4aa39c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"507f9723-d8e5-df4c-8345-b3c16646a607"],
 Cell[BoxData[
 "NormalizeMethod"], "InlineFormula",ExpressionUUID->
  "06b12654-35b5-bb49-a45b-bd5ba4e08251"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["NormalizeData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/NormalizeData"]], "InlineFormula",
  ExpressionUUID->"1473ce9e-ba22-f745-a4fb-3241cfdd7e3e"],
 ". Can be \"Set\" or \"Volumes\" which normalizes to the first volume or \
normalizes each volume individually, respectively. If \"Uniform\" normalizes \
the histogram of the data to have a uniform distribution between 0 and 1 \
where 0 is treated as background of the data."
}], "Usage",
 CellID->531734295,ExpressionUUID->"524c27d2-b2e0-a746-b637-bc93a7c90e59"],

