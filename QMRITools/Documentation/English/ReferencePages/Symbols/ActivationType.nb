  ButtonBox["MakeUnet",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
  ExpressionUUID->"b5e2f454-4469-b548-ac65-bac6e943f58b"],
