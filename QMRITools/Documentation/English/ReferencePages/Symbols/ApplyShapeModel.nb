Notebook[{

Cell[CellGroupData[{
Cell["ApplyShapeModel", "ObjectName",
 CellID->171038978,ExpressionUUID->"bb01cd96-6b4a-8a4d-8a0d-16ca89bbcde8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9d6c2a8c-432a-cf40-9280-df27ae87e46d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ApplyShapeModel",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/ApplyShapeModel"], "[", 
   RowBox[{
    StyleBox["model", "TI"], ",", 
    StyleBox["std", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "640b1773-9a8a-7c49-b58c-f1c187f21b80"],
 "\[LineSeparator]applies the ",
 Cell[BoxData[
  StyleBox["std", "TI"]], "InlineFormula",ExpressionUUID->
  "e80c3b14-ab15-eb4c-921b-6bf1fe225f2f"],
 " to the shape ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "72ba892a-547e-eb48-a82e-5e17c73c2322"],
 " to create the points. The ",
 Cell[BoxData[
  StyleBox["model", "TI"]], "InlineFormula",ExpressionUUID->
  "af024a4b-39a6-314c-9577-42b664dddb88"],
 " is made by ",
 Cell[BoxData[
  ButtonBox["MakeShapeModel",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeShapeModel"]], "InlineFormula",
  ExpressionUUID->"42590f60-d20d-a74a-b0c7-2eaafa1a0266"],
 ", the ",
 Cell[BoxData[
  StyleBox["std", "TI"]], "InlineFormula",ExpressionUUID->
  "e941cef4-7b06-a64d-96c5-9bb530277d49"],
 " is obtained by ",
 Cell[BoxData[
  ButtonBox["FitShapeModel",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/FitShapeModel"]], "InlineFormula",
  ExpressionUUID->"5ed6dee3-f74f-1640-b1fe-aa5f34485c10"],
 ". The std can be a number, vector or matrix. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d0ba2e0a-08b2-5146-9e3f-523443a1b13b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ApplyShapeModel",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/ApplyShapeModel"], "[", 
   RowBox[{
    StyleBox["model", "TI"], ",", 
    StyleBox["std", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "017b340d-081a-9945-8e21-b639806c35bb"],
 "\[LineSeparator]does the same but std is a number and ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "df5bf240-a343-4c43-90cf-6c217201c843"],
 " the integer indicating which vector to be used."
}], "Usage",
 CellChangeTimes->{{3.9966563124143963`*^9, 3.996656312612667*^9}},
 CellID->842783958,ExpressionUUID->"2886a484-ecc9-aa41-a4de-aa914a70187d"],

