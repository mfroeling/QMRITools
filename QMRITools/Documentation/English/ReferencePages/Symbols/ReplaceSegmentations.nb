Notebook[{

Cell[CellGroupData[{
Cell["ReplaceSegmentations", "ObjectName",
 CellID->288292218,ExpressionUUID->"b3c3c71b-7cbb-0f49-a033-bc04b2450a3e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b6be0a7f-3352-7243-8923-7421ab804140"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReplaceSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/ReplaceSegmentations"], "[", 
   RowBox[{
    StyleBox["seg", "TI"], ",", 
    StyleBox["labs", "TI"], ",", 
    StyleBox["new", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ca282e86-4708-d348-8777-3e98d10eb589"],
 "\[LineSeparator]replaces the labels ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "ba5019f9-a5e1-2045-9d1b-053073ee1cb9"],
 " form the segmentation ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "25fa2afe-e804-1a4b-bb92-5d3e8f70fcab"],
 " for labels ",
 Cell[BoxData[
  StyleBox["new", "TI"]], "InlineFormula",ExpressionUUID->
  "af24867a-2785-de46-a095-a60e1a43770d"],
 ". Both ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "cf031097-d7cb-e84a-8fbb-091f7164a68b"],
 " and ",
 Cell[BoxData[
  StyleBox["new", "TI"]], "InlineFormula",ExpressionUUID->
  "05e9e85e-5ebc-f243-9da0-3a8d1ee34c50"],
 " should be lists of integers of the same size. If ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "bf042884-406d-374b-8e49-ea131709e6ef"],
 " contains more labels then given in ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "8fbaab40-0206-7341-a7d1-98b0c091b923"],
 " these will be replaced by 0."
}], "Usage",
 CellChangeTimes->{{3.996655610627186*^9, 3.9966556107593307`*^9}},
 CellID->808565178,ExpressionUUID->"6b960621-dbed-fc4c-9c58-c753340366e8"],

