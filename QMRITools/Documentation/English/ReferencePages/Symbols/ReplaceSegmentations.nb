Notebook[{

Cell[CellGroupData[{
Cell["ReplaceSegmentations", "ObjectName",
 CellID->633507308,ExpressionUUID->"1d6840f5-7dda-d54c-9917-ff58bbec4932"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"abe95825-13e1-5741-a5b0-b69b7c36ce1d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReplaceSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/ReplaceSegmentations"], "[", 
   RowBox[{
    StyleBox["seg", "TI"], ",", 
    StyleBox["labs", "TI"], ",", 
    StyleBox["new", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "eb23305c-9850-c74b-9882-0406fe63ae77"],
 "\[LineSeparator]replaces the labels ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "532659eb-0bbd-2c4f-97c4-c0765d0377de"],
 " from the segmentation ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "9246c908-2558-5a42-a082-855b2f983315"],
 " for labels ",
 Cell[BoxData[
  StyleBox["new", "TI"]], "InlineFormula",ExpressionUUID->
  "6e5ddbb5-ebfd-b74d-bc79-3ff766311b66"],
 ". Both ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "acb6c439-6971-2546-bf97-76c477087c87"],
 " and ",
 Cell[BoxData[
  StyleBox["new", "TI"]], "InlineFormula",ExpressionUUID->
  "7c9e12ec-889e-344e-9e8e-55694725b170"],
 " should be lists of integers of the same size. If ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "abbbf81a-0c09-a946-9065-978b90a75dae"],
 " contains more labels then given in ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "c6e8c17e-fa9b-4b43-b70a-e631586ffd1d"],
 " these will be replaced by 0. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"eedbf629-10d4-7042-93a5-cfc561c5d4e4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReplaceSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/ReplaceSegmentations"], "[", 
   RowBox[{
    StyleBox["seg", "TI"], ",", 
    StyleBox["labs", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5959637d-2edc-1e49-8371-542a406ba4e9"],
 "\[LineSeparator]replaces the labels ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "59fd66f8-dca9-4842-b4d7-11b0e7c215d0"],
 " by a random permutation of Range[Length[labs]],using a fixed random seed. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"184e18bd-b4c5-6547-90e4-66a614b84015"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReplaceSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/ReplaceSegmentations"], "[", 
   StyleBox["seg", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "bc91c030-7c64-4b45-8cbd-92e6b1729cfc"],
 "\[LineSeparator]does the same for all labels in ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "36858cf5-7abd-6b45-b23e-b0e68b600254"],
 ". When ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "18bb59dc-0d95-b741-8e1a-b50dc40bde8b"],
 " is given, the input ",
 Cell[BoxData[
  StyleBox["seg", "TI"]], "InlineFormula",ExpressionUUID->
  "e72a0a51-1af3-504c-8443-710757d45e6d"],
 " can also be a split segmentation {masks, labels}, in which case the output \
is {masks, labels} sorted by label."
}], "Usage",
 CellChangeTimes->{{4.00380456802273*^9, 4.003804568482485*^9}},
 CellID->150603,ExpressionUUID->"79f2fe86-7fb6-1b4b-afdd-9c4a3523d21e"],

