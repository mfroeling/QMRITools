Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5528a25d-14c3-664a-954a-6feec5c8b73e"],
 Cell[BoxData[
 "UnwrapDimension"], "InlineFormula",ExpressionUUID->
  "c5ba7b48-7b83-5c47-b07a-5f53b1d9bcd2"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["Unwrap",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/Unwrap"]], "InlineFormula",
  ExpressionUUID->"93cae712-d840-9647-b5eb-c403eddf4c47"],
 ". Can be \"2D\" or \"3D\". 2D is for unwarpping 2D images or unwrapping the \
individual images from a 3D dataset (does not unwrap in the slice direction). \
3D unwraps a 3D dataset in all dimensions."
}], "Usage",
 CellID->377256494,ExpressionUUID->"9781b281-6e69-cf4d-b78d-318051b83673"],

