Cell[CellGroupData[{
Cell["RestartLearningCycle", "ObjectName",
 CellID->356049792,ExpressionUUID->"0f7c6d57-7a20-ef4e-bdfe-2c86779d3e4f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"62199a56-f90e-fd49-a184-840a023d615a"],
 Cell[BoxData[
 "RestartLearningCycle"], "InlineFormula",ExpressionUUID->
  "5a947ce4-c376-5944-9bce-5700c2f01d7a"],
 "\[LineSeparator]is an option for TrainSegmentationNetwork. If set to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "033abe57-76dc-4a4e-8744-6a1749218b97"],
 " and continuing training from a previous run, the one-cycle learning rate \
schedule (including its warmup) is restarted from 0 and fit to the remaining \
rounds, instead of resuming mid-cycle where the previous run left off."
}], "Usage",
 CellChangeTimes->{3.99853067858416*^9},
 CellID->934753603,ExpressionUUID->"cfdca478-495d-7f42-b3d3-8f10a0d8f7b8"],

