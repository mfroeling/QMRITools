Cell[CellGroupData[{
Cell["MergeSegmentations", "ObjectName",
 CellID->323308875,ExpressionUUID->"db8f5dbf-4838-cd4f-a634-9bce9a2115d2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"661db39c-69c9-e54e-88b0-9408d05bb5f9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MergeSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/MergeSegmentations"], "[", 
   RowBox[{
    StyleBox["masks", "TI"], ",", 
    StyleBox["labels", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "36a590af-4e60-4544-8838-7bd21aab8f03"],
 "\[LineSeparator]generates an ITKsnap or slices3D compatible segmentation \
from individual ",
 Cell[BoxData[
  StyleBox["masks", "TI"]], "InlineFormula",ExpressionUUID->
  "7fd5211e-7e2d-474b-9606-a6713a84a3b8"],
 " and label numbers. Output is a labeled segmentation. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"dc5e1c3d-2b97-d14b-b282-62abad34bec2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MergeSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/MergeSegmentations"], "[", 
   StyleBox["masks", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d4058554-1c68-6641-b4c2-b3b2006274df"],
 "\[LineSeparator]does the same but automatically numbers the segmentations."
}], "Usage",
