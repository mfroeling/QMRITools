Notebook[{

Cell[CellGroupData[{
Cell["MergeSegmentations", "ObjectName",
 CellID->50649525,ExpressionUUID->"52d53ce5-6977-bf41-8fed-6044ed61fe23"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3fadae12-e771-8247-a337-558cb8e06fd0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MergeSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/MergeSegmentations"], "[", 
   RowBox[{
    StyleBox["masks", "TI"], ",", 
    StyleBox["labels", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0dd2b434-7e59-154e-8108-3cfe76bdecd2"],
 "\[LineSeparator]generates an ITKsnap or slices3D compatible segmentation \
from individual ",
 Cell[BoxData[
  StyleBox["masks", "TI"]], "InlineFormula",ExpressionUUID->
  "9acc0af4-e041-bc49-bd6c-a0f4e660e1f4"],
 " and label numbers. Output is a labeled segmentation. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3192842c-f89b-354a-8e8d-db4f6c05aa03"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MergeSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/MergeSegmentations"], "[", 
   StyleBox["masks", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "cb22fd20-f7cb-1e47-ae46-5e51bcbee15d"],
 "\[LineSeparator]does the same but automatically numbers the segmentations. \
The ",
 Cell[BoxData[
  StyleBox["masks", "TI"]], "InlineFormula",ExpressionUUID->
  "3d037684-60ca-1d41-9b96-74f6db610304"],
 " are {z, ",
 Cell[BoxData[
  StyleBox["masks", "TI"]], "InlineFormula",ExpressionUUID->
  "a9f34674-2c74-864d-868d-a7d4cb772501"],
 ", y, x}. Voxels where ",
 Cell[BoxData[
  StyleBox["masks", "TI"]], "InlineFormula",ExpressionUUID->
  "7db1397c-9c0c-4a45-99c2-d60b43a83f21"],
 " overlap are set to 0."
}], "Usage",
 CellChangeTimes->{{4.0038045472017937`*^9, 4.0038045473435154`*^9}},
 CellID->461042143,ExpressionUUID->"f1d402a8-b990-ad46-a5a6-9ef9569a0cdb"],

