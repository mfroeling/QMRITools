Cell[CellGroupData[{
Cell["MakeCoilLayout", "ObjectName",
 CellID->375960282,ExpressionUUID->"38126e8f-6738-9b45-85e2-7f9977c584cb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"793b4b5d-a68f-a645-a83d-d09253fe36f1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["name", "TI"], ",", 
     StyleBox["size", "TI"], ",", 
     StyleBox["number", "TI"]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"df974a91-fe7e-ac48-a0a3-3db701562e94"],
 "\[LineSeparator]makes a coil grid with label name, partioned in ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "c196dfa3-ee91-0147-9fb1-8169d445e5eb"],
 " rows and with label number. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"de95dcd6-e660-db45-8aef-4d4a316c2710"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["name", "TI"], ",", 
      StyleBox["size", "TI"], ",", 
      StyleBox["number", "TI"]}], "}"}], ",", 
    StyleBox["val", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "54d3905f-8b50-5942-bb0b-f1570e50e071"],
 "\[LineSeparator]makes a coil grid with label name, partioned in ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "0c42711f-de9a-674a-872f-8a97ad9940a4"],
 " rows and with label the ",
 Cell[BoxData[
  StyleBox["val", "TI"]], "InlineFormula",ExpressionUUID->
  "995fc8c6-04c8-4648-91b4-c4a02d9b610a"],
 " at location number. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"569c7372-36aa-8043-b4f2-8bcc1b4cb225"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["coils", "TI"], ".."}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"d8b6888e-708c-1544-95c1-75d0545eda31"],
 "\[LineSeparator]same but for multile coils grids. Each coil grid is defined \
as {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "name"}], "TI"]], "InlineFormula",ExpressionUUID->
  "beb5bbd2-2c69-9f47-82cb-73c6637d2d38"],
 "name,size,number}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"29cbd6bd-0cd2-724a-99c5-4897a25734c7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["coils", "TI"], ".."}], "}"}], ",", 
    StyleBox["val", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8da0b1c7-196b-164d-89c0-42378f1e7a50"],
 "\[LineSeparator]savem but for multiple coil grids."
}], "Usage",
 CellChangeTimes->{{4.0038045402042866`*^9, 4.003804540454653*^9}},
