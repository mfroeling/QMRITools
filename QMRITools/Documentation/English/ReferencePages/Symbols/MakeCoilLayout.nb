Cell[CellGroupData[{
Cell["MakeCoilLayout", "ObjectName",
 CellID->440809061,ExpressionUUID->"5aa2fe8a-fd7d-9c4f-98bd-0b0d317d54fc"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e3090740-07d2-484f-aa76-b291c3a84b82"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["name", "TI"], ",", 
     StyleBox["size", "TI"], ",", 
     StyleBox["number", "TI"]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"a1a078b1-90d8-c042-a45e-dccce10a2a25"],
 "\[LineSeparator]makes a coil grid with label name, partioned in ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "4aabf859-cbdf-6445-825f-ae92a161e412"],
 " rows and with label number. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"369de316-bf09-4f42-8dd3-5309bf03ed56"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["name", "TI"], ",", 
      StyleBox["size", "TI"], ",", 
      StyleBox["number", "TI"]}], "}"}], ",", 
    StyleBox["val", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "de2ca448-e455-3443-a228-731a8bf5721b"],
 "\[LineSeparator]makes a coil grid with label name, partioned in ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "9bcd5f8e-e960-1a4a-98d0-878d7ee72d90"],
 " rows and with label the ",
 Cell[BoxData[
  StyleBox["val", "TI"]], "InlineFormula",ExpressionUUID->
  "3fc05fe2-26d0-b449-b8f1-5dc24e985972"],
 " at location number. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"69a38d2f-d7db-c14e-b0cd-8df864d3a31d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["coils", "TI"], ".."}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"58194cc0-d74d-9b4e-aa9e-0e34d19d3010"],
 "\[LineSeparator]same but for multile coils grids. Each coil grid is defined \
as {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "name"}], "TI"]], "InlineFormula",ExpressionUUID->
  "05c85c8b-1820-8346-87f8-a4b4052da515"],
 "name,size,number}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e047cdf4-3fa7-314e-8fdf-ade46bbdd7ea"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["coils", "TI"], ".."}], "}"}], ",", 
    StyleBox["val", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "def23bb8-3e41-1442-b1f0-426faec50ce7"],
 "\[LineSeparator]savem but for multiple coil grids."
}], "Usage",
