Cell[CellGroupData[{
Cell["MakeCoilLayout", "ObjectName",
 CellID->840556452,ExpressionUUID->"9e81488f-385d-f048-9303-0ef071c9794e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7b8107b6-67fe-fb41-857e-27ad39c3cd33"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["name", "TI"], ",", 
     StyleBox["size", "TI"], ",", 
     StyleBox["number", "TI"]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"89b67988-a16c-0d48-8f26-f3992a935d16"],
 "\[LineSeparator]makes a coil grid with label name, partioned in ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "ac2bb7f0-7525-f845-b05b-e1fddc0b46dd"],
 " rows and with label number. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"dc61dceb-9a7d-d045-8353-6a67f6b33adf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["name", "TI"], ",", 
      StyleBox["size", "TI"], ",", 
      StyleBox["number", "TI"]}], "}"}], ",", 
    StyleBox["val", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "33795fb8-3ece-484c-b9f2-0e46f60456e9"],
 "\[LineSeparator]makes a coil grid with label name, partioned in ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "155deea6-5be3-c845-b019-ff4cc5f64c65"],
 " rows and with label the ",
 Cell[BoxData[
  StyleBox["val", "TI"]], "InlineFormula",ExpressionUUID->
  "726d3814-77b9-034c-bd1d-c23cc543e6a9"],
 " at location number. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"955b877e-77b8-104e-83a9-495c8a3710f8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["coils", "TI"], ".."}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"e48660c3-e539-4d4c-975d-18584de6abde"],
 "\[LineSeparator]same but for multile coils grids. Each coil grid is defined \
as {",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "name"}], "TI"]], "InlineFormula",ExpressionUUID->
  "ea5bfe85-47bb-0847-8874-9aea105e48fe"],
 "name,size,number}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"62ba74ac-5495-c34c-b89c-7dde726bdcd3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCoilLayout",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/MakeCoilLayout"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["coils", "TI"], ".."}], "}"}], ",", 
    StyleBox["val", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6418a90f-830c-f64c-ab74-a22fbd7d86e4"],
 "\[LineSeparator]savem but for multiple coil grids."
}], "Usage",
