Notebook[{

Cell[CellGroupData[{
Cell["AmaresFitFidI", "ObjectName",
 CellID->358487710,ExpressionUUID->"f1f28c5e-f620-5245-aad8-427b84a867b1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ce553a4d-aa42-a249-8fb4-309ab656346c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresFitFidI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresFitFidI"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["cons", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "621a0cfc-865e-1e47-b96d-9206aa17394a"],
 "\[LineSeparator]fits the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "8be02d5b-4fd7-7648-b0b3-8f63d316a527"],
 " with using the ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "14606647-77a0-3f47-822f-116aa1d3594a"],
 " spectra. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"40afa6c5-1a09-b142-836b-42a93c27e25a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresFitFidI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresFitFidI"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["cons", "TI"], ",", 
      StyleBox["init", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"a5915e9b-baf1-8e4b-8308-e6b426a7e2c7"],
 "\[LineSeparator]fits the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "5c09c684-7d0b-f443-a402-017e3765b606"],
 " using initial values init which can be obtained from a previous fit or \
from AmaresInitialValues. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"20319629-46a6-7f44-af67-eaeed0b42f65"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresFitFidI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresFitFidI"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox[
      RowBox[{"1", "pars"}], "TI"]], ",", 
    StyleBox["cons", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3ae6846d-d047-2a4e-9004-df1f0241933f"],
 "\[LineSeparator]the ",
 Cell[BoxData[
  StyleBox["b1pars", "TI"]], "InlineFormula",ExpressionUUID->
  "a00e5b2c-a283-bf4b-8ad5-6515d32be977"],
 " are needed if in the ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "e2b054f3-c0ec-9647-89e3-37cdf79f468e"],
 " B1 correction is set ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "02defad0-f29c-8f47-8791-0a1386c40af6"],
 ". The ",
 Cell[BoxData[
  StyleBox["b1pars", "TI"]], "InlineFormula",ExpressionUUID->
  "20da0350-47ce-5b42-a442-6b806f9d4dea"],
 " are defined as {tau, fa, TR} with tau and TR in ms and fa in degrees. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"284988ec-a5b6-1f40-a5dd-82eba277397b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresFitFidI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresFitFidI"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox[
      RowBox[{"1", "pars"}], "TI"]], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["cons", "TI"], ",", 
      StyleBox["init", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"f5adf410-e1ae-6e46-b89c-ca87e6ef1290"],
 "\[LineSeparator]fits using initial values using ",
 Cell[BoxData[
  StyleBox["b1pars", "TI"]], "InlineFormula",ExpressionUUID->
  "8b8d7d71-7041-fa44-a2f6-b15665f59ce3"],
 " for B1 correction. The ",
 Cell[BoxData[
  StyleBox["time", "TI"]], "InlineFormula",ExpressionUUID->
  "a8e279fd-781d-5a4e-9aab-f5e4507ffc68"],
 ", ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "945461ae-3cf6-0343-96fd-1ffb16f1c69b"],
 " and ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "7676ecc3-f394-3d47-8205-2ded7f6cb488"],
 " can be obtained from AmaresBasis and the ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "ea1222e1-ea57-9a4c-a635-e62028bcee6e"],
 " can be obtained form EditMaresMatrix. The ",
 Cell[BoxData[
  StyleBox["cons", "TI"]], "InlineFormula",ExpressionUUID->
  "d69ae4a2-cdee-124c-bb4c-ebfb924dfb36"],
 " have to be defined for {\"amp\", \"sigma\", \"gamma\", \"shift\", \
\"phase\", \"B1\"} as {min, max} for each. Output is the {fitted parameters, \
the SE, the SE in %, the standarddeviation of the residuals.}"
}], "Usage",
 CellChangeTimes->{{3.9951025249229527`*^9, 3.995102525459751*^9}},
 CellID->232521217,ExpressionUUID->"9b454f5e-1af8-7348-bdf1-f96fbe67c1fc"],

