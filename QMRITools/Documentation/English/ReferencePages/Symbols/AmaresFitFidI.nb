Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"217c5e77-7726-484a-814a-dc4f56b0e8d6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresFitFidI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresFitFidI"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["cons", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f8738095-4cef-5c4f-b1cb-a86f776ade7b"],
 "\[LineSeparator]fits the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "8be35927-e432-2549-af31-b5acff7a71bc"],
 " with using the ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "16a491e1-421e-e842-afb5-92b565f86e19"],
 " spectra. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"505f79dc-64ea-0e41-85d1-84032d610211"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresFitFidI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresFitFidI"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["cons", "TI"], ",", 
      StyleBox["init", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"d7931b00-8917-454a-a42e-3d24f0353d6a"],
 "\[LineSeparator]fits the ",
 Cell[BoxData[
  StyleBox["fid", "TI"]], "InlineFormula",ExpressionUUID->
  "3ffc3cd4-8099-6b48-b685-470248a0aa3b"],
 " using initial values init which can be obtained from a previous fit or \
from ",
 Cell[BoxData[
  ButtonBox["AmaresInitialValues",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/AmaresInitialValues"]], "InlineFormula",
  ExpressionUUID->"cf143e2b-df1e-d243-8434-920c646b77e4"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0bb1b74c-314d-6846-ae15-e5d3afd074ea"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresFitFidI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresFitFidI"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox[
      RowBox[{"1", "pars"}], "TI"]], ",", 
    StyleBox["cons", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "363df83e-593a-9c4d-a415-a19bbf4ddc16"],
 "\[LineSeparator]the ",
 Cell[BoxData[
  StyleBox["b1pars", "TI"]], "InlineFormula",ExpressionUUID->
  "cef788f7-b63e-0f49-8abe-cd906ad1a89b"],
 " are needed if in the ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "bb5ab994-172b-2640-b2ce-f2ab36ce5414"],
 " B1 correction is set ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "5af28dd8-5a34-4946-9e1b-e793c4fd9bdb"],
 ". The ",
 Cell[BoxData[
  StyleBox["b1pars", "TI"]], "InlineFormula",ExpressionUUID->
  "2df292aa-2ac9-db4e-98a8-d7cc2a420ba4"],
 " are defined as {tau, fa, TR} with tau and TR in ms and fa in degrees. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"09be6e1c-a42c-e449-956d-4adfa239f32c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresFitFidI",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresFitFidI"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox[
      RowBox[{"1", "pars"}], "TI"]], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["cons", "TI"], ",", 
      StyleBox["init", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"d8bb5797-09c0-3e46-81d7-a7491eba81db"],
 "\[LineSeparator]fits using initial values using ",
 Cell[BoxData[
  StyleBox["b1pars", "TI"]], "InlineFormula",ExpressionUUID->
  "43836c59-44a0-ae4d-9be2-7336310e515d"],
 " for B1 correction. The ",
 Cell[BoxData[
  StyleBox["time", "TI"]], "InlineFormula",ExpressionUUID->
  "fc3ff392-795a-6a4b-b5c9-f92ba8ca00ce"],
 ", ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "54b9ea08-cff7-fe4e-a8e7-ee271967bf6c"],
 " and ",
 Cell[BoxData[
  StyleBox["gyro", "TI"]], "InlineFormula",ExpressionUUID->
  "89871470-1515-874e-9c64-034a32b44005"],
 " can be obtained from ",
 Cell[BoxData[
  ButtonBox["AmaresBasis",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/AmaresBasis"]], "InlineFormula",
  ExpressionUUID->"284c8fb7-1ce0-0043-9116-1ac2c7664934"],
 " and the ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "a555ea91-4dc6-b347-90bc-70252053e834"],
 " can be obtained form EditMaresMatrix. The ",
 Cell[BoxData[
  StyleBox["cons", "TI"]], "InlineFormula",ExpressionUUID->
  "42106292-6408-764a-86ad-a8f3d69705e5"],
 " have to be defined for {\"amp\", \"sigma\", \"gamma\", \"shift\", \
\"phase\", \"B1\"} as {min, max} for each. Output is the {fitted parameters, \
the SE, the SE in %, the standard deviation of the residuals.}."
}], "Usage",
 CellChangeTimes->{{3.99665659461014*^9, 3.996656595190054*^9}},
 CellID->185922508,ExpressionUUID->"850224c4-5f52-e44a-b4b5-12f0812f7741"],

Cell["The following options can be given: ", "Notes",
 CellID->451832982,ExpressionUUID->"83999d3d-8f17-e64e-ac87-26bc7cb5d987"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1d2b939d-b461-2344-b8ff-847e36872921"], 
    ButtonBox["AmaresUseB1",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AmaresUseB1"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AmaresUseB1",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AmaresUseB1"]], "InlineFormula",
      ExpressionUUID->"43dd0c3a-c5bc-f740-9e25-f7b01ec682ca"],
     " is an option for ",
     Cell[BoxData[
     "AmaresFitFidI"], "InlineFormula",ExpressionUUID->
      "fb12b2a2-4f9c-ea47-9fe7-50ea485cd104"],
     ". When ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "81e73d28-e450-a741-8e5d-bd7d07714068"],
     ", the B1 value supplied through init is used to apply \nthe Ernst-angle \
amplitude correction even if the fitting matrix has \"B1\"->False for all \
metabolites \n(i.e. B1 is applied but not fitted). Default is False."
    }], "TableText",ExpressionUUID->"aec76134-2963-424d-88f5-c4104382ae17"]}
