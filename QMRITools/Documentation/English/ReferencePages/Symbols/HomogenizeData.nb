  RowBox[{
   ButtonBox["HomogenizeData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/HomogenizeData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "aad2dd98-e09e-7a4a-b04f-0f938a6c43b9"],
