Cell["GenerateBidsName", "ObjectName",
 CellID->612994597,ExpressionUUID->"633952f4-2249-0740-8d45-d629bf363d07"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"21d4afd2-eb77-3b43-ac76-b4253f959450"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateBidsName",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/GenerateBidsName"], "[", 
   StyleBox["parts", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "19b76424-cf9a-914a-b217-46c3efb45db0"],
 "\[LineSeparator]generates a Bids file name from the Bids labels association \
which can be generated by ",
 Cell[BoxData[
  ButtonBox["PartitionBidsName",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PartitionBidsName"]], "InlineFormula",
  ExpressionUUID->"e10b79b8-a313-184c-9b73-ec8d7d3865d7"],
 ". The labels are joined in the order {\"sub\",\"ses\",\"vol\",\"stk\",\"rep\
\",\"chunk\",\"acq\",\"part\",\"type\",\"suf\"}."
}], "Usage",
 CellChangeTimes->{4.003804526497465*^9},
