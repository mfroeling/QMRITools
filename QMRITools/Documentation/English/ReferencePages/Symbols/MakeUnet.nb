Notebook[{

Cell[CellGroupData[{
Cell["MakeUnet", "ObjectName",
 CellID->3079609,ExpressionUUID->"683debf2-8439-774b-8868-5780d8a16c11"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7a58aa86-7d8d-2447-8a5f-883e096e7265"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeUnet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/MakeUnet"], "[", 
   RowBox[{
    StyleBox["nClasses", "TI"], ",", 
    StyleBox["dimIn", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3019c641-9d4f-cc49-b705-9e1ba36ee777"],
 "\[LineSeparator]Generates a UNET with one channel as input and ",
 Cell[BoxData[
  StyleBox["nClasses", "TI"]], "InlineFormula",ExpressionUUID->
  "df188306-d43d-6a4e-a830-d22eb584071a"],
 " as output. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"23f8d637-08bb-bd4e-8fa0-6a00d757a059"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeUnet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/MakeUnet"], "[", 
   RowBox[{
    StyleBox["nChannels", "TI"], ",", 
    StyleBox["nClasses", "TI"], ",", 
    StyleBox["dimIn", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e8e4499f-5f95-0244-8ed0-2de91956d42a"],
 "\[LineSeparator]Generates a UNET with ",
 Cell[BoxData[
  StyleBox["nChannels", "TI"]], "InlineFormula",ExpressionUUID->
  "0df7f91b-8fa9-2040-aba3-34c548bfa78d"],
 " as input and ",
 Cell[BoxData[
  StyleBox["nClasses", "TI"]], "InlineFormula",ExpressionUUID->
  "9b078807-6e56-894f-86e8-80f22d579884"],
 " as output. The number of features of the first convolution layer is set \
with the FeatureSchedule option. The data dimensions can be 2D or 3D and each \
of the dimensions should be 16, 32, 48, 64, 80, 96, 112, 128, 144, 160, 176, \
192, 208, 224, 240 or 256. However dimensions can be different based on the \
network depth and the block type. The implemented block types are \"Conv\", \
\"UNet\", \"ResNet\", \"DenseNet\", \"Inception\", or \"U2Net\"."
}], "Usage",
 CellChangeTimes->{{3.9985332452153625`*^9, 3.9985332454355927`*^9}},
 CellID->41489275,ExpressionUUID->"8a05e200-57d6-d74e-8fe5-9c3a7d82cb22"],

Cell["The following options can be given: ", "Notes",
 CellID->462236442,ExpressionUUID->"6d2dfcb6-df09-8d4a-af4b-8dd55bed5f58"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "297e0906-d69a-484f-ab0b-b58f9a665e29"], 
    ButtonBox["NetworkArchitecture",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/NetworkArchitecture"], \
"\"\<UNet\>\"", Cell[TextData[{
     "NetworkArchitecture is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "56354430-e0c7-b948-b725-51fb2aae39a5"],
     ". It defines the architecture of the network. It can be \"UNet\", \
\"UNet+\", or \"UNet++\".\nFor \"UNet+\" or \"UNet++\" it can also be {arch, \
i} where i specifies how many of the top layers are connected to the mapping \
layer."
    }], "TableText",ExpressionUUID->"a203f2ab-6ae7-324c-a6ce-6d99fb2604f7"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "985af40f-d85b-ca45-9c25-0b42859d1a9e"], 
    ButtonBox["BlockType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/BlockType"], "\"\<ResNet\>\"", 
    Cell[TextData[{
     "BlockType is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "70b813c0-1681-c34d-a098-d3666616a3c9"],
     ". It specifies the type of block used in the network. It can be \
\"Conv\", \"UNet\", \"ResNet\", \"DenseNet\", \"Inception\", or \"U2Net\"."
    }], "TableText",ExpressionUUID->"d705c826-781a-a648-b15e-629f3a5e12b3"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4f0813bc-fe36-6643-8d09-827461517099"], 
    ButtonBox["ActivationType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/ActivationType"], "\"\<GELU\>\"",
     Cell[TextData[{
     "ActivationType is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "7efc3247-4218-0949-b6a9-a48c363b9089"],
     ". It specifies which activation layer is used in the network. It can be \
\"LeakyRELU\" or any type allowed \nby a \"name\" definition in \
ElementwiseLayer."
    }], "TableText",ExpressionUUID->"69db9e58-4fa6-a547-8811-1ba57c4f9604"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b6e39415-57db-4247-bc0e-116649a46a2e"], 
    ButtonBox["NormalizationType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/NormalizationType"], \
"\"\<Instance\>\"", Cell[TextData[{
     "NormalizationType is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "6bc5e076-5c0c-3349-b450-c78102e1596f"],
     ". It specifies which normalization layer is used in the network. It can \
be \"Batch\" or \"Instance\" for \neither BatchNormalization or \
NormalizationLayer which is instance normalization."
    }], "TableText",ExpressionUUID->"7fdfa864-c773-aa42-bd89-91163e8732f7"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b10a3528-82ca-1f4d-83c7-c87cafff454b"], 
    ButtonBox["RescaleMethod",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/RescaleMethod"], "\"\<Conv\>\"",
     Cell[TextData[{
     "RescaleMethod is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "9db2ca15-bdc0-e045-97b3-5fa98ea93c45"],
     ". It specifies how the network rescales. It can be \"Conv\" or \"Pool\"."
    }], "TableText",ExpressionUUID->"b93d7d28-a314-d244-9036-caa2e16b0a25"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5126652c-e17b-434a-8da2-556828d02b78"], 
    ButtonBox["CatenateMethod",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsNeuralNetworkTools/ref/CatenateMethod"], "\"\<Cat\>\"",
     Cell[TextData[{
     "CatenateMethod is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "55b295ce-e7fd-694e-824d-aaae48d30a33"],
     ". It specifies how the network catenates the skip and upscale channel. \
It can be \"Tot\", or \"Cat\"."
    }], "TableText",ExpressionUUID->"80554a2c-5a61-614a-9c96-175c986a50a2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e6bdce66-34e8-d246-bbca-d17667f50092"], 
    ButtonBox["NetworkDepth",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/NetworkDepth"], "5", 
    Cell[TextData[{
     "NetworkDepth is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "50193344-0d8f-d249-b82a-4fa79be585bf"],
     ". It specifies how deep the UNET will be."
    }], "TableText",ExpressionUUID->"20a0b86a-bf04-e24f-8ebe-1833215dffae"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "941a47d1-6633-e74c-8f84-897122ab5a26"], 
    ButtonBox["DownsampleSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/DownsampleSchedule"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     "DownsampleSchedule is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "1c9ef21e-98fd-f24e-99c2-9d4f56a7e883"],
     ". It defines how the data is downsampled for each of the deeper layers \
of the Unet. \nBy default is is a factor two for each layer. A custom \
schedule for a 5 layer 3D Unet could be {{2,2,2},{1,2,2},{2,2,2},{1,2,2}, 1}.\
\nThe deepest layer is always downsampled by 1 and therefore not needed to be \
specified."
    }], "TableText",ExpressionUUID->"24cd694c-8ce4-8447-98ca-bd2681562231"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "30e0dbe9-924d-c34b-8e75-0688eedb7213"], 
    ButtonBox["SettingSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SettingSchedule"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SettingSchedule",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SettingSchedule"]], "InlineFormula",
      ExpressionUUID->"8114f227-2bb5-484d-bbbe-6137232922c1"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "2f289591-0200-954d-82c1-f18ca64c53cc"],
     ". It defines the settings for the Unet blocks. If one setting is given \
it applied to all layers.\nIf a list of settings is given the settings can be \
different per layer. The following settings are the default settings. \n\
\"Unet\": convolution block repetitions, 2, \"ResNet\" -> convolution block \
repetitions, 2, \"DenseNet\" -> {dense depth, block repetitions}, {4,2},\n\
\"Inception\" -> {inception width, block repetitions}, {4,2}, \"U2Net\"-> \
{Unet depth, downscale}, {5, True}."
    }], "TableText",ExpressionUUID->"3453d26b-216b-7e46-a9e1-f44233019bf0"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b4e765d7-7b30-794b-9f29-cbe23ea99540"], 
    ButtonBox["FeatureSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/FeatureSchedule"], 
    "32", Cell[TextData[{
     "FeatureSchedule is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "0de7b9e9-e5d6-dc4f-9677-76bd60568017"],
     ". It defines how the number of features is up-sampled for each of the \
deeper layers of the Unet.\nBy default it increases the number of features by \
a factor 2 each layer, i.e. {1, 2, 4, 8, 16}."
    }], "TableText",ExpressionUUID->"7a1c03e9-d17c-fd46-b3ff-b5234fe5c4ea"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "015f436c-3fcb-cd4b-8d31-caf8c2616777"], 
    ButtonBox["DropoutRate",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/DropoutRate"], "0.2",
     Cell[TextData[{
     "DropoutRate is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "041d35bb-c017-8646-b3af-10364864358a"],
     ". It specifies how much dropout is used after each block. It is a value \
between 0 and 1, default is .2."
    }], "TableText",ExpressionUUID->"57ea0ea2-6f79-cb4f-b70f-10250557b995"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ca92eaac-73e2-8645-a999-f2f3cb71172e"], 
    ButtonBox["Monitor",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Monitor", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["mon", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
      "698e1b71-5f6b-2048-9485-3bd443f95431"],
     " generates a temporary monitor cell in which the continually updated \
current value of ",
     Cell[BoxData[
      StyleBox["mon", "TI"]], "InlineFormula",ExpressionUUID->
      "09c7523e-6a2a-9348-b188-4258f4527b24"],
     " is displayed during the course of evaluation of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "e6fe54a7-9cf4-cf45-8043-f138e015eb3d"],
     ". "
    }], "TableText",ExpressionUUID->"15414216-ddfa-0d45-b4dc-ea238613c4ea"]}
  }]], "3ColumnTableMod",
 CellID->63616353,ExpressionUUID->"5eb2fb21-91ab-b44a-8828-45e8414b1303"]
}, Open  ]],

