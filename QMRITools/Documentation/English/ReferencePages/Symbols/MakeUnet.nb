Notebook[{

Cell[CellGroupData[{
Cell["MakeUnet", "ObjectName",
 CellID->911568154,ExpressionUUID->"e8dc34b9-d54c-4b43-b78f-32585eaa4385"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"68b4c63c-856f-3e43-9820-850acc2d5f93"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeUnet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/MakeUnet"], "[", 
   RowBox[{
    StyleBox["nClasses", "TI"], ",", 
    StyleBox["dimIn", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "93d40984-ed66-af46-a044-bbda0d48437c"],
 "\[LineSeparator]Generates a UNET with one channel as input and ",
 Cell[BoxData[
  StyleBox["nClasses", "TI"]], "InlineFormula",ExpressionUUID->
  "65f47d42-fb24-a043-9497-f81cf473ac74"],
 " as output. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c3453c32-3184-c043-a70b-2861606fcfc4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeUnet",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/MakeUnet"], "[", 
   RowBox[{
    StyleBox["nChannels", "TI"], ",", 
    StyleBox["nClasses", "TI"], ",", 
    StyleBox["dimIn", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0c892ed1-c8a8-5c46-b338-0b02f7e9de12"],
 "\[LineSeparator]Generates a UNET with ",
 Cell[BoxData[
  StyleBox["nChannels", "TI"]], "InlineFormula",ExpressionUUID->
  "08d83577-6a30-5847-b694-38cbd75ad293"],
 " as input and ",
 Cell[BoxData[
  StyleBox["nClasses", "TI"]], "InlineFormula",ExpressionUUID->
  "50777565-ef82-9f46-b8a1-5a5a6d6a9612"],
 " as output. he number of parameter of the first convolution layer can be \
set with dep. The data dimensions can be 2D or 3D and each of the dimensions \
should be 16, 32, 48, 64, 80, 96, 112, 128, 144, 160, 176, 192, 208, 224, 240 \
or 256. However dimensions can be different based on the network depth and \
the block type. The implemented block types are \"Conv\", \"UNet\", \
\"ResNet\", \"DenseNet\", \"Inception\", or \"U2Net\"."
}], "Usage",
 CellChangeTimes->{{3.996656831508127*^9, 3.996656831660904*^9}},
 CellID->569702931,ExpressionUUID->"e0e3eaab-781b-0b42-b264-5e223ddb89bd"],

Cell["The following options can be given: ", "Notes",
 CellID->66068706,ExpressionUUID->"693a88c6-7bc7-1049-aa38-ba4fee2938a7"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ad5ff3b2-1376-3747-a13d-6f9fce4cfb9d"], 
    ButtonBox["NetworkArchitecture",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NetworkArchitecture"], "\"\<UNet\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["NetworkArchitecture",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NetworkArchitecture"]], 
      "InlineFormula",ExpressionUUID->"59865b41-b049-5546-b656-9f064c8681c5"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "2239c4e4-8ff9-7e48-ba8e-f4098be13c9d"],
     ". It defines the architecture of the network. It can be \"UNet\", \
\"UNet+\", or \"UNet++\".\nFor \"UNet+\" or \"UNet++\" it can also be {arch, \
i} where i specifies how many of the top layers are connected to the mapping \
layer."
    }], "TableText",ExpressionUUID->"749afdf6-6906-d042-95e7-5357316ab7cc"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d352bec8-622a-9e44-b362-e34f8f77507d"], 
    ButtonBox["BlockType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/BlockType"], "\"\<ResNet\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["BlockType",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/BlockType"]], "InlineFormula",
      ExpressionUUID->"9a03fbaf-557c-324f-8bd5-3f04de419263"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "13df753c-a101-3145-ae3a-99ef893f636e"],
     ". It specifies the type of block used in the network. It can be \
\"Conv\", \"UNet\", \"ResNet\", \"DenseNet\", \"Inception\", or \"U2Net\"."
    }], "TableText",ExpressionUUID->"d21dc7a0-3af4-9144-b34e-aa788b115cb1"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6cab461b-1940-6748-93b4-078b10b7d3bd"], 
    ButtonBox["ActivationType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/ActivationType"], "\"\<GELU\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["ActivationType",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ActivationType"]], "InlineFormula",
      ExpressionUUID->"4a165dec-bca1-8744-a5ea-7cf0d9e38a0b"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "21b86dff-121e-d84f-be8f-520323675c20"],
     ". It specifies which activation layer is used in the network. It can be \
\"LeakyRELU\" or any type allowed \nby a \"name\" definition in \
ElementwiseLayer."
    }], "TableText",ExpressionUUID->"5954b0b5-46ff-3449-93a2-0a374e8d06c4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "08fc1b63-69b0-2f4a-8659-432b3b012238"], 
    ButtonBox["NormalizationType",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NormalizationType"], "\"\<Instance\>\"",
     Cell[TextData[{
     Cell[BoxData[
      ButtonBox["NormalizationType",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NormalizationType"]], 
      "InlineFormula",ExpressionUUID->"d558a8b9-dca7-6948-9b51-6e8a8eadd099"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "a76a7588-c31a-834c-b675-16455a8f9cc0"],
     ". It specifies which normalization layer is used in the network. It can \
be \"Batch\" or \"Instance\" for \neither BatchNormalization or \
NormalizationLayer which is instance normalization."
    }], "TableText",ExpressionUUID->"f5559fce-60c2-7e4e-afdb-b13ec34ba016"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "34493c31-34f8-3c46-a8f9-b02719d5d06e"], 
    ButtonBox["RescaleMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/RescaleMethod"], "\"\<Conv\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["RescaleMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RescaleMethod"]], "InlineFormula",
      ExpressionUUID->"7f35d456-83ea-644d-b7a1-242f78603ee5"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "a7c74b18-4858-b142-9080-4e8aaf62bc06"],
     ". It specifies how the network rescales. It can be \"Conv\" or \"Pool\"."
    }], "TableText",ExpressionUUID->"7629a10d-d532-094a-a990-7b8e4ae2f873"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ca11aed6-afe6-6241-a9f0-0a202afc1f0f"], 
    ButtonBox["CatenateMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/CatenateMethod"], "\"\<Cat\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["CatenateMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CatenateMethod"]], "InlineFormula",
      ExpressionUUID->"2803c545-9cf2-bc4c-a719-715b97d0355e"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "327743e9-7760-6e41-94c8-2e6d82195395"],
     ". It specifies how the network catenates the skip and upscale channel. \
It can be \"Tot\", or \"Cat\"."
    }], "TableText",ExpressionUUID->"597902e1-5198-2a46-b36e-12c36bee6c39"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "721d1d60-10ac-df43-9ac2-adc8548422ad"], 
    ButtonBox["NetworkDepth",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NetworkDepth"], "5", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["NetworkDepth",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NetworkDepth"]], "InlineFormula",
      ExpressionUUID->"f10a1d96-13ad-2740-a2c2-1ae233dd04d1"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "4f377771-bc4e-bc42-8980-41087ff09b90"],
     ". It specifies how deep the UNET will be."
    }], "TableText",ExpressionUUID->"8cc8e136-06e6-c04e-b8f6-71ee50a23de0"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e508c5af-7467-8643-a83c-59d65a22a635"], 
    ButtonBox["DownsampleSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DownsampleSchedule"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["DownsampleSchedule",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DownsampleSchedule"]], 
      "InlineFormula",ExpressionUUID->"eb0deba7-bee1-2f42-996b-5c47c11b2dc9"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "c3866bbd-a8cc-aa4b-909a-e370abafc3e0"],
     ". It defines how the data is downsampled for each of the deeper layers \
of the Unet. \nBy default is is a factor two for each layer. A custom \
schedule for a 5 layer 3D Unet could be {{2,2,2},{1,2,2},{2,2,2},{1,2,2}, 1}.\
\nThe deepest layer is always downsampled by 1 and therefore not needed to be \
specified."
    }], "TableText",ExpressionUUID->"193070c7-662d-7247-8ef4-fab5352036b9"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "26f7ad2e-458f-b940-b54d-a48a288da9c6"], 
    ButtonBox["SettingSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SettingSchedule"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SettingSchedule",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SettingSchedule"]], "InlineFormula",
      ExpressionUUID->"262ade09-70b0-ec43-837f-0cd0cc669c88"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "e374ff82-cbdc-6b47-82b9-a2ac04de529a"],
     ". It defines the settings for the Unet blocks. If one setting is given \
it applied to all layers.\nIf a list of settings is given the settings can be \
different per layer. The following settings are the default settings. \n\
\"Unet\": convolution block repetitions, 2, \"ResNet\" -> convolution block \
repetitions, 2, \"DenseNet\" -> {dense depth, block repetitions}, {4,2},\n\
\"Inception\" -> {inception width, block repetitions}, {4,2}, \"U2Net\"-> \
{Unet depth, downscale}, {5, True}."
    }], "TableText",ExpressionUUID->"71484601-3d1d-6a44-92bb-68c31ab77e6c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "cf315607-8c94-8548-9233-bd90666bce69"], 
    ButtonBox["FeatureSchedule",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/FeatureSchedule"], "32", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["FeatureSchedule",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/FeatureSchedule"]], "InlineFormula",
      ExpressionUUID->"5a6eb1b9-80d9-cf44-9074-8481c13baf94"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "7de21051-73f6-fb4b-87e0-c82a53445bff"],
     ". It defines how the number of features is up-sampled for each of the \
deeper layers of the Unet.\nBy default it increases the number of features by \
a factor 2 each layer, i.e. {1, 2, 4, 8, 16}."
    }], "TableText",ExpressionUUID->"c15f26d7-7249-1c4b-83d1-af18e563e89d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "596a4ef6-49f0-3546-a1ea-c58e705e9234"], 
    ButtonBox["DropoutRate",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DropoutRate"], "0.2", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["DropoutRate",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DropoutRate"]], "InlineFormula",
      ExpressionUUID->"dece8df1-89bd-6b4b-b4d8-9359d4cc92c3"],
     " is an option for ",
     Cell[BoxData[
     "MakeUnet"], "InlineFormula",ExpressionUUID->
      "e42fbd24-ab26-904d-b240-43b5357a8559"],
     ". It specifies how much dropout is used after each block. It is a value \
between 0 and 1, default is .2."
    }], "TableText",ExpressionUUID->"5a651683-acfe-ed40-afad-66dde7f52291"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "346fc9c6-3d92-5b46-8b24-1c30554eb64d"], 
    ButtonBox["MonitorCalc",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MonitorCalc"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["MonitorCalc",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MonitorCalc"]], "InlineFormula",
      ExpressionUUID->"bea2f540-2dda-ff41-86e2-5444dd072ae6"],
     " is an option for many processing functions. When true the process of \
the calculation is shown."
    }], "TableText",ExpressionUUID->"6ef6ec78-232b-6245-9367-52e142043caf"]}
  }]], "3ColumnTableMod",
 CellID->228234445,ExpressionUUID->"8fbaf513-bfd7-004d-acc9-d7fd25ee13bf"]
