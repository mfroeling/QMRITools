Notebook[{

Cell[CellGroupData[{
Cell["FinalGrads", "ObjectName",
 CellID->435249113,ExpressionUUID->"762a8700-02e1-944e-a181-fcecbd38850f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ca8bfc74-9f33-9340-a4b9-04205cde3a57"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FinalGrads",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/FinalGrads"], "[", 
   RowBox[{
    StyleBox["grtxt", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["int", "TI"], ",", 
      StyleBox["intn", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rand", "TI"], ",", 
      StyleBox["order", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"4ba530d8-26ed-3147-9952-d39695fa9b1e"],
 "\[LineSeparator]finalizes the gradient txt file. ",
 Cell[BoxData[
  StyleBox["grtxt", "TI"]], "InlineFormula",ExpressionUUID->
  "d1b6f725-3afa-ac47-982e-e75d44df5cea"],
 " is the output from the function ",
 Cell[BoxData[
  ButtonBox["ConvertGrads",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ConvertGrads"]], "InlineFormula",
  ExpressionUUID->"6ac78a12-a295-9e46-b941-5ddeb5701844"],
 ", which convert the grad to txt format. int is ",
 Cell[BoxData[
  ButtonBox[
   ButtonBox["True",
    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "c90058e7-9e0e-834f-b9ff-518d14870314"],
 " or False, if set to True it interleaves b=0 gradients every intn \
directions. rand indicates if the gradients need to be randomized, for this \
it uses the order which is the output of ",
 Cell[BoxData[
  ButtonBox["FindOrder",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/FindOrder"]], "InlineFormula",
  ExpressionUUID->"7fada026-d424-7549-b205-5dffdf6cc594"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9966567468263206`*^9, 3.9966567469146137`*^9}},
 CellID->6636581,ExpressionUUID->"0fbfb142-2520-404e-a0d8-c81da4a9dd76"],

