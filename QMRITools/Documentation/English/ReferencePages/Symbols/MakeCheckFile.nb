Notebook[{

Cell[CellGroupData[{
Cell["MakeCheckFile", "ObjectName",
 CellID->159911071,ExpressionUUID->"b5cc333b-092b-d747-ac28-85be2cae7a3b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a3905d04-1263-804b-9c11-2f6b25918ce8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeCheckFile",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsLoggingTools/ref/MakeCheckFile"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["fol", "TI"], ",", 
      StyleBox["name", "TI"], ",", 
      StyleBox["tag", "TI"]}], "}"}], ",", 
    StyleBox["stat", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "34cec8be-078d-8a4b-99ef-64eab02ebb0b"],
 "\[LineSeparator]makes a check json file in the fol with filename containing \
",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",ExpressionUUID->
  "48e7b7fa-2c1b-1b47-8402-14ecef4b164d"],
 " and tag. Where ",
 Cell[BoxData[
  StyleBox["stat", "TI"]], "InlineFormula",ExpressionUUID->
  "5c9c79b6-d522-1d43-8b4c-0a014b97fc10"],
 " is a list of rules that contain any information that needs to be put in \
the check file."
}], "Usage",
 CellChangeTimes->{{3.996656396989559*^9, 3.99665639704974*^9}},
 CellID->327170381,ExpressionUUID->"d3671233-911a-764c-90dc-933401097ebb"],

