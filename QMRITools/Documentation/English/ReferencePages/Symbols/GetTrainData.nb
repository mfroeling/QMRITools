Notebook[{

Cell[CellGroupData[{
Cell["GetTrainData", "ObjectName",
 CellID->112316430,ExpressionUUID->"2d37f1f5-42f6-af45-8a89-7fd9b2039c7e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c9baf119-6702-cb47-983b-eea73b8352ef"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetTrainData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetTrainData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{
     StyleBox["batch", "TI"], " ", 
     StyleBox["size", "TI"]}], ",", 
    StyleBox["patch", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "683a6f54-5ea6-e244-b76a-90113fa1ca67"],
 "\[LineSeparator]creates a training batch of size batch size with patch size \
patch. The input data can be out of memory in the form of a list of \"*wxf\" \
files that contain the data, segmentation and voxel size or a list of \"*.nii\
\" files in the form {{\"data.nii\", \"segmentation.nii\"}..}. The input data \
can be in memory in a list in the form {{data, segmentation, vox}..} \n",
 Cell["   ", "ModInfo",ExpressionUUID->"b1310088-e59b-f244-92bc-92b35f267f38"],
 "GetTrainData[data,",
 Cell[BoxData[
  StyleBox[
   RowBox[{"batch", " ", "size"}], "TI"]], "InlineFormula",ExpressionUUID->
  "ee88e818-f2a9-7148-8824-933feb1f38c1"],
 ",patch,nClass]\[LineSeparator]If nClass is set to an value n > 0 the \
segmentations are decoded in n classes. If ",
 Cell[BoxData[
  RowBox[{"MaskedPretraining", "->", 
   ButtonBox["True",
    BaseStyle->"Link"]}]], "InlineFormula",ExpressionUUID->
  "d415f1a4-82d9-ad47-a66e-4a22a6778cab"],
 " the target becomes the clean ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "df17cd71-1895-3245-8aff-332abdcfac97"],
 " itself and the input is masked with noise filled blocks, for self \
supervised pretraining."
}], "Usage",
 CellChangeTimes->{{3.998533228655033*^9, 3.9985332287948647`*^9}},
 CellID->516606319,ExpressionUUID->"2809b5b5-5c75-d84f-b59f-9ff5e73796aa"],

Cell["The following options can be given: ", "Notes",
 CellID->977702064,ExpressionUUID->"fcc719f5-546b-1641-9e67-611445d63141"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d0e0adc6-2c7b-884d-b0fe-921ae3e0036b"], 
    ButtonBox["PatchesPerSet",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PatchesPerSet"], "1", 
    Cell[TextData[{
     "PatchesPerSet is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "783611d1-7ca9-1f41-ba3f-278d42bb802c"],
     ". Defines how many random patches per dataset are created within the \
batch."
    }], "TableText",ExpressionUUID->"0ed2bd2d-6b25-a64e-89c6-cc80ed07fc41"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "50f7a380-45f4-d042-977b-2eb30055beda"], 
    ButtonBox["AugmentData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentData"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "AugmentData is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "d2e439d1-40e6-ae40-b198-d8677fb0fa3f"],
     " and ",
     Cell[BoxData[
      ButtonBox["TrainSegmentationNetwork",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
      "InlineFormula",ExpressionUUID->"100a87a3-fc05-bb44-a24a-3f0a98ccec43"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "4e3ce78a-060e-e144-a218-38b05cb1fc4d"],
     " the training data is augmented.\nIt can also be set to \"2D\" or \
\"3D\" to control if augmentation is done through plane or only in-plane."
    }], "TableText",ExpressionUUID->"693dc0c4-bdbe-de47-9007-c0d573fc8b30"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c050a8b1-29e5-ea4e-b6f8-abf8494edc31"], 
    ButtonBox["PadData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PadData"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "PadData is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "d303141c-4f71-1e4f-8bd6-53f260a87e08"],
     " and ",
     Cell[BoxData[
      ButtonBox["TrainSegmentationNetwork",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
      "InlineFormula",ExpressionUUID->"cebc5da0-42c7-f84d-b96c-43d55f74e557"],
     ".. If set to an integers the that number of slices on the top and \
bottom of the\ndata can be made 0. This is done to learn cut of datasets."
    }], "TableText",ExpressionUUID->"bf1378b7-43a6-de4d-8c98-9a5001da83b2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d4cad572-46f1-9d48-b713-460dcfbaa202"], 
    ButtonBox["MaskedPretraining",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MaskedPretraining"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["Mask",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Mask"]], "InlineFormula",
      ExpressionUUID->"23c626f8-ab0f-0e4f-94df-9930cb42416e"],
     "edPretraining is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "a6ad733a-4286-584c-8a86-58d931c6475b"],
     " and ",
     Cell[BoxData[
      ButtonBox["TrainSegmentationNetwork",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
      "InlineFormula",ExpressionUUID->"1a26e2cc-6239-1a4a-b311-62eae5cfc81b"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "9314a6eb-7dad-e74c-b632-53501ec46099"],
     " self supervised masked-pretraining data/mode is used instead\nof \
segmentation data: the target becomes the clean data itself and the input is \
masked with noise filled blocks."
    }], "TableText",ExpressionUUID->"0ecb36b2-0b98-6d4e-b084-6085d873d168"]}
  }]], "3ColumnTableMod",
 CellID->250151809,ExpressionUUID->"a18d97d9-17a4-264f-9abd-7096c92f4523"]
}, Open  ]],

