Notebook[{

Cell[CellGroupData[{
Cell["GetTrainData", "ObjectName",
 CellID->225834975,ExpressionUUID->"558255ec-b1a7-ec42-a58d-64fe3796954e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fe6be8c2-34ac-6a44-9783-c7ae1d2ce062"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetTrainData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetTrainData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{
     StyleBox["batch", "TI"], " ", 
     StyleBox["size", "TI"]}], ",", 
    StyleBox["patch", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "39b40000-764a-1841-b530-91fc8cc38d7e"],
 "\[LineSeparator]creates a training batch of size batch size with patch size \
patch. The input data can be out of memory in the form of a list of \"*wxf\" \
files that contain the data, segmentation and voxel size or a list of \"*.nii\
\" files in the form {{\"data.nii\", \"segmentation.nii\"}..}. The input data \
can be in memory in a list in the form {{data, segmentation, vox}..} \n",
 Cell["   ", "ModInfo",ExpressionUUID->"40927c56-5a05-2e48-96cb-7cebea912db9"],
 "GetTrainData[data,",
 Cell[BoxData[
  StyleBox[
   RowBox[{"batch", " ", "size"}], "TI"]], "InlineFormula",ExpressionUUID->
  "602d5d9f-25a8-984f-a79b-53e07777e109"],
 ",patch,nClass]\[LineSeparator]If nClass is set to an value n > 0 the \
segmentations are decoded in n classes."
}], "Usage",
 CellChangeTimes->{{3.9966566300401*^9, 3.996656630131201*^9}},
 CellID->304316883,ExpressionUUID->"2be87394-98b9-cd4d-be1f-f0f26ac006c6"],

Cell["The following options can be given: ", "Notes",
 CellID->415193538,ExpressionUUID->"488a124c-246c-a344-8567-4a10e0a721f4"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c57b55ab-7e9c-8346-9f65-cb911218e5b7"], 
    ButtonBox["PatchesPerSet",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PatchesPerSet"], "1", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PatchesPerSet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PatchesPerSet"]], "InlineFormula",
      ExpressionUUID->"594d5a77-23a5-1e4f-8552-0977b0056751"],
     " is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "1c21a0a9-5b8a-d343-b347-4d69f49e961e"],
     ". Defines how many random patches per dataset are created within the \
batch."
    }], "TableText",ExpressionUUID->"0f0c3a07-be8d-8c4b-bf14-92956af066ad"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d426bd46-0bf7-d04c-b786-ad8f9f38dac8"], 
    ButtonBox["AugmentData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AugmentData"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AugmentData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AugmentData"]], "InlineFormula",
      ExpressionUUID->"a8796ec0-47f9-2245-9215-a378dfeb7b07"],
     " is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "892bae00-eab7-8f45-9edb-43763b1c57c3"],
     " and ",
     Cell[BoxData[
      ButtonBox["TrainSegmentationNetwork",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
      "InlineFormula",ExpressionUUID->"b45786a0-f77b-4f42-80ae-f99f3c665909"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "751e1564-1cc0-3a4c-89ea-5836519b7de2"],
     " the training data is augmented.\nIt can also be set to \"2D\" or \
\"3D\" to control if augmentation is done through plane or only in-plane."
    }], "TableText",ExpressionUUID->"ce967d50-4ff6-ff4d-90f6-62af2c1d5e11"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "cbaa85ad-760a-9b4a-996b-453433cf7938"], 
    ButtonBox["PadData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/PadData"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["PadData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/PadData"]], "InlineFormula",
      ExpressionUUID->"cc4ffe6f-120f-074a-bd09-0827da9da1f6"],
     " is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "8fd5c4c4-8d6c-c34a-865f-927a01b54a4b"],
     " and ",
     Cell[BoxData[
      ButtonBox["TrainSegmentationNetwork",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
      "InlineFormula",ExpressionUUID->"c61abd51-1b16-9e42-9b38-fe4588126edb"],
     ".. If set to an integers the that number of slices on the top and \
bottom of the \ndata can be made 0. This is done to learn cut of datasets."
    }], "TableText",ExpressionUUID->"343d503a-b75a-8a44-9791-556092bc985d"]}
  }]], "3ColumnTableMod",
 CellID->62302792,ExpressionUUID->"a6f9f9db-a1b9-3d4f-92c9-b54f3d297664"]
}, Open  ]],

