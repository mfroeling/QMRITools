Notebook[{

Cell[CellGroupData[{
Cell["GetTrainData", "ObjectName",
 CellID->43752283,ExpressionUUID->"ba5db40c-278d-e64a-9bb1-eb1ef5093fcb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d0805cb7-74a5-db40-861b-33b75528fd13"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GetTrainData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/GetTrainData"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    RowBox[{
     StyleBox["batch", "TI"], " ", 
     StyleBox["size", "TI"]}], ",", 
    StyleBox["patch", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ed1afce4-9e37-9d48-9ca7-adb605e43cf1"],
 "\[LineSeparator]creates a training batch of size batch size with patch size \
patch. The input data can be out of memory in the form of a list of \"*wxf\" \
files that contain the data, segmentation and voxel size or a list of \"*.nii\
\" files in the form {{\"data.nii\", \"segmentation.nii\"}..}. The input data \
can be in memory in a list in the form {{data, segmentation, vox}..} \n",
 Cell["   ", "ModInfo",ExpressionUUID->"57f9fc4f-f1e1-2d40-a726-ff4ebe7a03a9"],
 "GetTrainData[data,",
 Cell[BoxData[
  StyleBox[
   RowBox[{"batch", " ", "size"}], "TI"]], "InlineFormula",ExpressionUUID->
  "6bd5147b-8d81-e746-8339-11347783db30"],
 ",patch,nClass]\[LineSeparator]If nClass is set to an value n > 0 the \
segmentations are decoded in n classes. If ",
 Cell[BoxData[
  RowBox[{"MaskedPretraining", "->", 
   ButtonBox["True",
    BaseStyle->"Link"]}]], "InlineFormula",ExpressionUUID->
  "4590864e-a0d0-a249-98f3-45457aa9884b"],
 " the target becomes the clean ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "bd3b2443-88d3-7545-91d2-f3484413e07f"],
 " itself and the input is masked with noise filled blocks, for self \
supervised pretraining."
}], "Usage",
 CellChangeTimes->{{4.0038045332206993`*^9, 4.0038045333539543`*^9}},
 CellID->420379539,ExpressionUUID->"5cef9a61-bebd-ee41-a687-c4e10cfd1b09"],

Cell["The following options can be given: ", "Notes",
 CellID->114957890,ExpressionUUID->"9662ee83-8a03-e64c-ba9b-e773b182d127"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c160bd86-7dc8-b24e-a739-4f2295a91691"], 
    ButtonBox["PatchesPerSet",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PatchesPerSet"], "1", 
    Cell[TextData[{
     "PatchesPerSet is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "52b12d56-ce5d-9648-9212-8ebafd230131"],
     ". Defines how many random patches per dataset are created within the \
batch."
    }], "TableText",ExpressionUUID->"143b4b16-3587-384e-8aba-2bd856e101d7"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1563b7f7-9b69-394e-92d9-b00935f00cf3"], 
    ButtonBox["AugmentData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentData"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     "AugmentData is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "c1e48dc3-91de-7747-b1ee-c433537b2b69"],
     " and ",
     Cell[BoxData[
      ButtonBox["TrainSegmentationNetwork",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
      "InlineFormula",ExpressionUUID->"88ab033e-e26a-2342-8a1d-94119eb65c89"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "7e2c60bd-71d9-cc4a-b4f8-e2dbe4f11e03"],
     " the training data is augmented.\nIt can also be set to \"2D\" or \
\"3D\" to control if augmentation is done through plane or only in-plane."
    }], "TableText",ExpressionUUID->"ae298c7f-f7ef-cf41-ba0c-947f82bcc615"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "23b26149-23b5-5744-9b6b-3c519c7250bb"], 
    ButtonBox["PadData",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PadData"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "PadData is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "bf37abec-45f2-0849-84ba-0729e9c2ce39"],
     " and ",
     Cell[BoxData[
      ButtonBox["TrainSegmentationNetwork",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
      "InlineFormula",ExpressionUUID->"78597a44-f8ea-a44c-b789-99513256bbba"],
     ".. If set to an integers the that number of slices on the top and \
bottom of the\ndata can be made 0. This is done to learn cut of datasets."
    }], "TableText",ExpressionUUID->"f44d9bce-1090-c047-9a1d-ccee9b5d282c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "abddfccc-b109-6346-bc4e-7caa1b737ead"], 
    ButtonBox["MaskedPretraining",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MaskedPretraining"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["Mask",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Mask"]], "InlineFormula",
      ExpressionUUID->"1e934bd6-d084-c745-8b43-2fcbec9d55cb"],
     "edPretraining is an option for ",
     Cell[BoxData[
     "GetTrainData"], "InlineFormula",ExpressionUUID->
      "a44a30a0-3d9a-8447-b197-8ac3bd4d4f55"],
     " and ",
     Cell[BoxData[
      ButtonBox["TrainSegmentationNetwork",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
      "InlineFormula",ExpressionUUID->"cc33ed1a-8dc5-314c-9e14-6072c907d895"],
     ". If set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "eeffb484-3295-1e4d-8d2c-2ec50f270944"],
     " self supervised masked-pretraining data/mode is used instead\nof \
segmentation data: the target becomes the clean data itself and the input is \
masked with noise filled blocks."
    }], "TableText",ExpressionUUID->"12c8f8bd-f6c7-944c-a40d-010bb5f2173d"]}
  }]], "3ColumnTableMod",
 CellID->1846164,ExpressionUUID->"0df3e82b-039a-1441-8a03-ef625de44d27"]
}, Open  ]],

