Notebook[{

Cell[CellGroupData[{
Cell["CompareSegmentations", "ObjectName",
 CellID->770313339,ExpressionUUID->"9912552b-6836-a04e-a75f-0d6bd06086af"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"04034e3a-50f3-dd4e-b7c9-8992a5cfb125"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompareSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/CompareSegmentations"],
    "[", 
   RowBox[{
    StyleBox["ref", "TI"], ",", 
    StyleBox["pred", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "03736969-815a-2840-aa5c-0dab27bcb944"],
 "\[LineSeparator]compares the segmentations ",
 Cell[BoxData[
  StyleBox["ref", "TI"]], "InlineFormula",ExpressionUUID->
  "0c8611df-f28f-6a4b-a39b-7cdb857f2937"],
 " and ",
 Cell[BoxData[
  StyleBox["pred", "TI"]], "InlineFormula",ExpressionUUID->
  "f335b927-6674-9d49-ad82-0d04a8be85d5"],
 " for all labels that are present in both, using the voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "0b6e5940-c061-0641-ac33-1eb020a9f64a"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f74cbae4-3da1-2548-b709-88a244108291"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompareSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/CompareSegmentations"],
    "[", 
   RowBox[{
    StyleBox["ref", "TI"], ",", 
    StyleBox["pred", "TI"], ",", 
    StyleBox["labs", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "516d5819-cf2c-ef4c-94ee-fe4b3eecb5fa"],
 "\[LineSeparator]compares only the labels ",
 Cell[BoxData[
  StyleBox["labs", "TI"]], "InlineFormula",ExpressionUUID->
  "86882886-aef2-c649-847d-6e1561bf6904"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"5ca16ec0-7443-6544-abf6-a7a4e32a21d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CompareSegmentations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/CompareSegmentations"],
    "[", 
   RowBox[{
    StyleBox["segs", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e70bc0a1-d51a-6442-9abe-b783b5928be4"],
 "\[LineSeparator]with ",
 Cell[BoxData[
  StyleBox["segs", "TI"]], "InlineFormula",ExpressionUUID->
  "f0ebf4ac-e3d6-a145-bb08-ed3e9b6ece54"],
 " an association of named segmentations compares every pair of segmentations \
for the labels present in all of them. The output is a Dataset with a row per \
label and a column per measure, for the association input it is an \
association with an entry \"name1 vs name2\" per pair. The measures are set \
with the Method option, which can be \"Dice\", \"Jaccard\" or any method of \
SurfaceDistance (\"Mean\", \"Median\", \"RMS\", \"HD\", \"HD95\", \"Std\"), \
or a list of these."
}], "Usage",
 CellChangeTimes->{{4.001136803656048*^9, 4.001136803982216*^9}},
 CellID->45493825,ExpressionUUID->"5b92999c-c7d8-2041-ad20-d351a4d0eaa3"],

Cell["The following options can be given: ", "Notes",
 CellID->361234880,ExpressionUUID->"d4b18aa7-b7d0-a04f-ae06-8bf1754c4de5"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a4919a86-e747-1f42-9e55-4133992e56b7"], 
    ButtonBox["Method",
     BaseStyle->"Link"], 
    RowBox[{"{", 
     RowBox[{"Dice", ",", " ", "HD95"}], "}"}], Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"60002223-adf8-b641-96a3-9c9a412a34e1"]}
  }]], "3ColumnTableMod",
 CellID->415448295,ExpressionUUID->"4016eb02-ac6e-a046-aeb0-e6e44dd2ec15"]
}, Open  ]],

