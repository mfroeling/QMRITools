Notebook[{

Cell[CellGroupData[{
Cell["UseParallelKernels", "ObjectName",
 CellID->229838609,ExpressionUUID->"feefd122-dd22-ae40-bd9a-3a8ac5ef0c5a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3f1e6101-01be-7c47-a0f4-dd2b26963bf9"],
 Cell[BoxData[
 "UseParallelKernels"], "InlineFormula",ExpressionUUID->
  "6297a125-f734-4e4d-b807-42bf98de7679"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["TrainSegmentationNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
  "InlineFormula",ExpressionUUID->"e004703f-a2b4-1749-8101-fc62cdc47351"],
 ". If set to ",
 Cell[BoxData[
  ButtonBox[
   ButtonBox["True",
    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "388d98a9-3be5-744c-9889-4aea617a963c"],
 " (default), producer kernels are launched as raw WSTP links, data loading \
and batch augmentation run on these separate kernels while NetTrain runs \
concurrently on its own kernel, which can substantially speed up training \
when augmentation is the bottleneck. If set to \"Parallel\", the older \
shared-queue Parallel-framework kernel pool is used instead. If set to {True, \
n} or {\"Parallel\", n} at most n producer kernels are used, useful for \
debugging on a small scale. If set to False batches are generated in-process."
}], "Usage",
 CellChangeTimes->{{3.998533297380928*^9, 3.9985332973926525`*^9}},
 CellID->4325876,ExpressionUUID->"0c3ffccf-c990-5548-b230-9a4f30b4aeb5"],

Cell["XXXX", "Notes",
 CellID->665688701,ExpressionUUID->"c3fdf5ec-d95f-2549-95f0-1d49b730a78c"]
}, Open  ]],

