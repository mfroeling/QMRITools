Notebook[{

Cell[CellGroupData[{
Cell["UseParallelKernels", "ObjectName",
 CellID->69789114,ExpressionUUID->"66d89f50-d38d-ed4c-9716-166e3383d141"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2a14029e-eca9-bf46-9fd6-f3e1f4e70cfd"],
 Cell[BoxData[
 "UseParallelKernels"], "InlineFormula",ExpressionUUID->
  "8d70fe9a-9eb6-8e4e-ae34-3f8a179b9c1b"],
 "\[LineSeparator]is an option for TrainSegmentationNetwork. If set to ",
 Cell[BoxData[
  ButtonBox[
   ButtonBox["True",
    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "09923329-ddbe-9140-948e-c13b2e866b2c"],
 ", data loading and batch augmentation run on separate parallel kernels \
while NetTrain runs concurrently on its own kernel, which can substantially \
speed up training when augmentation is the bottleneck. If set to {True, n} at \
most n producer kernels are used, useful for debugging on a small scale. If \
set to False (default) batches are generated in-process as before."
}], "Usage",
 CellChangeTimes->{{3.9981148235391865`*^9, 3.9981148235462303`*^9}},
 CellID->36334322,ExpressionUUID->"dc91d031-25d7-0d4c-935f-5ad2dc5ea8f8"],

Cell["XXXX", "Notes",
 CellID->94795055,ExpressionUUID->"a5340b1f-6ae3-e449-8a9f-909f35c8770e"]
}, Open  ]],

