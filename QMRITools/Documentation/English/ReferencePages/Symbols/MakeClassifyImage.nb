 CellID->966224423,ExpressionUUID->"dcf37175-60e4-c94a-9dda-66ee968eb279"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5df1684d-be30-f842-b606-ca037e52fa00"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeClassifyImage",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/MakeClassifyImage"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "e7f3fc0a-be2d-9844-a66e-e9b6f8bbe801"],
 "\[LineSeparator]makes a image of the input data. The data is automatically \
cropped to remove the background and normalized. If the input data is 3D a \
list of images is returned."
}], "Usage",
 CellChangeTimes->{3.9966556905477734`*^9},
 CellID->388852789,ExpressionUUID->"90e07dc4-e50e-a445-8c11-80ebd7f90164"],

