Notebook[{

Cell[CellGroupData[{
Cell["ViewProtocolNames", "ObjectName",
 CellID->134491536,ExpressionUUID->"ab50ee06-cb96-eb45-8e52-aa8a0aa6d3a7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c890ff40-4c8c-474c-8717-98267ab5e293"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ViewProtocolNames",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ViewProtocolNames"], "[", 
   StyleBox["folder", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "4d5d342c-40bb-df48-a521-bac4225f034e"],
 "\[LineSeparator]shows the protocol names in the radData folder specified by \
the config file with the series number and protocol name from the json files \
in the raw folders for each subject and session. Duplicate protocol names are \
highlighted and can be shown only using the checkbox. The config file only \
needs to define the folders."
}], "Usage",
 CellChangeTimes->{4.0038046015162487`*^9},
 CellID->33460015,ExpressionUUID->"85729954-3144-8f48-9593-064deb00e6e4"],

