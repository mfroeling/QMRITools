Cell[CellGroupData[{
Cell["SimAngleParameters", "ObjectName",
 CellID->169971428,ExpressionUUID->"150814b4-1642-3c4e-9933-e127165f82e2"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"27059d30-01db-3840-8ec6-91459cbfaa5e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimAngleParameters",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSimulationTools/ref/SimAngleParameters"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["vec", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "239bda78-6828-ce40-b2c1-e2b71fa7bf96"],
 "\[LineSeparator]calculates the diffusion eigenvectors for ",
 Cell[BoxData[
  StyleBox["tens", "TI"]], "InlineFormula",ExpressionUUID->
  "fffdabab-3040-3f40-8900-e92f32765a55"],
 " compared to the true values ",
 Cell[BoxData[
  StyleBox["vec", "TI"]], "InlineFormula",ExpressionUUID->
  "07032677-f40c-734f-a220-378c9d0459a6"],
 ". The output can be used in ",
 Cell[BoxData[
  ButtonBox["PlotSimulationAngleHist",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PlotSimulationAngleHist"]], 
  "InlineFormula",ExpressionUUID->"78f12517-43e6-aa48-a025-8766d47b996b"],
 " and ",
 Cell[BoxData[
  ButtonBox["PlotSimulationAngle",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PlotSimulationAngle"]], "InlineFormula",
  ExpressionUUID->"0734ce0a-41e3-ac49-8be4-c673962bcdb1"],
 "."
}], "Usage",
