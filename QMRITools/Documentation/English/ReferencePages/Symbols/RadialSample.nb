Cell[CellGroupData[{
Cell["RadialSample", "ObjectName",
 CellID->590522370,ExpressionUUID->"14700d7d-f789-3e46-beb7-e3ca5c15c458"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8000ec0f-d6da-5147-a608-9554d36fd0fe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RadialSample",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/RadialSample"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["data", "TI"], ",", 
    StyleBox["segang", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d25a83c4-a8d0-9c45-9f30-8380848cd1c1"],
 "\[LineSeparator]radialy samples the provided parameter map ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "ad49a582-ad0f-a445-b38d-7f2a10a6fca2"],
 ". The ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "6c106295-81c7-8b47-afd0-c5c393f70ea8"],
 " should be a ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "b3dec9ae-fd3e-754c-9627-6d9e4cc42386"],
 " of the left ventricle that was used in the ",
 Cell[BoxData[
  ButtonBox["CardiacSegment",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CardiacSegment"]], "InlineFormula",
  ExpressionUUID->"74026fa7-8d1b-e345-abd8-5b442c93e9c7"],
 ". segang is the output of the cardiac SegmentFunction. Output is {points, \
vals} which are orderd as indicated by the user."
}], "Usage",
 CellChangeTimes->{{3.9966566139808445`*^9, 3.996656614050436*^9}},
 CellID->496347434,ExpressionUUID->"6ba35121-4cb5-d148-947b-33de93bab400"],

