Notebook[{

Cell[CellGroupData[{
Cell["EvaluateModel", "ObjectName",
 CellID->113216734,ExpressionUUID->"5de55938-831e-174a-b4c7-ba399c4d384d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"87a8cdb0-6a2e-8f47-b06a-2094db0a281c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EvaluateModel",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/EvaluateModel"], "[", 
   RowBox[{
    StyleBox["points", "TI"], ",", 
    StyleBox["mesh", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c54a493e-5c1f-d042-80ec-190b8f15e6db"],
 "\[LineSeparator]return a dynamic plot showing an evaluation of the shape \
model. The ",
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",ExpressionUUID->
  "b0a173b6-6e40-5e43-9db6-cbcf20672aca"],
 " and ",
 Cell[BoxData[
  StyleBox["mesh", "TI"]], "InlineFormula",ExpressionUUID->
  "137ae948-beef-7040-af60-0433112caf99"],
 " are obtained from ",
 Cell[BoxData[
  ButtonBox["TemplateToVolume",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/TemplateToVolume"]], "InlineFormula",
  ExpressionUUID->"d2499747-7fe4-0e49-8530-4bbb996ff2b8"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4b8d4abd-7e73-9c49-8bb2-b08675c7d11a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EvaluateModel",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/EvaluateModel"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["mean", "TI"], ",", 
      StyleBox["mat", "TI"]}], "}"}], ",", 
    StyleBox["points", "TI"], ",", 
    StyleBox["cells", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6ec866bb-fc0c-d44d-8a37-9f496bba6f7a"],
 "\[LineSeparator]does the same but for a explicit shape model given by mean \
and mat. the shape model can be obtained from ",
 Cell[BoxData[
  ButtonBox["MakeShapeModel",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeShapeModel"]], "InlineFormula",
  ExpressionUUID->"334e8b42-7525-4145-9451-1407c4afb2a2"],
 "."
}], "Usage",
 CellChangeTimes->{{3.996656412163761*^9, 3.996656412169674*^9}, {
