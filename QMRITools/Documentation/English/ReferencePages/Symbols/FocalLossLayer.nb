Notebook[{

Cell[CellGroupData[{
Cell["FocalLossLayer", "ObjectName",
 CellID->32041259,ExpressionUUID->"d8555f19-9417-964c-b4bf-9a5930e628a0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7d278dd7-157f-0145-a1c1-2ccda1e05a5b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FocalLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/FocalLossLayer"], "[",
    "]"}]], "InlineFormula",ExpressionUUID->
  "bb5f603a-a474-8f4d-853d-093db8b432dd"],
 "\[LineSeparator]represents a net layer that computes the Focal loss by \
comparing input class probability vectors with the target class vector. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2528128a-0337-4244-afc7-1cefe05cb3a4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FocalLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/FocalLossLayer"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "dd3a1fb3-293e-244c-9ac0-6bc447132d6e"],
 "\[LineSeparator]does the same but uses g as the tunable focusing parameter \
gamma which needs to be larger than one."
}], "Usage",
 CellChangeTimes->{{3.9985332207181244`*^9, 3.9985332208319454`*^9}},
 CellID->901165877,ExpressionUUID->"e6c1bfdf-0af8-8d4a-ab80-ecf89458a9e0"],

