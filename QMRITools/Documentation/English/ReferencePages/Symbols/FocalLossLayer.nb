Notebook[{

Cell[CellGroupData[{
Cell["FocalLossLayer", "ObjectName",
 CellID->466494894,ExpressionUUID->"e43cd189-d082-da45-bb5c-90a722fe1442"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bd81e22e-9dd8-5a46-80a7-bc13e8cddf69"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FocalLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/FocalLossLayer"], "[",
    "]"}]], "InlineFormula",ExpressionUUID->
  "1055bfc2-e1c3-7d4a-8aed-ca7e598e2ab1"],
 "\[LineSeparator]represents ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "01194b54-a0d8-0e43-b2b7-697950689e3b"],
 " net layer that computes the Focal loss by comparing input class \
probability vectors with the target class vector. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2c6f8320-95ab-7342-944d-cc70af91ba8f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FocalLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/FocalLossLayer"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5b75fc02-8a1a-da40-ab67-c4dc3cf87e8f"],
 "\[LineSeparator]does the same but uses ",
 Cell[BoxData[
  StyleBox["g", "TI"]], "InlineFormula",ExpressionUUID->
  "9516a2c3-712c-d346-9bf1-c3bce7038c79"],
 " as the tunable focusing parameter gamma which needs to be larger than one. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f4dfa0a7-6e68-2745-8aa7-367393870970"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FocalLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/FocalLossLayer"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", 
    StyleBox["a", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9b714791-ba48-0c47-af5e-cb8107978db8"],
 "\[LineSeparator]does the same but uses ",
 Cell[BoxData[
  StyleBox["a", "TI"]], "InlineFormula",ExpressionUUID->
  "f6a984ad-9051-7c4c-ac54-c6de0030f879"],
 " as the balancing factor alpha."
}], "Usage",
 CellChangeTimes->{{3.9966563480134087`*^9, 3.9966563481443653`*^9}},
 CellID->15989495,ExpressionUUID->"a8092771-795f-ac4a-a038-a797024b7c2d"],

