Notebook[{

Cell[CellGroupData[{
Cell["MakeNode", "ObjectName",
 CellID->303353242,ExpressionUUID->"f030a343-fc1d-ae43-ae52-1e84e7f34b35"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"afcb667b-1631-8849-a5a5-3ccde0fb28df"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeNode",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/MakeNode"], "[", 
   RowBox[{
    StyleBox["scale", "TI"], ",", 
    StyleBox["conn", "TI"], ",", 
    StyleBox["blockConfig", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "11da467a-92f7-a046-9868-cc85a9bd6b7e"],
 "\[LineSeparator]makes a node for a UNET. The input ",
 Cell[BoxData[
  StyleBox["scale", "TI"]], "InlineFormula",ExpressionUUID->
  "3e7cbba0-3fda-1c42-99e9-ad60ae5f9d34"],
 " defines the input and output scaling, is either an integer or a vector of \
length dim. The input ",
 Cell[BoxData[
  StyleBox["conn", "TI"]], "InlineFormula",ExpressionUUID->
  "b4602d7f-2e53-6443-93e4-c5cbde6c0be4"],
 " defines the connections, is a list of two integer values defining the \
number of input and output ports. The ",
 Cell[BoxData[
  StyleBox["blockConfig", "TI"]], "InlineFormula",ExpressionUUID->
  "146897ca-733a-4642-8155-79f10afd797d"],
 " is defined as {{blockType, settings}, {features,..}, {act, dim}}."
}], "Usage",
 CellChangeTimes->{{3.996656832402935*^9, 3.996656832476902*^9}},
 CellID->939995013,ExpressionUUID->"21b4751e-75c9-1a4c-ab0a-25921d458ab1"],

Cell["The following options can be given: ", "Notes",
 CellID->80708350,ExpressionUUID->"0f4bce81-4255-ac4b-954b-c987d22e175f"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0c7600ed-7d97-fd4c-8565-351a2907b9d1"], 
    ButtonBox["DropoutRate",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DropoutRate"], "0", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["DropoutRate",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DropoutRate"]], "InlineFormula",
      ExpressionUUID->"ff307dcb-f478-f94e-b2ba-e4b93caa9c04"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"e38d09e4-6146-6240-98d9-b8058d4a17cb"],
     ". It specifies how much dropout is used after each block. It is a value \
between 0 and 1, default is .2."
    }], "TableText",ExpressionUUID->"37014ce4-547d-9348-ac5d-2de50fde49d9"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e521b6ed-1f70-0142-b5f5-dc44a9b1f0aa"], 
    ButtonBox["RescaleMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/RescaleMethod"], "\"\<Conv\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["RescaleMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/RescaleMethod"]], "InlineFormula",
      ExpressionUUID->"05fd6880-502f-f545-a48a-136a40e78769"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"44570732-46a0-d045-80ab-1df55fa05389"],
     ". It specifies how the network rescales. It can be \"Conv\" or \"Pool\"."
    }], "TableText",ExpressionUUID->"08e60f60-0d27-ad4f-a394-2bc0424930f0"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "51e4423d-8cbf-2144-970b-ee86cf1ae568"], 
    ButtonBox["CatenateMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/CatenateMethod"], "\"\<Cat\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["CatenateMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CatenateMethod"]], "InlineFormula",
      ExpressionUUID->"493e9fa0-4b50-7b4d-a65e-111117880466"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["MakeUnet",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
      ExpressionUUID->"7343da5c-f216-264f-8bc9-620b9d6f61df"],
     ". It specifies how the network catenates the skip and upscale channel. \
It can be \"Tot\", or \"Cat\"."
    }], "TableText",ExpressionUUID->"b8519e42-2552-7a49-ab04-5dde73a4330b"]}
  }]], "3ColumnTableMod",
 CellID->62693200,ExpressionUUID->"4e897b08-b989-954d-8c7a-6062ec8cd74f"]
}, Open  ]],

