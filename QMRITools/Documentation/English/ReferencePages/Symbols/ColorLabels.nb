Cell["ColorLabels", "ObjectName",
 CellID->743265654,ExpressionUUID->"ab5ba04b-6766-2342-bd5a-bd3b9b4a68c4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"881f8941-9fd3-b340-ad3a-a2bc0a498ff5"],
 Cell[BoxData[
 "ColorLabels"], "InlineFormula",ExpressionUUID->
  "c593f748-4432-1247-be83-df766d32d748"],
 "\[LineSeparator]is an option for PlotSegmentations. If a list of labels is \
given only these labels are plotted and each label gets a fixed color based \
on its position in the list. Default is Automatic, which uses the labels in \
the segmentation."
}], "Usage",
