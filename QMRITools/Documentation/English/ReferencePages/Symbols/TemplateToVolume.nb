Notebook[{

Cell[CellGroupData[{
Cell["TemplateToVolume", "ObjectName",
 CellID->108882784,ExpressionUUID->"7bc7851e-6863-c349-84e8-894f3ad1fc12"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"aafae8cd-0a0c-484b-a64c-32f16011a9ad"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TemplateToVolume",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/TemplateToVolume"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["masks", "TI"], ",", 
      StyleBox["voxM", "TI"]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["template", "TI"], ",", 
      StyleBox["voxT", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"8a1dc6a0-9eb4-c848-b5ac-5833cec9e229"],
 "\[LineSeparator]registers a mask or a series of masks to the given muscle \
template. The default output are the mesh points per mask volume and the cell \
needed to generate the mesh as {points, mesh}."
}], "Usage",
 CellChangeTimes->{3.9966557111921654`*^9},
 CellID->4774898,ExpressionUUID->"d1b57349-4061-d347-b33c-0bdd2e09db77"],

Cell["The following options can be given: ", "Notes",
 CellID->35646676,ExpressionUUID->"816a134c-6336-8442-ab92-2da61e4299b3"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1cc0a95f-873e-7648-9210-c771e47b889d"], 
    ButtonBox["MeshPoints",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MeshPoints"], 
    RowBox[{"{", 
     RowBox[{"500", ",", " ", "2000"}], "}"}], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["MeshPoints",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MeshPoints"]], "InlineFormula",
      ExpressionUUID->"1791d189-301b-294e-804a-2083c94ebe44"],
     " is an option for ",
     Cell[BoxData[
     "TemplateToVolume"], "InlineFormula",ExpressionUUID->
      "5c7aeea9-afc7-834d-99fc-31c03617aa59"],
     ". It specifies how many mesh coordinates will be used in the template."
    }], "TableText",ExpressionUUID->"7044ba10-f64a-1a43-ac57-347a88805ce3"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "96ccb1b0-f140-6441-9aad-3c3602cd9ac3"], 
    ButtonBox["TemplatePadding",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/TemplatePadding"], "20", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["TemplatePadding",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TemplatePadding"]], "InlineFormula",
      ExpressionUUID->"976d0887-a994-414f-b86d-f92894468731"],
     " is an option for ",
     Cell[BoxData[
     "TemplateToVolume"], "InlineFormula",ExpressionUUID->
      "9ea7a533-3f2b-ab4e-a154-d4cd922a922e"],
     ". It specifies how much the template will be padded to prevent cut off \
of \nlarger muscles."
    }], "TableText",ExpressionUUID->"1409dfe1-934a-a849-94ba-2f7b64da2351"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a7b467c7-4585-8c4f-9ea3-72b162384abc"], 
    ButtonBox["TemplateDilation",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/TemplateDilation"], "2", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["TemplateDilation",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TemplateDilation"]], "InlineFormula",
      ExpressionUUID->"163d1337-57fc-c54f-ac1f-b99dd5553908"],
     " is an option for ",
     Cell[BoxData[
     "TemplateToVolume"], "InlineFormula",ExpressionUUID->
      "fc574bf0-f9f5-6846-a0df-b27fe24174cd"],
     ". It specifies how much the template is dilated during registration.\n\
The value is specified in mm and it helps to properly align the points."
    }], "TableText",ExpressionUUID->"aef07a57-1248-9b42-b0ef-e1031bb2f758"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bfb5d9ef-b025-314a-8cdc-f294f9ac8dc6"], 
    ButtonBox["VolumeRescale",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/VolumeRescale"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["VolumeRescale",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/VolumeRescale"]], "InlineFormula",
      ExpressionUUID->"48019e5e-4239-7e41-a78b-1e9e17115f7e"],
     " is an option for ",
     Cell[BoxData[
     "TemplateToVolume"], "InlineFormula",ExpressionUUID->
      "73094f7f-76e4-1c42-a344-bcbdd01ef647"],
     ". If this option is set to ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "28ce656d-8488-f94c-a8b8-8865af61aa13"],
     " the volume of each muscle will be normalized \nto the mean volume of \
the template volumes or the template volume."
    }], "TableText",ExpressionUUID->"e8f19687-84b2-e843-a195-70dc1ce8c61c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ff93c295-5964-c44b-b7b2-78a93bcc219a"], 
    ButtonBox["SplineSpacing",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SplineSpacing"], "5", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["SplineSpacing",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SplineSpacing"]], "InlineFormula",
      ExpressionUUID->"ad356d0f-7b99-1d47-adfe-2b49be41bfc2"],
     " is an option for ",
     Cell[BoxData[
     "TemplateToVolume"], "InlineFormula",ExpressionUUID->
      "2e6442a5-74d4-6e43-978c-858ea5cd2078"],
     ". It defines how big the b-splines are during the registration process. \
Its value\nis multiplied with the voxel size which then becomes the spline \
spacing."
    }], "TableText",ExpressionUUID->"c8259233-5469-7d42-a1e0-af6f5fe35f54"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "009ffce4-5415-af40-a993-6e29d6c4d570"], 
    ButtonBox["TemplateOutput",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/TemplateOutput"], "\"\<Points\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["TemplateOutput",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/TemplateOutput"]], "InlineFormula",
      ExpressionUUID->"a6ea7f4f-5a2a-6f4c-857d-6d56da1fa188"],
     " is an option for ",
     Cell[BoxData[
     "TemplateToVolume"], "InlineFormula",ExpressionUUID->
      "b504d309-7d41-cf40-8a32-c8bf2ce40345"],
     ". The value can be \"Meshes\" \"PointsCells\" or \"Points\". The \
\"Meshes\" \"PointsCells\" outputs\nare needed for template and model \
visualization. The \"Points\" is the only thing needed for model fitting."
    }], "TableText",ExpressionUUID->"8f1af3fb-6d08-f94a-bf76-55afd7deda61"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "773d5528-05db-ff47-a01c-1934b9bba76c"], 
    ButtonBox["Monitor",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Monitor", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["mon", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
      "7e98cba2-1819-6340-9074-776da7798409"],
     " generates a temporary monitor cell in which the continually updated \
current value of ",
     Cell[BoxData[
      StyleBox["mon", "TI"]], "InlineFormula",ExpressionUUID->
      "9342819d-e74f-df44-8f7f-ed5e86befba1"],
     " is displayed during the course of evaluation of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "33e1fd35-16f3-df45-a238-bf6d33161e81"],
     ". "
    }], "TableText",ExpressionUUID->"ec75a487-8057-ff4e-b6f4-1a73b14b54f5"]}
  }]], "3ColumnTableMod",
 CellID->261143988,ExpressionUUID->"61732a07-9859-6146-9752-e9eafb4b38cd"]
}, Open  ]],

