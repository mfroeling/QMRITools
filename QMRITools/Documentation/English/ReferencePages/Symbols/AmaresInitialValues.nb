Cell[CellGroupData[{
Cell["AmaresInitialValues", "ObjectName",
 CellID->508978862,ExpressionUUID->"62a58ffa-350a-6e47-af48-82f2d13c6188"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d8e95c50-7b2b-d645-9980-fae5e13e4073"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresInitialValues",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresInitialValues"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gyro", "TI"], ",", 
      StyleBox["dw", "TI"]}], "}"}], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "e97db8df-358d-d443-a022-2aae2f4b7d12"],
 "\[LineSeparator]makes a guess for the initial fit values to initialize ",
 Cell[BoxData[
  ButtonBox["AmaresFitFidI",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/AmaresFitFidI"]], "InlineFormula",
  ExpressionUUID->"54b0a141-f8f0-3744-9e3a-19f22aa40ed7"],
 ". The ",
 Cell[BoxData[
  StyleBox["time", "TI"]], "InlineFormula",ExpressionUUID->
  "2cce6bff-5b43-234d-87f7-6ed28ee9a092"],
 ", ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "658f2876-d9d3-854b-892f-faa7e1956040"],
 " and gyro can be obtained from ",
 Cell[BoxData[
  ButtonBox["AmaresBasis",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/AmaresBasis"]], "InlineFormula",
  ExpressionUUID->"09d8dbef-ce4d-c349-8e36-5965f714394e"],
 " and the ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "bc0cd751-9aec-8245-b9ac-489486beaa63"],
 " can be obtained form EditMaresMatrix. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6cf4458d-04fe-9945-81bc-c5017a5d30b3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresInitialValues",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresInitialValues"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gyro", "TI"], ",", 
      StyleBox["dw", "TI"]}], "}"}], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["plot", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ebf9d5ed-9dfe-144a-862c-8f7ded370f18"],
 "\[LineSeparator]also exports the calibration plots if ",
 Cell[BoxData[
  StyleBox["plot", "TI"]], "InlineFormula",ExpressionUUID->
  "555a80d9-29ea-304a-b7f5-f174b5babc86"],
 " is set to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "404f9662-ba01-6840-90b8-8e384a3eda76"],
 "."
}], "Usage",
