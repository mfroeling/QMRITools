Notebook[{

Cell[CellGroupData[{
Cell["AmaresInitialValues", "ObjectName",
 CellID->3443140,ExpressionUUID->"c56f5586-2b38-1540-8057-fefc2ed60db7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5a2ce29d-2166-bc45-87ef-1288460b1dfe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresInitialValues",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresInitialValues"], "[", 
   RowBox[{
    StyleBox["fid", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["gyro", "TI"], ",", 
      StyleBox["dw", "TI"]}], "}"}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "39e5b0fb-9b69-074f-8bce-ceb6e315149f"],
 "\[LineSeparator]makes a guess for the initial fit values to initialize ",
 Cell[BoxData[
  ButtonBox["AmaresFitFidI",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/AmaresFitFidI"]], "InlineFormula",
  ExpressionUUID->"5566c59d-5872-d74f-8893-85ab1e7f02b1"],
 ". The time, basis and gyro can be obtained from ",
 Cell[BoxData[
  ButtonBox["AmaresBasis",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/AmaresBasis"]], "InlineFormula",
  ExpressionUUID->"9828e83b-7446-d54c-a1ef-6e4e8e011e20"],
 " and the matrix can be obtained form EditMaresMatrix."
}], "Usage",
 CellChangeTimes->{3.9951014089900455`*^9},
 CellID->206734289,ExpressionUUID->"1e51ba16-6093-944b-9c4f-5b8d08e4fe98"],

