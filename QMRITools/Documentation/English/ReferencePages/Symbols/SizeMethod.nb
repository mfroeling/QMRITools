Cell["SizeMethod", "ObjectName",
 CellID->94863035,ExpressionUUID->"77e8f240-8c98-8645-85a4-9ebe12a3ddd4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"09587486-2561-7a47-b68c-0c263dec6b0b"],
 Cell[BoxData[
 "SizeMethod"], "InlineFormula",ExpressionUUID->
  "3d0d4567-cd12-8b45-bda7-0caf2829715b"],
 "\[LineSeparator]is an option for SelectActivations. Values can be \
\"Voxels\" or \"Area\". With \"Voxels\" ActivationSize is the number of \
connected voxels within a slice, with \"Area\" it is the area in mm^2 for \
which the voxel size is needed."
}], "Usage",
 CellID->186957473,ExpressionUUID->"d59c860e-8f8a-ad41-81c3-a68f8d39191a"],

