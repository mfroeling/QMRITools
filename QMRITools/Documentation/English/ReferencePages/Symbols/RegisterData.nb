Notebook[{

Cell[CellGroupData[{
Cell["RegisterData", "ObjectName",
 CellID->618728709,ExpressionUUID->"d8cd588f-83e3-294c-9d80-522eb97e86c4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"988a31eb-5b20-584d-9cf8-60bdfad7a351"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterData"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "16cd7523-e16c-ec4e-8ffd-8216e9050c90"],
 "\[LineSeparator]registers the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "3af3b1e7-2c6b-314d-9209-1a1c6f85a76b"],
 " series. If ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "7de12f14-7893-0141-8ce8-9b3ecf4769a4"],
 " is 3D it performs multiple 2D registration,if ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "a70c6930-53cf-dc43-b462-643da86ab620"],
 " is 4D it performs multiple 3D registration. The input ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "f76207d8-17d2-0e45-8f15-a73f418ad49d"],
 " can be in the forms: ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "5b6ee4f5-4227-7e49-9e72-37dae5f20011"],
 ",{data,vox},{data,mask} or {data,mask,vox}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"de516b9b-c2a6-0f49-9a26-c104fb68aa6b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterData"], "[", 
   RowBox[{
    StyleBox["target", "TI"], ",", 
    StyleBox["moving", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "667c0ad6-3267-ae45-9ad2-4de3b19d2897"],
 "\[LineSeparator]registers the moving data to the target data. target can be \
2D or 3D. moving can be the same of one dimension higher than the target. The \
inputs target and moving can be in the forms: data, ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "data"}], "TI"]], "InlineFormula",ExpressionUUID->
  "459bce95-d771-b14c-b436-2e98c256a8d1"],
 ", vox}, {data, mask} or {data, mask, vox}. Output is the registered data \
with the dimensions of the ",
 Cell[BoxData[
  StyleBox["moving", "TI"]], "InlineFormula",ExpressionUUID->
  "f6e0607c-7012-a44c-bc9f-44d6831c7928"],
 " data. If ",
 Cell[BoxData[
  ButtonBox["OutputTransformation",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/OutputTransformation"]], "InlineFormula",
  ExpressionUUID->"87be225e-5ddb-3641-bd6b-b690f06c9110"],
 " is ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "283474b6-298d-5f49-8e46-bc3ec72461c7"],
 " it also outputs the translation, rotation scale and skew of all images or \
volumes. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6565b634-736d-2c48-b8e0-c772dd5b28f1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RegisterData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/RegisterData"], "[", "]"}]],
   "InlineFormula",ExpressionUUID->"9e028257-1a5d-7c43-99fe-9744cf0d9198"],
 "\[LineSeparator]is based on DOI: 10.1109/TMI.2009.2035616 and \
10.3389/fninf.2013.00050."
}], "Usage",
 CellChangeTimes->{{3.996656610581459*^9, 3.996656610932316*^9}},
 CellID->64146683,ExpressionUUID->"c0e67f59-bf09-4447-bc0a-7d7299591224"],

