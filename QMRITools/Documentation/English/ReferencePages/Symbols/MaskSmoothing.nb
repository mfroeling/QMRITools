Cell["MaskSmoothing", "ObjectName",
 CellID->99905353,ExpressionUUID->"ada671ff-3edc-7a4d-8f51-2819540fce85"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b9e99bd6-bbd9-594d-9df1-7f60ddd53635"],
 Cell[BoxData[
 "MaskSmoothing"], "InlineFormula",ExpressionUUID->
  "c22d3bf5-9df2-6341-9574-5aac64053fae"],
 "\[LineSeparator]is an options for ",
 Cell[BoxData[
  ButtonBox["Mask",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/Mask"]], "InlineFormula",ExpressionUUID->
  "98ec0adc-11bd-7c49-82e0-c36a2ef82f04"],
 ", ",
 Cell[BoxData[
  ButtonBox["SmoothMask",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SmoothMask"]], "InlineFormula",
  ExpressionUUID->"045028f7-a7f2-3742-bc28-618c5e23bc37"],
 " and ",
 Cell[BoxData[
  ButtonBox["SmoothSegmentation",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SmoothSegmentation"]], "InlineFormula",
  ExpressionUUID->"776f8643-763a-a841-a943-092409e73977"],
 ", if set to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "b05e45da-fa2f-e942-80f8-0f9727295307"],
 " it smooths the mask, by closing holes and smoothing the contours."
}], "Usage",
