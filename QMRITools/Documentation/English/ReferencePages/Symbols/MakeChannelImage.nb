Cell["MakeChannelImage", "ObjectName",
 CellID->14368723,ExpressionUUID->"622e189b-c298-b941-9064-4dca3a45b359"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0326fa82-4567-4740-b66a-1a6eff7598fe"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelImage",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeChannelImage"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0afc38bc-f94d-a645-ad6a-5ebc47cf4e2b"],
 "\[LineSeparator]makes a cross-sectional image of the channels ",
