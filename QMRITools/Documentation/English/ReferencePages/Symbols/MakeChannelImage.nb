 Cell["   ", "ModInfo",ExpressionUUID->"19a4a626-1431-e34b-befa-b7d15373f43f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeChannelImage",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeChannelImage"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "62214552-037a-9f47-94f6-9965c0f47f8f"],
