Notebook[{

Cell[CellGroupData[{
Cell["FreezeEncoderLayers", "ObjectName",
 CellID->237918756,ExpressionUUID->"cae81031-138f-2b44-a836-c322c5daaa1c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"da10e893-451a-ba4c-9f9f-2d7af80f6e1c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FreezeEncoderLayers",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/FreezeEncoderLayers"], 
   "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ac3d1591-f4f6-2245-88f8-0a25ae7429a6"],
 "\[LineSeparator]freezes the \"start\" stem node and the first 3 encoder \
blocks of ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "516d0af0-8e87-a344-9f5f-f9be5615d3f1"],
 " (\"enc_1\" .. \"enc_3\") for transfer learning,returning a \
LearningRateMultipliers spec to pass to NetTrain. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c9031b7a-a31e-9c47-9db0-3223a42be391"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FreezeEncoderLayers",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/FreezeEncoderLayers"], 
   "[", 
   RowBox[{
    StyleBox["net", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c0ee3b6b-0069-364e-83ea-1edf79c9d8fe"],
 "\[LineSeparator]freezes \"start\" plus the first ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "c38ead7b-c3a9-9543-8b28-012f656e9a1a"],
 " encoder blocks instead. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"097459e0-46a5-6b40-9c9a-315a3f9d9bcf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FreezeEncoderLayers",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/FreezeEncoderLayers"], 
   "[", 
   RowBox[{
    StyleBox["net", "TI"], ",", 
    StyleBox["n", "TI"], ",", 
    StyleBox["includeStart", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ced21ff7-555c-1745-86ac-019a2b472f1c"],
 "\[LineSeparator]controls whether \"start\" is included, default ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "0d7898d9-04a6-d742-bb7c-c89b400a5c40"],
 " \[Dash] set to False if the input channel count differs from the \
pretrained ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "78dc674f-6250-1a4f-9b33-05a95034f20b"],
 ", since \"start\" is then freshly initialized and must stay trainable."
}], "Usage",
 CellChangeTimes->{{3.9981148210827713`*^9, 3.99811482135133*^9}},
 CellID->310383469,ExpressionUUID->"7ea617ac-f133-0e40-a5eb-4a43e552dc78"],

