Notebook[{

Cell[CellGroupData[{
Cell["AnnalyzeTagging", "ObjectName",
 CellID->41119746,ExpressionUUID->"f6186555-4373-094b-8e2b-bda05696ae3a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"021929f3-c0c7-ee44-85f1-07afd1270f4e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AnnalyzeTagging",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTaggingTools/ref/AnnalyzeTagging"], "[", 
   StyleBox["gridC", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "430e951d-e9f9-014c-9be3-24560eaf5c8a"],
 "\[LineSeparator]tracks the motion in tagged cine data gridC, which is \
{slices, frames, y, x}. The wave vectors of the tag grid are estimated from \
the power spectrum of the first frames. Per slice the displacement between \
consecutive frames is estimated from the phase of the band pass filtered tag \
images for each tag direction and accumulated over the frames. Output is \
{{ux, uy}, {im0, im, w0, w}}, all {slices, frames, y, x}, where ux and uy are \
the accumulated displacements in pixels along the first and second image \
dimension, im0 are the reference images, im the motion corrected frames and \
w0 and w the corresponding tag grid weighting maps."
}], "Usage",
 CellChangeTimes->{4.0038044928444195`*^9},
 CellID->331070587,ExpressionUUID->"4eede3b4-047c-0045-b3a8-3d971941b945"],

Cell["The following options can be given: ", "Notes",
 CellID->227183880,ExpressionUUID->"3ffa9dc8-aba8-bd43-b3c0-9f288a489405"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c31def51-3059-8e48-8dee-a4e10894838e"], 
    ButtonBox["HistoryWeighting",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/HistoryWeighting"], "0.7", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["HistoryWeighting",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/HistoryWeighting"]], "InlineFormula",
      ExpressionUUID->"759bed01-6e71-5d44-8d36-e0d29eb67e48"],
     " is an options for ",
     Cell[BoxData[
     "AnnalyzeTagging"], "InlineFormula",ExpressionUUID->
      "736ad07d-4458-5e4e-bd0f-025faeb65c4d"],
     ". It is the weight of the new frame when updating the reference image, \
reference = (1 - w) reference + w frame."
    }], "TableText",ExpressionUUID->"2ad16f19-fa70-0a48-920e-ceebdb35dc17"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c7839525-97e5-544e-b5d7-04f833065bc3"], 
    ButtonBox["MonitorTagging",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MonitorTagging"], 
    ButtonBox["True",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["MonitorTagging",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MonitorTagging"]], "InlineFormula",
      ExpressionUUID->"beedaf28-7298-b845-bd3b-4818f3ae33c2"],
     " is an options for ",
     Cell[BoxData[
     "AnnalyzeTagging"], "InlineFormula",ExpressionUUID->
      "a7256869-c9f6-4142-9613-fadb52a68735"],
     ". If ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "3b356da3-6dd5-034d-a3e4-f878c98df7c6"],
     " the intermediate images and displacements are shown during the \
calculation."
    }], "TableText",ExpressionUUID->"a013e23e-7364-b24e-a551-5e9a54ec40ff"]}
  }]], "3ColumnTableMod",
 CellID->208944289,ExpressionUUID->"19800264-73df-6f40-aec4-7833116d28d5"]
}, Open  ]],

