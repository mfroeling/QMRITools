  ButtonBox["CreateT2Dictionary",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CreateT2Dictionary"]], "InlineFormula",
  ExpressionUUID->"b4738908-5b4f-ee4e-9d15-9779a98c8c3b"],
