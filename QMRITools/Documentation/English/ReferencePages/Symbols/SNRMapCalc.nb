Notebook[{

Cell[CellGroupData[{
Cell["SNRMapCalc", "ObjectName",
 CellID->870743096,ExpressionUUID->"7ff80f31-7131-524f-abb2-a239f981afb3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fa5a1647-66b0-f541-95d8-fd4ccac34c5e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SNRMapCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/SNRMapCalc"], "[", 
   RowBox[{
    SubscriptBox[
     StyleBox["data", "TI"], 
     StyleBox["1", "TR"]], ",", 
    StyleBox["noisemap", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "205d6cb7-878c-4848-ae25-2e5ad18042f2"],
 "\[LineSeparator]calculates the signal to noise ratio of the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "f2cc5513-1dd1-af4e-9b67-3dfa85f88f29"],
 " using MN[data]/(1/sqrt[pi/2] sigma),where sigma is the local mean of the \
noise map assuming it is a Rician distribution. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"70a6ae0c-a905-7248-b3c3-c27c991dcf93"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SNRMapCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/SNRMapCalc"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["2", "TR"]]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "51a689f3-bb64-7b4f-894a-6513e67c80ac"],
 "\[LineSeparator]calculates the signal to noise ratio from two identical \
images using MN[data1,data2] / (.5 SQRT[2] STDV[data2-data1]). \n",
 Cell["   ", "ModInfo",ExpressionUUID->"500f0e8b-6bf0-e54b-88e2-85419e3fb30b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SNRMapCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsProcessingTools/ref/SNRMapCalc"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["1", "TR"]], ",", 
     RowBox[{"..", " ", 
      StyleBox["dataN", "TI"]}]}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"a6ab95e9-3317-c94b-898e-7d03ce985ed9"],
 "\[LineSeparator]calculates the signal to noise ratio of the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "ef98611e-c1a4-6444-b6af-8fcc5e2cde26"],
 " using MN/sigma where the mean signal MN is the average voxel value over \
all dynamics N and the sigma is the standard deviation over all dynamics N."
}], "Usage",
 CellChangeTimes->{{3.9966567192645283`*^9, 3.9966567195204277`*^9}},
 CellID->464226192,ExpressionUUID->"07b6e8fe-dda9-2c48-9d86-1dd46891fe96"],

