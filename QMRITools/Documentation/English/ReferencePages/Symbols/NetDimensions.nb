Cell[CellGroupData[{
Cell["NetDimensions", "ObjectName",
 CellID->209979739,ExpressionUUID->"ce3c7003-f487-3640-a6ad-83ada9cf7502"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dd88ecaf-a0ea-1648-b657-4587fcf7071c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NetDimensions",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/NetDimensions"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "92cf95f0-129a-004f-9ae9-ec879bbef3b1"],
 "\[LineSeparator]extracts the input channels,output classes,the input patch \
dimension,and the number of input filters. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c4ce76a4-8666-5e4b-87e5-981a79413ed8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NetDimensions",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/NetDimensions"], "[", 
   RowBox[{
    StyleBox["net", "TI"], ",", 
    StyleBox["port", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "229a5b5a-9450-5b41-ab00-2c0509e553f8"],
 "\[LineSeparator]returns the dimensions at the given ",
 Cell[BoxData[
  StyleBox["port", "TI"]], "InlineFormula",ExpressionUUID->
  "98cb22b0-7bfc-7343-9c5f-aacc9af45f3c"],
 " instead. Port can be \"Input\", \"Output\", \"FirstEncodingIn\", \
\"FirstEncodingOut\", \"LastEncodingIn\", \"LastEncodingOut\", \
\"MinEncodingOut\", \"AllEncodingOut\", \"AllMaxChannels\", or \"U2Encoding\"."
}], "Usage",
