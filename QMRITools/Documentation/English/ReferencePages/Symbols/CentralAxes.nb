Cell[CellGroupData[{
Cell["CentralAxes", "ObjectName",
 CellID->719197506,ExpressionUUID->"f69cddb0-e61b-8b41-9336-a33411273f4a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"69d967fa-261c-d143-be7d-6b1712c67f79"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CentralAxes",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/CentralAxes"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "578a9987-9d2b-ad47-a696-a72b23f8ee17"],
 "\[LineSeparator]calculates the center of the lumen from a ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "0018bf4f-01d5-0d43-a479-e3e4a510f7f0"],
 " of the left ventricle. ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "201d9a9e-6539-424b-8842-0170937732be"],
 " is the voxels size, {slice, x, y}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"bacc9eba-6a38-0045-838c-aee1e56f4887"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CentralAxes",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/CentralAxes"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["maskp", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6758c598-b5af-c946-8fc3-20831cfaa889"],
 "\[LineSeparator]allows for fancy visualization of the other structures \
using ",
 Cell[BoxData[
  StyleBox["maskp", "TI"]], "InlineFormula",ExpressionUUID->
  "a10ea008-dd90-d646-aa6e-114cb3e11437"],
 ". Output is {centerpoints, normalvecs, inout} or {centerpoints, normalvecs, \
inout, fit}."
}], "Usage",
 CellChangeTimes->{{3.9966567037903137`*^9, 3.9966567039344807`*^9}},
 CellID->107791513,ExpressionUUID->"739f31eb-d58d-9b44-8c50-514649f3682e"],

