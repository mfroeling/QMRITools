Notebook[{

Cell[CellGroupData[{
Cell["UnwrapSplit", "ObjectName",
 CellID->85925055,ExpressionUUID->"634c2c95-5910-0e4a-a492-530c164e02aa"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0ac18304-59cc-a94f-a582-e9aec2004339"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UnwrapSplit",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/UnwrapSplit"], "[", 
   RowBox[{
    StyleBox["phase", "TI"], ",", 
    StyleBox["data", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9362208d-d3ad-764d-b8c8-e7ccdd125230"],
 "\[LineSeparator]unwarps the give ",
 Cell[BoxData[
  StyleBox["phase", "TI"]], "InlineFormula",ExpressionUUID->
  "393d5445-c964-0b4a-8b69-425e090d00ea"],
 " dataset but splits the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "fb1ea1b5-ea78-2f45-8bae-e4f1ad67f107"],
 " into left and right using SplitData based in the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "558e5bb3-3364-144a-a71a-65e2f71b0f78"],
 " and performs the unwrapping separately. The ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "56462fea-c48d-c24e-a495-0fa29477d388"],
 " should be between -Pi and Pi. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"944b0126-01fd-284b-832c-036c3931b42b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["UnwrapSplit",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/UnwrapSplit"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"e4b2d00f-8400-494d-a26e-fa88221f7afe"],
 "\[LineSeparator]is based on DOI: 10.1364/AO.46.006623 and \
10.1364/AO.41.007437."
}], "Usage",
 CellChangeTimes->{{3.996656658720848*^9, 3.9966566588902664`*^9}},
 CellID->247968226,ExpressionUUID->"87a816da-0209-1240-b65d-43010d9f0b6d"],

Cell["The following options can be given: ", "Notes",
 CellID->37030852,ExpressionUUID->"2db25273-5458-a34d-b17c-9fa38c0fbc30"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0c9178bd-0e99-a54b-a9ac-92c4c21ad444"], 
    ButtonBox["MonitorUnwrap",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MonitorUnwrap"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["MonitorUnwrap",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MonitorUnwrap"]], "InlineFormula",
      ExpressionUUID->"d866e658-a9d9-9a4c-a395-c09c871b102c"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["Unwrap",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Unwrap"]], "InlineFormula",
      ExpressionUUID->"8560ecba-747a-3746-ad2f-ad2cd91464be"],
     ". Monitor the unwrapping progress."
    }], "TableText",ExpressionUUID->"b17aaa13-6904-4640-bd42-bbba209ed996"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6e0eeb3f-aaf4-1e40-9483-ce4f8bcf0eca"], 
    ButtonBox["UnwrapDimension",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/UnwrapDimension"], "\"\<2D\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["Unwrap",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Unwrap"]], "InlineFormula",
      ExpressionUUID->"43c5a886-0e5d-2d44-8478-dbd6c932e25c"],
     "Dimension is an option for ",
     Cell[BoxData[
      ButtonBox["Unwrap",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Unwrap"]], "InlineFormula",
      ExpressionUUID->"348daa3f-5cf0-444b-8327-fe82e06a0c74"],
     ". Can be \"2D\" or \"3D\". 2D is for unwarpping 2D images or unwrapping \
the individual images from a 3D dataset (does not unwrap in the slice \
direction). 3D unwraps a 3D dataset in all dimensions."
    }], "TableText",ExpressionUUID->"f1dc1b56-999c-df46-bcc2-2a9c8bb10a9b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bb101184-5f94-5642-bf48-1282ab28ea5b"], 
    ButtonBox["UnwrapThresh",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/UnwrapThresh"], "0.5", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["Unwrap",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Unwrap"]], "InlineFormula",
      ExpressionUUID->"bc5a2bc4-938b-d34c-afe1-0221888ac624"],
     "Thresh is an option for ",
     Cell[BoxData[
      ButtonBox["Unwrap",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/Unwrap"]], "InlineFormula",
      ExpressionUUID->"f9a50f6b-18d0-bf45-ad09-c60a9de3688e"],
     ". Is a value between 0.6 and 0.9, and defines when to unwrap, the \
higher the value the less unwrapping will be done."
    }], "TableText",ExpressionUUID->"0919401c-02ad-2640-a7ea-fd3ff177077c"]}
  }]], "3ColumnTableMod",
 CellID->335712758,ExpressionUUID->"e32be5a5-d9a0-ff4b-aa7d-6f26fe367aca"]
}, Open  ]],

