Notebook[{

Cell[CellGroupData[{
Cell["SequencePulseAcquire", "ObjectName",
 CellID->171524482,ExpressionUUID->"a45937cf-0c4c-e544-b387-cf284bcaf294"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"45171e3f-ecf2-2141-bbf2-d3442f230ea8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SequencePulseAcquire",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SequencePulseAcquire"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9120d354-6921-cd49-ac02-378444e4b7e6"],
 "\[LineSeparator]performs a pulse acquire experiment of the spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "c537763b-c34c-e746-9fe1-70e89d91ae9d"],
 " given the hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "3ab7d341-80cd-3149-84de-86c4689addc5"],
 " with a 90 Degree pulse. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"32b91b12-a664-6144-8b9e-5c8cb81bf634"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SequencePulseAcquire",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SequencePulseAcquire"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["1", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ee991ac3-9757-064b-bdb9-418b8a2b52d9"],
 "\[LineSeparator]performs a pulse acquire experiment of the spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "ad233c6b-743f-534b-92c7-aa2e4e2abbd3"],
 " given the hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "1ecee420-3731-a84c-9f18-a797390c924a"],
 " with a 90 Degree pulse and ",
 Cell[BoxData[
  StyleBox["b1", "TI"]], "InlineFormula",ExpressionUUID->
  "4e555e9c-967c-7542-8377-deb2dd1a9213"],
 ". The output is a new spin system dOut."
}], "Usage",
 CellChangeTimes->{{3.9966556084771442`*^9, 3.996655608681261*^9}},
 CellID->20286581,ExpressionUUID->"40b28c47-25eb-e34b-971b-a0c989069640"],

