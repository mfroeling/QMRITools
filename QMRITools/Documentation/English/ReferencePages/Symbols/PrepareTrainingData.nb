Cell["PrepareTrainingData", "ObjectName",
 CellID->589746951,ExpressionUUID->"6f3d011a-2cac-3d4b-a5fa-970489de7158"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"896d4441-bf6e-3049-8173-7818dfaec7f1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PrepareTrainingData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PrepareTrainingData"], 
   "[", 
   RowBox[{
    StyleBox["inFolder", "TI"], ",", 
    StyleBox["outFolder", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "24c1dfc3-69f6-4749-87ad-a69b08b8f8dc"],
 "\[LineSeparator]prepares the data in de ",
 Cell[BoxData[
  StyleBox["inFolder", "TI"]], "InlineFormula",ExpressionUUID->
  "9f42a84e-4d9b-8942-b4d5-4b68161ef900"],
 " for training a neural network for segmentation and outputs in ",
 Cell[BoxData[
  StyleBox["outFolder", "TI"]], "InlineFormula",ExpressionUUID->
  "a2650a48-68c5-ee40-8c52-0bc34527d9c9"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a7b98f11-b5e8-ac45-b9ab-4dc4417905a8"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PrepareTrainingData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/PrepareTrainingData"], 
   "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["labFolder", "TI"], ",", 
      StyleBox["datFolder", "TI"]}], "}"}], ",", 
    StyleBox["outFolder", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "679d574a-1645-b548-96a4-f7e9ce9299ca"],
 "\[LineSeparator]does the same but the labels are stored in labFolder and \
data is stored in datFolder."
}], "Usage",
 CellChangeTimes->{{3.9966556268285675`*^9, 3.996655626967203*^9}},
 CellID->1047226110,ExpressionUUID->"a4cfa307-559d-8047-a463-61623f588ca5"],

