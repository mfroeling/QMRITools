Notebook[{

Cell[CellGroupData[{
Cell["T2Fit", "ObjectName",
 CellID->370488510,ExpressionUUID->"bc35380c-5be5-344d-ba22-4d43301b1dfd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1b57ea6e-10c8-d546-a298-239d36a89f80"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["T2Fit",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/T2Fit"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", "EchoTimes"}], "]"}]], "InlineFormula",
  ExpressionUUID->"3b3dfc6a-62e0-574f-9fb3-bb010d460ef6"],
 "\[LineSeparator]fits the t2 value to the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "81a829cf-7029-764f-bd84-5caf4f84e325"],
 " using linear or nonlinear methods.vThe output is in units as defined by \
the ",
 Cell[BoxData[
  StyleBox["EchoTimes", "TI"]], "InlineFormula",ExpressionUUID->
  "24ec0449-760c-3940-8bbb-a5b16440f7c1"],
 ", e.g. if ",
 Cell[BoxData[
  StyleBox["EchoTimes", "TI"]], "InlineFormula",ExpressionUUID->
  "938fc6fb-5008-574a-8699-d92aa6b81679"],
 " is in ms the output is in ms.vOutput is {S(0), t2}."
}], "Usage",
 CellChangeTimes->{{3.996656878323721*^9, 3.996656878431404*^9}},
 CellID->94077392,ExpressionUUID->"24501450-e355-9c47-bb36-df1810048834"],

Cell["The following options can be given: ", "Notes",
 CellID->35191004,ExpressionUUID->"09e956a0-c323-664f-8264-928ccaa55bcf"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e232e943-22e6-0e44-80f8-0f9a7a106fcb"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<Linear\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"5bb7a4c3-aade-ad4f-9648-f7b7ea6efe8e"]}
  }]], "3ColumnTableMod",
 CellID->484273593,ExpressionUUID->"7cfc5784-87a3-5c47-8c0b-b8fae28dc04d"]
}, Open  ]],

