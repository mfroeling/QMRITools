Notebook[{

Cell[CellGroupData[{
Cell["JaccardLossLayer", "ObjectName",
 CellID->2450576,ExpressionUUID->"0c6853db-4dc7-414e-adac-02990d665d2a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"df74095b-bb4f-9648-a438-ff7ccdc283c0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["JaccardLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/JaccardLossLayer"], "[",
    "]"}]], "InlineFormula",ExpressionUUID->
  "d54eaf30-0794-344d-af41-607341f0f94c"],
 "\[LineSeparator]represents a net layer that computes the Jaccard loss by \
comparing input class probability vectors with the target class vector. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"6f645b2d-bccf-8443-984d-6b8c8ebbfd4f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["JaccardLossLayer",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/JaccardLossLayer"], "[", 
   StyleBox["n", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "4cddcbfd-0dc5-aa4e-a37a-1154a7cabe8a"],
 "\[LineSeparator]does the same but n defines the power of the denominator, \
with n=2 the squared Jaccard score is calculated."
}], "Usage",
 CellChangeTimes->{{3.996656247040909*^9, 3.9966562470965576`*^9}},
 CellID->49166677,ExpressionUUID->"b0db13b9-423a-bf45-b2a0-4000772ed096"],

