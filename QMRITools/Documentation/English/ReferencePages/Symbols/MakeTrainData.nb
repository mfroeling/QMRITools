Notebook[{

Cell[CellGroupData[{
Cell["MakeTrainData", "ObjectName",
 CellID->151759717,ExpressionUUID->"824d81e8-c58a-684d-b4c7-7763ddf4aa8d"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2a12a59c-f2d9-4740-862c-be45faae8413"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeTrainData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeTrainData"], "[", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["1", "TR"]], ",", 
     SubscriptBox[
      StyleBox["data", "TI"], 
      StyleBox["2", "TR"]], ",", 
     StyleBox["n", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "37fb5087-d1d6-4c4f-8f16-b10c7e22614d"],
 "\[LineSeparator]makes multi contrast training data by blending the \
co-registered 3D datasets data1 and ",
 Cell[BoxData[
  StyleBox["data2", "TI"]], "InlineFormula",ExpressionUUID->
  "1cf7edd5-4441-354b-8e7a-4382b2243ce9"],
 " in n linear steps from data1 to ",
 Cell[BoxData[
  StyleBox["data2", "TI"]], "InlineFormula",ExpressionUUID->
  "8f7c7da9-2241-bb45-b33f-85bc527e2751"],
 ". Each blend is normalized and the result is masked. The output is a 4D \
dataset where each blend is a channel. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1460bd53-4655-5341-ac76-54429c1ef659"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeTrainData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MakeTrainData"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        StyleBox["data", "TI"], 
        StyleBox["1", "TR"]], ",", 
       SubscriptBox[
        StyleBox["data", "TI"], 
        StyleBox["2", "TR"]], ",", 
       StyleBox["n", "TI"]}], "}"}], ",", ".."}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"c334e093-ea52-3e4e-92c0-dc2701c82936"],
 "\[LineSeparator]does the same for multiple pairs and joins all blends as \
channels, e.g. {{outph, inph, 6}, {wat, fat, 5}}. The output can be used as \
data for PrepareTrainingData, during training a random channel is selected \
for each sample which acts as contrast augmentation."
}], "Usage",
 CellChangeTimes->{{3.9992223068470745`*^9, 3.9992223069813004`*^9}},
 CellID->539781090,ExpressionUUID->"d830ad8a-9400-ac4d-8a23-ed75d409dcfe"],

Cell["XXXX", "Notes",
 CellID->435680699,ExpressionUUID->"d7a4425f-1679-694d-81ab-403e8fae00ab"]
}, Open  ]],

