 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "d1aa497f-e650-a343-b470-c890e66a83bc"],
 " is dilated and if ",
 Cell[BoxData[
  StyleBox["size", "TI"]], "InlineFormula",ExpressionUUID->
  "e2f81e2b-bbf3-754f-b750-47ee7d034bc9"],
