Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"78ef7517-a080-b849-95e5-16807ce62310"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DilateMask",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/DilateMask"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["size", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6394b883-bf4a-cf43-9a91-daaa716b48bf"],
