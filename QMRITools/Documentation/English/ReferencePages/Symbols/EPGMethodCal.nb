Notebook[{

Cell[CellGroupData[{
Cell["EPGMethodCal", "ObjectName",
 CellID->546524746,ExpressionUUID->"318497fc-df33-1e40-b48c-fd548c05ad34"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2ca8f7cd-580f-d642-b7d1-b274ea694ba5"],
 Cell[BoxData[
 "EPGMethodCal"], "InlineFormula",ExpressionUUID->
  "1c8ba111-96a4-d04f-a9c2-41dc423be757"],
 "\[LineSeparator]is an option for CalibrateEPGT2Fit and ",
 Cell[BoxData[
  ButtonBox["EPGT2Fit",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/EPGT2Fit"]], "InlineFormula",
  ExpressionUUID->"69ec06f4-92e3-c44f-a5e1-dab70906feef"],
 ". The calibration can be done using \"1comp\", \"2comp\", \"2compF\". \
\"1comp\" assumes pure fat, \"2comp\" assumes 90% fat and 10% water and fits \
both t2 values, \"2compF\" assumes 90% fat and 10% water with a water t2 of \
20 ms. These are method A, B and C of Keene KR et.al. DOI: 10.1002/mrm.28290."
}], "Usage",
 CellID->129540329,ExpressionUUID->"f902b5b7-6d63-e34b-b9dd-c54cc613deea"],

Cell["XXXX", "Notes",
 CellID->25103500,ExpressionUUID->"b184cdba-4e71-f641-8ccb-c0e036bb6b09"]
}, Open  ]],

