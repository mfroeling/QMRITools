Cell[CellGroupData[{
Cell["ReadTransformParameters", "ObjectName",
 CellID->523683768,ExpressionUUID->"08e7a684-af0e-2b48-a025-aa06e05dd499"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8d06059b-7c47-f747-a82f-23af18c9b038"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ReadTransformParameters",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsElastixTools/ref/ReadTransformParameters"], "[", 
   StyleBox["directory", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "63f94908-8e63-5940-bada-78c60553448b"],
 "\[LineSeparator]reads the transformation parameters generated by ",
 Cell[BoxData[
  ButtonBox["RegisterData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RegisterData"]], "InlineFormula",
  ExpressionUUID->"11e27887-9f25-5840-9916-0b53ea92e3d6"],
 ". The directory should be the ",
 Cell[BoxData[
  ButtonBox["TempDirectory",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/TempDirectory"]], "InlineFormula",
  ExpressionUUID->"42aef585-2d31-1d4f-9524-a1ef85cccfea"],
 " were the registration is stored. ",
 Cell[BoxData[
  ButtonBox["DeleteTempDirectory",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/DeleteTempDirectory"]], "InlineFormula",
  ExpressionUUID->"660ece33-fb76-414e-a601-b7300ce61337"],
 " should be False. Output is the affine transformation vector per volume."
}], "Usage",
 CellChangeTimes->{3.996655581007063*^9},
 CellID->75580612,ExpressionUUID->"348eb3ee-3c0e-8442-b580-5ada922d6a9c"],

