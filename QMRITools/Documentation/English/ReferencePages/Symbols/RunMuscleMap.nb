Notebook[{

Cell[CellGroupData[{
Cell["RunMuscleMap", "ObjectName",
 CellID->324578208,ExpressionUUID->"d487fad3-e08c-7844-bf4d-9011ef7068bb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cbc17db0-cd97-1f49-96ee-95411bbbf398"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RunMuscleMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/RunMuscleMap"], "[", 
   StyleBox["file", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1c9110d4-845a-ca44-ab18-968c2c4635b2"],
 "\[LineSeparator]will run MuscleMap segmentation on the selected nii ",
 Cell[BoxData[
  StyleBox["file", "TI"]], "InlineFormula",ExpressionUUID->
  "a9242a30-eba7-5c45-8a9c-048de93576ee"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"87a54a59-b176-ca4e-a04a-e7588209a171"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RunMuscleMap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/RunMuscleMap"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["data", "TI"], ",", 
     StyleBox["vox", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "4ba3ca20-5ca1-b746-9f10-c00fa2d0b2b5"],
 "\[LineSeparator]will run MuscleMap segmentation of the data. Using \
TargetDevice \"GPU\" (default) or \"CPU\" the device is selected. Using ",
 Cell[BoxData[
  RowBox[{"Monitor", "->", 
   ButtonBox["True",
    BaseStyle->"Link"]}]], "InlineFormula",ExpressionUUID->
  "cc3894a4-12b1-dc42-a927-35f5a6820ae6"],
 " reports the steps while running."
}], "Usage",
 CellChangeTimes->{{4.0038045699049244`*^9, 4.003804570056486*^9}},
 CellID->277125877,ExpressionUUID->"a5373cdf-4c5c-d042-9225-17bdf9360f0a"],

Cell["The following options can be given: ", "Notes",
 CellID->621400946,ExpressionUUID->"7ce3d6f3-c429-7642-b61e-6cabbacb485a"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "90d46f0f-7e32-8b4b-8216-bb6bacc58e36"], 
    ButtonBox["MuscleMapPythonEnvironment",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsSegmentationTools/ref/MuscleMapPythonEnvironment"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
MuscleMapPythonEnvironment is the path to the conda environment of the \
MuscleMap installation. Fhe folder should contain the python.exe file.\
\>", "TableText",ExpressionUUID->"d91dc305-90b2-eb48-a882-1ac935d4eaf6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e718c116-e497-934d-a2e4-51ba1f454585"], 
    ButtonBox["MuscleMapPath",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MuscleMapPath"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
MuscleMapPath is the path to the MuscleMap code that is cloned from github \
and installed according to the muscle map readme.\
\>", "TableText",ExpressionUUID->"c964634a-ddcc-274e-8ba9-2f9462b1355b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "336418ee-01d6-274f-be50-2caa70071520"], 
    ButtonBox["MuscleMapLabels",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsSegmentationTools/ref/MuscleMapLabels"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "MuscleMapLabels is an option for ",
     Cell[BoxData[
     "RunMuscleMap"], "InlineFormula",ExpressionUUID->
      "67e8f2a1-5661-ca43-996a-98ee40688b8a"],
     ". If False the MuscleMap labels are converted to the QMRITools \
\"MuscleLabels\" numbering. If ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "4c0578d1-44a8-5746-8ac4-d7c73bb55056"],
     " the original MuscleMap labels are returned."
    }], "TableText",ExpressionUUID->"0c6fce33-efa7-504d-9006-b11266f198a0"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "fcb5437b-0676-734e-816e-40c6b71bc9ec"], 
    ButtonBox["TargetDevice",
     BaseStyle->"Link"], "\"\<GPU\>\"", Cell[
    "XXXX", "TableText",ExpressionUUID->
     "a3062526-8f1e-874f-b85d-c22e87ac4260"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d69ea4ea-ed74-214a-86f5-51801f85e83a"], 
    ButtonBox["Monitor",
     BaseStyle->"Link"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Monitor", "[", 
       RowBox[{
        StyleBox["expr", "TI"], ",", 
        StyleBox["mon", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
      "6b523b5c-e21f-764a-b67a-75b6d191507c"],
     " generates a temporary monitor cell in which the continually updated \
current value of ",
     Cell[BoxData[
      StyleBox["mon", "TI"]], "InlineFormula",ExpressionUUID->
      "22e0d314-bfb1-704e-bb68-e40f76a0df13"],
     " is displayed during the course of evaluation of ",
     Cell[BoxData[
      StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
      "b5222a58-de9e-4446-867a-464492018f81"],
     ". "
    }], "TableText",ExpressionUUID->"0d1731e8-9bd3-1646-a318-797196dc29b7"]}
  }]], "3ColumnTableMod",
 CellID->93992361,ExpressionUUID->"b04057ef-780f-894a-8c9c-7163a1506a96"]
