Notebook[{

Cell[CellGroupData[{
Cell["FindPatchDim", "ObjectName",
 CellID->92750944,ExpressionUUID->"d76b98ce-2b26-dc4c-8081-226d81f4f0d3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e6545a4d-7daa-a94c-acc9-a750293e0da0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindPatchDim",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/FindPatchDim"], "[", 
   RowBox[{
    StyleBox["net", "TI"], ",", 
    StyleBox["dim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "3e7496bb-e578-2c42-b149-89de7ab3b237"],
 "\[LineSeparator]finds the largest patch size for the network ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "f5f25027-432b-4247-b1a9-783b4a16e4ed"],
 " that fits within 8 GB for data of dimensions ",
 Cell[BoxData[
  StyleBox["dim", "TI"]], "InlineFormula",ExpressionUUID->
  "6b74ee46-2c5a-944f-87c9-539b48a6087b"],
 " {z, y, x}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"be57e7f8-8e2a-a549-b760-b4bb262e81d2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindPatchDim",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/FindPatchDim"], "[", 
   RowBox[{
    StyleBox["net", "TI"], ",", 
    StyleBox["dim", "TI"], ",", 
    StyleBox["lim", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b5ca08e0-c77f-7e40-b053-088be62cbe3d"],
 "\[LineSeparator]uses a maximum memory of ",
 Cell[BoxData[
  StyleBox["lim", "TI"]], "InlineFormula",ExpressionUUID->
  "9d459d34-fef3-5c4d-8917-bd292db3bc8e"],
 " GB. Output is {memory in GB, patch size}."
}], "Usage",
 CellChangeTimes->{{4.00054262283181*^9, 4.0005426230097656`*^9}},
 CellID->178982296,ExpressionUUID->"c937a0cb-56e1-4b4e-a21c-073281dc738a"],

