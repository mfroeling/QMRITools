Notebook[{

Cell[CellGroupData[{
Cell["ExcludeSlices", "ObjectName",
 CellID->399726630,ExpressionUUID->"a8ae21d9-a07c-6f48-8236-67a237de074c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cbbb1ab7-bcfc-5246-a025-6aaa8a84a092"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ExcludeSlices",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/ExcludeSlices"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9e8e98fa-ff3c-054f-849c-68c9c89b3a8e"],
 "\[LineSeparator]excludes slices that do not look like the others based on \
various distance measures. Output is an array with 1 or 0 with the dimensions \
{slices, diff dirs}."
}], "Usage",
 CellChangeTimes->{3.996656411530527*^9},
 CellID->42266549,ExpressionUUID->"a5092039-8d3b-234f-98f8-4bcb22a5cc51"],

Cell["The following options can be given: ", "Notes",
 CellID->286684927,ExpressionUUID->"05d498f8-fd1b-9b4f-931a-66ae2ac8ec2f"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9788a92f-b0b0-2c4e-a5e7-adbc6ada7328"], 
    ButtonBox["CutOffMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/CutOffMethod"], "\"\<Auto\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["CutOffMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CutOffMethod"]], "InlineFormula",
      ExpressionUUID->"0dc53c90-5965-c34d-9b91-be410548ea93"],
     " is an option for ",
     Cell[BoxData[
     "ExcludeSlices"], "InlineFormula",ExpressionUUID->
      "a5b0e03f-165b-f443-be72-6bf9ac6ff549"],
     ". Default value is \"Auto\" or it can be a fixed percentage (value \
between 0 and .5)."
    }], "TableText",ExpressionUUID->"872061c8-cbbe-0d42-ba65-eebd281d94e5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6b1338a2-e30e-ae48-889f-13a5fb9eedb2"], 
    ButtonBox["DistanceMeasure",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/DistanceMeasure"], "5", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["DistanceMeasure",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DistanceMeasure"]], "InlineFormula",
      ExpressionUUID->"9236a602-97af-e049-9c9c-1e5ed31456f4"],
     " is an option for ",
     Cell[BoxData[
     "ExcludeSlices"], "InlineFormula",ExpressionUUID->
      "af5cb956-0d46-c446-9c7f-dd87ac50dde6"],
     ". Defaul value is 5. (1 ManhattanDistance, 2 SquaredEuclideanDistance, \
3 EuclideanDistance, 4 Correlation, 5 SpearmanRho."
    }], "TableText",ExpressionUUID->"15f7b513-7276-714a-9bf1-b430fb631add"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "6d4ba3a2-6659-d545-85b1-3475751db2c5"], 
