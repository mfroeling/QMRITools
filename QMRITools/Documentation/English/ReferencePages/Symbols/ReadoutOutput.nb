 "ReadoutOutput"], "InlineFormula",ExpressionUUID->
  "fae25316-f5b8-b045-b0f4-9dd6068f7266"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["SimReadout",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SimReadout"]], "InlineFormula",
  ExpressionUUID->"31e146b0-53b3-1342-983e-b5c23ba43f3e"],
 " and ",
 Cell[BoxData[
  ButtonBox["SimSignal",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SimSignal"]], "InlineFormula",
  ExpressionUUID->"adab71eb-1226-2345-849b-d1e9d6547529"],
 " and values can be \"all\" and \"each\". When set to \"all\" the total \
signal and signal is given, when set to \"each\" the signal or spectrum for \
each peak is given separately."
}], "Usage",
 CellID->107126098,ExpressionUUID->"def2a9c9-8181-e145-91b8-90e00830ea86"],

