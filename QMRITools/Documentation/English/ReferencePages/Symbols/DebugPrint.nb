Cell[CellGroupData[{
Cell["DebugPrint", "ObjectName",
 CellID->465578088,ExpressionUUID->"c182b32e-c6d4-6948-a822-67585cbd3e21"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"99b9b807-f552-e14e-bb04-75a6b0b096c7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DebugPrint",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGeneralTools/ref/DebugPrint"], "[", 
   RowBox[{
    StyleBox["tag", "TI"], ",", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1546e037-3eba-924e-83b1-2fb778c8a8d4"],
 "\[LineSeparator]shows ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",ExpressionUUID->
  "fc72ce07-fecc-e544-a3f3-759ce14c6d5b"],
 " with MonitorFunction, labeled [tag], if ",
 Cell[BoxData[
  StyleBox["tag", "TI"]], "InlineFormula",ExpressionUUID->
  "6d0adb28-2643-b943-bc3b-cb3b8e5e8a78"],
 " is in QMRITools`$Debug or ",
 Cell[BoxData[
  ButtonBox["$Debug",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/$Debug"]], "InlineFormula",
  ExpressionUUID->"199088f2-e09f-0a48-a7f5-0281c630cf4d"],
 " is ",
 Cell[BoxData[
  ButtonBox["All",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "15f30dbb-fb43-d946-8b21-e717171691e1"],
 ". Multiple ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",ExpressionUUID->
  "4ec00b0a-6b12-874d-a524-6826c4079c91"],
 " are joined as one line. The arguments ",
 Cell[BoxData[
  StyleBox["x", "TI"]], "InlineFormula",ExpressionUUID->
  "eee7f8f8-4c9d-e240-802a-5f0ea984e1d9"],
 " are only evaluated when shown."
}], "Usage",
 CellChangeTimes->{{4.0028728088269234`*^9, 4.002872808939022*^9}},
 CellID->128008696,ExpressionUUID->"f20af2d7-3743-054c-a16a-aaf84389576c"],

