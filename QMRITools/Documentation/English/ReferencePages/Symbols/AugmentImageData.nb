Notebook[{

Cell[CellGroupData[{
Cell["AugmentImageData", "ObjectName",
 CellID->368221649,ExpressionUUID->"09d66c5e-52d7-4d4c-a75e-c473a97e2daf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8b8c5c9a-9b84-8945-a63b-7ac4b8a0c1fa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AugmentImageData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentImageData"], "[", 
   RowBox[{
    StyleBox["image", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rotate", "TI"], ",", 
      StyleBox["flip", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"2fd66e08-4023-7940-9633-d1995e6baf3c"],
 "\[LineSeparator]augments the input ",
 Cell[BoxData[
  StyleBox["image", "TI"]], "InlineFormula",ExpressionUUID->
  "86ecbfed-7318-8541-9a24-15bfea7b9176"],
 " by rotating between -180 and 180 degrees and flipping. The inputs rotate \
and flip can be set to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "db1de09d-d080-b14e-bf55-781ca03d27b6"],
 " or False. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4bc4d4ce-14a4-ee49-8816-d1ed4d9c58d4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AugmentImageData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSegmentationTools/ref/AugmentImageData"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["image", "TI"], ",", ".."}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["rotate", "TI"], ",", 
      StyleBox["flip", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"3f26a187-a899-274f-82ad-b330907bc65b"],
 "\[LineSeparator]same but for a list of images."
}], "Usage",
 CellChangeTimes->{{3.9966562700836353`*^9, 3.996656270246578*^9}},
 CellID->8435897,ExpressionUUID->"1b57db42-5b82-3a47-acb1-71322279d35e"],

