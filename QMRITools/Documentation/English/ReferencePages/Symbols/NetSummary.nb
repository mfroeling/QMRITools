Cell[CellGroupData[{
Cell["NetSummary", "ObjectName",
 CellID->654354894,ExpressionUUID->"4bc606e5-60f2-ad4a-92be-f957516c5738"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d42d4711-2f54-2347-aa24-b5040625c974"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NetSummary",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/NetSummary"], "[", 
   StyleBox["net", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1f0a9bdf-88f5-b747-a16a-5d00201c91b9"],
 "\[LineSeparator]gives a short summary of the convolution kernels and array \
elements in the network. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"bb266bc2-bb26-be4a-bf55-437bdfc57334"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NetSummary",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNeuralNetworkTools/ref/NetSummary"], "[", 
   RowBox[{
    StyleBox["net", "TI"], ",", 
    StyleBox["what", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f91aad89-41c2-0049-9a84-65c94cf04b91"],
 "\[LineSeparator]does the same but ",
 Cell[BoxData[
  StyleBox["what", "TI"]], "InlineFormula",ExpressionUUID->
  "f43f97ad-da56-214b-8bda-32d600679298"],
 " can be \"Full\" which also includes ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "2143d09b-555d-a34d-919c-06e1e2221806"],
 " and node images or \"Mem\" which only reports the memory."
}], "Usage",
 CellChangeTimes->{{3.996656733850996*^9, 3.996656733980953*^9}},
 CellID->21321036,ExpressionUUID->"79bada43-1b10-2443-a7ef-07ec5cbcbf32"],

