Cell[CellGroupData[{
Cell["AugmentData", "ObjectName",
 CellID->208661167,ExpressionUUID->"244261cc-971e-9641-b991-4e9326fc63f6"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"547cc160-c6f0-ac4d-9f21-543410c210c5"],
 Cell[BoxData[
 "AugmentData"], "InlineFormula",ExpressionUUID->
  "84caea04-eee5-5949-9fde-cb248a3a5ac2"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["GetTrainData",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetTrainData"]], "InlineFormula",
  ExpressionUUID->"dedd13c9-89d5-9347-a697-e6606b3862d2"],
 " and ",
 Cell[BoxData[
  ButtonBox["TrainSegmentationNetwork",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/TrainSegmentationNetwork"]], 
  "InlineFormula",ExpressionUUID->"cce93ef5-e05f-0848-ba6d-c20a8c3e3acb"],
 ". If set ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "d7d346d7-a250-474a-85b2-6cb3dcae8cb5"],
 " the training data is augmented. It can also be set to \"2D\" or \"3D\" to \
control if augmentation is done through plane or only in-plane."
}], "Usage",
