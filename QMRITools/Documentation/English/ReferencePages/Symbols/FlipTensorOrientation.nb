Cell[CellGroupData[{
Cell["FlipTensorOrientation", "ObjectName",
 CellID->585889420,ExpressionUUID->"7446beab-992c-bf44-9104-16417f11469c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"58f682a1-0275-b545-a68f-248a3970b291"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "48e13c37-9f75-8c41-9762-eb5f83163a0d"],
 "\[LineSeparator]permutes the internal orientation of the tensor, ",
 Cell[BoxData[
  StyleBox["perm", "TI"]], "InlineFormula",ExpressionUUID->
  "6657ecdd-299d-3543-b703-707b0d07fa91"],
 " can be any permutation of {\"x\",\"y\",\"z\"}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"70551e36-0249-2545-9334-b45b40be9508"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4caa4c60-bce2-c34e-b52e-7ddc519a6eab"],
 "\[LineSeparator]flips the internal orientation of the tensor, ",
 Cell[BoxData[
  StyleBox["flip", "TI"]], "InlineFormula",ExpressionUUID->
  "31b95a35-ad33-604c-81ee-715832429589"],
 " can be {1,1,1}, {-1,1,1}, {1,-1,1} or {1,1,-1}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d0b2a383-c6c7-4145-8122-5e512f65f353"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["flip", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "633f3397-289f-b246-aba4-e2000de7460d"],
 "\[LineSeparator]flips and permutes the internal orientation of the tensor. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7a14e94b-bcf4-af48-ae4e-febd75e1d0f6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["perm", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "a53b38d9-b127-3e4d-98f6-29e737673081"],
 "\[LineSeparator]flips and permutes the internal orientation of the tensor."
}], "Usage",
