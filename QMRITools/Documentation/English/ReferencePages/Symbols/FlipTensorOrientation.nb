Cell[CellGroupData[{
Cell["FlipTensorOrientation", "ObjectName",
 CellID->114119917,ExpressionUUID->"2450fbe4-76a9-c243-a3fe-428776ed2816"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ac69639f-2dd8-ec4c-841e-d497fe86c7e3"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "42c4b5d6-23e4-c241-b718-5b5cdcef03d3"],
 "\[LineSeparator]permutes the internal orientation of the tensor, ",
 Cell[BoxData[
  StyleBox["perm", "TI"]], "InlineFormula",ExpressionUUID->
  "312a46f6-1009-b741-beb7-d0bc20832040"],
 " can be any permutation of {\"x\",\"y\",\"z\"}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8ad7de03-097c-6649-adaa-e083f68545bf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8c03016e-8782-2d4e-a02f-ba7634206d4c"],
 "\[LineSeparator]flips the internal orientation of the tensor, ",
 Cell[BoxData[
  StyleBox["flip", "TI"]], "InlineFormula",ExpressionUUID->
  "dd8ff2fa-01f2-8440-bb04-955c62b4f9bd"],
 " can be {1,1,1}, {-1,1,1}, {1,-1,1} or {1,1,-1}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1b1555c5-526a-7d46-ba03-8a11592d8f9b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["flip", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "810eb74a-673d-f24c-9ff9-038ab60b90e5"],
 "\[LineSeparator]flips and permutes the internal orientation of the tensor. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"10d1fa7d-705c-9a4a-8da9-46554c442b2f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["perm", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "6834b2bc-93b7-da4c-8fc5-6dea9eea11cd"],
 "\[LineSeparator]flips and permutes the internal orientation of the tensor."
}], "Usage",
