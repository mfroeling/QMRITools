Cell[CellGroupData[{
Cell["FlipTensorOrientation", "ObjectName",
 CellID->744548164,ExpressionUUID->"f187a26f-239a-d84e-9030-f53b0b474f25"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a590575c-1088-474c-accf-7ba13cfa8dcf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7d015e58-261b-8b40-8764-059ec41c7c33"],
 "\[LineSeparator]permutes the internal orientation of the tensor, ",
 Cell[BoxData[
  StyleBox["perm", "TI"]], "InlineFormula",ExpressionUUID->
  "f0442e3f-d5c2-484f-866c-2badef1f0944"],
 " can be any permutation of {\"x\",\"y\",\"z\"}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"086aef96-c751-7b44-a8b0-d372575d91d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "118e13a5-6dcd-0748-9d56-dd47eb179215"],
 "\[LineSeparator]flips the internal orientation of the tensor, ",
 Cell[BoxData[
  StyleBox["flip", "TI"]], "InlineFormula",ExpressionUUID->
  "d8b1256e-0438-2c42-9916-4d42e190d315"],
 " can be {1,1,1}, {-1,1,1}, {1,-1,1} or {1,1,-1}. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3df057ce-e4ee-cb4f-817e-9e1017c409f2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["flip", "TI"], ",", 
    StyleBox["perm", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "97eef346-f7a5-8b48-867a-48ea14613490"],
 "\[LineSeparator]flips and permutes the internal orientation of the tensor. \
\n",
 Cell["   ", "ModInfo",ExpressionUUID->"2ae2b3c6-8ab5-0d4d-bfa3-0b164e0794f9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FlipTensorOrientation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FlipTensorOrientation"], "[", 
   RowBox[{
    StyleBox["tens", "TI"], ",", 
    StyleBox["perm", "TI"], ",", 
    StyleBox["flip", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f57ba783-0ac9-0a48-92b4-affa9fd9d902"],
 "\[LineSeparator]flips and permutes the internal orientation of the tensor."
}], "Usage",
