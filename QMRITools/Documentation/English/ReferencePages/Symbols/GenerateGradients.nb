Cell[CellGroupData[{
Cell["GenerateGradients", "ObjectName",
 CellID->133298157,ExpressionUUID->"cc8f8db6-94ba-6244-8ff8-a1a3e1fcdfea"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"58da4881-ee9f-234d-bce8-fa66f41cab82"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   StyleBox["numb", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "c146a4a9-76f1-fd44-979f-0935135d9e40"],
 "\[LineSeparator]optimizes a set with ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "53b27b4e-b91f-0945-bca6-9e4cfcddfb9b"],
 " gradients,numb mus be an integer. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"af56e3ae-1f64-6c49-9acf-c9900ee8d002"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["numb", "TI"], ",", 
     StyleBox["fixed", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "02e9ff40-cc31-cc4c-b0a9-5c790071822e"],
 "\[LineSeparator]optimizes a set with ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "8824c752-6eaf-f848-8f98-a7b73f2abff9"],
 " gradients, ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "24884514-7daf-0b43-93a4-e1e43bbf87d1"],
 " must ba an integer and fixed a list of 3D coordinates e.g. \
{{0,0,1},{0,1,0}}. The fixed gradients will not be moved. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"f1a172b3-f9a7-b446-b98d-0ada9cb1bdcf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["numb", "TI"], 
       StyleBox["1", "TR"]], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["numb", "TI"], 
        StyleBox["2", "TR"]], "  ", 
       StyleBox["\[Ellipsis]", "TR"]}]}], "}"}], ",", 
    StyleBox["alpha", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "879ba7ba-7151-2c4b-a0b0-50ed70a4b9fa"],
 "\[LineSeparator]optimizes a multi shel gradient set with ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "d6dfa95f-abd0-784c-ada7-0848d2be0d3c"],
 " gradients per shel. If ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "f2d39282-7b45-a346-8ceb-44fb0d97357b"],
 " is set to 0.5 equal importance is given tothe optimal distribution of each \
shell en the enitre set. if ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "64d4522f-6bb0-714a-9347-db6f2e3a738f"],
 " is 0 only the sub shels will be optimized, if ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "b974c5eb-4858-f343-bf1b-edbf544aae42"],
 " is set to 1 only the global set wil be optimized. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"86836678-7612-bb44-b837-3e30cacdf1c4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "d9bb745a-b7c5-4043-a790-5e7958226412"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.26259 and \
10.1002/(SICI)1522-2594(199909)42:3<515::AID-MRM14>3.0.CO;2-Q."
}], "Usage",
 CellChangeTimes->{{4.003804527010784*^9, 4.003804527320711*^9}},
 CellID->64306482,ExpressionUUID->"ca2126c9-f0ec-3042-a6b9-1f35c1fbb59b"],

Cell["The following options can be given: ", "Notes",
 CellID->39966086,ExpressionUUID->"62ac8b53-d4a3-c941-a62a-7556a9b291f1"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "3a3b51d9-4500-c847-a582-d7caff9f708d"], 
    ButtonBox["Steps",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/Steps"], "1000", Cell["\<\
Steps is an option GenerateGrads and is the number of step that is used.\
\>", "TableText",ExpressionUUID->"659add22-4935-4c4d-a50f-63056c04be95"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1016bfa8-a722-e147-9f10-43e1cfeb8c44"], 
    ButtonBox["Runs",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/Runs"], "1", Cell[
    TextData[{
     "Runs is an option for ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "79b5a770-08bc-004e-bc78-a04940f604fd"],
     ". Set how often the minimization function is run. The best solution of \
all runs is the output. ",
     Cell[BoxData[
      ButtonBox["Default",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "ab640e6e-1431-c84a-af29-a61fa057d4e9"],
     " value is 1."
    }], "TableText",ExpressionUUID->"ab0ee698-99dd-a94b-acd3-a37a6ff140dc"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b43cd2da-feeb-f043-b84a-00dfa8cf4fbe"], 
    ButtonBox["VisualOpt",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/VisualOpt"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "VisualOpt is an option for ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "db369006-e6a4-914c-9dcc-09f53babef5a"],
     ". Show the minimization proces of eacht calculation step. ",
     Cell[BoxData[
      ButtonBox["Default",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "d5b84409-3bf6-ea47-922c-3870247c119e"],
     " is False."
    }], "TableText",ExpressionUUID->"cfb3a947-d14f-634d-9eb5-3fade3d23f11"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5d918284-89aa-4b4f-a4a8-039dcd736fd5"], 
    ButtonBox["GradType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsGradientTools/ref/GradType"], "\"\<Normal\>\"", Cell[
    TextData[{
     "GradType is an option ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "d34baa94-6c5f-8244-b622-2020ec2fb1b5"],
     ". It specifies what type of gradient set wil be produced, \"Normal\" or \
\"OverPlus\"."
    }], "TableText",ExpressionUUID->"78963014-a315-644f-bd2c-6e37368007e2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f8d3b396-cb23-c542-b406-ffd098b3414a"], 
    ButtonBox["ConditionCalc",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/ConditionCalc"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "ConditionCalc is an option for ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "8828ce68-dada-7543-8f89-60213d5b1bca"],
     " if set to true ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "1d706d74-c27d-594a-8ea6-7a639de59508"],
     " will also give the condition number evolution of the system."
    }], "TableText",ExpressionUUID->"892eab63-42a3-4646-b540-3fe813bb701f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f9393698-c35f-aa47-befc-e6bb469e920b"], 
    ButtonBox["FullSphere",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/FullSphere"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "FullSphere is an option for ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "f8dad2b6-a16d-9a48-9ef8-58d349392915"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "d1cb75ef-0216-2a46-b745-9b715e03dafb"],
     " the gradients will be optimized on a full sphere rather than half a \
sphere."
    }], "TableText",ExpressionUUID->"04f87cb0-4607-a84d-8339-012d490d6aa8"]}
  }]], "3ColumnTableMod",
 CellID->316116515,ExpressionUUID->"2e75ff40-899e-ea47-9d07-ea0335cbd703"]
}, Open  ]],

