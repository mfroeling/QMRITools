Cell[CellGroupData[{
Cell["GenerateGradients", "ObjectName",
 CellID->253619479,ExpressionUUID->"dd3e5e93-d738-7b4d-b30a-62382fd99fb3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b000f55d-3908-c94b-a2e5-315c10d3cc0b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   StyleBox["numb", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "ad784aab-9d67-df4f-a3b5-08bf3a003c2c"],
 "\[LineSeparator]optimizes a set with ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "e8fbb402-e87a-d449-b891-60c70f8531c0"],
 " gradients,numb mus be an integer. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"dd935416-08f8-0747-b6a2-5e0609a973f1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["numb", "TI"], ",", 
     StyleBox["fixed", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "53c3c727-6233-9c43-ac29-ef94cfb027e3"],
 "\[LineSeparator]optimizes a set with ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "41b2bb43-7331-0f48-b844-496264238796"],
 " gradients, ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "044b70dc-ad8c-3b4f-a807-369fc4a9a9d5"],
 " must ba an integer and fixed a list of 3D coordinates e.g. \
{{0,0,1},{0,1,0}}. The fixed gradients will not be moved. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2f90f476-60b5-a44b-a047-667836278f28"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["numb", "TI"], 
       StyleBox["1", "TR"]], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["numb", "TI"], 
        StyleBox["2", "TR"]], "  ", 
       StyleBox["\[Ellipsis]", "TR"]}]}], "}"}], ",", 
    StyleBox["alpha", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "bb550a32-0749-fc43-ae52-0330c3a07316"],
 "\[LineSeparator]optimizes a multi shel gradient set with ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "fb12011c-edf7-4243-aea9-2fb4d9253825"],
 " gradients per shel. If ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "4238bbe7-75f7-1e4d-b66e-72e17ad45d6f"],
 " is set to 0.5 equal importance is given tothe optimal distribution of each \
shell en the enitre set. if ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "b8341721-614f-db4c-90fb-53177eb4b5e4"],
 " is 0 only the sub shels will be optimized, if ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "8f5c8d9b-9f71-1b4d-ac78-7a8bab5b6b4b"],
 " is set to 1 only the global set wil be optimized. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"81c26b9a-20ef-d843-ad96-7e9517f2db54"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "7aaead24-3f44-8c41-abfe-5a670b4d183a"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.26259 and \
10.1002/(SICI)1522-2594(199909)42:3<515::AID-MRM14>3.0.CO;2-Q."
}], "Usage",
 CellChangeTimes->{{3.998533222497179*^9, 3.998533223159561*^9}},
 CellID->458399798,ExpressionUUID->"f3533894-edd0-e244-841c-fe40fd81a666"],

Cell["The following options can be given: ", "Notes",
 CellID->177112971,ExpressionUUID->"cf37366f-bca0-fd44-9c0c-f649c1b445a8"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5a85e95d-1d2f-ba4f-8013-1349174e7c79"], 
    ButtonBox["Steps",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/Steps"], "1000", Cell["\<\
Steps is an option GenerateGrads and is the number of step that is used.\
\>", "TableText",ExpressionUUID->"8ae9717f-572e-d848-8605-7fa0a208b840"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "03f55255-5869-5a41-8c81-b20534b58f2f"], 
    ButtonBox["Runs",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/Runs"], "1", Cell[
    TextData[{
     "Runs is an option for ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "7cd8bc63-2a0d-1c41-b456-43bf2d0aee17"],
     ". Set how often the minimization function is run. The best solution of \
all runs is the output. Default value is 1."
    }], "TableText",ExpressionUUID->"034b69ab-6dcd-ad47-9f76-aa8481108274"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b03c69ad-4cc6-a349-93ba-be5c12201b4d"], 
    ButtonBox["VisualOpt",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/VisualOpt"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "VisualOpt is an option for ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "bf5d75c3-f707-d44d-9145-cbe429cc1f2f"],
     ". Show the minimization proces of eacht calculation step. Default is \
False."
    }], "TableText",ExpressionUUID->"84bfe58f-965c-6044-a769-d6e2f492d003"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "227436e8-685c-5345-bd25-75221972756d"], 
    ButtonBox["GradType",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsGradientTools/ref/GradType"], "\"\<Normal\>\"", Cell[
    TextData[{
     "GradType is an option ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "0ad05299-8aee-0b4c-8f42-862204d2cff7"],
     ". It specifies what type of gradient set wil be produced, \"Normal\" or \
\"OverPlus\"."
    }], "TableText",ExpressionUUID->"a8450f0c-ec63-cc41-8f16-8e8fa5cc8a47"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "add21c51-3c0f-fd43-a140-bb71eb7730eb"], 
    ButtonBox["ConditionCalc",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/ConditionCalc"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "ConditionCalc is an option for ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "e1ad88e7-4f47-ab4d-b965-20b07e2476d3"],
     " if set to true ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "f1d38e71-3cb4-6244-ac00-5f6215468f18"],
     " will also give the condition number evolution of the system."
    }], "TableText",ExpressionUUID->"576d4e3e-732d-f54d-a01c-e757d627c7aa"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "df8f4c45-65a6-5240-b35e-583a1b60b118"], 
    ButtonBox["FullSphere",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsGradientTools/ref/FullSphere"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     "FullSphere is an option for ",
     Cell[BoxData[
     "GenerateGradients"], "InlineFormula",ExpressionUUID->
      "a54d2056-8481-cb43-95f7-7d662141de5c"],
     ". If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "ce9a554f-2db9-db49-adb9-e50b14ab7508"],
     " the gradients will be optimized on a full sphere rather than half a \
sphere."
    }], "TableText",ExpressionUUID->"355c9da7-eabf-f748-bf28-b00e18fc2773"]}
  }]], "3ColumnTableMod",
 CellID->691178475,ExpressionUUID->"96933bd7-19f1-ce4d-8540-b43f522a38bb"]
