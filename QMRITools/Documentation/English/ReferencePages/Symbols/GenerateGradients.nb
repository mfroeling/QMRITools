Cell[CellGroupData[{
Cell["GenerateGradients", "ObjectName",
 CellID->6307027,ExpressionUUID->"6440da03-ffbd-e542-9686-58517e4bc1bd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ef50b57f-bb73-034a-835f-950f62770b83"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   StyleBox["numb", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "59b1d337-9dd8-7f44-bdd0-596aad3f8b64"],
 "\[LineSeparator]optimizes a set with ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "93aed877-2d12-b94d-be10-32f73627da2b"],
 " gradients,numb mus be an integer. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a7e434a6-2828-dc42-ab11-a68a0e5800cf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["numb", "TI"], ",", 
     StyleBox["fixed", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "3afe0f86-99ad-9e4d-913f-a0574bddaa92"],
 "\[LineSeparator]optimizes a set with ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "f579b33b-d5db-0340-abfc-651db24262e5"],
 " gradients, ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "936a96cc-c1b7-5840-9552-3cce4f39c70e"],
 " must ba an integer and fixed a list of 3D coordinates e.g. \
{{0,0,1},{0,1,0}}. The fixed gradients will not be moved. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"cabb9db0-5b4d-7243-8c6f-a542412afcb0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["numb", "TI"], 
       StyleBox["1", "TR"]], ",", 
      RowBox[{
       SubscriptBox[
        StyleBox["numb", "TI"], 
        StyleBox["2", "TR"]], "  ", 
       StyleBox["\[Ellipsis]", "TR"]}]}], "}"}], ",", 
    StyleBox["alpha", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0f638082-fe45-ef4f-aa68-c99700e2c6a7"],
 "\[LineSeparator]optimizes a multi shel gradient set with ",
 Cell[BoxData[
  StyleBox["numb", "TI"]], "InlineFormula",ExpressionUUID->
  "01e4fcb7-b21a-1847-ac2c-9c33856f3d38"],
 " gradients per shel. If ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "dc9f2b95-0ec3-ed45-9116-43991e65f92f"],
 " is set to 0.5 equal importance is given tothe optimal distribution of each \
shell en the enitre set. if ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "f40e5742-5c35-f549-9a0d-f7247f96ced3"],
 " is 0 only the sub shels will be optimized, if ",
 Cell[BoxData[
  StyleBox["alpha", "TI"]], "InlineFormula",ExpressionUUID->
  "07b183e4-f11f-bc4a-99ec-fc6ac751747f"],
 " is set to 1 only the global set wil be optimized. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"7768f538-5107-8c43-8fe8-d86f6ad9f71b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["GenerateGradients",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsGradientTools/ref/GenerateGradients"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "44e125a2-a34f-be49-ac9a-b43a57c6e73d"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.26259 and \
10.1002/(SICI)1522-2594(199909)42:3<515::AID-MRM14>3.0.CO;2-Q."
}], "Usage",
 CellChangeTimes->{{3.9966556968875427`*^9, 3.996655697217848*^9}},
 CellID->117561161,ExpressionUUID->"5fa163c5-e027-7140-be67-49b11939ccea"],

