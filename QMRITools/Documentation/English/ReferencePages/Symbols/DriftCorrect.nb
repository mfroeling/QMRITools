Notebook[{

Cell[CellGroupData[{
Cell["DriftCorrect", "ObjectName",
 CellID->416154079,ExpressionUUID->"c7b60995-5d16-0d47-ba59-bc405f4cb7eb"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"832a6502-fad8-c24e-bb15-48e141bb1a28"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DriftCorrect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/DriftCorrect"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["bval", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "89ff984e-7312-3e43-af1f-bff3354e0a4b"],
 "\[LineSeparator]drift corrects the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "6bfcaf4c-c345-0b4b-b1aa-594a109f67d5"],
 " using the signals of the lowest bvalue that has 5 or more unique volumes. \
For the function to work optimal it is best to have these volumes evenly \
spread throughout the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "948c0fcf-027c-c046-8cf3-f7f0ef5162ec"],
 " and for the first and last volume to have this low bvalue. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"ec68cdb4-c284-4849-826d-28211cf6fd00"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DriftCorrect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/DriftCorrect"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"f13587c4-433e-6f46-b18c-d26f0c098492"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.26124."
}], "Usage",
 CellChangeTimes->{{3.998533206522438*^9, 3.9985332066917763`*^9}},
 CellID->29124603,ExpressionUUID->"8150fe9f-1c34-884b-bcc2-a2e20c875463"],

