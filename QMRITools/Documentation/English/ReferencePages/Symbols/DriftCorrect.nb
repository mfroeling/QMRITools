Notebook[{

Cell[CellGroupData[{
Cell["DriftCorrect", "ObjectName",
 CellID->235669636,ExpressionUUID->"3bad4625-9c25-8740-8647-27f6d8914dbc"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"223abf3b-97b5-044b-b78f-8b14f3ece3c7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DriftCorrect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/DriftCorrect"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["bval", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9ece0126-17bb-8a42-9ef1-7c1b70ddf405"],
 "\[LineSeparator]drift corrects the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "54975de2-a84d-4644-bf93-a7e956f90cec"],
 " using the signals of the lowest bvalue that has 6 or more unique volumes. \
For the function to work optimal it is best to have these volumes evenly \
spread throughout the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "8735702d-7612-4e40-be1d-02950d435704"],
 " and for the first and last volume to have this low bvalue. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"5c876f65-cbd9-d948-ae8f-cd25eaf54280"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DriftCorrect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/DriftCorrect"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"eb031728-1c79-a749-a2e9-536f1c16b469"],
 "\[LineSeparator]is based on DOI: 10.1002/mrm.26124."
}], "Usage",
 CellChangeTimes->{{3.9966566428900967`*^9, 3.9966566430086*^9}},
 CellID->111798195,ExpressionUUID->"f5497e1d-688b-6a41-9dbe-2d0af62c57c4"],

