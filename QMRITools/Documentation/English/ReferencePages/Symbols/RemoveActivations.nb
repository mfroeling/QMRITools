Notebook[{

Cell[CellGroupData[{
Cell["RemoveActivations", "ObjectName",
 CellID->62723646,ExpressionUUID->"12c93e67-1c4b-2446-88f1-0fbd7b16e751"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4253c18c-506a-a842-bea2-41e82523692f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RemoveActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/RemoveActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    StyleBox["keys", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ebcc792e-c096-464a-8eea-d6b4702f975a"],
 "\[LineSeparator]removes the activations given by ",
 Cell[BoxData[
  StyleBox["keys", "TI"]], "InlineFormula",ExpressionUUID->
  "f819df75-b25b-ec4f-895d-3d864056ea4a"],
 " from the activation map ",
 Cell[BoxData[
  StyleBox["act", "TI"]], "InlineFormula",ExpressionUUID->
  "5d7e8063-ca16-c846-aaae-8f281c6eb449"],
 ", where ",
 Cell[BoxData[
  StyleBox["keys", "TI"]], "InlineFormula",ExpressionUUID->
  "ee2872c3-492c-7e44-91d4-2d7f0573e4b5"],
 " is a list of {slice, volume, component} as given by ",
 Cell[BoxData[
  ButtonBox["ListActivations",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ListActivations"]], "InlineFormula",
  ExpressionUUID->"aeaffc55-7c87-464b-a95c-e59baee6bb71"],
 ". act must be the same map that was given to ",
 Cell[BoxData[
  ButtonBox["ListActivations",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ListActivations"]], "InlineFormula",
  ExpressionUUID->"62b065fd-6e1a-2142-9d0a-4c58e3c53321"],
 ", otherwise the component numbers do not match. The output is the \
activation map without those activations."
}], "Usage",
 CellChangeTimes->{{4.004686673203186*^9, 4.0046866732694626`*^9}},
 CellID->21062548,ExpressionUUID->"747b0fe1-12ba-7646-bd8a-7b5c7fcb6667"],

Cell["XXXX", "Notes",
 CellID->118715858,ExpressionUUID->"1e1635d7-fee7-ef47-ba72-b88d1e50c6a0"]
}, Open  ]],

