Cell["PlotSegments", "ObjectName",
 CellID->371959926,ExpressionUUID->"b87ea627-1360-c24c-8f78-14aaa8aebeef"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e4468495-fc5b-e544-a6bb-90c6aab7bc60"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotSegments",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/PlotSegments"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["data", "TI"], ",", 
    StyleBox["segang", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "84822b5f-7415-3c4e-abe2-35e6bb99449a"],
 "\[LineSeparator]shows how the heart wil be sampled by ",
 Cell[BoxData[
  ButtonBox["RadialSample",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/RadialSample"]], "InlineFormula",
  ExpressionUUID->"f05b0f31-6908-bc4b-b741-92ae58051f6d"],
 ". mask is a mask the left ventricle that was used in the ",
 Cell[BoxData[
  ButtonBox["CardiacSegment",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CardiacSegment"]], "InlineFormula",
  ExpressionUUID->"55a38f59-2fd9-0949-a64c-58824d24a387"],
 ". function and the segang is the output of the cardiac SegmentFunction. \
Output is a plot window."
}], "Usage",
 CellChangeTimes->{3.996656615370466*^9},
 CellID->159985547,ExpressionUUID->"8be2ed05-b120-a44a-b491-75ceba1538ef"],

