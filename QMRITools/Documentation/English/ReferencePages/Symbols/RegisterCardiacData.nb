  "e2a34a6b-42fe-0d45-9a8d-d7323efa95cc"],
 "\[LineSeparator]registers the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "807395af-1ef0-0d4e-96dd-167318ebbb86"],
