    RowBox[{
     StyleBox["data", "TI"], ",", 
     StyleBox["mask", "TI"]}], "}"}], "]"}]], "InlineFormula",ExpressionUUID->
  "13ad3699-01c9-ae48-8d7a-75a32de1e487"],
 "\[LineSeparator]registers the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "23274618-2b9a-3b4f-81ff-87165e636553"],
 " series only using ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "f09aec4d-366d-6446-8893-17e36f2fd52c"],
 " within the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
