Cell[CellGroupData[{
Cell["PCAClipping", "ObjectName",
 CellID->10711336,ExpressionUUID->"2d157187-512d-1046-91f2-ef1aa25d81b3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"575dbae9-a273-334c-aefd-d58f80b054fd"],
 Cell[BoxData[
 "PCAClipping"], "InlineFormula",ExpressionUUID->
  "e03a097a-4989-5d47-8926-822c6db794ff"],
 "\[LineSeparator]is an option of ",
 Cell[BoxData[
  ButtonBox["PCADeNoise",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/PCADeNoise"]], "InlineFormula",
  ExpressionUUID->"4a8629cd-99ea-4d4c-bed1-c57da94e0357"],
 " and can be ",
 Cell[BoxData[
  ButtonBox[
   ButtonBox["True",
    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "b0b2785e-f326-6141-99ca-2fd3264f7fc6"],
 " of False. If True the output is clipped between 0.9 times the minimum and \
1.1 times the maximum absolute value of the input data."
}], "Usage",
 CellChangeTimes->{{4.0038045560466633`*^9, 4.003804556055725*^9}},
