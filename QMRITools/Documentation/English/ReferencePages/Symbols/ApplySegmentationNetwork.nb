Cell[CellGroupData[{
Cell["ApplySegmentationNetwork", "ObjectName",
 CellID->30960457,ExpressionUUID->"716bd1d9-c283-7040-be03-188e1230d34b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"62481c6b-f330-fc4a-acd8-059b313d6f0d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ApplySegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/ApplySegmentationNetwork"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["net", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "ee2240f2-35f2-644a-bbd2-2c50bef6e277"],
 "\[LineSeparator]segments ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "c309d99f-d480-2146-bcf1-fccf2a7b7f8d"],
 " using ",
 Cell[BoxData[
  StyleBox["net", "TI"]], "InlineFormula",ExpressionUUID->
  "80cda6e4-f8ef-5d4e-becf-e730abd78ea1"],
 ". Data can be an array or a nii file path. Net can be a network name, file, \
or NetGraph. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"64d1649f-1f28-5049-b0e1-cf4edef795b9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ApplySegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/ApplySegmentationNetwork"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["net", "TI"], ",", 
    StyleBox["node", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b6e18fef-745e-d642-b2ef-d48b8e812385"],
 "\[LineSeparator]returns the network output at the specified intermediate ",
 Cell[BoxData[
  StyleBox["node", "TI"]], "InlineFormula",ExpressionUUID->
  "eb49aa86-cc04-6f47-95f5-f2ccdbbf9168"],
 " rather than the final segmentation. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c05019a3-517f-b04c-9f0c-73141237ab30"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ApplySegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/ApplySegmentationNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["datFol", "TI"], ",", 
      StyleBox["outFol", "TI"]}], "}"}], ",", 
    StyleBox["net", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "823ce028-cea0-054c-a6ef-73bced00e626"],
 "\[LineSeparator]processes all nii files in datFol and saves results to \
outFol. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c29c3590-5a18-8043-a3b1-2a0772a80199"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ApplySegmentationNetwork",
    BaseStyle->"Link",
    ButtonData->
     "paclet:QMRIToolsSegmentationTools/ref/ApplySegmentationNetwork"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        StyleBox["datFol", "TI"], ",", 
        StyleBox["outFol", "TI"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["inTag", "TI"], ",", 
        StyleBox["outTag", "TI"]}], "}"}]}], "}"}], ",", 
    StyleBox["net", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "78f1cbd1-a0a4-1e4a-8990-723ed1c931ec"],
 "\[LineSeparator]uses custom file tags to find input and name output files."
}], "Usage",
 CellChangeTimes->{{3.996655577707407*^9, 3.99665557809746*^9}},
