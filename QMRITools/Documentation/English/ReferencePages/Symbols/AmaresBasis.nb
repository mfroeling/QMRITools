Notebook[{

Cell[CellGroupData[{
Cell["AmaresBasis", "ObjectName",
 CellID->201379345,ExpressionUUID->"b7e15036-ac37-c142-a5c4-30667efe7c2b"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a7eaaaab-73ea-684d-8279-a47724f5cde1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresBasis",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresBasis"], "[", 
   RowBox[{
    StyleBox["settings", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["metabolites", "TI"], ",", 
      StyleBox["split", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"e36e9814-1c8e-cc49-a472-957bf212b48f"],
 "\[LineSeparator]generates basis function needed for amaris fitting. The ",
 Cell[BoxData[
  StyleBox["settings", "TI"]], "InlineFormula",ExpressionUUID->
  "f4bbd96a-b46d-074d-ace0-5c91c86f0f0a"],
 " are defined as {nsamp, bw, field, nuc, te, f0} and the metabolites are a \
memmber of \"PE\", \"PC\", \"Piin\", \"Piex\", \"GPE\", \"GPC\", \"PTDC\", \
\"PCr\", \"ATP\", \"NAD\" and \"UDPG\". When \"ATP\" is defined in split the \
3 ATP peaks will be separate spectra to fit. The output is {basisFunc, {time, \
ppm, gyro}} where basisFunc is an Association."
}], "Usage",
 CellChangeTimes->{{3.995101407010521*^9, 3.9951014070703106`*^9}},
 CellID->458599877,ExpressionUUID->"b6c7476d-a57e-9347-88d4-d3d4eebf921b"],

Cell["XXXX", "Notes",
 CellID->354172823,ExpressionUUID->"66ec9090-ca50-554c-95f4-9a41c3cdf746"]
}, Open  ]],

