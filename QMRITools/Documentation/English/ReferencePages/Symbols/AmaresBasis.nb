Notebook[{

Cell[CellGroupData[{
Cell["AmaresBasis", "ObjectName",
 CellID->261209530,ExpressionUUID->"bafd5be8-01f6-3146-8b73-539a923adcfa"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bd257db1-ba4d-0842-b160-7ee4503acfe7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresBasis",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresBasis"], "[", 
   RowBox[{
    StyleBox["settings", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["metabolites", "TI"], ",", 
      StyleBox["split", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"3a46d4ad-abcb-a04b-9ed4-96ce75f6fee3"],
 "\[LineSeparator]generates basis function needed for Amares fitting. The ",
 Cell[BoxData[
  StyleBox["settings", "TI"]], "InlineFormula",ExpressionUUID->
  "eead297a-5e11-1e49-9f22-8bac0cb3b1ca"],
 " are defined as {nSamp, bw, field, nuc, te, f0} and the metabolites are a \
member of \"PE\", \"PC\", \"Piin\", \"Piex\", \"GPE\", \"GPC\", \"PTDC\", \
\"PCr\", \"ATP\", \"NAD\" and \"UDPG\". When \"ATP\" is defined in split the \
3 ATP peaks will be separate spectra to fit. The output is {basisFunc, {time, \
ppm, gyro}} where basisFunc is an Association."
}], "Usage",
 CellChangeTimes->{{3.996656710168049*^9, 3.996656710224375*^9}},
 CellID->117738894,ExpressionUUID->"0d69fc81-b88c-ba4f-8bb0-61035b0a41f0"],

Cell["XXXX", "Notes",
 CellID->68163469,ExpressionUUID->"985630bd-9aa8-a14d-b967-cbfec0fdb534"]
}, Open  ]],

