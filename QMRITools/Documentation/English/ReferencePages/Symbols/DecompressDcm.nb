Notebook[{

Cell[CellGroupData[{
Cell["DecompressDcm", "ObjectName",
 CellID->80138264,ExpressionUUID->"81f41ec7-7595-1f4b-8ce1-8cb2d556f46f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1d115a9e-ad54-1b42-891f-d7efc539dab2"],
 Cell[BoxData[
 "DecompressDcm"], "InlineFormula",ExpressionUUID->
  "5236f2db-de95-f845-b88a-0c76ba3bc7ab"],
 "\[LineSeparator]is an option for DcmToNii. If set ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "105a1015-a5ce-9f4b-8e09-53f8cb2d6839"],
 ", all dcm files in the input folder are decompressed with dcmdjpeg.exe \
(DCMTK) before the conversion. This is needed for JPEG2000 or JPEG-LS \
compressed dicom that dcm2niix cannot read. Only for Windows. Note that the \
input files are overwritten, so use a copy of the data."
}], "Usage",
 CellChangeTimes->{4.0026958082127495`*^9},
 CellID->892733871,ExpressionUUID->"1653c559-1f40-6d42-b5e6-924807ff4ccc"],

