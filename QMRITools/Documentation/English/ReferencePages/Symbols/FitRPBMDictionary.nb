Notebook[{

Cell[CellGroupData[{
Cell["FitRPBMDictionary", "ObjectName",
 CellID->83397474,ExpressionUUID->"21820aa3-e9f1-9d44-8b4d-5eb74e26e440"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6fbf305b-262f-0146-9a87-4aab87494ce4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FitRPBMDictionary",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTensorTools/ref/FitRPBMDictionary"], "[", 
   RowBox[{
    StyleBox["sig", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["pars", "TI"], ",", 
      StyleBox["sim", "TI"]}], "}"}], ",", 
    StyleBox["snr", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "94ec5aa8-8274-1444-9514-becb8bb7c4c3"],
 "\[LineSeparator]fits the RPBM function to the simulated data ",
 Cell[BoxData[
  StyleBox["sig", "TI"]], "InlineFormula",ExpressionUUID->
  "e118c94a-9f44-3b47-abf2-c850cdf90d56"],
 " using the parameters pars and the simulated data sim. The needed \
dictionary {pars, sim} is generated using ",
 Cell[BoxData[
  ButtonBox["CreateRPBMDictionary",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CreateRPBMDictionary"]], "InlineFormula",
  ExpressionUUID->"000cc41b-5df9-c14d-aa53-71ee54f21a93"],
 ". The snr is the estimated snr values of the data. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"fc6a77a1-7ba5-9c4e-b008-32bea1845c77"],
 "FitRPBMDictionary[sig,",
 Cell[BoxData[
  StyleBox[
   RowBox[{"{", "pars"}], "TI"]], "InlineFormula",ExpressionUUID->
  "8a0f4758-ec4b-fe41-b278-4f56a2243fd8"],
 ",sim},snr,d0]\[LineSeparator]does the same but fixes the initial diffusion \
to the given ",
 Cell[BoxData[
  StyleBox["d0", "TI"]], "InlineFormula",ExpressionUUID->
  "cd27869e-efd2-114b-bc81-c9b4f08d3253"],
 "."
}], "Usage",
 CellChangeTimes->{{3.9966556978373356`*^9, 3.9966556979276714`*^9}},
 CellID->471597974,ExpressionUUID->"efc07423-0b46-8f46-be70-643dd7238dad"],

Cell["XXXX", "Notes",
 CellID->798028400,ExpressionUUID->"4fda3c14-c112-7b4d-a5bb-aa59aefe0f69"]
}, Open  ]],

