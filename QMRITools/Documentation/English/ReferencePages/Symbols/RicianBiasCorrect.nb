Notebook[{

Cell[CellGroupData[{
Cell["RicianBiasCorrect", "ObjectName",
 CellID->491018556,ExpressionUUID->"b7d9f4cf-f32f-3340-9109-b721a23d5eb4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"af6c0444-1437-f74b-a47a-729d2c10ea87"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RicianBiasCorrect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/RicianBiasCorrect"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["sigma", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "adc1a3a3-a431-194e-b65a-2a9df79ca147"],
 "\[LineSeparator]corrects the Rician noise bias of magnitude ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "b3c144d8-0537-a945-b4cc-a7538a0c400e"],
 " (the expected magnitude is larger than the noise free signal at low SNR). \
The ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "9640d8f9-354c-a34d-a88c-b34ab0e8293f"],
 " can be {z, y, x} or {z, t, y, x}. The ",
 Cell[BoxData[
  StyleBox["sigma", "TI"]], "InlineFormula",ExpressionUUID->
  "5e6de293-db04-3b46-a1d8-c50569f05e2c"],
 " is the standard deviation of the noise in the magnitude ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "d8506322-82cd-fd44-bdce-800b87546b76"],
 " (as given by PCADeNoise), and can be a single value or a map {z, y, x}. \
Voxels with ",
 Cell[BoxData[
  StyleBox["sigma", "TI"]], "InlineFormula",ExpressionUUID->
  "aeb2b995-6a3e-be44-aa12-4f119aca56af"],
 " 0 are not changed. Output is the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "45d45b64-7e0e-1944-a37c-c03560e80d84"],
 " corrected for the noise bias. The option Method can be \"Exact\" (default, \
the mean and std of the Rice distribution are inverted, which also gives the \
Gaussian sigma) or \"Approximate\" (sqrt[data^2 - sigma^2],valid for SNR > \
3). \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0ed6c6e6-a08f-bf49-b918-de6ae3940499"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RicianBiasCorrect",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDenoiseTools/ref/RicianBiasCorrect"], "[", 
   "]"}]], "InlineFormula",ExpressionUUID->
  "e6e4ee58-84de-f54e-b9b2-78f3da0f834e"],
 "\[LineSeparator]is based on DOI: 10.1016/j.jmr.2005.09.018 and \
10.1016/j.neuroimage.2018.07.066."
}], "Usage",
 CellChangeTimes->{{4.002695810636635*^9, 4.0026958107832584`*^9}},
 CellID->87425432,ExpressionUUID->"d8365c5f-a7bf-594a-895d-0b603c296a44"],

Cell["The following options can be given: ", "Notes",
 CellID->221871122,ExpressionUUID->"acbcc536-f943-2348-9083-8e93a8c56924"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "590b66e9-d06a-d84b-ba8e-59ce7ab9a093"], 
    ButtonBox["Method",
     BaseStyle->"Link"], "\"\<Exact\>\"", Cell["\<\
Method is an option for various algorithm-intensive functions that specifies \
what internal methods they should use.\
\>", "TableText",ExpressionUUID->"abea1867-ec1a-b545-b7c6-cfb51feb7697"]}
  }]], "3ColumnTableMod",
 CellID->52115819,ExpressionUUID->"909f1956-f027-a242-a8a7-cf6691418f36"]
}, Open  ]],

