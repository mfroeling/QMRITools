Notebook[{

Cell[CellGroupData[{
Cell["ImportNii", "ObjectName",
 CellID->448652503,ExpressionUUID->"2bf34830-4a9b-ba41-a4a0-a0ffdba22bdd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ffd04667-b149-324e-9af5-a17f4cf6334e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ImportNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ImportNii"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"907ee279-cf06-de4a-bed6-8d8efcc6eaa1"],
 "\[LineSeparator]prompts to select the nii file to import. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2f5a399d-1a85-cf41-ac33-f688de7fb939"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ImportNii",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ImportNii"], 
   "[", "\"\<\!\(\*StyleBox[\"file\", \"TI\"]\)\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"acb8b9ba-db34-2f48-873f-e159de1de985"],
 "\[LineSeparator]imports the nii file. The default output is {data, vox}, \
however using ",
 Cell[BoxData[
  ButtonBox["NiiMethod",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/NiiMethod"]], "InlineFormula",
  ExpressionUUID->"d15bcdee-b796-f04c-871b-037fbe17260e"],
 " various outputs can be given. The Nii import is also supported using the \
native Import function from Mathematica."
}], "Usage",
 CellChangeTimes->{{3.9966567997164917`*^9, 3.9966567997815094`*^9}},
 CellID->14041267,ExpressionUUID->"f5c6693f-570d-3942-82a2-e4b73a3c092f"],

Cell["The following options can be given: ", "Notes",
 CellID->40961807,ExpressionUUID->"ca0c417c-6d44-0d4d-8cdd-3d9d1a91a70d"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "e365a367-6460-1f4c-8d3e-419f8e88ab36"], 
    ButtonBox["NiiMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NiiMethod"], "\"\<default\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["NiiMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NiiMethod"]], "InlineFormula",
      ExpressionUUID->"f81055a3-8592-fd43-9c69-e5bac5a949db"],
     " is an option for ImportNIi. Values can be \"data\", \"dataTR\", \
\"header\", \"scaling\", \"headerMat\", \"rotation\", \"all\"."
    }], "TableText",ExpressionUUID->"b5f1bb72-6caa-6d48-9508-b64b31d8e94b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4ab06258-574a-964c-b66b-b0280e5a94de"], 
    ButtonBox["NiiScaling",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NiiScaling"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["NiiScaling",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NiiScaling"]], "InlineFormula",
      ExpressionUUID->"f05d3998-0de0-674d-8acd-8a033a36f8c9"],
     " is an option for ",
     Cell[BoxData[
     "ImportNii"], "InlineFormula",ExpressionUUID->
      "aa2c1911-519f-8d42-b6bf-65c2f24909f7"],
     ". It scales the nii values with scale slope and offset for quantitative \
data."
    }], "TableText",ExpressionUUID->"0783db95-f9bb-6e4a-870f-059fb4cc6842"]}
  }]], "3ColumnTableMod",
 CellID->95824444,ExpressionUUID->"5875808c-67a8-c44c-bce9-6be83d847c8a"]
}, Open  ]],

