Notebook[{

Cell[CellGroupData[{
Cell["DixonPrecessionCheck", "ObjectName",
 CellID->5501095,ExpressionUUID->"f9e00647-d735-8f40-ac87-ac5ce59bc687"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"82e51f85-8a2e-994e-bda9-b818af40fa76"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DixonPrecessionCheck",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonPrecessionCheck"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["real", "TI"], ",", 
      StyleBox["imag", "TI"]}], "}"}], ",", 
    StyleBox["echos", "TI"], ",", 
    StyleBox["fatFraction", "TI"], ",", 
    StyleBox["phib", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "1b5f3bfd-5f65-754b-9e43-bb4a324df597"],
 "\[LineSeparator]checks if the fitted data matches the precession sense of \
the fat model (DixonPrecessions). real and imag are {z, echo, y, x}, ",
 Cell[BoxData[
  StyleBox["echos", "TI"]], "InlineFormula",ExpressionUUID->
  "ed3ed697-851f-5140-a071-86d55af7431f"],
 " in s, ",
 Cell[BoxData[
  StyleBox["fatFraction", "TI"]], "InlineFormula",ExpressionUUID->
  "e90ca472-4b3d-714c-b497-ea1926660578"],
 " the fitted fat fraction and ",
 Cell[BoxData[
  StyleBox["phib", "TI"]], "InlineFormula",ExpressionUUID->
  "7fcaa71e-b75a-454e-bc87-866943a3d7b0"],
 " the fitted bipolar phase in cycles, or 0. A fixed random sample of the \
voxels with the highest fat fraction (above the 0.9 quantile) is fitted with \
a water fat model for both precession senses. Output is {ratio, result}, \
where ratio is the residual of the current sense divided by that of the \
opposite sense and result is \"ok\" (ratio < 0.9), \"undecided\" or \
\"opposite precession fits better\" (ratio > 1.1)."
}], "Usage",
 CellChangeTimes->{{4.003433398191021*^9, 4.0034333982577744`*^9}},
 CellID->183038058,ExpressionUUID->"5a5f59bc-af79-3b43-89cd-cbd141ace3ae"],

Cell["The following options can be given: ", "Notes",
 CellID->77990046,ExpressionUUID->"77f66bc3-034f-bf4b-93cc-5b12c2d3d870"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f0f246d5-f5f3-e747-ad15-38817ade8699"], 
    ButtonBox["DixonPrecessions",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonPrecessions"], "1", 
    Cell["\<\
DixonPrecessions is an option for DixonReconstruct. Defines the rotation of \
the signal {-1,1} default is 1.\
\>", "TableText",ExpressionUUID->"8f7ce20a-4eb5-574d-af42-4225afbfe30f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "5b3d7513-e6e2-914d-b14b-ff71954a2e39"], 
    ButtonBox["DixonFieldStrength",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonFieldStrength"], "3", 
    Cell["\<\
DixonFieldStrength is an option for DixonReconstruct. Defines the \
fieldstrengths in Tesla on which the data was acquired.\
\>", "TableText",ExpressionUUID->"20d72913-f8ae-9842-8089-c0800dafd75f"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "851882a5-5c27-f947-8d43-df9ffe4cb6c9"], 
    ButtonBox["DixonNucleus",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonNucleus"], "\"\<1H\>\"",
     Cell["\<\
DixonNucleus is an option for DixonReconstruct. Defines the nucleus for which \
the reconstruction is performed.\
\>", "TableText",ExpressionUUID->"d7f02b19-ac39-3844-adb8-51fadc4918c6"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4b21f417-dd73-2d4f-9821-05fadfce2bdb"], 
    ButtonBox["DixonFrequencies",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonFrequencies"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "0.", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3.81"}], ",", " ", 
        RowBox[{"-", "3.4"}], ",", " ", 
        RowBox[{"-", "3.12"}], ",", " ", 
        RowBox[{"-", "2.67"}], ",", " ", 
        RowBox[{"-", "2.45"}], ",", " ", 
        RowBox[{"-", "1.94"}], ",", " ", 
        RowBox[{"-", "0.63"}], ",", " ", 
        RowBox[{"-", "0.4"}], ",", " ", "0.52", ",", " ", "0.62"}], "}"}]}], 
     "}"}], Cell["\<\
DixonFrequencies is an option for DixonReconstruct. Defines the frequencies \
in ppm of the fat peaks being used.\
\>", "TableText",ExpressionUUID->"c52c193c-930c-6647-ae0c-2b6f34f37f81"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ae2c8feb-f10d-b149-81ab-defef1e5f367"], 
    ButtonBox["DixonAmplitudes",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsDixonTools/ref/DixonAmplitudes"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "1", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "0.089", ",", " ", "0.577", ",", " ", "0.059", ",", " ", "0.093", ",", 
        " ", "0.059", ",", " ", "0.013", ",", " ", "0.02", ",", " ", "0.02", ",",
         " ", "0.01", ",", " ", "0.059"}], "}"}]}], "}"}], Cell["\<\
DixonAmplitudes is an option for DixonReconstruct. Defines the relative \
amplitudes of the fat peaks being used. Can also be a fat model string, \
\"Fixed\", \"Full\", \"FitCL\", \"FitDB\", \"FitIDB\", \"CallCL\", \"CallDB\" \
or \"CallIDB\", see GenerateAmps.\
\>", "TableText",ExpressionUUID->"25eda36a-c596-614b-803b-4f3bd812b4c5"]}
  }]], "3ColumnTableMod",
 CellID->191905952,ExpressionUUID->"fba1fdc0-b8f6-ea46-96d4-820da340a200"]
}, Open  ]],

