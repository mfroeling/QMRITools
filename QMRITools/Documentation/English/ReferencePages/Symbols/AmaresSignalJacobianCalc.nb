Notebook[{

Cell[CellGroupData[{
Cell["AmaresSignalJacobianCalc", "ObjectName",
 CellID->234816088,ExpressionUUID->"194161a7-fd7f-5c41-ae04-4de6c77e2f91"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8e068cfd-00fe-c047-bed9-de3326d4a782"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresSignalJacobianCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresSignalJacobianCalc"], "[", 
   RowBox[{
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["pars", "TI"], ",", 
    StyleBox["gyro", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "044dae9e-0dfc-5c4d-897c-f5bcdd0e73a0"],
 "\[LineSeparator]generates a fid and the Jacobian from the ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "53c44842-143a-0c4f-9951-a736d0b77c9a"],
 " functions according to ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "e66d3c89-0eef-0a46-b965-d3875ea14d3d"],
 " and ",
 Cell[BoxData[
  StyleBox["pars", "TI"]], "InlineFormula",ExpressionUUID->
  "149c8e74-1796-f543-87eb-e81ae7361f5d"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1ba9cffd-ef23-b34c-9832-bc480ca33dbf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresSignalJacobianCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresSignalJacobianCalc"], "[", 
   RowBox[{
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["time", "TI"], ",", 
    StyleBox["pars", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox[
      RowBox[{"1", "Pars"}], "TI"]], ",", 
    StyleBox["gyro", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "92acab10-5af9-9242-8d82-4ab1e81a065c"],
 "\[LineSeparator]also generates a fid but also using the B1 effect if set ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "d53f3238-d967-494d-a131-fc23046dbcc9"],
 " in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "414137c9-e3d7-aa43-bf42-fb5a2d40b074"],
 ". The values of ",
 Cell[BoxData[
  StyleBox["b1Pars", "TI"]], "InlineFormula",ExpressionUUID->
  "f7a9eabe-949c-8c43-99a3-85282dc873f4"],
 " are {tau, fa, TR} with tau and TR in ms and fa in degrees."
}], "Usage",
 CellChangeTimes->{{3.996655578878233*^9, 3.996655579145359*^9}},
 CellID->106201651,ExpressionUUID->"71d4aa83-c8df-324c-993f-1122f889f4d8"],

