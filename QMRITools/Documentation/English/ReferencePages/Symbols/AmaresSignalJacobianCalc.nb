Notebook[{

Cell[CellGroupData[{
Cell["AmaresSignalJacobianCalc", "ObjectName",
 CellID->970205853,ExpressionUUID->"ca3daa04-0326-de46-99cb-452875ba0bdf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0c99b5d5-0951-b24b-8935-1ffff5a9964c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresSignalJacobianCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresSignalJacobianCalc"], "[", 
   RowBox[{
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["pars", "TI"], ",", 
    StyleBox["gyro", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0ccf5524-52bc-9a43-a822-f18fbeaa42ca"],
 "\[LineSeparator]generates a fid and the Jacobian from the ",
 Cell[BoxData[
  StyleBox["basis", "TI"]], "InlineFormula",ExpressionUUID->
  "12a09bc0-c935-5349-98af-b97984868b16"],
 " functions according to ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "7a8d6d54-e083-8c45-8043-b1162d568f92"],
 " and ",
 Cell[BoxData[
  StyleBox["pars", "TI"]], "InlineFormula",ExpressionUUID->
  "49199c91-90df-ad49-addb-20c4b9d7ab33"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"c3a9b7e3-c6de-4f4a-8721-49fd36602271"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AmaresSignalJacobianCalc",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/AmaresSignalJacobianCalc"], "[", 
   RowBox[{
    StyleBox["basis", "TI"], ",", 
    StyleBox["matrix", "TI"], ",", 
    StyleBox["pars", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox[
      RowBox[{"1", "Pars"}], "TI"]], ",", 
    StyleBox["gyro", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "32e78f10-967f-c34e-ba46-c3bec5075006"],
 "\[LineSeparator]also generates a fid but also using the B1 effect if set ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "e12b9965-646d-634b-ae8f-297df6772ea3"],
 " in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "7352f662-3a38-904d-844e-1b06d8c8eebe"],
 ". The values of ",
 Cell[BoxData[
  StyleBox["b1Pars", "TI"]], "InlineFormula",ExpressionUUID->
  "7e8c19d4-b3f6-3e4e-ba4f-449e33ad436d"],
 " are {tau, fa, TR} with tau and TR in ms and fa in degrees."
}], "Usage",
 CellChangeTimes->{{3.9951014102206573`*^9, 3.9951014104261913`*^9}},
 CellID->156719955,ExpressionUUID->"9c747c49-3414-7242-8fc4-58ecd4c2c9e4"],

