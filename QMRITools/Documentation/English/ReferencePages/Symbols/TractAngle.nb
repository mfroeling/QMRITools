Cell[CellGroupData[{
Cell["TractAngle", "ObjectName",
 CellID->409442806,ExpressionUUID->"5d8d8bec-58c8-4246-bb32-0629d4086bdf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c99389c2-8c6c-5245-a4c1-28e610502d43"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TractAngle",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/TractAngle"], "[", 
   StyleBox["tracts", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "04addd06-05cc-fe4d-875e-8f11b92f4aba"],
 "\[LineSeparator]calculates the angle of each tract segment with the \
z-plane. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"8bba3540-b588-7548-a183-89c48665477b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TractAngle",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/TractAngle"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    SubscriptBox[
     StyleBox["v", "TI"], 
     StyleBox["1", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "21430d95-d104-cd4f-80e8-4a1d92394b15"],
 "\[LineSeparator]calculates the angle of each tract segment with the plane \
normal to ",
 Cell[BoxData[
  StyleBox["v1", "TI"]], "InlineFormula",ExpressionUUID->
  "81dfd885-bc96-9e43-87b1-de41991d322f"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"626e2d50-f516-5147-93bc-666121e6926b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["TractAngle",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsTractographyTools/ref/TractAngle"], "[", 
   RowBox[{
    StyleBox["tracts", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox[
       StyleBox["v", "TI"], 
       StyleBox["1", "TR"]], ",", 
      SubscriptBox[
       StyleBox["v", "TI"], 
       StyleBox["2", "TR"]]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"36c3137a-7d8f-2442-852f-266e87056a58"],
 "\[LineSeparator]calculates the elevation and azimuth angle of each tract \
segment with the plane normal to ",
 Cell[BoxData[
  StyleBox["v1", "TI"]], "InlineFormula",ExpressionUUID->
  "5c0cf83b-a266-8c47-ae0f-d3bdb4ff3f7f"],
 " and the azimuth angle in that plane relative to v2."
}], "Usage",
 CellChangeTimes->{{3.9966567139027576`*^9, 3.9966567141522713`*^9}},
 CellID->90670255,ExpressionUUID->"4158a1d6-bc3a-004b-b76f-6b829ff84e8c"],

