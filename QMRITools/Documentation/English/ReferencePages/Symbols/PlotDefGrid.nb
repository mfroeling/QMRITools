Notebook[{

Cell[CellGroupData[{
Cell["PlotDefGrid", "ObjectName",
 CellID->1002048502,ExpressionUUID->"2b00ddea-bb2c-f148-9422-f6da2ae96d56"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e01cbb82-c11c-5141-a7db-5619c5af79ea"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotDefGrid",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsLegacy/ref/PlotDefGrid"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["phasemap", "TI"], ",", 
    StyleBox["shiftpar", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "d733b8ec-dc28-1d4a-8d50-cc973e78151a"],
 "\[LineSeparator]plots the dataset on the background with on top the non \
deformed and the deformed grid, or arrows or lines. ",
 Cell[BoxData[
  StyleBox["shiftpar", "TI"]], "InlineFormula",ExpressionUUID->
  "c8bcc552-b724-f645-995a-ee47be30f69c"],
 " is {scale, dir} where the ",
 Cell[BoxData[
  StyleBox["phasemap", "TI"]], "InlineFormula",ExpressionUUID->
  "04890489-e9f5-d745-90ad-4328d012b450"],
 " is multiplied by scale to get the shift in voxels and dir is \"ROW\" or \
\"COL\"."
}], "Usage",
 CellChangeTimes->{{4.003804561335144*^9, 4.003804561400873*^9}},
 CellID->13173888,ExpressionUUID->"26ea22d5-d136-e34a-8d4f-39d972f3ae4e"],

