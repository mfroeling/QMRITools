Notebook[{

Cell[CellGroupData[{
Cell["T1Fit", "ObjectName",
 CellID->456244568,ExpressionUUID->"8f92e118-43ba-2248-a9a2-87d967203fdf"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"792921af-920e-c24b-b0c7-7523f13ecb74"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["T1Fit",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/T1Fit"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", "TR"}], "]"}]], "InlineFormula",
  ExpressionUUID->"88c9ca6c-808c-534d-985d-2b1cf5c112c8"],
 "\[LineSeparator]fits the t1 value to the ",
 Cell[BoxData[
  StyleBox["data", "TI"]], "InlineFormula",ExpressionUUID->
  "8b3ca789-79de-c347-96b2-7786b3fd9d5f"],
 " using a nonlinear method. The output is in units as defined by the ",
 Cell[BoxData[
  StyleBox["TR", "TI"]], "InlineFormula",ExpressionUUID->
  "902ca449-d3f3-b048-9395-18eb1e0ed977"],
 ", e.g. if ",
 Cell[BoxData[
  StyleBox["TR", "TI"]], "InlineFormula",ExpressionUUID->
  "73f67ba3-fba3-0f4e-a662-b8bc5f27aee7"],
 " is in ms the ",
 Cell[BoxData[
  StyleBox["TR", "TI"]], "InlineFormula",ExpressionUUID->
  "4cfff740-35c1-f74b-b395-23ac01dbf093"],
 " is in ms. Output is {t1, apar, bpar}."
}], "Usage",
 CellChangeTimes->{{3.9966568792573853`*^9, 3.996656879363037*^9}},
 CellID->393831776,ExpressionUUID->"4b6ee99a-c17f-bb46-8dd7-57e37a1fda96"],

