Cell[CellGroupData[{
Cell["MakeRegionMesh", "ObjectName",
 CellID->76093063,ExpressionUUID->"71662f13-2302-e34f-857c-6e4e345c5b8f"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fab7e9f4-eddb-0f48-80fa-7533f43211e6"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeRegionMesh",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MakeRegionMesh"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "5827c283-8597-4547-bc4f-eacc586ae745"],
 "\[LineSeparator]makes a MeshRegion from a binary mask assuming an 1x1x1mm \
isotropic voxel size and 1000 mesh coordinates. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"d6a4e2de-7e12-1341-9446-9eafecc0f528"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeRegionMesh",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MakeRegionMesh"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "84764082-8c40-4d48-a033-84327bee994d"],
 "\[LineSeparator]makes a MeshRegion with exactly ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "30bdb27e-63de-bb4f-bd86-834affed1b27"],
 " mesh coordinates. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"eaf727c1-8d82-4e4f-a245-a0ea0fbad64e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeRegionMesh",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MakeRegionMesh"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "29f618e7-9d30-7647-9bee-5227af75df90"],
 "\[LineSeparator]makes a MeshRegion taking in account the given voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "e28bf121-dcf5-4d4b-812e-a0b3ab5959a0"],
 " with 1000 mesh coordinates. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4310997c-4020-a24e-b5fb-15e41fcae72c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MakeRegionMesh",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/MakeRegionMesh"], "[", 
   RowBox[{
    StyleBox["data", "TI"], ",", 
    StyleBox["vox", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "11f0027d-e216-6e44-85da-64e1972b5360"],
 "\[LineSeparator]makes a MeshRegion taking in account the given voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "83fcf810-4ba7-bc44-a28f-f33f9bbe60ac"],
 " with exactly ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "3c31bc24-64b9-da47-a653-1f53239b0d47"],
 " mesh coordinates."
}], "Usage",
