Notebook[{

Cell[CellGroupData[{
Cell["MuscleBidsSummary", "ObjectName",
 CellID->24647519,ExpressionUUID->"eababbeb-f12e-7445-b802-a333bb51efc9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"80670177-e1bb-ff4b-aa1a-8f4c95373761"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsSummary",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsSummary"], "[", 
   RowBox[{
    StyleBox["dir", "TI"], ",", 
    StyleBox["step", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f7f17269-f215-3840-bf0a-a12e1fd0791b"],
 "\[LineSeparator]gives the number of problems per class of the config file \
in ",
 Cell[BoxData[
  StyleBox["dir", "TI"]], "InlineFormula",ExpressionUUID->
  "791df735-b334-654a-9434-4f5d765cee03"],
 ", for the ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "14cf1ec4-ab7f-b64e-9311-83bfc71bc3ff"],
 " or for all steps when ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "3705dfc0-41d3-f84b-8bd4-6991412e56ad"],
 " is \"All\", without writing a report. The steps and classes are those of \
MuscleBidsReport. Returns an association with \"ConfigOK\", \"Subjects\", \
\"Checked\", the steps that could be checked, and \"Counts\", per ",
 Cell[BoxData[
  StyleBox["step", "TI"]], "InlineFormula",ExpressionUUID->
  "33dffde2-f406-3247-a538-56b39cc6a001"],
 " the number of problems per class. The options are ProcessSubjects to limit \
the subjects and BidsOutputImages to define the expected Analysis images."
}], "Usage",
 CellChangeTimes->{{4.004686672503481*^9, 4.0046866725922604`*^9}},
 CellID->52120837,ExpressionUUID->"97ee95a7-8258-6b4d-b7ab-c8d8ec1c1dac"],

Cell["The following options can be given: ", "Notes",
 CellID->52180913,ExpressionUUID->"d65efaad-874a-7c4c-b3ec-fe91d8b92136"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0568622f-0307-ce42-b946-d4cfd2ba3e62"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell[TextData[{
     "ProcessSubjects is an option for Bids functions. Can be a list of bids \
subject names else it is ",
     Cell[BoxData[
      ButtonBox["All",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "239eb80a-692e-644a-bd62-d577ad8fb8a5"],
     "."
    }], "TableText",ExpressionUUID->"881bdc2f-765d-fe4c-9d37-3e661f4de650"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "35a2ca58-42c6-a64b-8faf-81c1ef38c65a"], 
    ButtonBox["BidsOutputImages",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsMuscleBidsTools/ref/BidsOutputImages"], "\"\<All\>\"", 
    Cell["\<\
BidsOutputImages is an option for MuscleBidsAnalysis and ManageCheckFiles. It \
sets which images are saved in the output folder,
one of \"All\", \"Quantitative\", \"Segmentation\", \"Tractography\" or \
\"None\".\
\>", "TableText",ExpressionUUID->"b43f6fbc-56ff-c348-a46a-c038a04eb7de"]}
  }]], "3ColumnTableMod",
 CellID->154024345,ExpressionUUID->"3c824914-2e46-2d4d-b44f-c89794c697e6"]
}, Open  ]],

