Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0030e0c0-70ad-a449-93a0-d4a01a577f85"],
 Cell[BoxData[
 "RotationCorrect"], "InlineFormula",ExpressionUUID->
  "c49ece3e-6aed-864d-9c4d-eb2b38465ed8"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["TensorCorrect",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/TensorCorrect"]], "InlineFormula",
  ExpressionUUID->"07756076-c11c-c14c-a7bf-132e4d8450b8"],
 ". Default is False. Is a tensor is deformed setting to ",
 Cell[BoxData[
  ButtonBox["True",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "edd569af-2912-cc49-bf56-4ffbca97f4fb"],
 " also the shear is accounted for by local rotation of the tensor."
}], "Usage",
 CellChangeTimes->{3.9966562804252834`*^9},
