Cell[CellGroupData[{
Cell["PlotShapeVariation", "ObjectName",
 CellID->565072752,ExpressionUUID->"6b1a05b1-332c-6040-b77c-acdb128cb4d7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"feae444a-c2ff-f247-b5ae-9bb09f11c309"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotShapeVariation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/PlotShapeVariation"], "[", 
   RowBox[{
    StyleBox["points", "TI"], ",", 
    StyleBox["mesh", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5e350044-3e6d-a64e-a5de-5e669bc2dffc"],
 "\[LineSeparator]plots the template ",
 Cell[BoxData[
  StyleBox["mesh", "TI"]], "InlineFormula",ExpressionUUID->
  "61036949-9ce1-4d4b-8eab-263edc44160a"],
 " which shows where the model has variation for each principal component. \
The needed ",
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",ExpressionUUID->
  "cbdf2a26-f695-974e-981c-ecb67396d334"],
 " and ",
 Cell[BoxData[
  StyleBox["mesh", "TI"]], "InlineFormula",ExpressionUUID->
  "5a6dbba7-0621-8a44-b0aa-b2600e4a9652"],
 " are obtained from ",
 Cell[BoxData[
  ButtonBox["TemplateToVolume",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/TemplateToVolume"]], "InlineFormula",
  ExpressionUUID->"6cdd3116-7e00-f04b-8e2c-8928590dc557"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"76f0a4bc-f991-e74d-a75c-6552bc9e8f63"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PlotShapeVariation",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/PlotShapeVariation"], "[", 
   RowBox[{
    StyleBox["points", "TI"], ",", 
    StyleBox["mesh", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c9443342-629c-8243-bcb4-4c8fb0170b42"],
 "\[LineSeparator]does the same but only shows the first ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "9cc80a59-2243-dd4e-8a14-c9f71b1f15aa"],
 " principal components."
}], "Usage",
 CellChangeTimes->{{3.9966556578723984`*^9, 3.9966556580175114`*^9}},
 CellID->50427870,ExpressionUUID->"eadade96-5ce6-9447-a30e-cc8740b617a4"],

