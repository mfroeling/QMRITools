Cell[CellGroupData[{
Cell["ShiftPulseProfile", "ObjectName",
 CellID->928712501,ExpressionUUID->"0f844294-1cfe-e540-9358-63e65cd03aa1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fa5f8550-8611-f540-88cb-3e2ee65f37d9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ShiftPulseProfile",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsRelaxometryTools/ref/ShiftPulseProfile"], "[", 
   RowBox[{
    StyleBox["angs", "TI"], ",", 
    StyleBox["shift", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "341329c9-2d8e-8043-a74b-f06e287f66ce"],
 "\[LineSeparator]shifts the reference pulse profile by ",
 Cell[BoxData[
  StyleBox["shift", "TI"]], "InlineFormula",ExpressionUUID->
  "eba8412a-a439-d44a-9c39-da981f12b5d5"],
 " and makes the. ans = {exitation, refocus} as generated by ",
 Cell[BoxData[
  ButtonBox["GetPulseProfile",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetPulseProfile"]], "InlineFormula",
  ExpressionUUID->"b4c2373c-0cf4-004a-89a6-3c7a4dfddde5"],
 ". Shift is the shift in sample points."
}], "Usage",
 CellChangeTimes->{{3.9966556723373985`*^9, 3.996655672397793*^9}},
 CellID->272379635,ExpressionUUID->"32eece64-eacf-8d44-8138-cd598d363608"],

