Cell[CellGroupData[{
Cell["FitSpectra", "ObjectName",
 CellID->222690946,ExpressionUUID->"9c542f94-eb08-2649-83ce-b5cb0f0dcd60"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6c580f21-7268-db45-85a7-84c3d345a318"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FitSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/FitSpectra"], "[", 
   RowBox[{
    StyleBox["specBasis", "TI"], ",", 
    StyleBox["spec", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["st", "TI"], ",", 
      StyleBox["end", "TI"]}], "}"}], ",", 
    StyleBox["dt", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["lwVals", "TI"], ",", 
      StyleBox["lwAmps", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"7f24b40a-5ee8-4846-8a27-83c953f144a8"],
 "\[LineSeparator]Fits the basis spectra from ",
 Cell[BoxData[
  ButtonBox["GetSpectraBasisFunctions",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetSpectraBasisFunctions"]], 
  "InlineFormula",ExpressionUUID->"619be618-a431-4d4d-9baf-5ba19474d93b"],
 " to the spec overt the ppm range {st, end} and dt the dwell time."
}], "Usage",
 CellChangeTimes->{3.996656745464405*^9},
 CellID->193499789,ExpressionUUID->"f97c64c2-d28c-8e47-8f1a-f05b2408f006"],

Cell["The following options can be given: ", "Notes",
