Notebook[{

Cell[CellGroupData[{
Cell["SequenceSpinEcho", "ObjectName",
 CellID->797534794,ExpressionUUID->"f3896354-7521-9b4f-8898-fc4b01d777bd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"66d0e9e6-9a2b-ec42-a492-7f0bca782e6b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SequenceSpinEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SequenceSpinEcho"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"], ",", 
    StyleBox["te", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "970d3dbe-20ef-9c44-9bbf-080969ea7f53"],
 "\[LineSeparator]performs a spin echo experiment with echo time ",
 Cell[BoxData[
  StyleBox["te", "TI"]], "InlineFormula",ExpressionUUID->
  "f4e506e8-e0cb-5447-a0dd-3c27668b1287"],
 " of the spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "78b3725a-eefa-5949-a842-8786f46c7771"],
 " given the hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "c4800b59-9441-f544-9455-af3183ada6ac"],
 " with a 90 and 180 Degree pulse. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e766b72e-ada1-2d4c-b7ed-1ebb21b2f8c1"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SequenceSpinEcho",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SequenceSpinEcho"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"], ",", 
    StyleBox["te", "TI"], ",", 
    SubscriptBox[
     StyleBox["b", "TI"], 
     StyleBox["1", "TR"]]}], "]"}]], "InlineFormula",ExpressionUUID->
  "9c37c494-69ee-b14e-9305-8ea3a5e3f688"],
 "\[LineSeparator]performs a spin echo experiment with echo time ",
 Cell[BoxData[
  StyleBox["te", "TI"]], "InlineFormula",ExpressionUUID->
  "e0d16308-58ff-e247-9246-583fad53d243"],
 " of the spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "2a628ce8-d13c-dd4e-8036-691f6325a08b"],
 " given the hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "2249129a-7e7f-2841-a3b6-bc8be8a24616"],
 " with a 90 and 180 Degree pulse and ",
 Cell[BoxData[
  StyleBox["b1", "TI"]], "InlineFormula",ExpressionUUID->
  "f33c3176-5beb-3348-9862-ce7db56516f4"],
 ". The ",
 Cell[BoxData[
  StyleBox["te", "TI"]], "InlineFormula",ExpressionUUID->
  "5d3f6b27-b2a6-0047-883a-ff3c13cd4212"],
 " is defined in ms and the ",
 Cell[BoxData[
  StyleBox["b1", "TI"]], "InlineFormula",ExpressionUUID->
  "62c18bde-60f3-c44a-b69a-2fef9807301f"],
 " of 100% is defined as 1. The output is a new spin system dOut."
}], "Usage",
 CellChangeTimes->{{3.996656233215376*^9, 3.996656233437052*^9}},
 CellID->78823227,ExpressionUUID->"573579ca-575e-1b40-bc80-11c0f9fcac57"],

