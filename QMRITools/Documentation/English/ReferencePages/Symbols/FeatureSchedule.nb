Cell["FeatureSchedule", "ObjectName",
 CellID->99911956,ExpressionUUID->"49b4db42-8615-2e4a-a746-6db8ddcde58e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3736195e-e921-444c-942a-44627145e9c8"],
 Cell[BoxData[
 "FeatureSchedule"], "InlineFormula",ExpressionUUID->
  "160dc95f-ecb3-e542-b302-0fab2bcdec68"],
 "\[LineSeparator]is an option for ",
 Cell[BoxData[
  ButtonBox["MakeUnet",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeUnet"]], "InlineFormula",
  ExpressionUUID->"3d1b8846-cb77-8641-b253-0eb759de304b"],
 ". It defines how the number of features is up-sampled for each of the \
deeper layers of the Unet. By default it increases the number of features by \
a factor 2 each layer, i.e. {1, 2, 4, 8, 16}."
}], "Usage",
 CellID->164221477,ExpressionUUID->"8ec7b0b2-666f-df4c-b114-c7ac8bd8036c"],

