 CellID->26510747,ExpressionUUID->"e6b66d7c-8a76-1c4a-9e61-6fef91e94282"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "089832b2-0a2b-1847-a88b-f486f7130075"], 
    ButtonBox["ActivationSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/ActivationSize"], "4", Cell[TextData[{
     Cell[BoxData[
      ButtonBox["ActivationSize",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
      ExpressionUUID->"86e5044f-4b81-8b47-b4e1-78d2258b0688"],
     " is an option for ",
     Cell[BoxData[
     "SelectActivations"], "InlineFormula",ExpressionUUID->
      "9e81c886-cc55-dd48-af48-d2ee3193a98f"],
     ". Its the size of the activations selected defined in number of voxels \
if no voxel size is given. If a voxel size is given its the volume."
    }], "TableText",ExpressionUUID->"1c028a7c-deca-3444-a8eb-710fe88df02a"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c54eacbd-8fef-6543-9b88-68a58e6bcaa9"], 
    ButtonBox["IgnoreSlices",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/IgnoreSlices"], 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0"}], "}"}], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["IgnoreSlices",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/IgnoreSlices"]], "InlineFormula",
      ExpressionUUID->"0231c34e-7c4e-7242-b95d-abe1c38abdee"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["FindActivations",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/FindActivations"]], "InlineFormula",
      ExpressionUUID->"d756e75b-a901-fe41-bdad-d6472d81b68b"],
     " and ",
     Cell[BoxData[
     "SelectActivations"], "InlineFormula",ExpressionUUID->
      "7934a110-7a7f-7642-b4bd-479ddba6371c"],
     ". determines how many slices of the start and end of the dataset are \
ignored."
    }], "TableText",ExpressionUUID->"6d59218e-6c73-2c4e-b102-d7d9e31ff040"]}
  }]], "3ColumnTableMod",
