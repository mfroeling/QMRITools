Cell[CellGroupData[{
Cell["SelectActivations", "ObjectName",
 CellID->27466174,ExpressionUUID->"5d14e2d8-51a7-4b42-b225-13eb70b1c683"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2719b1bc-7744-964a-bbed-295ff65f7bff"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/SelectActivations"], "[", 
   StyleBox["act", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "dfd903c9-8237-1141-942b-485cd827430b"],
 "\[LineSeparator]selects the activations above the given ",
 Cell[BoxData[
  ButtonBox["ActivationSize",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
  ExpressionUUID->"e826ab18-3d63-524d-a09e-c731bf112097"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2a8252e7-4da1-4d4c-8f0e-a3f627066f76"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/SelectActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "468272ba-be20-5d49-99d8-9d9eb2c60a0a"],
 "\[LineSeparator]selects the activations above the given ",
 Cell[BoxData[
  ButtonBox["ActivationSize",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
  ExpressionUUID->"54656721-493c-4748-ab11-465e26b864b0"],
 " where the activation size is in mm^3. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"e9d6e7a3-0782-2b43-b17e-dbac32c9d27a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/SelectActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2057d9a1-2bfb-224f-b38c-feca39c8d388"],
 "\[LineSeparator]selects the activations above the given ",
 Cell[BoxData[
  ButtonBox["ActivationSize",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
  ExpressionUUID->"2b7ead0e-c30d-4644-8285-ffebcc807350"],
 " within the given mask or masks. The mask can be 3D or 4D. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"67cda0bc-561a-0b4d-a1c9-fa7696e75cb2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/SelectActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["mask", "TI"], ",", 
      StyleBox["back", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"830abca9-a83a-cd4b-9b56-f2d06adb401b"],
 "\[LineSeparator]selects the activations above the given ",
 Cell[BoxData[
  ButtonBox["ActivationSize",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
  ExpressionUUID->"ec3f698b-274a-b74b-90cf-903ffa314df7"],
 " within the given mask or masks. All voxels outside the back are ignored. \
Output is {actSelected, actTotal} is mask is 3D. Output is {{actSelected, \
Total[actSelected]},{actTotal,Total[actTotal]}} is mask is 4D where \
actSelected and actTotal are per mask."
}], "Usage",
 CellChangeTimes->{{3.996655674301094*^9, 3.996655674497738*^9}},
 CellID->233651779,ExpressionUUID->"938964c0-825e-5b44-9a2b-bd80e4ec157f"],

