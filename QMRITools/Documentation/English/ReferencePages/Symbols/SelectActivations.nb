Cell["SelectActivations", "ObjectName",
 CellID->682443321,ExpressionUUID->"acc6c158-a19a-1d4c-afc6-cb7d46da90a1"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"057dbd96-ee07-c04b-acb2-fde8ae38e442"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/SelectActivations"], "[", 
   StyleBox["act", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "fb65f274-dbb5-894c-9292-ecbf80731f35"],
 "\[LineSeparator]selects the activations above the given ",
 Cell[BoxData[
  ButtonBox["ActivationSize",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
  ExpressionUUID->"3ed2a1df-66a4-8847-a1d0-09878697fbde"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"0583eec1-9ff3-8843-ba5f-b068ffd10c64"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/SelectActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "eabc8e3b-460f-1e4f-a97e-0b8f148e949a"],
 "\[LineSeparator]selects the activations above the given ",
 Cell[BoxData[
  ButtonBox["ActivationSize",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
  ExpressionUUID->"dbb8c980-e8c5-ff4f-a1b9-d9e75c8505ca"],
 ", the voxel size ",
 Cell[BoxData[
  StyleBox["vox", "TI"]], "InlineFormula",ExpressionUUID->
  "721b9096-e6d1-8f42-9b07-1b8f18c04e62"],
 " = {z, y, x} in mm is needed when SizeMethod is \"Area\". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"536ee15e-9039-3e45-819f-a514d15aae86"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/SelectActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b525491a-e9b5-8a42-b75c-cfd70c859833"],
 "\[LineSeparator]selects the activations above the given ",
 Cell[BoxData[
  ButtonBox["ActivationSize",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
  ExpressionUUID->"d2c59474-2ed2-9749-a87a-2bf0b6d4bea8"],
 " within the given ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "0932bf73-15b9-c34d-8f0a-d53c9a26f5b2"],
 " or masks. The ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "ae935bd0-0ed6-eb4d-ab1e-f3b51e17d982"],
 " can be 3D or 4D. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2105f9cc-37ec-d34a-b070-72d0c7577624"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SelectActivations",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsFasciculationTools/ref/SelectActivations"], "[", 
   RowBox[{
    StyleBox["act", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["mask", "TI"], ",", 
      StyleBox["back", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"4017af13-3309-4c4a-bcc8-47dd58e42f72"],
 "\[LineSeparator]selects the activations above the given ",
 Cell[BoxData[
  ButtonBox["ActivationSize",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
  ExpressionUUID->"45605956-1a8b-2a40-aa10-a95669f42698"],
 " within the given ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "12bc347c-4a76-2a41-9f74-db9dcdc4c131"],
 " or masks. ",
 Cell[BoxData[
  ButtonBox["All",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "0e05e0d8-30c8-a047-b096-4c50afdac94e"],
 " voxels outside the back are ignored. Output is {actSelected, actTotal} is ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "f1fe9d92-c85e-a34c-a21e-fc22491ad318"],
 " is 3D. Output is {{actSelected, \
Total[actSelected]},{actTotal,Total[actTotal]}} is ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "24e6c192-bb43-4f40-b3fe-d59f1fd47c39"],
 " is 4D where ",
 Cell[BoxData[
  StyleBox["actSelected", "TI"]], "InlineFormula",ExpressionUUID->
  "adff7001-5a1d-c549-9458-888e3906f7d0"],
 " and ",
 Cell[BoxData[
  StyleBox["actTotal", "TI"]], "InlineFormula",ExpressionUUID->
  "0a2ce04f-2231-4541-8fc0-325d23a1e798"],
 " are per ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "d8543fee-18f1-8545-b904-4e52559b55ef"],
 "."
}], "Usage",
 CellChangeTimes->{{4.003804573402727*^9, 4.00380457377664*^9}},
