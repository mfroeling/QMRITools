Cell["The following options can be given: ", "Notes",
 CellID->14072443,ExpressionUUID->"8056b880-6d96-df44-9822-ec98de074cc2"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "8d5165bb-a555-6645-9147-a11b4f8bc614"], 
    ButtonBox["ActivationSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/ActivationSize"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["ActivationSize",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
      ExpressionUUID->"6179b0ea-5976-d646-ba72-f33c3d7b9936"],
     " is an option for ",
     Cell[BoxData[
     "SelectActivations"], "InlineFormula",ExpressionUUID->
      "50c58548-58af-ab42-b9fe-3eb0349f0a55"],
     ". Its the minimal size of the activations selected, in number of \
connected voxels within a slice if SizeMethod is \"Voxels\" and in mm^2 if \
SizeMethod is \"Area\".\nThe default is Automatic which is 4 voxels for \
\"Voxels\" and 30 mm^2 for \"Area\". For \"Area\" the size is rounded up to \
whole voxels."
    }], "TableText",ExpressionUUID->"15074adc-bde6-e14f-b67d-d2fa23094a87"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9b716e5f-1de6-c245-af2c-cab9cdf9a280"], 
    ButtonBox["SizeMethod",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsFasciculationTools/ref/SizeMethod"], "\"\<Voxels\>\"", 
    Cell[TextData[{
     "SizeMethod is an option for ",
     Cell[BoxData[
     "SelectActivations"], "InlineFormula",ExpressionUUID->
      "c59c94c9-2147-d441-98cb-77881c28503c"],
     ". Values can be \"Voxels\" or \"Area\". With \"Voxels\" ",
     Cell[BoxData[
      ButtonBox["ActivationSize",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ActivationSize"]], "InlineFormula",
      ExpressionUUID->"45953846-d241-6246-9025-209341583fa3"],
     " is the number of connected voxels within a slice, with \"Area\" it is \
the area in mm^2 for which the voxel size is needed."
    }], "TableText",ExpressionUUID->"bee3b3fb-b259-b44d-9d64-af015841c3bd"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "46460336-1550-814d-aeea-58cafc6788a4"], 
    ButtonBox["IgnoreSlices",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsFasciculationTools/ref/IgnoreSlices"], 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0"}], "}"}], Cell[TextData[{
     "IgnoreSlices is an option for FindActivations and ",
     Cell[BoxData[
     "SelectActivations"], "InlineFormula",ExpressionUUID->
      "de6e4c3a-b5c3-2e42-a22a-984bf899ddca"],
     ". determines how many slices of the start and end of the dataset are \
ignored."
    }], "TableText",ExpressionUUID->"f821518f-a9e0-7447-a6ca-d1ce18400f1d"]}
  }]], "3ColumnTableMod",
 CellID->389551665,ExpressionUUID->"800388b1-43d2-3e43-ace7-01bd4233e1bf"]
}, Open  ]],

