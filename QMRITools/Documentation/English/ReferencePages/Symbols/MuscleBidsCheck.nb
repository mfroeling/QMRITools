Cell["MuscleBidsCheck", "ObjectName",
 CellID->147550612,ExpressionUUID->"052f29a6-50ed-b543-b449-7d2474226fcd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"36693eec-8f50-914f-bfec-2c6edf7991df"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsCheck",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsCheck"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "3f5401a4-82a1-344f-862c-c537b5d43b0b"],
 "\[LineSeparator]shows ViewProtocolNames, CheckConfigLabels, ",
 Cell[BoxData[
  ButtonBox["CheckBidsOutput",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CheckBidsOutput"]], "InlineFormula",
  ExpressionUUID->"62621b05-8228-e940-9877-ef8ab0db6a86"],
 " and ",
 Cell[BoxData[
  ButtonBox["ManageCheckFiles",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ManageCheckFiles"]], "InlineFormula",
  ExpressionUUID->"dd89d5ab-83e2-9045-bb7f-8862e1a037af"],
 " for the config file in dir as tabs."
}], "Usage",
 CellChangeTimes->{4.0022647334797497`*^9},
 CellID->41311220,ExpressionUUID->"735f5bd0-67f2-e14b-8fe6-3b33fc1097f0"],

Cell["The following options can be given: ", "Notes",
 CellID->17642784,ExpressionUUID->"2bac18a1-2e4b-e942-bb34-b8a3dff0d3d4"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7c78f965-9f05-1448-9c4c-76733943d60c"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell["\<\
ProcessSubjects is an option for Bids functions. Can be a list of bids \
subject names else it is All.\
\>", "TableText",ExpressionUUID->"313e058b-d858-bf46-97c0-cc23c1dab4f5"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b56a64aa-e744-474a-bf8c-4bea560c9178"], 
    ButtonBox["BidsOutputImages",
     BaseStyle->"Link",
     ButtonData->
      "paclet:QMRIToolsMuscleBidsTools/ref/BidsOutputImages"], "\"\<All\>\"", 
    Cell[TextData[{
     "BidsOutputImages is an option for MuscleBidsAnalysis. If set ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "e88f29ae-6a3f-2746-b931-e7edf3b6e457"],
     " the output images are saved in the output folder."
    }], "TableText",ExpressionUUID->"58553035-8652-ba4c-b2ce-3b181ed9fba0"]}
  }]], "3ColumnTableMod",
