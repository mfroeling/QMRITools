Notebook[{

Cell[CellGroupData[{
Cell["MuscleBidsCheck", "ObjectName",
 CellID->343004730,ExpressionUUID->"8bc9c522-5277-b146-8c22-afc182fd53d8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9d610e1a-75df-ea48-acd3-bc6af137750a"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsCheck",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsCheck"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "315276aa-815a-0a4f-a775-5ee09d8734ba"],
 "\[LineSeparator]shows ",
 Cell[BoxData[
  ButtonBox["CheckBidsOutput",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CheckBidsOutput"]], "InlineFormula",
  ExpressionUUID->"53634d97-a648-2c42-a6fc-a7d9db3f3e91"],
 " and ",
 Cell[BoxData[
  ButtonBox["ManageCheckFiles",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ManageCheckFiles"]], "InlineFormula",
  ExpressionUUID->"93cf2f50-8487-b24a-8e8d-5a3f33af02ce"],
 " for the config file in dir as tabs, the checks of the processing steps. \
The Report tab exports the problems of a step, or of all steps, as md or pdf \
report. The data is scanned when the function is called, the Reload buttons \
scan again. The options ProcessSubjects and ",
 Cell[BoxData[
  ButtonBox["BidsOutputImages",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/BidsOutputImages"]], "InlineFormula",
  ExpressionUUID->"77386664-391d-bc4f-b663-82d2aa3faafb"],
 " are passed on."
}], "Usage",
 CellChangeTimes->{4.0038045498907757`*^9},
 CellID->220027072,ExpressionUUID->"4f9e3f22-bcc4-1047-bb8f-eafc069c60ca"],

Cell["The following options can be given: ", "Notes",
 CellID->585616118,ExpressionUUID->"5ce2dd14-cc25-d34f-8b45-5b1d56d6b5d0"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b3db1564-665d-e848-964d-12247c68d598"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell[TextData[{
     "ProcessSubjects is an option for Bids functions. Can be a list of bids \
subject names else it is ",
     Cell[BoxData[
      ButtonBox["All",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "afdc97a9-556e-a14d-adbb-74467ba40093"],
     "."
    }], "TableText",ExpressionUUID->"4cddca43-b88a-9b4c-b57f-d944be796c6b"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f5f8fd26-4ecc-5a44-b4b9-842516a22ad3"], 
    ButtonBox["BidsOutputImages",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/BidsOutputImages"], "\"\<All\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["BidsOutputImages",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/BidsOutputImages"]], "InlineFormula",
      ExpressionUUID->"30cb3a48-1e30-ad4b-adac-bf76d8e64879"],
     " is an option for MuscleBidsAnalysis and ",
     Cell[BoxData[
      ButtonBox["ManageCheckFiles",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ManageCheckFiles"]], "InlineFormula",
      ExpressionUUID->"8433c5bb-1d71-d847-9095-bf429b69a490"],
     ". It sets which images are saved in the output folder,\none of \"All\", \
\"Quantitative\", \"Segmentation\", \"Tractography\" or \"None\"."
    }], "TableText",ExpressionUUID->"2dbeab06-c0b4-904d-a27d-fc1cb1e400d4"]}
  }]], "3ColumnTableMod",
 CellID->809148229,ExpressionUUID->"52405222-22aa-dc46-a604-44e27003aef1"]
}, Open  ]],

