Notebook[{

Cell[CellGroupData[{
Cell["MuscleBidsConfig", "ObjectName",
 CellID->575826961,ExpressionUUID->"11682297-024b-5544-a47b-d9019cf016fd"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fa0a1da6-910e-7149-b1f6-07bf4bd8b9eb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MuscleBidsConfig",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/MuscleBidsConfig"], "[", 
   StyleBox["dir", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "0b9c400c-05d7-5a43-adfa-b91f85fa243a"],
 "\[LineSeparator]shows the config of the config file in dir and its checks \
as tabs: ViewConfig, ",
 Cell[BoxData[
  ButtonBox["CheckCustomConfigs",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/CheckCustomConfigs"]], "InlineFormula",
  ExpressionUUID->"bc7ef6bf-58e6-8945-af58-6b62139e13da"],
 ", CheckConfigLabels and ViewProtocolNames. The data is scanned when the \
function is called, the Reload buttons scan again. The option ProcessSubjects \
is passed on."
}], "Usage",
 CellChangeTimes->{4.002695808757908*^9},
 CellID->70396053,ExpressionUUID->"de490687-9bbd-194e-9b6a-10b6e347bd26"],

Cell["The following options can be given: ", "Notes",
 CellID->443075550,ExpressionUUID->"039460d2-b464-6647-ae33-b01194dc124f"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "fcfd72e8-700b-a14c-a864-f8a0feb3f739"], 
    ButtonBox["ProcessSubjects",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRIToolsMuscleBidsTools/ref/ProcessSubjects"], 
    ButtonBox["All",
     BaseStyle->"Link"], Cell["\<\
ProcessSubjects is an option for Bids functions. Can be a list of bids \
subject names else it is All.\
\>", "TableText",ExpressionUUID->"0561759a-454c-3c4d-a444-40b2d446ab00"]}
  }]], "3ColumnTableMod",
 CellID->94915712,ExpressionUUID->"01597c4e-1b3a-934e-bb6b-c6abe52415d1"]
}, Open  ]],

