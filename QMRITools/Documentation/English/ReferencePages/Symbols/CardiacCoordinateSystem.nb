Notebook[{

Cell[CellGroupData[{
Cell["CardiacCoordinateSystem", "ObjectName",
 CellID->18910200,ExpressionUUID->"e27db394-1db7-7047-b7ab-a6afe02c71b7"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2485faaf-4f71-0f44-9a63-ae6df8690003"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["CardiacCoordinateSystem",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/CardiacCoordinateSystem"], "[", 
   RowBox[{
    StyleBox["mask", "TI"], ",", 
    StyleBox["vox", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b836cdfd-0365-3946-bfb3-fce3c90d8099"],
 "\[LineSeparator]creates the cardiac coordinate system within the ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "a93c708c-f2be-c44c-b960-5d6c706607b4"],
 " and is used in ",
 Cell[BoxData[
  ButtonBox["HelixAngleCalc",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/HelixAngleCalc"]], "InlineFormula",
  ExpressionUUID->"aafce8ea-c433-fc40-a6f8-31e54281c7b1"],
 ". Output is a set of vectors {radvecn, norvecc, cirvec}, being the radial, \
normal and circular axes of each voxel respectively. If the option showPlot \
is true the output is {{radvecn, norvecc, cirvec}, plots}."
}], "Usage",
 CellChangeTimes->{{3.996655584945278*^9, 3.9966555849931164`*^9}},
 CellID->564942200,ExpressionUUID->"9270a7e9-81dc-ab4e-bb1b-5ac4ad1947a2"],

Cell["The following options can be given: ", "Notes",
 CellID->194458492,ExpressionUUID->"3a960d00-cb9d-6c4d-85dd-a074f396d1ca"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2c3501da-545f-de44-a66a-c2532eb40a99"], 
    ButtonBox["ShowPlot",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/ShowPlot"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["ShowPlot",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ShowPlot"]], "InlineFormula",
      ExpressionUUID->"856b069e-db77-fa4a-9422-52782931681e"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["CentralAxes",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
      ExpressionUUID->"1bfb86cd-9c1f-4e47-8e37-874ad613cfef"],
     ", ",
     Cell[BoxData[
      ButtonBox["HelixAngleCalc",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/HelixAngleCalc"]], "InlineFormula",
      ExpressionUUID->"f1fd1bae-0851-dc4b-ac4c-52bcde392378"],
     " and ",
     Cell[BoxData[
     "CardiacCoordinateSystem"], "InlineFormula",ExpressionUUID->
      "10c94f7e-9a95-7a4d-87d4-46a08011c789"],
     ". ",
     Cell[BoxData[
      ButtonBox["True",
       BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
      "85865e70-ca8b-344e-bd66-b071c5f83b09"],
     " shows the fit of the central axes and outpu the plot as extra output."
    }], "TableText",ExpressionUUID->"015706e7-a7af-ec4b-b587-1e1d41b5473c"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "fcf0f443-d009-de4e-9a00-b70e76010566"], 
    ButtonBox["LCMMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/LCMMethod"], "\"\<WallMap\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["LCMMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/LCMMethod"]], "InlineFormula",
      ExpressionUUID->"20dcfb22-12b3-7644-aabd-371192adf44b"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["HelixAngleCalc",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/HelixAngleCalc"]], "InlineFormula",
      ExpressionUUID->"86708d3d-6de7-724f-b613-6b54b9948989"],
     " and LMCSystemCalc. Can be \"",
     Cell[BoxData[
      ButtonBox["CentralAxes",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
      ExpressionUUID->"fc6919af-4c9b-a144-b2e0-89dd2c5a92ef"],
     "\" or \"WallMap\". \n\"",
     Cell[BoxData[
      ButtonBox["CentralAxes",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
      ExpressionUUID->"432c82ae-1eea-4140-85a9-7f6c5448136d"],
     "\" uses wall distance calculation using projection of the central axes \
and circular approximation of the ventricle. This method is fairly fast and \
uses ",
     Cell[BoxData[
      ButtonBox["CentralAxes",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
      ExpressionUUID->"27e73a85-5394-b74b-b70e-81795fef5fae"],
     " internally.\n\"WallMap\" uses wall distance interpolation and \
subsequential gradient calculation. Can take long for high res datasets but \
is most accurate. Uses ",
     Cell[BoxData[
      ButtonBox["CalculateWallMap",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CalculateWallMap"]], "InlineFormula",
      ExpressionUUID->"5bd0cd5b-ff90-b54a-a946-3676cc36aeb8"],
     " internally."
    }], "TableText",ExpressionUUID->"a2f98e59-3c5a-594a-95a9-dd0cce91d572"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4d079a0f-534b-e24e-9da2-105aed194892"], 
    ButtonBox["AxesMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/AxesMethod"], "\"\<Quadratic\>\"", 
    Cell[TextData[{
     Cell[BoxData[
      ButtonBox["AxesMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/AxesMethod"]], "InlineFormula",
      ExpressionUUID->"ee89dd3f-2976-c34c-bf34-df75cd7f7925"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["HelixAngleCalc",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/HelixAngleCalc"]], "InlineFormula",
      ExpressionUUID->"0c611eb5-213e-be4e-acfd-126f71234c52"],
     " and ",
     Cell[BoxData[
      ButtonBox["CentralAxes",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CentralAxes"]], "InlineFormula",
      ExpressionUUID->"8080cdd6-07c6-a94b-b680-57fa8d0cca7c"],
     " and ",
     Cell[BoxData[
     "CardiacCoordinateSystem"], "InlineFormula",ExpressionUUID->
      "f9482aa5-6d05-1849-8577-42ed06593d76"],
     ". Can be \"Linear\", \"Quadratic\", \"Cubic\"."
    }], "TableText",ExpressionUUID->"dc900777-6ec2-cb41-bbfe-71251f2c67b5"]}
  }]], "3ColumnTableMod",
 CellID->186394527,ExpressionUUID->"3e988bab-3b61-7447-b715-5725f204f319"]
}, Open  ]],

