Notebook[{

Cell[CellGroupData[{
Cell["ReadoutMethod", "ObjectName",
 CellID->46155589,ExpressionUUID->"c951ab08-3ad0-1f42-a552-01d20c17ccac"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"a1ccc3a0-7924-ce4c-9fcc-87f773fb3d73"],
 Cell[BoxData[
 "ReadoutMethod"], "InlineFormula",ExpressionUUID->
  "7222ce1d-76e8-7044-a28b-d1c111577aa1"],
 "\[LineSeparator]is an option of ",
 Cell[BoxData[
  ButtonBox["SimReadout",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SimReadout"]], "InlineFormula",
  ExpressionUUID->"41e38737-f46e-e84e-b9aa-f515da695e9b"],
 " and can be \"Fid\" or \"Echo\". With \"Fid\" it is also possible to define \
a delay time in ms {\"Fid\", delay}. With \"Echo\" it is also possible to \
define a delay time in ms {\"Echo\", delay} and it than assumes te is half \
the readout, or a custom te can be defined {\"Echo\", delay, te}."
}], "Usage",
 CellID->570319949,ExpressionUUID->"bc0a0c48-f385-2342-bfda-a90b2696640f"],

