Cell[CellGroupData[{
Cell["FitShapeModel", "ObjectName",
 CellID->720534050,ExpressionUUID->"2d381e1b-e311-6443-88ae-4d5018b6884c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2ac4941d-da01-0f4e-bfc8-88ff45ada9bf"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FitShapeModel",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/FitShapeModel"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["meanPoints", "TI"], ",", 
      StyleBox["model", "TI"]}], "}"}], ",", 
    StyleBox["points", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f77f1272-5613-db4f-882b-ddb444ba5e14"],
 "\[LineSeparator]fits the shape model to the ",
 Cell[BoxData[
  StyleBox["points", "TI"]], "InlineFormula",ExpressionUUID->
  "10c80ded-ff07-2645-91d9-17abec29b641"],
 ", the shape model is defined by meanPoints and model which are obtained \
form ",
 Cell[BoxData[
  ButtonBox["MakeShapeModel",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeShapeModel"]], "InlineFormula",
  ExpressionUUID->"105a26a8-eb2b-bb4d-9774-f43da981b87f"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"4039e08b-82c4-f642-b3d9-83d0e3f8dd75"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FitShapeModel",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsShapeTools/ref/FitShapeModel"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["meanPoints", "TI"], ",", 
      StyleBox["model", "TI"]}], "}"}], ",", 
    StyleBox["points", "TI"], ",", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "016c5bf4-3d27-054e-9429-6b12a31f5098"],
 "\[LineSeparator]fits the model using the first ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "a601373e-ff50-a446-acf3-e4bbb9db89d8"],
 " shape vectors from the model."
}], "Usage",
 CellChangeTimes->{{3.996656408713867*^9, 3.9966564088489056`*^9}},
 CellID->490744815,ExpressionUUID->"0352c513-93cd-df40-ae34-64b9c003ab8a"],

