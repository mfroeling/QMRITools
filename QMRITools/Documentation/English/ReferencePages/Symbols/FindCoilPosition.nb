Notebook[{

Cell[CellGroupData[{
Cell["FindCoilPosition", "ObjectName",
 CellID->156756521,ExpressionUUID->"fe8dc43a-2b10-3949-92d8-f57ac997f4b9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e1892ca2-9ead-8e41-af6f-146f40279b74"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindCoilPosition",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/FindCoilPosition"], "[", 
   StyleBox["weights", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "8549faf8-9918-0143-9709-b1451e1eb577"],
 "\[LineSeparator]finds the coil posision by locating the highest intensity \
location in the coil weight map,which can be obtianed by ",
 Cell[BoxData[
  ButtonBox["LoadCoilSetup",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/LoadCoilSetup"]], "InlineFormula",
  ExpressionUUID->"b8c80f99-082a-8741-b9fe-e8e2b85e7ed5"],
 " or ",
 Cell[BoxData[
  ButtonBox["SumOfSquares",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/SumOfSquares"]], "InlineFormula",
  ExpressionUUID->"e7ff7b1b-380d-e048-96d5-7a860798079b"],
 ". Internally it uses ",
 Cell[BoxData[
  ButtonBox["MakeWeightMask",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/MakeWeightMask"]], "InlineFormula",
  ExpressionUUID->"997a442b-9d75-3b42-882c-0be3e38274da"],
 " to remove the noise of the weightmasks. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"45cfd02d-9685-fe43-ac0d-df79447a6f7e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["FindCoilPosition",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCoilTools/ref/FindCoilPosition"], "[", 
   RowBox[{
    StyleBox["weights", "TI"], ",", 
    StyleBox["mask", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c0a32702-0b7e-444c-864d-1d1904d7ac3f"],
 "\[LineSeparator]limits the search region to the provided ",
 Cell[BoxData[
  StyleBox["mask", "TI"]], "InlineFormula",ExpressionUUID->
  "2b47bb53-65a0-1a4f-b62d-fdc710162708"],
 "."
}], "Usage",
 CellChangeTimes->{{3.996656254659292*^9, 3.996656254799288*^9}},
 CellID->12631381,ExpressionUUID->"5769b780-21b8-024f-9440-f5c69cdc3df2"],

Cell["The following options can be given: ", "Notes",
 CellID->28985033,ExpressionUUID->"0a1b2ed4-0392-aa46-8078-695ef7f65303"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "751da638-233f-c346-849e-e18a5a53fcaa"], 
    ButtonBox["OutputCoilSurface",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/OutputCoilSurface"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["OutputCoilSurface",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OutputCoilSurface"]], 
      "InlineFormula",ExpressionUUID->"f577030b-f59b-5244-afaa-b6be5511fce9"],
     " is an option for ",
     Cell[BoxData[
     "FindCoilPosition"], "InlineFormula",ExpressionUUID->
      "d7907af0-6876-f04c-ae8a-71f95346e13d"],
     ". If set true it will also output a SurfacePlot of the coil location \
volume."
    }], "TableText",ExpressionUUID->"26920076-efc8-2c46-881f-93755c7d97be"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ff5ebc62-8c84-f04b-842c-baba2758f273"], 
    ButtonBox["CoilSurfaceVoxelSize",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/CoilSurfaceVoxelSize"], 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "1"}], "}"}], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["CoilSurfaceVoxelSize",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/CoilSurfaceVoxelSize"]], 
      "InlineFormula",ExpressionUUID->"07130d35-ed2d-6d46-a077-f43f5d44ac6b"],
     " is an option for ",
     Cell[BoxData[
     "FindCoilPosition"], "InlineFormula",ExpressionUUID->
      "66a5eeba-003a-3b43-9b7c-14dced1b2406"],
     ". Specifies the voxel size used for ",
     Cell[BoxData[
      ButtonBox["OutputCoilSurface",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/OutputCoilSurface"]], 
      "InlineFormula",ExpressionUUID->"a36c5bca-9d7c-074b-b655-1183d5e59cf0"],
     "."
    }], "TableText",ExpressionUUID->"bdd764a4-da2f-ca49-9af9-325b5d9dfb59"]}
  }]], "3ColumnTableMod",
 CellID->219801349,ExpressionUUID->"5d15ee8c-c2e0-1548-9183-195e82061369"]
