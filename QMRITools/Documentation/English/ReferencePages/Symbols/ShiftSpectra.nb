Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0af11d97-2f13-1e45-b676-371dee07f801"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ShiftSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/ShiftSpectra"], "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["dw", "TI"], ",", 
      StyleBox["gyro", "TI"]}], "}"}], ",", 
    StyleBox["shift", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "42d6d25d-9ae8-1946-9cc5-38043d735bbb"],
 "\[LineSeparator]shifts the ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "404e08cc-15b8-354c-9033-e49012918307"],
 " by ",
 Cell[BoxData[
  StyleBox["shift", "TI"]], "InlineFormula",ExpressionUUID->
  "93c6f201-e734-5149-b7e7-ed0d2a4055b8"],
 ". The ",
 Cell[BoxData[
  StyleBox["shift", "TI"]], "InlineFormula",ExpressionUUID->
  "2f829882-eeba-fc47-a84c-9a51bcfe5efd"],
 " is in ppm."
}], "Usage",
