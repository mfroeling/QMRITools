Notebook[{

Cell[CellGroupData[{
Cell["SimSignal", "ObjectName",
 CellID->22588809,ExpressionUUID->"c909ec27-dcce-6846-9f11-5a090c48db40"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0dbcbc0d-12e2-df41-958d-5c27d32e7cd4"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimSignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsJcouplingTools/ref/SimSignal"], "[", 
   RowBox[{
    StyleBox["din", "TI"], ",", 
    StyleBox["ham", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5ce78011-8919-b948-8a75-2527c5cc167c"],
 "\[LineSeparator]performs a readout of a spin system ",
 Cell[BoxData[
  StyleBox["din", "TI"]], "InlineFormula",ExpressionUUID->
  "e289e101-2842-e94b-80a7-a73e506ac3c0"],
 " with hamiltonian ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "9cbfeb6f-65a5-034d-a156-826e527429ee"],
 ". Output is the complex signal."
}], "Usage",
 CellChangeTimes->{{3.996656773881111*^9, 3.9966567739734497`*^9}},
 CellID->491669882,ExpressionUUID->"e7644bf7-0f0e-a245-b6e6-92e84036c1cd"],

Cell["The following options can be given: ", "Notes",
 CellID->56043557,ExpressionUUID->"2c46a0d2-3fc5-0244-b2bb-0f9e5727998a"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "40e50190-66ea-d244-a6c8-897a22d814c6"], 
    ButtonBox["ReadoutOutput",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/ReadoutOutput"], "\"\<all\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["ReadoutOutput",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/ReadoutOutput"]], "InlineFormula",
      ExpressionUUID->"9b2b3ca5-8145-fa42-b2e7-f2c59fb08565"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["SimReadout",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/SimReadout"]], "InlineFormula",
      ExpressionUUID->"810a4560-5c1c-6948-a6f9-7c08b20d4d2e"],
     " and ",
     Cell[BoxData[
     "SimSignal"], "InlineFormula",ExpressionUUID->
      "5a81c54b-a563-fb40-94a8-4d86f64467d7"],
     " and values can be \"all\" and \"each\". When set to \"all\" the total \
signal and signal is given, when set to \"each\" the signal or spectrum for \
each peak is given separately."
    }], "TableText",ExpressionUUID->"bafe743d-d2a2-bf4c-8f9c-cb96b2e2bf37"]}
  }]], "3ColumnTableMod",
 CellID->283456002,ExpressionUUID->"38e5b2ee-2648-bd48-9828-7a7192134800"]
}, Open  ]],

