Cell[CellGroupData[{
Cell["NormalizeMeanData", "ObjectName",
 CellID->578415760,ExpressionUUID->"d19b3a76-6522-024e-92fd-eaf75cb8ca2c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c8e109dc-e075-194b-880a-c57c0b424800"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NormalizeMeanData",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsMaskingTools/ref/NormalizeMeanData"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "2278f74e-700b-1943-9eee-ce5de07ba6a7"],
 "\[LineSeparator]calculates the mean normalized data from a 4D dataset."
}], "Usage",
 CellChangeTimes->{3.996655682783533*^9},
 CellID->36494576,ExpressionUUID->"5b51438d-c693-7249-b03f-f3daa226e285"],

Cell["The following options can be given: ", "Notes",
 CellID->79406888,ExpressionUUID->"38cfd3e6-1159-cb47-8ae8-aa5d708bfc7a"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "90de3e6c-db46-1242-a1ba-e5fe8b7e05fc"], 
    ButtonBox["NormalizeMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/NormalizeMethod"], "\"\<Set\>\"", Cell[
    TextData[{
     Cell[BoxData[
      ButtonBox["NormalizeMethod",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NormalizeMethod"]], "InlineFormula",
      ExpressionUUID->"70403f41-246d-594b-81e1-a384a472c9e5"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["NormalizeData",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/NormalizeData"]], "InlineFormula",
      ExpressionUUID->"5716ff76-90fe-1f46-8fcb-983ab44a0a29"],
     ". Can be \"Set\" or \"Volumes\" which normalizes to the first volume or \
normalizes each volume individually, respectively.\nIf \"Uniform\" normalizes \
the histogram of the data to have a uniform distribution between 0 and 1 \
where 0 is treated as background of the data."
    }], "TableText",ExpressionUUID->"af14ec80-8a56-114e-9c0f-38010982f40e"]}
  }]], "3ColumnTableMod",
 CellID->38891652,ExpressionUUID->"393db243-2fc0-884c-b414-11442b8c2fc5"]
