Notebook[{

Cell[CellGroupData[{
Cell["EditAmaresMatrix", "ObjectName",
 CellID->694032451,ExpressionUUID->"5f199793-79fb-1e43-95b5-4229a85fd86c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4dad60f6-07b7-074c-9808-a60aa8a228ad"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EditAmaresMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/EditAmaresMatrix"], "[", 
   StyleBox["matrix", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "7f3d9979-d584-974e-99db-93905dc6034e"],
 "\[LineSeparator]is used to edit the Amares fitting ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "b089bc33-1afa-8040-83aa-8356455ded28"],
 " which can be compressed or extended using ToFullAmaresMatrix or \
FromFullAmaresMatrix. The default properties are \"amp\": -1,\"sigma\": \
0,\"gamma\": -1,\"shift\": -1,\"phase\": 0,\"B1\": False,\"init\": False. The \
",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "06086825-e54a-fa46-b6dd-f92ce448ec37"],
 " has one row per metabolite and one column per fit property. For \
\"amp\",\"sigma\",\"gamma\",\"shift\" and \"phase\" the value sets how the \
parameter is shared between metabolites: -1 (unique): the metabolite has its \
own free parameter. 0 (same): all metabolites with 0 share one common \
parameter. 1,2,... (group-01,group-02,...): all metabolites with the same \
number share one parameter,different numbers are different parameters. \"B1\" \
is ",
 Cell[BoxData[
  ButtonBox[
   ButtonBox["True",
    BaseStyle->"Link"],
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "6884324a-4b8b-284a-ba52-7fadd41d173a"],
 " or False and switches the B1 (Ernst-angle) amplitude correction on or off \
for that metabolite. \"init\" is True or False and selects the metabolites \
that are summed to the base spectrum used by AmaresInitialValues for the \
initial shift and linewidth calibration. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2c9012e2-374b-6346-a158-a62a160e9559"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EditAmaresMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/EditAmaresMatrix"], "[", 
   RowBox[{
    StyleBox["matrix", "TI"], ",", 
    StyleBox["names", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "b9575d7a-8432-9f4e-a7f2-13de1cead5c3"],
 "\[LineSeparator]will do the same but will only do it for the values in the \
list ",
 Cell[BoxData[
  StyleBox["names", "TI"]], "InlineFormula",ExpressionUUID->
  "4864fd57-9670-d242-b80f-b59d186bc536"],
 ". If values are not in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "3e9c0034-75f7-cd44-8384-03b34cbc7475"],
 " they will be added, if values are ",
 Cell[BoxData[
  StyleBox["names", "TI"]], "InlineFormula",ExpressionUUID->
  "abbc06f7-c2fd-a847-88ec-8c4e055ba2c9"],
 " but not in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "d05e8740-6ba3-d54c-b154-f426eb431074"],
 " they will be removed from ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "ef9ec58e-300c-e142-9c38-1def92f75fa5"],
 "."
}], "Usage",
 CellChangeTimes->{{4.0038045127907906`*^9, 4.003804513020479*^9}},
 CellID->871759071,ExpressionUUID->"aaa4bb94-1649-ea4d-a72a-f96ad8cc7555"],

