Notebook[{

Cell[CellGroupData[{
Cell["EditAmaresMatrix", "ObjectName",
 CellID->116796074,ExpressionUUID->"ab747c62-50fe-5448-a213-5fea481c7e71"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"8cd1e070-46cd-504e-8481-9868ecd5cf07"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EditAmaresMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/EditAmaresMatrix"], "[", 
   StyleBox["matrix", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "19839d1b-ef6e-0042-8c3c-9ac7ad4efbc0"],
 "\[LineSeparator]is used to edit the Amares fitting ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "cee9b69a-9a89-2242-8606-f79309b8a9d7"],
 " which can be compressed or extended using ToFullAmaresMatrix or \
FromFullAmaresMatrix. The default properties are \"amp\": -1,\"sigma\": \
0,\"gamma\": -1,\"shift\": -1,\"phase\": 0,\"B1\": False,\"init\": False. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"1ee3e57c-acf5-f544-930f-a35c474d658f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EditAmaresMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/EditAmaresMatrix"], "[", 
   RowBox[{
    StyleBox["matrix", "TI"], ",", 
    StyleBox["names", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "c0faeb15-87ab-7049-8fa0-a67ecdf90c41"],
 "\[LineSeparator]will do the same but will only do it for the values in the \
list ",
 Cell[BoxData[
  StyleBox["names", "TI"]], "InlineFormula",ExpressionUUID->
  "b3ef8937-c8ea-7441-a92e-3543bd452b90"],
 ". If values are not in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "11e50b1c-98eb-6144-a2ce-18c9ffb4ad70"],
 " they will be added, if values are ",
 Cell[BoxData[
  StyleBox["names", "TI"]], "InlineFormula",ExpressionUUID->
  "a60249d0-a818-b44a-beea-af788da4e94a"],
 " but not in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "478c4fbb-4848-0643-add4-3ea9ac0c5803"],
 " they will be removed from ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "8bdfae55-0cd1-254c-a3eb-8bfab37cf114"],
 "."
}], "Usage",
 CellChangeTimes->{{3.998533208702364*^9, 3.9985332089596596`*^9}},
 CellID->1062778107,ExpressionUUID->"15d80c94-9ce0-754c-8907-44a280b965b6"],

