Notebook[{

Cell[CellGroupData[{
Cell["EditAmaresMatrix", "ObjectName",
 CellID->154240885,ExpressionUUID->"a6d66fc2-e004-8143-ab2f-9429cf327564"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"65d299fa-aa01-a546-87d6-a0481cfb8afa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EditAmaresMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/EditAmaresMatrix"], "[", 
   StyleBox["matrix", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1d76ec23-fbb3-504c-99df-44bf73284a7b"],
 "\[LineSeparator]is used to edit the Amares fitting ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "ce691e7f-8a80-2840-953a-527f5bf362ce"],
 " which can be compressed or extended using ",
 Cell[BoxData[
  ButtonBox["ToFullAmaresMatrix",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/ToFullAmaresMatrix"]], "InlineFormula",
  ExpressionUUID->"2bebfc93-bcd7-874b-b2e4-6640d2386d9f"],
 " or ",
 Cell[BoxData[
  ButtonBox["FromFullAmaresMatrix",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/FromFullAmaresMatrix"]], "InlineFormula",
  ExpressionUUID->"6ad23a79-8ecf-f546-944a-f72fe34cf5fd"],
 ". The default properties are \"amp\": -1,\"sigma\": 0,\"gamma\": -1,\"shift\
\": -1,\"phase\": 0,\"B1\": False,\"init\": False. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"56b91c4f-299d-fb4c-a4e1-3c08769d7289"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["EditAmaresMatrix",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsAmaresTools/ref/EditAmaresMatrix"], "[", 
   RowBox[{
    StyleBox["matrix", "TI"], ",", 
    StyleBox["names", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "25402729-c2b2-b440-bac7-805ad6d0cd11"],
 "\[LineSeparator]will do the same but will only do it for the values in the \
list ",
 Cell[BoxData[
  StyleBox["names", "TI"]], "InlineFormula",ExpressionUUID->
  "00fc5ea0-9430-274d-b388-3328423448e4"],
 ". If values are not in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "bc1b1423-56e0-eb40-86fa-02da520b34ae"],
 " they will be added, if values are ",
 Cell[BoxData[
  StyleBox["names", "TI"]], "InlineFormula",ExpressionUUID->
  "c0b5ea73-f8c6-1549-bbe1-9b82ae93d539"],
 " but not in ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "270d6c1e-2c90-e847-8ac2-36a051d61722"],
 " they will be removed from ",
 Cell[BoxData[
  StyleBox["matrix", "TI"]], "InlineFormula",ExpressionUUID->
  "e7cbfe44-3a2a-634b-9ebe-34bd11805596"],
 "."
}], "Usage",
 CellChangeTimes->{{3.996656256950926*^9, 3.996656257140444*^9}},
 CellID->501247280,ExpressionUUID->"30d3e617-4539-1c4f-b6ce-0b9fb99136f0"],

