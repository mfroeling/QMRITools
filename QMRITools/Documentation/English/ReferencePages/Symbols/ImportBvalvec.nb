   StyleBox["file", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "1cae7a27-0eea-fa4f-bbbd-aec8039f81e9"],
 "\[LineSeparator]if file is either a ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"*", 
    RowBox[{".", "bval"}]}], "TI"]], "InlineFormula",ExpressionUUID->
  "45e6888b-7aa4-b046-b008-5fbf50f078c8"],
 " or *.bvec it will automatically import the *.bval and ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"*", 
    RowBox[{".", "bvec"}]}], "TI"]], "InlineFormula",ExpressionUUID->
  "00f4fea3-213a-e447-9b34-7004df1a3234"],
 " files. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"917fc56a-ec4f-3940-b49f-c12de787cafb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ImportBvalvec",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsNiftiTools/ref/ImportBvalvec"], "[", 
   RowBox[{
    RowBox[{"*", 
     RowBox[{".", 
      StyleBox["bvec", "TI"]}]}], ",", 
    RowBox[{"*", 
     RowBox[{".", 
      StyleBox["bval", "TI"]}]}]}], "]"}]], "InlineFormula",ExpressionUUID->
  "047fc364-0443-804c-b7a2-b1ef9cfcb009"],
 "\[LineSeparator]imports the given *.",
 Cell[BoxData[
  StyleBox[
   RowBox[{"*", 
    RowBox[{".", "bval"}]}], "TI"]], "InlineFormula",ExpressionUUID->
  "b30ee5bc-099f-1347-b172-f4f139b74a5b"],
 "bval and *.",
