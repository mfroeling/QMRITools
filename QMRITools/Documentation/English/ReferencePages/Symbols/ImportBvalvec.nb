Cell["ImportBvalvec", "ObjectName",
 CellID->109649101,ExpressionUUID->"392bb8a2-1cc1-0948-b8f8-a453298dd7ed"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"653080b3-c42d-fd45-a01b-1b47a211fce2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ImportBvalvec",
