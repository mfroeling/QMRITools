Cell[CellGroupData[{
Cell["DeconvolveCSIdata", "ObjectName",
 CellID->30747472,ExpressionUUID->"9ba8144e-8195-a14e-b629-0c9c317f9520"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"10031264-3d75-3d4e-8183-e49ad8fb024b"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DeconvolveCSIdata",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/DeconvolveCSIdata"], 
   "[", 
   StyleBox["spectra", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "d1265bbf-12f6-2548-bff2-b9d7868a716f"],
 "\[LineSeparator]deconvolves the CSI ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "92c70679-e7ad-e241-8420-631c94bd6afd"],
 " after ",
 Cell[BoxData[
  ButtonBox["HammingFilterCSI",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/HammingFilterCSI"]], "InlineFormula",
  ExpressionUUID->"ab982b40-bca2-9b46-abb6-36af4a1b6c15"],
 " to revert the blurring of the Hamming filtering. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"3c47d2a2-7fee-8a40-a2e1-1f92b0d44d16"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["DeconvolveCSIdata",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsReconstructionTools/ref/DeconvolveCSIdata"], 
   "[", 
   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    StyleBox["ham", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8afaebe4-1f68-6e4a-b31f-f27622cf7788"],
 "\[LineSeparator]deconvolves the CSI ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "125c3582-4689-d241-9b5e-d5f49a4b0e07"],
 " with the acquired weighting ",
 Cell[BoxData[
  StyleBox["ham", "TI"]], "InlineFormula",ExpressionUUID->
  "7e582aa0-de16-bf49-9e73-87c0ffc92586"],
 " to revert the blurring of the kspace weighting."
}], "Usage",
 CellChangeTimes->{{3.9966557018925114`*^9, 3.9966557020285225`*^9}},
 CellID->114904448,ExpressionUUID->"6fd29480-8a48-6045-a278-6cc7f5ba5684"],

