Notebook[{

Cell[CellGroupData[{
Cell["PhaseCorrectSpectra", "ObjectName",
 CellID->218441656,ExpressionUUID->"f433d485-5d89-244d-9744-2217b7de4394"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d2f5fd41-a600-d64b-8c6b-f7669e30d238"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseCorrectSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseCorrectSpectra"], "[", 
   StyleBox["spec", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "99d5caf3-05fe-9245-9967-d17dbe76b07f"],
 "\[LineSeparator]performs 0th order phase correction of the spectra by \
minimizing the difference between the real and absolute spectra value. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"5b83f12d-dad5-af41-a3be-57cf63cba9ab"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseCorrectSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseCorrectSpectra"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", 
    StyleBox["dw", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "7e802395-91a4-ea46-b231-3aa64c7ed273"],
 "\[LineSeparator]performs 0th order phase correction of the spectra using \
Hankel matrix SVD fitting. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"7ae41198-dd43-4542-9f2e-80d499957e06"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseCorrectSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseCorrectSpectra"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", 
    StyleBox["dw", "TI"], ",", 
    StyleBox["te", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "96c59d87-3cd2-6b44-9cea-edabac79ccb0"],
 "\[LineSeparator]:= performs 0th and 1st order phase correction of the \
spectra using Hankel matrix SVD fitting. The first order phase is corrected \
by padding the fid with the missing values in the time before the TE. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"2d6978a9-2f6c-074d-890d-9a435e6a6c7c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["PhaseCorrectSpectra",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsSpectroTools/ref/PhaseCorrectSpectra"], "[", 
   RowBox[{
    StyleBox["spec", "TI"], ",", 
    StyleBox["dw", "TI"], ",", 
    StyleBox["te", "TI"], ",", 
    StyleBox["gyro", "TI"], ",", 
    StyleBox["ppmRan", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "fc1d89f6-c5d1-1247-9d20-bb9866cd1459"],
 "\[LineSeparator]performs 0th and 1st order phase correction of the spectra \
using Hankel matrix SVD fitting. Only the part of the spectra in the ",
 Cell[BoxData[
  StyleBox["ppmRan", "TI"]], "InlineFormula",ExpressionUUID->
  "646886bc-d30f-7946-8fbf-0e310bb13d65"],
 " is used for optimization."
}], "Usage",
 CellChangeTimes->{{3.9966556290173187`*^9, 3.9966556292683563`*^9}},
 CellID->561116125,ExpressionUUID->"c103919f-51fa-d944-92d1-fb6bb10729eb"],

