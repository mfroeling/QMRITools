   {Cell["   ", "ModInfo",ExpressionUUID->
     "4102573e-7e09-e640-9e49-382d100c3f5a"], 
    ButtonBox["GroupPerSegment",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/GroupPerSegment"], 
    ButtonBox["True",
