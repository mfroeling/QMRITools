Cell[CellGroupData[{
Cell["SegmentsPerSlice", "ObjectName",
 CellID->450683533,ExpressionUUID->"033be7f5-e764-f549-9e75-54aad44aeea9"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"77cc8ea2-0de9-ed44-b693-66bf53e8042e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentsPerSlice",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/SegmentsPerSlice"], "[", 
   StyleBox["points", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "25dfd08d-9fe7-ed44-bc50-75a87717c0eb"],
 "\[LineSeparator]gives the number of segments per slice where the slice \
distribution is determined by ",
 Cell[BoxData[
  ButtonBox["GetSegmentSlices",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetSegmentSlices"]], "InlineFormula",
  ExpressionUUID->"1972367b-814c-e54f-b36c-705d308975a3"],
 ". \n",
 Cell["   ", "ModInfo",ExpressionUUID->"24fc9949-ea66-4740-a482-83822c376a1f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SegmentsPerSlice",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsCardiacTools/ref/SegmentsPerSlice"], "[", 
   RowBox[{
    StyleBox["slices", "TI"], ",", 
    StyleBox["points", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "0d828928-76ba-664b-ad72-18b9c8e464ff"],
 "\[LineSeparator]does the same but the ",
 Cell[BoxData[
  StyleBox["slices", "TI"]], "InlineFormula",ExpressionUUID->
  "6325fe77-df8d-5942-899c-f07a5f838fec"],
 " are given manually."
}], "Usage",
 CellChangeTimes->{{3.9966562347746067`*^9, 3.996656234909342*^9}},
 CellID->200141171,ExpressionUUID->"af501c10-9299-2c45-af18-27f59ae7f7be"],

