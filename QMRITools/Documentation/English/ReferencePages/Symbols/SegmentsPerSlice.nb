   {Cell["   ", "ModInfo",ExpressionUUID->
     "29c1e311-aa09-324d-9d54-aa07a5d39037"], 
    ButtonBox["SegmentationMethod",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/SegmentationMethod"], "\"\<AHA\>\"", 
