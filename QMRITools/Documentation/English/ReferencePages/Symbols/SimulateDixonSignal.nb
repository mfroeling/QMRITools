       RowBox[{
       "0.089", ",", " ", "0.577", ",", " ", "0.059", ",", " ", "0.093", ",", 
        " ", "0.059", ",", " ", "0.013", ",", " ", "0.02", ",", " ", "0.02", ",",
         " ", "0.01", ",", " ", "0.059"}], "}"}]}], "}"}], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["DixonAmplitudes",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DixonAmplitudes"]], "InlineFormula",
      ExpressionUUID->"05bae29b-bf6e-684a-83fc-ef1a6a6c430d"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["DixonReconstruct",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DixonReconstruct"]], "InlineFormula",
      ExpressionUUID->"7a12702d-0a60-0e43-b74c-a3505062ec22"],
     ". Defines the relative amplitudes of the fat peaks being used. \nCan \
also be a fat model string, \"Fixed\", \"Full\", \"FitCL\", \"FitDB\", \
\"FitIDB\", \n\"CallCL\", \"CallDB\" or \"CallIDB\", see GenerateAmps."
    }], "TableText",ExpressionUUID->"5833c2e3-2bd4-084e-957d-78c4e7386cc7"]}
  }]], "3ColumnTableMod",
