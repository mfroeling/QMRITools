Notebook[{

Cell[CellGroupData[{
Cell["SimulateDixonSignal", "ObjectName",
 CellID->13502235,ExpressionUUID->"5f488074-4f91-eb42-9a32-6685f6a36152"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"20cb392a-c572-af4b-a541-2df2ac7836be"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimulateDixonSignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/SimulateDixonSignal"], "[", 
   RowBox[{
    StyleBox["echo", "TI"], ",", 
    StyleBox["fr", "TI"], ",", "B$0", ",", "T$2"}], "]"}]], "InlineFormula",
  ExpressionUUID->"44267c9e-b1d8-8141-a4d4-ad73ba7828a0"],
 "\[LineSeparator]simulates an Dixon gradient ",
 Cell[BoxData[
  StyleBox["echo", "TI"]], "InlineFormula",ExpressionUUID->
  "52ce0d16-6c6f-1a4e-8c6f-1e6619bb8730"],
 " sequence with echotimes. Echotimes ",
 Cell[BoxData[
  StyleBox["echo", "TI"]], "InlineFormula",ExpressionUUID->
  "96e4b52a-8d65-7b4b-9a04-571095f6af15"],
 " in s, water fraction ",
 Cell[BoxData[
  StyleBox["fr", "TI"]], "InlineFormula",ExpressionUUID->
  "d947fc1d-f648-5242-abbf-8943b94752b9"],
 " between 0 and 1 (fat fraction is 1 - fr), field of resonance ",
 Cell[BoxData[
  StyleBox["B0", "TI"]], "InlineFormula",ExpressionUUID->
  "b3d49a12-b46e-5043-ad7b-16af4b75e24d"],
 " in Hz and relaxation ",
 Cell[BoxData[
  StyleBox["T2", "TI"]], "InlineFormula",ExpressionUUID->
  "32873877-2103-a145-b27f-9395d00f3753"],
 " in s. ",
 Cell[BoxData[
  StyleBox["T2", "TI"]], "InlineFormula",ExpressionUUID->
  "397a2195-0318-6e4e-bac4-f9b9a37edb14"],
 " can be a single value or {T2water, T2fat}. Output is {real, imag}."
}], "Usage",
 CellChangeTimes->{{4.0038045803072834`*^9, 4.0038045804844284`*^9}},
 CellID->868067958,ExpressionUUID->"0306b62e-c498-9a4f-96e3-944f14032cb7"],

Cell["The following options can be given: ", "Notes",
 CellID->240523951,ExpressionUUID->"9abad969-16d8-b54a-8136-6acec5905df5"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "761df22e-b4a5-fe4b-a5a6-db8b82769acb"], 
    ButtonBox["DixonNucleus",
     BaseStyle->"Link",
