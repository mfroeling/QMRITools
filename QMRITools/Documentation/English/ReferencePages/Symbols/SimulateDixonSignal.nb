Cell[CellGroupData[{
Cell["SimulateDixonSignal", "ObjectName",
 CellID->1037365789,ExpressionUUID->"3b22913b-c66f-4748-891c-54c8aee3aaf0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"ef48fc0e-b29c-7f41-af7a-d8f5ea35f34d"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimulateDixonSignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/SimulateDixonSignal"], "[", 
   RowBox[{
    StyleBox["echo", "TI"], ",", 
    StyleBox["fr", "TI"], ",", "B$0", ",", "T$2"}], "]"}]], "InlineFormula",
  ExpressionUUID->"caf43537-6b0c-2046-8a52-c33fb6707d82"],
 "\[LineSeparator]simulates an Dixon gradient ",
 Cell[BoxData[
  StyleBox["echo", "TI"]], "InlineFormula",ExpressionUUID->
  "ad4f905b-d311-8745-8274-9bf1855a6820"],
 " sequence with echotimes. Echotimes ",
 Cell[BoxData[
  StyleBox["echo", "TI"]], "InlineFormula",ExpressionUUID->
  "3b15a604-f357-0649-bd02-4f434829c482"],
 " in ms, fat fraction ",
 Cell[BoxData[
  StyleBox["fr", "TI"]], "InlineFormula",ExpressionUUID->
  "a2805074-7f6f-744d-a900-769f606b09fb"],
 " between 0 and 1, field of resonance ",
 Cell[BoxData[
  StyleBox["B0", "TI"]], "InlineFormula",ExpressionUUID->
  "22056df0-e0d6-194f-9032-63cdb9cf34f5"],
 " in Hz and relaxation ",
 Cell[BoxData[
  StyleBox["T2", "TI"]], "InlineFormula",ExpressionUUID->
  "a96422c3-39dd-fe41-8f19-84e075355b01"],
 " in ms."
}], "Usage",
 CellChangeTimes->{{3.9966556226874104`*^9, 3.9966556227865143`*^9}},
 CellID->657740843,ExpressionUUID->"be634197-1048-c444-93f5-ce930c93e1c1"],

