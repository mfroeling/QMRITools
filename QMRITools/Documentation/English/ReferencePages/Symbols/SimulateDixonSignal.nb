    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "0.", "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3.81"}], ",", " ", 
        RowBox[{"-", "3.4"}], ",", " ", 
        RowBox[{"-", "3.12"}], ",", " ", 
        RowBox[{"-", "2.67"}], ",", " ", 
        RowBox[{"-", "2.45"}], ",", " ", 
        RowBox[{"-", "1.94"}], ",", " ", 
        RowBox[{"-", "0.63"}], ",", " ", 
        RowBox[{"-", "0.4"}], ",", " ", "0.52", ",", " ", "0.62"}], "}"}]}], 
     "}"}], Cell[TextData[{
     "DixonFrequencies is an option for ",
     Cell[BoxData[
      ButtonBox["DixonReconstruct",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DixonReconstruct"]], "InlineFormula",
      ExpressionUUID->"fa5b3196-ed8d-8443-b5bc-28c12f36312d"],
     ". Defines the frequencies in ppm of the fat peaks being used."
