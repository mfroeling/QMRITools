     Cell[BoxData[
      ButtonBox["DixonPrecessions",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DixonPrecessions"]], "InlineFormula",
      ExpressionUUID->"ff492588-6f58-5540-a6a1-c2931c6a956c"],
     " is an option for ",
     Cell[BoxData[
      ButtonBox["DixonReconstruct",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/DixonReconstruct"]], "InlineFormula",
      ExpressionUUID->"ee3e12d3-102c-2b48-8d69-6bf8765ab0f5"],
     ". Defines the rotation of the signal {-1,1} default is 1."
    }], "TableText",ExpressionUUID->"4a6e5292-d2ff-cb42-bf0e-ea8d4b60b414"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
