Cell[CellGroupData[{
Cell["SimulateDixonSignal", "ObjectName",
 CellID->48089636,ExpressionUUID->"0c3b8cd6-5c97-8c4f-a4ba-4fdf1313ff5a"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d7f102aa-0592-cd49-ba0e-8b6d1f45a926"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimulateDixonSignal",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/SimulateDixonSignal"], "[", 
   RowBox[{
    StyleBox["echo", "TI"], ",", 
    StyleBox["fr", "TI"], ",", "B$0", ",", "T$2"}], "]"}]], "InlineFormula",
  ExpressionUUID->"451cef17-7c4b-a646-a39b-586fed96ab47"],
 "\[LineSeparator]simulates an Dixon gradient ",
 Cell[BoxData[
  StyleBox["echo", "TI"]], "InlineFormula",ExpressionUUID->
  "aa3790c1-6552-564f-9ab6-eb5f80e3a2b4"],
 " sequence with echotimes. Echotimes ",
 Cell[BoxData[
  StyleBox["echo", "TI"]], "InlineFormula",ExpressionUUID->
  "dc495870-be6d-584d-a31c-56f86955f9ba"],
 " in ms, fat fraction ",
 Cell[BoxData[
  StyleBox["fr", "TI"]], "InlineFormula",ExpressionUUID->
  "d4013086-bbc3-634c-b29e-1d65397a0567"],
 " between 0 and 1, field of resonance ",
 Cell[BoxData[
  StyleBox["B0", "TI"]], "InlineFormula",ExpressionUUID->
  "7ec2e0b8-eb61-234e-aa79-111ac77ffa2e"],
 " in Hz and relaxation ",
 Cell[BoxData[
  StyleBox["T2", "TI"]], "InlineFormula",ExpressionUUID->
  "ab6f6f7b-2e88-4d40-807a-39abcc543d65"],
 " in ms."
}], "Usage",
 CellChangeTimes->{{3.9985332765319157`*^9, 3.99853327674057*^9}},
 CellID->143979498,ExpressionUUID->"5a9a1609-3470-0344-8357-6f2bd04f64f2"],

