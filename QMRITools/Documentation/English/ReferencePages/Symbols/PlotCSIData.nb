  ButtonBox["GetGyro",
   BaseStyle->"Link",
   ButtonData->"paclet:QMRITools/ref/GetGyro"]], "InlineFormula",
  ExpressionUUID->"2371406e-419e-c549-ba1b-3e3c7266b507"],
