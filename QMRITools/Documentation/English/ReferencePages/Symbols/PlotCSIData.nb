   RowBox[{
    StyleBox["spectra", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["dwell", "TI"], ",", 
      StyleBox["field", "TI"], ",", 
      StyleBox["nuc", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"593de2f9-435a-a94f-8bfb-2a21fe0c1bd1"],
 "\[LineSeparator]plots the CSI ",
 Cell[BoxData[
  StyleBox["spectra", "TI"]], "InlineFormula",ExpressionUUID->
  "7ae41887-6103-574e-86eb-3695e834b583"],
 " which has dimensions {z,y,x,nSamp}. The ppm axes is determined by dwell \
and ",
 Cell[BoxData[
  StyleBox["field", "TI"]], "InlineFormula",ExpressionUUID->
  "76dad687-50da-0d46-a42e-3a4796b55725"],
 " and nuc."
}], "Usage",
