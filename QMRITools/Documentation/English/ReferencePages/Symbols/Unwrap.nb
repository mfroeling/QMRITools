Notebook[{

Cell[CellGroupData[{
Cell["Unwrap", "ObjectName",
 CellID->188024928,ExpressionUUID->"fc145b5a-7585-5044-b29e-774b249e822c"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c945306a-4b71-4c4f-877c-4e17c40f7b40"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Unwrap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/Unwrap"], "[", 
   StyleBox["data", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "b14be7c6-cf2e-bc49-a374-cb4322294887"],
 "\[LineSeparator]unwraps the given dataset. The data should be between -Pi \
and Pi. \n",
 Cell["   ", "ModInfo",ExpressionUUID->"a702f01f-e42b-2944-97ea-ce2ef87728eb"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["Unwrap",
    BaseStyle->"Link",
    ButtonData->"paclet:QMRIToolsDixonTools/ref/Unwrap"], "[", "]"}]], 
  "InlineFormula",ExpressionUUID->"bced7440-4d90-8547-8bb9-c9f500ce8cfd"],
 "\[LineSeparator]is based on DOI: 10.1364/AO.46.006623 and \
10.1364/AO.41.007437."
}], "Usage",
 CellChangeTimes->{{3.9966568716915646`*^9, 3.9966568717511845`*^9}},
 CellID->515746829,ExpressionUUID->"30c7911c-10b2-a74f-8c59-d48871a36b35"],

Cell["The following options can be given: ", "Notes",
 CellID->637938,ExpressionUUID->"1faeaf4e-bf88-0344-9f2e-30945cbbef82"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "1b51f6fb-f98c-6c41-afd3-baae39718275"], 
    ButtonBox["MonitorUnwrap",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/MonitorUnwrap"], 
    ButtonBox["False",
     BaseStyle->"Link"], Cell[TextData[{
     Cell[BoxData[
      ButtonBox["MonitorUnwrap",
       BaseStyle->"Link",
       ButtonData->"paclet:QMRITools/ref/MonitorUnwrap"]], "InlineFormula",
      ExpressionUUID->"307e1eac-b52f-db4c-a66a-40f7fa33bd2f"],
     " is an option for ",
     Cell[BoxData[
     "Unwrap"], "InlineFormula",ExpressionUUID->
      "da280337-fb60-2248-a8b6-e909a1d01275"],
     ". Monitor the unwrapping progress."
    }], "TableText",ExpressionUUID->"fdbba107-dc44-3249-be91-29887ecc25e4"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "a2c79eaf-5d78-6e46-80d8-fcb9977a53fb"], 
    ButtonBox["UnwrapDimension",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/UnwrapDimension"], "\"\<2D\>\"", Cell[
    TextData[{
     Cell[BoxData[
     "Unwrap"], "InlineFormula",ExpressionUUID->
      "f1ae64ba-69bb-944d-9fd0-8eb189473431"],
     "Dimension is an option for ",
     Cell[BoxData[
     "Unwrap"], "InlineFormula",ExpressionUUID->
      "5c37bcc7-b8da-ba46-895a-addf8a595926"],
     ". Can be \"2D\" or \"3D\". 2D is for unwarpping 2D images or unwrapping \
the individual images from a 3D dataset (does not unwrap in the slice \
direction). 3D unwraps a 3D dataset in all dimensions."
    }], "TableText",ExpressionUUID->"bba31d33-da91-8d4f-9afd-5451fae94866"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "ed4bd5d9-6207-1342-9e0a-d67da92e3dd8"], 
    ButtonBox["UnwrapThresh",
     BaseStyle->"Link",
     ButtonData->"paclet:QMRITools/ref/UnwrapThresh"], "0.5", Cell[TextData[{
     Cell[BoxData[
     "Unwrap"], "InlineFormula",ExpressionUUID->
      "339fb7d3-2e4a-4744-8257-07a06ac5048f"],
     "Thresh is an option for ",
     Cell[BoxData[
     "Unwrap"], "InlineFormula",ExpressionUUID->
      "259d0765-9718-4543-92da-40622e2c2583"],
     ". Is a value between 0.6 and 0.9, and defines when to unwrap, the \
higher the value the less unwrapping will be done."
    }], "TableText",ExpressionUUID->"627b67b0-feb3-ab4f-8e42-3fefd27a3998"]}
  }]], "3ColumnTableMod",
 CellID->331313681,ExpressionUUID->"1a44b187-0227-204b-93de-4bd003f9cafa"]
}, Open  ]],

