          ItemBox[
           PaneBox[
            
            StyleBox["\<\"TriExponentialT2Fit[data, EchoTimes] fits the T2 \
based on Azzabou N et.al. Validation of a generic approach to muscle water T2 \
determination at 3T in fat-infiltrated skeletal muscle. J. Magn. Reson. 2015.\
\\nThe fat T2 parameters are automatically estimated from the high signal \
voxels from the last echo.\\n\\nThe output is in units as defined by the \
EchoTimes, e.g. if EchoTimes is in ms the output is in ms.\\nThe output \
fraction is between 0 an 1.\\n\\nOutput is {{S(0), fatFraction, \
muscleFraction, T2map},callibration} or {S(0), fatFraction, muscleFranction, \
T2map}.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
