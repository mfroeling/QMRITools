            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"BullseyePlot[data, segmask] generates a AHA-17 \
segment bullseye plot. \\nBullseyePlot[list] generates a AHA-17 segment \
