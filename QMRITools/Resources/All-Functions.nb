          ItemBox[
           PaneBox[
            
            StyleBox["\<\"DcmToNii[] converts a dicom folder to nii, you will \
be prometed for the location of the folders. \
\\nDcmToNii[{\\\"input\\\",\\\"ouput\\\"}] converts the \\\"input\\\" dicom \
folder to nii files which are place in the \\\"output\\\" folder.\\nFor this \
function to work the dcm2niix.exe file should be present in the QMRITools \
aplication folder.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
