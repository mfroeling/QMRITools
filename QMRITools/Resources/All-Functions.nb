      QMRITools`GeneralTools`MonitorCalc -> True, 
      QMRITools`RelaxometryTools`OutputCalibration -> False, 
      QMRITools`RelaxometryTools`EPGSmoothB1 -> True, 
      QMRITools`RelaxometryTools`WaterFatShift -> 0., 
