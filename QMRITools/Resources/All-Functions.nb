                "FEBitmaps", "InformationHelpIcon"],
                ImageSizeCache->{13., {4., 9.}}], True->
               
               DynamicBox[FEPrivate`FrontEndResource[
                "FEBitmaps", "InformationHelpIconHot"],
                ImageSizeCache->{13., {4., 9.}}]}, Dynamic[
                CurrentValue["MouseOver"]]],
              Appearance->None,
              BaseStyle->"Link",
              ButtonData->"paclet:QMRITools/ref/BayesianIVIMFit2",
              ButtonNote->"paclet:QMRITools/ref/BayesianIVIMFit2"],
             "\"paclet:QMRITools/ref/BayesianIVIMFit2\""],
            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"BayesianIVIMFit2[data, bval, init, mask] performs \
bayesian IVIM fit of data.\\n\\ndata is the data which should be {slice, \
Ndiff, x, y}.\\nbval is the bvector whould be length Ndiff.\\ninit is the \
initalization of the bayesian fit which comes from IVIMCalc, (without S0 \
using 2 compartments).\\nmask is the region in which the bayesian fit is \
performed.\\n\\noutput is {f1, dc, pdc1}. The fraction is defined between 0 \
and 1, the dc, pdc1 is in mm^2/s.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
