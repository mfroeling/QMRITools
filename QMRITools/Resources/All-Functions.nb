         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"BayesianIVIMFit2[data, bval, init, mask] performs \
bayesian IVIM fit of data.\\n\\ndata is the data which should be {slice, \
Ndiff, x, y}.\\nbval is the bvector whould be length Ndiff.\\ninit is the \
initalization of the bayesian fit which comes from IVIMCalc, (without s0 \
using 2 compartments).\\nmask is the region in which the bayesian fit is \
performed.\\n\\noutput is {f1, dc, pdc1}. The fraction is defined between 0 \
and 1, the dc, pdc1 is in mm^2/s.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
