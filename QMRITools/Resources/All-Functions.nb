            Method -> OptionValue[Method], DistributedContexts -> 
             Parallel`Protected`DistOptCheck[Parallelize, 
               OptionValue[DistributedContexts]], ProgressReporting -> 
             OptionValue[ProgressReporting]}]; 
         Parallel`Evaluate`Private`ehead = Replace[
            Head[
             Unevaluated[Parallel`Evaluate`Private`expr], Hold], {Hold[
               Pattern[Parallel`Evaluate`Private`s, 
                Blank[Symbol]]] :> Parallel`Evaluate`Private`s, 
