                "FEBitmaps", "InformationHelpIcon"],
                ImageSizeCache->{13., {4., 9.}}], True->
               
               DynamicBox[FEPrivate`FrontEndResource[
                "FEBitmaps", "InformationHelpIconHot"],
                ImageSizeCache->{13., {4., 9.}}]}, Dynamic[
                CurrentValue["MouseOver"]]],
              Appearance->None,
              BaseStyle->"Link",
              ButtonData->"paclet:QMRITools/ref/EPGT2Fit",
              ButtonNote->"paclet:QMRITools/ref/EPGT2Fit"],
             "\"paclet:QMRITools/ref/EPGT2Fit\""],
            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"EPGT2Fit[data, {Necho, detlaTE}, {exitation, \
refoucs}] fits the T2 based on Marty B et.al. Simultaneous muscle water T2 \
and fat fraction mapping using transverse relaxometry with stimulated echo \
compensation.\\nExitation and refocus are the RF pulse angles e.g. 90,180. \
They can also be a range of angeles over the slice profile as defined by \
GetSliceProfile.\\n\\nThe output is in units as defined by the detlaTE, e.g. \
if detlaTE is in ms the output is in ms.\\nThe exitation and refocus are \
defined in Degrees.\\n\\nOutput is {{{T2map,B1Map},{wat, fat, fatMap}, \
residual},callibration} or {{T2map,B1Map},{wat, fat, fatMap}, \
residual}\\n\\nEPGT2Fit[] is based on DOI: 10.1002/nbm.3459.\"\>", 
             "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
