            Blank[]], 
           Optional[
            Blank[]], 
           OptionsPattern[]}}}], "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     QMRITools`DixonTools`DixonPrecessions -> -1, 
      QMRITools`DixonTools`DixonFieldStrength -> 3, 
      QMRITools`DixonTools`DixonNucleus -> "1H", 
      QMRITools`DixonTools`DixonFrequencies -> {{0}, {3.8, 3.4, 3.1, 2.7, 2.5,
         1.95, 0.5, -0.5, -0.6}}, 
      QMRITools`DixonTools`DixonAmplitudes -> {{1}, {0.088, 0.628, 0.059, 
        0.064, 0.059, 0.01, 0.039, 0.01, 0.042}}, 
      QMRITools`DixonTools`DixonIterations -> 20, 
      QMRITools`DixonTools`DixonTollerance -> 0.1, 
      QMRITools`DixonTools`DixonMaskThreshhold -> 0.1, 
      QMRITools`DixonTools`DixonFilterInput -> True, 
      QMRITools`DixonTools`DixonFilterOutput -> True, 
      QMRITools`DixonTools`DixonFilterSize -> 1, 
      QMRITools`DixonTools`DixonFilterType -> "Median", 
      QMRITools`DixonTools`DixonBipolar -> False, 
      QMRITools`DixonTools`DixonClipFraction -> False, 
      QMRITools`DixonTools`DixonCorrectT1 -> False, 
      QMRITools`DixonTools`DixonComplexOutput -> False, 
