              Appearance->None,
              BaseStyle->"Link",
              ButtonData->"paclet:QMRITools/ref/DriftCorrect",
              ButtonNote->"paclet:QMRITools/ref/DriftCorrect"],
             "\"paclet:QMRITools/ref/DriftCorrect\""],
            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"DriftCorrect[data, bval] dirft corrects the data \
using the signals of the lowest bvalue that has 6 or more unique \
volumes.\\nFor the function to work optimal it is best to have these volumes \
evenly spread througout thet data and for the first and last volume to have \
this low bvalue.\\n\\nDriftCorrect[] is based on DOI: 10.1002/mrm.26124.\"\>",
