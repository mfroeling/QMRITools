           PaneBox[
            TooltipBox[
             ButtonBox[
              PaneSelectorBox[{False->
               
               DynamicBox[FEPrivate`FrontEndResource[
                "FEBitmaps", "InformationHelpIcon"],
                
                ImageSizeCache->{
                 9.75, {2.8908691406250004`, 6.859130859375}}], True->
               
               DynamicBox[FEPrivate`FrontEndResource[
                "FEBitmaps", "InformationHelpIconHot"],
                
                ImageSizeCache->{
                 9.75, {2.8908691406250004`, 6.859130859375}}]}, Dynamic[
                CurrentValue["MouseOver"]]],
              Appearance->None,
              BaseStyle->"Link",
              
              ButtonData->
               "paclet:QMRITools/ref/CalculateDisplacementParameters",
              
              ButtonNote->
               "paclet:QMRITools/ref/CalculateDisplacementParameters"],
             "\"paclet:QMRITools/ref/CalculateDisplacementParameters\""],
            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"CalculateDisplacementParameters[{motx, moty}, mask] \
calculates strain and rotation from the displacements motx and moty as given \
by AnnalyzeTagging, both {slices, frames, y, x}.\\nThe mask is {slices, y, x} \
and a circle fitted to the mask of each slice defines the center for the \
circumferential and radial directions.\\n\\nOutput is {Exx, Eyy, Exy, Ecc, \
Ecr, rot}, all {slices, frames, y, x}, where Exx, Eyy and Exy are the \
Green-Lagrange strain components along the image axes,\\nEcc is the \
circumferential strain, Ecr the radial strain and rot the rotation around the \
center in degrees.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[GridBox[{
             {
              
              DynamicModuleBox[{System`InformationDump`open$$ = {
               False, False, False, False, False, False}}, 
               StyleBox[GridBox[{
                  {
                   TagBox[
                    TooltipBox[
                    StyleBox["\<\" Documentation\"\>", "InformationRowLabel",
                    StripOnInput->False],
