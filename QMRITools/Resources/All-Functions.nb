                "FEBitmaps", "InformationHelpIconHot"],
                ImageSizeCache->{13., {4., 9.}}]}, Dynamic[
                CurrentValue["MouseOver"]]],
              Appearance->None,
              BaseStyle->"Link",
              ButtonData->"paclet:QMRITools/ref/SNRMapCalc",
              ButtonNote->"paclet:QMRITools/ref/SNRMapCalc"],
             "\"paclet:QMRITools/ref/SNRMapCalc\""],
            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"SNRMapCalc[data1,noisemap] calcualtes the signal to \
noise ratio of the data using MN[data]/(1/sqrt[pi/2] sigma), \\nwhere sigma \
is the local mean of the noise map assuming it is a rician \
distribution.\\n\\nSNRMapCalc[{data1,data2}] calcualtes the signal to noise \
ratio from two identical images using \\nMN[data1,data2] / (.5 SQRT[2] \
STDV[data2-data1]).\\n\\nSNRMapCalc[{data1, .. dataN}] calcualtes the signal \
to noise ratio of the data using MN/sigma where the mean signal MN is the \
average voxel\\nvalue over all dynamics N and the sigma is the standard \
deviation over all dynamics N.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
