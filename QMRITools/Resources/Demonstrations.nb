Cell["If segmentations have overlaps they can be removed.", "Text",
 CellChangeTimes->{{3.754900015110106*^9, 3.754900028063248*^9}, {
  3.7549968084521017`*^9, 3.75499681990247*^9}, {3.758435328203323*^9, 
  3.75843534207345*^9}},ExpressionUUID->"460b4f2c-53bc-49cd-9398-\
41759cefa4a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"segDil", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SparseArray", "@", 
       RowBox[{"Dilation", "[", 
        RowBox[{
         RowBox[{"Normal", "@", "#"}], ",", "1"}], "]"}]}], "&"}], "/@", 
     RowBox[{"Transpose", "[", "seg", "]"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7584353606845264`*^9, 3.758435385386111*^9}, {
  3.7584354600899343`*^9, 3.7584354650010266`*^9}, {3.8662562758072357`*^9, 
