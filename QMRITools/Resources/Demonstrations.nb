Cell[CellGroupData[{

Cell["Patch based unwrap", "Subsubsection",
 CellTags->"c:36",ExpressionUUID->"67a583ec-d68b-4d8e-ae56-a358819f36f5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"unw", "=", 
       RowBox[{"Unwrap", "/@", "im"}]}], ";"}], ")"}], "//", 
    "AbsoluteTiming"}], "//", "First"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Show", " ", "the", " ", "results"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "@", "un"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{"Join", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{
         RowBox[{"Rescale", "[", "#", "]"}], ",", 
         RowBox[{"ImageSize", "->", "150"}]}], "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"im", ",", 
        RowBox[{"Wrap", "[", "unw", "]"}]}], "}"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{
         RowBox[{"Rescale", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "r"}]}], "]"}], ",", 
         RowBox[{"ImageSize", "->", "150"}]}], "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"un", ",", "unw", ",", 
        RowBox[{"un", "-", "unw"}]}], "}"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellLabel->
  "In[880]:=",ExpressionUUID->"bec063f6-bc18-4ebe-8cf2-f2c975726cfb"],

Cell[BoxData["7.3948846`"], "Output",
 CellLabel->
  "Out[880]=",ExpressionUUID->"0725acc1-4974-42dd-b36f-25cdc9b5c7f0"],

