      RowBox[{"[", "1", "]"}], "]"}], ",", "vox", ",", 
     RowBox[{"ContourColor", "->", "\"\<Random\>\""}]}], "]"}]}], 
  "}"}]], "Input",
 CellChangeTimes->{{3.900562165265719*^9, 3.9005621731757307`*^9}, {
