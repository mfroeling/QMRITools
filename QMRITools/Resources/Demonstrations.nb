  "In[147]:=",ExpressionUUID->"4939d1d2-04a2-4d6a-ad27-e24d1fe0ae9b"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Automatic segmentation", "Chapter",
 CellChangeTimes->{{3.7548946289884815`*^9, 3.7548946340141907`*^9}, 
   3.75489504280996*^9, {3.7550018766471786`*^9, 3.75500188405846*^9}, 
   3.755498530622598*^9, {3.913434875090816*^9, 
   3.9134348793008933`*^9}},ExpressionUUID->"d8634280-3b4f-4d67-8ec1-\
4a66ef554d64"],

Cell[CellGroupData[{

Cell["UNET Neural Network", "Subsection",
 CellChangeTimes->{{3.913439198985773*^9, 
  3.913439212676489*^9}},ExpressionUUID->"4b7dfdf0-79ec-41be-a7c5-\
6f0f46055ba7"],

Cell[CellGroupData[{

Cell["Make Network", "Subsubsection",
 CellChangeTimes->{{3.913439541160827*^9, 
  3.9134395499412413`*^9}},ExpressionUUID->"74ad9263-6808-41a2-930a-\
5426c13be898"],

Cell["\<\
Automated segmentation is based on a UNET neural network . The included \
segmentation functions are all based on this network.
A UNET can be generated and manipulated with a number of functions.
To generate a UNET the number of input channels, output classes and the input \
patch size need to be given .
Other settings can be controlled with options .\
\>", "Text",
 CellChangeTimes->{{3.913440537768875*^9, 3.913440545840242*^9}, 
   3.913440768229949*^9, {3.9134420084100103`*^9, 
   3.91344200881002*^9}},ExpressionUUID->"29cdc2eb-bbcc-4ede-840f-\
99ea4033c8b7"],

Cell[BoxData[
 RowBox[{"Column", "@", 
  RowBox[{"Options", "@", "MakeUnet"}]}]], "Input",
 CellChangeTimes->{{3.913439507018381*^9, 3.913439513241387*^9}},
 CellLabel->
  "In[158]:=",ExpressionUUID->"dc810087-da59-4b05-8fb8-a092bdfc922a"],

Cell[BoxData[
 RowBox[{"<<", "QMRIToolsDev`"}]], "Input",
 CellLabel->
  "In[163]:=",ExpressionUUID->"08358a1a-ef1a-ad4b-ba73-8e7931f966de"],

Cell[BoxData[
 RowBox[{"net", "=", 
  RowBox[{"MakeUnet", "[", 
   RowBox[{"2", ",", "4", ",", 
    RowBox[{"{", 
     RowBox[{"16", ",", "80", ",", "80"}], "}"}], ",", 
    RowBox[{"MonitorCalc", "->", "True"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[164]:=",ExpressionUUID->"fbef0133-8e94-433f-835e-a78b3512ccf8"],

Cell["Get information from the network", "Text",
 CellChangeTimes->{{3.913440572027469*^9, 
  3.9134405847769976`*^9}},ExpressionUUID->"36f3e178-d0b0-40f2-9c3b-\
816ca80581d4"],

Cell[BoxData[
 RowBox[{"NetSummary", "[", "net", "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"e9c2ee75-c648-4a9d-97c1-903f48bbf53f"],

Cell[BoxData[
 RowBox[{"NetSummary", "[", 
  RowBox[{"net", ",", "\"\<Full\>\""}], "]"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"094bb3e2-5354-df42-ba7e-24b77f15c5c1"]
}, Closed]],

Cell[CellGroupData[{

Cell["Configure  the network", "Subsubsection",ExpressionUUID->"49dd69e8-4a41-44b0-a8ec-725403def1b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nChan", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nClass", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"netPar", "=", "32"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"depth", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shed", "=", 
   RowBox[{"{", 
    RowBox[{"1", " ", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "2"}], "}"}], " ", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"patch", "=", 
   RowBox[{"{", 
    RowBox[{"32", ",", "112", ",", "112"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dropout", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"block", "=", "\"\<UNet\>\""}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"netU", "=", 
  RowBox[{"MakeUnet", "[", 
   RowBox[{
   "nChan", ",", "nClass", ",", "patch", ",", " ", "\[IndentingNewLine]", 
    RowBox[{"FeatureSchedule", "->", "netPar"}], ",", "\[IndentingNewLine]", 
    RowBox[{"BlockType", "->", "block"}], ",", "\[IndentingNewLine]", 
    RowBox[{"NetworkDepth", "->", "depth"}], ",", "\[IndentingNewLine]", 
    RowBox[{"DropoutRate", "->", "dropout"}], ",", "\[IndentingNewLine]", 
    RowBox[{"DownsampleSchedule", "->", "shed"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->
  "In[165]:=",ExpressionUUID->"9f6c34bf-f1bd-4a69-aed9-d5b38deb8d44"],

Cell[BoxData[
 RowBox[{"NetSummary", "[", "netU", "]"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"c343534c-0fa4-934a-aba4-05fa891693c6"],

Cell[BoxData[
 RowBox[{"NetSummary", "[", 
  RowBox[{"netU", ",", "\"\<Full\>\""}], "]"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"20e12995-2926-5043-9b2a-2204dd74bfee"]
}, Closed]],

Cell[CellGroupData[{

Cell["Change the network", "Subsubsection",
 CellChangeTimes->{{3.913440604269323*^9, 
  3.913440608871997*^9}},ExpressionUUID->"441af3c3-8a00-4407-a852-\
88f0d363baa6"],

Cell["\<\
Some features of a network can be changed without affecting the trained \
elements, others need retraining.
For the retraining only the start and mapping layer need to be retrained.\
\>", "Text",
 CellChangeTimes->{{3.913440667404665*^9, 3.913440701560959*^9}, {
  3.913441057173152*^9, 3.913441062310585*^9}, {3.913441112763072*^9, 
  3.9134411570956507`*^9}},ExpressionUUID->"553cfd99-8d4b-46ea-a0cf-\
91ec2d3c5d22"],

Cell[BoxData[
 RowBox[{
  RowBox[{"netI", "=", 
   RowBox[{"NetInitialize", "[", "netU", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9134407036118774`*^9, 3.9134407123728104`*^9}, {
  3.9134410017861*^9, 3.91344100269531*^9}},
 CellLabel->
  "In[174]:=",ExpressionUUID->"dfaf2a5b-107a-4c0c-a434-cbddb5cd3f8a"],

Cell[BoxData[
 RowBox[{"NetDimensions", "[", "netI", "]"}]], "Input",
 CellChangeTimes->{{3.913440440045806*^9, 3.9134404440126667`*^9}, 
   3.913441018088481*^9},
 CellLabel->
  "In[175]:=",ExpressionUUID->"59231e76-9c21-4e8a-860d-2b8550fc2d65"],

Cell[BoxData[{
 RowBox[{"netI1", "=", 
  RowBox[{"ChangeNetDimensions", "[", 
   RowBox[{"netI", ",", 
    RowBox[{"\"\<Dimensions\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"48", ",", "112", ",", "112"}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"NetDimensions", "[", "netI1", "]"}]}], "Input",
 CellChangeTimes->{{3.913441067930968*^9, 3.9134410851936564`*^9}},
 CellLabel->
  "In[176]:=",ExpressionUUID->"51aa80bf-5dae-41e4-a29f-50a3a621bb2d"],

Cell["\<\
After changing the map and start layers are not initialized. \
\>", "Text",ExpressionUUID->"99340791-f25b-d84d-ac78-afbea62d8e89"],

Cell[BoxData[{
 RowBox[{"netI2", "=", 
  RowBox[{"ChangeNetDimensions", "[", 
   RowBox[{"netI", ",", 
    RowBox[{"\"\<Channels\>\"", "->", "3"}], ",", 
    RowBox[{"\"\<Classes\>\"", "->", "17"}], ",", 
    RowBox[{"\"\<Dimensions\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"48", ",", "112", ",", "112"}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"NetDimensions", "[", "netI2", "]"}]}], "Input",
 CellChangeTimes->{{3.903498747838228*^9, 3.9034987747346478`*^9}, {
  3.903499701804151*^9, 3.903499784055652*^9}, {3.913441013001683*^9, 
  3.91344101450571*^9}, {3.913441082104331*^9, 3.913441082302537*^9}},
 CellLabel->
  "In[178]:=",ExpressionUUID->"fa91cecb-d35d-48d0-ac5d-75b1c6a80574"]
}, Closed]],

Cell[CellGroupData[{

Cell["Add Loss Layer", "Subsubsection",
 CellChangeTimes->{{3.913439554329258*^9, 
  3.913439558485456*^9}},ExpressionUUID->"5e11383d-c076-4b7a-a9ff-\
03e7596cadef"],

Cell["\<\
To train a network a loss function needs to be defined and added .
Automatically 6 different loss layers are added to the network.\
\>", "Text",ExpressionUUID->"ae4c0799-8944-4aa2-903f-5a6353e945fc"],

Cell[BoxData[
 RowBox[{"lossNet", "=", 
  RowBox[{"AddLossLayer", "[", "netU", "]"}]}]], "Input",
 CellChangeTimes->{{3.9134395858343897`*^9, 3.913439618963889*^9}, {
  3.913440995830164*^9, 3.913440996871176*^9}},
 CellLabel->
  "In[180]:=",ExpressionUUID->"f77bb389-20f4-4e1b-bcf3-6917b32ba7d6"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Data manipulation", "Subsection",
 CellChangeTimes->{{3.913439198985773*^9, 3.913439212676489*^9}, {
  3.9134418575290394`*^9, 
  3.91344186100292*^9}},ExpressionUUID->"11d0c3ab-c56a-42f2-99d6-\
b5b0940480dd"],

Cell[CellGroupData[{

Cell["Import Data", "Subsubsection",
 CellChangeTimes->{{3.9134419811202583`*^9, 
  3.913441985197944*^9}},ExpressionUUID->"cca0d92f-b107-42e8-a98e-\
ec676b205e78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"segData", ",", "segV"}], "}"}], "=", 
   RowBox[{"ImportNii", "[", "\"\<seg_data.nii\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"segLab", ",", "segV"}], "}"}], "=", 
   RowBox[{"ImportNii", "[", "\"\<seg_label.nii\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nClass", "=", 
   RowBox[{"Round", "@", 
    RowBox[{"Max", "@", "segLab"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9134418648500443`*^9, 3.913441933052639*^9}, {
  3.913446363170163*^9, 3.913446370205127*^9}, {3.9134471891020947`*^9, 
  3.9134471899321933`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"caf94155-9c4b-4ed9-bd50-cc2cb43426a7"],

Cell[BoxData[
 RowBox[{"PlotData", "[", 
  RowBox[{"segData", ",", "segLab", ",", "segV"}], "]"}]], "Input",
 CellChangeTimes->{{3.913442022339154*^9, 3.913442027910924*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"b0da9dbd-c00d-4b86-8cdb-03aed6f6db02"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Make patches", "Subsubsection",
 CellChangeTimes->{{3.9134420542434607`*^9, 
  3.913442065689386*^9}},ExpressionUUID->"91541c1f-ccaf-4cf5-8dc3-\
76bb1ce946de"],

Cell["\<\
By default all possible patches that need to be made to fully cover the data \
are generated with minimal overlap of the patches.
It also provides the coordinates of the patch within the original dataset.\
\>", "Text",
 CellChangeTimes->{{3.913442141234672*^9, 3.913442177944491*^9}, {
  3.913442311979536*^9, 
  3.913442354314937*^9}},ExpressionUUID->"2b25214e-afbc-4cb5-814a-\
e44021de5ad4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"patch", "=", 
   RowBox[{"{", 
    RowBox[{"32", ",", "112", ",", "112"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"patches", ",", "loc"}], "}"}], "=", 
   RowBox[{"DataToPatches", "[", 
    RowBox[{"segData", ",", "patch", ",", 
     RowBox[{"PatchNumber", "->", "0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "@", "segData"}], ",", 
   RowBox[{"Dimensions", "@", "patches"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "@", "loc"}]}], "Input",
 CellLabel->
  "In[184]:=",ExpressionUUID->"61c3f72d-8273-480c-92bd-b064a605bd13"],

Cell[BoxData[
 RowBox[{"PlotData", "[", 
  RowBox[{"GridData", "[", 
   RowBox[{"patches", ",", "4"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"eaf1ea45-c204-4281-ae81-b0c5249b959b"],

Cell["Combine the patches to recreate the original dataset .", "Text",
 CellChangeTimes->{{3.913443041157716*^9, 
  3.913443062955762*^9}},ExpressionUUID->"c291d4e3-0f8b-4928-84e7-\
1dec78887500"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"segDataRec", "=", 
   RowBox[{"PatchesToData", "[", 
    RowBox[{"patches", ",", "loc"}], "]"}]}], ";"}], "\n", 
 RowBox[{"segData", "==", "segDataRec"}]}], "Input",
 CellChangeTimes->{{3.913442417453819*^9, 3.9134424267497582`*^9}, 
   3.91344425434203*^9},
 CellLabel->
  "In[189]:=",ExpressionUUID->"dfd27fc9-1c36-4ee2-a87c-926d2a226bb6"],

Cell["also works for segmentations", "Text",ExpressionUUID->"fd93fbc4-fc17-124c-80a5-c34f767b7af5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"patches", ",", "loc"}], "}"}], "=", 
   RowBox[{"DataToPatches", "[", 
    RowBox[{
     RowBox[{"Round", "[", "segLab", "]"}], ",", "patch", ",", 
     RowBox[{"PatchNumber", "->", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"PlotData", "[", 
  RowBox[{"GridData", "[", 
   RowBox[{"patches", ",", "4"}], "]"}], "]"}]}], "Input",
 CellLabel->
  "In[191]:=",ExpressionUUID->"647a555b-0525-b74b-92f4-c33eece159ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"segLabRec", "=", 
    RowBox[{"PatchesToData", "[", 
     RowBox[{"patches", ",", "loc", ",", 
      RowBox[{"Dimensions", "@", "segLab"}], ",", 
      RowBox[{"GetSegmentationLabels", "@", "segLab"}]}], "]"}]}], ";"}], "//",
   "AbsoluteTiming"}]], "Input",
 CellLabel->
  "In[193]:=",ExpressionUUID->"2e0d23f4-ebf2-134a-a502-b9f285f538c8"]
}, Closed]],

Cell[CellGroupData[{

Cell["Dynamic visualization of augmentation function", "Subsubsection",
 CellChangeTimes->{{3.9134420542434607`*^9, 3.913442065689386*^9}, {
  3.913444591858127*^9, 
  3.913444600639288*^9}},ExpressionUUID->"b99fe05e-a052-45e4-906f-\
a84b2499a84c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynVox", "=", "segV"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dynDat", "=", 
   RowBox[{"RescaleData", "[", 
    RowBox[{"segData", ",", 
     RowBox[{"{", " ", 
      RowBox[{"segV", ",", "dynVox"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dynSeg", "=", 
   RowBox[{"RescaleSegmentation", "[", 
    RowBox[{"segLab", ",", 
     RowBox[{"{", " ", 
      RowBox[{"segV", ",", "dynVox"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rr", "=", 
   RowBox[{"MinMax", "[", "dynSeg", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dynD", "=", 
    RowBox[{"Dimensions", "[", "dynDat", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"z", ",", "x", ",", "y"}], "}"}], "=", 
   RowBox[{"Round", "[", 
    RowBox[{"dynD", "/", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scale", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f1", ",", "f2", ",", "f3"}], "}"}], "=", " ", 
     RowBox[{"dynD", " ", "dynVox"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"w", "=", 
     RowBox[{"{", 
      RowBox[{
      "r1", ",", "r2", ",", "r3", ",", " ", "t1", ",", " ", "t2", ",", "t3", ",",
        "s1", ",", "s2", ",", "s3", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"time", "=", 
     RowBox[{"First", "@", 
      RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"datT", "=", 
         RowBox[{"DataTransformation", "[", 
          RowBox[{"dynDat", ",", "dynVox", ",", "w", ",", 
           RowBox[{"InterpolationOrder", "->", "1"}], ",", 
           RowBox[{"PadOutputDimensions", "->", "pad"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"segT", "=", 
         RowBox[{"DataTransformation", "[", 
          RowBox[{"dynSeg", ",", "dynVox", ",", "w", ",", 
           RowBox[{"InterpolationOrder", "->", "0"}], ",", 
           RowBox[{"PadOutputDimensions", "->", "pad"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cr", "=", 
         RowBox[{"FindCrop", "[", 
          RowBox[{"datT", ",", 
           RowBox[{"CropPadding", "->", "0"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"datTc", ",", "segTc"}], "}"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"ApplyCrop", "[", 
            RowBox[{"#", ",", "cr"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"datT", ",", "segT"}], "}"}]}]}], ";"}], 
       "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", ",", "x", ",", "y"}], "}"}], "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dd", " ", "=", " ", 
         RowBox[{"Dimensions", "[", "datTc", "]"}]}], ")"}], "/", "2"}], 
      "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Grid", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<evaluation time:  \>\"", ",", 
            RowBox[{"1000", "time"}], ",", "\"\< ms\>\""}], "}"}], "]"}], ",",
          "SpanFromLeft", ",", "SpanFromLeft"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<data dimensions:  \>\"", ",", "dd"}], "}"}], "]"}], ",",
          "SpanFromLeft", ",", "SpanFromLeft"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"MakeChannelClassImage", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"datTc", "[", 
               RowBox[{"[", 
                RowBox[{"z", ",", "All", ",", "All"}], "]"}], "]"}], "}"}], ",", 
             RowBox[{"segTc", "[", 
              RowBox[{"[", 
               RowBox[{"z", ",", "All", ",", "All"}], "]"}], "]"}], ",", 
             "rr"}], "]"}], ",", 
           RowBox[{"AspectRatio", "->", 
            RowBox[{"Divide", "@@", 
             RowBox[{"scale", "[", 
              RowBox[{"[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}], "]"}], "]"}]}]}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "300"}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"MakeChannelClassImage", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Reverse", "@", 
               RowBox[{"datTc", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "x", ",", "All"}], "]"}], "]"}]}], "}"}],
              ",", 
             RowBox[{"Reverse", "@", 
              RowBox[{"segTc", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "x", ",", "All"}], "]"}], "]"}]}], ",", 
             "rr"}], "]"}], ",", 
           RowBox[{"AspectRatio", "->", 
            RowBox[{"Divide", "@@", 
             RowBox[{"scale", "[", 
              RowBox[{"[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "3"}], "}"}], "]"}], "]"}]}]}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "300"}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"MakeChannelClassImage", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Reverse", "@", 
