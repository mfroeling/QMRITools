Cell["Filter the tracts based on various types of ROIs", "Text",
 CellChangeTimes->{{3.837509851965728*^9, 3.8375098628005795`*^9}, {
   3.8375132423252225`*^9, 3.837513244198758*^9}, 3.86202748369426*^9, {
