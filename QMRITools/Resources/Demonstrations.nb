18c3955c2e22"],

Cell[BoxData[
 RowBox[{"Dimensions", "/@", 
  RowBox[{"{", 
   RowBox[{"data", ",", 
    RowBox[{"RotateDimensionsLeft", "@", "data"}], ",", 
    RowBox[{"RotateDimensionsRight", "@", "data"}], ",", 
    RowBox[{"RotateDimensionsLeft", "[", 
     RowBox[{"data", ",", "2"}], "]"}], ",", 
    RowBox[{"ReverseDimensions", "@", "data"}]}], "}"}]}]], "Input",
