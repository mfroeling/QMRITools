       RowBox[{"various", " ", "mixing", " ", "times"}], "*)"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Row", "[", "pls", "]"}]}], "Input",ExpressionUUID->"b250ee77-119c-\
4a6c-ae60-654c651ae432"]
