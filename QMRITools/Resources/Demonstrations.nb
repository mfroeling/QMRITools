  3.8380966657189484`*^9}},ExpressionUUID->"344c9d85-ee70-472b-9f36-\
9f65fe863cee"],

Cell["\<\
Split a Segmentation in 5 equal parts along the slice direction\
\>", "Text",
 CellChangeTimes->{{3.754900015110106*^9, 3.754900028063248*^9}, {
  3.7549968084521017`*^9, 
  3.75499681990247*^9}},ExpressionUUID->"1b611f18-649c-473d-992a-\
229c3cb8c4f4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"loc", ",", "segSplit"}], "}"}], "=", 
   RowBox[{"SegmentMask", "[", 
    RowBox[{
     RowBox[{"seg", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"l", "=", 
  RowBox[{"Ceiling", "[", 
   RowBox[{"n", " ", "loc"}], "]"}]}], "\[IndentingNewLine]", 
