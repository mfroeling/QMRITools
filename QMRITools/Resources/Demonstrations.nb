Cell[CellGroupData[{

Cell["DCT based unwrap", "Subsubsection",
 CellTags->"c:36",ExpressionUUID->"630c46d0-f2c4-491c-afe3-23f8ee4f954d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"unw", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"UnwrapDCT", "[", 
          RowBox[{"#", ",", "Automatic"}], "]"}], "&"}], "/@", "im"}]}], 
      ";"}], ")"}], "//", "AbsoluteTiming"}], "//", "First"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Show", " ", "the", " ", "results"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "@", "un"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{"Join", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{
         RowBox[{"Rescale", "[", "#", "]"}], ",", 
         RowBox[{"ImageSize", "->", "150"}]}], "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"im", ",", 
        RowBox[{"Wrap", "[", "unw", "]"}]}], "}"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{
         RowBox[{"Rescale", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "r"}]}], "]"}], ",", 
         RowBox[{"ImageSize", "->", "150"}]}], "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"un", ",", "unw", ",", 
        RowBox[{"un", "-", "unw"}]}], "}"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellLabel->
  "In[275]:=",ExpressionUUID->"7f3d0efa-f87b-496f-bd36-5fcc6ab8771f"],

