Cell[CellGroupData[{

Cell["Muscle Naming", "Subsection",
 CellChangeTimes->{{3.913450357425166*^9, 
  3.913450364854804*^9}},ExpressionUUID->"57d9be71-701a-4227-89de-\
04d6ada42923"],

Cell["\<\
Within the segmentation framework standardized label names and numbers are \
used for segmentation.
Switching between names and numbers can be done using the standard convention \
or with a custom label file in the ITKSnap format.\
\>", "Text",
 CellChangeTimes->{{3.913450564507585*^9, 
  3.913450656631499*^9}},ExpressionUUID->"79d8ebfb-c5a1-4799-8bd2-\
fdab62551eec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"default", " ", "naming", " ", "file"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"file", "=", 
   RowBox[{
   "GetAssetLocation", "[", "\"\<MusclesLegAllLabels\>\"", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.913450676241894*^9, 3.913450692231413*^9}, {
   3.913451028182448*^9, 3.913451029794032*^9}, 3.9169949984836464`*^9},
 CellLabel->"In[97]:=",ExpressionUUID->"4433335e-8077-4c54-b56b-9963f3158849"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "names", " ", "and", " ", "labels", " ", "in", " ", "the", " ", "default", 
    " ", "file"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"ImportITKLabels", "[", 
   RowBox[{"GetAssetLocation", "[", "\"\<MusclesLegAllLabels\>\"", "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.913450660071272*^9, 3.913450705770611*^9}, 
   3.9169950008015385`*^9},
 CellLabel->"In[98]:=",ExpressionUUID->"7143d246-133b-408d-a97e-fedd9f6d0157"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"namesL", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Lateral_Gastrocnemius\>\"", 
     ",", "\"\<Medial_Gastrocnemius\>\"", ",", "\"\<Tibia\>\"", 
     ",", "\"\<Fibularis_Longus\>\"", ",", "\"\<Fibularis_Tertius\>\""}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"namesU", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Rectus_Femoris\>\"", ",", "\"\<Vastus_Intermedius\>\"", 
     ",", "\"\<Adductor_Brevis\>\"", ",", "\"\<Femur\>\"", 
     ",", "\"\<Gracilis\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mLeft", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "<>", "\"\<_Left\>\""}], "&"}], "/@", 
    RowBox[{"Join", "[", 
     RowBox[{"namesL", ",", "namesU"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mRight", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "<>", "\"\<_Right\>\""}], "&"}], "/@", 
     RowBox[{"Join", "[", 
      RowBox[{"namesL", ",", "namesU"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"num", "=", 
  RowBox[{"MuscleNameToLabel", "[", 
   RowBox[{"lab", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"mLeft", ",", "mRight"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"labc", "=", 
  RowBox[{"MuscleLabelToName", "[", "num", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"lab", "==", "labc"}]}], "Input",
 CellChangeTimes->{{3.9134504572720413`*^9, 3.913450470721317*^9}, {
  3.913450715624029*^9, 3.913450749145438*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"1a4b25b7-de9e-46dd-bb5f-a9060d7b7e28"],

Cell[BoxData[
 RowBox[{"MuscleLabelToName", "@", 
  RowBox[{"GetSegmentationLabels", "@", "labels"}]}]], "Input",
 CellChangeTimes->{{3.9699414345414944`*^9, 3.9699414535460587`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"628e818a-c8b8-b044-afb8-7d911664f2b9"]
}, Closed]],

