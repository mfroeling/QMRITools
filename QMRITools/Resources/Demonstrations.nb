   RowBox[{
   "automatically", " ", "split", " ", "the", " ", "data", " ", "into", " ", 
    "left", " ", "and", " ", "right"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"left", ",", "right", ",", "cut"}], "}"}], "=", 
     RowBox[{"CutData", "[", 
      RowBox[{"data", ",", "True"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "cut"}]}]], "Input",
