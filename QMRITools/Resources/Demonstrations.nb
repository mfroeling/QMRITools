 CellLabel->
  "In[111]:=",ExpressionUUID->"ff560c23-792c-49a2-9cd2-ce9d09a17f64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tensF", "=", 
   RowBox[{"AnisoFilterTensor", "[", 
    RowBox[{"tens", ",", "datareg", ",", 
     RowBox[{"AnisoFilterSteps", "\[Rule]", "3"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7549202250785255`*^9, 3.754920239701653*^9}, 
   3.755001029185559*^9, {3.8709322499734344`*^9, 3.870932251397116*^9}},
 CellLabel->
  "In[210]:=",ExpressionUUID->"3fe6c7c2-00b5-4d1e-b4f8-750688380984"],

