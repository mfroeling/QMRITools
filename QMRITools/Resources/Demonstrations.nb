  3.754996722907762*^9, 3.754996739591938*^9}, {3.754997287286001*^9, 
  3.754997290443138*^9}},ExpressionUUID->"1f4758f5-443f-4df8-b208-\
0f642bb70f02"],

Cell[BoxData[
