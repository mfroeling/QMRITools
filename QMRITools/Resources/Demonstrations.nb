       RowBox[{"Image", "[", 
        RowBox[{
         RowBox[{"Rescale", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}], "r"}]}], "]"}], ",", 
         RowBox[{"ImageSize", "->", "150"}]}], "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"un", ",", "unw", ",", 
        RowBox[{"un", "-", "unw"}]}], "}"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
