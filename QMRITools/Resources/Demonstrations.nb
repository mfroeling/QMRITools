  "In[128]:=",ExpressionUUID->"73c1be5e-ad36-4648-8909-3528e2e910da"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"display", " ", "the", " ", "data", " ", "with", " ", "PlotData"}],
    "*)"}], "\[IndentingNewLine]", 
  RowBox[{
