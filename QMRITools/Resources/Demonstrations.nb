     RowBox[{"FindActivations", "[", 
      RowBox[{"dwiS", ",", " ", "mask", ",", 
       RowBox[{"IgnoreSlices", "->", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3"}], "}"}]}], ",", 
       RowBox[{"ActivationThreshold", "->", 
