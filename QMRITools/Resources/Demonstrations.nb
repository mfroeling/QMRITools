Cell[CellGroupData[{

Cell["Fit the tensors", "Subsubsection",
 CellChangeTimes->{{3.755000277646787*^9, 3.755000283657793*^9}},
 CellTags->"c:62",ExpressionUUID->"46110b45-9f52-4171-ae7f-cc9053aa8a39"],

Cell["Calculate tensor from corrected data", "Text",
 CellChangeTimes->{{3.755000205572136*^9, 
  3.755000211162477*^9}},ExpressionUUID->"9b1f7978-adca-4e60-bbe3-\
3c5f3c0ab3f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "takes", " ", "a", " ", "while", " ", "so", " ", "you", " ", "can", " ", 
    "also", " ", "just", " ", "import"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tensB", ",", "S0", ",", "res"}], "}"}], "=", 
      RowBox[{"TensorCalc", "[", 
       RowBox[{"datareg", ",", "gradR", ",", "valR", ",", 
        RowBox[{"RobustFit", "->", "False"}], ",", 
        RowBox[{"Method", "->", "\"\<LLS\>\""}], ",", 
        RowBox[{"Parallelize", "->", "True"}]}], "]"}]}], ";"}], "//", 
    "AbsoluteTiming"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tensW", ",", "S0", ",", "res"}], "}"}], "=", 
      RowBox[{"TensorCalc", "[", 
       RowBox[{"datareg", ",", "gradR", ",", "valR", ",", 
        RowBox[{"RobustFit", "->", "False"}], ",", 
        RowBox[{"Method", "->", "\"\<WLLS\>\""}], ",", 
        RowBox[{"Parallelize", "->", "True"}]}], "]"}]}], ";"}], "//", 
    "AbsoluteTiming"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tensWi", ",", "S0", ",", "res"}], "}"}], "=", 
      RowBox[{"TensorCalc", "[", 
       RowBox[{"datareg", ",", "gradR", ",", "valR", ",", 
        RowBox[{"RobustFit", "->", "False"}], ",", 
        RowBox[{"Method", "->", "\"\<iWLLS\>\""}], ",", 
        RowBox[{"Parallelize", "->", "True"}]}], "]"}]}], ";"}], "//", 
    "AbsoluteTiming"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tens", ",", "S0", ",", 
        RowBox[{"{", 
         RowBox[{"out", ",", "res"}], "}"}]}], "}"}], "=", 
      RowBox[{"TensorCalc", "[", 
       RowBox[{"datareg", ",", "gradR", ",", "valR", ",", 
        RowBox[{"RobustFit", "->", "True"}], ",", 
        RowBox[{"Method", "->", "\"\<iWLLS\>\""}], ",", 
        RowBox[{"Parallelize", "->", "True"}]}], "]"}]}], ";"}], "//", 
    "AbsoluteTiming"}]}]}]], "Input",
 CellLabel->
  "In[454]:=",ExpressionUUID->"6d6d1437-70ce-594f-a433-b47ab38e0eb8"],

