Cell[BoxData[
 RowBox[{"PlotData", "[", 
  RowBox[{"GridData", "[", 
   RowBox[{
    RowBox[{"PadToDimensions", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"AugmentTrainingData", "[", 
        RowBox[{"segData", ",", "segV"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "16"}], "}"}]}], "]"}]}], ",", "4"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"7336c50c-d85c-424f-afc9-c47b1bcbad79"],

Cell["Generate 20 patches with augmentation of the same dataset", "Text",ExpressionUUID->"e3363388-8239-403b-81a4-9db86f906d64"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"augDats", ",", "augLabs"}], "}"}], "=", 
    RowBox[{"Transpose", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"AugmentTrainingData", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"segData", ",", "segLab"}], "}"}], ",", "segV", ",", 
         RowBox[{"{", 
          RowBox[{
          "True", ",", "True", ",", " ", "True", ",", "True", ",", "True"}], 
          "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "20"}], "}"}]}], "]"}]}]}], ";"}], "//", 
  "AbsoluteTiming"}]], "Input",
 CellLabel->
  "In[136]:=",ExpressionUUID->"41e4f2c2-5bd1-8847-a700-ea395071fa38"],

Cell[BoxData[
 RowBox[{"PlotData", "[", 
  RowBox[{
   RowBox[{"Transpose", "@", 
    RowBox[{"PadToDimensions", "@", "augDats"}]}], ",", 
   RowBox[{"Transpose", "@", 
    RowBox[{"PadToDimensions", "@", "augLabs"}]}], ",", "segV"}], 
  "]"}]], "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"cba302ab-95a2-4d0a-9c0d-99d79384222f"],

Cell["\<\
Can also be used to augment for pretraining where the target is the clean data\
\>", "Text",ExpressionUUID->"b19cbf28-42bf-3640-823f-51f40f9b71b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"augDats", ",", "augLabs"}], "}"}], "=", 
    RowBox[{"Transpose", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"AugmentTrainingData", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"segData", ",", "segLab"}], "}"}], ",", "segV", ",", 
         RowBox[{"{", 
          RowBox[{
          "True", ",", "True", ",", " ", "True", ",", "True", ",", "True"}], 
          "}"}], ",", 
         RowBox[{"\"\<AugmentMask\>\"", "->", "True"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "20"}], "}"}]}], "]"}]}]}], ";"}], "//", 
  "AbsoluteTiming"}]], "Input",
