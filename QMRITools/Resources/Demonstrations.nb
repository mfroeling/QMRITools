 CellTags->"c:25",ExpressionUUID->"69a2c8a5-fb3b-4839-94de-bdb3a0a3b69c"],

Cell["\<\
Automated Binarization.
Normalize the data to the mean of the data such that the mean data within an \
automated mask will be 100.\
\>", "Text",
 CellChangeTimes->{{3.758435238643988*^9, 3.758435247910249*^9}, {
  3.869798677092761*^9, 3.86979868226071*^9}, {3.869799058629578*^9, 
  3.8697990601018744`*^9}},ExpressionUUID->"6450432f-96f9-42ed-9572-\
f7f4702bc1a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataN", "=", 
   RowBox[{"NormalizeData", "[", "data", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mask", "=", 
   RowBox[{"Mask", "[", 
    RowBox[{"dataN", ",", 
     RowBox[{"MaskDilation", "->", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dataH", "=", 
    RowBox[{"HomogenizeData", "[", "dataN", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MeanNoZero", "@", 
    RowBox[{"GetMaskData", "[", 
     RowBox[{"data", ",", "mask"}], "]"}]}], ",", 
   RowBox[{"MeanNoZero", "@", 
    RowBox[{"GetMaskData", "[", 
     RowBox[{"dataN", ",", "mask"}], "]"}]}], ",", 
   RowBox[{"MeanNoZero", "@", 
    RowBox[{"GetMaskData", "[", 
     RowBox[{"dataH", ",", "mask"}], "]"}]}]}], "}"}]}], "Input",
 CellChangeTimes->{{3.75489694083027*^9, 3.7548969455958157`*^9}, 
   3.758435252074816*^9, {3.765524025920835*^9, 3.765524030978495*^9}, 
