Fit and show the IVIM signal of the whole volume\
\>", "Text",ExpressionUUID->"c0285daf-d6f8-45d3-b7b0-a5175ce9af64"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dwiIso", ",", "bval"}], "}"}], "=", 
   RowBox[{"MeanBvalueSignal", "[", 
    RowBox[{"datareg", ",", "valR"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigI", "=", 
   RowBox[{"MeanSignal", "[", "dwiIso", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"init", "=", 
   RowBox[{"IVIMCalc", "[", 
    RowBox[{"sigI", ",", "bval", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", ".05", ",", ".0015", ",", ".015"}], "}"}], ",", 
     RowBox[{"IVIMFixed", "->", "False"}], ",", 
     RowBox[{"IVIMConstrained", "->", "False"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"PlotIVIM", "[", 
  RowBox[{"init", ",", "sigI", ",", "bval", ",", 
   RowBox[{"ImageSize", "\[Rule]", "200"}]}], "]"}]}], "Input",
 CellLabel->
  "In[1241]:=",ExpressionUUID->"03dca666-6999-6246-a155-19e39337bf26"]
}, Closed]],

