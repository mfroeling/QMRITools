     RowBox[{"PlotTracts", "[", 
      RowBox[{"#", ",", "vox", ",", "dim", ",", 
       RowBox[{"MaxTracts", "->", "1000"}], ",", 
       RowBox[{"TractColoring", "->", "\"\<Direction\>\""}], ",", 
       RowBox[{"Method", "->", "\"\<tube\>\""}]}], "]"}]}], "&"}], "/@", 
   RowBox[{"{", 
    RowBox[{"tracts", ",", "tractsSF"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"833cfcce-dcdc-2f48-80e0-7944519c228c"],

Cell[BoxData[
 RowBox[{"PlotTracts", "[", 
  RowBox[{"tractsS", ",", "dim", ",", "vox", ",", 
   RowBox[{"Method", "->", "\"\<tube\>\""}], ",", 
   RowBox[{"Boxed", "->", "False"}], ",", 
   RowBox[{"MaxTracts", "->", "5000"}], ",", 
   RowBox[{"TractSize", "->", "0.7"}], ",", 
   RowBox[{"TractReduction", "->", "1"}], ",", 
