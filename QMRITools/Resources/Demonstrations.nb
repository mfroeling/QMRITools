Cell[CellGroupData[{

Cell["Tensor analysis", "Subsection",
 CellChangeTimes->{{3.754920706637082*^9, 3.754920714715969*^9}, {
  3.7550002741128864`*^9, 3.755000276412504*^9}},
 CellTags->"c:61",ExpressionUUID->"46cb5c22-df36-42f1-8278-128db9e6546d"],

Cell[CellGroupData[{

Cell["Fit the tensors", "Subsubsection",
 CellChangeTimes->{{3.755000277646787*^9, 3.755000283657793*^9}},
 CellTags->"c:62",ExpressionUUID->"46110b45-9f52-4171-ae7f-cc9053aa8a39"],

Cell["Calculate tensor from corrected data", "Text",
 CellChangeTimes->{{3.755000205572136*^9, 
  3.755000211162477*^9}},ExpressionUUID->"9b1f7978-adca-4e60-bbe3-\
3c5f3c0ab3f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "takes", " ", "a", " ", "while", " ", "so", " ", "you", " ", "can", " ", 
    "also", " ", "just", " ", "import"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tensB", ",", "S0", ",", "res"}], "}"}], "=", 
      RowBox[{"TensorCalc", "[", 
       RowBox[{"datareg", ",", "grad", ",", "val", ",", 
        RowBox[{"RobustFit", "->", "False"}], ",", 
        RowBox[{"Method", "->", "\"\<LLS\>\""}], ",", 
        RowBox[{"Parallelize", "->", "True"}]}], "]"}]}], ";"}], "//", 
    "AbsoluteTiming"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tensW", ",", "S0", ",", "res"}], "}"}], "=", 
      RowBox[{"TensorCalc", "[", 
       RowBox[{"datareg", ",", "grad", ",", "val", ",", 
        RowBox[{"RobustFit", "->", "False"}], ",", 
        RowBox[{"Method", "->", "\"\<WLLS\>\""}], ",", 
        RowBox[{"Parallelize", "->", "True"}]}], "]"}]}], ";"}], "//", 
    "AbsoluteTiming"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tensWi", ",", "S0", ",", "res"}], "}"}], "=", 
      RowBox[{"TensorCalc", "[", 
       RowBox[{"datareg", ",", "grad", ",", "val", ",", 
        RowBox[{"RobustFit", "->", "False"}], ",", 
        RowBox[{"Method", "->", "\"\<iWLLS\>\""}], ",", 
        RowBox[{"Parallelize", "->", "True"}]}], "]"}]}], ";"}], "//", 
    "AbsoluteTiming"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tens", ",", "S0", ",", 
        RowBox[{"{", 
         RowBox[{"out", ",", "res"}], "}"}]}], "}"}], "=", 
      RowBox[{"TensorCalc", "[", 
       RowBox[{"datareg", ",", "grad", ",", "val", ",", 
        RowBox[{"RobustFit", "->", "True"}], ",", 
        RowBox[{"Method", "->", "\"\<iWLLS\>\""}], ",", 
        RowBox[{"Parallelize", "->", "True"}]}], "]"}]}], ";"}], "//", 
    "AbsoluteTiming"}]}]}]], "Input",
 CellChangeTimes->{{3.962944387641121*^9, 3.962944389529806*^9}, {
  3.963298828036543*^9, 3.963298840589567*^9}, {3.9632988769912834`*^9, 
  3.9632988834082127`*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"6d6d1437-70ce-594f-a433-b47ab38e0eb8"],

Cell["Compare the fitting methods parameter maps.", "Text",
 CellChangeTimes->{{3.963299021125458*^9, 
  3.963299026894619*^9}},ExpressionUUID->"9b03a62e-2c8d-df4b-90c1-\
e52ec82d5013"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"crp", "=", 
   RowBox[{"FindCrop", "[", "mdata", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"PlotData", "[", 
  RowBox[{
   RowBox[{"GridData", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ParameterCalc", "[", 
        RowBox[{
         RowBox[{
