Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MedianNoZero", "@", 
    RowBox[{"Flatten", "@", "noise2"}]}], ",", 
   RowBox[{"Median", "@", 
    RowBox[{"Flatten", "@", "noise2"}]}]}], "}"}]], "Input",
 CellChangeTimes->{{3.758455301330388*^9, 3.7584553080034685`*^9}},
 CellLabel->
