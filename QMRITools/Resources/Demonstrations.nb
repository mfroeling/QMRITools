Cell[CellGroupData[{

Cell["Visualize Function Dependance", "Subsection",
 CellChangeTimes->{{3.91345441271451*^9, 
  3.913454425995268*^9}},ExpressionUUID->"5e495715-ac29-4355-8c79-\
530687271bae"],

Cell[CellGroupData[{

Cell["All functions", "Subsubsection",
 CellChangeTimes->{{3.91345445253969*^9, 
  3.9134544668219457`*^9}},ExpressionUUID->"e0943110-2092-479a-a17f-\
07754f3959ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "load", " ", "all", " ", "functions", " ", "and", " ", "contexts"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tool", ",", "funcs"}], "}"}], "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"QMRIToolsFunctions", "[", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"1", ";;", "2"}]}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"list", " ", "most", " ", "complicated", " ", "functions"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Quiet", "[", 
      RowBox[{
       RowBox[{"Reverse", "[", 
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"VertexCount", "[", 
              RowBox[{"First", "@", 
               RowBox[{"MakeFunctionGraph", "[", "#", "]"}]}], "]"}], ",", 
             "#"}], "}"}], "&"}], "/@", 
          RowBox[{"Flatten", "[", "funcs", "]"}]}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "15"}], "]"}], "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "]"}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"visualize", " ", "each", " ", "function"}], "*)"}], "\n", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{"First", "@", 
        RowBox[{"First", "@", 
         RowBox[{"Position", "[", 
          RowBox[{"tool", ",", "tl"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"f", "===", "\"\<\>\""}], ",", 
        RowBox[{"Graphics", "[", "]"}], ",", 
        RowBox[{"Column", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"f", ",", " ", 
              RowBox[{"LightDarkSwitched", "[", 
               RowBox[{"Black", ",", "White"}], "]"}], ",", "Large", ",", 
              "Bold"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MakeFunctionGraph", "[", 
             RowBox[{"f", ",", 
              RowBox[{"LabelPlacement", "\[Rule]", "name"}], ",", 
              RowBox[{"AllowSelfDependencies", "\[Rule]", "dep"}]}], "]"}]}], 
           "\[IndentingNewLine]", "}"}], ",", 
          RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
