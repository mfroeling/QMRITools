       RowBox[{"ActivationOutput", "->", "All"}], ",", 
       RowBox[{"MaskDilation", "->", "2"}], ",", " ", 
       RowBox[{"ActivationIterations", "->", " ", "5"}], ",", " ", 
       RowBox[{"ActivationBackground", "->", "10"}]}], "]"}]}]}], ";"}], "//",
   "AbsoluteTiming"}]], "Input",
 CellChangeTimes->{{3.879504001732992*^9, 3.8795040027250123`*^9}},
