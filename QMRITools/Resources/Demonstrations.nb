Cell[CellGroupData[{

Cell["Augment train data", "Subsubsection",
 CellChangeTimes->{{3.913446630271674*^9, 
  3.913446641361117*^9}},ExpressionUUID->"1de02039-6c06-43c4-9eff-\
a6eee0cce8e9"],

Cell[BoxData[
 RowBox[{"<<", "QMRIToolsDev`"}]], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"4b915e0b-0f67-df41-9d04-1cb2c854e7d1"],

Cell["\<\
For training the loading and augmentation can be combined, this can be done \
from disk or from memory.
The set one augmentation step is done, then one or multiple patches can be \
created from the same set\
\>", "Text",
 CellChangeTimes->{{3.913445425583524*^9, 3.913445469046076*^9}, {
  3.913446171910502*^9, 
  3.913446172043259*^9}},ExpressionUUID->"d60da325-8a24-414e-9511-\
94eec0ff0639"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"segData", ",", "segV"}], "}"}], "=", 
   RowBox[{"ImportNii", "[", "\"\<seg_data.nii\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"segLab", ",", "segV"}], "}"}], "=", 
   RowBox[{"ImportNii", "[", "\"\<seg_label.nii\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"patch", "=", 
   RowBox[{"{", 
    RowBox[{"32", ",", "112", ",", "112"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nClass", "=", 
   RowBox[{"Round", "@", 
    RowBox[{"Max", "@", "segLab"}]}]}], ";"}]}], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"3be69e21-60c7-eb46-964c-4c464b6138c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"trainDat", "=", 
    RowBox[{"GetTrainData", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\"\<seg_data.nii\>\"", ",", "\"\<seg_label.nii\>\""}], "}"}],
        "}"}], ",", "9", ",", "patch", ",", 
      RowBox[{"PatchesPerSet", "->", "1"}], ",", 
      RowBox[{"PadData", "->", "2"}]}], "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}], "\n", 
 RowBox[{"Grid", "@", 
  RowBox[{"Partition", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"MakeChannelClassImage", "[", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "nClass"}], "}"}], ",", " ", "segV"}], "]"}], 
      "&"}], "/@", "trainDat"}], ",", "3"}], "]"}]}]}], "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"fdb1647a-c80b-aa46-bc16-1117c14d85fd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10.6493529`", ",", "Null"}], "}"}]], "Output",
