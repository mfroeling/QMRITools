Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nEcho", ",", "fEcho", ",", "dEcho"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "2.6", ",", "0.76"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"echos", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"fEcho", " ", "+", " ", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{"nEcho", "-", "1"}]}], "]"}], "dEcho"}]}], ")"}], "/", 
     "1000."}]}], ";"}], " ", 
