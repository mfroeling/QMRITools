      RowBox[{"sigv", ",", "nes"}], "}"}]}], "}"}], " ", "=", " ", 
   RowBox[{"PCADeNoise", "[", 
    RowBox[{"dwi", ",", "mask", ",", 
     RowBox[{"PCAOutput", "\[Rule]", "True"}], ",", 
     RowBox[{"PCATollerance", "\[Rule]", "0"}], ",", 
     RowBox[{"MonitorCalc", "->", "True"}]}], "]"}]}], ";"}]], "Input",Express\
ionUUID->"b25ec0c8-9dee-4355-8b9d-d5d64b8430a5"],

