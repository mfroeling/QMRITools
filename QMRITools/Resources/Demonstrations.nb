Cell["Register And Apply to other Data", "Subsection",
 CellChangeTimes->{{3.755498259797733*^9, 3.755498271396658*^9}},
 CellTags->"c:33",ExpressionUUID->"52e9fa03-400d-4512-9bf9-1437a0e5fcb7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"testM", ",", "lab"}], "}"}], "=", 
   RowBox[{"SplitSegmentations", "[", 
    RowBox[{"RescaleSegmentation", "[", 
     RowBox[{"labels", ",", 
      RowBox[{"Dimensions", "@", "water"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testS", "=", 
