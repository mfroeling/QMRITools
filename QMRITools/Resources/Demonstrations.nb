  "In[176]:=",ExpressionUUID->"7a02e95a-55d3-4dcf-811f-6f7a57c0aed4"],

Cell[BoxData[
 RowBox[{"PlotData", "[", 
  RowBox[{"dwiIso", ",", "res", ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "200"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "10"}], "}"}]}], "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.758440767656734*^9, 3.7584408171734514`*^9}},
 CellLabel->
  "In[177]:=",ExpressionUUID->"c8cd8936-aaa0-4ffd-bcc6-64ae1a6de48c"]
}, Closed]],

