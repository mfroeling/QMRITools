Cell["Simulate RF pulse using bloch", "Text",
 CellChangeTimes->{{3.758436631234725*^9, 3.758436643807841*^9}, {
  3.758437145534289*^9, 
  3.758437148796986*^9}},ExpressionUUID->"08e92c98-8105-4c77-848e-\
