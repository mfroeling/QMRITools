Cell["\<\
Using MotionCorrectSets->True is similar to using CorrectjoinSetMotion\
\>", "Text",
 CellChangeTimes->{{3.758439253411528*^9, 
  3.75843928223833*^9}},ExpressionUUID->"80e50c85-aa4a-47c4-beb7-\
0309b49cd6c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"joinedC2", "=", 
   RowBox[{"JoinSets", "[", 
    RowBox[{
     RowBox[{"CorrectJoinSetMotion", "[", 
      RowBox[{"dataJ", ",", 
       RowBox[{"voxJ", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "overlap"}], "]"}], ",", 
     "overlap"}], "]"}]}], ";"}]], "Input",
