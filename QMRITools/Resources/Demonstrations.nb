 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Find", " ", "corp", " ", "finds", " ", "the", " ", "crop", " ", "values", 
    " ", "to", " ", "remove", " ", "zero", " ", "background"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"crop", "=", 
   RowBox[{"FindCrop", "[", "data", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.7548957772353544`*^9, 3.75489578023491*^9}, {
   3.7548958558205953`*^9, 3.754895858171589*^9}, {3.796883647542039*^9, 
