Cell[CellGroupData[{

Cell["Fiber Tractography ", "Subsection",
 CellChangeTimes->{{3.755000756204663*^9, 3.755000761412519*^9}, 
   3.837509656231181*^9, {3.865585671012499*^9, 3.865585679380221*^9}},
 CellTags->"c:70",ExpressionUUID->"d662ecba-578b-4489-8e5f-fa36d3871aa7"],

Cell["Process the muscle masks", "Text",
 CellChangeTimes->{{3.877347372606675*^9, 
  3.877347383840877*^9}},ExpressionUUID->"ce2c72f1-c0ce-4827-9fa9-\
f34eb0a6ffbf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"masks", ",", "labs"}], "}"}], "=", 
   RowBox[{"SplitSegmentations", "[", 
    RowBox[{"SmoothSegmentation", "[", 
     RowBox[{"labels", ",", 
      RowBox[{"MaskComponents", "\[Rule]", "0"}], ",", 
      RowBox[{"MaskClosing", "\[Rule]", "0"}], ",", 
      RowBox[{"MaskFiltKernel", "\[Rule]", "0"}], ",", 
      RowBox[{"MaskDilation", "\[Rule]", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"all", "=", 
   RowBox[{"Dilation", "[", 
    RowBox[{
     RowBox[{"Normal", "@", 
      RowBox[{"Total", "@", 
       RowBox[{"Transpose", "@", 
        RowBox[{"masks", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "All"}], 
          RowBox[{"(*", 
           RowBox[{"5", ";;", "6"}], "*)"}], "]"}], "]"}]}]}]}], ",", "1"}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[89]:=",ExpressionUUID->"e94f71ad-35d3-45b1-b3f9-da7a4a305fbf"],

Cell["\<\
Calculate the tensor parameters which will be used as stop criteria\
\>", "Text",
 CellChangeTimes->{{3.8375096937244864`*^9, 
  3.8375097131614184`*^9}},ExpressionUUID->"416dd865-07cf-4983-831e-\
47ee4c74ed0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"l1", ",", "l2", ",", "l3", ",", "md", ",", "fa"}], "}"}], "=", 
   RowBox[{"ParameterCalc", "[", "tensF", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.8375106064921355`*^9, {3.837511371858053*^9, 3.83751140314091*^9}, 
   3.837512222171653*^9, 3.848570540733254*^9, {3.862028663220238*^9, 
   3.862028663556521*^9}, {3.865582967526085*^9, 3.8655829676895804`*^9}, {
   3.869804537510588*^9, 3.869804539753971*^9}, 3.900563059580729*^9, 
   3.900563124314255*^9},
 CellLabel->"In[91]:=",ExpressionUUID->"d1993912-fbeb-4d5c-9270-ec462e67e431"],

Cell["Define where the tractography is allowed", "Text",
 CellChangeTimes->{{3.83750972099186*^9, 
  3.837509741100566*^9}},ExpressionUUID->"0e98120e-f12a-4c08-9535-\
de77cbef1e91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"stop", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"all", ",", 
       RowBox[{"{", 
        RowBox[{"0.9", ",", "1.1"}], "}"}]}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"within", " ", "the", " ", "muscle", " ", "mask"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"fa", ",", 
       RowBox[{"{", 
        RowBox[{"0.05", ",", "0.65"}], "}"}]}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"within", " ", "a", " ", "FA", " ", "range"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"md", ",", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", "2.5"}], "}"}]}], "}"}]}], 
    RowBox[{"(*", 
     RowBox[{"within", " ", "a", " ", "MD", " ", "range"}], "*)"}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"9b120239-90bf-4ad0-aecf-298d967ccc6f"],

Cell[BoxData[
 RowBox[{"PlotData", "[", 
  RowBox[{
   RowBox[{"Mask", "[", "stop", "]"}], ",", "fa"}], "]"}]], "Input",
 CellChangeTimes->{{3.8375106716325436`*^9, 3.8375106939961233`*^9}, 
   3.837512307721392*^9, {3.86729807540627*^9, 3.867298076955129*^9}, {
   3.86921455883301*^9, 3.869214628803359*^9}, {3.8692146653944693`*^9, 
   3.869214680224667*^9}, {3.8692152437476635`*^9, 3.8692152572668715`*^9}, {
   3.869221665042238*^9, 3.8692216658730106`*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"563e0d28-bc72-4f64-8c7f-3ab5a3ead7ec"],

Cell["\<\
Perform the tractography using Euler interpolation and nearest neighbour \
interpolation.\
\>", "Text",
 CellChangeTimes->{{3.83750972099186*^9, 3.837509741100566*^9}, {
  3.837509809802057*^9, 3.837509813389328*^9}, {3.869221825761391*^9, 
  3.869221849712386*^9}},ExpressionUUID->"29a9ffcf-a4f5-4810-b77b-\
7ca390550ef8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tracts", ",", "seeds"}], "}"}], "=", 
    RowBox[{"FiberTractography", "[", 
     RowBox[{"tensF", ",", "dwivox", ",", "stop", ",", "\[IndentingNewLine]", 
      RowBox[{"Parallelization", "->", "False"}], ",", 
      RowBox[{"TractMonitor", "->", "False"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"tract", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"InterpolationOrder", "->", "0"}], ",", 
      RowBox[{"Method", "->", "\"\<RK4\>\""}], ",", "\[IndentingNewLine]", 
      RowBox[{"StepSize", "->", "Automatic"}], ",", 
      RowBox[{"MaxSeedPoints", "->", 
       RowBox[{"Scaled", "[", ".5", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"stopping", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"FiberLengthRange", "->", 
       RowBox[{"{", 
        RowBox[{"10", ",", "500"}], "}"}]}], ",", 
      RowBox[{"FiberAngle", "->", "35"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"flip", " ", "tensor", " ", "if", " ", "needed"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"TensorFlips", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", 
      RowBox[{"TensorPermutations", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<z\>\"", ",", "\"\<y\>\"", ",", "\"\<x\>\""}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "//", "AbsoluteTiming"}]], "Input",
 CellChangeTimes->{{3.969942728465864*^9, 3.9699427289780617`*^9}, {
  3.9699428114588413`*^9, 3.969942812418581*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"bc214248-aca1-664b-a069-cd7e4e24d200"],

Cell["\<\
Segment the tracts within all muscle masks, fit the tracts with 3th order \
polynomials\
\>", "Text",ExpressionUUID->"8e9aaa2a-5ea2-4fb3-8ba8-9490bfc44b9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tractsS", "=", 
   RowBox[{"SegmentTracts", "[", 
    RowBox[{"tracts", ",", "masks", ",", "vox", ",", "dim", ",", 
     RowBox[{"FiberLengthRange", "->", 
      RowBox[{"{", 
       RowBox[{"10", ",", "500"}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[405]:=",ExpressionUUID->"a79f6a0f-433e-4746-980e-745b0e898114"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tractsSF", "=", 
   RowBox[{"FitTracts", "[", 
    RowBox[{"tractsS", ",", 
     RowBox[{"FittingOrder", "->", "3"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"38fe5ed5-fe67-f14c-9966-90b229af29d2"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{
