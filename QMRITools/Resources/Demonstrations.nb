         RowBox[{"ImageSize", "->", "150"}]}], "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"im", ",", 
        RowBox[{"Wrap", "[", "unw", "]"}]}], "}"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Map", "[", 
     RowBox[{
