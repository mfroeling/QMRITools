   RowBox[{"join", " ", "the", " ", "data", " ", "back", " ", "together"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dataStich", "=", 
     RowBox[{"StichData", "[", 
      RowBox[{"left", ",", "right"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"data", "==", "dataStich"}]}]}]], "Input",
