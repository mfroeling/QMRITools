Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"apply", " ", "thecropping"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"dataCrop", "=", 
    RowBox[{"ApplyCrop", "[", 
     RowBox[{"data", ",", "crop"}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.754895864337891*^9, 3.754895874794386*^9}, {
