   RowBox[{"{", 
    RowBox[{"vec", ",", 
     RowBox[{"{", 
      RowBox[{"dim", ",", " ", "coor"}], "}"}]}], "}"}], "=", 
   RowBox[{"DataToVector", "[", "data", "]"}]}], ";"}], "\n", 
