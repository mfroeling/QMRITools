     RowBox[{"MaskSmoothing", "\[Rule]", "True"}], ",", 
     RowBox[{"MaskComponents", "\[Rule]", "1"}], ",", 
     RowBox[{"MaskClosing", "\[Rule]", "3"}], ",", 
     RowBox[{"MaskDilation", "->", 
      RowBox[{"-", "1"}]}]}], "]"}]}], ";"}]}], "Input",
