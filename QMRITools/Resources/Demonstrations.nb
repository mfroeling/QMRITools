Cell[BoxData[{
 RowBox[{
  RowBox[{"echoTime", "=", "18"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"field", ",", "nuc", ",", "bw"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"3", ",", "\"\<1H\>\"", ",", "5000"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"din", ",", "struct"}], "}"}], "=", 
    RowBox[{"SimHamiltonian", "[", 
     RowBox[{"\"\<glu\>\"", ",", 
      RowBox[{"SimNucleus", "\[Rule]", "nuc"}], ",", 
