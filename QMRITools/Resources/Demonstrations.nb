  3.7584521947412176`*^9}},ExpressionUUID->"de8c27c7-f11b-40ba-bc10-\
c57fae6efe95"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"radSampF", "=", 
   RowBox[{"Flatten", "/@", "radSamp"}]}], ";"}], "\n", 
 RowBox[{"BullseyePlot", "[", 
  RowBox[{"radSampF", ",", 
   RowBox[{"BullPlotMethod", "\[Rule]", "\"\<Static\>\""}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "400"}]}], "]"}]}], "Input",
