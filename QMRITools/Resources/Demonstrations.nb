     RowBox[{"Iterations", "\[Rule]", "200"}], ",", 
     RowBox[{"MethodReg", "\[Rule]", "\"\<affineDTI\>\""}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"NumberSamples", "\[Rule]", "5000"}], ",", 
     RowBox[{"Resolutions", "\[Rule]", "2"}], ",", 
