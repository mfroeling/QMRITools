     RowBox[{"{", 
      RowBox[{"T2map", ",", "T2fmap", ",", "B1Map"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"watEPG", ",", "fatEPG", ",", "ffEPG"}], "}"}], ",", "resEPG"}],
     "}"}], "=", " ", 
