a2081fe0b5aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataS", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", "#", "}"}], "&"}], "/@", "data"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dimensions", "@", "dataS"}], "\[IndentingNewLine]", 
