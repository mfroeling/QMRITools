Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"datareg", ",", "gradF", ",", "valF", ",", "dwivox"}], "}"}], "=", 
    RowBox[{"ImportNiiDiff", "[", 
     RowBox[{"\"\<dtiData-reg.nii\>\"", ",", 
      RowBox[{"FlipBvec", "\[Rule]", "False"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tens", "=", 
   RowBox[{"Transpose", "@", 
    RowBox[{"ImportNii", "[", 
     RowBox[{"\"\<DTI-tensor.nii\>\"", ",", 
      RowBox[{"NiiMethod", "\[Rule]", "\"\<data\>\""}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tensF", "=", 
    RowBox[{"Transpose", "@", 
     RowBox[{"ImportNii", "[", 
      RowBox[{"\"\<DTI-tensor-filt.nii\>\"", ",", 
       RowBox[{"NiiMethod", "\[Rule]", "\"\<data\>\""}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"labels", ",", "vox"}], "}"}], "=", 
   RowBox[{"ImportNii", "[", "\"\<labels.nii\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dim", "=", 
   RowBox[{"Dimensions", "[", 
    RowBox[{"First", "@", "tens"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"3d03fde1-41a5-4faa-a08e-3aa8eeca546a"],

