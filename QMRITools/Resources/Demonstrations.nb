Cell[CellGroupData[{

Cell["Make patches", "Subsubsection",
 CellChangeTimes->{{3.9134420542434607`*^9, 
  3.913442065689386*^9}},ExpressionUUID->"91541c1f-ccaf-4cf5-8dc3-\
76bb1ce946de"],

Cell["\<\
By default all possible patches that need to be made to fully cover the data \
are generated with minimal overlap of the patches.
It also provides the coordinates of the patch within the original dataset.\
\>", "Text",
 CellChangeTimes->{{3.913442141234672*^9, 3.913442177944491*^9}, {
  3.913442311979536*^9, 
  3.913442354314937*^9}},ExpressionUUID->"2b25214e-afbc-4cb5-814a-\
e44021de5ad4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"patch", "=", 
   RowBox[{"{", 
    RowBox[{"32", ",", "112", ",", "112"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"patches", ",", "loc"}], "}"}], "=", 
   RowBox[{"DataToPatches", "[", 
    RowBox[{"segData", ",", "patch", ",", 
     RowBox[{"PatchNumber", "->", "0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Dimensions", "@", "segData"}], ",", 
   RowBox[{"Dimensions", "@", "patches"}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "@", "loc"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"61c3f72d-8273-480c-92bd-b064a605bd13"],

Cell[BoxData[
 RowBox[{"PlotData", "[", 
  RowBox[{"GridData", "[", 
   RowBox[{"patches", ",", "4"}], "]"}], "]"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"eaf1ea45-c204-4281-ae81-b0c5249b959b"],

Cell["Combine the patches to recreate the original dataset .", "Text",
 CellChangeTimes->{{3.913443041157716*^9, 
  3.913443062955762*^9}},ExpressionUUID->"c291d4e3-0f8b-4928-84e7-\
1dec78887500"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"segDataRec", "=", 
   RowBox[{"PatchesToData", "[", 
    RowBox[{"patches", ",", "loc"}], "]"}]}], ";"}], "\n", 
 RowBox[{"segData", "==", "segDataRec"}]}], "Input",
 CellChangeTimes->{{3.913442417453819*^9, 3.9134424267497582`*^9}, 
   3.91344425434203*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"dfd27fc9-1c36-4ee2-a87c-926d2a226bb6"],

Cell["also works for segmentations", "Text",ExpressionUUID->"fd93fbc4-fc17-124c-80a5-c34f767b7af5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"patches", ",", "loc"}], "}"}], "=", 
   RowBox[{"DataToPatches", "[", 
    RowBox[{
     RowBox[{"Round", "[", "segLab", "]"}], ",", "patch", ",", 
     RowBox[{"PatchNumber", "->", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"PlotData", "[", 
  RowBox[{"GridData", "[", 
   RowBox[{"patches", ",", "4"}], "]"}], "]"}]}], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"647a555b-0525-b74b-92f4-c33eece159ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"segLabRec", "=", 
    RowBox[{"PatchesToData", "[", 
     RowBox[{"patches", ",", "loc", ",", 
      RowBox[{"Dimensions", "@", "segLab"}], ",", 
      RowBox[{"GetSegmentationLabels", "@", "segLab"}]}], "]"}]}], ";"}], "//",
   "AbsoluteTiming"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"2e0d23f4-ebf2-134a-a502-b9f285f538c8"]
}, Closed]],

Cell[CellGroupData[{

Cell["Dynamic visualization of augmentation function", "Subsubsection",
 CellChangeTimes->{{3.9134420542434607`*^9, 3.913442065689386*^9}, {
  3.913444591858127*^9, 
  3.913444600639288*^9}},ExpressionUUID->"b99fe05e-a052-45e4-906f-\
a84b2499a84c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynVox", "=", "segV"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dynDat", "=", 
   RowBox[{"RescaleData", "[", 
    RowBox[{"segData", ",", 
     RowBox[{"{", " ", 
      RowBox[{"segV", ",", "dynVox"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dynSeg", "=", 
   RowBox[{"RescaleSegmentation", "[", 
    RowBox[{"segLab", ",", 
     RowBox[{"{", " ", 
      RowBox[{"segV", ",", "dynVox"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rr", "=", 
   RowBox[{"MinMax", "[", "dynSeg", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dynD", "=", 
    RowBox[{"Dimensions", "[", "dynDat", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"z", ",", "x", ",", "y"}], "}"}], "=", 
   RowBox[{"Round", "[", 
    RowBox[{"dynD", "/", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scale", "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"f1", ",", "f2", ",", "f3"}], "}"}], "=", " ", 
     RowBox[{"dynD", " ", "dynVox"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"w", "=", 
     RowBox[{"{", 
      RowBox[{
      "r1", ",", "r2", ",", "r3", ",", " ", "t1", ",", " ", "t2", ",", "t3", ",",
        "s1", ",", "s2", ",", "s3", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"time", "=", 
     RowBox[{"First", "@", 
      RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"datT", ",", "segT"}], "}"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"DataTransformation", "[", 
            RowBox[{"#", ",", "dynVox", ",", "w", ",", 
             RowBox[{"InterpolationOrder", "->", "0"}], ",", 
             RowBox[{"PadOutputDimensions", "->", "pad"}]}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"dynDat", ",", "dynSeg"}], "}"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"cr", "=", 
         RowBox[{"FindCrop", "[", 
          RowBox[{"datT", ",", 
           RowBox[{"CropPadding", "->", "0"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"datTc", ",", "segTc"}], "}"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"ApplyCrop", "[", 
            RowBox[{"#", ",", "cr"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"datT", ",", "segT"}], "}"}]}]}], ";"}], 
       "\[IndentingNewLine]", "]"}]}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", ",", "x", ",", "y"}], "}"}], "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dd", " ", "=", " ", 
         RowBox[{"Dimensions", "[", "datTc", "]"}]}], ")"}], "/", "2"}], 
      "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Grid", "[", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<evaluation time:  \>\"", ",", 
            RowBox[{"1000", "time"}], ",", "\"\< ms\>\""}], "}"}], "]"}], ",",
          "SpanFromLeft", ",", "SpanFromLeft"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<data dimensions:  \>\"", ",", "dd"}], "}"}], "]"}], ",",
          "SpanFromLeft", ",", "SpanFromLeft"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"MakeChannelClassImage", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"datTc", "[", 
               RowBox[{"[", 
                RowBox[{"z", ",", "All", ",", "All"}], "]"}], "]"}], "}"}], ",", 
             RowBox[{"segTc", "[", 
              RowBox[{"[", 
               RowBox[{"z", ",", "All", ",", "All"}], "]"}], "]"}], ",", 
             "rr"}], "]"}], ",", 
           RowBox[{"AspectRatio", "->", 
            RowBox[{"Divide", "@@", 
             RowBox[{"scale", "[", 
              RowBox[{"[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}], "]"}], "]"}]}]}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "300"}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"MakeChannelClassImage", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Reverse", "@", 
               RowBox[{"datTc", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "x", ",", "All"}], "]"}], "]"}]}], "}"}],
              ",", 
             RowBox[{"Reverse", "@", 
              RowBox[{"segTc", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "x", ",", "All"}], "]"}], "]"}]}], ",", 
             "rr"}], "]"}], ",", 
           RowBox[{"AspectRatio", "->", 
            RowBox[{"Divide", "@@", 
             RowBox[{"scale", "[", 
              RowBox[{"[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "3"}], "}"}], "]"}], "]"}]}]}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "300"}], "}"}]}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Show", "[", 
          RowBox[{
           RowBox[{"MakeChannelClassImage", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Reverse", "@", 
               RowBox[{"datTc", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "All", ",", "y"}], "]"}], "]"}]}], "}"}],
              ",", 
             RowBox[{"Reverse", "@", 
              RowBox[{"segTc", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "All", ",", "y"}], "]"}], "]"}]}], ",", 
             "rr"}], "]"}], ",", 
           RowBox[{"AspectRatio", "->", 
            RowBox[{"Divide", "@@", 
             RowBox[{"scale", "[", 
              RowBox[{"[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}]}]}], ",", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"Automatic", ",", "300"}], "}"}]}]}], "]"}]}], 
        "\[IndentingNewLine]", "}"}]}], "}"}], "]"}]}], "\[IndentingNewLine]",
    ",", "Delimiter", "\[IndentingNewLine]", ",", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<Reset\>\"", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "r1", ",", "r2", ",", "r3", ",", "s1", ",", "s2", ",", "s3", ",", "t1",
         ",", "t2", ",", "t3"}], "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
       "0", ",", "0", ",", "0", ",", "1", ",", "1", ",", "1", ",", "0", ",", 
        "0", ",", "0"}], "}"}]}]}], "]"}], "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pad", ",", "False"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"True", ",", "False"}], "}"}]}], "}"}], "\[IndentingNewLine]", ",",
    "Delimiter", "\[IndentingNewLine]", ",", "\"\<Rotation\>\"", 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r1", ",", "0"}], "}"}], ",", 
     RowBox[{"-", "45"}], ",", "45", ",", "1"}], "}"}], "\[IndentingNewLine]",
    ",", 
   RowBox[{"{", 
