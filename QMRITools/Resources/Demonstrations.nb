          NeuralNetworks`NetPath["Nodes", "enc_5", "Outputs", "Up"], 
          NeuralNetworks`NetPath["Nodes", "dec_3", "Inputs", "Scale"] -> 
          NeuralNetworks`NetPath["Nodes", "dec_4", "Outputs", "Up"], 
          NeuralNetworks`NetPath["Nodes", "dec_2", "Inputs", "Scale"] -> 
          NeuralNetworks`NetPath["Nodes", "dec_3", "Outputs", "Up"], 
          NeuralNetworks`NetPath["Nodes", "dec_1", "Inputs", "Scale"] -> 
          NeuralNetworks`NetPath["Nodes", "dec_2", "Outputs", "Up"], 
          NeuralNetworks`NetPath["Nodes", "map", "Inputs", "Input"] -> 
          NeuralNetworks`NetPath["Nodes", "dec_1", "Outputs", "Output"], 
          NeuralNetworks`NetPath["Outputs", "Output"] -> 
          NeuralNetworks`NetPath["Nodes", "map", "Outputs", "Output"]}|>, 
      "MSDM" -> <|
       "Type" -> "Graph", 
        "Inputs" -> <|
         "Input" -> NeuralNetworks`TensorT[{160, 160}, NeuralNetworks`RealT], 
          "Target" -> 
          NeuralNetworks`TensorT[{160, 160}, NeuralNetworks`AtomT]|>, 
        "Outputs" -> <|
         "Loss" -> NeuralNetworks`TensorT[{}, NeuralNetworks`RealT]|>, 
        "Nodes" -> <|
         "mask" -> <|
           "Type" -> "Chain", 
            "Nodes" -> <|
             "1" -> <|"Type" -> "Function", "Arrays" -> <||>, 
                "Parameters" -> <|"Function" -> (Unitize[
                    Abs[#]]& ), 
                  "Net" -> <|
                   "Type" -> "Elementwise", "Arrays" -> <||>, 
                    "Parameters" -> <|
                    "Function" -> 
                    NeuralNetworks`ValidatedParameter[Boole[Abs[#] != 0]& ], 
                    "$Dimensions" -> {160, 160}|>, 
                    "Inputs" -> <|
                    "Input" -> 
                    NeuralNetworks`TensorT[{160, 160}, 
                    NeuralNetworks`AtomT]|>, 
                    "Outputs" -> <|
                    "Output" -> NeuralNetworks`TensorT[{160, 160}, 
                    NeuralNetworks`IndexIntegerT[0, 1]]|>|>|>, 
                "Inputs" -> <|
                 "Input" -> 
                  NeuralNetworks`TensorT[{160, 160}, NeuralNetworks`AtomT]|>, 
                "Outputs" -> <|"Output" -> NeuralNetworks`TensorT[{160, 160}, 
                    NeuralNetworks`IndexIntegerT[0, 1]]|>|>|>, 
            "Edges" -> {
             NeuralNetworks`NetPath["Nodes", "1", "Inputs", "Input"] -> 
              NeuralNetworks`NetPath["Inputs", "Input"], 
              NeuralNetworks`NetPath["Outputs", "Output"] -> 
              NeuralNetworks`NetPath["Nodes", "1", "Outputs", "Output"]}, 
            "Inputs" -> <|
             "Input" -> NeuralNetworks`TensorT[{160, 160}, 
                NeuralNetworks`AtomT]|>, 
            "Outputs" -> <|"Output" -> NeuralNetworks`TensorT[{160, 160}, 
                NeuralNetworks`IndexIntegerT[0, 1]]|>|>, 
          "err" -> <|
           "Type" -> "Threading", "Arrays" -> <||>, 
            "Parameters" -> <|
             "Function" -> NeuralNetworks`ValidatedParameter[(# - #2)^2& ], 
              "Broadcasting" -> 
              NeuralNetworks`ValidatedParameter[Automatic]|>, 
            "Inputs" -> <|
             "Input1" -> 
              NeuralNetworks`TensorT[{160, 160}, NeuralNetworks`RealT], 
              "Input2" -> 
              NeuralNetworks`TensorT[{160, 160}, NeuralNetworks`AtomT]|>, 
            "Outputs" -> <|
             "Output" -> 
              NeuralNetworks`TensorT[{160, 160}, NeuralNetworks`AtomT]|>|>, 
          "count" -> <|
           "Type" -> "Aggregation", "Arrays" -> <||>, 
            "Parameters" -> <|
             "Function" -> Total, "Levels" -> 
              NeuralNetworks`ValidatedParameter[
                Span[1, -1]]|>, 
            "Inputs" -> <|"Input" -> NeuralNetworks`TensorT[{160, 160}, 
                NeuralNetworks`IndexIntegerT[0, 1]]|>, 
            "Outputs" -> <|"Output" -> NeuralNetworks`TensorT[{}, 
                NeuralNetworks`IndexIntegerT[0, 
                 DirectedInfinity[1]]]|>|>, 
          "masked" -> <|
           "Type" -> "Chain", 
            "Nodes" -> <|
             "1" -> <|"Type" -> "Threading", "Arrays" -> <||>, 
                "Parameters" -> <|
                 "Function" -> NeuralNetworks`ValidatedParameter[# #2& ], 
                  "Broadcasting" -> 
                  NeuralNetworks`ValidatedParameter[Automatic]|>, 
                "Inputs" -> <|
                 "Input1" -> 
                  NeuralNetworks`TensorT[{160, 160}, NeuralNetworks`AtomT], 
                  "Input2" -> NeuralNetworks`TensorT[{160, 160}, 
                    NeuralNetworks`IndexIntegerT[0, 1]]|>, 
                "Outputs" -> <|
                 "Output" -> 
                  NeuralNetworks`TensorT[{160, 160}, 
                    NeuralNetworks`AtomT]|>|>, 
              "2" -> <|"Type" -> "Aggregation", "Arrays" -> <||>, 
                "Parameters" -> <|
                 "Function" -> Total, "Levels" -> 
                  NeuralNetworks`ValidatedParameter[
                    Span[1, -1]]|>, 
                "Inputs" -> <|
                 "Input" -> 
                  NeuralNetworks`TensorT[{160, 160}, NeuralNetworks`AtomT]|>, 
                "Outputs" -> <|
                 "Output" -> 
                  NeuralNetworks`TensorT[{}, NeuralNetworks`AtomT]|>|>|>, 
            "Edges" -> {
             NeuralNetworks`NetPath["Nodes", "1", "Inputs", "Input1"] -> 
              NeuralNetworks`NetPath["Inputs", "Input1"], 
              NeuralNetworks`NetPath["Nodes", "1", "Inputs", "Input2"] -> 
              NeuralNetworks`NetPath["Inputs", "Input2"], 
              NeuralNetworks`NetPath["Nodes", "2", "Inputs", "Input"] -> 
              NeuralNetworks`NetPath["Nodes", "1", "Outputs", "Output"], 
              NeuralNetworks`NetPath["Outputs", "Output"] -> 
              NeuralNetworks`NetPath["Nodes", "2", "Outputs", "Output"]}, 
            "Inputs" -> <|
             "Input1" -> 
              NeuralNetworks`TensorT[{160, 160}, NeuralNetworks`AtomT], 
              "Input2" -> NeuralNetworks`TensorT[{160, 160}, 
                NeuralNetworks`IndexIntegerT[0, 1]]|>, 
            "Outputs" -> <|
             "Output" -> NeuralNetworks`TensorT[{}, NeuralNetworks`AtomT]|>|>,
           "loss" -> <|
           "Type" -> "Threading", "Arrays" -> <||>, 
            "Parameters" -> <|
             "Function" -> 
              NeuralNetworks`ValidatedParameter[75 Divide[#, 1.*^-8 + #2]& ], 
              "Broadcasting" -> 
              NeuralNetworks`ValidatedParameter[Automatic]|>, 
            "Inputs" -> <|
             "Input1" -> NeuralNetworks`TensorT[{}, NeuralNetworks`AtomT], 
              "Input2" -> NeuralNetworks`TensorT[{}, 
                NeuralNetworks`IndexIntegerT[0, 
                 DirectedInfinity[1]]]|>, 
            "Outputs" -> <|
             "Output" -> 
              NeuralNetworks`TensorT[{}, NeuralNetworks`RealT]|>|>|>, 
        "Edges" -> {
         NeuralNetworks`NetPath["Nodes", "err", "Inputs", "Input1"] -> 
          NeuralNetworks`NetPath["Inputs", "Input"], 
          NeuralNetworks`NetPath["Nodes", "err", "Inputs", "Input2"] -> 
          NeuralNetworks`NetPath["Inputs", "Target"], 
          NeuralNetworks`NetPath["Nodes", "mask", "Inputs", "Input"] -> 
          NeuralNetworks`NetPath["Inputs", "Target"], 
          NeuralNetworks`NetPath["Nodes", "masked", "Inputs", "Input2"] -> 
          NeuralNetworks`NetPath["Nodes", "mask", "Outputs", "Output"], 
          NeuralNetworks`NetPath["Nodes", "count", "Inputs", "Input"] -> 
          NeuralNetworks`NetPath["Nodes", "mask", "Outputs", "Output"], 
          NeuralNetworks`NetPath["Nodes", "masked", "Inputs", "Input1"] -> 
          NeuralNetworks`NetPath["Nodes", "err", "Outputs", "Output"], 
          NeuralNetworks`NetPath["Nodes", "loss", "Inputs", "Input2"] -> 
          NeuralNetworks`NetPath["Nodes", "count", "Outputs", "Output"], 
          NeuralNetworks`NetPath["Nodes", "loss", "Inputs", "Input1"] -> 
          NeuralNetworks`NetPath["Nodes", "masked", "Outputs", "Output"], 
          NeuralNetworks`NetPath["Outputs", "Loss"] -> 
          NeuralNetworks`NetPath["Nodes", "loss", "Outputs", "Output"]}|>|>, 
    "Edges" -> {
     NeuralNetworks`NetPath["Nodes", "MSDM", "Inputs", "Target"] -> 
      NeuralNetworks`NetPath["Inputs", "Target"], 
      NeuralNetworks`NetPath["Nodes", "net", "Inputs", "Input"] -> 
      NeuralNetworks`NetPath["Inputs", "Input"], 
      NeuralNetworks`NetPath["Nodes", "MSDM", "Inputs", "Input"] -> 
      NeuralNetworks`NetPath["Nodes", "net", "Outputs", "Output"], 
      NeuralNetworks`NetPath["Outputs", "MSDM"] -> 
      NeuralNetworks`NetPath["Nodes", "MSDM", "Outputs", "Loss"]}|>, <|
   "Version" -> "15.0.2", "Unstable" -> False|>],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
 CellLabel->"Out[70]=",ExpressionUUID->"de91cd92-24dc-824b-88ef-7987f5de8754"]
