  "In[127]:=",ExpressionUUID->"3e8ca21d-0805-49fc-aa4d-9912aeb2dfcd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"labelsD", "=", 
   RowBox[{"MergeSegmentations", "[", 
    RowBox[{"segDil", ",", "lab"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"labelsDCor", "=", 
   RowBox[{"MergeSegmentations", "[", 
    RowBox[{
     RowBox[{"RemoveMaskOverlaps", "[", "segDil", "]"}], ",", "lab"}], 
    "]"}]}], ";"}]}], "Input",
