   3.8747342149658875`*^9},ExpressionUUID->"3cde8bc5-3047-4773-bee2-\
bea3209a1f6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExportNii", "[", 
   RowBox[{
    RowBox[{"Transpose", "@", "tens"}], ",", "dwivox", ",", 
    "\"\<DTI-tensor.nii\>\""}], "]"}], ";"}]], "Input",
