 RowBox[{"<<", "QMRIToolsDev`"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExtractDemoData", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"DirectoryName", "[", 
       RowBox[{"GetAssetLocation", "[", "\"\<DemoData\>\"", "]"}], "]"}], 
