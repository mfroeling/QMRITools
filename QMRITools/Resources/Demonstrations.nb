   RowBox[{"SegmentMask", "[", 
    RowBox[{
     RowBox[{"seg", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "5"}], "]"}], "]"}], ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
