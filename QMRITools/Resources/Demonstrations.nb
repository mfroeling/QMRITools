Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ex", ",", "ref", ",", 
     RowBox[{"{", 
      RowBox[{"pl1", ",", "pl2"}], "}"}]}], "}"}], "=", 
   RowBox[{"GetPulseProfile", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<sg_150_100_167\>\"", ",", "90", ",", 
       RowBox[{"{", 
        RowBox[{"2.2845", ",", "3.9632", ",", "768"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\"\<sinc_centre\>\"", ",", "180", ",", 
