  RowBox[{"mask", "=", 
   RowBox[{"Mask", "[", 
    RowBox[{"dataN", ",", 
     RowBox[{"MaskDilation", "->", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
