Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fDix", ",", "sDix", ",", "nEcho"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"1.3", ",", "0.95", ",", "10"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"echos", "=", 
