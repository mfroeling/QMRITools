Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"data", ",", "vox", ",", "hdr"}], "}"}], "=", 
   RowBox[{"ImportNii", "[", 
    RowBox[{"\"\<twoLegs.nii\>\"", ",", 
     RowBox[{"NiiMethod", "->", "\"\<header\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"hdr", "//", "Column"}]}], "Input",
