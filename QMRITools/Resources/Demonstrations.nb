Cell[CellGroupData[{

Cell["Initial phase from first echo", "Subsubsection",ExpressionUUID->"5e9d0035-77a2-4c90-9919-14d3725aeb7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ph0", "=", 
   RowBox[{
    RowBox[{"UnwrapSplit", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Arg", "[", 
        RowBox[{"real", "+", 
         RowBox[{"imag", " ", "I"}]}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", "mag", ",", 
      RowBox[{"UnwrapDimension", "->", "\"\<3D\>\""}]}], "]"}], "/", 
    RowBox[{"(", 
