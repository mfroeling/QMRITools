 RowBox[{
  RowBox[{"dataN", "=", 
   RowBox[{"NormalizeData", "[", "data", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mask", "=", 
    RowBox[{"Mask", "[", "dataN", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MeanNoZero", "@", 
    RowBox[{"GetMaskData", "[", 
     RowBox[{"data", ",", "mask"}], "]"}]}], ",", 
   RowBox[{"MeanNoZero", "@", 
    RowBox[{"GetMaskData", "[", 
     RowBox[{"dataN", ",", "mask"}], "]"}]}]}], "}"}]}], "Input",
