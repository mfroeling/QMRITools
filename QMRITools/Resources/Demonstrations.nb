  3.758451038916531*^9}},ExpressionUUID->"0cfab279-b4c7-44c9-9d88-\
d558f0a95c00"],

Cell[BoxData[
 RowBox[{"PlotSegments", "[", 
  RowBox[{"mask", ",", "dat", ",", "segang"}], "]"}]], "Input",
