 RowBox[{"PlotData", "[", 
  RowBox[{"tensH", ",", "tens", ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2.5"}], ",", "2.5"}], "}"}], "/", "1000"}]}]}], 
  "]"}]], "Input",
