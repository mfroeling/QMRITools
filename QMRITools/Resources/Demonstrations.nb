   RowBox[{"Pulses", "[", "\"\<sg_150_100_167\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sim", "=", 
   RowBox[{"BlochSeries", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"4.", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "5"}]}]}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "4000"}], ",", "4000", ",", "50"}], "]"}], ",", 
     RowBox[{"4", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}], "pulse"}]}], " ", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.758436650221479*^9, 3.7584366573124595`*^9}, {
   3.7584367145087547`*^9, 3.758436716860037*^9}, 3.75843714147445*^9},
