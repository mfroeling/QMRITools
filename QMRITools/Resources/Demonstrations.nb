Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"fDix", ",", "sDix", ",", "nEcho"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"1.3", ",", "0.95", ",", "10"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"echos", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"fDix", " ", "+", " ", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"nEcho", "-", "1"}]}], "]"}], "sDix"}]}], ")"}], "/", 
    "1000."}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"snri", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B0i", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T2stari", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"25", ",", "100"}], "}"}], "/", "1000."}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fri", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"size", "=", "50"}], ";"}]}], "Input",
 CellLabel->
