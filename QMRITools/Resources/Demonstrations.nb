     RowBox[{"MaskClosing", "\[Rule]", "3"}], ",", 
     RowBox[{"MaskDilation", "->", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mask1", "=", 
   RowBox[{"Mask", "[", 
    RowBox[{
     RowBox[{"NormalizeMeanData", "[", "dwi", "]"}], ",", "10", ",", 
     RowBox[{"MaskSmoothing", "\[Rule]", "True"}], ",", 
     RowBox[{"MaskComponents", "\[Rule]", "1"}], ",", 
     RowBox[{"MaskClosing", "\[Rule]", "3"}], ",", 
     RowBox[{"MaskDilation", "->", 
