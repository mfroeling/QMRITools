             "rr"}], "]"}], ",", 
           RowBox[{"AspectRatio", "->", 
            RowBox[{"Divide", "@@", 
             RowBox[{"scale", "[", 
              RowBox[{"[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], "]"}], "]"}]}]}], ",", 
