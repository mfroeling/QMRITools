     RowBox[{"{", 
      RowBox[{"points", ",", "slices"}], "}"}]}], "}"}], "=", 
   RowBox[{"CardiacSegment", "[", 
    RowBox[{"dat", ",", "mask", ",", "off"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7584429249714117`*^9, 3.7584429280846834`*^9}, {
  3.7584431103117285`*^9, 3.7584431337012405`*^9}},
