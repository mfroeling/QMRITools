             RowBox[{"{", "}"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"voxJ", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.755579226890072*^9, 3.755579254219699*^9}, {
   3.838095369260709*^9, 3.8380953843003683`*^9}, 
