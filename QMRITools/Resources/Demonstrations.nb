     RowBox[{"1000", "*", "eigMus"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1000", "MDmus"}], ",", "FAmus"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.755498712417824*^9, 3.755498742032555*^9}, {
  3.755498807491068*^9, 3.755498926018022*^9}, {3.755498995171444*^9, 
