  RowBox[{
   RowBox[{"{", 
    RowBox[{"dwiS", ",", "valS"}], "}"}], "=", 
   RowBox[{"SelectBvalueData", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dwi", ",", "val"}], "}"}], ",", 
