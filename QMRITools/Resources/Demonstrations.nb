 CellTags->"c:36",ExpressionUUID->"67a583ec-d68b-4d8e-ae56-a358819f36f5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"unw", "=", 
       RowBox[{"Unwrap", "/@", "im"}]}], ";"}], ")"}], "//", 
    "AbsoluteTiming"}], "//", "First"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Show", " ", "the", " ", "results"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"r", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "@", "un"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{"Join", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{
         RowBox[{"Rescale", "[", "#", "]"}], ",", 
         RowBox[{"ImageSize", "->", "150"}]}], "]"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"im", ",", 
        RowBox[{"Wrap", "[", "unw", "]"}]}], "}"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Image", "[", 
        RowBox[{
         RowBox[{"Rescale", "[", 
