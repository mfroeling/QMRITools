   3.9134348793008933`*^9}},ExpressionUUID->"d8634280-3b4f-4d67-8ec1-\
4a66ef554d64"],

Cell[CellGroupData[{

Cell["UNET Neural Network", "Subsection",
 CellChangeTimes->{{3.913439198985773*^9, 
  3.913439212676489*^9}},ExpressionUUID->"4b7dfdf0-79ec-41be-a7c5-\
6f0f46055ba7"],

Cell[CellGroupData[{

Cell["Make Network", "Subsubsection",
 CellChangeTimes->{{3.913439541160827*^9, 
  3.9134395499412413`*^9}},ExpressionUUID->"74ad9263-6808-41a2-930a-\
5426c13be898"],

Cell["\<\
Automated segmentation is based on a UNET neural network . The included \
segmentation functions are all based on this network.
A UNET can be generated and manipulated with a number of functions.
To generate a UNET the number of input channels, output classes and the input \
patch size need to be given .
Other settings can be controlled with options .\
\>", "Text",
 CellChangeTimes->{{3.913440537768875*^9, 3.913440545840242*^9}, 
   3.913440768229949*^9, {3.9134420084100103`*^9, 
   3.91344200881002*^9}},ExpressionUUID->"29cdc2eb-bbcc-4ede-840f-\
99ea4033c8b7"],

Cell[BoxData[
 RowBox[{"Column", "@", 
  RowBox[{"Options", "@", "MakeUnet"}]}]], "Input",
 CellChangeTimes->{{3.913439507018381*^9, 3.913439513241387*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"dc810087-da59-4b05-8fb8-a092bdfc922a"],

Cell[BoxData[
 RowBox[{"net", "=", 
  RowBox[{"MakeUnet", "[", 
   RowBox[{"2", ",", "4", ",", 
    RowBox[{"{", 
     RowBox[{"16", ",", "80", ",", "80"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9134393359467707`*^9, 3.913439420834979*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"fbef0133-8e94-433f-835e-a78b3512ccf8"],

Cell["Get information from the network", "Text",
 CellChangeTimes->{{3.913440572027469*^9, 
  3.9134405847769976`*^9}},ExpressionUUID->"36f3e178-d0b0-40f2-9c3b-\
816ca80581d4"],

Cell[BoxData[
 RowBox[{"NetSummary", "[", "net", "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"e9c2ee75-c648-4a9d-97c1-903f48bbf53f"],

Cell[BoxData[
 RowBox[{"NetSummary", "[", 
  RowBox[{"net", ",", "\"\<Full\>\""}], "]"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"094bb3e2-5354-df42-ba7e-24b77f15c5c1"]
}, Closed]],

Cell[CellGroupData[{

Cell["Configure all aspects of the network", "Subsubsection",
 CellChangeTimes->{{3.913440772380751*^9, 
  3.913440782089819*^9}},ExpressionUUID->"49dd69e8-4a41-44b0-a8ec-\
725403def1b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nChan", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nClass", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"netPar", "=", "32"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"depth", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"shed", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "2"}], "}"}], " ", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "2"}], "}"}], " ", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"patch", "=", 
   RowBox[{"{", 
    RowBox[{"32", ",", "112", ",", "112"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dropout", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"block", "=", "\"\<UNet\>\""}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"netU", "=", 
  RowBox[{"MakeUnet", "[", 
   RowBox[{
   "nChan", ",", "nClass", ",", "patch", ",", " ", "\[IndentingNewLine]", 
    RowBox[{"FeatureSchedule", "->", "netPar"}], ",", "\[IndentingNewLine]", 
    RowBox[{"BlockType", "->", "block"}], ",", "\[IndentingNewLine]", 
    RowBox[{"NetworkDepth", "->", "depth"}], ",", "\[IndentingNewLine]", 
    RowBox[{"DropoutRate", "->", "dropout"}], ",", "\[IndentingNewLine]", 
    RowBox[{"DownsampleSchedule", "->", "shed"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"9f6c34bf-f1bd-4a69-aed9-d5b38deb8d44"],

Cell[BoxData[
 RowBox[{"NetSummary", "[", "netU", "]"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"c343534c-0fa4-934a-aba4-05fa891693c6"],

Cell[BoxData[
 RowBox[{"NetSummary", "[", 
  RowBox[{"netU", ",", "\"\<Full\>\""}], "]"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"20e12995-2926-5043-9b2a-2204dd74bfee"]
}, Closed]],

Cell[CellGroupData[{

Cell["Change the network", "Subsubsection",
 CellChangeTimes->{{3.913440604269323*^9, 
  3.913440608871997*^9}},ExpressionUUID->"441af3c3-8a00-4407-a852-\
88f0d363baa6"],

Cell["\<\
Some features of a network can be changed without affecting the trained \
elements, others need retraining.
For the retraining only the start and mapping layer need to be retrained.\
\>", "Text",
 CellChangeTimes->{{3.913440667404665*^9, 3.913440701560959*^9}, {
  3.913441057173152*^9, 3.913441062310585*^9}, {3.913441112763072*^9, 
  3.9134411570956507`*^9}},ExpressionUUID->"553cfd99-8d4b-46ea-a0cf-\
91ec2d3c5d22"],

Cell[BoxData[
 RowBox[{
  RowBox[{"netI", "=", 
   RowBox[{"NetInitialize", "[", "netU", "]"}]}], ";"}]], "Input",
