    RowBox[{"{", 
     RowBox[{"25", ",", "25"}], 
     RowBox[{"(*", "100", "*)"}], "}"}], "/", "1000."}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fri", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
