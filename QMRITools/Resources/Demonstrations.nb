}, Closed]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fasciculation Detection", "Chapter",
 CellChangeTimes->{{3.7548946289884815`*^9, 3.7548946340141907`*^9}, 
   3.75489504280996*^9, {3.755498556031525*^9, 3.755498559150863*^9}, {
