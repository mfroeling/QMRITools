           RowBox[{"{", 
            RowBox[{"size", ",", "size"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"realN", "=", 
        RowBox[{"realM", "+", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", 
             RowBox[{"1", "/", "snri"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"nEcho", ",", "size", ",", "size"}], "}"}]}], "]"}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"imagN", "=", 
        RowBox[{"imagM", "+", 
         RowBox[{"RandomVariate", "[", 
          RowBox[{
           RowBox[{"NormalDistribution", "[", 
            RowBox[{"0", ",", 
             RowBox[{"1", "/", "snri"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"nEcho", ",", "size", ",", "size"}], "}"}]}], "]"}]}]}], 
