Cell[CellGroupData[{

Cell["Joining multiple stacks", "Subsection",
 CellChangeTimes->{{3.7548959535708246`*^9, 3.754895967835901*^9}, {
  3.7555791021749706`*^9, 3.7555791092126975`*^9}},
