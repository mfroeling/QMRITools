441bfbb8a97a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pts", ",", "radSamp"}], "}"}], "=", 
   RowBox[{"RadialSample", "[", 
    RowBox[{"mask", ",", "dat", ",", "segang"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.758443213356582*^9, 3.758443259558839*^9}, {
