     RowBox[{"actS", ",", "actST"}], "}"}], "=", 
    RowBox[{"SelectActivations", "[", 
     RowBox[{"act", ",", "mask1"}], "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"actB", "=", 
   RowBox[{"First", "@", 
    RowBox[{"SelectActivations", "[", 
     RowBox[{"act", ",", "mask"}], "]"}]}]}], ";"}]}], "Input",
