sigfat: B1-0.9, fat=30% and SNR=30\
\>", "Text",
 CellChangeTimes->{{3.758348486184921*^9, 3.7583485082277412`*^9}, {
  3.758348672821705*^9, 3.758348688469573*^9}, {3.758348848328043*^9, 
  3.7583488612875695`*^9}, {3.758351335931971*^9, 
  3.758351350683274*^9}},ExpressionUUID->"054abc16-56b6-40bf-a212-\
835aa4516f1a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigB1", "=", 
   RowBox[{"AddNoise", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"RotateDimensionsRight", "[", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"0.7", 
            RowBox[{"EPGSignal", "[", 
             RowBox[{"echo", ",", "Twat", ",", "angle", ",", "b1s"}], "]"}]}],
            "+", 
           RowBox[{"0.3", 
            RowBox[{"EPGSignal", "[", 
             RowBox[{"echo", ",", "Tfat", ",", "angle", ",", "b1s"}], 
             "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"50", ",", "50"}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"b1s", ",", "b1"}], "}"}]}], "]"}], ",", "30", ",", 
     RowBox[{"NoiseSize", "\[Rule]", "\"\<SNR\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sig", "=", 
   RowBox[{"RotateDimensionsRight", "[", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"0.7", 
        RowBox[{"EPGSignal", "[", 
         RowBox[{"echo", ",", "Twat", ",", "angle", ",", "0.9"}], "]"}]}], 
       "+", 
       RowBox[{"0.3", 
        RowBox[{"EPGSignal", "[", 
         RowBox[{"echo", ",", "Tfat", ",", "angle", ",", "0.9"}], "]"}]}]}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"50", ",", "50"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigSNR", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"AddNoise", "[", 
      RowBox[{"sig", ",", "snrs", ",", 
       RowBox[{"NoiseSize", "\[Rule]", "\"\<SNR\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"snrs", ",", "SNR"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sigFat", "=", 
    RowBox[{"AddNoise", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"RotateDimensionsRight", "[", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "ff"}], ")"}], 
             RowBox[{"EPGSignal", "[", 
              RowBox[{"echo", ",", "Twat", ",", "angle", ",", "0.9"}], 
              "]"}]}], "+", 
            RowBox[{"ff", " ", 
             RowBox[{"EPGSignal", "[", 
              RowBox[{"echo", ",", "Tfat", ",", "angle", ",", "0.9"}], 
              "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"50", ",", "50"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ff", ",", "fat"}], "}"}]}], "]"}], ",", "30", ",", 
      RowBox[{"NoiseSize", "\[Rule]", "\"\<SNR\>\""}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Dimensions", "/@", 
  RowBox[{"{", 
   RowBox[{"sigB1", ",", "sigSNR", ",", "sigFat"}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.75834847529982*^9, 3.7583484835448585`*^9}, {
  3.7583485161003*^9, 3.7583485602140207`*^9}, {3.7583486512417836`*^9, 
  3.7583486703280087`*^9}, {3.758348738552423*^9, 3.7583487506008997`*^9}, {
