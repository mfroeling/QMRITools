Cell[CellGroupData[{

Cell["Visualize Function Dependance", "Subsection",
 CellChangeTimes->{{3.91345441271451*^9, 
  3.913454425995268*^9}},ExpressionUUID->"5e495715-ac29-4355-8c79-\
530687271bae"],

Cell[CellGroupData[{

Cell["All functions", "Subsubsection",
 CellChangeTimes->{{3.91345445253969*^9, 
  3.9134544668219457`*^9}},ExpressionUUID->"e0943110-2092-479a-a17f-\
07754f3959ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "load", " ", "all", " ", "functions", " ", "and", " ", "contexts"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tool", ",", "funcs"}], "}"}], "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"QMRIToolsFunctions", "[", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"1", ";;", "2"}]}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"list", " ", "most", " ", "complicated", " ", "functions"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Quiet", "[", 
      RowBox[{
       RowBox[{"Reverse", "[", 
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"VertexCount", "[", 
              RowBox[{"First", "@", 
               RowBox[{"MakeFunctionGraph", "[", "#", "]"}]}], "]"}], ",", 
             "#"}], "}"}], "&"}], "/@", 
          RowBox[{"Flatten", "[", "funcs", "]"}]}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "15"}], "]"}], "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}]}], "]"}], "]"}], "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"visualize", " ", "each", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{"First", "@", 
        RowBox[{"First", "@", 
         RowBox[{"Position", "[", 
          RowBox[{"tool", ",", "tl"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"f", "===", "\"\<\>\""}], ",", 
        RowBox[{"Graphics", "[", "]"}], ",", 
        RowBox[{"Column", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"f", ",", " ", 
              RowBox[{"LightDarkSwitched", "[", 
               RowBox[{"Black", ",", "White"}], "]"}], ",", "Large", ",", 
              "Bold"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MakeFunctionGraph", "[", 
             RowBox[{"f", ",", 
              RowBox[{"LabelPlacement", "\[Rule]", "name"}], ",", 
              RowBox[{"AllowSelfDependencies", "\[Rule]", "dep"}]}], "]"}]}], 
           "\[IndentingNewLine]", "}"}], ",", 
          RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tl", ",", 
         RowBox[{"First", "@", "tool"}], ",", "\"\<ToolBox\>\""}], "}"}], ",",
        "tool"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"f", ",", "\"\<\>\"", ",", "\"\<Function\>\""}], "}"}], ",", 
       RowBox[{"Dynamic", "[", 
        RowBox[{"funcs", "[", 
         RowBox[{"[", "p", "]"}], "]"}], "]"}], ",", 
       RowBox[{"ControlType", "->", "PopupMenu"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"name", ",", "Tooltip", ",", "\"\<Show Name\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Tooltip", ",", "Automatic"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dep", ",", "False", ",", "\"\<Self Ref\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"True", ",", "False"}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Initialization", ":>", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", "1"}], ",", 
        RowBox[{"f", "=", "\"\<\>\""}]}], "}"}]}], ",", 
     RowBox[{"SaveDefinitions", "->", "True"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.902748465853432*^9, 3.9027484972260933`*^9}, {
   3.902748866059586*^9, 3.902748868457079*^9}, {3.9041074410387897`*^9, 
   3.904107460484128*^9}, {3.904109171728662*^9, 3.904109173983015*^9}, {
   3.904118324402685*^9, 3.904118328791685*^9}, {3.904370269884246*^9, 
   3.904370280924671*^9}, 3.90473487889553*^9, {3.904734953222146*^9, 
   3.904735027385186*^9}, {3.904735094806617*^9, 3.904735099251048*^9}, {
   3.913871448790291*^9, 3.913871484114935*^9}, 3.9718569104062595`*^9, 
   3.971856954247341*^9, {3.980424057791458*^9, 3.980424058468643*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"a5e2d2fb-670e-49fa-81d9-2fba825ef94c"]
}, Closed]],

Cell[CellGroupData[{

Cell["MuscleBidsProcess", "Subsubsection",
 CellChangeTimes->{{3.9041182770810556`*^9, 3.9041183115712175`*^9}, {
   3.9043788603939376`*^9, 3.904378884483983*^9}, {3.9045651603644934`*^9, 
   3.904565164890196*^9}, {3.9047370754488735`*^9, 3.904737082457805*^9}, 
   3.913454475012357*^9},ExpressionUUID->"cbf760a0-2bf3-4cd9-9163-\
a9a754c8078f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tool", ",", "funcs"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{"QMRIToolsFunctions", "[", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"1", ";;", "2"}]}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nAll", " ", "=", " ", 
   RowBox[{"Length", "@", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"VertexList", "[", 
         RowBox[{"Quiet", "@", 
          RowBox[{
           RowBox[{"MakeFunctionGraph", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Flatten", "[", 
        RowBox[{"funcs", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;"}], "]"}], "]"}], "]"}]}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gr", "=", 
   RowBox[{"MakeFunctionGraph", "[", 
    RowBox[{"MuscleBidsProcess", ",", 
     RowBox[{"LabelPlacement", "->", "Tooltip"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nPro", "=", 
    RowBox[{"ToString", "@", 
     RowBox[{"VertexCount", "@", 
      RowBox[{"gr", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"\"\<Number public and private QMITools functions: \>\"", "<>", 
        RowBox[{"ToString", "@", "nAll"}]}], ",", "Bold", ",", "16"}], "]"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"\"\<Number of functions used in MuscleBidsProcess: \>\"", "<>", 
        RowBox[{"ToString", "@", "nPro"}]}], ",", "Bold", ",", "16"}], "]"}], 
     ",", "\[IndentingNewLine]", "\"\<\>\"", ",", "gr"}], 
    "\[IndentingNewLine]", "}"}], ",", 
   RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9816162451070232`*^9, 3.981616247367672*^9}, {
  3.9816163577380447`*^9, 3.98161638439394*^9}, {3.9816164227765026`*^9, 
  3.981616424426836*^9}},
 CellLabel->
  "In[246]:=",ExpressionUUID->"08ec42cd-6308-4a07-ac63-93554086a46e"]
