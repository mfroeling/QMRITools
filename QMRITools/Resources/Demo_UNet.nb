 RowBox[{
  RowBox[{"makeNetIm", "=", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"im", "=", 
        RowBox[{"Information", "[", 
         RowBox[{"#", ",", "\"\<SummaryGraphic\>\""}], "]"}]}], "}"}], ",", 
