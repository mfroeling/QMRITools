         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"HistogramPar[data, {constraints, Nbins}, style, \
color, range] plots histograms of IVIM solution.\\nHistogramPar[data, \
{constraints, Nbins, mu, conv}, components, color, range] plots histograms of \
IVIM solution.\\n\\ndata is {f1, dc, pdc1} or {f1, f2, dc, pdc1, \
pdc2}.\\nconstraints are the ranges of the x-axes for the plots.\\nNbins are \
the number of histogram bins.\\nstyle is the plot type, can be 1, 2, or \
3.\\ncolor is the color of the histogram.\\nrange are the ranges of the \
y-axes.  \\n\\noutput is a row of histograms.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
