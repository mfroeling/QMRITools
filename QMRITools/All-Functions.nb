                "FEBitmaps", "InformationHelpIcon"],
                ImageSizeCache->{13., {4., 9.}}], True->
               
               DynamicBox[FEPrivate`FrontEndResource[
                "FEBitmaps", "InformationHelpIconHot"],
                ImageSizeCache->{13., {4., 9.}}]}, Dynamic[
                CurrentValue["MouseOver"]]],
              Appearance->None,
              BaseStyle->"Link",
              ButtonData->"paclet:QMRITools/ref/B1MapCalc",
              ButtonNote->"paclet:QMRITools/ref/B1MapCalc"],
             "\"paclet:QMRITools/ref/B1MapCalc\""],
            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"B1MapCalc[data, TR, alpha] calculates the B1 map \
from a dual TR {tr1, tr2} acquisition using magnitude data with reference \
angle alpha.\\ndata has dimensions {z, {tr1,tr2}, x, y}.\\nB1MapCalc[dataTr1, \
dataTr2, TR, alpha] where dataTr1 and and dataTr2 can have any \
dimensions.\\nB1MapCalc[chan1, chan2, {f, phase, scale}, TR, alpha] \
calculates the b1map of two channels with singal fraction f for chan1 and 1-f \
for chan2 using \\nphase for the combination. the total b1 is scaled with \
scale.\\nB1MapCalc[chan1, chan2, {{f1, f2}, phase, scale}, TR, aplha] \
calculates the b1map of two channels with singal fraction f1 for chan1 and f2 \
for chan2 using \\nphase for the combination. the total b1 is scaled with \
scale.\\n\\nThe Output can be \\\"Map\\\", \\\"MagPhase\\\", or \\\"Complex\\\
\"}\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
