         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"FinalGrads[grtxt,{int,intn},{rand,order}] finalizes \
the gradient txt file. \\ngrtxt is the output from the function ConvertGrads, \
which convert the grad to txt format.\\nint is True or False, if set to True \
it interleaves b=0 gradients every intn directions.\\nrand indicates if the \
gradients need to be randomized, for this it uses the order which is the \
output of FindOrder.\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
