           Optional[
            Blank[]], 
           OptionsPattern[]}}}], "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     QMRITools`ProcessingTools`OutputSNR -> "SNR", 
      QMRITools`ProcessingTools`SmoothSNR -> 2}, 
