Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = True, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox["\<\" Symbol\"\>", "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"HelixAngleCalc[eigenvectors, mask, vox] calculates \
the helix angle matrix of cardiac data using only a left ventricle \
mask.\\nHelixAngleCalc[eigenvectors, mask, maskp, vox] calculates the helix \
angle matrix of cardiac data using only a left ventricle mask, and a maskp \
for visualization.\\nHelixAngleCalc[eigenvectors, mask, centerpoint, vec, \
inout, vox]  calculates the helix angle matrix of cardiac data using only a \
left ventricle mask.\\nHelixAngleCalc[eigenvectors, mask, maskp, centerpoint, \
vec, inout, vox] calculates the helix angle matrix of cardiac data using a \
left vantricle mask and a maskp for visualization.\\n\\neigenvectors are the \
tensor eigenvectors calculated with EigenvecCalc.\\nmask is a mask of the \
left ventricle.\\nmaskp is a mask used for visualization.\\nvox is the voxels \
size, {slice, x, y}.\\n\\nThe folowing values are calculated automaticlay \
Using CentralAxes but can also be provided as an input.\\ncenterpoint is the \
center of each slice calculated with CentralAxes.\\ninout is the inner and \
outer radius calcualted with CentralAxes.\\nvec is the vector describin the \
central axes of the heart, calculated with CentralAxes.\\n\\nOutput is het \
fiber angle matrix FAM = {9, slice, x, y} or {FAM, plot}.\\nThe angles are in \
degrees. \\n\\nHelixAngleCalc[] is based on DOI: 10.1186/1532-429X-17-S1-P15.\
\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
