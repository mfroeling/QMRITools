                "FEBitmaps", "InformationHelpIconHot"],
                ImageSizeCache->{13., {4., 9.}}]}, Dynamic[
                CurrentValue["MouseOver"]]],
              Appearance->None,
              BaseStyle->"Link",
              ButtonData->"paclet:QMRITools/ref/DixonReconstruct",
              ButtonNote->"paclet:QMRITools/ref/DixonReconstruct"],
             "\"paclet:QMRITools/ref/DixonReconstruct\""],
            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"DixonReconstruct[real, imag, echo] reconstruxt \
Dixon data with initital guess b0 = 0 and T2star = \
0.\\nDixonReconstruct[real, imag, echo, b0] reconstructs Dixon data with \
intitial guess T2star = 0.\\nDixonReconstruct[real, imag, echo, b0, t2] \
reconstructs Dixon data.\\n\\nreal is the real data in radials.\\nimag is the \
imaginary data in radians.\\nB0 can be estimated from two phase images using \
Unwrap.\\nT2 can be estimated from multiple echos using T2fit.\\n\\nOutput is \
{{watF,fatF},{watSig,fatSig},{inphase,outphase},{B0,T2star},itterations}.\\n\\\
nThe fractions are between 0 and 1, the B0 field map is in Hz and the T2start \
map is in ms.\\n\\nDixonReconstruct[] is based on DOI: 10.1002/mrm.20624 and \
10.1002/mrm.21737 (10.1002/nbm.3766).\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[GridBox[{
             {
              
              DynamicModuleBox[{System`InformationDump`open$$ = {
               False, False, False, False, False, False}}, 
               StyleBox[GridBox[{
                  {
                   TagBox[
                    TooltipBox[
                    StyleBox["\<\" Documentation\"\>", "InformationRowLabel",
                    StripOnInput->False],
                    "\"Documentation\"",
                    TooltipStyle->"TextStyling"],
                    Annotation[#, "Documentation", "Tooltip"]& ], 
                   TemplateBox[{
                    
                    TemplateBox[{
                    "\"Local \[RightGuillemet]\"", 
