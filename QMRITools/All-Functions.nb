     DefaultValues, QMRITools`TensorTools`TensorCalc, {
      SyntaxInformation[QMRITools`TensorTools`TensorCalc] -> {
        "ArgumentsPattern" -> {
           Blank[], 
           Blank[], 
           Optional[
            Blank[]], 
           OptionsPattern[]}}}], "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     QMRITools`TensorTools`MonitorCalc -> True, Method -> "iWLLS", 
      QMRITools`TensorTools`FullOutput -> True, 
      QMRITools`TensorTools`RobustFit -> True, Parallelize -> True, 
      QMRITools`TensorTools`RobustFitParameters -> {0.0001, 6}}, 
    "Attributes" -> {Protected, ReadProtected}, "FullName" -> 
    "QMRITools`TensorTools`TensorCalc"], True]]], "Print",
