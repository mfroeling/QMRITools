       RowBox[{
        RowBox[{"{", "Protected", "}"}], "1"}]}], "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"graphsSel", "=", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#", ",", 
           RowBox[{"SDG", "[", 
            RowBox[{"#", ",", "20", ",", "\[IndentingNewLine]", 
             RowBox[{"VertexLabels", "\[Rule]", 
              RowBox[{"{", 
