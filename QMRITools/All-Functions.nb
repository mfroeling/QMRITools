        "ArgumentsPattern" -> {
           Blank[], 
           Blank[], 
           OptionsPattern[]}}}], "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     QMRITools`CardiacTools`ShowPlot -> False, 
      QMRITools`CardiacTools`LCMMethod -> "WallMap", 
      QMRITools`CardiacTools`AxesMethod -> "Quadratic"}, 
    "Attributes" -> {Protected, ReadProtected}, "FullName" -> 
