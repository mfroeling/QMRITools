Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = True, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox["\<\" Symbol\"\>", "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox[
           PaneBox[
            TooltipBox[
             ButtonBox[
              PaneSelectorBox[{False->
               
               DynamicBox[FEPrivate`FrontEndResource[
                "FEBitmaps", "InformationHelpIcon"],
                ImageSizeCache->{13., {4., 9.}}], True->
               
               DynamicBox[FEPrivate`FrontEndResource[
                "FEBitmaps", "InformationHelpIconHot"],
                ImageSizeCache->{13., {4., 9.}}]}, Dynamic[
                CurrentValue["MouseOver"]]],
              Appearance->None,
              BaseStyle->"Link",
              ButtonData->"paclet:QMRITools/ref/CoilCombine",
              ButtonNote->"paclet:QMRITools/ref/CoilCombine"],
             "\"paclet:QMRITools/ref/CoilCombine\""],
            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"CoilCombine[sig] combines the coil signals sig. \
Where sig is {nCoils, ...}.  \\nCoilCombine[sig, cov] combines the coil \
signals sig. Where sig is {nCoils, ...} and cov the complex noise correlation \
matrix.\\nCoilCombine[sig, cov, sens] combines the coil signals sig. Where \
sig is {nCoils, ...} and cov the complex noise correlation matrix and sense \
the coils sensitivitys.\\n\\nPossible coil combination methods are \
\\\"Sum\\\", \\\"RootSumSqaures\\\", \\\"RoemerEqualNoise\\\", \
\\\"RoemerEqualSignal\\\", \\\"WSVD\\\".\\nRootSumSquares needs the signal. \
Can be performed with and without the noise covaricance \
