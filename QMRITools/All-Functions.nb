         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"Tensor[{l1, l2, l3}] creates a diffuison tensor \
with vectors {{0,0,1},{0,1,0},{1,0,0}} and eigenvalues {l1, l2, \
