             ",", 
             RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}]}], "}"}], "&"}],
         "/@", "functions"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexCount", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], ">", "10"}], "&"}]}], "]"}],
      ",", 
