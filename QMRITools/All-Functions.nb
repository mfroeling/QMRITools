Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = True, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox["\<\" Symbol\"\>", "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox[
           PaneBox[
            TooltipBox[
             ButtonBox[
              PaneSelectorBox[{False->
               
               DynamicBox[FEPrivate`FrontEndResource[
                "FEBitmaps", "InformationHelpIcon"],
                ImageSizeCache->{13., {4., 9.}}], True->
               
               DynamicBox[FEPrivate`FrontEndResource[
                "FEBitmaps", "InformationHelpIconHot"],
                ImageSizeCache->{13., {4., 9.}}]}, Dynamic[
                CurrentValue["MouseOver"]]],
              Appearance->None,
              BaseStyle->"Link",
              ButtonData->"paclet:QMRITools/ref/Tensor",
              ButtonNote->"paclet:QMRITools/ref/Tensor"],
             "\"paclet:QMRITools/ref/Tensor\""],
            FrameMargins->{{0, 4}, {0, 2}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"Tensor[{l1, l2, l3}] creates a diffuison tensor \
with vectors {{0,0,1},{0,1,0},{1,0,0}} and eigenvalues {l1, l2, \
l3}.\\nTensor[{l1, l2, l3}, {e1, e2, e3}] creates a diffuison tensor with \
vectors {e1, e2, e3} and eigenvalues {l1, l2, l3}.\\nTensor[{l1, l2, l3}, \
\\\"Random\\\"] creates a diffuison tensor with random orthogonal \
eigenvectors {e1, e2, e2} and eigenvalues {l1, l2, l3}.\\nTensor[{l1, l2, \
l3}, \\\"RandomZ\\\"] creates a diffuison tensor with random orthogonal \
eigenvectors {{1,0,0}, e2, e3} with random eigenvectors and eigenvalues {l1, \
l2, l3}.\\nTensor[{l1, l2, l3}, \\\"OrtRandom\\\"] creates a diffuison tensor \
with random orthogonal eigenvectors {{1,0,0},{0,1,0},{0,0,1}} and eigenvalues \
{l1, l2, l3}.\\n\\nTensor[] is based on DOI: 10.1002/nbm.2959.\"\>", 
             "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
