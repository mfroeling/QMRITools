	"datasets":{
		"HeadDTI":{
			"Label":["DTI-Head-1", "DTI-Head-2"],
			"Class":"Volumes",
			"Type":"dwi",
			"Suffix":"dti",
			"Process":{
				"Method":"DTI",
				"SplitRegistration":false,
				"FlipPermute": [[1, -1, 1], ["z", "y", "x"]], 
				"GradientCorrection":"WA1",
				"RegistrationDimension": "2D",
				"FasciculationDetection": true
			},
			"Merging":{
				"Split":false,
				"Target":["HeadDIXp", "megre", "dix", "outph"],
				"Moving":"s0",
				"Process":["s0", "snr0", "l1", "l2", "l3", "md", "fa", "rd", "adci", "fri", "tens"]
			}
		},
		"HeadTSE":{
			"Label":"TSEDix-Head",
			"Class":"Volume",
			"Type":"tse",
			"Suffix":"dix",
			"Process":{
				"Method":"Dixon-A"
			},
			"Merging":{
				"Split":false,
				"Target":["HeadTSE", "megre", "dix", "wat"],
				"Moving":"wat",
				"Process":["wat", "fat", "inph", "outph", "watfr", "fatfr"]
			}
		},
		"HeadDIXp":{
			"Label":"DIX-Rec-Head",
			"Class":"Volume",
			"Type":"megre",
			"Suffix":"dix",
			"Process":{
				"Method":"Dixon-A"
			},
			"Merging":{
